          "cards": c_cards, "fence": c_fence, "alarms": c_alarms}[a.cmd]
    try:
        return fn(a)
    except Fail as e:
        if getattr(a, "json", False):
            print(json.dumps({"ok": False, "exit": e.code, "error": e.msg.split(":")[0], "detail": e.data or {}}))
        print("phone: " + e.msg, file=sys.stderr)
        return e.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
