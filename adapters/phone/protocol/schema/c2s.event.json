{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2s.event.json",
  "title": "C0/C1 event (one of the kinds; unknown keys -> 422)",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "zone"
        },
        "zone": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,23}(:[a-z0-9_-]{1,32})?$"
        },
        "dir": {
          "enum": [
            "enter",
            "exit",
            "dwell"
          ]
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "zone",
        "dir"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "awake"
        },
        "how": {
          "enum": [
            "interaction",
            "sleep_end",
            "unlocks"
          ]
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "how"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "car"
        },
        "state": {
          "enum": [
            "on",
            "off"
          ]
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bt"
        },
        "dev": {
          "enum": [
            "buds",
            "watch",
            "car",
            "headset",
            "speaker",
            "other"
          ]
        },
        "state": {
          "enum": [
            "on",
            "off"
          ]
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "dev",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "alarm"
        },
        "next": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "next"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "net"
        },
        "vpn": {
          "type": "boolean"
        },
        "type": {
          "enum": [
            "wifi",
            "cell",
            "ethernet",
            "none",
            "other"
          ]
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tile"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:.-]{0,23}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "nfc"
        },
        "tag": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "tag"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "health.daily"
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sleep": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4102444800
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "deep_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "rem_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "light_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "awake_min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            }
          },
          "additionalProperties": false
        },
        "rhr": {
          "type": "integer",
          "minimum": 20,
          "maximum": 220
        },
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "workouts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_:.-]{0,23}$"
              },
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "avg_hr": {
                "type": "integer",
                "minimum": 20,
                "maximum": 250
              },
              "hour": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              }
            },
            "additionalProperties": false,
            "required": [
              "type",
              "min"
            ]
          }
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "day"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "tz"
        },
        "tz": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_+/-]{1,48}$"
        },
        "offset_min": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "home_offset_min": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "country": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "tz",
        "offset_min"
      ]
    }
  ]
}
