{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2s.selftest.json",
  "title": "self-test results; optional=true marks a check whose red is fine (no note to Claude)",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "optional": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "checks"
  ]
}
