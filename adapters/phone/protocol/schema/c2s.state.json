{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2s.state.json",
  "title": "C0/C1 state snapshot (partial allowed; latest per key kept). Unknown keys -> 422",
  "type": "object",
  "properties": {
    "battery": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "band": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:.-]{0,15}$"
        },
        "charging": {
          "type": "boolean"
        },
        "saver": {
          "type": "boolean"
        },
        "charger": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]{1,12}$"
        }
      },
      "additionalProperties": false
    },
    "net": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "wifi",
            "cell",
            "ethernet",
            "none",
            "other"
          ]
        },
        "vpn": {
          "type": "boolean"
        },
        "roaming": {
          "type": "boolean"
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]{2}$"
        },
        "metered": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "dnd": {
      "enum": [
        "off",
        "priority",
        "alarms",
        "total",
        "unknown"
      ]
    },
    "ringer": {
      "enum": [
        "normal",
        "vibrate",
        "silent"
      ]
    },
    "screen": {
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "last_unlock": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "alarm": {
      "type": "object",
      "properties": {
        "next": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "car": {
      "type": "object",
      "properties": {
        "projection": {
          "type": "boolean"
        },
        "bt": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "bt": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "buds",
          "watch",
          "car",
          "headset",
          "speaker",
          "other"
        ]
      }
    },
    "place": {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,23}(:[a-z0-9_-]{1,32})?$"
        },
        "band": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:.-]{0,15}$"
        },
        "town": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "stop": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "since": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        },
        "fix_age_min": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "still",
            "walking",
            "running",
            "vehicle",
            "bicycle",
            "tilting",
            "unknown"
          ]
        },
        "since": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4102444800
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "properties": {
        "fgs": {
          "type": "boolean"
        },
        "wakeups_h": {
          "type": "number",
          "minimum": 0
        },
        "reconnects_d": {
          "type": "integer",
          "minimum": 0
        },
        "cpu_s_d": {
          "type": "number",
          "minimum": 0
        },
        "loc_d": {
          "type": "integer",
          "minimum": 0
        },
        "fgs_h": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "minProperties": 1
}
