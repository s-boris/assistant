{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "c2s.usage.json",
  "title": "usage: a batch of product-analytics events (stable feature id, kind, surface, duration). Never text, titles, links, place names or ids of his data; the app caps them per day and reports how many it dropped.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string",
            "pattern": "^app\\.[a-z0-9_]{1,24}(\\.[a-z0-9_]{1,24}){0,3}$"
          },
          "kind": {
            "enum": ["invoke", "tap", "open", "dismiss", "view", "error"]
          },
          "surface": {
            "enum": ["tile", "widget", "screen", "fab", "fab_menu", "card", "chat", "link", "notify", "dive", "trackid",
                     "ring", "talk", "capture", "shortcut", "app"]
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4102444800
          },
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 86400000
          },
          "level": {
            "enum": ["urgent", "timed", "decision", "info"]
          },
          "outcome": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,24}$"
          }
        },
        "additionalProperties": false,
        "required": ["feature", "kind", "at"]
      }
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "app": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    }
  },
  "additionalProperties": false,
  "required": ["items"]
}
