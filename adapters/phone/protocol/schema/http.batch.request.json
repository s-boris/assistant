{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http.batch.request.json",
  "title": "POST /v1/events (also /v1/ack, /v1/action, /v1/chat, /v1/card-answer): envelopes",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "items"
  ]
}
