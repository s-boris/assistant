{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http.pair.response.json",
  "title": "POST /v1/pair 200",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^d_[0-9A-Z]{4,12}$"
    },
    "cert": {
      "type": "string",
      "pattern": "^-----BEGIN CERTIFICATE-----",
      "description": "device cert PEM (2 years, signed by the CA)"
    },
    "ca": {
      "type": "string",
      "pattern": "^-----BEGIN CERTIFICATE-----"
    },
    "config": {
      "type": "object",
      "properties": {
        "rev": {
          "type": "integer",
          "minimum": 0
        },
        "keepalive_s": {
          "type": "integer",
          "minimum": 15,
          "maximum": 900
        },
        "quiet": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "state_every_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "geofence_resp_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "activity": {
          "type": "boolean"
        },
        "trip": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:.-]{0,15}$"
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^/\\s]+$"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "night": {
          "enum": [
            "ring",
            "hold",
            "dnd"
          ]
        },
        "health": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "rev",
        "keepalive_s",
        "urls"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "device_id",
    "cert",
    "ca",
    "config"
  ]
}
