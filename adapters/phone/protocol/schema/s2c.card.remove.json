{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2c.card.remove.json",
  "title": "remove a card",
  "type": "object",
  "properties": {
    "card_id": {
      "type": "string",
      "pattern": "^c_[A-Za-z0-9_-]{1,40}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "card_id"
  ]
}
