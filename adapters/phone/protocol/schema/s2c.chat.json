{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2c.chat.json",
  "title": "chat message from Claude",
  "type": "object",
  "properties": {
    "msg_id": {
      "type": "string",
      "pattern": "^m_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^m_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "buttons": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "data": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": false,
          "required": [
            "text",
            "data"
          ]
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "msg_id",
    "text"
  ]
}
