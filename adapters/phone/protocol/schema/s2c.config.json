{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2c.config.json",
  "title": "server config",
  "type": "object",
  "properties": {
    "rev": {
      "type": "integer",
      "minimum": 0
    },
    "keepalive_s": {
      "type": "integer",
      "minimum": 15,
      "maximum": 900
    },
    "quiet": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "state_every_s": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "geofence_resp_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "activity": {
      "type": "boolean"
    },
    "trip": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:.-]{0,15}$"
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[^/\\s]+$"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "night": {
      "enum": [
        "ring",
        "hold",
        "dnd"
      ]
    },
    "health": {
      "type": "boolean",
      "description": "M4: Health Connect summaries allowed by the gateway (default false). The app also needs its own switch on."
    }
  },
  "additionalProperties": false,
  "required": [
    "rev",
    "keepalive_s",
    "urls"
  ]
}
