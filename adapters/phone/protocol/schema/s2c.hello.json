{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2c.hello.json",
  "title": "server hello (first frame after the WS upgrade)",
  "type": "object",
  "properties": {
    "server": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "device_id": {
      "type": "string",
      "pattern": "^d_[0-9A-Z]{4,12}$"
    },
    "time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4102444800
    },
    "tz": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "config_rev": {
      "type": "integer",
      "minimum": 0
    },
    "pending": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "server",
    "device_id",
    "time",
    "tz",
    "config_rev",
    "pending"
  ]
}
