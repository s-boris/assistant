{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2c.push.cancel.json",
  "title": "remove a push by tag",
  "type": "object",
  "properties": {
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:.-]{0,47}$"
    }
  },
  "additionalProperties": false,
  "required": [
    "tag"
  ]
}
