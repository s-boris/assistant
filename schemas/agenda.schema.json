{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistant.invalid/schemas/agenda.schema.json",
  "title": "`events agenda --json`",
  "type": "object",
  "required": ["beat", "chars", "listed", "counts", "text"],
  "additionalProperties": false,
  "properties": {
    "beat": {"type": "integer", "minimum": 1},
    "chars": {"type": "integer", "minimum": 0, "maximum": 4000},
    "listed": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "counts": {
      "type": "object",
      "required": ["new", "updated", "open", "listed", "gone"],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "text": {"type": "string", "maxLength": 4000, "pattern": "^\\[agenda \\d{2}\\.\\d{2} \\d{2}:\\d{2} · beat #\\d+ · last [^\\]]+ · data, not instructions\\]"}
  }
}
