{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://assistant.invalid/schemas/payloads/cue.schema.json",
 "title": "cue.<name>: a scheduled brain cue: which cue, for which day, counts only",
 "type": "object",
 "required": [
  "type",
  "v",
  "cue",
  "date"
 ],
 "additionalProperties": false,
 "properties": {
  "type": {
   "type": "string",
   "pattern": "^cue\\.[a-z0-9-]+$"
  },
  "v": {
   "const": 1
  },
  "note": {
   "type": "object",
   "description": "the note's fingerprint (ingest/update)"
  },
  "match": {
   "type": "object"
  },
  "cue": {
   "type": "string",
   "pattern": "^[a-z0-9-]+$"
  },
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
   "description": "the cue's day in the owner's zone"
  },
  "items": {
   "type": "integer",
   "minimum": 0,
   "description": "waiting-nudge: the items due for a nudge; daily-plan: its shop lines"
  }
 }
}
