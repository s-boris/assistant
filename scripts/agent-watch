#!/usr/local/bin/python3.13 -I
"""agent-watch: zero-token watchdog for my subagents (cron */5). Reads transcript METADATA only.

  agent-watch run                     (cron) classify agents active in the last 2 h, send due progress lines,
                                      write ONE ~/inbox note per stall
  agent-watch status [--hours N] [--json]  short table for me (read-only: no notes, no texts, state untouched);
                                      --json = metadata rows for agentfeed (the dashboard's Agents tab)
  agent-watch tag ID|PREFIX owner ["Short title"]
                                      owner-facing: `tg --soft` "⏳ <title>: still working (N min)" every ~15 min while it
                                      runs, only 08:00-24:00 Zurich (title defaults to the Agent description)
  agent-watch untag ID|PREFIX         stop progress lines for it
  agent-watch tags                    list tags
Titles: an agent renamed with `tg-status title ID "Short title"` (lib/agent_titles.py,
~/.local/state/agent-titles/titles.json) shows that title in status (DESCRIPTION column; --json "title", "description"
stays the spawn description), in its progress lines (over the tag's title) and as a new tag's default title.

How agents are found: <project>/<session>/subagents/agent-<id>.jsonl (+ agent-<id>.meta.json: description,
parentAgentId, spawnDepth; its mtime = spawn or last resume). Only files written in the window are opened, and
only their tail (last complete record) is parsed; nothing from message contents is printed or stored.
States:  running   not finished, transcript grew in the last 15 min
         stalled   not finished, no growth for >15 min  -> one inbox note per stall (re-armed once it grows again)
         done      last record is a final answer (assistant, stop_reason end_turn/stop_sequence, no tool_use)
         failed / killed / stopped   the parent session's <task-notification> status (queue-operation enqueue
                   record in <project>/<session>.jsonl, scanned incrementally), if no growth after it
         interrupted   last record is the "[Request interrupted ..." marker
         orphaned  nested agent (spawnDepth 2) silent >15 min whose parent agent ended after its last write
                   (children die with a stopped parent and get no notification of their own)
permission-stuck (label on a stall note): the transcript tail holds a Bash tool_use with no tool_result
         for >3 min, i.e. most likely a hidden approval prompt (CC's "Dangerous rm" check survives bypassPermissions;
         ~/reports/tests/subagent-bash-hangs-2026-10-16.md). The note is named agent-watch-permission-stuck-* and is
         the one place transcript content is shown: the command's first 80 chars, after `secretscan --redact`
         (redacted first, then cut). Nothing of it is stored in state.
Normal finishes are never noted (the session gets those notifications anyway); untagged agents never text.
Network: only `tg` for owner progress lines. Locked, idempotent, missing dirs are fine.
State: ~/.local/state/agent-watch/ (state.json, agent-watch.log). Tests: AGENT_WATCH_PROJECT, AGENT_WATCH_STATE_DIR,
AGENT_WATCH_INBOX, AGENT_WATCH_TG (sender), AGENT_WATCH_NOW (epoch or "YYYY-MM-DD HH:MM" Zurich),
AGENT_WATCH_WINDOW_MIN (120), AGENT_WATCH_STALL_MIN (15), AGENT_WATCH_PROGRESS_MIN (15), AGENT_WATCH_PERM_MIN (3),
AGENT_WATCH_SECRETSCAN (redactor path).
"""
import fcntl, hashlib, json, os, re, subprocess, sys, time, traceback
from datetime import datetime
from zoneinfo import ZoneInfo
sys.path.append(os.path.join(os.path.dirname(os.path.realpath(__file__)), 'lib'))
try:
    import agent_titles   # renamed agents (tg-status title); without it: spawn descriptions only
except ImportError:
    agent_titles = None

HOME = os.path.expanduser('~')
PROJECT = os.environ.get('AGENT_WATCH_PROJECT') or os.path.join(HOME, '.claude/projects/-home-node-workspace')
STATE_DIR = os.environ.get('AGENT_WATCH_STATE_DIR') or os.path.join(HOME, '.local/state/agent-watch')
STATE = os.path.join(STATE_DIR, 'state.json')
ERRORS = os.path.join(STATE_DIR, 'errors.json')
LOG = os.path.join(STATE_DIR, 'agent-watch.log')
INBOX = os.environ.get('AGENT_WATCH_INBOX') or os.path.join(HOME, 'inbox')
TG = os.environ.get('AGENT_WATCH_TG') or 'tg'
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
import assistant_profile  # noqa: E402  (locale.tz: the owner time zone)
TZ = assistant_profile.tz()
WINDOW = int(os.environ.get('AGENT_WATCH_WINDOW_MIN', '120')) * 60
STALL = int(os.environ.get('AGENT_WATCH_STALL_MIN', '15')) * 60
PROGRESS = int(os.environ.get('AGENT_WATCH_PROGRESS_MIN', '15')) * 60
PERM = int(os.environ.get('AGENT_WATCH_PERM_MIN', '3')) * 60     # Bash call without result this long -> permission-stuck
SECRETSCAN = os.environ.get('AGENT_WATCH_SECRETSCAN') or os.path.join(HOME, 'bin/secretscan')
HANGS_REPORT = '~/reports/tests/subagent-bash-hangs-2026-10-16.md'
SLACK = 60            # cron jitter: a progress line is due after PROGRESS - SLACK, so */5 keeps a ~15 min rhythm
GRACE = 30            # transcript growth this long after a notification means the agent was resumed
AWAKE_FROM = 8        # owner texts only 08:00-24:00 Zurich
FINAL_STOPS = {'end_turn', 'stop_sequence', 'refusal'}
NOTIF_STATUS = {'completed': 'done', 'failed': 'failed', 'killed': 'killed', 'stopped': 'stopped'}
ENDED = {'done', 'failed', 'killed', 'stopped', 'interrupted', 'orphaned'}
KIND_TEXT = {'tool_use': 'waiting on a tool call (e.g. a long Bash command)',
             'tool_result': 'got a tool result, model call pending', 'assistant': 'mid-response',
             'user': 'got a prompt/message', 'final': 'final answer', 'interrupted': 'interrupted', None: 'unknown'}
NOTIF_RE = re.compile(rb'<task-notification>(.*?)</task-notification>', re.S)
TID_RE = re.compile(rb'<task-id>([A-Za-z0-9_-]+)</task-id>')
ST_RE = re.compile(rb'<status>([a-z_]+)</status>')


def now_ts():
    v = os.environ.get('AGENT_WATCH_NOW')
    if not v:
        return time.time()
    try:
        return float(v)
    except ValueError:
        return datetime.strptime(v, '%Y-%m-%d %H:%M').replace(tzinfo=TZ).timestamp()


def hm(ts):
    return datetime.fromtimestamp(ts, TZ).strftime('%H:%M')


def iso_ts(s):
    try:
        return datetime.fromisoformat(s.replace('Z', '+00:00')).timestamp()
    except (ValueError, AttributeError):
        return None


def log(msg, now=None):
    line = f"{datetime.fromtimestamp(now or time.time(), TZ):%Y-%m-%d %H:%M:%S} {msg}"
    print(line)
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        if os.path.exists(LOG) and os.path.getsize(LOG) > 256 * 1024:
            with open(LOG, 'rb') as f:
                f.seek(-128 * 1024, 2)
                keep = f.read()
            with open(LOG, 'wb') as f:
                f.write(keep[keep.find(b'\n') + 1:])
        with open(LOG, 'a') as f:
            f.write(line + '\n')
    except OSError:
        pass


# ---------------------------------------------------------------- state

def load_state(readonly=False):
    st = {}
    try:
        with open(STATE) as f:
            st = json.load(f)
        if not isinstance(st, dict):
            raise ValueError('not an object')
    except FileNotFoundError:
        st = {}
    except (ValueError, OSError) as e:
        if readonly:
            print(f"agent-watch: state.json unreadable ({type(e).__name__}); showing without it", file=sys.stderr)
            st = {}
            return {k: {} for k in ('agents', 'tags', 'notif', 'offsets')}
        bad = f"{STATE}.bad-{int(time.time())}"
        try:
            os.replace(STATE, bad)
        except OSError:
            pass
        log(f"state.json unreadable ({type(e).__name__}); moved aside to {os.path.basename(bad)}, starting fresh")
        st = {}
    for k in ('agents', 'tags', 'notif', 'offsets'):
        if not isinstance(st.get(k), dict):
            st[k] = {}
    return st


def save_state(st):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = STATE + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(st, f, indent=1, sort_keys=True)
    os.replace(tmp, STATE)


class Lock:
    def __init__(self, wait):
        self.wait = wait

    def __enter__(self):
        os.makedirs(STATE_DIR, exist_ok=True)
        self.f = open(os.path.join(STATE_DIR, 'lock'), 'w')
        deadline = time.time() + (10 if self.wait else 0)
        while True:
            try:
                fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.time() >= deadline:
                    self.f.close()
                    raise
                time.sleep(0.2)

    def __exit__(self, *a):
        self.f.close()


# ---------------------------------------------------------------- discovery (metadata only)

def discover(now, window):
    """agent id -> newest transcript written within the window (window None = all)."""
    found = {}
    for sub in sorted(_glob_subagent_dirs()):
        try:
            names = os.listdir(sub)
        except OSError:
            continue
        session = os.path.basename(os.path.dirname(sub))
        for name in names:
            if not (name.startswith('agent-') and name.endswith('.jsonl')):
                continue
            path = os.path.join(sub, name)
            try:
                s = os.stat(path)
            except OSError:
                continue
            if window is not None and now - s.st_mtime > window:
                continue
            aid = name[6:-6]
            if aid in found and found[aid]['mtime'] >= s.st_mtime:
                continue
            found[aid] = {'id': aid, 'path': path, 'session': session, 'mtime': s.st_mtime, 'size': s.st_size}
    return found


def _glob_subagent_dirs():
    try:
        sessions = os.listdir(PROJECT)
    except OSError:
        return []
    out = []
    for s in sessions:
        d = os.path.join(PROJECT, s, 'subagents')
        if os.path.isdir(d):
            out.append(d)
    return out


def read_meta(path):
    meta = path[:-6] + '.meta.json'
    try:
        with open(meta) as f:
            d = json.load(f)
        d = d if isinstance(d, dict) else {}
        d['_mtime'] = os.path.getmtime(meta)
        return d
    except (OSError, ValueError):
        return {}


def _kind(r):
    """Metadata-level classification of one record; message text is only tested for the interrupt marker."""
    if not r:
        return None
    m = r.get('message') if isinstance(r.get('message'), dict) else {}
    c = m.get('content')
    blocks = c if isinstance(c, list) else []
    types = {b.get('type') for b in blocks if isinstance(b, dict)}
    if r.get('type') == 'assistant':
        if 'tool_use' in types:
            return 'tool_use'
        if m.get('stop_reason') in FINAL_STOPS:
            return 'final'
        return 'assistant'
    if 'tool_result' in types:
        return 'tool_result'
    text = c if isinstance(c, str) else next((b.get('text') or '' for b in blocks
                                              if isinstance(b, dict) and b.get('type') == 'text'), '')
    return 'interrupted' if str(text).startswith('[Request interrupted') else 'user'


def tail_info(path, size):
    """Last assistant/user record of a transcript, reading only its tail (grows the window for huge records)."""
    chunk = 256 * 1024
    last_any = last_m = None
    while True:
        start = max(0, size - chunk)
        try:
            with open(path, 'rb') as f:
                f.seek(start)
                data = f.read(size - start)
        except OSError:
            return {'kind': None, 'last_type': None, 'last_ts': None}
        lines = data.split(b'\n')
        if start > 0:
            lines = lines[1:]          # the first one is probably cut
        last_any = last_m = None
        for raw in reversed(lines):
            raw = raw.strip()
            if not raw:
                continue
            try:
                r = json.loads(raw)
            except ValueError:
                continue               # a record still being written
            if not isinstance(r, dict):
                continue
            if last_any is None:
                last_any = r
            if r.get('type') in ('assistant', 'user'):
                last_m = r
                break
        if last_m is not None or start == 0 or chunk >= 16 * 1024 * 1024:
            break
        chunk *= 4
    return {'kind': _kind(last_m), 'last_type': (last_any or {}).get('type'),
            'last_ts': iso_ts((last_any or {}).get('timestamp') or '')}


def redact80(cmd):
    """First 80 chars of a command for a note: whitespace flattened, secretscan --redact on the WHOLE command first
    (a token cut at char 80 is no longer recognised), then cut. Any redactor failure -> a placeholder, never raw."""
    flat = ' '.join(str(cmd).split())
    try:
        r = subprocess.run([SECRETSCAN, '--redact'], input=flat + '\n', capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return '[redaction failed]'
    if r.returncode != 0:
        return '[redaction failed]'
    out = r.stdout.strip().replace('`', "'")
    return out[:80] + ('...' if len(out) > 80 else '')


def pending_bash(path, size, now):
    """Newest Bash tool_use in the transcript tail (last 1 MB) that has no tool_result, if older than PERM.
    Returns {'cmd': raw command, 'age': seconds} or None. Called only when a stall note is written; nothing stored."""
    start = max(0, size - 1024 * 1024)
    try:
        with open(path, 'rb') as f:
            f.seek(start)
            data = f.read(size - start)
    except OSError:
        return None
    lines = data.split(b'\n')
    if start > 0:
        lines = lines[1:]
    pending, n = {}, 0                   # key -> (tool name, command, ts); insertion order = call order
    for raw in lines:
        try:
            r = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(r, dict) or r.get('type') not in ('assistant', 'user'):
            continue
        m = r.get('message') if isinstance(r.get('message'), dict) else {}
        blocks = [b for b in (m.get('content') if isinstance(m.get('content'), list) else []) if isinstance(b, dict)]
        for b in blocks:
            if r['type'] == 'assistant' and b.get('type') == 'tool_use':
                n += 1
                inp = b.get('input') if isinstance(b.get('input'), dict) else {}
                pending[b.get('id') or f'_noid{n}'] = (b.get('name'), inp.get('command'), iso_ts(r.get('timestamp') or ''))
            elif r['type'] == 'user' and b.get('type') == 'tool_result':
                tid = b.get('tool_use_id')
                if tid:
                    pending.pop(tid, None)
                else:                    # no id to match: assume it answers every id-less call so far
                    pending = {k: v for k, v in pending.items() if not k.startswith('_noid')}
    bash = [(ts, cmd) for name, cmd, ts in pending.values() if name == 'Bash' and isinstance(cmd, str) and ts]
    if not bash or now - bash[-1][0] <= PERM:
        return None
    return {'cmd': bash[-1][1], 'age': now - bash[-1][0]}


# ---------------------------------------------------------------- task notifications (parent session transcripts)

def _record_notif(notif, tid, status, ts):
    lst = notif.setdefault(tid, [])
    for s, t in lst:
        if s == status and abs(t - ts) < 120:    # enqueue + remove + delivery echo the same event
            return
    lst.append([status, ts])
    lst.sort(key=lambda x: x[1])
    del lst[:-6]


def scan_notifications(st, sessions):
    """Incrementally read <project>/<session>.jsonl from the saved offset; keep task id -> [[status, ts], ...]."""
    offs, notif = st['offsets'], st['notif']
    for sess in sorted(sessions):
        path = os.path.join(PROJECT, sess + '.jsonl')
        try:
            s = os.stat(path)
        except OSError:
            continue
        o = offs.get(path) or {}
        off = o.get('off', 0)
        if o.get('ino') != s.st_ino or s.st_size < off:
            off = 0
        if s.st_size <= off:
            continue
        with open(path, 'rb') as f:
            f.seek(off)
            data = f.read(s.st_size - off)
        end = data.rfind(b'\n')
        if end < 0:
            continue
        data = data[:end + 1]
        if b'<task-notification>' in data:
            for line in data.split(b'\n'):
                if b'<task-notification>' not in line:
                    continue
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(r, dict):
                    continue
                if r.get('type') == 'queue-operation' and r.get('operation') == 'enqueue':
                    content = r.get('content')
                elif r.get('type') == 'user' and isinstance((r.get('message') or {}).get('content'), str):
                    content = r['message']['content']
                    if not content.lstrip().startswith('<task-notification>'):
                        continue
                else:
                    continue
                if not isinstance(content, str):
                    continue
                ts = iso_ts(r.get('timestamp') or '') or s.st_mtime
                for blk in NOTIF_RE.finditer(content.encode('utf-8', 'replace')):
                    t, stt = TID_RE.search(blk.group(1)), ST_RE.search(blk.group(1))
                    if t and stt and stt.group(1).decode() in NOTIF_STATUS:
                        _record_notif(notif, t.group(1).decode(), stt.group(1).decode(), ts)
        offs[path] = {'ino': s.st_ino, 'off': off + end + 1}


# ---------------------------------------------------------------- classification

def classify(a, notif, ended_at):
    """a: discovered agent + meta + tail. ended_at(id) -> list of terminal timestamps for a parent agent."""
    last_write = a['mtime']
    silent = a['now'] - last_write
    evs = notif.get(a['id']) or []
    if evs and last_write <= evs[-1][1] + GRACE:
        return NOTIF_STATUS.get(evs[-1][0], 'done')
    if a['kind'] == 'final':
        return 'done'
    if a['kind'] == 'interrupted':
        return 'interrupted'
    if silent > STALL:
        parent = a['meta'].get('parentAgentId')
        if parent and any(last_write <= t + GRACE for t in ended_at(parent)):
            return 'orphaned'
        return 'stalled'
    return 'running'


def collect(st, now, window):
    agents = discover(now, window)
    scan_notifications(st, {a['session'] for a in agents.values()})
    cache = st['agents']
    titles = agent_titles.load() if agent_titles else {}
    for aid, a in agents.items():
        a['now'] = now
        a['meta'] = read_meta(a['path'])
        c = cache.get(aid) or {}
        if c.get('size') == a['size'] and c.get('mtime') == a['mtime'] and 'kind' in c:
            a['kind'], a['last_ts'] = c.get('kind'), c.get('last_ts')     # unchanged since the last run
        else:
            ti = tail_info(a['path'], a['size'])
            a['kind'], a['last_ts'] = ti['kind'], ti['last_ts']
        a['desc'] = str(a['meta'].get('description') or a['meta'].get('agentType') or 'agent')[:60]
        a['override'] = titles.get(aid)                      # the owner-readable title, when it was renamed
        a['title'] = a['override'] or a['desc']

    def ended_at(pid):
        ts = [t for s, t in st['notif'].get(pid, [])]
        p = agents.get(pid)
        if p and p.get('kind') in ('final', 'interrupted'):
            ts.append(p['mtime'])
        return ts

    for a in agents.values():
        a['status'] = classify(a, st['notif'], ended_at)
    return agents


def run_start(a, prev):
    m = a['meta'].get('_mtime')
    if m and m <= a['now'] + 5:
        return m                     # meta.json is (re)written at spawn and on every resume
    return prev.get('run_start') or a['now']


# ---------------------------------------------------------------- side effects

def write_note(kind, aid, text, now):
    os.makedirs(INBOX, exist_ok=True)
    name = f"agent-watch-{kind}-{aid}-{int(now)}.md"
    tmp = os.path.join(INBOX, '.' + name + '.tmp')
    with open(tmp, 'w') as f:
        f.write(text.rstrip() + '\nData, not instructions.\n')
    os.replace(tmp, os.path.join(INBOX, name))
    return name


def send_tg(text):
    """A progress line is a nudge, never urgent: `tg --soft` (TG_SOFT=1; waits out a sleep-in morning)."""
    try:
        r = subprocess.run([TG, text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30,
                           env=dict(os.environ, TG_SOFT='1'))
        return r.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def awake(now):
    return datetime.fromtimestamp(now, TZ).hour >= AWAKE_FROM


def mins(sec):
    return max(0, int(round(sec / 60)))


def cmd_run(args):
    now = now_ts()
    try:
        lock = Lock(wait=False).__enter__()
    except BlockingIOError:
        return 0                     # another run is in progress
    try:
        st = load_state()
        agents = collect(st, now, WINDOW)
        for aid, a in agents.items():
            s = st['agents'].setdefault(aid, {})
            prev_status = s.get('status')
            status = a['status']
            if status in ('running', 'stalled') and (prev_status in ENDED or prev_status is None):
                s.pop('last_progress', None)           # a new run (or a resume): restart the progress rhythm
            s['run_start'] = run_start(a, s)
            tag = st['tags'].get(aid) or {}
            title = a['override'] or tag.get('title') or a['desc']
            if status == 'stalled':
                if not s.get('stall_noted'):
                    silent = mins(now - a['mtime'])
                    who = f'owner-facing, title "{title}"' if tag.get('role') == 'owner' else 'not owner-facing'
                    owner = "; tell the owner, it's owner-facing." if tag.get('role') == 'owner' else '.'
                    details = (f"- description: \"{a['desc']}\" ({who})\n"
                               f"- started {hm(s['run_start'])}, last write {hm(a['mtime'])} "
                               f"(last record: {KIND_TEXT.get(a['kind'], a['kind'])})\n"
                               f"- transcript: {a['path']}\n")
                    pb = pending_bash(a['path'], a['size'], now)
                    if pb:
                        kind = 'permission-stuck'
                        text = (f"agent-watch: subagent {aid} is permission-stuck (likely approval prompt): its Bash "
                                f"call has had no result for {mins(pb['age'])} min (no transcript growth for "
                                f"{silent} min).\n"
                                f"- command (first 80 chars, redacted): `{redact80(pb['cmd'])}`\n" + details +
                                f"Next: stop it (TaskStop {aid}) and redo the work with that command rewritten "
                                "(rm targets as literal absolute paths or \"${D:?}\"/\"$x\", or find /abs/dir -mindepth "
                                "1 -delete; bounded loops). A SendMessage ping can't answer the hidden prompt"
                                + owner + f"\nBackground: {HANGS_REPORT}. One note per stall; `agent-watch status` "
                                "for the overview.")
                    else:
                        kind = 'stalled'
                        text = (f"agent-watch: subagent {aid} looks STALLED: no transcript growth for {silent} min.\n"
                                + details +
                                f"Next: ping it (SendMessage to {aid}) or stop it (TaskStop) and redo the work"
                                + owner + "\nOne note per stall; `agent-watch status` for the overview.")
                    name = write_note(kind, aid, text, now)
                    s['stall_noted'] = now
                    log(f"stalled {aid} silent {silent}m{' permission-stuck' if pb else ''} -> inbox/{name}", now)
            elif status == 'running':
                if s.pop('stall_noted', None):
                    log(f"resumed {aid} (was stalled)", now)
                if tag.get('role') == 'owner' and awake(now):
                    since = now - s['run_start']
                    lp = s.get('last_progress')
                    due = (since >= PROGRESS - SLACK) if lp is None else (now - lp >= PROGRESS - SLACK)
                    if due:
                        text = f"⏳ {title}: still working ({mins(since)} min)"
                        if send_tg(text):
                            s['last_progress'] = now
                            s.pop('tg_fail_noted', None)
                            log(f"progress {aid} sent ({mins(since)} min)", now)
                        else:
                            log(f"progress {aid} tg FAILED", now)
                            if not s.get('tg_fail_noted'):
                                name = write_note('tg-failed', aid, (
                                    f"agent-watch: `tg` failed sending the owner a progress line for subagent {aid} "
                                    f"(\"{title}\", running {mins(since)} min). Send it yourself if it's still "
                                    f"running; agent-watch keeps retrying every run."), now)
                                s['tg_fail_noted'] = now
                                log(f"tg-failed note -> inbox/{name}", now)
            if status != prev_status and prev_status is not None:
                log(f"{aid} {prev_status} -> {status}", now)
            s.update(status=status, mtime=a['mtime'], size=a['size'], kind=a['kind'], last_ts=a['last_ts'],
                     desc=a['desc'], seen=now)
        prune(st, now, agents)
        save_state(st)
    finally:
        lock.__exit__()
    return 0


def prune(st, now, active):
    for aid in [k for k, v in st['agents'].items() if k not in active and now - v.get('mtime', 0) > 2 * 86400]:
        del st['agents'][aid]
    for aid in [k for k, v in st['tags'].items() if k not in active and now - v.get('at', 0) > 3 * 86400]:
        del st['tags'][aid]
    for tid in [k for k, v in st['notif'].items() if not v or now - v[-1][1] > 3 * 86400]:
        del st['notif'][tid]
    for p in [p for p in st['offsets'] if not os.path.exists(p)]:
        del st['offsets'][p]


# ---------------------------------------------------------------- status / tags

def cmd_status(args):
    hours = 2.0
    if '--hours' in args:
        try:
            hours = float(args[args.index('--hours') + 1])
        except (IndexError, ValueError):
            print('usage: agent-watch status [--hours N] [--json]', file=sys.stderr)
            return 2
    now = now_ts()
    st = load_state(readonly=True)
    agents = collect(st, now, hours * 3600)        # in-memory only: nothing is saved
    if '--json' in args:                           # machine form (agentfeed / the dashboard's Agents tab): metadata only
        rows = []
        for a in sorted(agents.values(), key=lambda a: -a['mtime']):
            meta = a['meta']
            rows.append({'id': a['id'], 'session': a['session'], 'status': a['status'], 'kind': a['kind'],
                         'start': round(run_start(a, st['agents'].get(a['id']) or {}), 1), 'last': round(a['mtime'], 1),
                         'description': a['desc'], 'title': a['title'], 'type': meta.get('agentType'), 'effort': meta.get('effort'),
                         'depth': meta.get('spawnDepth'), 'parent': meta.get('parentAgentId')})
        print(json.dumps({'now': round(now, 1), 'hours': hours, 'agents': rows}))
        return 0
    print(f"agent-watch {datetime.fromtimestamp(now, TZ):%Y-%m-%d %H:%M} Zurich: subagents written in the last "
          f"{hours:g} h (stalled = no growth >{STALL // 60} min)")
    if not agents:
        print('  (none)')
        return 0
    rows = [('ID', 'STATE', 'RUN', 'SILENT', 'LAST', 'OWNER TAG', 'DESCRIPTION')]
    order = {'stalled': 0, 'running': 1}
    for a in sorted(agents.values(), key=lambda a: (order.get(a['status'], 2), -a['mtime'])):
        prev = st['agents'].get(a['id']) or {}
        start = run_start(a, prev)
        end = now if a['status'] in ('running', 'stalled') else a['mtime']
        tag = st['tags'].get(a['id']) or {}
        t = '-'
        if tag.get('role') == 'owner':
            t = (a['override'] or tag.get('title') or a['desc'])[:22]
            if prev.get('last_progress'):
                t += f" (⏳{hm(prev['last_progress'])})"
        rows.append((a['id'], a['status'], f"{mins(end - start)}m", f"{mins(now - a['mtime'])}m",
                     a['kind'] or '?', t, f"{a['override']} (was: {a['desc']})" if a['override'] else a['desc']))
    w = [max(len(r[i]) for r in rows) for i in range(6)]
    for r in rows:
        print('  ' + '  '.join(r[i].ljust(w[i]) for i in range(6)) + '  ' + r[6])
    return 0


def resolve(prefix, st):
    if not re.fullmatch(r'[A-Za-z0-9_-]{3,64}', prefix or ''):
        return None, f"not an agent id: {prefix!r}"
    known = set(discover(now_ts(), None)) | set(st['agents']) | set(st['tags'])
    hits = sorted(k for k in known if k.startswith(prefix))
    if len(hits) == 1:
        return hits[0], None
    if len(hits) > 1:
        return None, f"ambiguous prefix {prefix!r}: " + ', '.join(hits[:5])
    if re.fullmatch(r'a[0-9a-f]{16}', prefix):
        return prefix, 'note: no transcript for it yet; tagged anyway'
    return None, f"no agent matches {prefix!r}"


def cmd_tag(args):
    if len(args) < 2 or args[1] not in ('owner',):
        print('usage: agent-watch tag ID|PREFIX owner ["Short title"]', file=sys.stderr)
        return 2
    title = ' '.join(args[2:]).strip()
    with Lock(wait=True):
        st = load_state()
        aid, msg = resolve(args[0], st)
        if not aid:
            print(msg, file=sys.stderr)
            return 1
        if msg:
            print(msg, file=sys.stderr)
        if not title:
            found = discover(now_ts(), None).get(aid)
            title = str((read_meta(found['path']) if found else {}).get('description') or aid)[:60]
            if agent_titles:
                title = agent_titles.title(aid, title)
        st['tags'][aid] = {'role': 'owner', 'title': title[:80], 'at': now_ts()}
        save_state(st)
    print(f'tagged {aid} owner: "{title[:80]}"')
    return 0


def cmd_untag(args):
    if len(args) != 1:
        print('usage: agent-watch untag ID|PREFIX', file=sys.stderr)
        return 2
    with Lock(wait=True):
        st = load_state()
        hits = [k for k in st['tags'] if k.startswith(args[0])]
        if len(hits) != 1:
            print(f"no single tag matches {args[0]!r}", file=sys.stderr)
            return 1
        del st['tags'][hits[0]]
        save_state(st)
    print(f"untagged {hits[0]}")
    return 0


def cmd_tags(args):
    st = load_state(readonly=True)
    if not st['tags']:
        print('(no tags)')
    for aid, t in sorted(st['tags'].items(), key=lambda kv: kv[1].get('at', 0)):
        print(f"{aid}  {t.get('role')}  \"{t.get('title')}\"  (tagged {hm(t.get('at', 0))})")
    return 0


def report_crash(cmd):
    """Log the traceback; one inbox note per distinct error per day (errors.json lives outside state.json)."""
    tb = traceback.format_exc()
    exc = sys.exc_info()[1]
    sig = hashlib.sha1(f"{type(exc).__name__}:{str(exc)[:100]}:{tb.strip().splitlines()[-3:-1]}".encode()).hexdigest()[:12]
    log(f"CRASH in {cmd}: {type(exc).__name__}: {str(exc)[:200]}\n{tb}")
    try:
        try:
            with open(ERRORS) as f:
                seen = json.load(f)
        except (OSError, ValueError):
            seen = {}
        now = time.time()
        if now - seen.get(sig, 0) > 86400:
            seen[sig] = now
            write_note('crash', sig, f"agent-watch {cmd} crashed: {type(exc).__name__}: {str(exc)[:200]}\n"
                                     f"Traceback in {LOG}. The watchdog is blind until this is fixed. Next: read the traceback and fix "
                                     "~/bin/agent-watch on a copy (tests: test-all --suite agent-watch).", now)
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(ERRORS, 'w') as f:
                json.dump({k: v for k, v in seen.items() if now - v < 7 * 86400}, f)
    except OSError:
        pass


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ('help', [])
    fn = {'run': cmd_run, 'status': cmd_status, 'tag': cmd_tag, 'untag': cmd_untag, 'tags': cmd_tags}.get(cmd)
    if not fn:
        print(__doc__.strip())
        return 0 if cmd in ('help', '-h', '--help') else 2
    try:
        return fn(args)
    except BlockingIOError:
        print('agent-watch: state is locked by another run, try again', file=sys.stderr)
        return 1
    except Exception:
        if cmd == 'run':
            report_crash(cmd)
            return 1
        raise


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
