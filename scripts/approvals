#!/usr/local/bin/python3.13 -I
"""approvals: one-time approvals the owner gives with a tap: nonce + action sha256 + expiry, single
use; `approvals --help`. Source: ~/opt/assistant (packages/approvals, schemas/approvals.sql, adapters/tg).

Finds its libraries next to itself: deployed, ~/bin/lib/{core,approvals}; in the repo, ../core and
../packages/approvals. $ASSISTANT_LIB (a directory holding core/ and approvals/) overrides both. Stdlib only.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_roots = [
    os.environ.get("ASSISTANT_LIB", ""),
    os.path.join(_here, "lib"),
    os.path.join(_here, ".."),
    os.path.join(_here, "..", "packages"),
]
for _pkg in ("core", "approvals"):
    for _r in _roots:
        if _r and os.path.isfile(os.path.join(_r, _pkg, "__init__.py")):
            _r = os.path.abspath(_r)
            if _r not in sys.path:
                sys.path.insert(0, _r)
            break

if __name__ == "__main__":
    from approvals import cli

    try:
        sys.exit(cli.main())
    except BrokenPipeError:  # a reader that quit early (| head)
        sys.exit(0)
