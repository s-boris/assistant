for _p in (os.path.join(_HERE, 'lib'), os.path.dirname(_HERE)):
    if os.path.isdir(os.path.join(_p, 'core')):
        sys.path.insert(0, _p)
        break
from core import jsonstate, locks, notes  # noqa: E402

E = os.environ.get
HOME = os.path.expanduser('~')
STATE = E('BOARD_STATE') or os.path.join(HOME, '.local/state/board')
TODO = E('BOARD_TODO') or os.path.join(HOME, 'workspace/TODO.md')
PROACTIVE = E('BOARD_PROACTIVE') or os.path.join(HOME, 'workspace/PROACTIVE.md')
INBOX = E('BOARD_INBOX') or os.path.join(HOME, 'inbox')
TODO_LOCK = E('BOARD_TODO_LOCK') or os.path.join(STATE, 'todo.lock')
DEPLOYS = E('BOARD_DEPLOYS') or os.path.join(HOME, '.local/state/assistant/deploys.jsonl')
REPO = E('BOARD_REPO') or os.path.join(HOME, 'opt/assistant')
BIN = E('BOARD_BIN') or os.path.join(HOME, 'bin')
CMD_ALLOW_FILE = E('BOARD_CMD_ALLOW') or os.path.join(HOME, '.config/assistant/board-cmd-allow')
STORE_FILE = E('BOARD_STORE_FILE')
FEED = os.path.join(STATE, 'board.json')
