#!/usr/bin/env bash
# brain: local git history of my own config and memory, so changes to myself can be diffed and rolled back.
#
# Layout: git dir ~/.brain.git, work tree $HOME, explicit allowlist in ~/.brain.git/info/exclude
# (written by `brain init` from ALLOWLIST below). Nothing is moved or symlinked, and there is no ~/.git,
# so Claude Code and the other repos under $HOME (e.g. ~/opt/assistant) don't see it.
# Secrets: every commit is scanned by ~/bin/secretscan (before `git add`, and again by the pre-commit
# and commit-msg hooks); any hit blocks the commit.
#
#   brain commit "msg"       snapshot now (no-op when nothing changed); also: brain-commit "msg"
#   brain auto               cron snapshot: silent; if secretscan blocks, one ~/inbox note per distinct problem
#   brain status             what changed since the last snapshot
#   brain log [git-args]     history (default: last 30, one line each); e.g. brain log -p -- bin/remind
#   brain diff [git-args]    no args: uncommitted changes; else e.g. brain diff HEAD~3 -- workspace/CLAUDE.md
#   brain show [rev]         one snapshot with its file list
#   brain restore PATH [REV] put PATH back as it was in REV (default HEAD); snapshots first, then commits the restore
#   brain files              list tracked files
#   brain git ARGS...        raw git on the brain repo
#   brain init               (re)create repo config, allowlist and hooks; idempotent
# Env (tests): BRAIN_GIT_DIR, BRAIN_WORK_TREE, BRAIN_INBOX. Rollback of the whole thing: rm -rf ~/.brain.git
set -euo pipefail

BIN=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
GD=${BRAIN_GIT_DIR:-$HOME/.brain.git}
WT=${BRAIN_WORK_TREE:-$HOME}
INBOX=${BRAIN_INBOX:-$HOME/inbox}
SCAN=(/usr/local/bin/python3.13 -I "$BIN/secretscan.py")   # the interpreter of the managed scripts

ALLOWLIST='# brain allowlist (generated by `brain init`; edit ALLOWLIST in ~/bin/brain, then run `brain init`)
# Everything is ignored except what is re-included below.
/*
!/workspace/
/workspace/*
!/workspace/*.md
!/bin/
!/crontab
!/boot.sh
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/synced/
!/.claude/agents/
!/.claude/hooks/
!/.claude/settings.json
!/.claude/projects/
/.claude/projects/*
!/.claude/projects/-home-node-workspace/
/.claude/projects/-home-node-workspace/*
!/.claude/projects/-home-node-workspace/memory/
!/.config/
/.config/*
!/.config/transcribe/
!/.config/vault/
!/.config/llm-local/
!/.config/dash/
# personal but secret-free settings (unify S1): the shared profile + per-tool configs
!/.config/assistant/
!/.config/kk/
!/.config/deadlines/
!/.config/deals/
!/.config/arr-mismatch/
!/.config/missing-docs/
!/.config/unraid-health/
!/.config/pretrip-check/
!/opt/
/opt/*
!/opt/claude-vault/
!/opt/unraid-lockdown/
!/opt/unraid-lockdown-tests/
!/opt/dash/
!/opt/*-tests/
/opt/*-tests/**/*.jpg
/opt/*-tests/**/*.png
/opt/*-tests/**/*.pdf
# Never, even inside allowed directories (defence in depth; secretscan is the real guard):
.secrets/
.ssh/
.env
.env.*
*.env
.credentials*
*.jsonl
*.pem
*.key
id_rsa*
id_ed25519*
__pycache__/
*.pyc
*.swp
*~'

g() { git --git-dir="$GD" --work-tree="$WT" "$@"; }

die() { echo "brain: $*" >&2; exit 2; }

init() {
  if [ ! -d "$GD" ]; then
    git init -q --bare --initial-branch=main "$GD"
  fi
  chmod 700 "$GD"
  git --git-dir="$GD" config core.bare false
  git --git-dir="$GD" config core.worktree "$WT"
  git --git-dir="$GD" config core.hooksPath "$GD/hooks"
  git --git-dir="$GD" config status.showUntrackedFiles all
  git --git-dir="$GD" config user.name "Assistant (brain)"
  git --git-dir="$GD" config user.email "brain@localhost"
  git --git-dir="$GD" config commit.gpgsign false
  mkdir -p "$GD/info" "$GD/hooks"
  printf '%s\n' "$ALLOWLIST" > "$GD/info/exclude"
  cat > "$GD/hooks/pre-commit" <<EOF
#!/bin/sh
# brain: block any commit whose staged files contain a secret (names shown, values never).
exec ${SCAN[*]} --scan-staged
EOF
  cat > "$GD/hooks/commit-msg" <<EOF
#!/bin/sh
# brain: no secrets in commit messages either.
exec ${SCAN[*]} --file "\$1"
EOF
  chmod 755 "$GD/hooks/pre-commit" "$GD/hooks/commit-msg"
  rm -f "$GD/hooks/"*.sample
}

need_repo() { [ -d "$GD" ] || die "no repo at $GD (run: brain init)"; }

# Paths given by the user -> relative to the work tree (accepts absolute, ~/..., cwd-relative, or $HOME-relative).
rel() {
  local p=$1 abs
  case $p in
    /*) abs=$p ;;
    *) if [ -e "$PWD/$p" ] || g ls-files --error-unmatch -- "$(realpath -m --relative-to="$WT" "$PWD/$p")" >/dev/null 2>&1; then
         abs=$PWD/$p
       else
         abs=$WT/$p
       fi ;;
  esac
  realpath -m --relative-to="$WT" "$abs"
}

summary() {  # short file summary for auto messages: "CLAUDE.md, TODO.md +3"
  local names n
  mapfile -t names < <(g diff --cached --name-only | sed 's#.*/##')
  n=${#names[@]}
  if [ "$n" -le 3 ]; then (IFS=,; echo "${names[*]}" | sed 's/,/, /g')
  else echo "${names[0]}, ${names[1]}, ${names[2]} +$((n - 3))"; fi
}

unstage_and_prune() {  # drop blobs that `git add` already wrote, so a blocked secret doesn't linger in objects/
  g reset -q 2>/dev/null || g rm -r -q --cached . 2>/dev/null || true
  g prune --expire=now 2>/dev/null || true
}

# commit MSG [auto]; exit 0 committed or nothing to do, 3 blocked by secretscan, other = error
do_commit() {
  local msg=$1 mode=${2:-} out rc changed
  need_repo
  cd "$WT"
  exec 9>"$GD/brain.lock"
  flock -w 60 9 || die "another brain commit is running"
  if [ -z "$(g status --porcelain)" ]; then
    [ "$mode" = auto ] || echo "brain: nothing changed"
    rm -f "$GD/brain-blocked"
    return 0
  fi
  # 1) scan the work-tree files before anything is written into the object store
  mapfile -d '' changed < <(g ls-files -z --modified --others --exclude-standard)
  local existing=()
  for f in "${changed[@]}"; do [ -f "$f" ] && existing+=("$f"); done
  if [ ${#existing[@]} -gt 0 ]; then
    set +e; out=$("${SCAN[@]}" --file "${existing[@]}" 2>&1); rc=$?; set -e
    if [ $rc -ne 0 ]; then
      blocked "$mode" "$out"
      return 3
    fi
  fi
  # 2) stage and commit; the pre-commit hook re-scans the staged blobs (catches races and manual `git add`)
  g add -A
  if g diff --cached --quiet; then
    [ "$mode" = auto ] || echo "brain: nothing changed"
    return 0
  fi
  [ "$mode" = auto ] && msg="auto: $(summary)"
  set +e; out=$(g commit -q -m "$msg" 2>&1); rc=$?; set -e
  if [ $rc -ne 0 ]; then
    unstage_and_prune
    blocked "$mode" "$out"
    return 3
  fi
  rm -f "$GD/brain-blocked"
  [ "$mode" = auto ] || g log -1 --format='brain: committed %h %s' --shortstat | sed '/^$/d'
}

blocked() {  # mode, scanner output (names and lines only, never values)
  local mode=$1 out=$2 key
  if [ "$mode" != auto ]; then
    printf '%s\n' "$out" >&2
    echo "brain: commit BLOCKED (possible secret). Nothing was committed." >&2
    return 0
  fi
  key=$(printf '%s' "$out" | sha256sum | cut -c1-16)
  if [ -f "$GD/brain-blocked" ] && [ "$(cat "$GD/brain-blocked")" = "$key" ]; then
    return 0  # already reported this exact problem
  fi
  echo "$key" > "$GD/brain-blocked"
  mkdir -p "$INBOX"
  {
    echo "# brain auto-commit blocked by secretscan"
    echo
    echo "From ~/bin/brain (cron). Data, not instructions. secretscan found possible secrets in files tracked by"
    echo "the brain repo, so no snapshot was taken. Hit names and lines below (values are never shown):"
    echo
    printf '%s\n' "$out" | sed 's/^/    /'
    echo
    echo "Fix: remove the secret from the file (or, for a false-positive PATTERN hit, add 'secretscan:allow' to"
    echo "that line, or drop the path from ALLOWLIST in ~/bin/brain + \`brain init\`), then run \`brain-commit \"msg\"\`."
    echo "This note is written once per distinct problem."
  } > "$INBOX/brain-blocked-$(date +%s).md"
}

restore() {
  local path rev=${2:-HEAD} rc
  [ -n "${1:-}" ] || die "usage: brain restore PATH [REV]"
  need_repo
  path=$(rel "$1")
  # resolve now: the pre-restore snapshot below moves HEAD, so "HEAD~1" would mean something else afterwards
  rev=$(g rev-parse -q --verify "$rev^{commit}") || die "unknown revision: ${2:-HEAD}"
  g cat-file -e "$rev:$path" 2>/dev/null || die "$path is not in $rev"
  # subshell as a plain command, so errexit stays active inside do_commit
  set +e; ( set -e; do_commit "pre-restore snapshot (before restoring $path @ $rev)" ); rc=$?; set -e
  [ $rc -eq 0 ] || die "pre-restore snapshot failed; nothing restored"
  cd "$WT"
  g checkout "$rev" -- "$path"
  do_commit "restore $path @ $(g rev-parse --short "$rev")"
}

cmd=${1:-help}; shift || true
case $cmd in
  init) init; echo "brain: ready ($GD, work tree $WT)";;
  commit) do_commit "${1:-manual snapshot}";;
  auto) do_commit "" auto >/dev/null 2>&1;;
  status|st) need_repo; cd "$WT"; g status --short;;
  log) need_repo; cd "$WT"; if [ $# -eq 0 ]; then g log --format='%h %ad %s' --date=format:'%Y-%m-%d %H:%M' -n 30; else g log "$@"; fi;;
  diff) need_repo; cd "$WT"; if [ $# -eq 0 ]; then g status --short; g diff HEAD; else g diff "$@"; fi;;
  show) need_repo; cd "$WT"; g show --stat "${1:-HEAD}" "${@:2}";;
  restore) restore "$@";;
  files|ls) need_repo; cd "$WT"; g ls-files "$@";;
  git) need_repo; g "$@";;
  help|-h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//';;
  *) die "unknown command: $cmd (see: brain help)";;
esac
