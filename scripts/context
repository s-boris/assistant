STATE = os.environ.get('CONTEXT_STATE', os.path.join(HOME, '.local', 'state', 'context'))
REPORTS = os.environ.get('CONTEXT_UNRAID_REPORTS', os.path.join(HOME, 'reports', 'unraid'))
HN_BASE = os.environ.get('CONTEXT_HN_BASE', 'https://hacker-news.firebaseio.com/v0')
WEATHER_URL = os.environ.get('CONTEXT_WEATHER_URL', 'https://api.open-meteo.com/v1/forecast')
METEO_URL = os.environ.get('CONTEXT_METEO_URL', 'https://app-prod-ws.meteoswiss-app.ch/v2/plzDetail')
TG_TIMEOUT = int(os.environ.get('CONTEXT_TG_TIMEOUT', '2400'))
# Weather point: the home coordinates rounded to 2 decimals (about 1 km: enough for a forecast grid; the weather
# API never gets the exact home). PLZ: MeteoSwiss' id of the home postcode (postcode + '00').
LAT = round(float(assistant_profile.get('home.lat')), 2)
LON = round(float(assistant_profile.get('home.lon')), 2)
PLZ = str(assistant_profile.get('home.postcode')) + '00'
HOME_LABEL = (assistant_profile.get('home.town_aliases') or [''])[0] or assistant_profile.get('home.town')
UA = 'context/1.0 (personal daily snapshot; a few requests twice a day)'
STALE_MAX = 48 * 3600
TTL = {'hn': 2 * 3600, 'weather': 3 * 3600, 'capacity': 3600}
STATUSES = ('ok', 'stale', 'error', 'not set up', 'placeholder', 'skipped')
SIGNAL_TYPES = ('plan', 'event', 'problem', 'wish', 'purchase', 'request')
SIGNAL_DAYS = 14
HA_BANDS = {'near': '< 5 km from home', 'region': '5-50 km from home', 'far': '> 50 km from home'}
WANTS = ('reply', 'decision', 'meeting', 'document', 'payment', 'pickup', 'call', 'favour', 'info')
TOPICS = ('travel', 'party', 'sport', 'food', 'work', 'tech', 'games', 'media', 'shopping', 'home', 'admin',
          'family_event', 'birthday', 'logistics', 'other', 'private')
ISO_DATE = re.compile(r'\d{4}-\d{2}-\d{2}')
OLD_PRIVATE = ('telegram.md', 'signals.md', 'location.json')   # before privacy plan C; --cleanup-private
FILES = {k: os.path.join(STATE, v) for k, v in {
