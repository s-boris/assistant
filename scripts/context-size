#!/usr/local/bin/python3.13 -I
"""context-size: the main session's always-loaded context in tokens and its
hook outputs; `context-size --help`. Source: ~/opt/assistant (packages/ctxsize).

Finds its libraries next to itself: deployed, ~/bin/lib/{core,ctxsize}; in the repo, ../core and ../packages/ctxsize.
$ASSISTANT_LIB (a directory holding core/ and ctxsize/) overrides both. Stdlib only.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_roots = [
    os.environ.get("ASSISTANT_LIB", ""),
    os.path.join(_here, "lib"),
    os.path.join(_here, ".."),
    os.path.join(_here, "..", "packages"),
]
for _pkg in ("core", "ctxsize"):
    for _r in _roots:
        if _r and os.path.isfile(os.path.join(_r, _pkg, "__init__.py")):
            _r = os.path.abspath(_r)
            if _r not in sys.path:
                sys.path.insert(0, _r)
            break

if __name__ == "__main__":
    from ctxsize import cli

    try:
        sys.exit(cli.main())
    except BrokenPipeError:  # a reader that quit early (| head)
        sys.exit(0)
