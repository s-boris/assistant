def _private_file():
    path = os.environ.get("CONTRACTS_PROVIDERS") or os.path.expanduser("~/.config/contracts/providers.json")
    try:
        with open(path) as f:
            extra = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(extra, dict):
        return {}
    return {k: v for k, v in extra.items() if isinstance(v, (list, tuple)) and len(v) == 2}


def _private_providers():
    """More providers from a private file (his own banks etc. stay out of this public script):
    {"token": ["Display", "kind"], …} in CONTRACTS_PROVIDERS or ~/.config/contracts/providers.json.
    Kind "shop" entries are retailers for `warranty` (_private_shops), not providers."""
    return {fold(k): (v[0], v[1]) for k, v in _private_file().items() if v[1] in KIND_LABEL}


def _private_shops():
    return {fold(k): str(v[0]) for k, v in _private_file().items() if v[1] == "shop" and fold(k)}
