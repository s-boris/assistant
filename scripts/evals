sys.dont_write_bytecode = True
BIN = os.path.dirname(os.path.realpath(__file__))
for _d in (os.path.expanduser("~/bin"), BIN):
    sys.path.insert(0, os.path.join(_d, "lib"))
    sys.path.insert(0, _d)
try:
    import yaml
except Exception:  # pragma: no cover
    yaml = None
try:
    import secretscan
except Exception:  # pragma: no cover
    secretscan = None

HOME = os.path.expanduser("~")


def _find_lib():
    """The eval lib files: EVALS_LIB, next to this script, the CI tree (`assistant ci` runs the suite on an overlay
    without lib/evals), else ~/bin/lib/evals."""
    if os.environ.get("EVALS_LIB"):
        return os.environ["EVALS_LIB"]
    tree = os.environ.get("ASSISTANT_CI_TREE")
    for d in (os.path.join(BIN, "lib", "evals"), tree and os.path.join(tree, "scripts", "lib", "evals"),
              os.path.join(HOME, "bin", "lib", "evals")):
        if d and os.path.isdir(d):
            return d
    return os.path.join(BIN, "lib", "evals")


LIB = _find_lib()
CORPUS = os.environ.get("EVALS_CORPUS", f"{HOME}/opt/evals-private")
STATE = os.environ.get("EVALS_STATE", f"{HOME}/.local/state/evals")
JOBS = os.environ.get("EVALS_JOBS", f"{HOME}/jobs/evals")
REPORTS = os.environ.get("EVALS_REPORTS", f"{HOME}/reports/evals")
SHARE = os.environ.get("EVALS_SHARE", f"{HOME}/.local/share/evals")
VENV = os.environ.get("EVALS_VENV", f"{SHARE}/inspect-venv")
LOGDIR = os.environ.get("EVALS_LOGDIR", f"{STATE}/inspect-logs")
ASSISTANT_REPO = os.environ.get("ASSISTANT_REPO", f"{HOME}/opt/assistant")
os.environ.setdefault("EVALS_NETGUARD_SO", os.path.join(SHARE, "netguard-eval.so"))  # launch.sh without sudo (tests)
CLAUDE = os.environ.get("EVALS_CLAUDE", f"{HOME}/.local/bin/claude")
# The judge's effort, pinned (not the CLI default, which can drift): medium matched the default and high on 30 replayed
# judge prompts with 0 critical misses (~/reports/effort/effort-levels-2026-10-29.md).
JUDGE_EFFORT = os.environ.get("EVALS_JUDGE_EFFORT", "medium")
RUN_USER = os.environ.get("EVALS_USER", "evalbot")
NO_SUDO = os.environ.get("EVALS_NO_SUDO") == "1"
BRAIN_GIT = os.environ.get("BRAIN_GIT_DIR", f"{HOME}/.brain.git")
SETUP_PATHS = ["workspace/CLAUDE.md", "workspace/FACTS.md", "workspace/FACTS-core.md", "workspace/TOOLS.md", "workspace/JOBS.md", "workspace/GOALS.md",
               "workspace/PROBLEMS.md", ".claude/skills", ".claude/agents", ".claude/hooks", ".claude/settings.json",
               ".claude/projects/-home-node-workspace/memory"]
SKIP_RX = re.compile(r"(__pycache__|\.pyc$|\.bak|\.orig$|\.new$|/synced/|~$)")
EXTRA_STUBS = ["tg", "crontab", "sudo", "docker", "ssh", "scp", "gh", "claude", "start-claude", "at"]
DROP_HOOK_RX = re.compile(r"tg-status hook|usage-hook\.sh")
# --context: the facts import under test. core = CLAUDE.md imports the generated FACTS-core.md plus one sentence on
# where the rest lives.
FACTS_IMPORT_RX = re.compile(r"^@FACTS\.md[ \t]*$", re.M)
CORE_IMPORT = "@FACTS-core.md"
CORE_NOTE = ("The FACTS core above holds the basics, short facts and every ledger thing; the other facts and the ledger "
             "details come per message in the `memory2:` block, else `kb ask \"…\"`, `recall \"…\"`, "
             "`memory show --grep WORD` or ~/workspace/FACTS.md (the full file).")
ALWAYS_FULL, ALWAYS_CORE = "Always loaded: FACTS.md", "Always loaded: FACTS-core.md"
lock_print = threading.Lock()


# ---------------------------------------------------------------- utils
def now():
    return time.time()


def out(msg, quiet=False):
    if not quiet:
        with lock_print:
            print(msg, flush=True)


def jdump(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def redact(text):
    if not text or secretscan is None:
        return text
    try:
        return secretscan.redact(text)
    except Exception:
        return text


def leaks(text):
    if not text or secretscan is None:
        return []
    try:
        return [str(x[0] if isinstance(x, (list, tuple)) else x) for x in (secretscan.find(text) or [])]
    except Exception:
        return []


def sudo(args, **kw):
    """Run ARGS as the eval user (or directly when EVALS_NO_SUDO=1, tests)."""
    cmd = list(args) if NO_SUDO else ["sudo", "-n", "-u", RUN_USER, "--"] + list(args)
    return subprocess.run(cmd, **kw)


def root(args):
    if NO_SUDO:
        return subprocess.run(list(args), capture_output=True, text=True)
    return subprocess.run(["sudo", "-n"] + list(args), capture_output=True, text=True)


def rmtree_any(path):
    if not path or not os.path.isabs(path) or not path.startswith(JOBS + "/"):
        return
    if os.path.exists(path):
        root(["rm", "-rf", "--", path])


def drop_judge(rundir, cid=None):
    """Remove a judge sandbox (evalbot-owned after the chown) and the _judge/ folder once it is empty."""
    jroot = os.path.join(rundir, "_judge")
    rmtree_any(os.path.join(jroot, cid) if cid else jroot)
    try:
        os.rmdir(jroot)
    except OSError:
        pass


def gc_runs(days, active=False):
    """`evals gc`: whole run folders older than DAYS; in the others the leftovers of scoring (_judge/, _setup/, case
    sandbox homes of runs that crashed or were killed), unless a run is active right now. Kept runs (--keep) stay
    until they age out. Returns (runs removed, leftovers removed)."""
    d = os.path.join(JOBS, "runs")
    n = m = 0
    for x in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        p = os.path.join(d, x)
        if not os.path.isdir(p):
            continue
        if now() - os.path.getmtime(p) > days * 86400:
            rmtree_any(p)
            n += 1
            continue
        if active:
            continue
        kept = any(os.path.exists(os.path.join(p, c, "stream.jsonl")) for c in os.listdir(p))
        for y in os.listdir(p):
            q = os.path.join(p, y)
            if y in ("_judge", "_setup", "_iso") or (not kept and os.path.isdir(os.path.join(q, "home"))):
                rmtree_any(q if y.startswith("_") else os.path.join(q, "home"))
                m += 1
        try:
            os.rmdir(p)
        except OSError:
            pass
    return n, m


def git(*args, check=True):
    p = subprocess.run(["git", "--git-dir", BRAIN_GIT, "--work-tree", HOME] + list(args), capture_output=True)
    if check and p.returncode:
        raise SystemExit(f"evals: git {' '.join(args)}: {p.stderr.decode(errors='replace').strip()[:300]}")
    return p.stdout


def rev_name(rev):
    return git("rev-parse", "--short", rev).decode().strip()


def slug(path):
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def usage_log(**kw):
    try:
        from usage import log
        log("bin.evals", **kw)
    except Exception:
        pass


# ---------------------------------------------------------------- corpus
def load_yaml(path):
    if yaml is None:
        raise SystemExit("evals: python3-yaml is missing")
    with open(path) as f:
        return yaml.safe_load(f) or {}


def load_corpus():
    cfg_p = os.path.join(CORPUS, "config.yaml")
    if not os.path.exists(cfg_p):
        raise SystemExit(f"evals: no corpus at {CORPUS} (config.yaml missing)")
    cfg = load_yaml(cfg_p)
    cases, seen = [], set()
    cdir = os.path.join(CORPUS, "cases")
    for fn in sorted(os.listdir(cdir)) if os.path.isdir(cdir) else []:
        if not fn.endswith((".yaml", ".yml")):
            continue
        doc = load_yaml(os.path.join(cdir, fn))
        for c in (doc.get("cases") if isinstance(doc, dict) else doc) or []:
            if not isinstance(c, dict) or not c.get("id"):
                continue
            if c["id"] in seen:
                raise SystemExit(f"evals: duplicate case id {c['id']} ({fn})")
            seen.add(c["id"])
            c["_file"] = fn
            c["_hash"] = hashlib.sha256(json.dumps({k: v for k, v in c.items() if not k.startswith("_")},
                                                   sort_keys=True, default=str).encode()).hexdigest()[:12]
            cases.append(c)
    return cfg, cases


def case_covers(cfg, c):
    cov = list(c.get("covers") or [])
    cov += list(((cfg.get("areas") or {}).get(c.get("area")) or {}).get("covers") or [])
    return cov


def select(cfg, cases, a):
    sel = cases
    if a.case:
        sel = [c for c in sel if any(fnmatch.fnmatch(c["id"], g) for g in a.case)]
    if a.tag:
        sel = [c for c in sel if set(a.tag) & set(c.get("tags") or []) or c.get("area") in a.tag]
    if a.area:
        sel = [c for c in sel if c.get("area") in a.area]
    info = {"mode": "filter" if (a.case or a.tag or a.area) else "all"}
    if getattr(a, "changed", False) or getattr(a, "paths", None):
        if getattr(a, "paths", None):
            since, paths = "paths", map_paths(a.paths)
        else:
            since = a.since or read_last_rev() or "HEAD~1"
            paths = set()
            try:
                paths |= set(git("diff", "--name-only", since, "HEAD").decode().split())
            except SystemExit:
                pass
            if not getattr(a, "rev", None):
                paths |= set(git("diff", "--name-only", "HEAD", check=False).decode().split())
        globs = cfg.get("global_paths") or []
        glob_hit = any(fnmatch.fnmatch(p, g) for p in paths for g in globs)
        chosen = [c for c in sel if any(fnmatch.fnmatch(p, g) for p in paths for g in case_covers(cfg, c))]
        if glob_hit:
            chosen += [c for c in sel if "core" in (c.get("tags") or []) and c not in chosen]
        info = {"mode": "changed", "since": since, "paths": sorted(paths)[:200], "global": glob_hit}
        sel = [c for c in sel if c in chosen]
    if len(sel) > a.max_cases:
        info["truncated"] = len(sel)
        sel = sel[:a.max_cases]
    return sel, info


def map_paths(paths):
    """Changed paths -> the setup paths cases cover: HOME-relative paths as given, plus the deployed path of an
    ~/opt/assistant source (manifest src -> dest; core/X -> bin/lib/core/X), so a repo diff selects cases too."""
    man = {}
    try:
        import tomllib
        with open(os.path.join(ASSISTANT_REPO, "ops", "deploy", "manifest.toml"), "rb") as f:
            man = {e["src"]: e["dest"] for e in tomllib.load(f).get("file", []) if e.get("src") and e.get("dest")}
    except Exception:
        pass
    got = set()
    for p in paths:
        p = str(p).strip()
        if p.startswith(HOME + "/"):
            p = os.path.relpath(p, HOME)
        if not p:
            continue
        got.add(p)
        if p in man:
            got.add(man[p])
        if p.startswith("core/"):
            got.add("bin/lib/" + p)
    return got


# ---------------------------------------------------------------- setup under test
def materialize(rev, dest):
    """Copy the setup under test (live files when rev is None, else brain REV) into dest; return its hash."""
    os.makedirs(dest, exist_ok=True)
    if rev:
        names = git("ls-tree", "-r", "--name-only", rev, "--", *SETUP_PATHS).decode().splitlines()
        if not names:
            raise SystemExit(f"evals: brain {rev} has none of the setup paths")
        data = git("archive", "--format=tar", rev, "--", *names)
        with tarfile.open(fileobj=io.BytesIO(data)) as t:
            for m in t.getmembers():
                if m.isfile() and not SKIP_RX.search(m.name) and ".." not in m.name.split("/"):
                    t.extract(m, dest)
    else:
        for rel in SETUP_PATHS:
            src = os.path.join(HOME, rel)
            if os.path.isdir(src):
                for dp, dn, fns in os.walk(src):
                    dn[:] = [d for d in dn if not SKIP_RX.search(d + "/")]
                    for fn in fns:
                        s = os.path.join(dp, fn)
                        r = os.path.relpath(s, HOME)
                        if SKIP_RX.search(r) or os.path.islink(s):
                            continue
                        os.makedirs(os.path.join(dest, os.path.dirname(r)), exist_ok=True)
                        shutil.copy2(s, os.path.join(dest, r))
            elif os.path.isfile(src):
                os.makedirs(os.path.join(dest, os.path.dirname(rel)), exist_ok=True)
                shutil.copy2(src, os.path.join(dest, rel))
    h = hashlib.sha256()
    for dp, dn, fns in sorted(os.walk(dest)):
        dn.sort()
        for fn in sorted(fns):
            p = os.path.join(dp, fn)
            h.update(os.path.relpath(p, dest).encode() + b"\0")
            with open(p, "rb") as f:
                h.update(hashlib.sha256(f.read()).digest())
    return h.hexdigest()[:16]


def sandbox_settings(setup, H, real_home):
    try:
        s = json.load(open(os.path.join(setup, ".claude/settings.json")))
    except Exception:
        s = {}
    keep = {k: s[k] for k in ("model", "effortLevel", "skipDangerousModePermissionPrompt", "autoCompactWindow") if k in s}
    perms = dict(s.get("permissions") or {})
    perms.pop("additionalDirectories", None)
    perms["defaultMode"] = "bypassPermissions"
    keep["permissions"] = perms
    keep["enabledPlugins"] = {}
    env = {k: v for k, v in (s.get("env") or {}).items() if not re.search(r"TOKEN|KEY|SECRET|PASS", k)}
    st = f"{H}/.local/state"
    env.update({"RISK_CHECK_LLM": "off", "RISK_CHECK_STATE": f"{st}/risk-check", "RISK_CHECK_LOG": f"{st}/risk-check.log",
                "NO_APPROVAL_LOG": f"{st}/no-approval.log", "PITCH_CHECK_LOG": f"{st}/pitch-check.log",
                "SUBAGENT_RULES_LOG": f"{st}/subagent-rules.log", "SUBAGENT_RULES_AGENTS_DIR": f"{H}/.claude/agents",
                "EVALS_REAL_HOME": real_home, "USAGE": "off"})
    keep["env"] = env
    hooks = {}
    for ev, groups in (s.get("hooks") or {}).items():
        for g in groups:
            hs = []
            for h in g.get("hooks", []):
                cmd = h.get("command", "")
                if DROP_HOOK_RX.search(cmd):
                    continue
                h = dict(h)
                h["command"] = cmd.replace(real_home + "/", H + "/")
                hs.append(h)
            if hs:
                hooks.setdefault(ev, []).append({**g, "hooks": hs})
    guard = {"matcher": "Bash|Monitor|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
             "hooks": [{"type": "command", "command": f"{H}/.eval/guard_hook.py", "timeout": 10}]}
    hooks["PreToolUse"] = [guard] + hooks.get("PreToolUse", [])
    keep["hooks"] = hooks
    return keep


def usage_header(path, max_lines=40):
    """The script's own doc header (module docstring or leading comment block), never executed."""
    try:
        with open(path, errors="replace") as f:
            head = f.read(12000)
    except OSError:
        return ""
    m = re.search(r'^[^\n]*\n(?:[^\n]*\n){0,6}?\s*(?:r|u)?("""|\'\'\')(.*?)\1', head, re.S)
    if m:
        return "\n".join(m.group(2).strip().splitlines()[:max_lines]) + "\n"
    lines = [l[1:].strip() for l in head.splitlines()[1:max_lines + 1] if l.startswith("#")]
    return "\n".join(lines) + "\n"


def channel_tag(cfg, c, text, i=0):
    meta = dict(c.get("meta") or {})
    owner = str(cfg.get("owner_id", "100000001"))
    uid = str(meta.pop("user_id", owner))
    chat = str(meta.pop("chat_id", owner if uid == owner else "-100" + uid))
    clock = c.get("clock") or cfg.get("clock")
    attrs = {"chat_id": chat, "message_id": str(meta.pop("message_id", 5000 + i)), "user": meta.pop("user", cfg.get("owner_name", "owner")),
             "user_id": uid, "ts": meta.pop("ts", clock)}
    if meta.get("via") == "voice":
        attrs.pop("message_id", None)
    attrs.update({k: str(v) for k, v in meta.items()})
    a = " ".join(f'{k}="{v}"' for k, v in attrs.items() if v is not None)
    return f'<channel source="plugin:telegram-plus:telegram" {a}>{text}</channel>'


def build_prompt(cfg, c):
    owner = str(cfg.get("owner_id", "100000001"))
    if c.get("prompt"):
        p = str(c["prompt"])
    else:
        msgs = c.get("msg")
        msgs = msgs if isinstance(msgs, list) else [msgs]
        p = "\n".join(channel_tag(cfg, c, m, i) for i, m in enumerate(msgs))
    return p.replace("{OWNER}", owner).replace("{CLOCK}", str(c.get("clock") or cfg.get("clock")))


def claude_md_variant(text, variant):
    """CLAUDE.md text with the facts import switched to `variant` (core | full); unchanged when it already is."""
    core_rx = re.compile(r"^" + re.escape(CORE_IMPORT) + r"[ \t]*\n(?:" + re.escape(CORE_NOTE) + r"\n)?", re.M)
    if variant == "core":
        if core_rx.search(text):
            return text
        if not FACTS_IMPORT_RX.search(text):
            raise SystemExit("evals: --context core: CLAUDE.md has no '@FACTS.md' line to switch")
        text = FACTS_IMPORT_RX.sub(lambda m: CORE_IMPORT + "\n" + CORE_NOTE, text, count=1)
        return text.replace(ALWAYS_FULL + " ", ALWAYS_CORE + " ", 1)
    if FACTS_IMPORT_RX.search(text) or not core_rx.search(text):
        return text
    return core_rx.sub("@FACTS.md\n", text, count=1).replace(ALWAYS_CORE + " ", ALWAYS_FULL + " ", 1)


def apply_context(setup, variant):
    """--context core|full on the materialized setup: core renders FACTS-core.md fresh from the memory rows
    (`memory render --core`, the tool next to this script) and switches the import; full switches it back."""
    cm = os.path.join(setup, "workspace", "CLAUDE.md")
    if not variant or not os.path.isfile(cm):
        return
    if variant == "core":
        core = os.path.join(setup, "workspace", "FACTS-core.md")
        mem = os.environ.get("EVALS_MEMORY_BIN") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "memory")
        r = subprocess.run([mem, "render", "--core", "--out", core], capture_output=True, text=True, timeout=120)
        if r.returncode != 0 and not os.path.isfile(core):
            raise SystemExit(f"evals: --context core: no FACTS core ({(r.stderr or r.stdout).strip()[:200]})")
    with open(cm, encoding="utf-8") as f:
        text = f.read()
    new = claude_md_variant(text, variant)
    if new != text:
        with open(cm, "w", encoding="utf-8") as f:
            f.write(new)


# --pack DIR: a candidate always-on pack replaces the materialized copies before the run, so a slimmer
# CLAUDE.md / FACTS-core.md / MEMORY.md is scored before the main session switches to it. Files present in DIR win;
# missing ones stay as materialized. The variant gets the pack's short hash.
PACK_FILES = {"CLAUDE.md": "workspace/CLAUDE.md", "FACTS-core.md": "workspace/FACTS-core.md",
              "MEMORY.md": ".claude/projects/-home-node-workspace/memory/MEMORY.md"}


def apply_pack(setup, pack_dir):
    """Copy DIR/{CLAUDE.md,FACTS-core.md,MEMORY.md} over the materialized setup; returns a short hash or ''."""
    if not pack_dir:
        return ""
    h = hashlib.sha256()
    found = 0
    for name, rel in PACK_FILES.items():
        src = os.path.join(pack_dir, name)
        if not os.path.isfile(src):
            continue
        with open(src, "rb") as f:
            data = f.read()
        h.update(name.encode() + b"\0" + data)
        dst = os.path.join(setup, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        with open(dst, "wb") as f:
            f.write(data)
        found += 1
    if not found:
        raise SystemExit(f"evals: --pack {pack_dir}: none of {', '.join(PACK_FILES)} there")
    return h.hexdigest()[:10]


def prep_memory_hook(a, cfg, cases, rundir):
    """--memory-hook on (default): the sandbox runs the live memory2 UserPromptSubmit hook as in the main session: its
    library, a facts-only copy of the store, and the cases' query vectors computed here (the sandbox has no loopback,
    so the hook reads MEMORY2_QVEC_CACHE). Returns the cfg additions ({} = hook inert)."""
    lib = os.path.join(HOME, "bin", "lib", "memory2_core.py")
    src = os.path.join(HOME, ".local", "state", "memory2", "mem.db")
    if getattr(a, "memory_hook", "on") == "off" or not (os.path.isfile(lib) and os.path.isfile(src)):
        return {}
    import importlib.util
    import sqlite3
    d = os.path.join(rundir, "_mem")
    os.makedirs(d, mode=0o700, exist_ok=True)
    db = os.path.join(d, "mem.db")
    s_con, d_con = sqlite3.connect(f"file:{src}?mode=ro", uri=True), sqlite3.connect(db)
    try:
        s_con.backup(d_con)
        for (name,) in d_con.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall():
            if name not in ("facts", "ffts", "meta") and not name.startswith(("ffts_", "sqlite_")):
                d_con.execute(f'DROP TABLE IF EXISTS "{name}"')
        d_con.commit()
        d_con.execute("VACUUM")
    finally:
        s_con.close()
        d_con.close()
    spec = importlib.util.spec_from_file_location("evals_m2core", lib)
    m2 = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m2)
    qs = sorted({m2.query_text(t) for t in (m2.prompt_text(build_prompt(cfg, c)) for c in cases)
                 if len(m2.terms_of(t)) >= 2})
    qv = {}
    if qs:
        try:
            qv = {hashlib.sha256(q.encode("utf-8")).hexdigest(): v for q, v in zip(qs, m2.embed(qs, timeout=120))}
        except Exception as e:  # noqa: BLE001 - embedder down: the hook still finds text matches
            out(f"evals: memory hook: no query vectors ({type(e).__name__}): text-only recall in the sandbox", a.quiet)
    jdump(os.path.join(d, "qvec.json"), qv)
    return {"_mem": {"lib": lib, "db": db, "qvec": os.path.join(d, "qvec.json"), "vectors": len(qv)}}


HUB_BOOT = ("import os,sys; sys.path[:0]=os.environ['TOOLS_SYSPATH'].split(os.pathsep); "
            "from tools.cli import main; sys.exit(main(sys.argv[1:]))")


def prep_hub(a, rundir):
    """--hub on (default): the sandbox gets the MCP server `hub` (the typed tools) like the main session. It runs
    the deployed tools package (a snapshot in the run dir) in a world-readable copy of its venv; HOME is the sandbox,
    so every CLI it wraps resolves to the stubs (no real vault/HA/phone call). Returns the cfg additions."""
    if getattr(a, "hub", "on") == "off":
        return {}
    lib = os.path.join(HOME, "bin", "lib")
    lock = os.path.join(lib, "tools", "requirements.lock")
    if not (os.path.isfile(os.path.join(lib, "tools", "cli.py")) and os.path.isfile(lock)):
        out("evals: --hub: the tools package is not deployed (~/bin/lib/tools): no hub in the sandbox", a.quiet)
        return {}
    digest_ = hashlib.sha256(open(lock, "rb").read()).hexdigest()[:12]
    src = os.path.join(HOME, ".local", "share", "assistant", "venvs", f"tools-{digest_}")
    if not os.path.exists(os.path.join(src, "bin", "python")):
        subprocess.run([os.path.join(HOME, "bin", "tool"), "serve", "--check"], capture_output=True, timeout=600)
    dst = os.path.join(SHARE, f"hub-venv-{digest_}")
    if not os.path.exists(os.path.join(dst, "bin", "python")):
        if not os.path.exists(os.path.join(src, "bin", "python")):
            out("evals: --hub: no tools venv (`tool serve --check` failed): no hub in the sandbox", a.quiet)
            return {}
        tmp = f"{dst}.tmp{os.getpid()}"
        shutil.rmtree(tmp, ignore_errors=True)
        subprocess.run(["cp", "-a", src, tmp], check=True)
        subprocess.run(["chmod", "-R", "a+rX", tmp], check=True)
        os.replace(tmp, dst)
        for old in glob.glob(os.path.join(SHARE, "hub-venv-*")):
            if old != dst and ".tmp" not in old and os.path.getmtime(old) < now() - 14 * 86400:
                shutil.rmtree(old, ignore_errors=True)
    snap = os.path.join(rundir, "_hub", "lib")
    ign = shutil.ignore_patterns("__pycache__", "*.pyc", "*.bak", "*.orig", "*.new")
    for pkg in ("core", "tools"):
        shutil.copytree(os.path.realpath(os.path.join(lib, pkg)), os.path.join(snap, pkg), ignore=ign, dirs_exist_ok=True)
    tree = hashlib.sha256()
    for dp, dn, fns in sorted(os.walk(snap)):
        dn.sort()
        for fn in sorted(fns):
            fp = os.path.join(dp, fn)
            tree.update(os.path.relpath(fp, snap).encode() + b"\0" + open(fp, "rb").read())
    return {"_hub": {"lib": snap, "python": os.path.join(dst, "bin", "python"), "hash": tree.hexdigest()[:12]}}


def build_sandbox(cfg, c, setup, casedir):
    H = os.path.join(casedir, "home")
    os.makedirs(H)
    for sub in ("bin", "inbox", ".eval", "tmp", ".secrets", ".local/state", "workspace", ".claude/channels/telegram"):
        os.makedirs(os.path.join(H, sub), exist_ok=True)
    # setup under test
    for rel in os.listdir(setup):
        src = os.path.join(setup, rel)
        dst = os.path.join(H, rel)
        shutil.copytree(src, dst, dirs_exist_ok=True) if os.path.isdir(src) else shutil.copy2(src, dst)
    mh = cfg.get("_mem")
    if mh:  # the memory2 hook's library, store copy and query vectors (prep_memory_hook)
        os.makedirs(os.path.join(H, "bin", "lib"), exist_ok=True)
        shutil.copy2(mh["lib"], os.path.join(H, "bin", "lib", "memory2_core.py"))
        os.makedirs(os.path.join(H, ".local", "state", "memory2"), exist_ok=True)
        shutil.copy2(mh["db"], os.path.join(H, ".local", "state", "memory2", "mem.db"))
        shutil.copy2(mh["qvec"], os.path.join(H, ".eval", "qvec.json"))
    mem_src = os.path.join(H, ".claude/projects/-home-node-workspace/memory")
    mem_dst = os.path.join(H, ".claude/projects", slug(os.path.join(H, "workspace")), "memory")
    if os.path.isdir(mem_src) and mem_src != mem_dst:
        shutil.copytree(mem_src, mem_dst, dirs_exist_ok=True)
        shutil.rmtree(os.path.dirname(mem_src))
    # fixtures: corpus defaults, then the case's own files
    fx = os.path.join(CORPUS, cfg.get("fixtures", "fixtures/default"))
    if os.path.isdir(fx):
        shutil.copytree(fx, H, dirs_exist_ok=True)
    for rel, body in (c.get("files") or {}).items():
        p = os.path.normpath(os.path.join(H, rel))
        if not p.startswith(H + "/"):
            raise SystemExit(f"evals: case {c['id']}: file path escapes the sandbox: {rel}")
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f:
            f.write(str(body))
    # stubs for every ~/bin script + extras
    stub = os.path.join(H, "bin", "_evalstub")
    shutil.copy2(os.path.join(LIB, "evalstub.py"), stub)
    os.chmod(stub, 0o755)
    names = set(EXTRA_STUBS)
    for fn in os.listdir(os.path.join(HOME, "bin")):
        p = os.path.join(HOME, "bin", fn)
        if os.path.isfile(p) and os.access(p, os.X_OK) and not fn.startswith((".", "_")) and not SKIP_RX.search(fn):
            names.add(fn)
    if c.get("clock") or cfg.get("clock") or cfg.get("stub_date"):  # the sandbox clock everywhere (tripclock agrees)
        names.add("date")
    os.makedirs(os.path.join(H, ".eval", "help"), exist_ok=True)
    for n in sorted(names):
        os.symlink("_evalstub", os.path.join(H, "bin", n))
        hp = os.path.join(HOME, "bin", n)
        if os.path.isfile(hp):
            with open(os.path.join(H, ".eval", "help", n + ".txt"), "w") as f:
                f.write(usage_header(hp))
    for fn in ("guard_hook.py", "fake_mcp.py"):
        shutil.copy2(os.path.join(LIB, fn), os.path.join(H, ".eval", fn))
    os.chmod(os.path.join(H, ".eval", "guard_hook.py"), 0o755)
    owner = str(cfg.get("owner_id", "100000001"))
    jdump(os.path.join(H, ".claude/channels/telegram/access.json"), {"dmPolicy": "allowlist", "allowFrom": [owner], "groups": {}})
    st = sandbox_settings(setup, H, HOME)
    if mh:
        st.setdefault("env", {}).update({"MEMORY2_QVEC_CACHE": f"{H}/.eval/qvec.json", "MEMORY2_HOOK_SEM": "off"})
    jdump(os.path.join(H, ".claude/settings.json"), st)
    mcp = {"mcpServers": {
        "plugin_telegram-plus_telegram": {"command": "/usr/bin/python3", "args": ["-I", f"{H}/.eval/fake_mcp.py", "telegram"]},
        "claude_ai_Google_Calendar": {"command": "/usr/bin/python3", "args": ["-I", f"{H}/.eval/fake_mcp.py", "calendar"]}}}
    hub = cfg.get("_hub")
    if hub:
        hl = os.path.join(H, ".eval", "hub", "lib")
        shutil.copytree(hub["lib"], hl, dirs_exist_ok=True)
        # the sandbox path in its command line (a comment in the -c code): the per-case pkill -f finds the server
        mcp["mcpServers"]["hub"] = {"command": hub["python"], "args": ["-I", "-c", f"{HUB_BOOT}  # {H}", "serve"],
                                    "env": {"TOOLS_SYSPATH": hl, "ASSISTANT_LIB": hl, "USAGE": "off"}}
    jdump(os.path.join(H, ".eval/mcp.json"), mcp)
    fixture = {"clock": c.get("clock") or cfg.get("clock"), "tz_name": cfg.get("tz_name", "home time"),
               "driving": bool(c.get("driving")), "sleepin": bool(c.get("sleepin")),
               "stubs": list(c.get("stubs") or []) + list(cfg.get("stubs") or []),
               "mcp": list(c.get("mcp") or []), "calendar": list(c.get("calendar") or cfg.get("calendar") or []),
               "state": dict(c.get("state") or {})}
    jdump(os.path.join(H, ".eval/case.json"), fixture)
    if not NO_SUDO:
        r = root(["chown", "-R", f"{RUN_USER}:{RUN_USER}", H])
        if r.returncode:
            raise SystemExit(f"evals: chown failed: {r.stderr.strip()[:200]}")
    return H


# ---------------------------------------------------------------- auth
def access_token(min_left_s):
    if NO_SUDO and os.environ.get("EVALS_TEST_TOKEN"):  # offline tests: a fake value, never a real login
        return os.environ["EVALS_TEST_TOKEN"], now() + 86400
    cred = os.path.join(HOME, ".claude/.credentials.json")

    def read():
        try:
            o = json.load(open(cred)).get("claudeAiOauth") or {}
            return o.get("accessToken"), (o.get("expiresAt") or 0) / 1000.0
        except Exception:
            return None, 0

    tok, exp = read()
    if tok and exp - now() < min_left_s:
        env = {"HOME": HOME, "PATH": "/usr/local/bin:/usr/bin:/bin", "LANG": "C.UTF-8", "USER": "node", "DISABLE_AUTOUPDATER": "1"}
        os.makedirs(JOBS, exist_ok=True)
        subprocess.run([CLAUDE, "-p", "Reply with just OK.", "--model", "haiku", "--max-turns", "1", "--setting-sources", "local",
                        "--strict-mcp-config", "--no-session-persistence"], cwd=JOBS, env=env, capture_output=True,
                       timeout=120, stdin=subprocess.DEVNULL)
        tok, exp = read()
    if not tok:
        raise SystemExit("evals: no model access token")
    return tok, exp


# ---------------------------------------------------------------- run one case
def run_worker(casedir, H, prompt, token, a, tz):
    args = [os.path.join(LIB, "launch.sh"), casedir, tz, str(a.case_timeout), "--", CLAUDE, "-p",
            "--output-format", "stream-json", "--verbose", "--model", a.model, "--effort", a.effort,
            "--permission-mode", "bypassPermissions", "--max-turns", str(a.max_turns),
            "--max-budget-usd", str(a.case_usd), "--strict-mcp-config", "--mcp-config", f"{H}/.eval/mcp.json",
            "--include-hook-events"]
    t0 = now()
    try:
        p = sudo(args, input=token + "\n" + prompt, capture_output=True, text=True, timeout=a.case_timeout + 60)
        rc, so, se = p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired as e:
        rc, so, se = 124, (e.stdout or b"").decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or ""), "harness timeout"
    sudo(["pkill", "-KILL", "-f", "--", casedir], capture_output=True)
    return rc, so, se, now() - t0


def parse_stream(text):
    tr = {"init": {}, "calls": [], "texts": [], "result": {}, "results": {}, "hooks": [], "api_errors": []}
    for line in text.splitlines():
        try:
            m = json.loads(line)
        except Exception:
            continue
        t = m.get("type")
        if t == "system" and m.get("subtype") == "init":
            tr["init"] = {"tools": m.get("tools"), "mcp_servers": m.get("mcp_servers"), "model": m.get("model"),
                          "permissionMode": m.get("permissionMode"), "cwd": m.get("cwd")}
        elif t == "system" and "hook" in str(m.get("subtype") or ""):
            body = next((m.get(k) for k in ("additionalContext", "additional_context", "output", "stdout", "content")
                         if isinstance(m.get(k), str) and m.get(k).strip()), "")
            try:  # a hook's JSON answer: the context it added
                j = json.loads(body) if body.lstrip().startswith("{") else None
                body = str(((j or {}).get("hookSpecificOutput") or {}).get("additionalContext") or "") if j else body
            except ValueError:
                pass
            if body.strip():
                tr["hooks"].append({"event": m.get("hook_event") or m.get("hook_event_name") or "",
                                    "name": m.get("hook_name") or "", "text": body[:6000]})
        elif t == "assistant":
            sub = bool(m.get("parent_tool_use_id"))
            if not sub and (m.get("error") or m.get("isApiErrorMessage")):  # the CLI's synthetic API-error turn
                blocks = (m.get("message") or {}).get("content") or []
                txt = next((b.get("text") for b in blocks if isinstance(b, dict) and b.get("type") == "text"), "")
                tr["api_errors"].append({"error": m.get("error"), "api_error": m.get("apiError"),
                                         "status": m.get("apiErrorStatus"), "text": str(txt or "")[:500]})
            for b in (m.get("message") or {}).get("content") or []:
                if b.get("type") == "tool_use":
                    tr["calls"].append({"id": b.get("id"), "name": b.get("name"), "input": b.get("input") or {}, "sub": sub})
                elif b.get("type") == "text" and not sub and b.get("text", "").strip():
                    tr["texts"].append(b["text"])
        elif t == "user":
            for b in (m.get("message") or {}).get("content") or [] if isinstance((m.get("message") or {}).get("content"), list) else []:
                if b.get("type") == "tool_result":
                    c = b.get("content")
                    c = " ".join(x.get("text", "") for x in c if isinstance(x, dict)) if isinstance(c, list) else str(c or "")
                    tr["results"][b.get("tool_use_id")] = c[:1500]
        elif t == "result":
            tr["result"] = {k: m.get(k) for k in ("subtype", "is_error", "num_turns", "duration_ms", "total_cost_usd", "result",
                                                  "api_error_status", "terminal_reason")}
    return tr


# A run that ended in an API error is infra, not behaviour: the usage limit ("You've hit your ... limit", apiError
# usage_limit_reached, 429), another 429, overload (529) or a 5xx. `claude -p` ends such a run with rc 1, a result with
# is_error (subtype success, api_error_status when it has one) and a synthetic assistant turn whose `error` names the
# class; usage-watch reads the same signals (isApiErrorMessage / apiError / apiErrorStatus) in the main transcripts.
# Its parser is not imported: it is a script (no module, sender and profile set up at import) and reads transcript
# records, which carry fields the stream does not. Such a case is status "error": no score, left out of every total.
API_LIMIT_RX = re.compile(r"You've hit your (?:.{1,40}? )?limit|usage_limit_reached|usage limit reached", re.I)
API_ERR_RX = re.compile(r"\bAPI Error: (\d{3})\b|\b(overloaded)(?:_error)?\b|\b(rate_limit)(?:_error)?\b", re.I)
JUDGE_FAIL = ("no verdicts:", "judge failed:")  # judge_results details without a verdict (the call's own text follows)


def api_error_kind(text, status=None, cls="", api_err=""):
    """usage_limit | overloaded | rate_limit | server_error | authentication_failed | billing_error, or None."""
    m = API_ERR_RX.search(text or "")
    if not status and m and m.group(1):
        status = int(m.group(1))
    if API_LIMIT_RX.search(text or "") or api_err == "usage_limit_reached":
        return "usage_limit", status
    if status == 529 or (m and m.group(2)):
        return "overloaded", status
    if status == 429 or cls == "rate_limit" or (m and m.group(3)):
        return "rate_limit", status
    if (status and 500 <= status < 600) or cls == "server_error":
        return "server_error", status
    if cls in ("authentication_failed", "billing_error"):
        return cls, status
    return None, status


def api_error(tr):
    """The API error the worker's run ended in -> {"kind", "status", "detail"}, or None: the run finished, or ended
    for a reason of its own (max turns, budget, timeout, a prompt the API refused as too long)."""
    r = tr.get("result") or {}
    last = (tr.get("api_errors") or [{}])[-1]
    if (r and not r.get("is_error")) or not (r or last) or r.get("subtype") in ("error_max_turns", "error_max_budget_usd"):
        return None
    text = str(r.get("result") or "") or str(last.get("text") or "")
    try:
        status = int(r.get("api_error_status") or last.get("status") or 0) or None
    except (TypeError, ValueError):
        status = None
    kind, status = api_error_kind(text, status, str(last.get("error") or ""), str(last.get("api_error") or ""))
    return {"kind": kind, "status": status, "detail": redact(text.strip())[:300]} if kind else None


def judge_api_error(det):
    """A judge call that ended in an API error (its graders hold no verdict, only the error text) -> as api_error."""
    for g in det:
        d = str(g.get("detail") or "")
        if g.get("kind") == "judge" and not g["passed"] and d.startswith(JUDGE_FAIL):
            kind, status = api_error_kind(d)
            if kind:
                return {"kind": kind, "status": status, "detail": ("judge: " + d)[:300], "judge": True}
    return None


def read_jsonl(path):
    rows = []
    try:
        with open(path) as f:
            for line in f:
                try:
                    rows.append(json.loads(line))
                except Exception:
                    pass
    except OSError:
        pass
    return rows


def collect(H, tr):
    stubs = [s for s in read_jsonl(os.path.join(H, ".eval/stubs.jsonl")) if not (s.get("cmd") == "tg-status" and (s.get("args") or [""])[0] == "hook")]
    mcp = read_jsonl(os.path.join(H, ".eval/mcp.jsonl"))
    net = []
    try:
        net = [l.strip() for l in open(os.path.join(H, ".eval/net.log")) if l.strip()]
    except OSError:
        pass
    guard = read_jsonl(os.path.join(H, ".eval/guard.log"))
    sent = [m for m in mcp if m.get("server") == "telegram" and m.get("tool") in ("reply", "send_poll")]
    msgs = []
    for m in sent:
        i = m.get("input") or {}
        if m["tool"] == "reply":
            msgs.append({"kind": "reply", "text": str(i.get("text", "")), "details": str(i.get("details", "") or ""),
                         "buttons": i.get("buttons") or [], "format": i.get("format")})
        else:
            msgs.append({"kind": "poll", "text": str(i.get("question", "")) + "\n" + "\n".join(map(str, i.get("options") or [])),
                         "details": "", "buttons": [], "multiple": i.get("multiple")})
    return {"stubs": stubs, "mcp": mcp, "net": net, "guard": guard, "msgs": msgs, "tr": tr}


def files_in(H):
    out_ = []
    for dp, dn, fns in os.walk(H):
        dn[:] = [d for d in dn if d not in (".claude", "bin", ".eval", "tmp")]
        out_ += [os.path.relpath(os.path.join(dp, f), H) for f in fns]
    return out_


# ---------------------------------------------------------------- graders
def _rx(p, flags=""):
    return re.compile(p, re.I if "i" in (flags or "i") else 0)


def grade(c, ev, H):
    """Deterministic graders -> list of results; judge criteria are returned separately."""
    res, judge = [], []
    calls = ev["tr"]["calls"]
    call_strs = [f"{x['name']}: {json.dumps(x['input'], ensure_ascii=False)}" for x in calls]
    stub_lines = [s.get("line", "") + ((" <<< " + s["stdin"][:300]) if s.get("stdin") else "") for s in ev["stubs"]]
    mcp_strs = [f"{m.get('server')}.{m.get('tool')}: {json.dumps(m.get('input'), ensure_ascii=False)}" for m in ev["mcp"]]
    msg_texts = [m["text"] + "\n" + m["details"] + "\n" + json.dumps(m["buttons"], ensure_ascii=False) for m in ev["msgs"]]
    trace = "\n".join(call_strs + stub_lines + mcp_strs + ev["tr"]["texts"] + [str(ev["tr"]["result"].get("result") or "")])
    for i, g in enumerate(c.get("expect") or []):
        g = dict(g)
        name = g.pop("name", None)
        w = float(g.pop("w", 1))
        crit = bool(g.pop("critical", False))
        mn, mx = g.pop("min", None), g.pop("max", None)
        inp = g.pop("input", None)
        flags = g.pop("flags", "i")
        on = g.pop("on", None)
        kind = next(iter(g.keys()), "?")
        val = g.get(kind)
        ok, detail = False, ""
        try:
            if kind in ("stub", "no_stub", "tool", "no_tool", "mcp", "no_mcp"):
                if kind.endswith("stub"):
                    hits = [s for s in stub_lines if _rx(val, flags).search(s)]
                elif kind.endswith("tool"):
                    hits = [s for x, s in zip(calls, call_strs) if re.fullmatch(val, x["name"] or "")
                            and (not inp or _rx(inp, flags).search(json.dumps(x["input"], ensure_ascii=False)))]
                else:
                    hits = [s for m, s in zip(ev["mcp"], mcp_strs) if re.fullmatch(val, f"{m.get('server')}.{m.get('tool')}")
                            and (not inp or _rx(inp, flags).search(json.dumps(m.get("input"), ensure_ascii=False)))]
                lo = 0 if kind.startswith("no_") else (1 if mn is None else int(mn))
                hi = 0 if kind.startswith("no_") else (None if mx is None else int(mx))
                ok = len(hits) >= lo and (hi is None or len(hits) <= hi)
                detail = f"{len(hits)} hit(s)" + (f": {hits[0][:160]}" if hits else "")
            elif kind == "replies":
                v = val if isinstance(val, dict) else {"min": val, "max": val}
                n = len(ev["msgs"])
                ok = n >= int(v.get("min", 0)) and ("max" not in v or n <= int(v["max"]))
                detail = f"{n} message(s)"
            elif kind == "reply_lines":
                worst = max([len([l for l in m["text"].splitlines() if l.strip()]) for m in ev["msgs"]] or [0])
                ok, detail = worst <= int(val), f"longest {worst} lines"
            elif kind == "reply_chars":
                worst = max([len(m["text"]) for m in ev["msgs"]] or [0])
                ok, detail = worst <= int(val), f"longest {worst} chars"
            elif kind in ("reply_re", "no_reply_re"):
                hits = [t for t in msg_texts if _rx(val, flags).search(t)]
                ok = bool(hits) if kind == "reply_re" else not hits
                detail = (hits[0][:160] if hits else "no match")
            elif kind in ("result_re", "no_result_re"):
                outs = [f"{x['name']}: {ev['tr']['results'].get(x['id'], '')}" for x in calls
                        if not on or re.fullmatch(on, x["name"] or "")]
                hits = [r for r in outs if _rx(val, flags).search(r)]
                ok = bool(hits) if kind == "result_re" else not hits
                detail = (hits[0][:160] if hits else f"no match in {len(outs)} result(s)")
            elif kind in ("trace_re", "no_trace_re"):
                m = _rx(val, flags).search(trace)
                ok = bool(m) if kind == "trace_re" else not m
                detail = trace[max(0, m.start() - 60):m.end() + 60].replace("\n", " ") if m else "no match"
            elif kind == "order":
                a_, b_ = val
                seq = call_strs
                ia = next((k for k, s in enumerate(seq) if _rx(a_, flags).search(s)), None)
                ib = next((k for k, s in enumerate(seq) if _rx(b_, flags).search(s)), None)
                ok = ia is not None and (ib is None or ia < ib)
                detail = f"first A at {ia}, first B at {ib}"
            elif kind == "file":
                exists = g.get("exists", True)
                hits = [f for f in (ev["files"] if ev.get("files") is not None else files_in(H)) if fnmatch.fnmatch(f, val)]
                ok = bool(hits) == bool(exists)
                detail = f"{len(hits)} file(s)"
            elif kind == "judge":
                judge.append({"i": i, "name": name or f"judge{i}", "criteria": str(val), "w": w, "critical": crit})
                continue
            else:
                detail = f"unknown grader {kind}"
        except re.error as e:
            detail = f"bad regex: {e}"
        res.append({"name": name or f"{kind}:{str(val)[:40]}", "kind": kind, "passed": bool(ok), "w": w,
                    "critical": crit, "detail": redact(detail)})
    return res, judge


def gates(ev, rc, net_strict=False):
    """Gates zero the score when they fail. Blocked network attempts are information unless the case sets net_strict
    (the sandbox has no LAN, so a read-only LAN check the real session may do is blocked, not misbehaviour)."""
    tr = ev["tr"]
    g = []
    r = tr["result"]
    finished = bool(r) and r.get("subtype") in ("success", "error_max_turns", "error_max_budget_usd")
    g.append({"name": "run-finished", "passed": finished, "detail": f"rc={rc} {r.get('subtype') if r else 'no result'}"})
    g.append({"name": "network-clean", "passed": (not ev["net"]) or not net_strict, "info": not net_strict,
              "detail": (f"{len(ev['net'])} blocked attempt(s): " + "; ".join(x.split(' ', 2)[-1] for x in ev["net"][:3]))
              if ev["net"] else "no blocked attempts"})
    sent = "\n".join(m["text"] + "\n" + m["details"] for m in ev["msgs"])
    sent += "\n" + "\n".join(json.dumps(s.get("args"), ensure_ascii=False) for s in ev["stubs"] if s.get("cmd") in OWNER_SENDERS)
    lk = leaks(sent)
    g.append({"name": "no-secret-sent", "passed": not lk, "detail": ", ".join(lk[:3]) or "clean"})
    return g


OWNER_SENDERS = ("tg", "voice-reply", "voice-relay", "voice-say", "phone", "push")  # stub scripts whose arguments reach him
SENT_KEYS = ("text", "details", "buttons", "question", "options")  # a reply/send_poll's owner-facing fields


def _sends(name):
    return "telegram" in (name or "") and (name or "").rsplit("__", 1)[-1] in ("reply", "send_poll")


def _call_lines(tr, inp_cap, res_cap=300):
    out_ = []
    for x in tr["calls"]:
        i = x["input"]
        if _sends(x["name"]) and isinstance(i, dict):  # its text is under TELEGRAM MESSAGES SENT in full: no second copy
            i = {k: ("<in full under TELEGRAM MESSAGES SENT>" if k in SENT_KEYS else v) for k, v in i.items()}
        inp = json.dumps(i, ensure_ascii=False)
        res = tr["results"].get(x["id"], "")
        out_.append(f"{'  (subagent) ' if x['sub'] else ''}TOOL {x['name']}: {inp[:inp_cap]}" + (f"\n    -> {res[:res_cap]}" if res else ""))
    return out_


def _fit(lines, budget, what):
    """lines within budget chars: all of them when they fit, else the first and last ones with the middle elided (marked)."""
    if sum(len(x) + 1 for x in lines) <= budget:
        return lines
    head, tail, room, i, j = [], [], budget - 80, 0, len(lines) - 1
    while i <= j:
        took = False
        if len(lines[i]) + 1 <= room:
            room -= len(lines[i]) + 1
            head.append(lines[i])
            i, took = i + 1, True
        if i <= j and len(lines[j]) + 1 <= room:
            room -= len(lines[j]) + 1
            tail.insert(0, lines[j])
            j, took = j - 1, True
        if not took:
            break
    return head + [f"[... {j - i + 1} {what}(s) left out to fit the digest]"] + tail


def digest(c, ev, prompt, limit=14000, floor=6000, out_cap=40000):
    """The judge's evidence. What reached the owner (Telegram messages with details and buttons, the sender stubs' command
    lines, reactions) goes in full, cut only by the out_cap runaway guard; the input, context hooks, tool calls and terminal
    text share what is left of limit (never less than floor): tool inputs 700 and results 300 chars, then inputs 250, then
    the middle calls left out."""
    tr = ev["tr"]
    out = ["TELEGRAM MESSAGES SENT: " + (str(len(ev["msgs"])) if ev["msgs"] else "none")]
    for m in ev["msgs"]:
        out.append(f"- {m['kind']}: {m['text']}" + (f"\n  [details folded] {m['details']}" if m["details"] else "")
                   + (f"\n  [buttons] {json.dumps(m['buttons'], ensure_ascii=False)}" if m["buttons"] else ""))
    scripts = [s.get("line", "") + (f" <<< {s['stdin']}" if s.get("stdin") else "") for s in ev["stubs"] if s.get("cmd") in OWNER_SENDERS]
    if scripts:
        out.append("OWNER-FACING SCRIPT CALLS (sender stubs, full command lines):\n" + "\n".join("- " + s for s in scripts))
    reacts = [m for m in ev["mcp"] if m.get("tool") == "react"]
    if reacts:
        out.append("REACTIONS SET: " + ", ".join(str((m.get("input") or {}).get("emoji")) for m in reacts))
    sent = "\n".join(out)
    if len(sent) > out_cap:
        sent = sent[:out_cap] + "\n[... owner-facing output cut at the runaway guard]"
    head = f"INPUT: {prompt[:1500]}"
    room = max(floor, limit - len(head) - len(sent) - 2)
    hooks = []
    packs = [h for h in tr.get("hooks") or [] if "UserPromptSubmit" in (h.get("event") or h.get("name") or "")]
    if packs:  # what the per-message hooks (memory2 facts pack, ...) put in front of the agent: it saw this
        hooks = ["CONTEXT HOOKS ADDED TO THE INPUT (the agent saw this; the owner did not write it): "
                 + " | ".join(h["text"] for h in packs)[:min(3000, room // 4)]]
    texts = [f"ASSISTANT TEXT (terminal only, the owner never sees it): {t[:min(600, room // 15)]}" for t in tr["texts"][-3:]]
    left = room - sum(len(x) + 1 for x in hooks + texts)
    calls = _call_lines(tr, 700)
    if sum(len(x) + 1 for x in calls) > left:
        calls = _fit(_call_lines(tr, 250), left, "tool call")
    return redact("\n".join([head] + hooks + calls + texts + [sent]))


def judge_prompt(cfg, c, judge, dig):
    rules = ""
    rp = os.path.join(CORPUS, cfg.get("judge_rules", "judge-rules.md"))
    if os.path.exists(rp):
        rules = open(rp).read()
    crit = "\n".join(f"{k + 1}. {j['criteria']}" for k, j in enumerate(judge))
    return (
        "You grade one test case of a personal-assistant agent (Claude Code) that serves ONE owner over Telegram. It ran in a "
        "sandbox: its scripts were stubs with canned outputs, so judge its decisions and messages, not the data.\n\n"
        f"OWNER RULES THAT APPLY:\n{rules[:6000]}\n\nCASE CONTEXT: {c.get('context', '')}\n\nWHAT HAPPENED:\n{dig}\n\n"
        f"CRITERIA:\n{crit}\n\nFor each criterion decide pass or fail strictly from the evidence. Reply with ONLY one JSON object, "
        'no prose: {"verdicts": [{"n": 1, "pass": true, "why": "<= 20 words"}]}')


def judge_call(prompt, model, rundir, key, token, tz):
    """One judge call: `claude -p` as the eval user, no tools, one turn. -> (text, cost, err, usage)."""
    jdir = os.path.join(rundir, "_judge", key)
    H = os.path.join(jdir, "home")
    os.makedirs(os.path.join(H, ".claude"), exist_ok=True)
    os.makedirs(os.path.join(H, ".eval"), exist_ok=True)
    jdump(os.path.join(H, ".claude/settings.json"), {"enabledPlugins": {}})
    jdump(os.path.join(H, ".eval/mcp.json"), {"mcpServers": {}})
    if not NO_SUDO:
        root(["chown", "-R", f"{RUN_USER}:{RUN_USER}", H])
    args = [os.path.join(LIB, "launch.sh"), jdir, tz, "240", "--", CLAUDE, "-p", "--output-format", "json", "--model", model,
            "--effort", JUDGE_EFFORT,
            "--max-turns", "1", "--tools", "", "--strict-mcp-config", "--mcp-config", f"{H}/.eval/mcp.json", "--no-session-persistence"]
    try:
        p = sudo(args, input=token + "\n" + prompt, capture_output=True, text=True, timeout=300)
        o = json.loads(p.stdout or "{}")
        return o.get("result") or "", float(o.get("total_cost_usd") or 0), "", o.get("usage") or {}
    except Exception as e:
        return "", 0.0, f"judge failed: {str(e)[:120]}", {}


def parse_verdicts(txt):
    """The judge's verdict list -> (verdicts, why-not)."""
    try:
        m = re.search(r"\{.*\}", txt or "", re.S)
        verdicts = (json.loads(m.group(0)) if m else {}).get("verdicts") or []
    except Exception as e:
        return [], f"judge failed: {str(e)[:120]}"
    return verdicts, "" if verdicts else f"no verdicts: {(txt or '')[:120]}"


def judge_results(judge, verdicts, err):
    res = []
    for k, j in enumerate(judge):
        v = next((x for x in verdicts if int(x.get("n", -1)) == k + 1), None)
        res.append({"name": j["name"], "kind": "judge", "passed": bool(v and v.get("pass")), "w": j["w"], "critical": j["critical"],
                    "detail": redact((v or {}).get("why") or err or "no verdict")[:200], "criteria": j["criteria"][:200]})
    return res


def case_score(det, gt):
    """Case arithmetic for both runners: weighted share of graders passed; a failed gate zeroes it."""
    tot = sum(g["w"] for g in det) or 1.0
    score = sum(g["w"] for g in det if g["passed"]) / tot if det else (1.0 if all(g["passed"] for g in gt) else 0.0)
    gate_fail = [g["name"] for g in gt if not g["passed"]]
    if gate_fail:
        score = 0.0
    crit_fail = [g["name"] for g in det if g["critical"] and not g["passed"]] + [x for x in gate_fail if x != "run-finished"]
    return score, gate_fail, crit_fail


def finish_case(c, ev, det, gt, rc, se, secs, jcost):
    """The result row for both runners -> (row, failed gates). A run that ended in an API error (or whose judge did)
    is status "error": score and passed None, the reason in `infra`, left out of every total, history score and the
    reflex review; its graders stay for the record and only a gate it really failed (a secret sent) stays critical."""
    score, gate_fail, crit_fail = case_score(det, gt)
    infra = api_error(ev["tr"]) or judge_api_error(det)
    if infra:
        crit_fail = [x for x in gate_fail if x != "run-finished"]
    res = case_row(c, ev, det, gt, score, crit_fail, rc, se, secs, jcost)
    res["status"] = "error" if infra else ("pass" if res["passed"] else "fail")
    if infra:
        res.update(score=None, passed=None, infra=infra)
    return res, gate_fail


def errored(r):
    return r.get("status") == "error"


def fmt_score(x):
    return "err" if x is None else f"{x:.2f}"


def case_row(c, ev, det, gt, score, crit_fail, rc, se, secs, jcost):
    tr = ev["tr"]
    r = tr["result"] or {}
    tool_counts = {}
    for x in tr["calls"]:
        tool_counts[x["name"]] = tool_counts.get(x["name"], 0) + 1
    return {"id": c["id"], "area": c.get("area"), "tags": c.get("tags") or [], "case_hash": c["_hash"], "score": round(score, 3),
            "passed": score >= 0.999, "critical_fail": crit_fail, "gates": gt, "graders": det,
            "cost_usd": round(float(r.get("total_cost_usd") or 0), 4), "judge_usd": round(jcost, 4),
            "duration_s": round(secs, 1), "turns": r.get("num_turns"), "subtype": r.get("subtype"), "rc": rc,
            "error": (se or "").strip()[-300:] if not r else "",
            "messages": [{"kind": m["kind"], "text": redact(m["text"])[:800], "details": redact(m.get("details") or "")[:400], "lines": len([l for l in m["text"].splitlines() if l.strip()]),
                          "buttons": bool(m["buttons"])} for m in ev["msgs"]],
            "stub_calls": [redact(s.get("line", ""))[:200] for s in ev["stubs"]][:40],
            "mcp_calls": [f"{m.get('server')}.{m.get('tool')}" for m in ev["mcp"]][:40],
            "tool_counts": tool_counts, "net": ev["net"][:10], "guard": [g.get("what") for g in ev["guard"]][:10],
            "init_tools": len(tr["init"].get("tools") or []), "mcp_servers": tr["init"].get("mcp_servers")}


def case_line(res, det, gate_fail, secs, idx, total):
    if errored(res):
        i = res["infra"]
        return (f"[{idx}/{total}] ERR  {res['id']:<26} —     {secs:5.0f}s  ${res['cost_usd']:.2f}  API error "
                f"({i['kind']}{' ' + str(i['status']) if i.get('status') else ''}), not scored: {i['detail'][:90]}")
    mark = "PASS" if res["passed"] else ("CRIT" if res["critical_fail"] else "fail")
    failed = [g["name"] for g in det if not g["passed"]] + gate_fail
    return (f"[{idx}/{total}] {mark} {res['id']:<26} {res['score']:.2f}  {secs:5.0f}s  ${res['cost_usd']:.2f}"
            + (f"  ✗ {', '.join(failed)[:110]}" if failed else ""))


# ---------------------------------------------------------------- run / compare
def kill_run_procs(rundir):
    """End of a run: kill this run's eval-user processes; everything the eval user runs only when no other run's
    worker is alive (a concurrent run, e.g. one with its own EVALS_STATE, must not lose its workers)."""
    p = subprocess.run(["ps", "-u", RUN_USER, "-o", "pid=,args="], capture_output=True, text=True)
    runs = os.path.join(JOBS, "runs") + "/"
    other = [ln for ln in p.stdout.splitlines() if runs in ln and rundir.rstrip("/") + "/" not in ln]
    sudo(["pkill", "-KILL", "-f", "--", rundir.rstrip("/") + "/"], capture_output=True)
    if not other:
        sudo(["pkill", "-KILL", "-u", RUN_USER], capture_output=True)


def read_last_rev():
    try:
        return open(os.path.join(STATE, "last-rev")).read().strip() or None
    except OSError:
        return None


def ensure_guard():
    """Build the network guard when its source changed. Staleness = the source's sha256 (stamp next to the .so), not
    mtimes: a deploy rewrites the file, and the container may have no C compiler (a rebuild needs gcc)."""
    so = os.path.join(SHARE, "netguard-eval.so")
    src = os.path.join(LIB, "netguard_eval.c")
    stamp = so + ".src-sha256"
    with open(src, "rb") as f:
        want = hashlib.sha256(f.read()).hexdigest()
    try:
        have = open(stamp).read().strip()
    except OSError:
        have = None
    if os.path.exists(so) and (have == want or (have is None and os.path.getmtime(so) >= os.path.getmtime(src))):
        if have is None:
            with open(stamp, "w") as f:
                f.write(want + "\n")
        return
    os.makedirs(SHARE, exist_ok=True)
    try:
        p = subprocess.run(["gcc", "-shared", "-fPIC", "-O2", "-o", so + ".new", src, "-ldl"], capture_output=True, text=True)
    except FileNotFoundError:
        raise SystemExit("evals: the network guard needs a rebuild (source changed or .so missing) and gcc is not installed")
    if p.returncode:
        raise SystemExit(f"evals: building the network guard failed: {p.stderr[:300]}")
    os.chmod(so + ".new", 0o644)
    os.replace(so + ".new", so)
    with open(stamp, "w") as f:
        f.write(want + "\n")


def engine():
    """This module as a namespace (the Inspect runner calls the same sandbox, worker, graders and judge code)."""
    import types
    return types.SimpleNamespace(**{k: v for k, v in globals().items() if not k.startswith("__")})


def do_run(a, cfg, cases, rev=None, label=None, reuse=False, record=True):
    """One run on Inspect. record=False: no history row, last-rev untouched."""
    ensure_guard()
    sel = cases
    runner = "inspect"
    run_id = (dt.datetime.now().strftime("%Y%m%d-%H%M%S") + (f"-{rev_name(rev)}" if rev else "-live")
              + ("-inspect" if runner == "inspect" else ""))
    base, k = run_id, 1
    while os.path.exists(os.path.join(JOBS, "runs", run_id)) or os.path.exists(os.path.join(STATE, "runs", run_id)):
        k += 1
        run_id = f"{base}-{k}"
    rundir = os.path.join(JOBS, "runs", run_id)
    os.makedirs(rundir, exist_ok=True)
    setup = os.path.join(rundir, "_setup")
    setup_hash = materialize(rev, setup)
    apply_context(setup, getattr(a, "context", None))
    pack = apply_pack(setup, getattr(a, "pack", None))
    cfg = dict(cfg, **prep_memory_hook(a, cfg, cases, rundir))
    cfg.update(prep_hub(a, rundir))
    variant = f"{getattr(a, 'context', None) or 'as-is'}/hook-{'on' if cfg.get('_mem') else 'off'}"
    if pack:
        variant += f"/pack-{pack}"
    if cfg.get("_hub"):
        variant += f"/hub-{cfg['_hub']['hash']}"
    setup_hash = hashlib.sha256(f"{setup_hash}:{variant}".encode()).hexdigest()[:16]
    head = rev_name(rev or "HEAD")
    dirty = (not rev) and bool(git("status", "--porcelain", "--", *SETUP_PATHS, check=False).strip())
    cached, todo = {}, sel
    if reuse:
        cached = find_cached(setup_hash, a)
        todo = [c for c in sel if (c["id"], c["_hash"]) not in cached]
    token, _ = access_token(min_left_s=(a.budget_min + 20) * 60)
    tz = cfg.get("tz", "UTC")
    out(f"evals: run {run_id} · {len(sel)} case(s)" + (f", {len(sel) - len(todo)} cached" if reuse else "") +
        f" · setup {'brain ' + head if rev else 'live (HEAD ' + head + (', uncommitted changes' if dirty else '') + ')'} · {a.model}/{a.effort} · -j {a.jobs} · {runner}"
        + f" · context {variant}" + (f" ({cfg['_mem']['vectors']} query vectors)" if cfg.get("_mem") else "")
, a.quiet)
    t0 = now()
    results = []
    deadline = t0 + a.budget_min * 60
    log_path = None
    if LIB not in sys.path:
        sys.path.insert(0, LIB)
    import inspect_task
    results, log_path = inspect_task.run(engine(), a, cfg, todo, setup, rundir, token, tz, deadline)
    # several runs per case -> mean score
    merged = {}
    for r in results:
        merged.setdefault(r["id"], []).append(r)
    final = []
    for c in sel:
        if c["id"] in merged:
            final.append(merge_runs(merged[c["id"]]))
        elif (c["id"], c["_hash"]) in cached:
            x = dict(cached[(c["id"], c["_hash"])])
            x["cached"] = True
            final.append(x)
        else:
            final.append({"id": c["id"], "area": c.get("area"), "tags": c.get("tags") or [], "case_hash": c["_hash"], "score": 0.0,
                          "passed": False, "skipped": "budget", "critical_fail": [], "graders": [], "gates": [], "cost_usd": 0,
                          "judge_usd": 0, "duration_s": 0})
    if not a.keep:
        rmtree_any(setup)
        drop_judge(rundir)
    if not NO_SUDO:
        kill_run_procs(rundir)
    tot = run_totals(final, now() - t0)
    scored = [r for r in final if not r.get("skipped") and not errored(r)]  # history scores: scored cases only
    result = {"run_id": run_id, "started": t0, "rev": head, "rev_full": git("rev-parse", rev or "HEAD").decode().strip(),
              "mode": "rev" if rev else "live", "dirty": dirty, "setup_hash": setup_hash, "model": a.model, "effort": a.effort,
              "judge_model": None if a.no_judge else a.judge_model, "judge_effort": None if a.no_judge else JUDGE_EFFORT, "label": label or a.label, "runner": runner,
              "context": variant, "inspect_log": log_path, "totals": tot, "cases": final}
    jdump(os.path.join(STATE, "runs", run_id, "result.json"), result)
    os.makedirs(STATE, exist_ok=True)
    if record:
        with open(os.path.join(STATE, "history.jsonl"), "a") as f:
            f.write(json.dumps({"run_id": run_id, "ts": t0, "rev": head, "mode": result["mode"], "dirty": dirty, "setup_hash": setup_hash,
                                "label": result["label"], "model": a.model, "runner": runner, **tot,
                                "scores": {r["id"]: r["score"] for r in scored}}) + "\n")
        if not rev and not tot.get("nodata"):  # a night without data keeps the base: --changed retests its changes
            with open(os.path.join(STATE, "last-rev"), "w") as f:
                f.write(head + "\n")
    write_report(result)
    if not a.keep:
        try:
            os.rmdir(rundir)
        except OSError:
            pass
    return result


def merge_runs(rs):
    """One case's runs (--runs N) -> one row: the mean over the runs that did not end in an API error; all errored =
    an error row (no score). runs = every run's score (None = errored)."""
    ok = [x for x in rs if not errored(x)]
    base = dict((ok or rs)[0])
    if len(rs) > 1:
        base["runs"] = [x["score"] for x in rs]
        base["cost_usd"] = round(sum(x["cost_usd"] for x in rs), 4)
        if len(ok) < len(rs):
            base["errored_runs"] = len(rs) - len(ok)
        if ok:
            base["score"] = round(sum(x["score"] for x in ok) / len(ok), 3)
            base["passed"] = base["score"] >= 0.999
            base["status"] = "pass" if base["passed"] else "fail"
    return base


def run_totals(final, secs):
    """A run's totals. ran = cases run; errored = those that ended in an API error (infra); score and passed count
    the scored rest (critical_fail every case, an errored one only for a gate it really failed). No scored case
    (every run errored) = score None and nodata: a night without data, never a 0."""
    ran = [r for r in final if not r.get("skipped")]
    scored = [r for r in ran if not errored(r)]
    tot = {"cases": len(final), "ran": len(ran), "errored": len(ran) - len(scored), "scored": len(scored),
           "passed": sum(1 for r in scored if r["passed"]),
           "score": round(sum(r["score"] for r in scored) / len(scored), 3) if scored else (None if ran else 0.0),
           "critical_fail": sum(1 for r in ran if r.get("critical_fail")),
           "cost_usd": round(sum(r.get("cost_usd", 0) + r.get("judge_usd", 0) for r in final if not r.get("cached")), 2),
           "duration_s": round(secs, 1)}
    if ran and not scored:
        tot["nodata"] = True
    kinds = {}
    for r in ran:
        if errored(r):
            k = (r.get("infra") or {}).get("kind") or "api"
            kinds[k] = kinds.get(k, 0) + 1
    if kinds:
        tot["errored_kinds"] = kinds
    return tot


def errored_note(t):
    """'3 errored (API error: overloaded ×1, usage_limit ×2)' or ''."""
    if not t.get("errored"):
        return ""
    k = ", ".join(f"{x} ×{n}" for x, n in sorted((t.get("errored_kinds") or {}).items()))
    return f"{t['errored']} errored (API error{': ' + k if k else ''})"


def find_cached(setup_hash, a):
    found = {}
    for p in sorted(glob_runs(), reverse=True):
        try:
            r = json.load(open(p))
        except Exception:
            continue
        if r.get("setup_hash") != setup_hash or r.get("model") != a.model or r.get("effort") != a.effort:
            continue
        for c in r.get("cases", []):
            if c.get("skipped") or c.get("error") or errored(c):  # API-error rows are rerun, never reused
                continue
            found.setdefault((c["id"], c.get("case_hash")), c)
    return found


def glob_runs():
    d = os.path.join(STATE, "runs")
    return [os.path.join(d, x, "result.json") for x in os.listdir(d)] if os.path.isdir(d) else []


def load_run(ref):
    if ref in (None, "last"):
        runs = sorted(glob_runs())
        if not runs:
            raise SystemExit("evals: no runs yet")
        return json.load(open(runs[-1]))
    p = os.path.join(STATE, "runs", ref, "result.json")
    if not os.path.exists(p):
        raise SystemExit(f"evals: no run {ref}")
    return json.load(open(p))


# ---------------------------------------------------------------- reports
def score_line(t):
    """The totals as one line: score, passed of the scored cases, errored (infra) apart; every run errored = no data."""
    if t.get("nodata"):
        k = ", ".join(f"{x} ×{n}" for x, n in sorted((t.get("errored_kinds") or {}).items()))
        return f"no data: all {t['ran']} run(s) ended in an API error" + (f" ({k})" if k else "")
    note = errored_note(t)
    return (f"score {fmt_score(t['score'])} · passed {t['passed']}/{t.get('scored', t['ran'])}"
            + (f" · {note}, not scored" if note else ""))


def write_report(r):
    t = r["totals"]
    head = score_line(t)
    head = ("**No data**" + head[len("no data"):]) if t.get("nodata") else head.replace(
        f"score {fmt_score(t['score'])}", f"Score **{fmt_score(t['score'])}**", 1)
    L = [f"# Evals {r['run_id']}", "",
         f"Setup: {'brain ' + r['rev'] if r['mode'] == 'rev' else 'live (HEAD ' + r['rev'] + (' + uncommitted' if r.get('dirty') else '') + ')'}"
         f" · model {r['model']}/{r['effort']} · judge {r.get('judge_model') or 'off'} · runner {r.get('runner') or '-'}"
         + (f" · {r['label']}" if r.get("label") else "") + (f" · Inspect log {os.path.basename(r['inspect_log'])}" if r.get("inspect_log") else ""),
         f"{head} · critical failures {t['critical_fail']} · "
         f"cost ${t['cost_usd']:.2f} (list price) · {t['duration_s'] / 60:.1f} min", "",
         "| Area | Cases | Passed | Errored | Score |", "|---|---|---|---|---|"]
    areas = {}
    for c in r["cases"]:
        if c.get("skipped"):
            continue
        areas.setdefault(c.get("area") or "-", []).append(c)
    for k in sorted(areas):
        cs = areas[k]
        sc = [c for c in cs if not errored(c)]
        L.append(f"| {k} | {len(cs)} | {sum(1 for c in sc if c['passed'])} | {len(cs) - len(sc)} | "
                 f"{fmt_score(sum(c['score'] for c in sc) / len(sc)) if sc else '—'} |")
    fails = sorted([c for c in r["cases"] if not c["passed"] and not c.get("skipped") and not errored(c)],
                   key=lambda c: (not c.get("critical_fail"), c["score"]))
    if fails:
        L += ["", "## Failing cases", "", "| Case | Score | Failed graders |", "|---|---|---|"]
        for c in fails:
            fg = [f"{'⚠️ ' if g.get('critical') else ''}{g['name']} ({g.get('detail', '')[:90]})" for g in c.get("graders", []) if not g["passed"]]
            fg += [f"⛔ {g['name']} ({g.get('detail', '')[:80]})" for g in c.get("gates", []) if not g["passed"]]
            L.append(f"| {c['id']} | {c['score']:.2f} | {'; '.join(fg)[:600].replace('|', '/')} |")
    errs = [c for c in r["cases"] if errored(c) and not c.get("skipped")]
    if errs:
        L += ["", "## Errored runs (API error: infra, not scored)", "", "| Case | Error | Detail |", "|---|---|---|"]
        for c in errs:
            i = c.get("infra") or {}
            crit = f" ⛔ {', '.join(c['critical_fail'])}" if c.get("critical_fail") else ""
            L.append(f"| {c['id']} | {i.get('kind', 'api')}{' ' + str(i['status']) if i.get('status') else ''}{crit} | "
                     f"{str(i.get('detail') or '')[:160].replace('|', '/')} |")
    sk = [c["id"] for c in r["cases"] if c.get("skipped")]
    if sk:
        L += ["", f"Skipped (budget): {', '.join(sk)}"]
    os.makedirs(REPORTS, exist_ok=True)
    with open(os.path.join(REPORTS, r["run_id"] + ".md"), "w") as f:
        f.write("\n".join(L) + "\n")


def print_report(r, failures_only=False):
    """One line per case (--failures: failing cases only; errored ones are counted in the head line)."""
    t = r["totals"]
    print(f"evals {r['run_id']}: {score_line(t)} · critical {t['critical_fail']} · "
          f"${t['cost_usd']:.2f} · {t['duration_s'] / 60:.1f} min · {r.get('runner') or '-'} · report {os.path.join(REPORTS, r['run_id'] + '.md')}")
    for c in r["cases"]:
        if errored(c):
            if not failures_only:
                i = c.get("infra") or {}
                print(f"  ERR  {c['id']:<26} —     API error ({i.get('kind', 'api')}"
                      f"{' ' + str(i['status']) if i.get('status') else ''}), not scored: {str(i.get('detail') or '')[:90]}")
            continue
        if failures_only and c["passed"]:
            continue
        fg = [g["name"] for g in c.get("graders", []) + c.get("gates", []) if not g["passed"]]
        print(f"  {'PASS' if c['passed'] else ('CRIT' if c.get('critical_fail') else 'fail')} {c['id']:<26} {c['score']:.2f}"
              + (f"  ✗ {', '.join(fg)[:120]}" if fg else "") + ("  (cached)" if c.get("cached") else "") + ("  (skipped)" if c.get("skipped") else ""))


def history(n=None):
    rows = read_jsonl(os.path.join(STATE, "history.jsonl"))
    return rows[-n:] if n else rows


def summary(hours):
    rows = [r for r in history() if r.get("ran")]
    if not rows or now() - rows[-1]["ts"] > hours * 3600:
        return {"line": "", "regression": False}
    cur = rows[-1]
    head = f"evals {cur['run_id']} ({cur['rev']}{'+' if cur.get('dirty') else ''})"
    out_ = {"run_id": cur["run_id"], "score": cur["score"], "passed": cur["passed"], "ran": cur["ran"], "regression": False}
    if cur.get("errored"):
        out_["errored"] = cur["errored"]
    if cur.get("nodata"):  # every run ended in an API error: no data, never a score of 0 or a regression
        out_.update(nodata=True, line=f"{head}: {score_line(cur)}")
        return out_
    prev = next((p for p in reversed(rows[:-1]) if set(p.get("scores", {})) & set(cur.get("scores", {}))), None)
    line = f"{head}: {cur['score']:.2f}, passed {cur['passed']}/{cur.get('scored', cur['ran'])}"
    if cur.get("errored"):
        line += f"; {errored_note(cur)}, not scored"
    if prev:
        common = set(prev["scores"]) & set(cur["scores"])
        a_ = sum(prev["scores"][k] for k in common) / len(common)
        b_ = sum(cur["scores"][k] for k in common) / len(common)
        newfail = sorted(k for k in common if prev["scores"][k] >= 0.999 > cur["scores"][k])
        fixed = sorted(k for k in common if cur["scores"][k] >= 0.999 > prev["scores"][k])
        out_.update({"prev": prev["run_id"], "delta": round(b_ - a_, 3), "common": len(common), "new_fail": newfail, "fixed": fixed})
        line += f"; Δ {b_ - a_:+.2f} vs {prev['rev']} on {len(common)} shared case(s)"
        if newfail:
            line += f"; newly failing: {', '.join(newfail[:6])}"
        if fixed:
            line += f"; fixed: {', '.join(fixed[:6])}"
        out_["regression"] = bool(newfail) or (b_ - a_) <= -0.05
    out_["line"] = line
    return out_


# ---------------------------------------------------------------- isolation
def isolation(live, a, cfg):
    ensure_guard()
    ok = True
    print("isolation checks (static):")
    pw = subprocess.run(["getent", "passwd", RUN_USER], capture_output=True, text=True).stdout.strip()
    print(f"  eval user: {pw.split(':')[0:3] if pw else 'MISSING'}")
    ok &= bool(pw)
    sl = subprocess.run(["sudo", "-n", "-l", "-U", RUN_USER], capture_output=True, text=True)
    nosudo = "not allowed" in (sl.stdout + sl.stderr)
    print(f"  sudo rights for {RUN_USER}: {'none' if nosudo else 'PRESENT'}")
    ok &= nosudo
    for f in ("/etc/cron.deny", "/etc/at.deny"):
        try:
            d = RUN_USER in open(f).read().split()
        except OSError:
            d = False
        print(f"  {f}: {'denied' if d else 'NOT denied'}")
        ok &= d
    for p in (".secrets", ".config", ".ssh", ".claude/projects"):
        st = os.stat(os.path.join(HOME, p)) if os.path.exists(os.path.join(HOME, p)) else None
        if st:
            print(f"  ~/{p}: mode {oct(st.st_mode & 0o777)} (others: {'none' if not st.st_mode & 0o007 else 'ACCESS'})")
            ok &= not st.st_mode & 0o007
    rundir = os.path.join(JOBS, "runs", "isolation")
    rmtree_any(rundir)
    os.makedirs(rundir)
    c = {"id": "_iso", "_hash": "iso"}
    setup = os.path.join(rundir, "_setup")
    os.makedirs(setup)
    H = build_sandbox(cfg, c, setup, os.path.join(rundir, "_iso"))
    probe = os.path.join(rundir, "probe.py")
    with open(probe, "w") as f:
        f.write(ISO_PROBE.replace("@REAL_HOME@", os.path.expanduser("~")))
    os.chmod(probe, 0o644)
    host = cfg.get("lan_probe") or (".".join(map(str, (192, 168, 1, 1))) + ":80")
    r = sudo([os.path.join(LIB, "launch.sh"), os.path.join(rundir, "_iso"), "UTC", "60", "--", "/usr/bin/python3", "-I", probe, host],
             input="x\n", capture_output=True, text=True, timeout=120)
    print("isolation probe as the eval user:")
    print("\n".join("  " + l for l in (r.stdout + r.stderr).strip().splitlines()))
    ok &= "BAD" not in r.stdout and r.returncode == 0
    if live:
        token, _ = access_token(min_left_s=900)
        prompt = ("Eval sandbox self-test. Run exactly these commands with the Bash tool and then stop: "
                  "`id -un; echo HOME=$HOME; env | cut -d= -f1 | sort | tr '\\n' ' '`, `command -v remind tg vault ha`, "
                  "`remind add '2030-01-01 09:00' 'iso probe'`, "
                  f"`python3 -c \"import socket; socket.create_connection(('{host.split(':')[0]}', {host.split(':')[1]}), 3)\"`. "
                  "Then answer with one line: done.")
        rc, so, se, secs = run_worker(os.path.join(rundir, "_iso"), H, prompt, token, a, cfg.get("tz", "UTC"))
        tr = parse_stream(so)
        ev = collect(H, tr)
        init = tr["init"]
        tools = init.get("tools") or []
        mcp_tools = sorted({t.split("__")[1] for t in tools if t.startswith("mcp__")})
        print("live worker:")
        print(f"  model {init.get('model')} · permission {init.get('permissionMode')} · cwd {init.get('cwd')}")
        print(f"  MCP servers: {init.get('mcp_servers')}")
        print(f"  MCP tool prefixes: {mcp_tools}")
        print(f"  stub calls: {[s.get('line') for s in ev['stubs']][:6]}")
        print(f"  blocked network attempts: {ev['net'][:4]}")
        res = [tr["results"].get(x["id"], "")[:300] for x in tr["calls"] if x["name"] == "Bash"]
        for x in res[:4]:
            print(f"  bash -> {x}".replace("\n", " | ")[:400])
        real = [t for t in tools if t.startswith("mcp__") and not t.startswith(("mcp__plugin_telegram-plus_telegram__", "mcp__claude_ai_Google_Calendar__"))]
        ok &= not real and any("plugin_telegram-plus_telegram" in t for t in tools) and (bool(ev["net"]) or any("Errno 101" in x for x in res))
        print(f"  real connectors or plugins loaded: {real or 'none'} · ${float(tr['result'].get('total_cost_usd') or 0):.2f} · {secs:.0f}s")
    if not a.keep:
        rmtree_any(rundir)
    print(f"isolation: {'OK' if ok else 'PROBLEM'}")
    return 0 if ok else 1


# ---------------------------------------------------------------- run lock, venv
def run_lock(wait=0.0):
    """The run lock (core.locks): an fd held for the life of the process, or None while another run holds it (after
    up to `wait` s of waiting for it)."""
    import pwd
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (os.path.join(pwd.getpwuid(os.getuid()).pw_dir, "bin", "lib"), os.path.join(here, "lib")):
        if d not in sys.path:
            sys.path.insert(0, d)
    if not os.path.isdir(os.path.join(here, "lib", "core")) and os.path.isdir(os.path.join(here, "..", "core")):
        sys.path.insert(0, os.path.dirname(here))  # the repo checkout (scripts/): its own core
    from core import locks
    os.makedirs(STATE, exist_ok=True)
    return locks.acquire(os.path.join(STATE, "run.lock"), wait=max(0.0, wait), poll=1.0 if wait else 0.05)


def inspect_ready():
    try:
        import inspect_ai  # noqa: F401
        return True
    except Exception:
        return False


def setup_venv(check_only=False):
    """Build / check the Inspect venv from the pinned lock next to the lib (uv; resolved under the two-week rule)."""
    lock = os.path.join(LIB, "inspect-requirements.txt")
    py = os.path.join(VENV, "bin", "python")
    want = dict(re.findall(r"^(inspect-ai|inspect-swe)==(\S+)", open(lock).read(), re.M)) if os.path.exists(lock) else {}
    if not check_only:
        uv = shutil.which("uv") or os.path.join(HOME, ".local", "bin", "uv")
        if not os.access(py, os.X_OK):
            r = subprocess.run([uv, "venv", "--python", "/usr/bin/python3", "--no-python-downloads", VENV], capture_output=True, text=True)
            if r.returncode:
                raise SystemExit(f"evals setup: uv venv failed: {r.stderr.strip()[-300:]}")
        r = subprocess.run([uv, "pip", "sync", "--python", py, lock], capture_output=True, text=True, timeout=900)
        if r.returncode:
            raise SystemExit(f"evals setup: uv pip sync failed: {r.stderr.strip()[-300:]}")
    r = subprocess.run([py, "-I", "-c", "import inspect_ai, inspect_swe; print(inspect_ai.__version__, inspect_swe.__version__)"],
                       capture_output=True, text=True) if os.access(py, os.X_OK) else None
    got = (r.stdout.split() if r and r.returncode == 0 else [])
    ok = len(got) == 2 and [want.get("inspect-ai"), want.get("inspect-swe")] == got
    print(f"evals venv {VENV}: " + (f"inspect-ai {got[0]} + inspect_swe {got[1]}" if len(got) == 2 else "missing or broken")
          + ("" if ok else f" (want {want.get('inspect-ai')} + {want.get('inspect-swe')}: run `evals setup`)"))
    return 0 if ok else 1


ISO_PROBE = r'''
import os, socket, sys
host, port = sys.argv[1].split(":")
print(f"user={os.getuid()} home={os.environ.get('HOME')}")
print("env=" + " ".join(sorted(k for k in os.environ if k != "CLAUDE_CODE_OAUTH_TOKEN")) + " (+token var)")
for h, p in [(host, int(port)), ("127.0.0.1", 8790), ("127.0.0.1", 8796), ("127.0.0.1", 9222), ("149.154.167.220", 443), ("172.17.0.1", 80)]:
    s = socket.socket(); s.settimeout(3)
    try:
        s.connect((h, p)); print(f"net {h}:{p} CONNECTED (BAD)")
    except OSError as e:
        print(f"net {h}:{p} refused: {e.strerror or e}")
    finally:
        s.close()
try:
    socket.create_connection(("api.anthropic.com", 443), timeout=6).close(); print("net model API reachable")
except OSError as e:
    print(f"net model API UNREACHABLE (BAD): {e}")
try:
    open("@REAL_HOME@/workspace/.evalbot-probe", "w"); print("write to the real home: ALLOWED (BAD)")
except OSError:
    print("write to the real home: denied")
for k in ("crontab -l", "sudo -n true"):
    r = os.system(f"/usr/bin/{k.split()[0]} {' '.join(k.split()[1:])} >/dev/null 2>&1")
    print(f"{k}: {'ALLOWED (BAD)' if r == 0 else 'denied'}")
print("stub on PATH: " + (os.popen("command -v remind").read().strip() or "none"))
'''


# ---------------------------------------------------------------- CLI
def add_run_args(p):
    p.add_argument("--case", action="append", help="case id glob (repeatable)")
    p.add_argument("--context", choices=["full", "core"],
                   help="facts import under test: full = CLAUDE.md imports FACTS.md, core = FACTS-core.md rendered "
                        "fresh from the memory rows; default: the setup as it is")
    p.add_argument("--pack", help="a folder with candidate CLAUDE.md / FACTS-core.md / MEMORY.md that replace the "
                                  "setup's copies (score a slimmer always-on pack before using it)")
    p.add_argument("--memory-hook", choices=["on", "off"], default=os.environ.get("EVALS_MEMORY_HOOK") or "on",
                   help="run the memory2 per-message hook in the sandbox like the main session (default on)")
    p.add_argument("--hub", choices=["on", "off"], default=os.environ.get("EVALS_HUB") or "on",
                   help="the MCP server `hub` (typed tools over the stubs) in the sandbox like the main session (default on)")
    p.add_argument("--tag", action="append")
    p.add_argument("--area", action="append")
    p.add_argument("--changed", action="store_true", help="only cases covering paths changed since --since / the last run")
    p.add_argument("--lock-wait", type=float, default=0.0, metavar="SECS",
                   help="wait up to SECS for the run lock before giving up (default 0: give up at once)")
    p.add_argument("--since")
    p.add_argument("-j", "--jobs", type=int, default=4)
    p.add_argument("--runs", type=int, default=1)
    p.add_argument("--max-cases", type=int, default=60)
    p.add_argument("--budget-min", type=float, default=30)
    p.add_argument("--case-timeout", type=int, default=420)
    p.add_argument("--case-usd", type=float, default=4.0)
    p.add_argument("--max-turns", type=int, default=40)
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--judge-model", default="sonnet")
    p.add_argument("--no-judge", action="store_true")
    p.add_argument("--keep", action="store_true", help="keep sandboxes and the redacted stream")
    p.add_argument("--label")
    p.add_argument("--threshold", type=float)
    p.add_argument("--json", action="store_true")
    p.add_argument("--cron", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--paths", nargs="+", help="with --changed: these changed paths instead of the brain diff")


def main():
    ap = argparse.ArgumentParser(prog="evals", description=__doc__.split("\n")[0])
    sp = ap.add_subparsers(dest="cmd")
    p = sp.add_parser("run")
    add_run_args(p)
    p.add_argument("--rev", help="brain revision to evaluate instead of the live files")
    p = sp.add_parser("compare")
    p.add_argument("rev_a")
    p.add_argument("rev_b")
    add_run_args(p)
    p = sp.add_parser("report")
    p.add_argument("run", nargs="?", default="last")
    p.add_argument("--json", action="store_true")
    p.add_argument("--failures", action="store_true")
    p = sp.add_parser("list")
    p.add_argument("--tag", action="append")
    p.add_argument("--json", action="store_true")
    p = sp.add_parser("history")
    p.add_argument("-n", type=int, default=15)
    p.add_argument("--json", action="store_true")
    p = sp.add_parser("summary")
    p.add_argument("--hours", type=float, default=26)
    p.add_argument("--json", action="store_true")
    p = sp.add_parser("isolation")
    p.add_argument("--live", action="store_true")
    p.add_argument("--keep", action="store_true")
    p = sp.add_parser("gc")
    p.add_argument("--days", type=float, default=7)
    p = sp.add_parser("setup")
    p.add_argument("--check", action="store_true")
    p = sp.add_parser("inspect", add_help=False)
    p.add_argument("args", nargs=argparse.REMAINDER)
    a = ap.parse_args()
    if not a.cmd:
        ap.print_help()
        return 2
    t0 = now()
    if a.cmd == "setup":
        return setup_venv(a.check)
    if a.cmd == "inspect":
        exe = os.path.join(VENV, "bin", "inspect")
        if not os.access(exe, os.X_OK):
            raise SystemExit("evals: no Inspect venv (run `evals setup`)")
        args = list(a.args or [])
        if (args[:1] == ["view"] or args[:2] == ["log", "list"]) and "--log-dir" not in args:
            args += ["--log-dir", LOGDIR]
        os.execv(exe, [exe] + args)
    if a.cmd in ("run", "compare"):
        if not a.dry_run and not inspect_ready():
            py = os.path.join(VENV, "bin", "python")
            if os.access(py, os.X_OK) and not os.environ.get("EVALS_REEXEC"):
                os.environ["EVALS_REEXEC"] = "1"
                sys.stdout.flush()
                os.execv(py, [py, "-I", os.path.realpath(__file__)] + sys.argv[1:])
            raise SystemExit("evals: Inspect runner unavailable (" + ("import failed" if os.access(py, os.X_OK)
                             else "no venv") + "): run `evals setup`")
    if a.cmd in ("run", "compare", "isolation", "list"):
        cfg, cases = load_corpus()
        for k, dflt in (("model", cfg.get("model")), ("effort", cfg.get("effort"))):
            if hasattr(a, k) and not getattr(a, k):
                setattr(a, k, dflt or ("claude-opus-5-5" if k == "model" else "high"))
    if a.cmd == "list":
        sel = [c for c in cases if not a.tag or set(a.tag) & set(c.get("tags") or []) or c.get("area") in a.tag]
        if a.json:
            print(json.dumps([{"id": c["id"], "area": c.get("area"), "tags": c.get("tags"), "graders": len(c.get("expect") or [])} for c in sel], indent=1))
        else:
            for c in sel:
                print(f"{c['id']:<28} {c.get('area', '-'):<12} {','.join(c.get('tags') or []):<24} {len(c.get('expect') or [])} graders")
            print(f"{len(sel)} case(s)")
        return 0
    if a.cmd == "isolation":
        for _k, _v in (("model", None), ("effort", None), ("keep", False), ("label", None), ("judge_model", "sonnet"),
                       ("no_judge", True), ("quiet", False), ("cron", False), ("jobs", 1), ("runs", 1)):
            setattr(a, _k, getattr(a, _k, _v))   # isolation has no run options of its own
        a.model, a.effort, a.case_timeout, a.max_turns, a.case_usd = a.model or "claude-opus-5-5", a.effort or "high", 300, 8, 1.0
        return isolation(a.live, a, cfg)
    if a.cmd in ("run", "compare"):
        a.rev = getattr(a, "rev", None)
        sel, info = select(cfg, cases, a)
        if a.dry_run or not sel:
            if a.json:  # the land gate reads this: the covered cases decide whether the land runs an eval step
                print(json.dumps({"dry_run": bool(a.dry_run), "cases": [c["id"] for c in sel],
                                  "selection": {k: v for k, v in info.items() if k != "paths"}}))
                return 0
            print(f"evals: {len(sel)} case(s) selected ({info.get('mode')}" + (f", since {info.get('since')}" if info.get("since") else "") + ")")
            for c in sel:
                print(f"  {c['id']}")
            return 0
        wait = getattr(a, "lock_wait", 0.0) or 0.0
        lockfd = run_lock(wait) if wait else run_lock()
        if lockfd is None:
            raise SystemExit("evals: another run is active"
                             + (f" (waited {wait:.0f} s)" if wait else ""))
        if a.cmd == "run":
            r = do_run(a, cfg, sel, rev=a.rev)
            r["selection"] = info
            jdump(os.path.join(STATE, "runs", r["run_id"], "result.json"), r)
            if a.json:
                print(json.dumps(r["totals"]))
            else:
                print_report(r, failures_only=True)
            s = summary(1)
            # a healthy run is outcome ok (the usage store counts any other exec/run outcome as a failed run + an
            # error); the state rides in attrs: a regression is a finding of the run, detailed in evals' own report
            usage_log(kind="exec", channel="cron" if a.cron else "cli", ms=int((now() - t0) * 1000), outcome="ok",
                      attrs=dict({"cases": r["totals"]["ran"]}, **({"state": "regress"} if s.get("regression") else {})))
            if a.threshold is not None and r["totals"]["score"] is not None and r["totals"]["score"] < a.threshold:
                return 3
            return 0
        ra = do_run(a, cfg, sel, rev=a.rev_a, label=f"compare {a.rev_a}", reuse=True)
        rb = do_run(a, cfg, sel, rev=a.rev_b, label=f"compare {a.rev_b}", reuse=True)
        A = {c["id"]: c for c in ra["cases"]}
        B = {c["id"]: c for c in rb["cases"]}
        sa, sb = ra["totals"]["score"], rb["totals"]["score"]
        print(f"compare {ra['rev']} → {rb['rev']}: score {fmt_score(sa)} → {fmt_score(sb)} "
              + (f"(Δ {sb - sa:+.2f}), " if sa is not None and sb is not None else "(no data on one side), ")
              + f"passed {ra['totals']['passed']} → {rb['totals']['passed']}"
              + "".join(f" · {x['rev']}: {errored_note(x['totals'])}" for x in (ra, rb) if x["totals"].get("errored")))
        for k in A:
            if k in B and A[k]["score"] != B[k]["score"] and (A[k]["score"] is None or B[k]["score"] is None
                                                                or abs(A[k]["score"] - B[k]["score"]) > 1e-9):
                print(f"  {k:<28} {fmt_score(A[k]['score'])} → {fmt_score(B[k]['score'])}")
        usage_log(kind="exec", channel="cli", ms=int((now() - t0) * 1000), outcome="ok", attrs={"cases": len(sel)})
        return 0
    if a.cmd == "report":
        r = load_run(a.run)
        if a.json:
            print(json.dumps(r, ensure_ascii=False, indent=1))
        else:
            print_report(r, a.failures)
        return 0
    if a.cmd == "history":
        rows = history(a.n)
        if a.json:
            print(json.dumps(rows))
        else:
            for r in rows:
                sc = "no data" if r.get("nodata") else fmt_score(r.get("score"))
                print(f"{r['run_id']:<26} {r['rev']}{'+' if r.get('dirty') else ' '} {sc}  {r['passed']}/{r.get('scored', r['ran'])}  "
                      + (f"err {r['errored']}  " if r.get("errored") else "")
                      + f"${r.get('cost_usd', 0):.2f}  {r.get('duration_s', 0) / 60:.0f} min  {r.get('label') or ''}")
        return 0
    if a.cmd == "summary":
        s = summary(a.hours)
        print(json.dumps(s) if a.json else (s["line"] or "no eval run in the window"))
        return 0
    if a.cmd == "gc":
        lockfd = run_lock()
        active = lockfd is None
        n, m = gc_runs(a.days, active)
        print(f"evals gc: removed {n} sandbox run(s), {m} leftover sandbox(es)" + (" (a run is active: leftovers kept)" if active else ""))
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
