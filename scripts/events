#!/usr/local/bin/python3.13 -I
"""events: the event ledger + agenda CLI. Source: ~/opt/assistant (packages/inbox, core); `events --help`.

Finds its libraries next to itself: deployed, ~/bin/lib/{core,inbox}; in the repo, ../core and ../packages/inbox.
$ASSISTANT_LIB (a directory holding core/ and inbox/) overrides both. Stdlib only (cron runs /usr/bin/python3 -I).
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_roots = [
    os.environ.get("ASSISTANT_LIB", ""),
    os.path.join(_here, "lib"),
    os.path.join(_here, ".."),
    os.path.join(_here, "..", "packages"),
]
for _pkg in ("core", "inbox"):
    for _r in _roots:
        if _r and os.path.isfile(os.path.join(_r, _pkg, "__init__.py")):
            _r = os.path.abspath(_r)
            if _r not in sys.path:
                sys.path.insert(0, _r)
            break

if __name__ == "__main__":
    if sys.argv[1:3] == ["agenda", "--hook"]:
        try:
            from inbox import hook
        except Exception:  # fail open: a broken install must never block a beat
            sys.exit(0)
        sys.exit(hook.hook_main())
    from inbox import cli

    sys.exit(cli.main(sys.argv[1:]))
