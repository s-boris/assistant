NODES = {'telegram': 'Telegram (main bot)', 'app': 'Claude app / terminal', 'me': 'Main session',
         'anthropic': 'Anthropic API', 'tools': 'Tools (shell, files)', 'subagents': 'Subagents',
         'browser': 'Browser', 'web': 'Web', 'calendar': 'Calendar', 'github': 'GitHub', 'cron': 'Cron jobs',
         'inbox': '~/inbox', 'vault': 'Vault', 'unraid': 'Unraid', 'nginx': 'nginx VM'}
