# PLAN_NAME. Writes go only through PlanWriter: method + path allowlist, and every id in a write path must belong to
# the plan routine (created in this run, or found under the name-and-marker-checked plan routine on a fresh GET).
PLAN_FILE = os.path.join(STATE, 'plan.json')
PUSHED_FILE = os.path.join(STATE, 'plan-pushed.json')
PUSH_LOG = os.path.join(STATE, 'plan-push.log')
PLAN_HISTORY = os.path.join(STATE, 'plan-history')
TOKEN_RW_FILE = os.environ.get('GYM_TOKEN_RW_FILE') or os.path.join(HOME, '.secrets/jefit-token-rw')
PLAN_NAME, TEST_NAME, PLAN_MARK = 'Assistant plan', 'Assistant test', '[gym-plan]'
TRAVEL_FILE = os.path.join(STATE, 'plan-travel.json')
