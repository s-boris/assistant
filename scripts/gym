STATE = os.environ.get('GYM_STATE_DIR') or os.path.join(HOME, '.local/state/gym')
DB_PATH = os.environ.get('GYM_DB') or os.path.join(STATE, 'gym.db')
TOKEN_FILE = os.environ.get('GYM_TOKEN_FILE') or os.path.join(HOME, '.secrets/jefit-token')
API_CONFIG = os.environ.get('GYM_API_CONFIG') or os.path.join(HOME, '.config/gym/api.json')
LB = 0.45359237
INCH = 2.54

# ----------------------------------------------------------------------------- exercise classification
MUSCLES = ['chest', 'back', 'shoulders', 'biceps', 'triceps', 'forearms', 'quads', 'hamstrings', 'glutes',
           'calves', 'abs']
# muscles held to the 10-20 hard sets/week range, with a weight for how much a shortfall matters
TRACKED = {'chest': 1.0, 'back': 1.0, 'shoulders': 1.0, 'quads': 1.0, 'hamstrings': 1.0, 'glutes': 0.8,
           'biceps': 0.7, 'triceps': 0.7, 'calves': 0.5}
TARGET_LO, TARGET_HI = 10, 20
PATTERN = {'chest': 'push', 'shoulders': 'push', 'triceps': 'push', 'back': 'pull', 'biceps': 'pull',
           'forearms': 'pull', 'quads': 'legs', 'hamstrings': 'legs', 'glutes': 'legs', 'calves': 'legs',
           'abs': 'core', 'other': 'other'}
SIDE = {'chest': 'front', 'shoulders': 'front', 'biceps': 'front', 'quads': 'front', 'abs': 'front',
        'back': 'back', 'triceps': 'back', 'hamstrings': 'back', 'glutes': 'back', 'calves': 'back'}
# (regex on the normalized name, primary muscle, secondary muscles, pattern override, side override)
RULES = [
    (r'\b(wrist|forearm|gripper|hand grip|farmer)', 'forearms', [], None, None),
    (r'\b(calf|calves)\b', 'calves', [], None, None),
    (r'\b(skull ?crusher|triceps?|push ?down|french press|close grip bench|jm press|bench dip)', 'triceps', [],
     None, None),
    (r'\b(back extension|hyper ?extension|reverse hyper)', 'back', ['glutes', 'hamstrings'], 'legs', None),
    (r'\b(hip thrust|glute|bridge|kickback|abduct)', 'glutes', ['hamstrings'], None, None),
    (r'\b(leg curl|hamstring curl|nordic)', 'hamstrings', [], None, None),
    (r'\b(romanian|rdl|stiff leg|good morning|hamstring|swing)', 'hamstrings', ['glutes'], None, None),
    (r'\bdeadlift', 'hamstrings', ['glutes', 'back'], None, None),
    (r'\b(leg extension|sissy)', 'quads', [], None, None),
    (r'\b(squat|leg press|lunge|step up|hack)', 'quads', ['glutes'], None, None),
    (r'\b(rear delt|reverse fly|reverse flye|face pull|reverse pec)', 'shoulders', ['back'], 'pull', 'back'),
    (r'\b(lateral raise|side raise|front raise|upright row)', 'shoulders', [], None, None),
    (r'\b(overhead press|shoulder press|military|arnold|push press|landmine press|delt)', 'shoulders',
     ['triceps'], None, None),
    (r'\bshrug', 'back', [], None, None),
    (r'\b(pull ?ups?|chin ?ups?|pull ?down|lat|lats|row|pullover|rack pull|muscle up)\b', 'back', ['biceps'],
     None, None),
    (r'\bcurl', 'biceps', [], None, None),
    (r'\b(fly|flye|flyes|crossover|pec deck)\b', 'chest', [], None, None),
    (r'\b(bench press|chest|fly|flye|flyes|pec|push ?ups?|press ?ups?|crossover|dips?)\b', 'chest',
     ['triceps', 'shoulders'], None, None),
    (r'\b(incline|decline)\b.*\bpress|\bpress\b.*\b(incline|decline)\b', 'chest', ['triceps', 'shoulders'],
     None, None),
    (r'\b(crunch|sit ?ups?|plank|leg raise|knee raise|russian twist|rollout|ab wheel|hollow|woodchop|pallof|'
     r'dead bug|v ups?|toes to bar|abs?|oblique|l sit)\b', 'abs', [], None, None),
    (r'\bextension', 'triceps', [], None, None),
    (r'\bpress\b', 'chest', ['triceps', 'shoulders'], None, None),
]
EQUIPMENT = [
    (r'\b(trap bar|hex bar)', 'trap bar'), (r'\b(ez ?bar|ez curl|ez)\b', 'ez bar'),
    (r'\b(barbell|bb)\b', 'barbell'), (r'\b(dumbbells?|db)\b', 'dumbbell'), (r'\b(kettlebells?|kb)\b', 'kettlebell'),
    (r'\bsmith\b', 'machine'), (r'\b(cable|crossover|push ?down|face pull|pull ?down)', 'cable'),
    (r'\b(machine|leg press|leg extension|leg curl|hack|pec deck|selectorized|hammer strength)', 'machine'),
    (r'\bbands?\b', 'band'),
    (r'\b(pull ?ups?|chin ?ups?|dips?|push ?ups?|press ?ups?|plank|hanging|sit ?ups?|crunch|bodyweight|burpee|'
     r'muscle up|inverted row|back extension|hyper ?extension|leg raise|hollow|l sit|dead hang)\b', 'bodyweight'),
    (r'^(back |front )?squat$|^(conventional |sumo |romanian )?deadlift$|^rdl$|^bench press$|'
     r'^(overhead|military) press$', 'barbell'),
]
BODYWEIGHT_RE = re.compile(r'\b(pull ?ups?|chin ?ups?|dips?|push ?ups?|press ?ups?|hanging|sit ?ups?|crunch|'
                           r'muscle up|inverted row|leg raise|knee raise|bodyweight|burpee|toes to bar|'
                           r'back extension|hyper ?extension)\b')
TIMED_RE = re.compile(r'\b(plank|hold|wall sit|dead hang|l sit|hollow|isometric|farmer|carry|static)\b')
# Jefit body-part codes (exports and the API): 8 = upper legs (refined by name), 9 = lower legs
JEFIT_BODYPART = {0: 'abs', 1: 'back', 2: 'biceps', 3: 'chest', 4: 'forearms', 5: 'glutes', 6: 'shoulders',
                  7: 'triceps', 8: 'legs', 9: 'calves', 10: 'cardio', 11: 'other'}
JEFIT_BODYPART_KEYS = {'abs': 'abs', 'back': 'back', 'biceps': 'biceps', 'chest': 'chest', 'forearms': 'forearms',
                       'glutes': 'glutes', 'shoulders': 'shoulders', 'triceps': 'triceps', 'upper_legs': 'legs',
                       'lower_legs': 'calves', 'cardio': 'cardio'}
DEFAULT_PICK = {'chest': 'Incline Dumbbell Press', 'back': 'Seated Cable Row', 'shoulders': 'Dumbbell Lateral Raise',
                'biceps': 'Dumbbell Curl', 'triceps': 'Cable Triceps Pushdown', 'quads': 'Leg Press',
                'hamstrings': 'Romanian Deadlift', 'glutes': 'Hip Thrust', 'calves': 'Standing Calf Raise'}


def norm_name(name):
    s = (name or '').lower().replace('-', ' ')
    s = re.sub(r'[^a-z0-9 ]+', ' ', s)
    return re.sub(r'\s+', ' ', s).strip()


def classify(name, bodypart=None, equip_hint=None):
    """-> dict(muscle, secondary list, equipment, pattern, side, kind) from the name (+ Jefit body part)."""
    n = norm_name(name)
    muscle, secondary, pattern, side = 'other', [], None, None
    for rx, m, sec, pat, sd in RULES:
        if re.search(rx, n):
            muscle, secondary, pattern, side = m, list(sec), pat, sd
            break
    code = JEFIT_BODYPART.get(bodypart) if isinstance(bodypart, int) else JEFIT_BODYPART_KEYS.get(
        str(bodypart or '').strip().lower())
    if code == 'legs':
        if muscle not in ('quads', 'hamstrings', 'glutes'):
            muscle, secondary, pattern, side = 'quads', ['glutes'], None, None
    elif code == 'cardio':
        muscle, secondary, pattern, side = 'other', [], 'other', None
    elif code and code != 'other' and code != muscle:
        muscle, secondary, pattern, side = code, [], None, None
    equipment = (equip_hint or '').strip().lower().replace('_', ' ') or None
    if not equipment:
        equipment = 'other'
        for rx, eq in EQUIPMENT:
            if re.search(rx, n):
                equipment = eq
                break
    kind = 'timed' if TIMED_RE.search(n) else 'bodyweight' if BODYWEIGHT_RE.search(n) else 'weight'
    return {'muscle': muscle, 'secondary': [s for s in secondary if s != muscle], 'equipment': equipment,
            'pattern': pattern or PATTERN.get(muscle, 'other'), 'side': side or SIDE.get(muscle, ''),
            'kind': kind}


def epley(weight, reps):
    if not weight or weight <= 0 or not reps or reps < 1 or reps > 12:
        return None
    return round(weight if reps == 1 else weight * (1 + reps / 30.0), 2)


# ----------------------------------------------------------------------------- time helpers
def owner_tz():
    name = os.environ.get('OWNER_TZ')
    if name:
        return ZoneInfo(name)
    try:
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), 'lib'))
        import assistant_profile
        return assistant_profile.tz()
    except Exception:
        return ZoneInfo('UTC')


def today():
    if os.environ.get('GYM_NOW'):
        return dt.date.fromisoformat(os.environ['GYM_NOW'][:10])
    return dt.datetime.now(owner_tz()).date()


def now_dt():
    """Owner-local now; GYM_NOW = a date (end of that day) or a datetime (tests)."""
    v, tz = os.environ.get('GYM_NOW'), owner_tz()
    if v:
        if len(v) > 10:
            x = dt.datetime.fromisoformat(v)
            return x if x.tzinfo else x.replace(tzinfo=tz)
        return dt.datetime.combine(dt.date.fromisoformat(v[:10]), dt.time(23, 59, 59), tz)
    return dt.datetime.now(tz)


def ts_to_date(ts):
    return dt.datetime.fromtimestamp(ts, owner_tz()).date().isoformat()


def as_ts(v):
    """unix seconds (or ms) / ISO datetime / date string -> int seconds or None."""
    if v is None:
        return None
    s = str(v).strip().strip('"')
    if not s or s in ('0', 'null', 'None'):
        return None
    try:
        x = float(s)
        if x <= 0:
            return None
        return int(x / 1000) if x > 1e11 else int(x)
    except ValueError:
        pass
    try:
        d = dt.datetime.fromisoformat(s.replace('Z', '+00:00'))
        if d.tzinfo is None:
            d = d.replace(tzinfo=owner_tz())
        return int(d.timestamp())
    except ValueError:
        return None


def as_date(v):
    s = str(v or '').strip().strip('"')
    m = re.match(r'(\d{4})-(\d{2})-(\d{2})', s)
    return f'{m.group(1)}-{m.group(2)}-{m.group(3)}' if m else None


def num(v, default=None):
    try:
        x = float(str(v).strip().strip('"'))
        return x if math.isfinite(x) else default
    except (TypeError, ValueError):
        return default


def ddmm(iso):
    d = dt.date.fromisoformat(iso)
    return f'{d.day:02d}.{d.month:02d}.'


def fmt_kg(x):
    if x is None:
        return '-'
    return f'{x:.1f}'.rstrip('0').rstrip('.') if abs(x - round(x)) > 0.01 else f'{round(x):d}'


def fmt_w(x):
    return f'{x:.2f}'.rstrip('0').rstrip('.') if x is not None else '-'


def fmt_n(x):
    return f'{x:,.0f}'.replace(',', "'")


# ----------------------------------------------------------------------------- sets from Jefit logs
SET_RE = re.compile(r'^(-?\d+(?:\.\d+)?)\s*[xX*]\s*(\d+(?:\.\d+)?)(?:\s*(s|sec|secs)|:(\d{1,2}))?$')


def parse_logs(text, timed=False, unit_factor=1.0):
    """Jefit "40x8,40x8,40x5," -> (sets, status). status: ok | empty | cardio | bad.
    Timed exercises (or "60s" / "1:30" reps) give duration_s instead of reps."""
    toks = [t.strip() for t in str(text or '').split(',') if t.strip()]
    if not toks:
        return [], 'empty'
    parsed = []
    for t in toks:
        m = SET_RE.match(t)
        if not m:
            return [], 'bad'
        parsed.append(m)
    if any('.' in m.group(2) for m in parsed) and not timed:
        return [], 'cardio'   # Jefit cardio entries look like "0x0.0,0x10"
    sets = []
    for m in parsed:
        w = float(m.group(1)) * unit_factor
        r = float(m.group(2))
        if m.group(4) is not None:      # m:ss
            dur, reps = int(r) * 60 + int(m.group(4)), None
        elif m.group(3) or timed:
            dur, reps = int(round(r)), None
        else:
            dur, reps = None, int(round(r))
        if not reps and not dur:
            continue
        sets.append({'w': round(w, 2) if w > 0 else 0.0, 'reps': reps, 'dur': dur})
    return sets, ('ok' if sets else 'empty')


# ----------------------------------------------------------------------------- CSV export parser
def read_sections(text):
    """Section name -> list of records (dicts keyed by their block's header row)."""
    sections, cur, header = {}, None, None
    for fields in csv.reader(io.StringIO(text.lstrip('﻿'))):
        first = fields[0].strip() if fields else ''
        if first.startswith('###') and all(not f.strip() for f in fields[1:]):
            name = first.strip('#').strip()
            cur = sections.setdefault(name.upper(), []) if name else None
            header = None
            continue
        if not fields or all(not f.strip() for f in fields):
            header = None
            continue
        if cur is None:
            continue
        if header is None:
            header = [h.strip() for h in fields]
            continue
        cur.append({h: (fields[i] if i < len(fields) else '') for i, h in enumerate(header)})
    return sections


def parse_unit(v):
    s = str(v or '').strip().lower()
    if s.startswith('lb') or s.startswith('pound'):
        return 'lb'
    if s.startswith('kg') or s.startswith('kilo'):
        return 'kg'
    return None


def parse_csv_export(text, unit=None):
    """-> dict(sessions=[...], body=[...], unit, length_unit, report={...}); raises ValueError on a non-export."""
    sec = read_sections(text)
    if 'EXERCISE LOGS' not in sec:
        raise ValueError('not a Jefit export: no "### EXERCISE LOGS ###" section')
    setting = (sec.get('SETTING') or [{}])[0]
    file_unit = parse_unit(setting.get('mass'))
    rep = {'unit_source': 'option' if unit else ('file' if file_unit else 'default'), 'cardio': 0, 'empty': 0,
           'bad': 0, 'orphan_logs': 0, 'logs': 0, 'sets': 0}
    unit = unit or file_unit or 'kg'
    f = LB if unit == 'lb' else 1.0
    length_unit = 'in' if str(setting.get('length', '')).strip().lower().startswith('in') else 'cm'

    # body parts / equipment hints: custom exercises and routine exercise blocks
    bodypart = {}
    for r in sec.get('CUSTOM EXERCISES', []):
        k = f"0:{str(r.get('_id', '')).strip()}"
        bp = num(r.get('bodypart'))
        if bp is not None:
            bodypart[k] = int(bp)
    for r in sec.get('ROUTINES', []):
        if 'exercise_id' in r and 'bodypart' in r:
            k = f"{int(num(r.get('belongSys'), 1))}:{str(r.get('exercise_id', '')).strip()}"
            bp = num(r.get('bodypart'))
            if bp is not None and k not in bodypart:
                bodypart[k] = int(bp)

    # per-set durations from EXERCISE SET LOGS (recent workouts only)
    set_dur = {}
    for r in sec.get('EXERCISE SET LOGS', []):
        d = num(r.get('duration'), 0) or 0
        if d > 0:
            set_dur.setdefault(str(r.get('exercise_log_id', '')).strip(), {})[int(num(r.get('set_index'), 0))] = int(d)

    sessions = {}
    for r in sec.get('WORKOUT SESSIONS', []):
        sid = str(r.get('_id', '')).strip()
        if not sid:
            continue
        start = as_ts(r.get('starttime')) or as_ts(r.get('starttimie'))
        dur = num(r.get('total_time'), 0) or 0
        if not dur and start and as_ts(r.get('endtime')):
            dur = max(0, as_ts(r.get('endtime')) - start)
        sessions[sid] = {'uid': f'jefit:{sid}', 'date': ts_to_date(start) if start else as_date(r.get('mydate')),
                         'start_ts': start, 'duration_s': int(dur) or None, 'logs': {}}

    # exercise display names: per id, the most recent non-empty name (Jefit renames exercises over time)
    logs = sec['EXERCISE LOGS']
    latest = {}
    for r in logs:
        k = exercise_key(r)
        nm = str(r.get('ename', '')).strip()
        when = as_date(r.get('mydate')) or ''
        if nm and (k not in latest or when >= latest[k][0]):
            latest[k] = (when, nm)

    for r in logs:
        k = exercise_key(r)
        name = latest.get(k, ('', ''))[1] or str(r.get('ename', '')).strip()
        if not name:
            rep['empty'] += 1
            continue
        jkey = k if k.startswith('jefit:') else None
        cls = classify(name, bodypart.get(k[6:]) if jkey else None)
        log_id = str(r.get('_id', '')).strip()
        timed = cls['kind'] == 'timed' or bool(set_dur.get(log_id))
        sets, status = parse_logs(r.get('logs'), timed=timed, unit_factor=f)
        if status != 'ok':
            rep[status] += 1
            continue
        for i, d in (set_dur.get(log_id) or {}).items():
            if 0 <= i < len(sets):
                sets[i]['dur'], sets[i]['reps'] = d, None
        sid = str(r.get('belongsession', '')).strip()
        if sid not in sessions:
            start = as_ts(r.get('logTime'))
            date = as_date(r.get('mydate')) or (ts_to_date(start) if start else None)
            if not date:
                rep['bad'] += 1
                continue
            rep['orphan_logs'] += 1
            sid = sid or f'{date}'
            sessions.setdefault(sid, {'uid': f'jefit:{sid}', 'date': date, 'start_ts': start, 'duration_s': None,
                                      'logs': {}})
        s = sessions[sid]
        if not s['date']:
            s['date'] = as_date(r.get('mydate'))
        lg = s['logs'].setdefault(k, {'xkey': k, 'name': name, 'bodypart': bodypart.get(k[6:]) if jkey else None,
                                      'equip': None, 'record_kg': None, 'sets': []})
        lg['sets'].extend(sets)
        rec = num(r.get('record'))
        if rec and rec > 0:
            lg['record_kg'] = round(max(lg['record_kg'] or 0, rec * f), 2)
        rep['logs'] += 1
        rep['sets'] += len(sets)

    out = []
    for s in sessions.values():
        if s['logs'] and s['date']:
            s['logs'] = list(s['logs'].values())
            out.append(s)
    out.sort(key=lambda s: (s['date'], s['start_ts'] or 0))

    body = []
    lf = INCH if length_unit == 'in' else 1.0
    for r in sec.get('PROFILE', []):
        d = as_date(r.get('mydate'))
        if not d:
            continue
        w = num(r.get('weight'), 0) or 0
        fat = num(r.get('fatpercent'), 0) or 0
        meas = {}
        for c in ('chest', 'arms', 'waist', 'hips', 'thighs', 'calves', 'shoulders', 'neck', 'forearms'):
            v = num(r.get(c), 0) or 0
            if v > 0:
                meas[c] = round(v * lf, 1)
        if w > 0 or fat > 0 or meas:
            body.append({'date': d, 'weight_kg': round(w * f, 2) if w > 0 else None,
                         'fat_pct': fat if fat > 0 else None, 'measures': meas})
    return {'sessions': out, 'body': body, 'unit': unit, 'length_unit': length_unit, 'report': rep}


def exercise_key(r):
    eid = str(r.get('eid', '')).strip()
    if eid and re.fullmatch(r'\d+', eid):
        return f"jefit:{int(num(r.get('belongSys'), 1))}:{eid}"
    return 'name:' + norm_name(r.get('ename'))


# ----------------------------------------------------------------------------- database
SCHEMA = """
CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS sessions (
  id INTEGER PRIMARY KEY, date TEXT NOT NULL, start_ts INTEGER, duration_s INTEGER, total_kg REAL,
  source TEXT, hash TEXT, updated_at TEXT);
CREATE INDEX IF NOT EXISTS sessions_date ON sessions(date);
CREATE TABLE IF NOT EXISTS session_uids (uid TEXT PRIMARY KEY, session_id INTEGER NOT NULL
  REFERENCES sessions(id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS exercises (
  id INTEGER PRIMARY KEY, name TEXT NOT NULL, muscle TEXT, secondary TEXT, equipment TEXT, pattern TEXT,
  side TEXT, kind TEXT, bodypart TEXT, manual INTEGER DEFAULT 0);
CREATE TABLE IF NOT EXISTS exercise_keys (key TEXT PRIMARY KEY, exercise_id INTEGER NOT NULL
  REFERENCES exercises(id) ON DELETE CASCADE);
CREATE TABLE IF NOT EXISTS exercise_logs (
  id INTEGER PRIMARY KEY, session_id INTEGER NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
  exercise_id INTEGER NOT NULL REFERENCES exercises(id), pos INTEGER, record_kg REAL,
  UNIQUE(session_id, exercise_id));
CREATE TABLE IF NOT EXISTS sets (
  id INTEGER PRIMARY KEY, log_id INTEGER NOT NULL REFERENCES exercise_logs(id) ON DELETE CASCADE,
  idx INTEGER NOT NULL, weight_kg REAL, reps INTEGER, duration_s INTEGER, e1rm_kg REAL, UNIQUE(log_id, idx));
CREATE TABLE IF NOT EXISTS body_stats (
  date TEXT PRIMARY KEY, weight_kg REAL, fat_pct REAL, measures TEXT, source TEXT);
CREATE TABLE IF NOT EXISTS imports (
  id INTEGER PRIMARY KEY, at TEXT, source TEXT, detail TEXT, new INTEGER, updated INTEGER, unchanged INTEGER);
"""


def connect(path=None):
    path = path or DB_PATH
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    fresh = not os.path.exists(path)
    old = os.umask(0o077)
    try:
        conn = sqlite3.connect(path)
    finally:
        os.umask(old)
    if fresh:
        os.chmod(path, 0o600)
    conn.execute('PRAGMA foreign_keys = ON')
    conn.executescript(SCHEMA)
    return conn


def session_hash(s):
    body = [s['date'], s.get('start_ts'), s.get('duration_s'),
            sorted([lg['xkey'], [[x['w'], x['reps'], x['dur']] for x in lg['sets']]] for lg in s['logs'])]
    return hashlib.sha1(json.dumps(body, sort_keys=True).encode()).hexdigest()


def ensure_exercise(conn, lg):
    """Exercise id for a log: by key, else by normalized name; reclassify unless fixed by hand."""
    key, nkey = lg['xkey'], 'name:' + norm_name(lg['name'])
    row = conn.execute('SELECT exercise_id FROM exercise_keys WHERE key=?', (key,)).fetchone() or \
        conn.execute('SELECT exercise_id FROM exercise_keys WHERE key=?', (nkey,)).fetchone()
    cls = classify(lg['name'], lg.get('bodypart'), lg.get('equip'))
    has_dur = any(x['dur'] for x in lg['sets'])
    if has_dur:
        cls['kind'] = 'timed'
    elif cls['kind'] == 'weight' and lg['sets'] and all(not x['w'] for x in lg['sets']):
        cls['kind'] = 'bodyweight'
    if cls['kind'] != 'weight' and cls['equipment'] == 'other':
        cls['equipment'] = 'bodyweight'
    bp = lg.get('bodypart')
    vals = (lg['name'], cls['muscle'], ','.join(cls['secondary']), cls['equipment'], cls['pattern'], cls['side'],
            cls['kind'], None if bp is None else str(bp))
    if row:
        xid = row[0]
        manual = conn.execute('SELECT manual FROM exercises WHERE id=?', (xid,)).fetchone()[0]
        if manual:
            conn.execute('UPDATE exercises SET name=? WHERE id=?', (lg['name'], xid))
        else:
            conn.execute('UPDATE exercises SET name=?, muscle=?, secondary=?, equipment=?, pattern=?, side=?, '
                         'kind=?, bodypart=COALESCE(?, bodypart) WHERE id=?', vals + (xid,))
    else:
        xid = conn.execute('INSERT INTO exercises (name, muscle, secondary, equipment, pattern, side, kind, bodypart) '
                           'VALUES (?,?,?,?,?,?,?,?)', vals).lastrowid
    for k in (key, nkey):
        conn.execute('INSERT OR IGNORE INTO exercise_keys (key, exercise_id) VALUES (?,?)', (k, xid))
    return xid


def find_session(conn, s):
    row = conn.execute('SELECT u.session_id, x.date, x.start_ts FROM session_uids u JOIN sessions x ON '
                       'x.id=u.session_id WHERE u.uid=?', (s['uid'],)).fetchone()
    if row and (row[1] == s['date'] or (row[2] and s.get('start_ts') and abs(row[2] - s['start_ts']) <= 120)):
        return row[0]   # same source id on another day = an id from another export: match by time instead
    if s.get('start_ts'):
        row = conn.execute('SELECT id FROM sessions WHERE start_ts IS NOT NULL AND abs(start_ts-?) <= 120 '
                           'ORDER BY abs(start_ts-?) LIMIT 1', (s['start_ts'], s['start_ts'])).fetchone()
        if row:
            return row[0]
    keys = []
    for lg in s['logs']:
        keys += [lg['xkey'], 'name:' + norm_name(lg['name'])]
    q = ('SELECT DISTINCT s.id FROM sessions s JOIN exercise_logs l ON l.session_id=s.id '
         'JOIN exercise_keys k ON k.exercise_id=l.exercise_id WHERE s.date=? AND k.key IN (%s)'
         % ','.join('?' * len(keys)))
    if not s.get('start_ts'):
        row = conn.execute(q, [s['date']] + keys).fetchone()
    else:
        row = conn.execute(q + ' AND s.start_ts IS NULL', [s['date']] + keys).fetchone()
    return row[0] if row else None


def store(conn, data, source, detail, dry_run=False):
    counts = {'new': 0, 'updated': 0, 'unchanged': 0, 'body': 0}
    for s in data['sessions']:
        sid = find_session(conn, s)
        h = session_hash(s)
        if sid:
            old = conn.execute('SELECT hash FROM sessions WHERE id=?', (sid,)).fetchone()[0]
            if old == h:
                counts['unchanged'] += 1
                if not dry_run:
                    conn.execute('INSERT OR IGNORE INTO session_uids (uid, session_id) VALUES (?,?)', (s['uid'], sid))
                continue
            counts['updated'] += 1
        else:
            counts['new'] += 1
        if dry_run:
            continue
        now = dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')
        total = round(sum((x['w'] or 0) * (x['reps'] or 0) for lg in s['logs'] for x in lg['sets']), 1)
        if sid:
            conn.execute('UPDATE sessions SET date=?, start_ts=?, duration_s=?, total_kg=?, source=?, hash=?, '
                         'updated_at=? WHERE id=?', (s['date'], s['start_ts'], s['duration_s'], total, source, h,
                                                     now, sid))
            conn.execute('DELETE FROM exercise_logs WHERE session_id=?', (sid,))
        else:
            sid = conn.execute('INSERT INTO sessions (date, start_ts, duration_s, total_kg, source, hash, updated_at) '
                               'VALUES (?,?,?,?,?,?,?)', (s['date'], s['start_ts'], s['duration_s'], total, source,
                                                          h, now)).lastrowid
        conn.execute('INSERT OR IGNORE INTO session_uids (uid, session_id) VALUES (?,?)', (s['uid'], sid))
        for pos, lg in enumerate(s['logs']):
            xid = ensure_exercise(conn, lg)
            row = conn.execute('SELECT id FROM exercise_logs WHERE session_id=? AND exercise_id=?', (sid, xid)).fetchone()
            if row:   # two source exercises mapped to one (e.g. renamed): append the sets
                lid = row[0]
                base = conn.execute('SELECT COALESCE(MAX(idx)+1, 0) FROM sets WHERE log_id=?', (lid,)).fetchone()[0]
            else:
                lid = conn.execute('INSERT INTO exercise_logs (session_id, exercise_id, pos, record_kg) VALUES (?,?,?,?)',
                                   (sid, xid, pos, lg.get('record_kg'))).lastrowid
                base = 0
            for i, x in enumerate(lg['sets']):
                conn.execute('INSERT INTO sets (log_id, idx, weight_kg, reps, duration_s, e1rm_kg) VALUES (?,?,?,?,?,?)',
                             (lid, base + i, x['w'], x['reps'], x['dur'], epley(x['w'], x['reps'])))
    for b in data.get('body', []):
        if dry_run:
            counts['body'] += 1
            continue
        cur = conn.execute('SELECT weight_kg, fat_pct, measures FROM body_stats WHERE date=?', (b['date'],)).fetchone()
        new = (b['weight_kg'], b['fat_pct'], json.dumps(b['measures'], sort_keys=True))
        if cur != new:
            conn.execute('INSERT OR REPLACE INTO body_stats (date, weight_kg, fat_pct, measures, source) '
                         'VALUES (?,?,?,?,?)', (b['date'],) + new + (source,))
            counts['body'] += 1
    if not dry_run:
        conn.execute('INSERT INTO imports (at, source, detail, new, updated, unchanged) VALUES (?,?,?,?,?,?)',
                     (dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'), source, detail,
                      counts['new'], counts['updated'], counts['unchanged']))
        conn.commit()
    return counts


# ----------------------------------------------------------------------------- import csv
def cmd_import_csv(a):
    try:
        with open(a.file, encoding='utf-8-sig', errors='replace', newline='') as fh:
            text = fh.read()
        data = parse_csv_export(text, unit=a.unit)
    except (OSError, ValueError) as e:
        print(f'gym import: {e}', file=sys.stderr)
        return 1
    conn = connect()
    counts = store(conn, data, 'csv', os.path.basename(a.file), dry_run=a.dry_run)
    rep = data['report']
    out = {'file': os.path.basename(a.file), 'unit': data['unit'], 'unit_source': rep['unit_source'],
           'sessions': len(data['sessions']), **counts, 'exercise_logs': rep['logs'], 'sets': rep['sets'],
           'skipped': {k: rep[k] for k in ('cardio', 'empty', 'bad') if rep[k]},
           'orphan_logs': rep['orphan_logs'], 'dry_run': a.dry_run}
    if a.json:
        print(json.dumps(out))
        return 0
    pre = 'Would import' if a.dry_run else 'Imported'
    print(f"{pre} {out['file']}: {out['sessions']} sessions ({counts['new']} new, {counts['updated']} updated, "
          f"{counts['unchanged']} unchanged), {rep['logs']} exercise logs, {rep['sets']} sets, "
          f"{counts['body']} body-stat rows; unit {data['unit']} ({rep['unit_source']}).")
    if out['skipped']:
        print('Skipped logs: ' + ', '.join(f'{v} {k}' for k, v in out['skipped'].items()) + '.')
    if rep['orphan_logs']:
        print(f"{rep['orphan_logs']} logs had no session row; grouped by their date.")
    if rep['unit_source'] == 'default':
        print('No unit in the file: assumed kg (use --unit lb if the export is in pounds).')
    return 0


# ----------------------------------------------------------------------------- Open Training API adapter
# Jefit Open Training API: a personal access token (Elite; jefit.com -> Settings -> Open Training API) sent as
# "Authorization: Bearer <token>" to the /api/v2 REST surface of the web app. Token-readable GETs used here:
#   /api/v2/user/routines                  token check (401 without a valid token)
#   /api/v2/exercises                      system + the user's custom exercises; custom ones carry numeric_user_id,
#                                          which gives {uid} (or set "user_id" in the API settings file)
#   /api/v2/users/{uid}/sessions/calendar  every date with a session (first sync starts at the earliest one)
#   /api/v2/users/{uid}/sessions?startDate=S&endDate=E
#                                          sessions in [S, E) (local-midnight unix seconds) with inline logs and sets
#   /api/v2/users/{uid}/exercises          the user's exercises: name, body_parts, equipment (logs carry ids only)
# /api/v2/user and body stats refuse the token (401/403): body stats come from the CSV export only.
API_DEFAULTS = {
    'base': 'https://www.jefit.com',
    'auth': 'bearer',        # 'bearer' | 'token' | 'x-api-key' (probe falls back through them)
    'confirmed': True,
    'unit': 'lb',            # unit of the API's plain set "weight"/"record": Jefit stores pounds whatever the
                             # account's unit_system says ("metric" only changes the display)
    'user_id': None,         # numeric Jefit user id; found once through the token, then kept here
    'check_path': '/api/v2/user/routines',
    'catalog_path': '/api/v2/exercises',
    'calendar_path': '/api/v2/users/{uid}/sessions/calendar',
    'sessions_path': '/api/v2/users/{uid}/sessions?startDate={start}&endDate={end}',
    'exercises_path': '/api/v2/users/{uid}/exercises',
    'chunk_days': 365,
    'max_requests': 400,
}
AUTH_SCHEMES = [('bearer', 'Authorization', 'Bearer {t}'), ('token', 'Authorization', 'Token {t}'),
                ('x-api-key', 'X-API-Key', '{t}')]
PENDING = "API details pending: set \"confirmed\": true in the API settings once the endpoints are known."
# Jefit equipment codes -> this tool's equipment names (others: from the exercise name)
API_EQUIPMENT = {'barbell': 'barbell', 'dumbbell': 'dumbbell', 'ez_curl_bar': 'ez bar', 'kettlebell': 'kettlebell',
                 'machine_strength': 'machine', 'smith_machine': 'machine', 'cable': 'cable', 'band': 'band',
                 'body': 'bodyweight', 'pullup_bar': 'bodyweight', 'trap_bar': 'trap bar'}


def api_config():
    cfg = dict(API_DEFAULTS)
    try:
        with open(API_CONFIG) as fh:
            cfg.update(json.load(fh))
    except (OSError, ValueError):
        pass
    if os.environ.get('JEFIT_API_BASE'):
        cfg['base'] = os.environ['JEFIT_API_BASE']
    return cfg


def save_api_config(cfg):
    """Keeps only the settings that differ from the defaults (the base URL never: env overrides stay out)."""
    os.makedirs(os.path.dirname(API_CONFIG), mode=0o700, exist_ok=True)
    try:
        with open(API_CONFIG) as fh:
            keep = {k: v for k, v in json.load(fh).items() if k in API_DEFAULTS}
    except (OSError, ValueError):
        keep = {}
    keep.update({k: v for k, v in cfg.items() if k in API_DEFAULTS and k != 'base' and v != API_DEFAULTS[k]})
    tmp = API_CONFIG + '.tmp'
    with open(tmp, 'w') as fh:
        json.dump(keep, fh, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, API_CONFIG)


def read_token():
    """-> token or None. Refuses a token file readable by others."""
    try:
        st = os.stat(TOKEN_FILE)
    except OSError:
        return None
    if st.st_mode & 0o077:
        raise PermissionError(f'{TOKEN_FILE} must be 0600 (chmod 600 it)')
    with open(TOKEN_FILE) as fh:
        tok = fh.read().strip()
    return tok or None


def egress_read():
    """The read token goes by handle "gym" (core.egress) only while this run uses the live default file;
    a test's own token (GYM_TOKEN_FILE) keeps the direct path. Plan writes with this token go by handle too; a
    jefit-token-rw (TOKEN_RW_FILE) stays direct until it has a binding of its own."""
    return _egress is not None and \
        os.path.realpath(TOKEN_FILE) == os.path.realpath(os.path.expanduser('~/.secrets/jefit-token'))


def read_api_token():
    """-> the read token for Api, or None: by handle when egress_read(), else read_token()."""
    if not egress_read():
        return read_token()
    try:
        st = os.stat(TOKEN_FILE)
    except OSError:
        st = None
    if st is not None and st.st_mode & 0o077:
        raise PermissionError(f'{TOKEN_FILE} must be 0600 (chmod 600 it)')
    try:
        return _egress.secret('gym')
    except _egress.Missing:
        return None


def token_state():
    """-> 'present' | 'missing' | 'by handle (hub)' for status; PermissionError on a token file readable by others."""
    if not read_api_token():
        return 'missing'
    return 'by handle (hub)' if egress_read() and _egress.mode('gym') == 'hub' else 'present'


def no_token_hint():
    """Why there is no token: the live file by handle (its egress mode) or a token file not set up yet."""
    if egress_read():
        return (f'no Jefit token by handle (core.egress gym, {_egress.mode("gym")} mode: {TOKEN_FILE} missing or '
                f'empty; hub mode needs no file)')
    return f'no Jefit token yet ({TOKEN_FILE}, 0600, via the console)'


class Api:
    def __init__(self, cfg, token, handle=None):
        self.cfg, self._t, self.count, self.handle = cfg, token, 0, handle

    def scrub(self, s):
        return str(s).replace(self._t, '***') if self._t else str(s)

    def get(self, path, scheme=None):
        """Read-only GET -> (status, content_type, parsed JSON or None)."""
        scheme = scheme or self.cfg.get('auth') or 'bearer'
        if self.count >= int(self.cfg.get('max_requests') or 400):
            raise RuntimeError('request cap reached; run again to continue')
        self.count += 1
        hdr = next((h, v) for n, h, v in AUTH_SCHEMES if n == scheme)
        url = self.cfg['base'].rstrip('/') + path
        req = urllib.request.Request(url, method='GET', headers={
            hdr[0]: hdr[1].format(t=self._t), 'Accept': 'application/json', 'User-Agent': 'gym-sync/1 (read-only)'})
        try:
            with (_egress.open(req, self.handle, timeout=60) if self.handle else
                  urllib.request.urlopen(req, timeout=60)) as r:
                status, ctype, raw = r.status, r.headers.get('Content-Type', ''), r.read(50_000_000)
        except urllib.error.HTTPError as e:
            status, ctype, raw = e.code, e.headers.get('Content-Type', '') if e.headers else '', b''
        except (urllib.error.URLError, OSError) as e:
            raise RuntimeError(self.scrub(f'{url}: {getattr(e, "reason", e)}')) from None
        body = None
        if raw and 'json' in ctype.lower():
            try:
                body = json.loads(raw.decode('utf-8', 'replace'))
            except ValueError:
                body = None
        return status, ctype.split(';')[0], body


def shape(v, depth=0):
    """JSON structure with key names and list lengths only, never values."""
    if isinstance(v, dict):
        if depth >= 3:
            return '{...}'
        return {k: shape(x, depth + 1) for k, x in list(v.items())[:40]}
    if isinstance(v, list):
        return [f'len={len(v)}'] + ([shape(v[0], depth + 1)] if v else [])
    return type(v).__name__


def fill(path, **kw):
    return path.format(**{k: urllib.parse.quote(str(v), safe='') for k, v in kw.items()})


def local_midnight(d):
    return int(dt.datetime.combine(d, dt.time(), owner_tz()).timestamp())


def find_uid(api, cfg):
    """-> numeric Jefit user id: from the settings, else from the token's custom exercises (saved once found)."""
    if cfg.get('user_id'):
        return int(cfg['user_id'])
    status, _, body = api.get(cfg['catalog_path'])
    if status != 200:
        raise RuntimeError(f'exercise catalog -> HTTP {status}')
    ids = {int(x['numeric_user_id']) for x in (body or {}).get('data') or []
           if isinstance(x, dict) and num(x.get('numeric_user_id'))}
    if len(ids) != 1:
        raise RuntimeError(f'cannot tell the Jefit user id from the token (custom exercises name {len(ids)} users); '
                           f'set "user_id" in {API_CONFIG}')
    cfg['user_id'] = ids.pop()
    save_api_config(cfg)
    return cfg['user_id']


def cmd_probe(api, cfg):
    """Token check with each auth scheme (configured first), then one GET per data endpoint: status + key names."""
    results, scheme = [], None
    known = cfg.get('auth') or 'bearer'
    saved = cfg.get('auth')
    for name in [known] + [n for n, _, _ in AUTH_SCHEMES if n != known]:
        status, ctype, body = api.get(cfg['check_path'], name)
        results.append({'path': cfg['check_path'], 'auth': name, 'status': status, 'type': ctype, 'shape': shape(body)})
        if status < 400:
            scheme = name
            break
        if status not in (401, 403):
            break
        time.sleep(0.5)
    uid = None
    if scheme:
        api.cfg['auth'] = scheme
        try:
            uid = find_uid(api, cfg)
        except RuntimeError as e:
            results.append({'path': cfg['catalog_path'], 'auth': scheme, 'status': 'no user id', 'type': '',
                            'shape': str(e)})
    if uid:
        end = today() + dt.timedelta(days=1)
        for p in (cfg['calendar_path'], cfg['sessions_path'], cfg['exercises_path']):
            time.sleep(0.5)
            path = fill(p, uid=uid, start=local_midnight(end - dt.timedelta(days=14)), end=local_midnight(end))
            status, ctype, body = api.get(path)
            results.append({'path': p, 'auth': scheme, 'status': status, 'type': ctype, 'shape': shape(body)})
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    out = os.path.join(STATE, 'probe.json')
    with open(out, 'w') as fh:
        json.dump({'at': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'), 'base': cfg['base'],
                   'results': results}, fh, indent=1)
    os.chmod(out, 0o600)
    for r in results:
        keys = ', '.join(r['shape'].keys()) if isinstance(r['shape'], dict) else str(r['shape'])[:80]
        print(f"GET {r['path']} [{r['auth']}] -> {r['status']} {r['type']} {keys}".rstrip())
    ok = bool(uid) and all(isinstance(r['status'], int) and r['status'] < 400 for r in results[-3:])
    if scheme and scheme != saved:
        cfg['auth'] = scheme
        save_api_config(cfg)
        print(f'Auth header that works: {scheme} (saved to {API_CONFIG}).')
    if not scheme:
        print('The token was refused with every auth header (401/403): expired, revoked or not Elite?')
    print(f"API {'OK' if ok else 'NOT OK'}. Shapes (key names only): {out}")
    return 0 if ok else 1


def pick(d, *names):
    for n in names:
        if isinstance(d, dict) and d.get(n) not in (None, ''):
            return d[n]
    return None


def find_list(payload, want):
    """The first list of dicts in payload whose items have one of the `want` keys."""
    stack = [payload]
    while stack:
        v = stack.pop(0)
        if isinstance(v, list) and v and isinstance(v[0], dict) and any(k in v[0] for k in want):
            return v
        if isinstance(v, dict):
            stack.extend(v.values())
        elif isinstance(v, list):
            stack.extend(x for x in v if isinstance(x, (dict, list)))
    return []


def first_code(v):
    """Jefit list fields pad with 'none': ['upper_legs', 'glutes', 'none'] -> 'upper_legs'."""
    if isinstance(v, list):
        v = next((x for x in v if x not in (None, '', 'none')), None)
    return None if v in (None, '', 'none') else v


def api_sets(raw, unit):
    if isinstance(raw, str):
        return parse_logs(raw, unit_factor=LB if unit == 'lb' else 1.0)[0]
    out = []
    for x in raw or []:
        if not isinstance(x, dict) or str(x.get('type') or '').lower() in ('warm-up', 'warmup', 'warm_up'):
            continue
        if x.get('weight_kg') is not None:
            w = num(x['weight_kg'], 0)
        elif x.get('weight_lbs') is not None or x.get('weight_lb') is not None:
            w = num(pick(x, 'weight_lbs', 'weight_lb'), 0) * LB
        else:
            w = num(pick(x, 'weight', 'load'), 0) * (LB if unit == 'lb' else 1.0)
        reps = num(pick(x, 'reps', 'rep', 'repetitions'))
        dur = num(pick(x, 'duration', 'duration_s', 'seconds', 'time'))
        if dur and dur > 0 and not reps:
            out.append({'w': round(w or 0, 2), 'reps': None, 'dur': int(dur)})
        elif reps and reps > 0:
            out.append({'w': round(w or 0, 2), 'reps': int(round(reps)), 'dur': None})
    return out


def api_log(x, unit, catalog=None):
    """One exercise log -> dict(xkey, name, bodypart, equip, record_kg, sets) or None (cardio, unnamed, no sets)."""
    if str(x.get('record_type') or '').lower() == 'cardio':
        return None     # like the CSV import: cardio entries carry no strength sets
    eid = pick(x, 'exercise_id', 'eid')
    ex = x.get('exercise') if isinstance(x.get('exercise'), dict) else (catalog or {}).get(str(eid), {})
    eid = eid if eid is not None else pick(ex, 'id', 'exercise_id')
    name = str(pick(x, 'exercise_name', 'ename', 'name') or pick(ex, 'name') or '').strip()
    if not name:
        return None
    nid = pick(x, 'numeric_exercise_id')
    if nid is not None and num(nid) is not None:
        key = f"jefit:{0 if x.get('is_system_exercise') is False else 1}:{int(num(nid))}"
    else:
        bsys = pick(x, 'belongSys', 'belong_sys')
        bsys = 1 if bsys is None else int(num(bsys, 1))
        key = f'jefit:{bsys}:{int(num(eid))}' if eid is not None and num(eid) is not None else 'name:' + norm_name(name)
    bp = first_code(pick(x, 'bodypart', 'body_part') or pick(ex, 'bodypart', 'body_part', 'body_parts'))
    if isinstance(bp, (int, float)) or (isinstance(bp, str) and bp.isdigit()):
        bp = int(bp)
    eq = pick(x, 'equipment') or pick(ex, 'equipment', 'equipment_type')
    if isinstance(eq, list):
        # Jefit catalog codes: the name's own equipment wins (cable rows are "machine_strength" in Jefit);
        # the first mapped code fills the gap, unmapped ones (bench, weight_plate) are ignored
        eq = None if classify(name)['equipment'] != 'other' else next(
            (API_EQUIPMENT[c] for c in eq if c in API_EQUIPMENT), None)
    raw = pick(x, 'log_sets', 'sets', 'logs')
    sets = api_sets(raw, unit)
    if not sets:
        return None
    rec = num(pick(x, 'record', 'one_rep_max', '1rm'))
    return {'xkey': key, 'name': name, 'bodypart': bp, 'equip': eq if isinstance(eq, str) else None,
            'record_kg': round(rec * (LB if unit == 'lb' else 1.0), 2) if rec and rec > 0 else None, 'sets': sets}


def api_session(x, unit):
    sid = pick(x, 'id', '_id', 'session_id', 'local_id', 'row_id')
    start = as_ts(pick(x, 'starttime', 'start_time', 'started_at', 'start'))
    if start is None and isinstance(x.get('date'), (int, float)) and x['date'] > 1e8:
        start = as_ts(x['date'])    # the API's session "date" is the start time in unix seconds
    date = (ts_to_date(start) if start else None) or as_date(pick(x, 'date', 'mydate'))
    if sid is None or not date:
        return None
    dur = num(pick(x, 'total_time', 'duration', 'workout_time', 'duration_seconds'))
    logs_raw = pick(x, 'logs', 'exercise_logs', 'exercises', 'items')
    return {'uid': f'jefit:{sid}', 'id': sid, 'date': date, 'start_ts': start, 'duration_s': int(dur) if dur else None,
            'unit': unit,   # API weights are pounds even for metric accounts (see API_DEFAULTS['unit'])
            'logs_raw': logs_raw if isinstance(logs_raw, list) else []}


def cmd_sync(a):
    try:
        token = read_api_token()
    except PermissionError as e:
        print(f'gym sync: {e}', file=sys.stderr)
        return 1
    cfg = api_config()
    if not token:
        h = no_token_hint()
        print(f'{h[0].upper()}{h[1:]}. Meanwhile: gym import csv FILE.')
        return 3
    api = Api(cfg, token, 'gym' if egress_read() else None)
    try:
        if a.probe:
            return cmd_probe(api, cfg)
        if not cfg.get('confirmed'):
            print(PENDING)
            print('Next step: `gym sync --probe` (read-only GETs; prints status codes and key names only).')
            return 4
        return run_sync(a, api, cfg)
    except RuntimeError as e:
        print(f'gym sync: {api.scrub(e)}', file=sys.stderr)
        return 1


def first_session_date(api, cfg, uid):
    """Earliest calendar date with a session, or None."""
    status, _, body = api.get(fill(cfg['calendar_path'], uid=uid))
    if status != 200:
        return None
    dates = sorted(as_date(x.get('date')) for x in find_list(body, ('date',)) if as_date(x.get('date')))
    return dates[0] if dates else None


def run_sync(a, api, cfg):
    conn = connect()
    unit = cfg.get('unit') or 'lb'
    uid = find_uid(api, cfg)
    if a.since:
        since = a.since
    else:
        last = conn.execute("SELECT MAX(date) FROM sessions").fetchone()[0]
        since = ((dt.date.fromisoformat(last) - dt.timedelta(days=7)).isoformat() if last else
                 first_session_date(api, cfg, uid) or '2010-01-01')
    until = today() + dt.timedelta(days=1)
    step = dt.timedelta(days=max(1, int(cfg.get('chunk_days') or 365)))
    raw, start = {}, dt.date.fromisoformat(since)
    while start < until:
        end = min(start + step, until)
        status, _, body = api.get(fill(cfg['sessions_path'], uid=uid, start=local_midnight(start),
                                       end=local_midnight(end)))
        if status != 200 or body is None:
            print(f'gym sync: sessions request -> HTTP {status}', file=sys.stderr)
            return 1
        for x in find_list(body, ('starttime', 'start_time', 'started_at', 'date', 'mydate')):
            k = pick(x, 'id', '_id', 'session_id', 'local_id', 'row_id')
            raw.setdefault(str(k), x)       # chunk edges may repeat a session
        start = end
        time.sleep(0.2)
    catalog, sessions, skipped = None, [], 0
    for x in raw.values():
        s = api_session(x, unit)
        if not s:
            skipped += 1
            continue
        lraw = s.pop('logs_raw')
        if catalog is None:
            need = {str(lx.get('exercise_id')) for y in raw.values() for lx in y.get('logs') or []
                    if isinstance(lx, dict) and not pick(lx, 'exercise_name', 'ename', 'name', 'exercise')}
            catalog = load_catalog(api, cfg, uid, need) if need else {}
        logs = {}
        for lx in lraw:
            lg = api_log(lx, s['unit'], catalog) if isinstance(lx, dict) else None
            if lg:
                if lg['xkey'] in logs:
                    logs[lg['xkey']]['sets'].extend(lg['sets'])
                else:
                    logs[lg['xkey']] = lg
        s.pop('id')
        s.pop('unit')
        if logs:
            s['logs'] = list(logs.values())
            sessions.append(s)
        else:
            skipped += 1
    counts = store(conn, {'sessions': sessions, 'body': []}, 'api', f'since {since}', dry_run=a.dry_run)
    out = {'since': since, 'sessions': len(sessions), **counts, 'skipped': skipped, 'requests': api.count,
           'dry_run': a.dry_run}
    if a.json:
        print(json.dumps(out))
    else:
        pre = 'Would sync' if a.dry_run else 'Synced'
        print(f"{pre} since {since}: {len(sessions)} sessions ({counts['new']} new, {counts['updated']} updated, "
              f"{counts['unchanged']} unchanged), {skipped} skipped (no strength sets); {api.count} requests.")
    return 0


def load_catalog(api, cfg, uid, need):
    """exercise id -> catalog entry: the user's exercises, plus the full catalog when ids are still missing."""
    catalog = {}
    for path in (fill(cfg['exercises_path'], uid=uid), cfg['catalog_path']):
        status, _, body = api.get(path)
        for x in find_list(body, ('name',)) if status == 200 else []:
            for k in ('id', 'local_id'):
                if x.get(k) is not None:
                    catalog.setdefault(str(x[k]), x)
        if not need - set(catalog):
            break
    return catalog


# ----------------------------------------------------------------------------- analysis
def load(conn):
    """-> sessions list (date-sorted) with logs and sets, plus the exercise table."""
    ex = {}
    for r in conn.execute('SELECT id, name, muscle, secondary, equipment, pattern, side, kind FROM exercises'):
        ex[r[0]] = {'id': r[0], 'name': r[1], 'muscle': r[2] or 'other',
                    'secondary': [s for s in (r[3] or '').split(',') if s], 'equipment': r[4], 'pattern': r[5],
                    'side': r[6], 'kind': r[7]}
    sess = {}
    for r in conn.execute('SELECT id, date, start_ts, duration_s FROM sessions ORDER BY date, start_ts'):
        sess[r[0]] = {'id': r[0], 'date': r[1], 'start_ts': r[2], 'duration_s': r[3], 'logs': {}}
    q = ('SELECT l.session_id, l.id, l.exercise_id, s.idx, s.weight_kg, s.reps, s.duration_s, s.e1rm_kg '
         'FROM exercise_logs l JOIN sets s ON s.log_id=l.id ORDER BY l.session_id, l.pos, s.idx')
    for sid, lid, xid, idx, w, reps, dur, e1 in conn.execute(q):
        lg = sess[sid]['logs'].setdefault(lid, {'ex': xid, 'sets': []})
        lg['sets'].append({'w': w or 0, 'reps': reps, 'dur': dur, 'e1rm': e1})
    out = sorted(sess.values(), key=lambda s: (s['date'], s['start_ts'] or 0))
    for s in out:
        s['logs'] = list(s['logs'].values())
    return out, ex


def mark_hard(lg, kind):
    sets = lg['sets']
    timed = [x for x in sets if x['dur']]
    weighted = [x for x in sets if x['reps'] and x['w'] > 0]
    bw = [x for x in sets if x['reps'] and not x['w']]
    if kind == 'bodyweight':
        bw, weighted = bw + weighted, []
    for x in sets:
        x['hard'] = False
    if timed:
        top = max(x['dur'] for x in timed)
        for x in timed:
            x['hard'] = x['dur'] >= 0.5 * top
    if weighted:
        rel = lambda x: x['w'] * (1 + x['reps'] / 30.0) if x['reps'] > 1 else x['w']
        top = max(rel(x) for x in weighted)
        for x in weighted:
            x['hard'] = rel(x) >= 0.85 * top
    if bw:
        top = max(x['reps'] for x in bw)
        for x in bw:
            x['hard'] = x['reps'] >= 0.5 * top


def iso_week(date):
    y, w, _ = dt.date.fromisoformat(date).isocalendar()
    return f'{y}-W{w:02d}'


def week_start(d):
    return d - dt.timedelta(days=d.weekday())


def linreg(points):
    if len(points) < 2:
        return 0.0
    n = len(points)
    mx = sum(p[0] for p in points) / n
    my = sum(p[1] for p in points) / n
    den = sum((p[0] - mx) ** 2 for p in points)
    return sum((p[0] - mx) * (p[1] - my) for p in points) / den if den else 0.0


def analyze(conn, weeks=8, end=None):
    end = end or today()
    sessions, ex = load(conn)
    sessions = [s for s in sessions if s['date'] <= end.isoformat()]
    for s in sessions:
        for lg in s['logs']:
            mark_hard(lg, ex[lg['ex']]['kind'])
    win_start = week_start(end) - dt.timedelta(weeks=weeks - 1)
    recent_start = end - dt.timedelta(days=27)
    in_win = [s for s in sessions if s['date'] >= win_start.isoformat()]
    recent = [s for s in sessions if s['date'] >= recent_start.isoformat()]
    res = {'end': end.isoformat(), 'weeks': weeks, 'window_start': win_start.isoformat(),
           'total_sessions': len(sessions), 'first_date': sessions[0]['date'] if sessions else None,
           'last_date': sessions[-1]['date'] if sessions else None}

    # weekly table
    wk = {}
    for i in range(weeks):
        ws = win_start + dt.timedelta(weeks=i)
        wk[iso_week(ws.isoformat())] = {'week': iso_week(ws.isoformat()), 'start': ws.isoformat(), 'sessions': 0,
                                        'hard_sets': 0, 'tonnage_kg': 0.0, 'minutes': 0}
    for s in in_win:
        row = wk.get(iso_week(s['date']))
        if not row:
            continue
        row['sessions'] += 1
        row['minutes'] += round((s['duration_s'] or 0) / 60)
        for lg in s['logs']:
            row['hard_sets'] += sum(1 for x in lg['sets'] if x['hard'])
            row['tonnage_kg'] += sum(x['w'] * x['reps'] for x in lg['sets'] if x['reps'] and x['w'])
    res['weekly'] = [dict(r, tonnage_kg=round(r['tonnage_kg'])) for r in wk.values()]
    res['sessions_per_week'] = round(len(in_win) / weeks, 2)
    res['sessions_per_week_4w'] = round(len(recent) / 4, 2)

    # muscle volume (fractional sets) + tonnage (primary only)
    def muscle_volume(ss, nweeks):
        vol = {m: 0.0 for m in MUSCLES}
        ton = {m: 0.0 for m in MUSCLES}
        for s in ss:
            for lg in s['logs']:
                e = ex[lg['ex']]
                hard = sum(1 for x in lg['sets'] if x['hard'])
                if e['muscle'] in vol:
                    vol[e['muscle']] += hard
                    ton[e['muscle']] += sum(x['w'] * x['reps'] for x in lg['sets'] if x['reps'] and x['w'])
                for m in e['secondary']:
                    if m in vol:
                        vol[m] += 0.5 * hard
        return ({m: round(v / nweeks, 1) for m, v in vol.items()}, {m: round(v / nweeks) for m, v in ton.items()})
    res['hard_sets_per_week_4w'], res['tonnage_per_week_4w'] = muscle_volume(recent, 4)
    res['hard_sets_per_week'], res['tonnage_per_week'] = muscle_volume(in_win, weeks)
    res['muscle_weekly'] = {}
    for s in in_win:
        w = iso_week(s['date'])
        for lg in s['logs']:
            e = ex[lg['ex']]
            hard = sum(1 for x in lg['sets'] if x['hard'])
            for m, f in [(e['muscle'], 1.0)] + [(m, 0.5) for m in e['secondary']]:
                if m in MUSCLES:
                    d = res['muscle_weekly'].setdefault(m, {})
                    d[w] = round(d.get(w, 0) + f * hard, 1)

    # balance (primary hard sets, last 4 weeks)
    pat = {'push': 0, 'pull': 0, 'legs': 0, 'core': 0, 'other': 0}
    side = {'front': 0, 'back': 0}
    quad = post = 0
    for s in recent:
        for lg in s['logs']:
            e = ex[lg['ex']]
            hard = sum(1 for x in lg['sets'] if x['hard'])
            pat[e['pattern'] if e['pattern'] in pat else 'other'] += hard
            if e['side'] in side:
                side[e['side']] += hard
            if e['muscle'] == 'quads':
                quad += hard
            elif e['muscle'] in ('hamstrings', 'glutes'):
                post += hard
    tot = sum(pat.values()) or 1
    ratio = lambda a, b: round(a / b, 2) if b else None
    res['balance'] = {'share': {k: round(100 * v / tot) for k, v in pat.items()}, 'sets': pat,
                      'push_pull': ratio(pat['push'], pat['pull']), 'front_back': ratio(side['front'], side['back']),
                      'quad_posterior': ratio(quad, post)}

    # per-exercise history: PRs, progression
    hist = {}
    for s in sessions:
        for lg in s['logs']:
            e = ex[lg['ex']]
            h = hist.setdefault(e['id'], {'id': e['id'], 'name': e['name'], 'kind': e['kind'], 'muscle': e['muscle'],
                                          'equipment': e['equipment'], 'points': [], 'dates': [], 'hard_win': 0,
                                          'best': None, 'best_reps': None, 'best_dur': None, 'top_sets': []})
            h['dates'].append(s['date'])
            if s['date'] >= win_start.isoformat():
                h['hard_win'] += sum(1 for x in lg['sets'] if x['hard'])
            if e['kind'] == 'weight':
                cands = [x for x in lg['sets'] if x['e1rm']]
                if cands:
                    b = max(cands, key=lambda x: x['e1rm'])
                    h['points'].append((s['date'], b['e1rm'], b['w'], b['reps']))
                    if not h['best'] or b['e1rm'] > h['best']['e1rm']:
                        h['best'] = {'e1rm': b['e1rm'], 'w': b['w'], 'reps': b['reps'], 'date': s['date']}
                top = max((x for x in lg['sets'] if x['reps'] and x['w']), key=lambda x: (x['w'], x['reps']), default=None)
                if top:
                    h['top_sets'].append((s['date'], top['w'], top['reps']))
            reps = max((x['reps'] for x in lg['sets'] if x['reps']), default=None)
            if reps and (not h['best_reps'] or reps > h['best_reps']['reps']):
                h['best_reps'] = {'reps': reps, 'date': s['date']}
            dur = max((x['dur'] for x in lg['sets'] if x['dur']), default=None)
            if dur and (not h['best_dur'] or dur > h['best_dur']['dur']):
                h['best_dur'] = {'dur': dur, 'date': s['date']}

    prs = []
    for h in hist.values():
        if h['kind'] == 'weight' and h['best']:
            prs.append({'exercise': h['name'], 'type': 'e1rm', 'value': h['best']['e1rm'], 'set': f"{fmt_w(h['best']['w'])}x{h['best']['reps']}",
                        'date': h['best']['date'], 'in_window': h['best']['date'] >= win_start.isoformat()})
        elif h['kind'] == 'timed' and h['best_dur']:
            prs.append({'exercise': h['name'], 'type': 'seconds', 'value': h['best_dur']['dur'], 'set': '',
                        'date': h['best_dur']['date'], 'in_window': h['best_dur']['date'] >= win_start.isoformat()})
        elif h['best_reps']:
            prs.append({'exercise': h['name'], 'type': 'reps', 'value': h['best_reps']['reps'], 'set': '',
                        'date': h['best_reps']['date'], 'in_window': h['best_reps']['date'] >= win_start.isoformat()})
    prs.sort(key=lambda p: (not p['in_window'], -(hist_hard(hist, p['exercise']))))
    res['prs'] = prs

    lifts = []
    for h in hist.values():
        pts_win = [p for p in h['points'] if p[0] >= win_start.isoformat()]
        if h['kind'] != 'weight' or len(pts_win) < 4 or not ex[h['id']]['secondary']:
            continue
        running, last_pr = 0.0, None
        for d, v, _, _ in h['points']:
            if v > running + 0.01:
                running, last_pr = v, d
        sess_since = sum(1 for p in h['points'] if p[0] > last_pr)
        weeks_since = (end - dt.date.fromisoformat(last_pr)).days / 7
        d0 = dt.date.fromisoformat(pts_win[0][0])
        slope = linreg([((dt.date.fromisoformat(d) - d0).days / 7, v) for d, v, _, _ in pts_win])
        mean = sum(p[1] for p in pts_win) / len(pts_win)
        last3 = [p[1] for p in h['points'][-3:]]
        last_seen = dt.date.fromisoformat(h['points'][-1][0])
        if (end - last_seen).days > 21:
            status = 'inactive'
        elif weeks_since >= 4 and sess_since >= 3:
            status = 'plateau'
        elif slope > 0.05:
            status = 'progressing'
        else:
            status = 'flat'
        declining = len(last3) == 3 and sum(last3) / 3 < 0.95 * running
        top = h['top_sets'][-1] if h['top_sets'] else None
        lifts.append({'exercise': h['name'], 'id': h['id'], 'muscle': h['muscle'], 'equipment': h['equipment'],
                      'sessions': len(pts_win), 'hard_sets': h['hard_win'], 'first': pts_win[0][1],
                      'last': pts_win[-1][1], 'best': running, 'kg_per_week': round(slope, 2),
                      'pct_per_month': round(100 * slope * 4.345 / mean, 1) if mean else 0.0,
                      'last_pr': last_pr, 'weeks_since_pr': round(weeks_since, 1), 'sessions_since_pr': sess_since,
                      'status': status, 'declining': declining,
                      'last_top_set': {'date': top[0], 'w': top[1], 'reps': top[2]} if top else None,
                      'series': [(d, v) for d, v, _, _ in pts_win]})
    big = re.compile(r'\b(squat|bench press|overhead press|military press)\b|^(barbell |conventional |sumo |trap bar )?'
                     r'deadlift$')
    lifts.sort(key=lambda x: -(x['hard_sets'] + 30 * bool(big.search(norm_name(x['exercise']))) +
                               10 * (x['equipment'] in ('barbell', 'trap bar'))))
    res['main_lifts'] = lifts[:5]

    # consistency: weekly streaks, gaps
    weeks_with = sorted({week_start(dt.date.fromisoformat(s['date'])) for s in sessions})
    wset = set(weeks_with)
    cur, w = 0, week_start(end)
    if w not in wset:
        w -= dt.timedelta(weeks=1)
    while w in wset:
        cur += 1
        w -= dt.timedelta(weeks=1)
    best = run = 0
    prev = None
    for w in weeks_with:
        run = run + 1 if prev and (w - prev).days == 7 else 1
        best = max(best, run)
        prev = w
    dates = sorted({s['date'] for s in sessions})
    gaps = []
    for a_, b_ in zip(dates, dates[1:]):
        days = (dt.date.fromisoformat(b_) - dt.date.fromisoformat(a_)).days
        if days >= 8 and b_ >= win_start.isoformat():
            gaps.append({'from': a_, 'to': b_, 'days': days})
    gaps.sort(key=lambda g: -g['days'])
    res['consistency'] = {'streak_weeks': cur, 'longest_streak_weeks': best, 'gaps': gaps[:3],
                          'days_since_last': (end - dt.date.fromisoformat(dates[-1])).days if dates else None}

    # fatigue proxy: consecutive weeks without a low week (<= 60 % of the trailing 4-week mean, or no session)
    allw = {}
    for s in sessions:
        k = week_start(dt.date.fromisoformat(s['date']))
        allw[k] = allw.get(k, 0) + sum(1 for lg in s['logs'] for x in lg['sets'] if x['hard'])
    hard_weeks, w = 0, week_start(end)
    if allw.get(w, 0) == 0:
        w -= dt.timedelta(weeks=1)
    while True:
        prevs = [allw.get(w - dt.timedelta(weeks=i), 0) for i in range(1, 5)]
        trail = sum(prevs) / 4
        if allw.get(w, 0) == 0 or (trail and allw[w] <= 0.6 * trail):
            break
        hard_weeks += 1
        w -= dt.timedelta(weeks=1)
    res['weeks_without_deload'] = hard_weeks

    body = conn.execute('SELECT date, weight_kg FROM body_stats WHERE weight_kg IS NOT NULL AND date <= ? '
                        'ORDER BY date', (end.isoformat(),)).fetchall()
    res['body_weight'] = {'last': body[-1][1], 'date': body[-1][0]} if body else None
    res['_hist'] = hist
    return res


def hist_hard(hist, name):
    for h in hist.values():
        if h['name'] == name:
            return h['hard_win']
    return 0


# ----------------------------------------------------------------------------- stats text
def cmd_stats(a):
    conn = connect()
    r = analyze(conn, a.weeks, a.end)
    r.pop('_hist')
    oa = r['other_activity'] = other_activity(a.end or today(), a.weeks)
    if a.json:
        print(json.dumps(r, indent=1))
        return 0
    if not r['total_sessions']:
        print('No sessions yet. Import a Jefit CSV export: gym import csv FILE')
        return 0
    L = []
    L.append(f"Gym stats: {r['weeks']} weeks, {ddmm(r['window_start'])}-{ddmm(r['end'])}{r['end'][:4]}")
    c = r['consistency']
    n_win = sum(w['sessions'] for w in r['weekly'])
    L.append(f"Sessions: {n_win} ({r['sessions_per_week']}/week, last 4 wk {r['sessions_per_week_4w']}/week); "
             f"last {ddmm(r['last_date'])} ({c['days_since_last']} d ago)")
    L.append(f"Streak: {c['streak_weeks']} weeks with training (longest {c['longest_streak_weeks']}); "
             f"{r['weeks_without_deload']} weeks since a lighter week")
    if act_any(oa['total']):
        L.append(f"Dance (not in the streak): {act_text(oa['total'], emoji=False, counts=True)} in {r['weeks']} wk"
                 + (f"; this week {act_text(oa['this_week'], emoji=False)}" if act_any(oa['this_week']) else '')
                 + (f"; tracked since {ddmm(oa['since'])}" if oa['since'] and oa['since'] > r['window_start'] else ''))
    if c['gaps']:
        L.append('Gaps: ' + ', '.join(f"{ddmm(g['from'])}-{ddmm(g['to'])} ({g['days']} d)" for g in c['gaps']))
    L.append('')
    L.append('Week      Sessions  Hard sets  Tonnage kg  Minutes')
    for w in r['weekly']:
        L.append(f"{w['week']:<9} {w['sessions']:>8}  {w['hard_sets']:>9}  {fmt_n(w['tonnage_kg']):>10}  {w['minutes']:>7}")
    L.append('')
    L.append(f'Hard sets per week by muscle (4 wk | {r["weeks"]} wk; target {TARGET_LO}-{TARGET_HI}), tonnage kg/wk (4 wk):')
    for m in MUSCLES:
        v4, vn = r['hard_sets_per_week_4w'][m], r['hard_sets_per_week'][m]
        if not v4 and not vn:
            continue
        flag = ''
        if m in TRACKED:
            flag = 'low' if v4 < TARGET_LO else 'high' if v4 > TARGET_HI else 'ok'
        L.append(f"  {m:<11} {v4:>5} | {vn:<5} {flag:<4}  {fmt_n(r['tonnage_per_week_4w'][m]):>7}")
    b = r['balance']
    sh = b['share']
    L.append('')
    L.append(f"Balance (hard sets, 4 wk): push {sh['push']}% / pull {sh['pull']}% / legs {sh['legs']}% / core {sh['core']}%")
    L.append(f"  push:pull {b['push_pull'] or '-'} · front:back {b['front_back'] or '-'} · quads:hams+glutes "
             f"{b['quad_posterior'] or '-'}")
    L.append('')
    L.append('Main lifts (e1RM, Epley):')
    for x in r['main_lifts']:
        tag = {'plateau': f"plateau: no PR in {x['weeks_since_pr']:.0f} wk", 'progressing': 'progressing',
               'flat': 'flat', 'inactive': 'not trained lately'}[x['status']]
        if x['declining']:
            tag += ', trending down'
        L.append(f"  {x['exercise']:<26} {fmt_kg(x['first'])} -> {fmt_kg(x['last'])} kg ({x['kg_per_week']:+.1f} kg/wk, "
                 f"{x['pct_per_month']:+.1f} %/mo); best {fmt_kg(x['best'])} on {ddmm(x['last_pr'])}; {tag}")
    if not r['main_lifts']:
        L.append('  (none with 4+ weighted sessions in the window)')
    L.append('')
    L.append('PRs (* = set in this window):')
    for p in r['prs'][:12]:
        val = (f"{fmt_kg(p['value'])} kg e1RM ({p['set']})" if p['type'] == 'e1rm' else
               f"{p['value']} s" if p['type'] == 'seconds' else f"{p['value']} reps")
        L.append(f"  {'*' if p['in_window'] else ' '} {p['exercise']:<26} {val}, {ddmm(p['date'])}{p['date'][:4]}")
    if r['body_weight']:
        L.append('')
        L.append(f"Body weight: {fmt_kg(r['body_weight']['last'])} kg ({ddmm(r['body_weight']['date'])}{r['body_weight']['date'][:4]})")
    print('\n'.join(L))
    return 0


# ----------------------------------------------------------------------------- review
def increment(lift):
    lower = lift['muscle'] in ('quads', 'hamstrings', 'glutes')
    if lift['equipment'] == 'dumbbell':
        return 2.0
    if lift['equipment'] in ('barbell', 'trap bar') and lower:
        return 5.0
    return 2.5


def favourite_for(hist, muscle):
    best = None
    for h in hist.values():
        if h['muscle'] == muscle and (not best or len(h['dates']) > len(best['dates'])):
            best = h
    return best['name'] if best else DEFAULT_PICK.get(muscle, 'an exercise for it')


def suggestions(r):
    hist = r['_hist']
    c = r['consistency']
    cand = []
    v4 = r['hard_sets_per_week_4w']
    plateaus = [x for x in r['main_lifts'] if x['status'] == 'plateau']
    declining = [x for x in r['main_lifts'] if x['declining'] and x['status'] != 'inactive']
    if c['days_since_last'] is not None and c['days_since_last'] >= 14:
        cand.append((100, 'comeback', f"Back after {c['days_since_last']} days off: first week at ~80-90 % of your "
                                      f"last working weights, then build back up."))
    deload = (len(plateaus) >= 2 or (plateaus and declining)) and r['weeks_without_deload'] >= 6 and \
        (c['days_since_last'] or 0) < 14
    if deload:
        names = ' and '.join(x['exercise'] for x in (plateaus + [d for d in declining if d not in plateaus])[:2])
        cand.append((90, 'deload', f"Deload next week: same exercises, about half the sets at ~90 % of the weight. "
                                   f"{r['weeks_without_deload']} weeks without a lighter week and {names} stalled."))
    if r['sessions_per_week_4w'] < 2 and (c['days_since_last'] or 0) < 14:
        cand.append((70, 'frequency', f"Train 2-3x a week (lately {r['sessions_per_week_4w']}/week): two fixed slots in "
                                      f"the calendar make it stick; each muscle at least twice a week."))
    pre = 'After the deload, ' if deload else ''
    b = r['balance']
    pull_short = bool(b['push_pull'] and b['push_pull'] > 1.3)
    lows = sorted(((TARGET_LO - v4[m]) * w, m) for m, w in TRACKED.items()
                  if v4[m] < TARGET_LO and not (pull_short and m == 'back'))
    for score, m in sorted(lows, reverse=True):
        need = min(6, max(2, math.ceil(TARGET_LO - v4[m])))
        txt = (f"{m.capitalize()} at {fmt_kg(v4[m])} hard sets/week (target {TARGET_LO}-{TARGET_HI}): add {need} sets "
               f"of {favourite_for(hist, m)} per week, spread over 2 sessions.")
        cand.append((40 + score * 3, 'low', pre + txt[0].lower() + txt[1:] if pre else txt))
    for x in plateaus:
        cand.append((60 + x['weeks_since_pr'], 'plateau',
                     f"{x['exercise']}: no e1RM gain in {x['weeks_since_pr']:.0f} weeks: change the rep range for 4-6 "
                     f"weeks (e.g. 3x8 -> 4x5 heavier) or swap to a close variation; train it 2x a week."))
    if pull_short:
        back = f" (back {fmt_kg(v4['back'])} hard sets/week)" if v4['back'] < TARGET_LO else ''
        cand.append((55 + 10 * (v4['back'] < TARGET_LO), 'balance',
                     f"Push:pull is {b['push_pull']}:1{back}: add 3 sets of a pull "
                     f"({favourite_for(hist, 'back')}) to each push day for shoulder balance."))
    elif b['push_pull'] and b['push_pull'] < 0.6:
        cand.append((50, 'balance', f"Push:pull is {b['push_pull']}:1: add a pressing exercise "
                                    f"({favourite_for(hist, 'chest')}) to balance the upper body."))
    if b['quad_posterior'] and b['quad_posterior'] > 1.6:
        cand.append((52, 'balance', f"Quads get {b['quad_posterior']}x the sets of hamstrings+glutes: add "
                                    f"{favourite_for(hist, 'hamstrings')} or a leg curl on leg days."))
    for m, w in TRACKED.items():
        if v4[m] > TARGET_HI + 2:
            cand.append((45, 'high', f"{m.capitalize()} at {fmt_kg(v4[m])} hard sets/week: above ~{TARGET_HI} extra sets "
                                     f"add more fatigue than growth; trim {math.ceil(v4[m] - TARGET_HI)}."))
    for x in [l for l in r['main_lifts'] if l['status'] == 'progressing'][:2]:
        t = x['last_top_set']
        if not t:
            continue
        inc = increment(x)
        cand.append((30 + x['pct_per_month'], 'overload',
                     f"{x['exercise']} is progressing ({x['kg_per_week']:+.1f} kg/week e1RM): next time "
                     f"{fmt_w(t['w'] + inc)} kg x {t['reps']} (+{fmt_w(inc)} kg), or +1 rep at {fmt_w(t['w'])} kg."))
    cand.append((1, 'logging', 'Keep logging every set, warm-ups included, so trends and PRs stay accurate.'))
    cand.append((0, 'filler', f"Keep each muscle in the {TARGET_LO}-{TARGET_HI} hard sets/week range and add weight or "
                              f"reps when all sets reach the top of your rep range."))
    limits = {'low': 2, 'plateau': 1, 'balance': 1, 'overload': 1, 'high': 1}
    picked, used = [], {}
    for score, kind, txt in sorted(cand, key=lambda c_: -c_[0]):
        if used.get(kind, 0) >= limits.get(kind, 1):
            continue
        picked.append({'kind': kind, 'text': txt, 'score': round(score, 1)})
        used[kind] = used.get(kind, 0) + 1
        if len(picked) == 3:
            break
    return picked


def cmd_review(a):
    conn = connect()
    end = a.end or today()
    if a.if_trained is not None:
        since = (end - dt.timedelta(days=a.if_trained - 1)).isoformat()
        n = conn.execute('SELECT COUNT(*) FROM sessions WHERE date >= ? AND date <= ?', (since, end.isoformat())).fetchone()[0]
        if not n:
            return 0
    r = analyze(conn, a.weeks, end)
    if not r['total_sessions']:
        print('No sessions yet. Import a Jefit CSV export: gym import csv FILE')
        return 0
    sug = suggestions(r)
    c = r['consistency']
    n4 = round(r['sessions_per_week_4w'] * 4)
    L = [f"🏋️ Gym review · 4 weeks to {ddmm(r['end'])}"]
    L.append(f"{n4} sessions ({r['sessions_per_week_4w']}/wk) · streak {c['streak_weeks']} wk · last {c['days_since_last']} d ago")
    oa = other_activity(end, 4)
    if act_any(oa['total']):
        L.append(f"Also active: {act_text(oa['total'], emoji=False, counts=True)} dancing in 4 wk")
    v4 = r['hard_sets_per_week_4w']
    lows = sorted((m for m in TRACKED if v4[m] < TARGET_LO), key=lambda m: -(TARGET_LO - v4[m]) * TRACKED[m])
    low = [f'{m} {fmt_kg(v4[m])}' for m in lows[:4]] + ([f'+{len(lows) - 4}'] if len(lows) > 4 else [])
    high = [f'{m} {fmt_kg(v4[m])}' for m in TRACKED if v4[m] > TARGET_HI]
    ok = [m for m in TRACKED if TARGET_LO <= v4[m] <= TARGET_HI]
    parts = []
    if low:
        parts.append('low ' + ', '.join(low))
    if high:
        parts.append('high ' + ', '.join(high))
    if ok:
        parts.append(f'{len(ok)} in range')
    L.append('Sets/wk: ' + ' · '.join(parts))
    cutoff = (dt.date.fromisoformat(r['end']) - dt.timedelta(days=27)).isoformat()
    main = {x['exercise'] for x in r['main_lifts']}
    recent_prs = sorted((p for p in r['prs'] if p['date'] >= cutoff), key=lambda p: p['date'], reverse=True)
    recent_prs.sort(key=lambda p: p['exercise'] not in main)
    if recent_prs:
        shown = []
        for p in recent_prs[:2]:
            val = (f"{fmt_kg(p['value'])} kg" if p['type'] == 'e1rm' else f"{p['value']} s" if p['type'] == 'seconds'
                   else f"{p['value']} reps")
            shown.append(f"{p['exercise']} {val} ({ddmm(p['date'])})")
        more = f' +{len(recent_prs) - 2} more' if len(recent_prs) > 2 else ''
        L.append('New PRs (e1RM): ' + ', '.join(shown) + more)
    stalled = [x for x in r['main_lifts'] if x['status'] == 'plateau']
    if stalled:
        L.append('Stalled: ' + ', '.join(f"{x['exercise']} ({x['weeks_since_pr']:.0f} wk)" for x in stalled[:2]))
    L.append('')
    L.append('Suggestions (heuristics, not medical advice):')
    for i, s in enumerate(sug, 1):
        L.append(f"{i}. {s['text']}")
    text = '\n'.join(L)
    if a.json:
        print(json.dumps({'text': text, 'suggestions': sug, 'end': r['end']}))
    else:
        print(text)
    return 0


# ----------------------------------------------------------------------------- charts (Pillow)
C_SURFACE, C_TEXT, C_TEXT2, C_GRID, C_SERIES, C_BAND = '#fcfcfb', '#0b0b0b', '#52514e', '#e4e3df', '#2a78d6', '#e3eefb'


def _font(size, bold=False):
    from PIL import ImageFont
    for p in ('/usr/share/fonts/truetype/dejavu/DejaVuSans%s.ttf' % ('-Bold' if bold else ''),
              '/usr/share/fonts/truetype/liberation/LiberationSans-%s.ttf' % ('Bold' if bold else 'Regular')):
        if os.path.exists(p):
            return ImageFont.truetype(p, size)
    return ImageFont.load_default()


def _canvas(w, h, title, subtitle):
    from PIL import Image, ImageDraw
    img = Image.new('RGB', (w, h), C_SURFACE)
    d = ImageDraw.Draw(img)
    d.text((48, 36), title, font=_font(40, True), fill=C_TEXT)
    d.text((48, 92), subtitle, font=_font(26), fill=C_TEXT2)
    return img, d


def chart_volume(r, path):
    v = r['hard_sets_per_week_4w']
    rows = [(m, v[m]) for m in MUSCLES if m in TRACKED or v[m]]
    W, top, rh = 1080, 170, 64
    H = top + rh * len(rows) + 90
    img, d = _canvas(W, H, 'Hard sets per week', f"By muscle, last 4 weeks to {ddmm(r['end'])} · band = "
                                                  f"{TARGET_LO}-{TARGET_HI} target")
    x0, x1 = 230, W - 110
    vmax = max([TARGET_HI + 5] + [x for _, x in rows])
    sx = lambda x: x0 + (x1 - x0) * x / vmax
    d.rectangle([sx(TARGET_LO), top - 10, sx(TARGET_HI), top + rh * len(rows)], fill=C_BAND)
    f, fs = _font(28), _font(24)
    for t in range(0, int(vmax) + 1, 5):
        d.line([sx(t), top - 10, sx(t), top + rh * len(rows)], fill=C_GRID, width=2)
        d.text((sx(t), top + rh * len(rows) + 12), str(t), font=fs, fill=C_TEXT2, anchor='ma')
    for i, (m, x) in enumerate(rows):
        y = top + i * rh + rh // 2
        d.text((x0 - 20, y), m, font=f, fill=C_TEXT, anchor='rm')
        if x > 0:
            d.rounded_rectangle([x0, y - 16, max(x0 + 8, sx(x)), y + 16], radius=4, fill=C_SERIES)
        d.text((max(x0 + 8, sx(x)) + 12, y), fmt_kg(x), font=f, fill=C_TEXT, anchor='lm')
    img.save(path)


def chart_e1rm(r, path):
    lifts = [x for x in r['main_lifts'] if len(x['series']) >= 2][:4]
    if not lifts:
        return False
    W, ph, top = 1080, 300, 150
    H = top + ph * len(lifts) + 30
    img, d = _canvas(W, H, 'Estimated 1RM, main lifts', f"Best set per session (Epley), {ddmm(r['window_start'])}-"
                                                         f"{ddmm(r['end'])}")
    f, fb, fs = _font(26), _font(28, True), _font(22)
    t0 = dt.date.fromisoformat(r['window_start'])
    t1 = dt.date.fromisoformat(r['end'])
    span = max(1, (t1 - t0).days)
    for i, x in enumerate(lifts):
        y0 = top + i * ph
        d.text((48, y0), f"{x['exercise']} · {fmt_kg(x['last'])} kg", font=fb, fill=C_TEXT)
        vals = [v for _, v in x['series']]
        lo, hi = min(vals), max(vals)
        pad = max(1.0, (hi - lo) * 0.15)
        lo, hi = lo - pad, hi + pad
        px0, px1, py0, py1 = 140, W - 60, y0 + 56, y0 + ph - 60
        for yv in (lo + pad, hi - pad):
            yy = py1 - (py1 - py0) * (yv - lo) / (hi - lo)
            d.line([px0, yy, px1, yy], fill=C_GRID, width=2)
            d.text((px0 - 14, yy), fmt_kg(yv), font=fs, fill=C_TEXT2, anchor='rm')
        pts = [(px0 + (px1 - px0) * (dt.date.fromisoformat(dd) - t0).days / span, py1 - (py1 - py0) * (v - lo) / (hi - lo))
               for dd, v in x['series']]
        d.line(pts, fill=C_SERIES, width=4, joint='curve')
        for px, py in pts:
            d.ellipse([px - 6, py - 6, px + 6, py + 6], fill=C_SERIES, outline=C_SURFACE, width=2)
        d.text((px0, py1 + 14), ddmm(r['window_start']), font=fs, fill=C_TEXT2, anchor='la')
        d.text((px1, py1 + 14), ddmm(r['end']), font=fs, fill=C_TEXT2, anchor='ra')
        if x['status'] == 'plateau':
            d.text((px1, y0 + 4), f"no PR in {x['weeks_since_pr']:.0f} wk", font=f, fill=C_TEXT2, anchor='ra')
    img.save(path)
    return True


def chart_sessions(r, path):
    wk = r['weekly']
    W, H, top = 1080, 620, 170
    img, d = _canvas(W, H, 'Sessions per week', f"{len(wk)} weeks to {ddmm(r['end'])}")
    f, fs = _font(26), _font(22)
    x0, x1, y1 = 100, W - 48, H - 90
    vmax = max([3] + [w['sessions'] for w in wk])
    sy = lambda v: y1 - (y1 - top) * v / vmax
    for t in range(0, vmax + 1):
        d.line([x0, sy(t), x1, sy(t)], fill=C_GRID, width=2)
        d.text((x0 - 16, sy(t)), str(t), font=fs, fill=C_TEXT2, anchor='rm')
    slot = (x1 - x0) / len(wk)
    bw = max(8, slot * 0.6)
    for i, w in enumerate(wk):
        cx = x0 + slot * (i + 0.5)
        if w['sessions']:
            d.rounded_rectangle([cx - bw / 2, sy(w['sessions']), cx + bw / 2, y1], radius=4, fill=C_SERIES)
        if (len(wk) - 1 - i) % max(1, round(len(wk) / 6)) == 0:
            d.text((cx, y1 + 14), ddmm(w['start']), font=fs, fill=C_TEXT2, anchor='ma')
    img.save(path)


def cmd_chart(a):
    try:
        import PIL  # noqa: F401
    except ImportError:
        print('Charts skipped: Pillow is not installed (python3-pil).')
        return 0
    conn = connect()
    r = analyze(conn, a.weeks, a.end)
    if not r['total_sessions']:
        print('No sessions yet. Import a Jefit CSV export: gym import csv FILE')
        return 0
    out = a.out or os.path.join(STATE, 'charts')
    os.makedirs(out, mode=0o700, exist_ok=True)
    paths = []
    p = os.path.join(out, 'volume.png')
    chart_volume(r, p)
    paths.append(p)
    p = os.path.join(out, 'e1rm.png')
    if chart_e1rm(r, p):
        paths.append(p)
    p = os.path.join(out, 'sessions.png')
    chart_sessions(r, p)
    paths.append(p)
    for p in paths:
        os.chmod(p, 0o600)
        print(p)
    return 0


# ----------------------------------------------------------------------------- exercises, status
def cmd_exercises(a):
    conn = connect()
    rows = conn.execute('SELECT e.id, e.name, e.muscle, e.secondary, e.equipment, e.pattern, e.kind, e.manual, '
                        'COUNT(s.id) FROM exercises e LEFT JOIN exercise_logs l ON l.exercise_id=e.id '
                        'LEFT JOIN sets s ON s.log_id=l.id GROUP BY e.id ORDER BY e.muscle, e.name').fetchall()
    items = [{'name': r[1], 'muscle': r[2], 'secondary': r[3], 'equipment': r[4], 'pattern': r[5], 'kind': r[6],
              'manual': bool(r[7]), 'sets': r[8]} for r in rows]
    if a.json:
        print(json.dumps(items))
        return 0
    for x in items:
        sec = f" (+{x['secondary']})" if x['secondary'] else ''
        print(f"{x['muscle']:<11} {x['name']:<32} {x['equipment']:<10} {x['pattern']:<5} {x['kind']:<10} "
              f"{x['sets']:>5} sets{sec}{' [fixed]' if x['manual'] else ''}")
    return 0


def cmd_exercise(a):
    conn = connect()
    n = norm_name(a.name)
    row = conn.execute('SELECT exercise_id FROM exercise_keys WHERE key=?', ('name:' + n,)).fetchone()
    if not row:
        print(f'gym: no exercise named "{a.name}" (see gym exercises)', file=sys.stderr)
        return 1
    xid = row[0]
    if a.reset:
        name, bp = conn.execute('SELECT name, bodypart FROM exercises WHERE id=?', (xid,)).fetchone()
        cls = classify(name, int(bp) if bp and bp.isdigit() else bp)
        conn.execute('UPDATE exercises SET muscle=?, secondary=?, equipment=?, pattern=?, side=?, manual=0 WHERE id=?',
                     (cls['muscle'], ','.join(cls['secondary']), cls['equipment'], cls['pattern'], cls['side'], xid))
    else:
        if a.muscle not in MUSCLES + ['other']:
            print(f'gym: muscle must be one of {", ".join(MUSCLES)}, other', file=sys.stderr)
            return 2
        sets = ['muscle=?', 'pattern=?', 'side=?', 'secondary=?', 'manual=1']
        vals = [a.muscle, PATTERN.get(a.muscle, 'other'), SIDE.get(a.muscle, ''), '']
        if a.equipment:
            sets.append('equipment=?')
            vals.append(a.equipment)
        conn.execute(f'UPDATE exercises SET {", ".join(sets)} WHERE id=?', vals + [xid])
    conn.commit()
    r = conn.execute('SELECT name, muscle, equipment, pattern, manual FROM exercises WHERE id=?', (xid,)).fetchone()
    print(f"{r[0]}: {r[1]}, {r[2]}, {r[3]}{' (fixed)' if r[4] else ' (automatic)'}")
    return 0


def cmd_status(a):
    conn = connect()
    q = lambda s: conn.execute(s).fetchone()[0]
    try:
        tok = token_state()
    except PermissionError:
        tok = 'bad permissions'
    last = conn.execute('SELECT at, source, detail, new, updated, unchanged FROM imports ORDER BY id DESC LIMIT 1').fetchone()
    try:
        import PIL  # noqa: F401
        charts = 'pillow'
    except ImportError:
        charts = 'none'
    st = {'db': DB_PATH, 'sessions': q('SELECT COUNT(*) FROM sessions'), 'exercises': q('SELECT COUNT(*) FROM exercises'),
          'sets': q('SELECT COUNT(*) FROM sets'), 'body_stats': q('SELECT COUNT(*) FROM body_stats'),
          'first': q('SELECT MIN(date) FROM sessions'), 'last': q('SELECT MAX(date) FROM sessions'),
          'last_import': {'at': last[0], 'source': last[1], 'new': last[3], 'updated': last[4],
                          'unchanged': last[5]} if last else None,
          'token': tok, 'api_confirmed': bool(api_config().get('confirmed')), 'charts': charts}
    if a.json:
        print(json.dumps(st))
        return 0
    print(f"DB {st['db']}: {st['sessions']} sessions, {st['exercises']} exercises, {st['sets']} sets, "
          f"{st['body_stats']} body-stat rows; {st['first'] or '-'} .. {st['last'] or '-'}")
    if last:
        print(f"Last import {last[0]} ({last[1]}): {last[3]} new, {last[4]} updated, {last[5]} unchanged")
    print(f"Jefit token: {tok}; API endpoints confirmed: {'yes' if st['api_confirmed'] else 'no'}; charts: {charts}")
    return 0


