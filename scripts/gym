def routine_profile(kind='plan'):
    """The Jefit routine a push writes: its name, description marker, push state file and command."""
    if kind == 'travel':
        return {'kind': kind, 'name': TRAVEL_NAME, 'mark': TRAVEL_MARK, 'pushed': TRAVEL_PUSHED_FILE,
                'cmd': 'gym plan push --travel'}
    return {'kind': 'plan', 'name': PLAN_NAME, 'mark': PLAN_MARK, 'pushed': PUSHED_FILE, 'cmd': 'gym plan push'}
ID_RE = r'u_\d{12}'
WRITE_RULES = [('POST', r'/api/v2/user/routines'),
               ('PATCH', rf'/api/v2/routines/{ID_RE}'), ('DELETE', rf'/api/v2/routines/{ID_RE}'),
               ('POST', rf'/api/v2/routines/{ID_RE}/days'),
               ('PATCH', rf'/api/v2/days/{ID_RE}'), ('DELETE', rf'/api/v2/days/{ID_RE}'),
               ('POST', rf'/api/v2/days/{ID_RE}/day_exercises'),
               ('PATCH', rf'/api/v2/day_exercises/{ID_RE}'), ('DELETE', rf'/api/v2/day_exercises/{ID_RE}')]
EX_FIELDS = ('count', 'sets', 'number_of_reps', 'rest_time')     # PATCH order: count before the per-set values
# HTTP 429: retries, first backoff and its cap (s) when Jefit sends no Retry-After; a longer Retry-After stops
RETRY_TRIES, RETRY_BASE_S, RETRY_CAP_S, RETRY_AFTER_MAX_S = 6, 5.0, 60.0, 300.0
# goal -> role -> (sets, low reps, high reps, rest s)
GOALS = {
    'mixed': {'main': (3, 4, 6, 150), 'acc': (3, 8, 12, 90), 'small': (2, 8, 12, 60)},
    'strength': {'main': (4, 3, 5, 180), 'acc': (3, 6, 10, 120), 'small': (2, 8, 12, 60)},
    'hypertrophy': {'main': (3, 6, 10, 120), 'acc': (3, 10, 15, 75), 'small': (3, 10, 15, 60)},
    'fitness': {'main': (3, 8, 12, 90), 'acc': (3, 12, 15, 45), 'small': (2, 12, 15, 45)},
}
# slot -> how to recognise it in the log (regex on the normalized name and/or the classified muscle) and its role
SLOTS = {
    'squat': {'rx': r'\b(squat|hack)\b', 'not': r'\b(split|bulgarian|jump|goblet|sissy)\b', 'role': 'main',
              'pref': ('barbell',)},
    'hinge': {'rx': r'\b(deadlift|romanian|rdl|good morning)\b', 'role': 'main', 'pref': ('barbell', 'trap bar')},
    'hpush': {'rx': r'\b(bench press|chest press)\b', 'not': r'\b(incline|decline|close grip)\b', 'role': 'main',
              'pref': ('barbell',)},
    'vpush': {'rx': r'\b(military|overhead press|shoulder press|arnold|push press)\b', 'role': 'main',
              'pref': ('barbell',)},
    'vpull': {'rx': r'\b(pull ?downs?|pull ?ups?|chin ?ups?)\b', 'not': r'\bknee raise\b', 'role': 'acc'},
    'hpull': {'rx': r'\brows?\b', 'not': r'\bupright\b', 'role': 'acc'},
    'quad2': {'rx': r'\b(leg press|lunge|split squat|leg extension|hack squat|step up)\b',
              'not': r'\b(calf|single leg)\b', 'role': 'acc'},
    'ham': {'muscle': 'hamstrings', 'role': 'acc'},
    'incline': {'rx': r'\bincline\b.*\bpress\b|\bpress\b.*\bincline\b|\bdumbbell bench press\b|\bdips?\b',
                'role': 'acc'},
    'delt': {'rx': r'\b(lateral raise|side raise|rear delt|face pull|reverse fly)\b', 'role': 'acc'},
    'triceps': {'muscle': 'triceps', 'role': 'small'},
    'biceps': {'muscle': 'biceps', 'role': 'small'},
    'calves': {'muscle': 'calves', 'role': 'small'},
    'core': {'muscle': 'abs', 'role': 'small'},
}
# days/week -> [(key, title, items)]; an item is a slot or a tuple of slots done as a pair
TEMPLATES = {
    2: [('A', 'Full body A', ['squat', 'hpush', ('vpull', 'ham'), ('delt', 'triceps'), 'core']),
        ('B', 'Full body B', ['hinge', 'vpush', 'quad2', 'calves', ('hpull', 'incline'), ('biceps', 'core')])],
    3: [('A', 'Full body A', ['squat', 'hpush', ('vpull', 'ham'), ('delt', 'triceps'), 'core']),
        ('B', 'Full body B', ['hinge', 'vpush', ('hpull', 'incline'), ('biceps', 'core')]),
        ('C', 'Full body C', ['quad2', 'incline', ('vpull', 'ham'), ('delt', 'biceps'), 'calves'])],
    4: [('U1', 'Upper 1', ['hpush', 'hpull', ('vpush', 'vpull'), ('triceps', 'biceps')]),
        ('L1', 'Lower 1', ['squat', ('ham', 'core'), 'quad2', 'calves']),
        ('U2', 'Upper 2', ['vpush', 'vpull', ('incline', 'hpull'), ('delt', 'triceps')]),
        ('L2', 'Lower 2', ['hinge', ('quad2', 'core'), 'ham', 'calves'])],
}
TRIM_ORDER = ('calves', 'core', 'biceps', 'triceps')   # dropped first when a day runs past the time budget
SET_WORK_S, PAIR_SWITCH_S, WARMUP_S, WARMUP2_S, TRANSITION_S = 40, 30, 180, 120, 60
PLAN_RULE = ('Double progression: when every working set reaches the top of the range, add weight next session; '
             'below the bottom of the range twice in a row, drop 10 % and build back. a/b = pair: alternate them, '
             'rest after the pair.')


class PlanError(Exception):
    pass


def jefit_ex_id(key):
    m = re.match(r'jefit:([01]):(\d+)$', key or '')
    return (('d_' if m.group(1) == '1' else 'u_') + m.group(2).zfill(12)) if m else None


def short_name(name):
    s = re.sub(r'\s*\([^)]*\)', '', name or '')
    return re.sub(r'^(barbell|dumbbell|machine|cable|ez bar|kettlebell)\s+', '', s, flags=re.I).strip() or name


def write_private_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + '.tmp'
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as fh:
        json.dump(data, fh, indent=1)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def plan_pool(conn, end):
    """-> {exercise name: info} for every logged exercise: sessions in the last year, last date, recent e1RM/reps."""
    keys = {}
    for k, xid in conn.execute("SELECT key, exercise_id FROM exercise_keys WHERE key LIKE 'jefit:%' ORDER BY key"):
        keys.setdefault(xid, jefit_ex_id(k))
    ex = {}
    q = ('SELECT e.id, e.name, e.muscle, e.secondary, e.equipment, e.kind, x.date, s.weight_kg, s.reps '
         'FROM sets s JOIN exercise_logs l ON l.id=s.log_id JOIN exercises e ON e.id=l.exercise_id '
         'JOIN sessions x ON x.id=l.session_id WHERE x.date <= ? ORDER BY x.date, x.start_ts, l.pos, s.idx')
    for xid, name, mus, sec, eq, kind, date, w, reps in conn.execute(q, (end.isoformat(),)):
        e = ex.setdefault(name, {'name': name, 'muscle': mus or 'other', 'jefit_id': keys.get(xid),
                                 'secondary': [s for s in (sec or '').split(',') if s], 'equipment': eq or 'other',
                                 'kind': kind or 'weight', 'days': {}})
        e['days'].setdefault(date, []).append((w or 0.0, reps))
    year = (end - dt.timedelta(days=365)).isoformat()
    for e in ex.values():
        dates = sorted(e['days'])
        sets = [s for d in dates[-3:] for s in e['days'][d]]
        e.update(n_year=sum(1 for d in dates if d >= year), last=dates[-1],
                 idle_days=(end - dt.date.fromisoformat(dates[-1])).days,
                 e1rm=max((epley(w, r) or 0 for w, r in sets if w > 0 and r and 1 <= r <= 15), default=0),
                 best_reps=max((r for _, r in sets if r), default=0))
    return ex


def slot_match(slot, e):
    s, n = SLOTS[slot], norm_name(e['name'])
    if s.get('muscle') and e['muscle'] != s['muscle']:
        return False
    if s.get('rx') and not re.search(s['rx'], n):
        return False
    if s.get('not') and re.search(s['not'], n):
        return False
    return not (slot == 'core' and e['kind'] == 'timed')


def slot_score(slot, e):
    s = SLOTS[slot]
    score = e['n_year'] - 0.25 * e['idle_days'] / 30.4
    if s['role'] == 'main' and e['equipment'] in s.get('pref', ()):
        score += 20
    if slot != 'core' and e['kind'] == 'weight':
        score += 5
    return score


def plan_pick(slot, pool, used, exclude=()):
    """Best exercise from his own log for a slot: familiar (sessions in the last year), recent, loadable."""
    for min_n in (2, 1):
        c = [e for e in pool.values() if e['n_year'] >= min_n and e['jefit_id'] and e['name'] not in exclude
             and slot_match(slot, e)]
        c = [e for e in c if e['name'] not in used] or c       # reuse only when nothing else fits
        if c:
            return max(c, key=lambda e: (slot_score(slot, e), e['name']))
    return None


def plan_step(e):
    return 5.0 if e['equipment'] in ('cable', 'machine') else 2.5


def plan_inc(slot, e):
    n, eq = norm_name(e['name']), e['equipment']
    if eq in ('barbell', 'trap bar'):
        return 5.0 if slot in ('squat', 'hinge') or e['muscle'] in ('quads', 'hamstrings', 'glutes') else 2.5
    if eq == 'machine' and re.search(r'\b(leg press|calf press)\b', n):
        return 10.0
    return 5.0 if eq in ('cable', 'machine') else 2.5


def start_weight(e, lo, hi):
    """-> (kg or None, target reps, basis). Start where the middle of the range leaves ~2 reps in reserve:
    e1RM (best Epley of the last 3 sessions) x detraining / (1 + (mid + 2) / 30), rounded down to the step."""
    mid = (lo + hi) / 2
    if not e['e1rm']:
        t = min(hi, max(lo, int(e['best_reps'] * 0.75)))
        return None, t, f"bodyweight, best {e['best_reps']} reps"
    f = 1.0 if e['idle_days'] < 56 else 0.9 if e['idle_days'] < 183 else 0.85
    step = plan_step(e)
    w = math.floor(round(e['e1rm'] * f / (1 + (mid + 2) / 30) / step, 3)) * step
    basis = f"e1RM {fmt_kg(e['e1rm'])} (last {ddmm(e['last'])})" + (f' x{f}' if f < 1 else '')
    return max(w, step), int(mid), basis


def plan_exercise(slot, e, role, goal, group):
    sets, lo, hi, rest = GOALS[goal][role]
    w, target, basis = start_weight(e, lo, hi)
    return {'slot': slot, 'name': e['name'], 'jefit_id': e['jefit_id'], 'muscle': e['muscle'],
            'secondary': e['secondary'], 'equipment': e['equipment'], 'role': role, 'group': group, 'sets': sets,
            'lo': lo, 'hi': hi, 'reps': target, 'rest_s': rest, 'pair_rest_s': rest, 'weight_kg': w,
            'inc_kg': plan_inc(slot, e) if w else 0.0, 'step_kg': plan_step(e), 'basis': basis,
            'stalls': 0, 'fails': 0}


def relabel(exs):
    """Numbers per group (1, 2, 3a/3b ...); in a pair the first rests briefly, the last takes the pair's rest."""
    groups = []
    for x in exs:
        if groups and groups[-1][0]['group'] == x['group']:
            groups[-1].append(x)
        else:
            groups.append([x])
    for i, g in enumerate(groups, 1):
        for j, x in enumerate(g):
            x['label'] = f'{i}{"abcd"[j]}' if len(g) > 1 else str(i)
            x['rest_s'] = PAIR_SWITCH_S if j < len(g) - 1 else max(y['pair_rest_s'] for y in g)
    return groups


def est_minutes(exs):
    t, mains = 0, 0
    for g in relabel(exs):
        for r in range(max(x['sets'] for x in g)):
            t += sum(SET_WORK_S + x['rest_s'] for x in g if x['sets'] > r)
        for x in g:
            if x['role'] == 'main':
                t += WARMUP_S if mains == 0 else WARMUP2_S
                mains += 1
        t += TRANSITION_S
    return round(t / 60)


def plan_volume(days):
    v = {m: 0.0 for m in MUSCLES}
    for d in days:
        for x in d['exercises']:
            if x['muscle'] in v:
                v[x['muscle']] += x['sets']
            for s in x['secondary']:
                if s in v:
                    v[s] += 0.5 * x['sets']
    return {k: round(x, 1) for k, x in v.items()}


def build_plan(conn, days, goal, minutes, swaps, end):
    pool = plan_pool(conn, end)
    if not pool:
        raise PlanError('no workout history yet: run `gym sync` (or import a CSV) first')
    for old, new in swaps.items():
        if new not in pool or not pool[new]['jefit_id']:
            raise PlanError(f'--swap: "{new}" is not in your log (with a Jefit id); see `gym exercises`')
    used, out, notes = set(), [], []
    for key, title, items in TEMPLATES[days]:
        exs = []
        for gi, it in enumerate(items, 1):
            for slot in (it if isinstance(it, tuple) else (it,)):
                e = plan_pick(slot, pool, used)
                if e and e['name'] in swaps:
                    e = pool[swaps[e['name']]]
                if not e:
                    notes.append(f'{key}: nothing in your log fits the {slot} slot; left out')
                    continue
                used.add(e['name'])
                exs.append(plan_exercise(slot, e, SLOTS[slot]['role'], goal, gi))
        relabel(exs)
        for slot in TRIM_ORDER:
            if est_minutes(exs) <= minutes + 5:
                break
            drop = [x for x in exs if x['slot'] == slot]
            if drop:
                exs.remove(drop[-1])
                notes.append(f'{key}: {drop[-1]["name"]} left out to stay near {minutes} min')
                relabel(exs)
        mains = [short_name(x['name']) for x in exs if x['role'] == 'main']
        out.append({'key': key, 'name': f'{key} · ' + (' + '.join(mains) if mains else title), 'exercises': exs,
                    'est_min': est_minutes(exs)})
    r = analyze(conn, weeks=4, end=end)
    for lift in r.get('main_lifts') or []:
        if lift['status'] == 'plateau' and lift['exercise'] in used:
            notes.append(f"{lift['exercise']}: no PR in {round(lift['weeks_since_pr'])} wk; new rep range in this plan")
    now = r.get('hard_sets_per_week_4w') or {}
    return {'version': 1, 'name': PLAN_NAME, 'created': end.isoformat(), 'updated': end.isoformat(), 'goal': goal,
            'days_per_week': days, 'minutes': minutes, 'days': out, 'volume': plan_volume(out),
            'volume_now': {k: round(v, 1) for k, v in now.items()}, 'notes': notes, 'rule': PLAN_RULE}


def plan_card(plan):
    lines = [f"Plan \"{plan['name']}\" v{plan['version']} · {plan['days_per_week']} days/week · goal {plan['goal']}"
             f" · ~{plan['minutes']} min"]
    for d in plan['days']:
        lines.append(f"{d['name']} (~{d['est_min']} min)")
        for x in d['exercises']:
            w = f"{fmt_kg(x['weight_kg'])} kg" if x['weight_kg'] else \
                'band' if x.get('equipment') == 'band' else 'bodyweight'
            rest = f"rest {x['rest_s'] // 60}:{x['rest_s'] % 60:02d}" if x['rest_s'] > PAIR_SWITCH_S else '→ pair'
            lines.append(f"  {x['label']:<3}{x['name']}  {x['sets']}×{x['lo']}–{x['hi']} @ {w}  {rest}"
                         + (f"  (for {x['for']})" if x.get('for') else ''))
            if x.get('cue'):
                lines.append(f"       {x['cue']}")
    vol, now = plan.get('volume') or {}, plan.get('volume_now') or {}
    lines.append('Hard sets/week: ' + ', '.join(f"{m} {fmt_kg(vol[m])} ({fmt_kg(now.get(m, 0))})"
                                                for m in MUSCLES if vol.get(m) or now.get(m)) + ' — (now)')
    lines.append('Rule: ' + plan['rule'])
    lines += [f'Note: {n}' for n in plan.get('notes') or []]
    lines.append('Suggestions only, not medical advice.')
    return '\n'.join(lines)


def free_evenings(day, n=3):
    """Free evenings (18-23) in the next n days from calcache's cache (token-free): ['today', 'Wed', ...];
    None without a cache, on any error, or with GYM_CALCACHE=off."""
    import subprocess
    bin_ = os.environ.get('GYM_CALCACHE') or os.path.join(HOME, 'bin/calcache')
    if bin_ == 'off' or not os.path.exists(bin_):
        return None
    try:
        r = subprocess.run([bin_, 'busy', day.isoformat(), '--days', str(n), '--json'], capture_output=True,
                           text=True, timeout=15)
        rows = [x for x in json.loads(r.stdout) if x.get('covered')] if r.returncode in (0, 4) else []
        if not rows:
            return None
        return ['today' if x['date'] == day.isoformat() else dt.date.fromisoformat(x['date']).strftime('%a')
                for x in rows if not x.get('evening_busy')]
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError, AttributeError):
        return None


def evenings_line(day, n=3):
    """Optional /gym card line: free evenings from free_evenings(); '' when that has nothing."""
    free = free_evenings(day, n)
    if free is None:
        return ''
    return '\n📅 Free evenings: ' + (', '.join(free) if free else f'none in the next {n} days')


def next_day(conn, plan, end):
    """-> (index of the plan day the last logged session matches or None, the next plan day): the day after the
    match (largest share of its exercises, no tie), else the first day."""
    days = plan['days']
    done = None
    sessions, ex = load(conn)
    sessions = [s for s in sessions if s['date'] <= end.isoformat()]
    if sessions:
        names = {norm_name(ex[lg['ex']]['name']) for lg in sessions[-1]['logs']}
        scores = [len(names & {norm_name(x['name']) for x in d['exercises']}) / max(1, len(d['exercises']))
                  for d in days]
        if max(scores) and scores.count(max(scores)) == 1:
            done = scores.index(max(scores))
    return done, days[(done + 1) % len(days)] if done is not None else days[0]


# the three main lifts on the dashboard: first matching exercise name (normalized) wins, in this order
MAIN_LIFTS = (('squat', ('barbell squat', 'squat', 'barbell back squat', 'back squat')),
              ('bench', ('barbell bench press', 'bench press')),
              ('deadlift', ('barbell deadlift', 'deadlift', 'conventional deadlift')))


def lift_trends(conn, end, weeks=4):
    """e1RM trend of squat, bench and deadlift from the local log: per lift the best e1RM of each session up to
    `end`; last = the newest value, change = last minus the newest value on or before end - weeks; None when the
    lift was not done in those weeks or has no older value. series = the sessions of the last 12 weeks (date, e1RM)."""
    sessions, ex = load(conn)
    by_name = {}
    for s in sessions:
        if s['date'] > end.isoformat():
            continue
        for lg in s['logs']:
            e = ex[lg['ex']]
            vals = [x['e1rm'] for x in lg['sets'] if x['e1rm']]
            if e['kind'] == 'weight' and vals:
                pts = by_name.setdefault(norm_name(e['name']), {'name': e['name'], 'pts': {}})
                pts['pts'][s['date']] = max(pts['pts'].get(s['date'], 0), max(vals))
    out = []
    for key, names in MAIN_LIFTS:
        hit = next((by_name[n] for n in names if n in by_name), None)
        if not hit:
            out.append({'lift': key, 'exercise': None, 'last': None, 'last_date': None, 'change': None,
                        'series': []})
            continue
        pts = sorted(hit['pts'].items())
        last_d, last_v = pts[-1]
        cut = (end - dt.timedelta(weeks=weeks)).isoformat()
        base = [v for d, v in pts if d <= cut] if last_d > cut else []
        since = (end - dt.timedelta(weeks=12)).isoformat()
        out.append({'lift': key, 'exercise': hit['name'], 'last': round(last_v, 1), 'last_date': last_d,
                    'change': round(last_v - base[-1], 1) if base else None,
                    'series': [[d, round(v, 1)] for d, v in pts if d >= since]})
    return out


# ----------------------------------------------------------------------------- other activity (dance, from calcache)
ACTIVITY_FILE = os.path.join(STATE, 'activity.json')
ACTIVITY_KEEP_DAYS = 400
SHUFFLE_RE = re.compile(r'\bshuffle', re.I)
RAVE_RE = re.compile(r'\brave|\bclub|techno|festival|open[- ]?air|afterhour|warehouse|boiler room', re.I)
RAVE_MIN_H, ACT_MAX_H = 2.0, 12.0
ACT_KINDS = (('shuffle', '🕺'), ('rave', '🪩'))


def rave_artists():
    """rave-radar's artist names + aliases (lowercase, 3+ letters); [] when missing, off or failing."""
    import subprocess
    bin_ = os.environ.get('GYM_RAVE_RADAR') or os.path.join(HOME, 'bin/rave-radar')
    if bin_ == 'off' or not os.path.exists(bin_):
        return []
    try:
        r = subprocess.run([bin_, 'artists', 'list', '--json'], capture_output=True, text=True, timeout=10)
        rows = json.loads(r.stdout) if r.returncode == 0 else []
    except (OSError, ValueError, subprocess.SubprocessError):
        return []
    names = []
    for a in rows if isinstance(rows, list) else []:
        if isinstance(a, dict):
            names += [n.strip().lower() for n in [a.get('name'), *(a.get('aliases') or [])]
                      if isinstance(n, str) and len(n.strip()) >= 3]
    return names


def artist_hit(text, names):
    """An artist named in text: whole words, or close enough for a typo when the name is 6+ letters."""
    import difflib
    low = text.lower()
    toks = re.findall(r"[\w'&.-]+", low)
    for n in names:
        if re.search(r'(?<!\w)' + re.escape(n) + r'(?!\w)', low):
            return True
        k = len(n.split())
        if len(n) >= 6 and any(difflib.SequenceMatcher(None, ' '.join(toks[i:i + k]), n).ratio() >= 0.85
                               for i in range(len(toks) - k + 1)):
            return True
    return False


def activity_kind(ev, artists):
    """(kind, hours) for one calcache event: 'shuffle' (title says shuffle) or 'rave' (rave/club words or a rave-radar
    artist, 2+ h); timed events only, travel legs never; hours capped at 12. artists() is called lazily. Else None."""
    if not isinstance(ev, dict) or ev.get('all_day') or (ev.get('flags') or {}).get('travel'):
        return None
    try:
        hours = (dt.datetime.fromisoformat(ev['end']) - dt.datetime.fromisoformat(ev['start'])).total_seconds() / 3600
    except (KeyError, TypeError, ValueError):
        return None
    title = str(ev.get('title') or '')
    if not 0 < hours <= 24:
        return None
    if SHUFFLE_RE.search(title):
        return 'shuffle', round(min(hours, ACT_MAX_H), 2)
    if hours >= RAVE_MIN_H and (RAVE_RE.search(title) or artist_hit(title, artists())):
        return 'rave', round(min(hours, ACT_MAX_H), 2)
    return None


def activity_sync(now):
    """Merge calcache's events (today on) into activity.json: per event id {date, start, end, kind, hours}, no titles.
    Entries dated today or later that left the cache are dropped (cancelled/renamed); past days stay as observed.
    Writes only on change. Returns the store; a missing/failed calcache (or GYM_CALCACHE=off) only reads it."""
    import subprocess
    store = read_json(ACTIVITY_FILE)
    store = store if isinstance(store, dict) and isinstance(store.get('events'), dict) else {'events': {}}
    bin_ = os.environ.get('GYM_CALCACHE') or os.path.join(HOME, 'bin/calcache')
    if bin_ == 'off' or not os.path.exists(bin_):
        return store
    try:
        r = subprocess.run([bin_, 'show', '--days', '21', '--json'], capture_output=True, text=True, timeout=15)
        evs = json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, ValueError, subprocess.SubprocessError):
        evs = None
    if not isinstance(evs, list):
        return store
    tz, today_s = owner_tz(), now.date().isoformat()
    cache = {}

    def artists():
        if 'a' not in cache:
            cache['a'] = rave_artists()
        return cache['a']
    seen = {}
    for ev in evs:
        k = activity_kind(ev, artists)
        if k and ev.get('id'):
            start = dt.datetime.fromisoformat(ev['start'])
            start = start.astimezone(tz) if start.tzinfo else start
            seen[str(ev['id'])] = {'date': start.date().isoformat(), 'start': ev['start'], 'end': ev['end'],
                                   'kind': k[0], 'hours': k[1]}
    keep = (now.date() - dt.timedelta(days=ACTIVITY_KEEP_DAYS)).isoformat()
    events = {i: v for i, v in store['events'].items()
              if isinstance(v, dict) and keep <= str(v.get('date', '')) < today_s}
    events.update(seen)
    new = {'version': 1, 'since': store.get('since') or today_s, 'events': events}
    if new != store:
        try:
            os.makedirs(STATE, mode=0o700, exist_ok=True)
            tmp = f'{ACTIVITY_FILE}.{os.getpid()}.tmp'
            with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as fh:
                json.dump(new, fh, indent=1)
            os.chmod(tmp, 0o600)
            os.replace(tmp, ACTIVITY_FILE)
        except OSError:
            pass
    return new


def other_activity(end, weeks=8, now=None):
    """Dance per week for the `weeks` weeks to `end` (same Monday weeks as analyze): {since, this_week, total, weeks:
    [{start, shuffle: {count, hours}, rave: {...}}]}; events count once they are over (end <= now, or within `end`)."""
    now = now or now_dt()
    try:
        store = activity_sync(now)
    except Exception:          # never break the card over the calendar
        store = read_json(ACTIVITY_FILE) or {}
    cutoff = min(now, dt.datetime.combine(end + dt.timedelta(days=1), dt.time(), now.tzinfo or owner_tz()))
    win0 = week_start(end) - dt.timedelta(weeks=weeks - 1)
    blank = lambda: {k: {'count': 0, 'hours': 0.0} for k, _ in ACT_KINDS}
    rows = {(win0 + dt.timedelta(weeks=i)).isoformat(): dict(start=(win0 + dt.timedelta(weeks=i)).isoformat(), **blank())
            for i in range(weeks)}
    evs = store.get('events') if isinstance(store.get('events'), dict) else {}
    for v in evs.values():
        try:
            e_ = dt.datetime.fromisoformat(v['end'])
            e_ = e_ if e_.tzinfo else e_.replace(tzinfo=owner_tz())
            row = rows.get(week_start(dt.date.fromisoformat(v['date'])).isoformat())
            b = row and row.get(v['kind'])
            if not b or e_ > cutoff:
                continue
            b['count'] += 1
            b['hours'] = round(b['hours'] + float(v['hours']), 1)
        except (KeyError, TypeError, ValueError, AttributeError):
            continue
    wl = list(rows.values())
    total = blank()
    for w in wl:
        for k, _ in ACT_KINDS:
            total[k]['count'] += w[k]['count']
            total[k]['hours'] = round(total[k]['hours'] + w[k]['hours'], 1)
    return {'since': store.get('since'), 'this_week': {k: wl[-1][k] for k, _ in ACT_KINDS}, 'total': total,
            'weeks': wl}


def act_any(b):
    return any((b.get(k) or {}).get('count') for k, _ in ACT_KINDS)


def act_h(h):
    return f'{h:.0f} h' if abs(h - round(h)) < 0.05 else f'{h:.1f} h'


def act_text(b, emoji=True, counts=False):
    """'🕺 shuffle 1 h · 🪩 rave 6 h' for a {shuffle, rave} block ('' when empty); counts=True: 'shuffle 4× 4 h'."""
    out = []
    for k, emo in ACT_KINDS:
        x = b.get(k) or {}
        if x.get('count'):
            n = f"{x['count']}× " if counts or x['count'] > 1 else ''
            out.append((f'{emo} ' if emoji else '') + f'{k} {n}{act_h(x["hours"])}')
    return (' · ' if emoji else ', ').join(out)


def act_line(oa):
    """One /gym line: 'Dance: 🕺 shuffle 1 h this week · 8 wk: shuffle 4× 4 h, rave 1× 8 h'; '' when 8 weeks empty."""
    if not oa or not act_any(oa['total']):
        return ''
    tot = act_text(oa['total'], emoji=False, counts=True)
    wk = act_text(oa['this_week'])
    return f'Dance: {wk} this week · {len(oa["weeks"])} wk: {tot}' if wk else f'Dance ({len(oa["weeks"])} wk): {tot}'


def week_status(sessions, dance, current):
    """'gym' | 'active' (dance, no gym) | 'missed' | 'open' (this week, nothing yet)."""
    return 'gym' if sessions else 'active' if dance else 'open' if current else 'missed'


def plan_next_json(conn, plan, end):
    """The dashboard block (`gym plan next --json`): numbers and exercise names only, local data only."""
    r = analyze(conn, 8, end)
    c = r['consistency']
    has_plan = bool(plan and plan.get('days'))
    target = plan.get('days_per_week') if has_plan else None
    wk = week_start(end).isoformat()
    this = next((w for w in r['weekly'] if w['start'] == wk), None)
    res = {'schema': 1, 'date': end.isoformat(),
           'plan': ({'name': plan.get('name'), 'version': plan.get('version'), 'days_per_week': target,
                     'in_jefit': (read_json(PUSHED_FILE) or {}).get('status') == 'complete'} if has_plan else None),
           'week': {'start': wk, 'sessions': this['sessions'] if this else 0, 'target': target},
           'weeks': [{'start': w['start'], 'sessions': w['sessions']} for w in r['weekly']],
           'other_activity': other_activity(end, 8),
           'streak_weeks': c['streak_weeks'], 'longest_streak_weeks': c['longest_streak_weeks'],
           'sessions_per_week_4w': r['sessions_per_week_4w'], 'total_sessions': r['total_sessions'],
           'last_session': None, 'next': None, 'lifts': lift_trends(conn, end), 'free_evenings': free_evenings(end)}
    dance = {w['start']: act_any(w) for w in res['other_activity']['weeks']}
    for w in res['weeks']:
        w['status'] = week_status(w['sessions'], dance.get(w['start']), w['start'] == wk)
    res['week']['status'] = week_status(res['week']['sessions'], dance.get(wk), True)
    done = None
    if has_plan:
        done, d = next_day(conn, plan, end)
        lead = (d.get('exercises') or [{}])[0]
        res['next'] = {'key': d.get('key'), 'name': d.get('name'), 'est_min': d.get('est_min'),
                       'lead': lead.get('name'), 'lead_sets': lead.get('sets'), 'lead_reps': [lead.get('lo'), lead.get('hi')],
                       'lead_kg': lead.get('weight_kg')}
    if r['last_date']:
        res['last_session'] = {'date': r['last_date'], 'days_ago': c['days_since_last'],
                               'day': plan['days'][done].get('key') if done is not None else None}
    return res


def plan_next(conn, plan, end):
    """Phone card of the next session, from local data only (the DB as of the last sync/import): the plan day
    after the one the last logged session matches (largest share of its exercises, no tie), else the first day; each
    exercise with sets×reps @ weight; last session date and the weekly streak. No plan: the review's summary line."""
    r = analyze(conn, 4, end)
    c = r['consistency']
    last = r['last_date']
    ago = c['days_since_last']
    ago_txt = None if ago is None else 'today' if ago == 0 else 'yesterday' if ago == 1 else f'{ago} d ago'
    if not plan or not plan.get('days'):
        if not r['total_sessions']:
            dl = act_line(other_activity(end, 8))
            return '🏋️ Gym · no plan and no sessions logged yet' + (f'\n{dl}' if dl else '')
        n4 = round(r['sessions_per_week_4w'] * 4)
        dl = act_line(other_activity(end, 8))
        return ('🏋️ Gym · no plan yet\n'
                f"{n4} sessions in 4 wk ({r['sessions_per_week_4w']}/wk) · streak {c['streak_weeks']} wk"
                f" · last {ddmm(last)} ({ago_txt})" + (f'\n{dl}' if dl else ''))
    days = plan['days']
    done, d = next_day(conn, plan, end)
    L = [f"🏋️ Next: {d['name']} (~{d['est_min']} min)"]
    if last:
        L.append(f"Last session {ddmm(last)}" + (f" ({days[done]['key']}, {ago_txt})" if done is not None
                                                  else f" ({ago_txt})") + f" · streak {c['streak_weeks']} wk")
    else:
        L.append('No session logged yet')
    dl = act_line(other_activity(end, 8))
    if dl:
        L.append(dl)
    L.append('')
    for x in d['exercises']:
        w = f"{fmt_kg(x['weight_kg'])} kg" if x['weight_kg'] else 'bodyweight'
        L.append(f"{x['label']:<3}{x['name']}  {x['sets']}×{x['lo']}–{x['hi']} @ {w}")
    if any(x['label'][-1:] in 'ab' and not x['label'].isdigit() for x in d['exercises']):
        L.append('a/b = pair: alternate them, rest after the pair')
    pushed = read_json(PUSHED_FILE) or {}
    if pushed.get('status') == 'complete':
        jf = ('in Jefit' if pushed.get('plan_version') == plan.get('version')
              else f"Jefit has v{pushed.get('plan_version')}")
    else:
        jf = 'not in Jefit yet'
    row = conn.execute('SELECT at FROM imports ORDER BY id DESC LIMIT 1').fetchone()
    synced = ''
    try:
        at = dt.datetime.fromisoformat(row[0])
        at = at.astimezone(owner_tz()) if at.tzinfo else at
        synced = f" · log synced {ddmm(at.date().isoformat())} {at:%H:%M}"
    except (TypeError, ValueError):
        pass
    L += ['', f"Plan v{plan.get('version')} · {jf}{synced}"]
    return '\n'.join(L)


def plan_description(plan, mark=PLAN_MARK):
    parts = [d['key'] + ': ' + ', '.join(f"{x['label']} {short_name(x['name'])} {x['sets']}x{x['lo']}-{x['hi']}"
                                         for x in d['exercises']) for d in plan['days']]
    return (f"{mark} {plan['days_per_week']} days/week, goal {plan['goal']}. " + ' | '.join(parts) + '. '
            + plan['rule'])[:1000]


def plan_target(plan, prof=None):
    """The Jefit routine the plan should be (weights as weight_lbs: Jefit stores pounds)."""
    prof = prof or routine_profile()
    days = []
    for i, d in enumerate(plan['days']):
        exs = []
        for x in d['exercises']:
            lbs = round(x['weight_kg'] / LB, 4) if x.get('weight_kg') else None
            one = {'reps': x['reps'], 'weight_lbs': lbs, 'rest_time': x['rest_s'], 'duration': 0, 'type': 'default'}
            exs.append({'exercise_id': x['jefit_id'], 'name': x['name'], 'count': x['sets'],
                        'number_of_reps': [x['reps']] * x['sets'], 'rest_time': x['rest_s'],
                        'sets': [dict(one) for _ in range(x['sets'])]})
        days.append({'name': d['name'], 'index': i + 1, 'day_of_week': 7, 'exercises': exs})
    return {'routine': {'name': prof['name'], 'description': plan_description(plan, prof['mark']),
                        'day_indexing_style': 'number',
                        'focus': 'general', 'difficulty': 'intermediate', 'day_count': len(days)}, 'days': days}


def ex_add_ops(dk, ek, x):
    """Add an exercise, then ONE PATCH with all its fields (Jefit takes several fields per call; read back 19.10)."""
    return [('add_ex', dk, ek, x['exercise_id']), ('patch_ex', ek, {f: x[f] for f in EX_FIELDS})]


def field_eq(f, a, b):
    """Same value for a day_exercise field; per-set values compare reps, rest and weight (0.01 lb)."""
    if f != 'sets':
        return a == b
    if not isinstance(a, list) or not isinstance(b, list) or len(a) != len(b):
        return False
    return all(isinstance(s, dict) and s.get('reps') == w.get('reps') and s.get('rest_time') == w.get('rest_time')
               and abs((s.get('weight_lbs') or 0) - (w.get('weight_lbs') or 0)) <= 0.01 for s, w in zip(a, b))


def live_target(r):
    """A live Jefit routine in plan_target()'s shape, to resume a push that stopped half-way."""
    days = []
    for d in sorted_days(r):
        exs = []
        for e in sorted_exs(d):
            sets = sorted(e.get('sets') or [], key=lambda s: s.get('index') or 0)
            exs.append({'exercise_id': str((e.get('exercise') or {}).get('id')), 'count': e.get('count'),
                        'number_of_reps': e.get('number_of_reps'), 'rest_time': e.get('rest_time'),
                        'sets': [{k: st.get(k) for k in ('reps', 'weight_lbs', 'rest_time')} for st in sets]})
        days.append({'name': d.get('name'), 'index': d.get('index'), 'day_of_week': d.get('day_of_week'),
                     'exercises': exs})
    return {'routine': {k: r.get(k) for k in ('name', 'description', 'day_indexing_style', 'focus', 'difficulty',
                                              'day_count')}, 'days': days}


def plan_ops(target, pushed, rebuild=False, live=None):
    """Abstract writes (symbols R, D1, D1E1 ... stand for Jefit ids). The diff base is `live` (resume, from
    live_target), else the last complete push; with neither, or --rebuild, a full build."""
    pushed = pushed or {}
    old = live if live is not None else (pushed.get('target') if pushed.get('status') == 'complete' else None)
    if rebuild or old is None:
        ops = [('delete_routine', 'R_old')] if rebuild and pushed.get('routine_id') else []
        ops += [('create_routine', 'R'), ('patch_routine', 'R', target['routine'])]
        for i, d in enumerate(target['days']):
            dk = f'D{i + 1}'
            f = {k: d[k] for k in ('name', 'index', 'day_of_week')}
            ops.append(('patch_day', dk, f) if i == 0 else ('add_day', dk, f))
            for j, x in enumerate(d['exercises']):
                ops += ex_add_ops(dk, f'{dk}E{j + 1}', x)
        return ops
    ops = []
    ch = {k: v for k, v in target['routine'].items() if old['routine'].get(k) != v}
    if ch:
        ops.append(('patch_routine', 'R', ch))
    for i, d in enumerate(target['days']):
        dk = f'D{i + 1}'
        if i >= len(old['days']):
            ops.append(('add_day', dk, {k: d[k] for k in ('name', 'index', 'day_of_week')}))
            for j, x in enumerate(d['exercises']):
                ops += ex_add_ops(dk, f'{dk}E{j + 1}', x)
            continue
        od = old['days'][i]
        dch = {k: d[k] for k in ('name', 'index', 'day_of_week') if od.get(k) != d[k]}
        if dch:
            ops.append(('patch_day', dk, dch))
        oe, ne = od['exercises'], d['exercises']
        k = 0
        while k < min(len(oe), len(ne)) and oe[k]['exercise_id'] == ne[k]['exercise_id']:
            k += 1
        for j in range(k):
            fields = {f: ne[j][f] for f in EX_FIELDS if not field_eq(f, oe[j].get(f), ne[j][f])}
            if fields:
                ops.append(('patch_ex', f'{dk}E{j + 1}', fields))
        ops += [('delete_ex', f'{dk}E{j + 1}') for j in range(len(oe) - 1, k - 1, -1)]
        for j in range(k, len(ne)):
            ops += ex_add_ops(dk, f'{dk}E{j + 1}', ne[j])
    ops += [('delete_day', f'D{i + 1}') for i in range(len(old['days']) - 1, len(target['days']) - 1, -1)]
    return ops


def op_request(op):
    """-> (method, path with {SYMBOL}s, body)."""
    k = op[0]
    if k == 'create_routine':
        return 'POST', '/api/v2/user/routines', {'create_day': True}
    if k in ('patch_routine', 'patch_day'):
        return 'PATCH', ('/api/v2/routines/{%s}' if k == 'patch_routine' else '/api/v2/days/{%s}') % op[1], \
            {'data': op[2]}
    if k == 'add_day':
        return 'POST', '/api/v2/routines/{R}/days', {'data': op[2]}
    if k == 'add_ex':
        return 'POST', '/api/v2/days/{%s}/day_exercises' % op[1], {'data': {'exercise': {'id': op[3]}}}
    if k == 'patch_ex':
        return 'PATCH', '/api/v2/day_exercises/{%s}' % op[1], {'data': op[2]}
    return 'DELETE', {'delete_routine': '/api/v2/routines/{%s}', 'delete_day': '/api/v2/days/{%s}',
                      'delete_ex': '/api/v2/day_exercises/{%s}'}[k] % op[1], None


def test_requests(first_ex_id):
    lbs = round(80 / LB, 4)
    return [('GET', '/api/v2/user/routines', None), ('POST', '/api/v2/user/routines', {'create_day': True}),
            ('PATCH', '/api/v2/routines/{T}', {'data': {'name': TEST_NAME}}), ('GET', '/api/v2/routines/{T}', None),
            ('POST', '/api/v2/days/{T_D1}/day_exercises', {'data': {'exercise': {'id': first_ex_id}}}),
            ('PATCH', '/api/v2/day_exercises/{T_E1}', {'data': {'sets': [
                {'reps': 5, 'weight_lbs': lbs, 'rest_time': 150, 'duration': 0, 'type': 'default'}]}}),
            ('GET', '/api/v2/day_exercises/{T_E1}', None), ('DELETE', '/api/v2/routines/{T}', None),
            ('GET', '/api/v2/user/routines', None)]


def retry_after_s(v):
    """Retry-After header (seconds or an HTTP date) -> seconds, or None."""
    v = (v or '').strip()
    if not v:
        return None
    try:
        return max(0.0, float(v))
    except ValueError:
        pass
    try:
        t = email.utils.parsedate_to_datetime(v)
    except (TypeError, ValueError, IndexError):
        return None
    if t.tzinfo is None:
        t = t.replace(tzinfo=dt.timezone.utc)
    return max(0.0, (t - dt.datetime.now(dt.timezone.utc)).total_seconds())


class PlanWriter:
    """HTTP for plan pushes. Refuses any write outside WRITE_RULES or touching an id it does not own.
    Paces every request (`delay` s apart) and retries HTTP 429 (Retry-After, else 5-60 s backoff)."""

    def __init__(self, cfg, token, delay=None, sleep=None, backoff=None, handle=None):
        self.cfg, self._t, self.count, self.sent, self.handle = cfg, token, 0, [], handle
        self.owned, self.deletable = set(), set()
        self.delay = float(os.environ.get('GYM_WRITE_DELAY', '1.0') if delay is None else delay)
        self.backoff = float(os.environ.get('GYM_RETRY_BASE', RETRY_BASE_S) if backoff is None else backoff)
        self.sleep = sleep or time.sleep
        self.retries, self.waited, self._last = 0, 0.0, None

    def scrub(self, s):
        return str(s).replace(self._t, '***') if self._t else str(s)

    def allowed(self, method, path):
        if method == 'GET':
            return path.startswith('/api/v2/')
        for m, rx in WRITE_RULES:
            if m == method and re.fullmatch(rx, path):
                ids = re.findall(ID_RE, path)
                if method == 'DELETE' and path.startswith('/api/v2/routines/'):
                    return ids[0] in self.deletable
                return all(i in self.owned for i in ids)
        return False

    def _pace(self):
        if self.delay and self._last is not None:
            wait = self._last + self.delay - time.monotonic()
            if wait > 0:
                self.sleep(wait)
        self._last = time.monotonic()

    def _send(self, method, path, body):
        url = self.cfg['base'].rstrip('/') + path
        data = json.dumps(body).encode() if body is not None else None
        hdr = {'Authorization': f'Bearer {self._t}', 'Accept': 'application/json', 'User-Agent': 'gym-plan/1'}
        if data is not None:
            hdr['Content-Type'] = 'application/json'
        req = urllib.request.Request(url, data=data, method=method, headers=hdr)
        try:
            with (_egress.open(req, self.handle, timeout=60) if self.handle else
                  urllib.request.urlopen(req, timeout=60)) as r:
                status, raw, after = r.status, r.read(20_000_000), None
        except urllib.error.HTTPError as e:
            status, raw = e.code, e.read(200_000) if e.fp else b''
            after = retry_after_s(e.headers.get('Retry-After') if e.headers else None)
        except (urllib.error.URLError, OSError) as e:
            raise PlanError(self.scrub(f'{method} {path}: {getattr(e, "reason", e)}')) from None
        try:
            payload = json.loads(raw.decode('utf-8', 'replace')) if raw.strip() else {}
        except ValueError:
            payload = {}
        return status, payload, after

    def _journal(self, method, path, status, payload):
        self.sent.append((method, path, status))
        line = {'at': dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds'), 'method': method, 'path': path,
                'status': status}
        data = payload.get('data') if isinstance(payload, dict) else None
        if method == 'POST' and path == '/api/v2/user/routines' and 200 <= status < 300 and isinstance(data, dict) \
                and re.fullmatch(ID_RE, str(data.get('id'))):
            line['new_id'] = data['id']             # created by this tool: a leftover may be deleted later
        os.makedirs(os.path.dirname(PUSH_LOG), mode=0o700, exist_ok=True)
        with open(os.open(PUSH_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600), 'a') as fh:
            fh.write(json.dumps(line) + '\n')

    def call(self, method, path, body=None):
        if not self.allowed(method, path):
            raise PlanError(f'refused {method} {path}: outside the plan routine')
        for attempt in range(RETRY_TRIES + 1):
            if self.count >= 400:
                raise PlanError('request cap reached')
            self.count += 1
            self._pace()
            status, payload, after = self._send(method, path, body)
            if method != 'GET':
                self._journal(method, path, status, payload)
            if status != 429 or attempt == RETRY_TRIES:
                break
            wait = after if after is not None else min(RETRY_CAP_S, self.backoff * 2 ** attempt)
            if wait > RETRY_AFTER_MAX_S:
                raise PlanError(f'Jefit rate limit: it asks to wait {wait / 60:.0f} min; run `gym plan push --apply` '
                                'again later (it resumes)')
            self.retries += 1
            self.waited += wait
            self.sleep(wait)
        if not 200 <= status < 300:
            err = payload.get('error') or payload.get('message') if isinstance(payload, dict) else None
            if method != 'GET' and status in (401, 403):
                raise PlanError(f'Jefit refused {method} {path} (HTTP {status}): the token has no write scope? '
                                f'Create a "Read + write" token and put it in {TOKEN_RW_FILE} (0600, console only).')
            if status == 429:
                raise PlanError(f'Jefit still rate-limited after {RETRY_TRIES} retries; run `gym plan push --apply` '
                                'again later (it resumes)')
            raise PlanError(self.scrub(f'{method} {path} -> HTTP {status}' + (f': {err}' if err else '')))
        return payload.get('data') if isinstance(payload, dict) and 'data' in payload else payload

    def snapshot(self):
        rows = self.call('GET', '/api/v2/user/routines') or []
        return {r['id']: (r.get('name'), r.get('last_updated')) for r in rows if isinstance(r, dict)}

    def routine(self, rid):
        r = self.call('GET', f'/api/v2/routines/{rid}')
        if not isinstance(r, dict) or not re.fullmatch(ID_RE, str(r.get('id'))):
            raise PlanError('unexpected routine response')
        return r

    def adopt(self, r, name, mark=None):
        """Own a routine and everything under it, only when name (and marker) match."""
        if r.get('name') != name or (mark and mark not in (r.get('description') or '')):
            raise PlanError(f'routine {r.get("id")} is not "{name}" with the plan marker any more; not touching it')
        self.owned.add(r['id'])
        self.deletable.add(r['id'])
        for d in r.get('days') or []:
            self.owned.add(d['id'])
            self.owned.update(e['id'] for e in d.get('day_exercises') or [])


def sorted_days(r):
    return sorted(r.get('days') or [], key=lambda d: (d.get('week') or 0, d.get('index') or 0, d.get('sort_order') or 0))


def sorted_exs(d):
    return sorted(d.get('day_exercises') or [], key=lambda e: (e.get('index') or 0, e.get('sort_order') or 0))


def live_ids(r):
    ids = {'R': r['id']}
    for i, d in enumerate(sorted_days(r), 1):
        ids[f'D{i}'] = d['id']
        for j, e in enumerate(sorted_exs(d), 1):
            ids[f'D{i}E{j}'] = e['id']
    return ids


def verify_live(r, target, mark=PLAN_MARK):
    """-> list of differences between the live routine and the target (empty = matches)."""
    diff = []
    if r.get('name') != target['routine']['name'] or mark not in (r.get('description') or ''):
        diff.append('name/description')
    days = sorted_days(r)
    if len(days) != len(target['days']):
        return diff + [f'{len(days)} days, want {len(target["days"])}']
    for d, t in zip(days, target['days']):
        exs = sorted_exs(d)
        if d.get('name') != t['name']:
            diff.append(f'day name {d.get("name")!r}')
        got = [str((e.get('exercise') or {}).get('id')) for e in exs]
        if got != [x['exercise_id'] for x in t['exercises']]:
            diff.append(f'{t["name"]}: exercises differ')
            continue
        for e, x in zip(exs, t['exercises']):
            sets = sorted(e.get('sets') or [], key=lambda s: s.get('index') or 0)
            if e.get('count') != x['count'] or len(sets) != x['count']:
                diff.append(f'{x["name"]}: {len(sets)} sets, want {x["count"]}')
            elif any(s.get('reps') != w['reps'] or abs((s.get('weight_lbs') or 0) - (w['weight_lbs'] or 0)) > 0.01
                     for s, w in zip(sets, x['sets'])):
                diff.append(f'{x["name"]}: set values differ')
    return diff


def run_test_sequence(w, first_ex_id, keep=(), names=(TEST_NAME, PLAN_NAME)):
    """Create "Assistant test", read it back, write one set, delete it, and check his routines are unchanged."""
    before = w.snapshot()
    if any(n in names and rid not in keep for rid, (n, _) in before.items()):
        raise PlanError(f'a routine named "{names[0]}" or "{names[1]}" already exists that this tool did not '
                        'record; not touching it (rename or delete it in Jefit first)')
    t = w.call('POST', '/api/v2/user/routines', {'create_day': True}) or {}
    tid = str(t.get('id'))
    if not re.fullmatch(ID_RE, tid) or tid in before:
        raise PlanError('create did not return a new routine id')
    w.owned.add(tid)
    w.deletable.add(tid)
    w.call('PATCH', f'/api/v2/routines/{tid}', {'data': {'name': TEST_NAME}})
    r = w.routine(tid)
    w.adopt(r, TEST_NAME)
    days = sorted_days(r)
    if not days:
        raise PlanError('test routine came back without a day')
    reqs = test_requests(first_ex_id)
    de = w.call('POST', f'/api/v2/days/{days[0]["id"]}/day_exercises', reqs[4][2]) or {}
    if not re.fullmatch(ID_RE, str(de.get('id'))):
        raise PlanError('adding an exercise did not return an id')
    w.owned.add(de['id'])
    w.call('PATCH', f'/api/v2/day_exercises/{de["id"]}', reqs[5][2])
    got = w.call('GET', f'/api/v2/day_exercises/{de["id"]}') or {}
    sets = got.get('sets') or []
    want = reqs[5][2]['data']['sets'][0]['weight_lbs']
    if len(sets) != 1 or abs((sets[0].get('weight_lbs') or 0) - want) > 0.01 or sets[0].get('reps') != 5:
        raise PlanError('test set did not read back as written (1 x 5 @ 80 kg); test routine left for inspection')
    w.call('DELETE', f'/api/v2/routines/{tid}')
    after = w.snapshot()
    if tid in after:
        raise PlanError('test routine still listed after DELETE')
    if after != before:
        raise PlanError('his routine list changed during the test (not by this tool?); stopping')
    return before


def plan_load():
    plan = read_json(PLAN_FILE)
    if not plan:
        raise PlanError('no plan yet: run `gym plan draft` first')
    return plan


def created_routine_ids(path=None):
    """Routine ids this tool created, from its journal: `new_id` on the create line; older lines without it:
    the routine PATCHed right after a successful create (the naming PATCH)."""
    ids, after_create = set(), False
    try:
        with open(path or PUSH_LOG) as fh:
            lines = fh.read().splitlines()
    except OSError:
        return ids
    for ln in lines:
        try:
            j = json.loads(ln)
        except ValueError:
            continue
        if not isinstance(j, dict):
            continue
        if re.fullmatch(ID_RE, str(j.get('new_id'))):
            ids.add(j['new_id'])
        m = re.fullmatch(rf'/api/v2/routines/({ID_RE})', str(j.get('path')))
        if after_create and j.get('method') == 'PATCH' and m:
            ids.add(m.group(1))
        after_create = (j.get('method') == 'POST' and j.get('path') == '/api/v2/user/routines'
                        and 200 <= (j.get('status') or 0) < 300)
    return ids


def req_rows(ops, step='plan'):
    return [dict(zip(('method', 'path', 'body'), op_request(o)), step=step) for o in ops]


def push_plan(plan, apply=False, rebuild=False, out=None, kind='plan'):
    """Dry run (default): the exact requests, no HTTP. --apply: delete leftover routines this tool created, the
    test sequence on the first write, then the diff (or the rest of a push that stopped half-way). `kind` picks
    the routine (routine_profile): a push only ever names, adopts, deletes or diffs that routine (and its own test
    routine); "Assistant plan" and "Assistant travel" never touch each other."""
    prof = routine_profile(kind)
    rname, mark = prof['name'], prof['mark']
    target, pushed = plan_target(plan, prof), read_json(prof['pushed']) or {}
    if not all(x['exercise_id'] for d in target['days'] for x in d['exercises']):
        raise PlanError('an exercise has no Jefit id (CSV-only history); swap it or run `gym sync`')
    needs_test = not any((read_json(f) or {}).get('verified') for f in (PUSHED_FILE, TRAVEL_PUSHED_FILE))
    resume = bool(pushed.get('routine_id')) and pushed.get('status') != 'complete' and not rebuild
    first_ex = target['days'][0]['exercises'][0]['exercise_id']
    ops = plan_ops(target, pushed, rebuild)
    tests = [{'method': m, 'path': p, 'body': b, 'step': 'test'} for m, p, b in test_requests(first_ex)]
    res = {'dry_run': not apply, 'routine': rname, 'cmd': prof['cmd'], 'test_sequence': needs_test, 'resume': resume,
           'requests': (tests if needs_test else []) + req_rows(ops)}
    if not apply:
        return res
    try:
        token, handle = read_token_file(TOKEN_RW_FILE), None
        if not token:                               # the read token (it has write scope): by handle when live
            token, handle = (read_api_token(), 'gym') if egress_read() else (read_token(), None)
    except PermissionError as e:
        raise PlanError(str(e))
    if not token:
        raise PlanError(f'no Jefit token ({TOKEN_RW_FILE} or {TOKEN_FILE})' if not egress_read() else
                        f'{no_token_hint()} (and no {TOKEN_RW_FILE})')
    w = PlanWriter(api_config(), token, handle=handle)
    rid = pushed.get('routine_id')
    cleaned, done = [], []
    res.update(cleaned=cleaned, requests=done)
    try:
        before = w.snapshot()
        mine = created_routine_ids() | ({rid} if rid else set())
        for oid, (name, _) in before.items():          # leftovers of earlier runs: only ones this tool created
            if name in (rname, TEST_NAME) and oid != rid and oid not in mine:
                raise PlanError(f'a routine named "{name}" exists that this tool did not create; not touching it '
                                '(rename or delete it in Jefit first)')
        for oid, (name, _) in before.items():
            if name in (rname, TEST_NAME) and oid != rid:
                w.adopt(w.routine(oid), name, mark if name == rname else None)
                w.call('DELETE', f'/api/v2/routines/{oid}')
                cleaned.append(name)
                done.append({'method': 'DELETE', 'path': '/api/v2/routines/{leftover}', 'body': None,
                             'step': 'cleanup'})
        gone = {oid for oid, (n, _) in before.items() if n in (rname, TEST_NAME) and oid != rid}
        state = dict(pushed)
        if needs_test:
            run_test_sequence(w, first_ex, keep={rid} if rid else (), names=(TEST_NAME, rname))
            done.extend(tests)
            state['verified'] = dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')
            write_private_json(prof['pushed'], state)
        ids = {}
        if rid and rid in before:
            r = w.routine(rid)
            w.adopt(r, rname, mark)
            if rebuild:
                ids['R_old'] = rid
            elif pushed.get('status') == 'complete':
                ids = live_ids(r)
                if [k for k, v in (pushed.get('ids') or {}).items() if ids.get(k) != v]:
                    raise PlanError(f'the routine "{rname}" was changed in Jefit since the last push; '
                                    f'run `{prof["cmd"]} --rebuild --apply`')
            else:                                       # stopped half-way: diff against what is really there
                ids = live_ids(r)
                ops = plan_ops(target, pushed, live=live_target(r))
        elif rid and pushed.get('status') == 'complete' and not rebuild:
            raise PlanError(f'the routine "{rname}" is gone in Jefit; run `{prof["cmd"]} --rebuild --apply`')
        else:
            resume = False
            ops = [o for o in plan_ops(target, {}) if o[0] != 'delete_routine']
        res['resume'] = resume
        for op in ops:
            m, p, body = op_request(op)
            path = re.sub(r'\{(\w+)\}', lambda x: ids[x.group(1)], p)
            data = w.call(m, path, body)
            done.extend(req_rows([op]))
            if op[0] == 'create_routine':
                nid = str((data or {}).get('id'))
                if not re.fullmatch(ID_RE, nid) or nid in before:
                    raise PlanError('create did not return a new routine id')
                ids['R'] = nid
                w.owned.add(nid)
                w.deletable.add(nid)
                state.update(status='incomplete', routine_id=nid)
                write_private_json(prof['pushed'], state)
                days = sorted_days(data) or sorted_days(w.routine(nid))
                if not days:
                    raise PlanError('new routine came back without a day')
                ids['D1'] = days[0]['id']
                w.owned.add(days[0]['id'])
            elif op[0] in ('add_day', 'add_ex'):
                nid = str((data or {}).get('id'))
                if not re.fullmatch(ID_RE, nid):
                    raise PlanError(f'{m} {p} did not return an id')
                ids[op[1] if op[0] == 'add_day' else op[2]] = nid
                w.owned.add(nid)
            elif op[0] == 'delete_routine':
                state.update(status='incomplete', routine_id=None)
                write_private_json(prof['pushed'], state)
        live = w.routine(ids['R'])
        diff = verify_live(live, target, mark)
        if diff:
            state.update(status='mismatch', routine_id=ids['R'])
            write_private_json(prof['pushed'], state)
            raise PlanError('Jefit routine does not match the plan after the push: ' + '; '.join(diff[:5]))
        after = w.snapshot()
        ours = {ids.get('R'), ids.get('R_old')} | gone
        others = {k: v for k, v in after.items() if k not in ours}
        mine_before = {k: v for k, v in before.items() if k not in ours}
        state.update(status='complete', routine_id=ids['R'], ids=live_ids(live), target=target,
                     plan_version=plan['version'], pushed_at=dt.datetime.now(dt.timezone.utc).isoformat(
                         timespec='seconds'))
        write_private_json(prof['pushed'], state)
        res['others_unchanged'] = others == mine_before
        if others != mine_before:
            raise PlanError('pushed, but his other routines changed meanwhile (not by this tool?); please check')
    finally:
        res.update(sent=len(w.sent), retries=w.retries, waited_s=round(w.waited, 1))
    res['created'] = resume or any(o[0] == 'create_routine' for o in ops)
    res['app_sync'] = any(m != 'GET' for m, _, _ in w.sent)      # changed in Jefit: the phone needs a Sync
    return res


def read_token_file(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    if st.st_mode & 0o077:
        raise PermissionError(f'{path} must be 0600 (chmod 600 it)')
    with open(path) as fh:
        return fh.read().strip() or None


def print_requests(res):
    reqs = res['requests']
    head = (f"Dry run: nothing sent. `{res.get('cmd', 'gym plan push')} --apply` would send" if res['dry_run']
            else 'Sent')
    print(f"{head} {len(reqs)} requests for the Jefit routine \"{res['routine']}\" (ids shown as {{symbols}}).")
    if res['dry_run'] and res.get('resume'):
        print('Resume: the last push stopped half-way. --apply reads that routine and sends only what is still '
              'missing or different (at most the list below, without the create).')
    step = None
    for r in reqs:
        if r['step'] != step:
            step = r['step']
            print({'test': 'First write only: safe test (create "Assistant test", read back, delete, compare his '
                           'routines):',
                   'cleanup': 'Leftover routines this tool created earlier:'}.get(step, 'Plan routine:'))
        body = '' if r['body'] is None else ' ' + json.dumps(r['body'], ensure_ascii=False, separators=(',', ':'))
        print(f"  {r['method']:<6} {r['path']}{body}")
    if not reqs:
        print('  (Jefit already matches the plan)')


def exposures(conn, name, since):
    out = {}
    q = ('SELECT x.date, s.weight_kg, s.reps FROM sets s JOIN exercise_logs l ON l.id=s.log_id JOIN exercises e '
         'ON e.id=l.exercise_id JOIN sessions x ON x.id=l.session_id WHERE e.name=? AND x.date > ? '
         'ORDER BY x.date, x.start_ts, s.idx')
    for date, w, reps in conn.execute(q, (name, since)):
        out.setdefault(date, []).append((w or 0.0, reps))
    return sorted(out.items())


def progress(x, exps):
    """Double progression over the sessions since the last update -> (changes, new x)."""
    x, why = dict(x), []
    for date, sets in exps:
        if x.get('weight_kg'):
            first = [r or 0 for w, r in sets if w >= 0.95 * x['weight_kg'] - 0.01][:x['sets']]
            full = len(first) >= x['sets']
            if full and all(r >= x['hi'] for r in first):
                x['weight_kg'] = round(x['weight_kg'] + x['inc_kg'], 2)
                x.update(reps=x['lo'], fails=0, stalls=0)
                why.append(f"{ddmm(date)} top of the range on every set: +{fmt_kg(x['inc_kg'])} kg")
            elif full and first[0] >= x['lo'] and all(r >= x['reps'] for r in first):
                x.update(reps=min(x['hi'], x['reps'] + 1), fails=0, stalls=0)
            else:
                x['fails'] = x.get('fails', 0) + 1 if (not first or first[0] < x['lo']) else 0
                x['stalls'] = x.get('stalls', 0) + 1
                if x['fails'] >= 2:
                    step = x.get('step_kg') or 2.5
                    x['weight_kg'] = max(step, math.floor(round(x['weight_kg'] * 0.9 / step, 3)) * step)
                    x.update(reps=x['lo'], fails=0, stalls=0)
                    why.append(f'{ddmm(date)} below {x["lo"]} reps twice: -10 %')
        else:
            first = [r or 0 for _, r in sets][:x['sets']]
            if len(first) >= x['sets'] and all(r >= x['reps'] for r in first) and x['reps'] < x['hi']:
                x.update(reps=x['reps'] + 1, stalls=0)
            else:
                x['stalls'] = x.get('stalls', 0) + 1
    return why, x


def update_plan(conn, plan, end):
    """New plan version from the sessions since the last update: progression, swaps for stalls and skips."""
    since, new, changes = plan['updated'], json.loads(json.dumps(plan)), []
    ret = read_json(RETURN_FILE) or {}
    if ret.get('applied') and str(ret.get('to') or '') > since:     # reduced weights on purpose: not a stall
        since = min(str(ret['to']), end.isoformat())
    pool = plan_pool(conn, end)
    used = {x['name'] for d in plan['days'] for x in d['exercises']}
    sess = conn.execute('SELECT id, date, duration_s FROM sessions WHERE date > ? ORDER BY date', (since,)).fetchall()
    names_by_session = {}
    for sid, name in conn.execute('SELECT l.session_id, e.name FROM exercise_logs l JOIN exercises e ON '
                                  'e.id=l.exercise_id JOIN sessions x ON x.id=l.session_id WHERE x.date > ?',
                                  (since,)):
        names_by_session.setdefault(sid, set()).add(name)
    for d in new['days']:
        day_names = {x['name'] for x in d['exercises']}
        for i, x in enumerate(d['exercises']):
            exps = exposures(conn, x['name'], since)
            why, nx = progress(x, exps)
            changes += [f"{x['name']}: {w}" for w in why]
            if (nx['reps'], nx.get('weight_kg')) != (x['reps'], x.get('weight_kg')) and not why:
                changes.append(f"{x['name']}: target {nx['reps']} reps")
            skipped = sum(1 for sid, _, _ in sess if x['name'] not in names_by_session.get(sid, set())
                          and len(names_by_session.get(sid, set()) & (day_names - {x['name']})) >= 2)
            reason = 'stalled 3 sessions' if nx.get('stalls', 0) >= 3 else 'skipped 3 sessions' \
                if not exps and skipped >= 3 else None
            if reason:
                alt = plan_pick(x['slot'], pool, used, exclude=used)
                if alt:
                    used.add(alt['name'])
                    nx = dict(plan_exercise(x['slot'], alt, x['role'], plan['goal'], x['group']))
                    changes.append(f"{x['name']} → {alt['name']} ({reason})")
                else:
                    changes.append(f"{x['name']}: {reason}, no alternative in your log; keep it")
                    nx['stalls'] = 0
            d['exercises'][i] = nx
        relabel(d['exercises'])
        d['est_min'] = est_minutes(d['exercises'])
    durs = sorted(s[2] / 60 for s in sess if s[2])
    notes = []
    if len(durs) >= 3:
        med = durs[len(durs) // 2]
        if med > plan['minutes'] + 10:
            notes.append(f'sessions run ~{round(med)} min (budget {plan["minutes"]}): consider dropping a set')
    weeks = (end - dt.date.fromisoformat(plan['created'])).days // 7
    if weeks and weeks % 6 == 5:
        notes.append('next week: deload (2 sets per exercise at -10 %)')
    new['volume'] = plan_volume(new['days'])
    new['notes'] = notes
    if changes:
        new['version'] = plan['version'] + 1
    new['updated'] = end.isoformat()
    return new, changes, len(sess)


# ----------------------------------------------------------------------------- plan: travel / return
# Travel plan: no equipment (a band or a bar only when he has one), Jefit catalogue exercises (ids checked against the
# live GET /api/v2/exercises) standing in for the slots of his main plan. Stored apart (TRAVEL_FILE) and pushed as
# its own routine TRAVEL_NAME; "Assistant plan" stays as it is.
# slot -> candidates (name, Jefit id, kit or None, muscle, secondary, sets, lo, hi, rest s, role, cue); the first whose
# kit he has wins, the next one when it is already on that day
TRAVEL_EX = {
    'squat': [('Split Squat', 'd_000000001341', None, 'quads', ('glutes', 'hamstrings'), 3, 8, 12, 90, 'main',
               'per leg; rear foot on a chair or the bed = Bulgarian, 3-s lowering')],
    'lunge': [('Bodyweight Rear Lunge', 'd_000000001219', None, 'quads', ('glutes',), 3, 10, 15, 60, 'acc',
               'per leg; step back long, knee just above the floor')],
    'quad2': [('Jump Squat', 'd_000000000476', None, 'quads', ('glutes', 'calves'), 3, 6, 8, 60, 'acc',
               'crisp jumps, soft landings: keeps the power')],
    'hinge': [('Single-Leg Glute Bridge', 'd_000000000865', None, 'glutes', ('hamstrings',), 3, 10, 15, 60, 'acc',
               'per leg; 2-s squeeze at the top, heel on the bed edge = harder')],
    'hpush': [('Push-Up', 'd_000000000047', None, 'chest', ('triceps', 'shoulders'), 3, 8, 15, 90, 'main',
               'too easy: feet on the bed, then 3-s lowering')],
    'vpush': [('Band Shoulder Press', 'd_000000000445', 'band', 'shoulders', ('triceps',), 3, 8, 15, 60, 'main',
               'stand on the band'),
              ('Handstand Push-Up', 'd_000000000875', None, 'shoulders', ('triceps',), 3, 4, 8, 90, 'main',
               'pike version first (feet on the bed, hips high), wall-supported when that is easy')],
    'vpull': [('Pull-Up', 'd_000000000083', 'bar', 'back', ('biceps',), 3, 4, 8, 90, 'main',
               'any bar: playground, beach gym, door-frame bar'),
              ('Back Extension (Prone)', 'd_000000000337', None, 'back', ('glutes',), 3, 12, 15, 60, 'acc',
               'arms in a Y, 2-s hold at the top')],
    'hpull': [('Band Reverse Fly', 'd_000000000053', 'band', 'back', ('shoulders',), 3, 12, 20, 60, 'acc',
               'band at chest height, squeeze the shoulder blades'),
              ('Back Extension (Prone)', 'd_000000000337', None, 'back', ('glutes',), 3, 12, 15, 60, 'acc',
               'arms in a Y, 2-s hold at the top')],
    'triceps': [('Bench Dip', 'd_000000000229', None, 'triceps', ('chest', 'shoulders'), 2, 10, 15, 60, 'small',
                 'hands on a chair or the bed edge')],
    'biceps': [('Band Alternating Bicep Curl', 'd_000000000283', 'band', 'biceps', (), 2, 12, 20, 45, 'small', '')],
    'delt': [('Band Lateral Raise', 'd_000000000422', 'band', 'shoulders', (), 2, 12, 20, 45, 'small', '')],
    'calves': [('Single-Leg Calf Raise', 'd_000000001236', None, 'calves', (), 2, 12, 20, 45, 'small',
                'on a step, full stretch at the bottom')],
    'core': [('Reverse Crunch', 'd_000000000338', None, 'abs', (), 2, 12, 20, 45, 'small', ''),
             ('V-Up', 'd_000000000686', None, 'abs', (), 2, 10, 15, 45, 'small', '')],
}
# travel slot -> (slot of his main plan whose lift it stands in for, generic name without a plan)
TRAVEL_FOR = {'squat': ('squat', 'squat'), 'lunge': ('quad2', 'leg press'), 'quad2': ('quad2', 'leg press'),
              'hinge': ('hinge', 'deadlift'), 'hpush': ('hpush', 'bench press'), 'vpush': ('vpush', 'overhead press'),
              'vpull': ('vpull', 'pulldown'), 'hpull': ('hpull', 'row'), 'triceps': ('triceps', 'triceps'),
              'biceps': ('biceps', 'biceps'), 'delt': ('delt', 'lateral raise'), 'calves': ('calves', 'calves'),
              'core': ('core', 'core')}
# days/week -> [(key, title, items)]; a tuple = circuit (a/b/c, rest after the round); slots without a fitting
# exercise for his kit are left out
TRAVEL_TEMPLATES = {
    2: [('A', 'Travel A', ['squat', 'hpush', ('vpull', 'hinge'), ('triceps', 'delt', 'core')]),
        ('B', 'Travel B', ['vpush', 'quad2', ('hpull', 'lunge'), ('hinge', 'calves', 'biceps', 'core')])],
    3: [('A', 'Travel A', ['squat', 'hpush', ('vpull', 'hinge'), ('triceps', 'delt', 'core')]),
        ('B', 'Travel B', ['vpush', 'quad2', ('hpull', 'lunge'), ('calves', 'biceps')]),
        ('C', 'Travel C', ['squat', 'hpush', ('vpull', 'hinge'), ('calves', 'core')])],
}
TRAVEL_TRIM = ('calves', 'delt', 'biceps', 'core', 'triceps')
TRAVEL_RULE = ('Maintenance: every set stops 1-2 reps short of failure. At the top of the range on every set, make '
               'it harder next time (3-s lowering, a pause, feet raised, single-leg) instead of adding reps. a/b/c = '
               'circuit: go straight through, rest after the round. A few weeks like this keep strength; '
               '`gym plan return` rebuilds the load after.')
# week, share of his last logged working weight, sets vs the plan (at least 2)
RETURN_WEEKS = ((1, 0.85, -1), (2, 0.90, 0))


def next_trip(day):
    """-> {name, from, to} of the trip under way or next in trip-conditions' trips.json (GYM_TRIPS), or None."""
    data = read_json(TRIPS_FILE)
    trips = data.get('trips') if isinstance(data, dict) else data
    found = []
    for t in (trips.values() if isinstance(trips, dict) else trips or []):
        if not isinstance(t, dict):
            continue
        try:
            a = dt.date.fromisoformat(str(t.get('from')))
            b = dt.date.fromisoformat(str(t.get('to') or t.get('from')))
        except ValueError:
            continue
        if b >= day:
            found.append((a, b, str(t.get('name') or 'trip')))
    if not found:
        return None
    a, b, n = min(found)
    return {'name': n, 'from': a.isoformat(), 'to': b.isoformat()}


def travel_exercise(slot, t, group, pool_by_id, lifts):
    name, jid, kit, mus, sec, sets, lo, hi, rest, role, cue = t
    e = pool_by_id.get(jid)
    if e and e.get('best_reps'):
        reps, basis = min(hi, max(lo, int(e['best_reps'] * 0.75))), f"your best {e['best_reps']} reps ({ddmm(e['last'])})"
    else:
        reps, basis = lo, 'new: start at the bottom of the range'
    plan_slot, generic = TRAVEL_FOR[slot]
    return {'slot': slot, 'name': name, 'jefit_id': jid, 'muscle': mus, 'secondary': list(sec),
            'equipment': kit or 'bodyweight', 'role': role, 'group': group, 'sets': sets, 'lo': lo, 'hi': hi,
            'reps': reps, 'rest_s': rest, 'pair_rest_s': rest, 'weight_kg': None, 'inc_kg': 0.0, 'step_kg': 0.0,
            'basis': basis, 'cue': cue, 'for': lifts.get(plan_slot) or generic, 'stalls': 0, 'fails': 0}


def build_travel(conn, start, end, days, minutes, kit, day, trip_name=None):
    """Bodyweight plan for a trip: TRAVEL_TEMPLATES filled from TRAVEL_EX for his kit, trimmed to the time budget;
    reps from his own log when he has done the exercise, else the bottom of the range."""
    pool = plan_pool(conn, day)
    by_id = {e['jefit_id']: e for e in pool.values() if e.get('jefit_id')}
    lifts = {}
    for d in (read_json(PLAN_FILE) or {}).get('days') or []:
        for x in d.get('exercises') or []:
            lifts.setdefault(x.get('slot'), short_name(x.get('name')))
    out, notes = [], []
    for key, title, items in TRAVEL_TEMPLATES[days]:
        exs = []
        for gi, it in enumerate(items, 1):
            for slot in (it if isinstance(it, tuple) else (it,)):
                fits = [t for t in TRAVEL_EX[slot] if t[2] is None or t[2] in kit]
                t = next((t for t in fits if t[0] not in {x['name'] for x in exs}), None)
                if t:
                    exs.append(travel_exercise(slot, t, gi, by_id, lifts))
        relabel(exs)
        for slot in TRAVEL_TRIM:
            if est_minutes(exs) <= minutes + 5:
                break
            drop = [x for x in exs if x['slot'] == slot]
            if drop:
                exs.remove(drop[-1])
                notes.append(f'{key}: {drop[-1]["name"]} left out to stay near {minutes} min')
                relabel(exs)
        mains = [short_name(x['name']) for x in exs if x['role'] == 'main']
        out.append({'key': key, 'name': f'{key} · ' + (' + '.join(mains) if mains else title), 'exercises': exs,
                    'est_min': est_minutes(exs)})
    n_days = (end - start).days + 1
    sessions = max(1, round(n_days / 7 * days))
    if 'band' not in kit:
        notes.append('a resistance band (pocket-sized) adds rows, curls, laterals and presses: `--band`')
    if 'bar' not in kit:
        notes.append('a pull-up bar nearby (playground, beach gym): `--bar` puts Pull-Ups in for the back extensions')
    now = (analyze(conn, weeks=4, end=day).get('hard_sets_per_week_4w') or {}) if pool else {}
    return {'version': 1, 'kind': 'travel', 'name': TRAVEL_NAME, 'created': day.isoformat(),
            'updated': day.isoformat(), 'goal': 'maintain', 'days_per_week': days, 'minutes': minutes,
            'kit': sorted(kit), 'trip': {'name': trip_name, 'from': start.isoformat(), 'to': end.isoformat(),
                                         'days': n_days, 'sessions': sessions},
            'days': out, 'volume': plan_volume(out), 'volume_now': {k: round(v, 1) for k, v in now.items()},
            'notes': notes, 'rule': TRAVEL_RULE}


def travel_card(plan):
    t = plan['trip']
    keys = [d['key'] for d in plan['days']]
    order = ' '.join(keys[i % len(keys)] for i in range(t['sessions']))
    lines = plan_card(plan).split('\n')
    lines.insert(1, f"{(t.get('name') or 'Trip')} {ddmm(t['from'])}–{ddmm(t['to'])} ({t['days']} days): "
                    f"~{t['sessions']} sessions {order}, 2+ days apart · kit: {', '.join(plan['kit']) or 'none'}")
    return '\n'.join(lines)


def travel_load():
    plan = read_json(TRAVEL_FILE)
    if not plan:
        raise PlanError('no travel plan yet: run `gym plan travel` first')
    return plan


def last_working(conn, name, end):
    """-> (date, top weight kg, its reps) of the last logged session of an exercise on or before `end`."""
    exps = [(d, s) for d, s in exposures(conn, name, '0000-00-00') if d <= end.isoformat()]
    if not exps:
        return None
    date, sets = exps[-1]
    w, r = max(sets, key=lambda s: (s[0] or 0, s[1] or 0))
    return date, w or 0.0, r


def build_return(conn, plan, start):
    """Re-entry after a trip: week 1 at -15 % of his last logged working weight (best e1RM of his last 3 sessions
    before the trip, at the plan's reps) with one set less, week 2 at -10 %, never above the plan's weight;
    week 3 = the plan itself."""
    weeks, rows = [], {}
    pool = plan_pool(conn, start - dt.timedelta(days=1))
    for wk, f, dsets in RETURN_WEEKS:
        p = json.loads(json.dumps(plan))
        for d in p['days']:
            for x in d['exercises']:
                last = last_working(conn, x['name'], start - dt.timedelta(days=1))
                e1rm = (pool.get(x['name']) or {}).get('e1rm')
                plan_w = x.get('weight_kg')
                x['sets'] = max(2, x['sets'] + dsets)
                if plan_w:      # his last 3 sessions' best e1RM at the plan's mid-range reps, 2 in reserve
                    ref = e1rm / (1 + ((x['lo'] + x['hi']) / 2 + 2) / 30) if e1rm else plan_w
                    step = x.get('step_kg') or 2.5
                    x['weight_kg'] = max(step, min(plan_w, math.floor(round(ref * f / step, 3)) * step))
                if wk == 1:
                    x['reps'] = x['lo']
                basis = (f"e1RM {fmt_kg(e1rm)}, last {fmt_kg(last[1])} × {last[2]} {ddmm(last[0])}"
                         if last and last[1] and e1rm and plan_w else
                         f"last {last[2]} reps ({ddmm(last[0])})" if last else 'not logged: plan weight')
                rows.setdefault((d['key'], x['label'], x['name']), {'plan_w': plan_w, 'plan_sets': None,
                                                                   'basis': basis, 'weeks': []})
                rows[(d['key'], x['label'], x['name'])]['weeks'].append((x['sets'], x['reps'], x.get('weight_kg')))
            relabel(d['exercises'])
            d['est_min'] = est_minutes(d['exercises'])
        a = start + dt.timedelta(days=7 * (wk - 1))
        p['volume'] = plan_volume(p['days'])
        p['notes'] = []
        p['rule'] = (f'Return week {wk} of {len(RETURN_WEEKS)} ({int(round((1 - f) * 100))} % under the last '
                     'working weights). ' + plan['rule'])
        weeks.append({'week': wk, 'from': a.isoformat(), 'to': (a + dt.timedelta(days=6)).isoformat(), 'share': f,
                      'plan': p})
    for d in plan['days']:
        for x in d['exercises']:
            r = rows.get((d['key'], x['label'], x['name']))
            if r:
                r['plan_sets'], r['plan_reps'] = x['sets'], x['reps']
    return {'version': 1, 'created': today().isoformat(), 'from': start.isoformat(),
            'to': (start + dt.timedelta(days=7 * len(RETURN_WEEKS) - 1)).isoformat(),
            'base_version': plan['version'], 'weeks': weeks, 'applied': {},
            'rows': [{'day': k[0], 'label': k[1], 'name': k[2], **v} for k, v in rows.items()]}


def return_card(ret, plan):
    def w(s, r, kg):
        return f"{s}×{r}" + (f" @ {fmt_kg(kg)}" if kg else '')
    lines = [f"Return after the trip: {ddmm(ret['from'])}–{ddmm(ret['to'])}, then \"{PLAN_NAME}\" v{plan['version']}"
             ' as it is']
    for x in ret['weeks']:
        lines.append(f"Week {x['week']} ({ddmm(x['from'])}–{ddmm(x['to'])}): -{int(round((1 - x['share']) * 100))} %"
                     f" on the last working weights" + (', one set less' if x['week'] == 1 else ', full sets'))
    day = None
    for r in ret['rows']:
        if r['day'] != day:
            day = r['day']
            lines.append(next(d['name'] for d in plan['days'] if d['key'] == day))
        wk = ' · '.join(f"wk{i} {w(*v)}" for i, v in enumerate(r['weeks'], 1))
        lines.append(f"  {r['label']:<3}{r['name']}  {wk} → plan {w(r['plan_sets'], r['plan_reps'], r['plan_w'])}"
                     f"  ({r['basis']})")
    lines.append('Week 3: the plan weights; double progression resumes (`gym plan update` skips applied return '
                 'weeks).')
    applied = ', '.join(f'week {k} {v[:10]}' for k, v in sorted((ret.get('applied') or {}).items()))
    lines.append(f'Jefit: applied {applied}.' if applied else
                 f'Draft only. `gym plan return --apply --week 1` writes week 1 into "{PLAN_NAME}" (his OK first); '
                 'week 2 the same; `gym plan push --apply` puts the plan back.')
    lines.append('Suggestions only, not medical advice.')
    return '\n'.join(lines)


def cmd_travel(a):
    start, end, name = a.from_, a.to, None
    if not (start and end):
        trip = next_trip(today())
        if not trip:
            raise PlanError('no trip dates: give --from and --to (no trip ahead in ' + TRIPS_FILE + ')')
        start = start or dt.date.fromisoformat(trip['from'])
        end = end or dt.date.fromisoformat(trip['to'])
        name = trip['name']
    if end < start:
        raise PlanError('trip dates: --to is before --from')
    if not 20 <= a.minutes <= 60:
        raise PlanError('--minutes must be 20-60')
    kit = {k for k, on in (('band', a.band), ('bar', a.bar)) if on}
    plan = build_travel(connect(), start, end, a.days_per_week, a.minutes, kit, today(), name)
    if not a.dry_run:
        old = read_json(TRAVEL_FILE)
        if old:
            plan['version'] = old.get('version', 0) + 1
        write_private_json(TRAVEL_FILE, plan)
    print(json.dumps(plan) if a.json else travel_card(plan) + ('' if a.dry_run else f'\nSaved: {TRAVEL_FILE}'))
    return 0


def cmd_return(a):
    plan = plan_load()
    start = a.from_
    if not start:
        t = (read_json(TRAVEL_FILE) or {}).get('trip') or next_trip(today()) or {}
        if not t.get('to'):
            raise PlanError('no trip dates: give --from (the first day back)')
        start = dt.date.fromisoformat(t['to']) + dt.timedelta(days=1)
    ret = build_return(connect(), plan, start)
    old = read_json(RETURN_FILE) or {}
    if old.get('from') == ret['from'] and old.get('base_version') == ret['base_version']:
        ret['applied'] = old.get('applied') or {}
    res = None
    if a.apply:
        wk = a.week or next((x['week'] for x in ret['weeks'] if x['from'] <= today().isoformat() <= x['to']), 1)
        res = push_plan(next(x['plan'] for x in ret['weeks'] if x['week'] == wk), apply=True, kind='plan')
        ret['applied'][str(wk)] = dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')
    if not a.dry_run or a.apply:
        write_private_json(RETURN_FILE, ret)
    if a.json:
        print(json.dumps(dict(ret, push=res)))
        return 0
    print(return_card(ret, plan))
    if res:
        print_requests(res)
        print(f"Done: {res['sent']} writes. Jefit routine \"{PLAN_NAME}\" holds return week {wk}; "
              'his other routines unchanged.')
        if res.get('app_sync'):
            print(app_sync(PLAN_NAME))
    return 0


def cmd_plan(a):
    try:
        if a.plan_cmd == 'draft':
            swaps = {}
            for s in a.swap or []:
                old, sep, newn = s.partition('=')
                if not sep or not old.strip() or not newn.strip():
                    print('gym plan draft: --swap takes "Old name=New name"', file=sys.stderr)
                    return 2
                swaps[old.strip()] = newn.strip()
            plan = build_plan(connect(), a.days, a.goal, a.minutes, swaps, today())
            if not a.dry_run:
                old = read_json(PLAN_FILE)
                if old:
                    write_private_json(os.path.join(PLAN_HISTORY, f"plan-v{old.get('version', 0)}-"
                                                                  f"{old.get('updated', 'x')}.json"), old)
                    plan['version'] = old.get('version', 0) + 1
                write_private_json(PLAN_FILE, plan)
            print(json.dumps(plan) if a.json else plan_card(plan) + ('' if a.dry_run else
                                                                      f'\nSaved: {PLAN_FILE}'))
            return 0
        if a.plan_cmd == 'next':
            if a.json:
                print(json.dumps(plan_next_json(connect(), read_json(PLAN_FILE), today())))
                return 0
            print(plan_next(connect(), read_json(PLAN_FILE), today()) + evenings_line(today()))
            return 0
        if a.plan_cmd == 'travel':
            return cmd_travel(a)
        if a.plan_cmd == 'return':
            return cmd_return(a)
        if a.plan_cmd == 'show' and a.travel:
            plan, pushed = travel_load(), read_json(TRAVEL_PUSHED_FILE) or {}
            if a.json:
                print(json.dumps({'plan': plan, 'pushed': {k: pushed.get(k) for k in
                                                           ('status', 'plan_version', 'pushed_at')}}))
                return 0
            st = pushed.get('status')
            print(travel_card(plan) + '\nJefit: ' + (
                f"pushed v{pushed.get('plan_version')} {pushed['pushed_at'][:10]}" if st == 'complete' else
                'push stopped half-way (`gym plan push --travel --apply` resumes it)' if st in ('incomplete', 'mismatch')
                else 'not pushed yet (`gym plan push --travel`)'))
            return 0
        if a.plan_cmd == 'show':
            plan = plan_load()
            pushed = read_json(PUSHED_FILE) or {}
            if a.json:
                print(json.dumps({'plan': plan, 'pushed': {k: pushed.get(k) for k in
                                                           ('status', 'plan_version', 'pushed_at', 'verified')}}))
                return 0
            print(plan_card(plan))
            age = (today() - dt.date.fromisoformat(plan['updated'])).days
            st = pushed.get('status')
            jf = ('pushed v' + str(pushed.get('plan_version')) + ' ' + pushed['pushed_at'][:10] if st == 'complete'
                  else 'push stopped half-way (`gym plan push --apply` resumes it)' if st in ('incomplete', 'mismatch')
                  else 'not pushed yet')
            print(f"Jefit: {jf}"
                  f"; last update {ddmm(plan['updated'])}" + ('; review due (`gym plan update`)' if age >= 28 else ''))
            return 0
        if a.plan_cmd == 'push':
            kind = 'travel' if a.travel else 'plan'
            res = push_plan(travel_load() if a.travel else plan_load(), apply=a.apply, rebuild=a.rebuild, kind=kind)
            rname = res['routine']
            if a.json:
                print(json.dumps(res))
            else:
                print_requests(res)
                if a.travel and not a.apply:
                    print('After --apply: ' + app_sync(rname))
                if a.apply:
                    extra = [f"resumed the half-done push" if res.get('resume') else '',
                             f"deleted leftover {', '.join(res['cleaned'])}" if res.get('cleaned') else '',
                             f"{res['retries']} rate-limit retries ({res['waited_s']:.0f} s)" if res.get('retries')
                             else '']
                    extra = [x for x in extra if x]
                    print(f"Done: {res['sent']} writes" + (f" ({'; '.join(extra)})" if extra else '')
                          + f". Jefit routine \"{rname}\" matches the {'travel ' if a.travel else ''}plan; "
                          + 'his other routines unchanged.'
                          + ((f' Set it as the current plan in the app for the trip; switch back to "{PLAN_NAME}" '
                              'after.' if a.travel else ' Set it as the current plan once in the app.')
                             if res.get('created') else ''))
                    if res.get('app_sync'):
                        print(app_sync(rname))
            return 0
        if a.plan_cmd == 'update':
            plan = plan_load()
            new, changes, n = update_plan(connect(), plan, today())
            if a.write or a.apply:
                write_private_json(os.path.join(PLAN_HISTORY, f"plan-v{plan['version']}-{plan['updated']}.json"), plan)
                write_private_json(PLAN_FILE, new)
            res = push_plan(new, apply=a.apply)
            if a.json:
                print(json.dumps({'sessions': n, 'changes': changes, 'notes': new['notes'],
                                  'version': new['version'], 'saved': bool(a.write or a.apply), 'push': res}))
                return 0
            print(f"Plan update from {n} sessions since {ddmm(plan['updated'])}: "
                  + (f"{len(changes)} changes (v{plan['version']} → v{new['version']})" if changes else 'no changes'))
            for c in changes + [f'Note: {x}' for x in new['notes']]:
                print(f'  {c}')
            if not (a.write or a.apply):
                print('Not saved (add --write to keep it, --apply to keep it and push it).')
            print_requests(res)
            if res.get('app_sync'):
                print(APP_SYNC)
            return 0
    except PlanError as e:
        print(f'gym plan: {e}', file=sys.stderr)
        return 2 if 'plan yet' in str(e) or '--swap' in str(e) or 'trip dates' in str(e) \
            or '--minutes' in str(e) else 1
    print('gym plan: draft | show | next | push | update | travel | return (see --help)', file=sys.stderr)
    return 2


# ----------------------------------------------------------------------------- CLI
def date_arg(s):
    try:
        return dt.date.fromisoformat(s)
    except ValueError:
        raise argparse.ArgumentTypeError('use YYYY-MM-DD')


COACH_CMDS = ('recap',)     # the recap layer: ~/bin/lib/gymcoach.py


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] in COACH_CMDS:
        import types
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), 'lib'))
        import gymcoach
        return gymcoach.main(types.SimpleNamespace(**globals()), argv)
    p = argparse.ArgumentParser(prog='gym', description='Workout log engine (see the header of this file).')
    sub = p.add_subparsers(dest='cmd')
    pi = sub.add_parser('import')
    pi.add_argument('kind', choices=['csv'])
    pi.add_argument('file')
    pi.add_argument('--unit', choices=['kg', 'lb'])
    pi.add_argument('--dry-run', action='store_true')
    pi.add_argument('--json', action='store_true')
    ps = sub.add_parser('sync')
    ps.add_argument('--probe', action='store_true')
    ps.add_argument('--since', type=lambda s: date_arg(s).isoformat())
    ps.add_argument('--dry-run', action='store_true')
    ps.add_argument('--json', action='store_true')
    for name in ('stats', 'review', 'chart'):
        x = sub.add_parser(name)
        x.add_argument('--weeks', type=int, default=8 if name != 'chart' else 12)
        x.add_argument('--end', type=date_arg)
        if name == 'chart':
            x.add_argument('--out')
        else:
            x.add_argument('--json', action='store_true')
        if name == 'review':
            x.add_argument('--if-trained', type=int, metavar='DAYS')
    pe = sub.add_parser('exercises')
    pe.add_argument('--json', action='store_true')
    px = sub.add_parser('exercise')
    px.add_argument('name')
    px.add_argument('--muscle')
    px.add_argument('--equipment')
    px.add_argument('--reset', action='store_true')
    pp = sub.add_parser('plan')
    psub = pp.add_subparsers(dest='plan_cmd')
    pd = psub.add_parser('draft')
    pd.add_argument('--days', type=int, choices=sorted(TEMPLATES), default=2)
    pd.add_argument('--goal', choices=sorted(GOALS), default='mixed')
    pd.add_argument('--minutes', type=int, default=50)
    pd.add_argument('--swap', action='append', metavar='OLD=NEW')
    pd.add_argument('--dry-run', action='store_true')
    pd.add_argument('--json', action='store_true')
    psh = psub.add_parser('show')
    psh.add_argument('--travel', action='store_true')
    psh.add_argument('--json', action='store_true')
    pnx = psub.add_parser('next')
    pnx.add_argument('--json', action='store_true')
    ppu = psub.add_parser('push')
    ppu.add_argument('--travel', action='store_true')
    ppu.add_argument('--apply', action='store_true')
    ppu.add_argument('--rebuild', action='store_true')
    ppu.add_argument('--json', action='store_true')
    pup = psub.add_parser('update')
    pup.add_argument('--write', action='store_true')
    pup.add_argument('--apply', action='store_true')
    pup.add_argument('--json', action='store_true')
    ptr = psub.add_parser('travel')
    ptr.add_argument('--from', dest='from_', type=date_arg)
    ptr.add_argument('--to', type=date_arg)
    ptr.add_argument('--days-per-week', type=int, choices=sorted(TRAVEL_TEMPLATES), default=2)
    ptr.add_argument('--minutes', type=int, default=35)
    ptr.add_argument('--band', action='store_true')
    ptr.add_argument('--bar', action='store_true')
    ptr.add_argument('--dry-run', action='store_true')
    ptr.add_argument('--json', action='store_true')
    prt = psub.add_parser('return')
    prt.add_argument('--from', dest='from_', type=date_arg)
    prt.add_argument('--apply', action='store_true')
    prt.add_argument('--week', type=int, choices=[w for w, _, _ in RETURN_WEEKS])
    prt.add_argument('--dry-run', action='store_true')
    prt.add_argument('--json', action='store_true')
    pst = sub.add_parser('status')
    pst.add_argument('--json', action='store_true')
    a = p.parse_args(argv)
    if not a.cmd:
        p.print_help()
        return 2
    if a.cmd in ('stats', 'review', 'chart') and not 1 <= a.weeks <= 104:
        print('gym: --weeks must be 1-104', file=sys.stderr)
        return 2
    if a.cmd == 'exercise' and not a.reset and not a.muscle:
        print('gym exercise: give --muscle M (and optionally --equipment E) or --reset', file=sys.stderr)
        return 2
    fn = {'import': cmd_import_csv, 'sync': cmd_sync, 'stats': cmd_stats, 'review': cmd_review, 'chart': cmd_chart,
          'exercises': cmd_exercises, 'exercise': cmd_exercise, 'status': cmd_status, 'plan': cmd_plan}[a.cmd]
    return fn(a)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
