#!/usr/local/bin/python3.13 -I
"""hub: the claude-hub stack as the brain sees it: status, health, the install kit; `hub --help`.
Source: ~/opt/assistant (packages/hubkit; hub-side code in packages/hub, compose + pastes in ops/hub).

Finds its libraries next to itself: deployed, ~/bin/lib/{core,hubkit}; in the repo, ../core and ../packages/hubkit.
$ASSISTANT_LIB (a directory holding core/ and hubkit/) overrides both. Stdlib only.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_roots = [
    os.environ.get("ASSISTANT_LIB", ""),
    os.path.join(_here, "lib"),
    os.path.join(_here, ".."),
    os.path.join(_here, "..", "packages"),
]
for _pkg in ("core", "hubkit", "approvals"):
    for _r in _roots:
        if _r and os.path.isfile(os.path.join(_r, _pkg, "__init__.py")):
            _r = os.path.abspath(_r)
            if _r not in sys.path:
                sys.path.insert(0, _r)
            break

if __name__ == "__main__":
    from hubkit import cli

    try:
        sys.exit(cli.main())
    except BrokenPipeError:  # a reader that quit early (| head)
        sys.exit(0)
