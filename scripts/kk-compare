PROFILE = os.environ.get("KK_PROFILE") or os.path.join(HOME, ".config", "kk", "profile.json")
MAX_AGE_DAYS = 30
UA = "Mozilla/5.0 (X11; Linux x86_64) kk-compare/1.0"
BAG = "https://opendata.bagnet.ch/?r=/download&path="
