    "queued": ('"{t}" ist in der Download-Warteschlange und kommt bald.', '"{t}" is in the download queue and coming soon.'),
    "regrab": ('"{t}": der Download ist fehlgeschlagen, ein neuer ist angestossen. Kommt automatisch, sobald er durch ist.',
               '"{t}": the download failed, so a new one is started. It shows up by itself once it\'s done.'),
    "searching": ('"{t}" ist gefunden und wird gleich geladen. Sollte bald auf Emby sein.',
                  '"{t}" was found and is about to download. Should be on Emby soon.'),
    "retried": ('"{t}": die Anfrage hatte einen Fehler, sie ist neu gestartet.',
                '"{t}": the request hit an error and has been restarted.'),
    "not_released": ('"{t}" ist noch nicht digital erschienen{when_de}. Kommt automatisch, sobald es draussen ist.',
