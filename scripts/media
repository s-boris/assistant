              "guter", "gutes", "guten", "beste", "besten", "bester", "bestes", "toll", "tolle", "toller", "tolles"}
TN_MIN_FILM = 60           # movie picks run at least this long (half the time budget when that is shorter)
TN_KIDS_PENALTY = 0.25     # Family/Kids titles rank lower unless the mood or his history asks for them
TICKS_PER_MIN = 600000000  # Emby RunTimeTicks (100 ns) per minute
