    "no_metadata": ('"{t}" ist so neu, dass es noch nicht in den Datenbanken steht. Kommt, sobald es dort auftaucht.',
                    '"{t}" is so new it isn\'t in the databases yet. It comes once it\'s listed there.'),
    "removed": ('"{t}" ist nicht mehr auf dem Server. Bei Bedarf einfach nochmals anfragen: <seerr-link>',
                '"{t}" isn\'t on the server any more. Just request it again if you want it: <seerr-link>'),
    "not_requested": ('"{t}" ist noch nicht angefragt: <seerr-link> → suchen → "Anfragen".',
                      '"{t}" isn\'t requested yet: <seerr-link> → search → "Request".'),
    "stuck": ('"{t}" hängt noch an einem Detail, ich schau\'s mir an. 🔧', '"{t}" is stuck on a detail; I\'m on it. 🔧'),
}


def dr_norm(s):
    s = unicodedata.normalize("NFKD", str(s or "")).encode("ascii", "ignore").decode().lower().replace("&", " and ")
    return " ".join(re.sub(r"[^a-z0-9]+", " ", s).split())


DR_NAME_YEAR = re.compile(r"^(.+?)[\s._\-\[(]+((?:19|20)\d{2})(?=[\s._\-\])]|$)")


def dr_parse(name):
    """Release name -> (normalized title part, year or None)."""
    m = DR_NAME_YEAR.match(name or "")
    return (dr_norm(m.group(1)), int(m.group(2))) if m else (dr_norm(name), None)


def dr_rtext(x):
    return str(x.get("message") or x.get("reason") or "") if isinstance(x, dict) else str(x)


def dr_reason(text):
    t = text.lower()
    if any(u in t for u in DR_UNKNOWN):
        return "mismatch"
    for key, words in (("existing", ("existing file", "not an upgrade", "not a upgrade", "is not an upgrade")),
                       ("blocklisted", ("blocklist", "blacklist")), ("language", ("language",)),
                       ("quality", ("quality", "not wanted in profile", "custom format")), ("size", ("size",)),
                       ("seeders", ("seeder", "peers")), ("restricted", ("restrict", "must contain", "contains one",
                                                                          "release group"))):
        if any(w in t for w in words):
            return key
    return "other"


DR_REASON_TXT = {"existing": "they'd replace files already on disk (packs)", "blocklisted": "all blocklisted", "language": "wrong language for the profile",
                 "quality": "quality not allowed by the profile", "size": "outside the size limits",
                 "seeders": "too few seeders", "restricted": "blocked by a release restriction", "other": "rejected"}


def dr_candidates(rels, titles, years, rank=None, allowed=None, cut=None):
    """Releases rejected ONLY as an unknown title whose name is one of the title's names and whose year is within
    +-1 of a known year, best first (at or below the profile cutoff, then above; usenet first; newest)."""
    names = {dr_norm(t) for t in titles if t}
    out = []
    for r in rels:
        rs = [dr_rtext(x) for x in r.get("rejections") or []]
        if not rs or any(dr_reason(x) != "mismatch" for x in rs):
            continue
        name, y = dr_parse(r.get("title"))
        if name not in names or not y or not years or min(abs(y - x) for x in years) > 1:
            continue
        qn = ((r.get("quality") or {}).get("quality") or {}).get("name")
        if allowed is not None and qn not in allowed:
            continue
        out.append(r)
    rank = rank or {}
    cut = 10 ** 6 if cut is None else cut

    def key(r):
        i = rank.get(((r.get("quality") or {}).get("quality") or {}).get("name"), -1)
        return (i > cut, -i if i <= cut else i, r.get("protocol") != "usenet", r.get("ageMinutes") or r.get("age") or 0)
    return sorted(out, key=key)


def dr_classify(rels, titles=(), years=()):
    """Interactive search result -> {kind: none|approved|mismatch|<reason>, n, ...}."""
    n = len(rels or [])
    if not n:
        return {"kind": "none", "n": 0}
    ok = [r for r in rels if r.get("approved")]
    if ok:
        return {"kind": "approved", "n": n, "ok": len(ok)}
    cnt, sample = collections.Counter(), {}
    for r in rels:
        rs = [dr_rtext(x) for x in r.get("rejections") or []]
        for k in sorted({dr_reason(x) for x in rs} or {"other"}):
            cnt[k] += 1
            sample.setdefault(k, rs[0] if rs else "")
    kind, k_n = max(cnt.items(), key=lambda kv: (kv[1], kv[0] == "mismatch"))
    out = {"kind": kind, "n": n, "count": k_n, "reason": sample[kind][:120]}
    if kind == "mismatch":
        yrs = collections.Counter(y for y in (dr_parse(r.get("title"))[1] for r in rels) if y)
        out["years"] = [y for y, _ in yrs.most_common(2)]
        out["candidates"] = len(dr_candidates(rels, titles, years))
    return out


DR_RES_TOK = re.compile(r"\d{3,4}[pi]|uhd|4k")
DR_SRC_TOK = re.compile(r"web|webrip|webdl|bluray|bdrip|brrip|hdtv|dvdrip|remux")


def dr_rel_tail(name):
    """Release-name tokens from the resolution tag on (else the first source tag): quality, source, codec and group,
    i.e. what a season pack shares with its episodes' scene names (episode numbers and titles come before it)."""
    s = re.sub(r"\.(mkv|mp4|avi|m4v|ts)$", "", str(name or "").strip(), flags=re.I)
    toks = [t for t in re.split(r"[^0-9a-z]+", s.lower()) if t]
    for pat in (DR_RES_TOK, DR_SRC_TOK):
        for i, t in enumerate(toks):
            if pat.fullmatch(t):
                return tuple(toks[i:])
    return ()


def dr_same_release(rels, files, eps):
    """The group name when EVERY probed release is the release already on disk (nothing new on the indexers), else
    None. Each release must be rejected only as 'existing file' and named like an episode file of its season: the same
    scene name, or the same release group + quality + tail (resolution/source/codec/group) as a file's scene name.
    A single/multi-episode release must hit only episodes that have such a file; a season pack may be at most 25 %
    (+ 200 MB) bigger than those files together, so a fuller pack of the same group still counts as new."""
    if not rels or not files:
        return None
    ep_nums = collections.defaultdict(set)              # episode file id -> episode numbers
    for e in eps or []:
        if e.get("episodeFileId"):
            ep_nums[e["episodeFileId"]].add(e.get("episodeNumber"))
    groups = set()
    for r in rels:
        rs = [dr_rtext(x) for x in r.get("rejections") or []]
        if r.get("approved") or not rs or any(dr_reason(x) != "existing" for x in rs):
            return None
        title, grp = r.get("title") or "", (r.get("releaseGroup") or "").lower()
        qn = ((r.get("quality") or {}).get("quality") or {}).get("name")
        tail, norm = dr_rel_tail(title), dr_norm(title)
        hits = []
        for f in files:
            if r.get("seasonNumber") is not None and f.get("seasonNumber") != r.get("seasonNumber"):
                continue
            scene = f.get("sceneName") or ""
            if not scene:
                continue
            fq = ((f.get("quality") or {}).get("quality") or {}).get("name")
            same_name = dr_norm(scene) == norm
            same_tail = (tail and dr_rel_tail(scene) == tail and grp and (f.get("releaseGroup") or "").lower() == grp
                         and (not qn or not fq or qn == fq))
            if same_name or same_tail:
                hits.append(f)
        if not hits:
            return None
        if r.get("fullSeason"):
            have = sum(f.get("size") or 0 for f in hits)
            if r.get("size") and have and r["size"] > have * 1.25 + 200e6:
                return None
        else:
            covered = set().union(*(ep_nums.get(f.get("id"), set()) for f in hits))
            if not r.get("episodeNumbers") or not set(r["episodeNumbers"]) <= covered:
                return None
        groups.add(hits[0].get("releaseGroup") or r.get("releaseGroup") or "")
    return "/".join(sorted(g for g in groups if g)) or "same"


def dr_profile_rank(p):
    """Quality profile -> (allowed quality names, {name: rank}, cutoff rank); rank grows with quality."""
    rank, allowed, cut = {}, set(), None
    for i, it in enumerate(p.get("items") or []):
        for s in it.get("items") or [it]:
            qn = (s.get("quality") or {}).get("name")
            if qn:
                rank[qn] = i
                if it.get("allowed"):
                    allowed.add(qn)
        gid = it.get("id") if it.get("items") else (it.get("quality") or {}).get("id")
        if gid is not None and gid == p.get("cutoff"):
            cut = i
    return allowed, rank, cut


def dr_movie_release(m, now):
    """('out', date|None) | ('digital'|'physical'|'cinema', future date) | ('cinema_only', since) | ('unknown', None)."""
    dig, phy, cin = (zdt(m.get(k)) for k in ("digitalRelease", "physicalRelease", "inCinemas"))
    home = [x for x in (dig, phy) if x]
    past = [x for x in home if x <= now]
    if past:
        return "out", min(past)
    if home:
        nxt = min(home)
        return ("digital" if nxt == dig else "physical"), nxt
    if cin:
        if cin > now:
            return "cinema", cin
        return ("out", cin) if now - cin >= timedelta(days=DR_CINEMA_DAYS) else ("cinema_only", cin)
    if m.get("status") == "released" or (m.get("year") or 9999) < now.year:
        return "out", None
    return "unknown", None


def dr_age(d, now):
    if not d:
        return "?"
    days = max(0, (now - d).days)
    return "today" if days == 0 else f"{days} d" if days < 14 else f"{days // 7} w" if days < 60 else f"{days // 30} mo"


def dr_seasons(ss):
    ss = sorted(set(ss))
    if not ss:
        return ""
    if ss == list(range(ss[0], ss[-1] + 1)) and len(ss) > 1:
        return f" S{ss[0]}–{ss[-1]}"
    return " S" + ",".join(map(str, ss))


def dr_when(kind, d):
    """(German, English) date clause for the forward lines."""
    if not d:
        return "", ""
    s = ldate(d, "%d.%m.%Y")
    return {"digital": (f" (digital ab {s})", f" (digital release {s})"),
            "physical": (f" (auf Disc ab {s})", f" (on disc from {s})"),
            "cinema": (f" (im Kino ab {s})", f" (in cinemas from {s})"),
            "cinema_only": (f" (seit {s} im Kino, digital noch ohne Datum)", f" (in cinemas since {s}, no digital date yet)"),
            "next": (f" (nächste am {s})", f" (next on {s})")}.get(kind, ("", ""))


class Doctor:
    def __init__(self, a, now):
        self.a, self.now, self.dry = a, now, a.dry_run
        self.warns, self.queues, self.rels, self.n_fixed, self.probes = [], {}, {}, 0, 0
        self.skipped = collections.Counter()
        self.st = {} if os.environ.get("MEDIA_DOCTOR_FRESH_STATE") else self.load()

    @staticmethod
    def path():
        return os.path.expanduser(DR_STATE)

    def load(self):
        try:
            with open(self.path()) as f:
                st = json.load(f)
            return st if isinstance(st, dict) else {}
        except (OSError, ValueError):
            return {}

    def save(self):
        if self.dry:
            return
        cutoff = self.now.timestamp() - 60 * 86400
        st = {k: {kk: vv for kk, vv in (v or {}).items() if (vv or {}).get("t", 0) >= cutoff}
              for k, v in self.st.items() if isinstance(v, dict)}
        p = self.path()
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p + ".tmp", "w") as f:
            json.dump(st, f, indent=1, sort_keys=True)
        os.replace(p + ".tmp", p)

    def seen(self, kind, key):
        """Time of the last `kind` action for `key` (aware datetime) or None."""
        t = ((self.st.get(kind) or {}).get(key) or {}).get("t")
        return datetime.fromtimestamp(t, timezone.utc) if t else None

    def mark(self, _kind, _key, **extra):
        self.st.setdefault(_kind, {})[_key] = {"t": self.now.timestamp(), **extra}

    def due(self, kind, key, days, also=None):
        last = max([x for x in (self.seen(kind, key), also) if x], default=None)
        return (last is None or self.now - last >= timedelta(days=days)), last

    def act(self, svc, method, path, body, what, kind=None, key=None):
        """One fix (recorded, not sent, on --dry-run). Returns (text, response or None)."""
        if self.dry:
            return f"(dry run) {what}", None
        try:
            resp = api(svc, method, path, body, timeout=max(TIMEOUT, 60))
        except ApiError as e:
            self.warns.append(f"fix '{what}': {e}")
            return f"⚠️ couldn't {what}", None
        if kind:
            self.mark(kind, key)
        self.n_fixed += 1
        try:
            os.makedirs(os.path.dirname(self.path()), exist_ok=True)
            with open(os.path.join(os.path.dirname(self.path()), "doctor.log"), "a") as f:
                f.write(f"{iso_z(self.now)} {svc} {method} {path.split('?')[0]} {what}\n")
        except OSError:
            pass
        return f"✅ {what}", resp if resp is not None else {}

    def queue(self, svc):
        if svc not in self.queues:
            self.queues[svc] = soft(lambda: arr_queue(svc), self.warns, f"{svc} queue") or []
        return self.queues[svc]

    def probe(self, svc, key, path, titles, years, force=False, keep=None, refine=None):
        """Interactive search (GET /api/v3/release; it queries every indexer) -> classification, cached for
        DR_SEARCH_DAYS. None when probing is off / over the cap and nothing is cached. refine(rels, res) may
        re-classify (e.g. 'existing' -> 'same_on_disk'); an 'existing' entry cached before that check is stale."""
        ent = (self.st.get("probe") or {}).get(key)
        fresh = ent and self.now.timestamp() - ent.get("t", 0) < DR_SEARCH_DAYS * 86400
        if fresh and refine and ent.get("kind") == "existing" and not ent.get("disk_checked"):
            fresh = False
        if ent and fresh and not force:
            return {**ent, "cached": True}
        if self.a.no_probe or self.probes >= DR_PROBES:
            return {**ent, "cached": True} if ent else None
        self.probes += 1
        rels = soft(lambda: get(svc, path, timeout=DR_PROBE_TIMEOUT), self.warns, f"{svc} indexer search")
        if rels is None:
            return None
        if keep:
            rels = [r for r in rels if keep(r)]
        self.rels[key] = rels
        res = dr_classify(rels, titles, years)
        if refine:
            res = soft(lambda: refine(rels, res), self.warns, f"{svc} files") or res
        if not self.dry:
            self.mark("probe", key, **res)
        return {**res, "t": self.now.timestamp(), "cached": False}

    def emby(self, kind, prov, pid, title, yr):
        """{'name','year','same'} when Emby has the title (by provider id, else name + year +-1), else None."""
        if not (CFG.get("emby") or {}).get("url") or (not pid and not title) or "emby" in self.__dict__.get("_off", ()):
            return None
        base = f"{EMBY}/Items?Recursive=true&IncludeItemTypes={kind}&Fields=ProviderIds,ProductionYear&Limit=10"
        try:
            if pid:
                hit = (get("emby", f"{base}&AnyProviderIdEquals={prov}.{q(pid)}") or {}).get("Items") or []
                if hit:
                    return {"name": hit[0].get("Name"), "year": hit[0].get("ProductionYear"), "same": True}
            if title:
                want = dr_norm(title)
                for x in (get("emby", f"{base}&SearchTerm={q(title)}") or {}).get("Items") or []:
                    y = x.get("ProductionYear")
                    if dr_norm(x.get("Name")) == want and (not yr or not y or abs(int(y) - int(yr)) <= 1):
                        return {"name": x.get("Name"), "year": y, "same": False}
        except ApiError as e:
            self.warns.append(f"Emby: {e}")
            self._off = ("emby",)
        return None


def dr_v(code, line, action=None, owner=None, **fill):
    return {"code": code, "line": line, "action": action, "owner": owner, "fill": fill}


def dr_queue_verdict(d, svc, recs, it):
    """Verdict for a title with records in the arr queue; fixes failed / stalled downloads (drop + blocklist +
    search again: the download client's copy goes, library files are never touched)."""
    groups = {}
    for r in recs:
        groups.setdefault(r.get("downloadId") or r.get("id"), []).append(r)
    worst = None
    for did, g in groups.items():
        r = g[0]
        state, status = r.get("trackedDownloadState") or "", (r.get("status") or "").lower()
        msgs = ([r["errorMessage"]] if r.get("errorMessage") else []) + \
               [m for sm in r.get("statusMessages") or [] for m in sm.get("messages") or []]
        msg = (msgs[0] if msgs else "").strip()[:110]
        added = zdt(r.get("added"))
        stalled = (r.get("protocol") == "torrent" and any("stall" in m.lower() for m in msgs + [status])
                   and added and d.now - added >= timedelta(hours=DR_STALL_H))
        if state in ("importFailed", "failed", "failedPending") or status == "failed" or stalled:
            why = "stalled torrent" if stalled else f"download failed ({msg or state or status})"
            key = f"{svc}:{did}"
            if d.seen("regrab", key):
                v = dr_v("regrab", f"{why}; dropped {ldate(d.seen('regrab', key), '%d.%m')}, still listed in the queue")
            else:
                ids = ",".join(str(x["id"]) for x in g[:1])
                txt, _ = d.act(svc, "DELETE", f"/api/v3/queue/{ids}?removeFromClient=true&blocklist=true&skipRedownload=false",
                               None, "dropped + blocklisted it; the arr searches for another", "regrab", key)
                v = dr_v("regrab", why, txt)
        elif state == "importBlocked" or (state == "importPending" and (r.get("trackedDownloadStatus") or "") == "warning"):
            v = dr_v("import_blocked", f"import blocked: {msg or 'see the arr UI'}",
                     owner="arr-unblock imports it once the files check out, else it asks you")
        elif status in ("paused", "delay", "queued") or state == "downloading" and status in ("", "queued"):
            what = {"paused": "paused in the download client", "delay": "held by a delay profile"}.get(status, "queued")
            v = dr_v("queued", what + (f" ({len(g)} eps)" if svc == "sonarr" and len(g) > 1 else ""))
        else:
            e = eta(r)
            v = dr_v("downloading", f"{pct(r)} · {eta_txt(r)}" + (f" ({len(g)} eps)" if svc == "sonarr" and len(g) > 1 else ""),
                     eta=e.split(" (")[0] if e not in ("?", "done, importing") else "a few minutes")
        if worst is None or DR_ORDER.index(v["code"]) < DR_ORDER.index(worst["code"]):
            worst = v
    if len(groups) > 1 and worst:
        worst["line"] += f" (+{len(groups) - 1} more in the queue)"
    return worst


def dr_not_in_arr(d, it, svc):
    """Seerr has the request but the arr doesn't have the title: retry the request (when the arr can find it)."""
    if it["type"] == "tv":
        if not it.get("tvdb"):
            return dr_v("no_metadata", "no TheTVDB id yet, Sonarr can't add it")
        found = get("sonarr", f"/api/v3/series/lookup?term=tvdb%3A{int(it['tvdb'])}") or []
    else:
        try:
            found = [get("radarr", f"/api/v3/movie/lookup/tmdb?tmdbId={int(it['tmdb'])}")]
        except ApiError as e:
            if "HTTP 404" not in str(e) and "not found" not in str(e).lower():
                raise
            found = []
    arr = "Sonarr" if svc == "sonarr" else "Radarr"
    if not [x for x in found if x]:
        return dr_v("no_metadata", f"{arr} can't find it on {'TheTVDB' if svc == 'sonarr' else 'TMDB'} yet")
    if not it.get("req"):
        return dr_v("not_requested", f"not in {arr}, no open request")
    recent = it.get("created") and d.now - it["created"] <= timedelta(days=DR_RETRY_MAX_DAYS)
    if it["req_status"] != 4 or not recent:   # approved but gone from the arr = removed on purpose: never re-add
        return dr_v("removed", f"not in {arr} any more (removed); Seerr still lists the request",
                    owner="re-request it in Seerr if it should come back")
    head = "Seerr failed to hand it to " + arr
    ok, last = d.due("retry", f"req:{it['req']}", DR_RETRY_DAYS)
    if not ok:
        return dr_v("retried", f"{head}; retried {ldate(last, '%d.%m')}, still not there",
                    owner="check Seerr's log / the arr's root folder")
    txt, resp = d.act("seerr", "POST", f"/api/v1/request/{int(it['req'])}/retry", None, "retried the request",
                      "retry", f"req:{it['req']}")
    if resp and resp.get("status") == 4:
        txt += " (still failing)"
    return dr_v("retried", head, txt)


def dr_on_disk(d, it, extra=""):
    hit = d.emby("Movie" if it["type"] == "movie" else "Series", "Tmdb" if it["type"] == "movie" else "Tvdb",
                 it["tmdb"] if it["type"] == "movie" else it.get("tvdb"), it["title"], it["year"])
    if hit:
        return dr_v("on_emby", "on Emby; Seerr marks it available at its next sync" + extra)
    return dr_v("on_disk", "on disk, Emby hasn't picked it up yet (next library scan)" + extra)


def dr_search_verdict(d, it, svc, key, pr, last_arr, search_fix, missing_txt=None, tv=False):
    """Verdict from an indexer probe (or, without one, the last search time) + the re-search fix."""
    code = "missing_eps" if tv else "no_release"
    head = (missing_txt + ", ") if missing_txt else ""
    if pr and pr["kind"] == "approved":
        when = f" (checked {ldate(datetime.fromtimestamp(pr['t'], timezone.utc), '%d.%m')})" if pr.get("cached") else ""
        if pr.get("cached"):
            return dr_v("searching", f"{head}{pr['ok']} usable release(s) found{when}; the arr should grab one")
        txt, _ = search_fix()
        return dr_v("searching", f"{head}{pr['ok']} of {pr['n']} releases usable", txt)
    if pr and pr["kind"] == "none":
        return dr_v(code, f"{head}no release on the indexers (searched {ldate(datetime.fromtimestamp(pr['t'], timezone.utc), '%d.%m')})")
    if pr and pr["kind"] == "mismatch":
        yrs = "/".join(map(str, pr.get("years") or [])) or "?"
        line = f"name mismatch: {pr['n']} releases, named {yrs}, {it.get('year') or '?'} in the arr"
        if tv:
            return dr_v("mismatch", head + line, owner="check the series' alternate titles / TVDB")
        return dr_v("mismatch", head + line, owner=(f"`media doctor \"{it['title']}\" --grab` grabs the best match"
                                                     if pr.get("candidates") else "no release carries the title + year"))
    if pr and pr["kind"] == "same_on_disk":
        when = ldate(datetime.fromtimestamp(pr["t"], timezone.utc), "%d.%m")
        return dr_v(code, f"{head}nothing new on the indexers: {pr['n']} releases, all the {pr.get('group') or 'same'} "
                          f"release already on disk (searched {when})")
    if pr and pr["kind"] == "existing":
        return dr_v("rejected", f"{head}{pr['n']} releases, all packs that would replace files already on disk",
                    owner="grab a pack by hand if replacing those files is fine")
    if pr:
        return dr_v("rejected", f"{head}{pr['n']} releases, all rejected: {DR_REASON_TXT.get(pr['kind'], pr['kind'])}",
                    owner=f"profile/settings are your call ({pr.get('reason', '')[:70]})")
    ok, last = d.due("search", key, DR_SEARCH_DAYS, last_arr)
    if ok:
        txt, _ = search_fix()
        return dr_v(code, f"{head}nothing grabbed yet", txt)
    return dr_v(code, f"{head}no release yet (searched {ldate(last, '%d.%m')})")


def dr_movie(d, it):
    m = None
    if it.get("arr_id"):
        try:
            m = get("radarr", f"/api/v3/movie/{int(it['arr_id'])}")
        except ApiError as e:
            if "HTTP 404" not in str(e):
                raise
    if (not m or m.get("tmdbId") != it["tmdb"]) and it.get("tmdb"):
        m = (get("radarr", f"/api/v3/movie?tmdbId={int(it['tmdb'])}") or [None])[0]
    if m:
        it["title"], it["year"] = m.get("title") or it["title"], m.get("year") or it["year"]
    if not m:
        return dr_not_in_arr(d, it, "radarr")
    mid, key = m["id"], f"radarr:{m['id']}"
    if m.get("hasFile"):
        mf = m.get("movieFile") or {}
        qn = ((mf.get("quality") or {}).get("quality") or {}).get("name")
        extra = f" ({qn})" if qn else ""
        if mf.get("qualityCutoffNotMet"):
            extra += ", waiting for an upgrade"
        return dr_on_disk(d, it, extra)
    recs = [r for r in d.queue("radarr") if r.get("movieId") == mid or (r.get("movie") or {}).get("id") == mid]
    if recs:
        return dr_queue_verdict(d, "radarr", recs, it)
    fixes = []
    if not m.get("monitored"):
        fixes.append(d.act("radarr", "PUT", "/api/v3/movie/editor", {"movieIds": [mid], "monitored": True},
                           "monitored it again")[0])
    kind, when = dr_movie_release(m, d.now)
    if kind != "out":
        line = {"digital": f"digital release {ldate(when)}", "physical": f"disc release {ldate(when)}",
                "cinema": f"in cinemas from {ldate(when)}", "cinema_only": f"in cinemas since {ldate(when)}, no digital date",
                "unknown": "no release dates yet"}[kind]
        de, en = dr_when(kind, when)
        return dr_v("not_released", line, "; ".join(fixes) or None, when_de=de, when_en=en)
    hit = d.emby("Movie", "Tmdb", it["tmdb"], it["title"], it["year"])
    if hit:
        return dr_v("on_emby" if hit["same"] else "on_emby_other",
                    f"already on Emby as {hit['name']} ({hit['year'] or '?'})" if not hit["same"] else
                    "on Emby (Radarr lost track of the file)", "; ".join(fixes) or None, o=hit["name"])
    if it.get("created") and d.now - it["created"] < timedelta(hours=DR_FRESH_H):
        return dr_v("fresh", "just requested; Radarr is searching", "; ".join(fixes) or None)
    hist = soft(lambda: get("radarr", f"/api/v3/history/movie?movieId={mid}"), d.warns, "Radarr history") or []
    grabs = sorted((zdt(h.get("date")) for h in hist if h.get("eventType") == "grabbed" and zdt(h.get("date"))))
    fails = [h for h in hist if h.get("eventType") in ("downloadFailed", "importFailed", "downloadIgnored")]
    gtxt = f"last grab {ldate(grabs[-1], '%d.%m')}{' failed' if fails else ''}" if grabs else None
    titles = [m.get("title"), m.get("originalTitle")] + [x.get("title") for x in m.get("alternateTitles") or []]
    years = sorted({y for y in [m.get("year"), m.get("secondaryYear")] + [
        (zdt(m.get(k)) or d.now).year if m.get(k) else None for k in ("inCinemas", "digitalRelease", "physicalRelease")] if y})
    pr = d.probe("radarr", key, f"/api/v3/release?movieId={mid}", titles, years, force=d.a.grab)
    v = dr_search_verdict(d, it, "radarr", key, pr, zdt(m.get("lastSearchTime")),
                          lambda: d.act("radarr", "POST", "/api/v3/command", {"name": "MoviesSearch", "movieIds": [mid]},
                                        "searched again", "search", key), gtxt)
    if d.a.grab and v["code"] == "mismatch" and key in d.rels:
        prof = get("radarr", f"/api/v3/qualityprofile/{int(m.get('qualityProfileId') or 0)}") or {}
        allowed, rank, cut = dr_profile_rank(prof)
        best = (dr_candidates(d.rels[key], titles, years, rank, allowed, cut) or [None])[0]
        if best:
            txt, _ = d.act("radarr", "POST", "/api/v3/release",
                           {"guid": best.get("guid"), "indexerId": best.get("indexerId"), "movieId": mid},
                           f"grabbed {best.get('title', '?')[:70]}", "grab", key)
            v = dr_v("searching", v["line"], txt)
        else:
            v["owner"] = "no matching release in a quality the profile allows"
    if fixes:
        v["action"] = "; ".join(fixes + ([v["action"]] if v["action"] else []))
    return v


def dr_tv(d, it):
    s = None
    if it.get("arr_id"):
        try:
            s = get("sonarr", f"/api/v3/series/{int(it['arr_id'])}")
        except ApiError as e:
            if "HTTP 404" not in str(e):
                raise
    if (not s or (it.get("tvdb") and s.get("tvdbId") != it["tvdb"])) and it.get("tvdb"):
        s = (get("sonarr", f"/api/v3/series?tvdbId={int(it['tvdb'])}") or [None])[0]
    if s:
        it["title"], it["year"] = s.get("title") or it["title"], s.get("year") or it["year"]
    if not s:
        return dr_not_in_arr(d, it, "sonarr")
    sid = s["id"]
    want = set(it.get("seasons") or []) or {x["seasonNumber"] for x in s.get("seasons") or [] if x.get("seasonNumber")}
    eps = [e for e in get("sonarr", f"/api/v3/episode?seriesId={sid}") or [] if e.get("seasonNumber") in want]
    fixes = []
    unmon = [x["seasonNumber"] for x in s.get("seasons") or [] if x.get("seasonNumber") in want and not x.get("monitored")]
    if not s.get("monitored") or unmon:
        body = json.loads(json.dumps(s))
        body["monitored"] = True
        for x in body.get("seasons") or []:
            if x.get("seasonNumber") in want:
                x["monitored"] = True
        fixes.append(d.act("sonarr", "PUT", f"/api/v3/series/{sid}", body,
                           f"monitored{dr_seasons(unmon) or ' the show'} again")[0])
    far = d.now + timedelta(days=36500)
    aired = [e for e in eps if (zdt(e.get("airDateUtc")) or far) <= d.now]
    miss = [e for e in aired if not e.get("hasFile")]
    if miss and not unmon:
        um = [e["id"] for e in miss if not e.get("monitored")]
        if um:
            fixes.append(d.act("sonarr", "PUT", "/api/v3/episode/monitor", {"episodeIds": um, "monitored": True},
                               f"monitored {plural(len(um), 'missing episode')} again")[0])
    future = sorted((e for e in eps if (zdt(e.get("airDateUtc")) or far) > d.now and zdt(e.get("airDateUtc"))),
                    key=lambda e: e["airDateUtc"])
    nxt = future[0] if future else None
    recs = [r for r in d.queue("sonarr") if r.get("seriesId") == sid]
    fx = "; ".join(fixes) or None

    def done(v):
        if fixes:
            v["action"] = "; ".join(fixes + ([v["action"]] if v["action"] else []))
        return v
    if recs:
        v = dr_queue_verdict(d, "sonarr", recs, it)
        if miss and v["code"] in ("downloading", "queued"):
            v["line"] += f"; {len(miss)} of {len(aired)} aired eps not on disk yet"
        return done(v)
    if not aired:
        if nxt:
            de, en = dr_when("next", zdt(nxt["airDateUtc"]))
            return done(dr_v("not_released", f"premieres {ldate(zdt(nxt['airDateUtc']))}", when_de=de, when_en=en))
        return done(dr_v("not_released", "no air date yet"))
    if not miss:
        if nxt:
            de, en = dr_when("next", zdt(nxt["airDateUtc"]))
            return done(dr_v("airing", f"up to date ({len(aired)} eps), next S{nxt['seasonNumber']:02d}E{nxt['episodeNumber']:02d} "
                                       f"{ldate(zdt(nxt['airDateUtc']), '%d.%m')}", when_de=de, when_en=en))
        return done(dr_on_disk(d, it, f" (all {len(aired)} eps)"))
    if it.get("created") and d.now - it["created"] < timedelta(hours=DR_FRESH_H):
        return done(dr_v("fresh", "just requested; Sonarr is searching"))
    per = collections.Counter(e["seasonNumber"] for e in miss)
    mtxt = f"{len(miss)} of {len(aired)} aired eps missing (" + ", ".join(f"S{k}: {n}" for k, n in sorted(per.items())) + ")"
    season = min(per)
    titles = [s.get("title")] + [x.get("title") for x in s.get("alternateTitles") or []]
    want_eps = {e["episodeNumber"] for e in miss if e["seasonNumber"] == season}
    def same_on_disk(rels, res):
        """All rejected packs/episodes = the release already on disk (same scene name or group+quality tail)."""
        if res.get("kind") != "existing":
            return res
        files = [f for f in get("sonarr", f"/api/v3/episodefile?seriesId={sid}") or [] if f.get("seasonNumber") == season]
        grp = dr_same_release(rels, files, [e for e in eps if e.get("seasonNumber") == season])
        return {**res, "kind": "same_on_disk", "group": grp, "disk_checked": True} if grp else {**res, "disk_checked": True}
    pr = d.probe("sonarr", f"sonarr:{sid}:{season}", f"/api/v3/release?seriesId={sid}&seasonNumber={season}", titles, [],
                 keep=lambda r: r.get("fullSeason") or bool(set(r.get("episodeNumbers") or []) & want_eps),
                 refine=same_on_disk)
    last = max([x for x in (zdt(e.get("lastSearchTime")) for e in miss) if x], default=None)
    ids = [e["id"] for e in miss][:200]
    v = dr_search_verdict(d, it, "sonarr", f"sonarr:{sid}", pr, last,
                          lambda: d.act("sonarr", "POST", "/api/v3/command", {"name": "EpisodeSearch", "episodeIds": ids},
                                        f"searched the {plural(len(ids), 'missing episode')} again", "search", f"sonarr:{sid}"),
                          mtxt, tv=True)
    v["fill"]["n"] = len(miss)
    return done(v)


def dr_item(r, mi, me_id):
    """One request (r may be None) + its Seerr media -> the doctor's working dict."""
    r = r or {}
    who = (r.get("requestedBy") or {})
    return {"req": r.get("id"), "req_status": r.get("status"), "type": r.get("type") or mi.get("mediaType"),
            "tmdb": mi.get("tmdbId"), "tvdb": mi.get("tvdbId"), "media_status": mi.get("status") or 1,
            "arr_id": mi.get("externalServiceId"), "who": ((who.get("displayName") or "?").split() or ["?"])[0],
            "mine": bool(me_id and who.get("id") == me_id), "created": zdt(r.get("createdAt")),
            "seasons": sorted({x["seasonNumber"] for x in r.get("seasons") or [] if x.get("seasonNumber")}),
            "title": None, "year": None}


def dr_open(reqs, me_id, now, days=0):
    """Seerr requests still on their way (pending; approved with the title pending/processing/partly there; failed
    in the last 90 days; not 4K), merged per title. Approved requests whose title Seerr reset to unknown/deleted were
    removed from the arr: skipped (counted), like requests older than `days` (0 = no limit)."""
    items, skipped = {}, collections.Counter()
    for r in reqs:
        mi = r.get("media") or {}
        st, ms, cr = r.get("status"), mi.get("status"), zdt(r.get("createdAt"))
        if r.get("is4k") or st not in (1, 2, 4) or ms == 5:
            continue
        if st == 2 and ms in (1, 7):
            skipped["removed"] += 1
            continue
        if st == 4 and (not cr or now - cr > timedelta(days=DR_RETRY_MAX_DAYS)):
            skipped["old failed"] += 1
            continue
        if days and cr and now - cr > timedelta(days=days) and st != 1:
            skipped[f"older than {days} d"] += 1
            continue
        it = dr_item(r, mi, me_id)
        k = (it["type"], it["tmdb"])
        if k in items:
            old = items[k]
            old["seasons"] = sorted(set(old["seasons"]) | set(it["seasons"]))
            if it["req_status"] == 4 or (it["created"] and old["created"] and it["created"] < old["created"]):
                it["seasons"] = old["seasons"]
                items[k] = it
            continue
        items[k] = it
    return list(items.values()), skipped


def dr_me():
    try:
        return seerr_user_rec(READY_USER)["id"] if READY_USER else None
    except ApiError:
        return None


def dr_diagnose(d, it):
    if it["media_status"] == 5 and it["req_status"] not in (1, 2, 4):
        return dr_v("available", "on Emby")
    if it["req_status"] == 1:
        return dr_v("pending", "waiting for approval in Seerr", owner="approve or decline it in Seerr")
    if not it.get("req") and it["media_status"] in (1, 7):
        hit = d.emby("Movie" if it["type"] == "movie" else "Series", "Tmdb" if it["type"] == "movie" else "Tvdb",
                     it["tmdb"] if it["type"] == "movie" else it.get("tvdb"), it["title"], it["year"])
        if hit:
            return dr_v("on_emby" if hit["same"] else "on_emby_other", f"on Emby as {hit['name']} ({hit['year'] or '?'})",
                        o=hit["name"])
        return dr_v("not_requested", "not requested in Seerr")
    return dr_movie(d, it) if it["type"] == "movie" else dr_tv(d, it)


def dr_fwd(it, v):
    code = v["code"]
    key = "stuck" if code in ("import_blocked", "mismatch", "rejected", "error") else code
    if key not in DR_FWD:
        key = "no_release"
    fill = {"t": it.get("title") or "?", "eta": "", "when_de": "", "when_en": "", "n": "", "o": "", **v.get("fill", {})}
    de, en = DR_FWD[key]
    return de.format(**fill), en.format(**fill)


def dr_head_line(it, now, md=False):
    kind = "🎬" if it["type"] == "movie" else "📺"
    t = f"{it.get('title') or '?'}" + (f" ({it['year']})" if it.get("year") else "") + (dr_seasons(it.get("seasons")) if it["type"] == "tv" else "")
    if md:
        t = f"*{tn_md(t)}*"
    who = "you" if it.get("mine") else it.get("who") or "?"
    return f"{kind} {t} · {who} · {dr_age(it.get('created'), now)}" if it.get("req") else f"{kind} {t}"


def dr_detail(v, md=False):
    s = f"{DR_ICON.get(v['code'], '•')} {v['line']}"
    if v.get("action"):
        s += f" → {v['action']}"
    if v.get("owner"):
        s += f" · 👉 {v['owner']}"
    return s


def dr_render(items, now, n, single, warns, d, md=False):
    fixed = d.n_fixed
    need = sum(1 for it in items if it["v"]["code"] in DR_OWNER)
    if single:
        it = items[0]
        out = [f"🩺 {dr_head_line(it, now, md)}", "   " + dr_detail(it["v"], md), "",
               f"🇨🇭 {it['de']}", f"🇬🇧 {it['en']}"]
    else:
        head = f"🩺 Request doctor · {plural(len(items), 'open request')}"
        if fixed or d.dry:
            head += f" · {fixed} fixed" if not d.dry else " · dry run"
        if need:
            head += f" · {need} need you"
        out = [head]
        if not items:
            out.append("Nothing waiting: every Seerr request is on Emby.")
        stuck = [it for it in items if it["v"]["code"] in DR_SHOWN]
        wait = [it for it in items if it["v"]["code"] in DR_WAITING]
        rest = [it for it in items if it not in stuck and it not in wait]
        for it in stuck[:n]:
            out += [dr_head_line(it, now, md), "   " + dr_detail(it["v"], md)]
        if len(stuck) > n:
            out.append(f"… +{len(stuck) - n} more stuck")
        if wait:
            out.append("Waiting normally:")
            for it in wait[:n]:
                out.append(f"  {DR_ICON[it['v']['code']]} {dr_short(it)}: {it['v']['line']}")
            if len(wait) > n:
                out.append(f"  … +{len(wait) - n} more")
        if rest:
            out.append(f"Already there or gone: {len(rest)} (" + ", ".join(
                f"{dr_short(it)} {DR_ICON.get(it['v']['code'], '')}" for it in rest[:4]) + (", …" if len(rest) > 4 else "") + ")")
        if d.skipped:
            out.append("Skipped: " + ", ".join(f"{v} {k}" for k, v in sorted(d.skipped.items())) + " (--days 0 = all)")
    if warns:
        out.append("⚠️ Not checked: " + "; ".join(w.split(":")[0] for w in warns)[:200])
    return "\n".join(out)


def dr_short(it, n=40):
    t = (it.get("title") or "?") + (dr_seasons(it.get("seasons")) if it["type"] == "tv" else "")
    return t if len(t) <= n else t[:n - 1] + "…"


def dr_text(items, now, d, n=12):
    """Compact plain card (instant /doctor): one line per request, stuck ones first."""
    if not items:
        return "🩺 Request doctor\nNothing waiting: every Seerr request is on Emby."
    need = sum(1 for it in items if it["v"]["code"] in DR_OWNER)
    head = f"🩺 Request doctor · {plural(len(items), 'open request')}" + (f" · {d.n_fixed} fixed" if d.n_fixed else "") + \
           (f" · {need} need you" if need else "")
    out = [head]
    show = [it for it in items if it["v"]["code"] in DR_SHOWN or it["v"]["code"] in DR_WAITING]
    for it in show[:n]:
        v = it["v"]
        line = v["line"] + (" ✅" if (v.get("action") or "").startswith("✅") else "")
        line = line if len(line) <= 80 else line[:79].rstrip(" ,;·(") + "…"
        out.append(f"{DR_ICON.get(v['code'], '•')} {dr_short(it)}: {line}")
    if len(show) > n:
        out.append(f"… +{len(show) - n} more")
    if len(items) > len(show):
        out.append(f"✅ {len(items) - len(show)} already there or gone")
    out.append("/doctor TITLE = one request + a line to forward")
    return "\n".join(out)


def dr_cron(items, now, a, d):
    """--cron: the routine fixes ran; one ~/inbox note only when DR_NOTE_MIN+ requests stay stuck on him (his call:
    mismatch, rejected, import blocked, waiting for approval). Failed checks are cron-fail's job (exit 3)."""
    need = [it for it in items if it["v"]["code"] in DR_OWNER - {"error"}]
    print(f"doctor --cron: {plural(len(items), 'open request')}, {d.n_fixed} fixed, {len(need)} need you"
          + (f", {len(d.warns)} check(s) failed" if d.warns else ""))
    if len(need) >= DR_NOTE_MIN:
        day = ldate(now, "%Y-%m-%d")
        out = [f"# media-doctor {day}: {plural(len(need), 'request')} stuck on the owner", "",
               f"Weekly `media doctor --cron`: {plural(len(items), 'open request')}, {d.n_fixed} routine fix(es) done "
               f"(monitor, search, re-grab, Seerr retry); these stay stuck and need his call. Handling: JOBS.md "
               f"(media-doctor). Per title: `media doctor \"TITLE\"` (+ German/English lines to forward).", ""]
        for it in need:
            out += [f"- {dr_head_line(it, now)}", f"  {dr_detail(it['v'])}"]
        if d.skipped:
            out += ["", "Skipped (left alone on purpose): " + ", ".join(f"{v} {k}" for k, v in sorted(d.skipped.items()))]
        text = "\n".join(out) + "\n"
        if d.dry:
            print(f"(dry run) would write {DR_INBOX}/media-doctor-{day}.md:\n" + text, end="")
        else:
            box = os.path.expanduser(DR_INBOX)
            os.makedirs(box, exist_ok=True)
            tmp = os.path.join(box, f".media-doctor-{day}.md.tmp")
            with open(tmp, "w") as f:
                f.write(text)
            os.replace(tmp, os.path.join(box, f"media-doctor-{day}.md"))
            print(f"note: {box}/media-doctor-{day}.md")
    if d.warns:
        for w in d.warns:
            print(f"!! {w}", file=sys.stderr)
        sys.exit(3)


def cmd_doctor(a):
    now = now_utc()
    if a.cron and (a.title or a.grab or a.json or a.mine):
        die("--cron checks every open request: no TITLE, --grab, --mine or --json")
    if a.grab and not a.title:
        die("--grab needs a TITLE")
    d = Doctor(a, now)
    me_id = dr_me()
    if a.title:
        m = re.match(r"^(.*?)\s*\(?((?:19|20)\d\d)\)?$", a.title)
        name, yr = (m.group(1), m.group(2)) if m and m.group(1) else (a.title, None)
        hits = seerr_search(name, a.type, 10)
        if not hits:
            die(f"no Seerr match for {a.title!r}")
        h = sorted(hits, key=lambda h: (bool(yr) and year(h) != yr, dr_norm(title_of(h)) != dr_norm(name),
                                        ((h.get("mediaInfo") or {}).get("status") or 1) not in (2, 3, 4)))[0]
        det = details(h["id"], h["mediaType"])
        mi = {**(det.get("mediaInfo") or {}), "tmdbId": det.get("id"), "mediaType": h["mediaType"]}
        mi.setdefault("tvdbId", (det.get("externalIds") or {}).get("tvdbId"))
        reqs = sorted((r for r in mi.get("requests") or [] if not r.get("is4k") and r.get("status") != 3),
                      key=lambda r: r.get("createdAt") or "")
        open_ = [r for r in reqs if r.get("status") in (1, 2, 4)]
        it = dr_item((open_ or reqs or [None])[0], mi, me_id)
        if not open_ and len(reqs) > 1 and it["type"] == "tv":
            it["seasons"] = sorted({x["seasonNumber"] for r in reqs for x in r.get("seasons") or [] if x.get("seasonNumber")})
        it["title"], it["type"] = title_of(det), h["mediaType"]
        it["year"] = int(year(det)) if year(det).isdigit() else None
        items = [it]
    else:
        reqs = seerr_paged("/api/v1/request?filter=all&sort=added", 5000)
        items, d.skipped = dr_open(reqs, me_id, now, a.days)
        if a.mine:
            items = [it for it in items if it["mine"]]
    for it in items:
        try:
            it["v"] = dr_diagnose(d, it)
        except ApiError as e:
            d.warns.append(str(e))
            it["v"] = dr_v("error", str(e)[:120])
        if not it.get("title"):
            try:
                det = details(it["tmdb"], it["type"])
                it["title"], it["year"] = title_of(det), (int(year(det)) if year(det).isdigit() else None)
            except (ApiError, TypeError, ValueError):
                it["title"] = f"tmdb:{it['tmdb']}"
        it["de"], it["en"] = dr_fwd(it, it["v"])
    epoch = datetime.min.replace(tzinfo=timezone.utc)
    items.sort(key=lambda it: (DR_ORDER.index(it["v"]["code"]) if it["v"]["code"] in DR_ORDER else 99,
                               -(it.get("created") or epoch).timestamp() if it.get("created") else 0))
    d.save()
    if a.cron:
        return dr_cron(items, now, a, d)
    single = bool(a.title)
    if a.json:
        rows = [{"title": it.get("title"), "year": it.get("year"), "type": it["type"], "tmdb": it["tmdb"],
                 "seasons": it.get("seasons"), "request": it.get("req"), "requested_by": "you" if it["mine"] else it["who"],
                 "requested": it.get("created"), "code": it["v"]["code"], "verdict": it["v"]["line"],
                 "action": it["v"].get("action"), "needs_owner": it["v"].get("owner"), "de": it["de"], "en": it["en"]}
                for it in items]
        emit_json({"items": rows, "fixed": d.n_fixed, "dry_run": d.dry, "probes": d.probes, "skipped": d.skipped,
                   "message": dr_render(items, now, a.n, single, d.warns, d, md=True),
                   "text": dr_render(items, now, a.n, True, d.warns, d) if single else dr_text(items, now, d),
                   "warnings": d.warns})
        return finish(d.warns, True)
    print(dr_render(items, now, a.n, single, d.warns, d))
    if d.warns:
        sys.exit(3)


# ---------- posters: the weekly "Neu auf dem Server" collage (Emby + arr history GETs only; Pillow) ----------
# Items = movies and episodes Emby created in the window, from the libraries his Emby user sees (movie, TV and mixed
# views, minus his My Media / Latest excludes); specials (season 0), missing/virtual episodes and extras stay out.
# Radarr/Sonarr history tells upgrades apart: a title whose file deletions (or renames) in the window match its imports
# had a file before (upgrade, replacement, rename), so it isn't new. Shows are grouped by series, episodes counted.
PO_W = 1080
PO_MAX = int(_env_num("MEDIA_POSTERS_MAX", 24))
PO_NOTE_MIN = int(_env_num("MEDIA_POSTERS_SEND_MIN", 5))
PO_INBOX = os.environ.get("MEDIA_POSTERS_INBOX") or "~/inbox"
PO_FONTS = os.environ.get("MEDIA_POSTERS_FONTS") or "/usr/share/fonts/truetype"
PO_VIEWS = {"movies", "tvshows", "mixed", ""}
PO_FIELDS = ("DateCreated,ProductionYear,CommunityRating,ParentIndexNumber,IndexNumber,SeriesId,SeriesName,"
             "ProviderIds,LocationType,ImageTags,SeriesPrimaryImageTag")
PO_IMG_MAX = 6 * 1024 * 1024
PO_MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
PO_C = {"bg": (13, 14, 20), "fg": (244, 243, 251), "mute": (160, 158, 182), "star": (255, 184, 77),
        "a1": (255, 79, 139), "a2": (123, 92, 255), "a3": (34, 211, 166), "card": (30, 31, 42)}
PO_IMPORT = {"downloadFolderImported", "movieFolderImported", "seriesFolderImported"}
PO_DELETE = {"movieFileDeleted", "episodeFileDeleted"}
PO_RENAME = {"movieFileRenamed", "episodeFileRenamed"}


def po_pid(x, name):
    """A provider id (Tmdb, Tvdb) of an Emby item as int, whatever the key's case; None if absent."""
    for k, v in (x.get("ProviderIds") or {}).items():
        if k.lower() == name and str(v).isdigit():
            return int(v)
    return None


def po_views(uid):
    c = (get("emby", f"{EMBY}/Users/{uid}") or {}).get("Configuration") or {}
    skip = {str(s) for s in (c.get("MyMediaExcludes") or []) + (c.get("LatestItemsExcludes") or [])}
    views = (get("emby", f"{EMBY}/Users/{uid}/Views") or {}).get("Items") or []
    return [v for v in views if (v.get("CollectionType") or "") in PO_VIEWS
            and not ({str(v.get("Id")), str(v.get("Guid") or "")} & skip)]


def po_fetch(uid, since, skipped):
    """Movies + regular episodes Emby created since `since` in his visible libraries (deduped)."""
    floor, seen, out = iso_z(since)[:19], set(), []
    for v in po_views(uid):
        d = get("emby", f"{EMBY}/Users/{uid}/Items?ParentId={q(v['Id'])}&Recursive=true&IncludeItemTypes=Movie,Episode"
                        f"&MinDateCreated={q(iso_z(since))}&IsMissing=false&Fields={PO_FIELDS}&Limit=5000") or {}
        for x in d.get("Items") or []:
            if x.get("Id") in seen or (x.get("DateCreated") or "")[:19] < floor or x.get("ExtraType"):
                continue
            seen.add(x.get("Id"))
            if x.get("LocationType") == "Virtual" or x.get("IsMissing"):
                skipped["missing"] += 1
            elif x.get("Type") == "Episode" and (x.get("ParentIndexNumber") == 0 or not x.get("SeriesId")):
                skipped["specials"] += 1
            elif x.get("Type") in ("Movie", "Episode"):
                out.append(x)
    return out


def po_replaced(svc, since, warns):
    """Keys of titles that already had a file before the window (deletions/renames >= imports in the window):
    Radarr -> TMDB id, Sonarr -> (TVDB id, season, episode). None when the arr failed (nothing filtered)."""
    inc = "includeMovie=true" if svc == "radarr" else "includeSeries=true&includeEpisode=true"
    try:
        recs = get(svc, f"/api/v3/history/since?date={q(iso_z(since - timedelta(days=1)))}&{inc}") or []
    except ApiError as e:
        warns.append(f"{svc} history failed, upgrades not filtered: {e}")
        return None
    imp, dele, ren = collections.Counter(), collections.Counter(), collections.Counter()
    for r in recs if isinstance(recs, list) else recs.get("records") or []:
        if svc == "radarr":
            k = (r.get("movie") or {}).get("tmdbId")
        else:
            s, e = r.get("series") or {}, r.get("episode") or {}
            k = (s.get("tvdbId"), e.get("seasonNumber"), e.get("episodeNumber"))
            k = k if None not in k else None
        ev = r.get("eventType")
        if k:
            (imp if ev in PO_IMPORT else dele if ev in PO_DELETE else ren if ev in PO_RENAME else collections.Counter())[k] += 1
    return {k for k in set(dele) | set(ren) if dele[k] >= imp[k]}


def po_series(uid, ids):
    out = {}
    ids = sorted(ids)
    for i in range(0, len(ids), 50):
        d = get("emby", f"{EMBY}/Users/{uid}/Items?Ids={q(','.join(ids[i:i + 50]))}"
                        "&Fields=ProviderIds,DateCreated,ProductionYear,CommunityRating,ImageTags") or {}
        out.update({x.get("Id"): x for x in d.get("Items") or []})
    return out


def po_rating(x):
    r = x.get("CommunityRating")
    return round(float(r), 1) if isinstance(r, (int, float)) and r > 0 else None


def po_seasons(ss):
    ss = sorted(ss)
    if len(ss) == 1:
        return f"S{ss[0]}"
    return f"S{ss[0]}–{ss[-1]}" if ss == list(range(ss[0], ss[-1] + 1)) else "S" + ",".join(map(str, ss))


def po_collect(uid, since, warns):
    """-> (items, skipped): movies and series (new episodes grouped), newest titles only."""
    skipped = collections.Counter()
    raw = po_fetch(uid, since, skipped)
    floor = iso_z(since)[:19]
    rmov = po_replaced("radarr", since, warns) if any(x["Type"] == "Movie" for x in raw) else set()
    reps = po_replaced("sonarr", since, warns) if any(x["Type"] == "Episode" for x in raw) else set()
    eps = [x for x in raw if x["Type"] == "Episode"]
    smeta = po_series(uid, {x["SeriesId"] for x in eps}) if eps else {}
    items, shows = [], {}
    for x in raw:
        if x["Type"] == "Movie":
            if rmov and po_pid(x, "tmdb") in rmov:
                skipped["upgrades"] += 1
                continue
            items.append({"kind": "movie", "id": x.get("Id"), "title": x.get("Name") or "?",
                          "year": x.get("ProductionYear"), "rating": po_rating(x), "added": x.get("DateCreated") or "",
                          "img": x.get("Id") if (x.get("ImageTags") or {}).get("Primary") else None})
            continue
        s = smeta.get(x["SeriesId"]) or {}
        if reps and (po_pid(s, "tvdb"), x.get("ParentIndexNumber"), x.get("IndexNumber")) in reps:
            skipped["upgrades"] += 1
            continue
        g = shows.get(x["SeriesId"])
        if not g:
            g = shows[x["SeriesId"]] = {
                "kind": "show", "id": x["SeriesId"], "title": s.get("Name") or x.get("SeriesName") or "?",
                "year": s.get("ProductionYear"), "rating": po_rating(s), "added": "", "episodes": 0, "seasons": set(),
                "new_series": (s.get("DateCreated") or "")[:19] >= floor,
                "img": x["SeriesId"] if ((s.get("ImageTags") or {}).get("Primary") or x.get("SeriesPrimaryImageTag")
                                         or not s) else None}
        g["episodes"] += 1
        g["added"] = max(g["added"], x.get("DateCreated") or "")
        if isinstance(x.get("ParentIndexNumber"), int):
            g["seasons"].add(x["ParentIndexNumber"])
    for g in shows.values():
        g["seasons"] = sorted(g["seasons"])
    return items + list(shows.values()), skipped


def po_rank(x):
    return (x["rating"] is not None, x["rating"] or 0, x["added"])


def po_texts(now, days, movies, shows, eps):
    loc, start = now.astimezone(ZRH), (now - timedelta(days=days)).astimezone(ZRH)
    kw = loc.isocalendar()[1]
    rng = (f"{start.day}–{loc.day} {PO_MON[loc.month - 1]}" if (start.month, start.year) == (loc.month, loc.year)
           else f"{start.day} {PO_MON[start.month - 1]} – {loc.day} {PO_MON[loc.month - 1]}")
    when = "this week" if days == 7 else f"in the last {days} days"
    head = f"Neu auf dem Server · KW {kw}"
    sub = f"New on the server {when} · {rng}"
    parts = [plural(movies, "movie")] if movies else []
    if shows:
        parts.append(f"{plural(shows, 'show')} ({plural(eps, 'new episode')})")
    counts = " · ".join(parts) or "nothing new"
    de = [f"{movies} {'Film' if movies == 1 else 'Filme'}"] if movies else []
    if shows:
        de.append(f"{shows} {'Serie' if shows == 1 else 'Serien'} ({eps} {'neue Folge' if eps == 1 else 'neue Folgen'})")
    caption = f"🎬 Neu auf dem Server (KW {kw}): {', '.join(de) or 'nichts'}.\nNew {when}: {counts}."
    return head, sub, counts, caption


def po_font(bold, size):
    from PIL import ImageFont
    for n in (["noto/NotoSans-Bold.ttf", "dejavu/DejaVuSans-Bold.ttf"] if bold
              else ["noto/NotoSans-Regular.ttf", "dejavu/DejaVuSans.ttf"]):
        try:
            return ImageFont.truetype(os.path.join(PO_FONTS, n), size)
        except OSError:
            pass
    raise ApiError(f"posters: no Noto Sans or DejaVu Sans font under {PO_FONTS} (fonts-noto-core, fonts-dejavu-core)")


def po_tw(draw, s, font):
    b = draw.textbbox((0, 0), s, font=font)
    return b[2] - b[0]


def po_fit(draw, s, font, w):
    """Shorten s with an ellipsis until it fits w pixels."""
    if po_tw(draw, s, font) <= w:
        return s
    while s and po_tw(draw, s + "…", font) > w:
        s = s[:-1]
    return s.rstrip() + "…"


def po_wrap(draw, s, font, w, lines=2):
    words, out = s.split(), []
    while words and len(out) < lines:
        line = words.pop(0)
        while words and po_tw(draw, line + " " + words[0], font) <= w:
            line += " " + words.pop(0)
        out.append(line)
    if words:
        out[-1] = out[-1] + " " + " ".join(words)
    return [po_fit(draw, x, font, w) for x in out]


def po_star(draw, cx, cy, r, fill):
    pts = []
    for i in range(10):
        a = math.pi / 2 + i * math.pi / 5
        rr = r if i % 2 == 0 else r * 0.45
        pts.append((cx + rr * math.cos(a), cy - rr * math.sin(a)))
    draw.polygon(pts, fill=fill)


def po_image(item_id, w, warns):
    """Emby's Primary image of an item (X-Emby-Token header, GET), as a PIL image, or None."""
    from PIL import Image
    import io
    c = CFG.get("emby") or {}
    if not item_id or not re.fullmatch(r"[0-9a-fA-F]+", str(item_id)) or not c.get("url") or not c.get("key"):
        return None
    url = c["url"].rstrip("/") + f"{EMBY}/Items/{item_id}/Images/Primary?maxWidth={w}&quality=90"
    try:
        with svc_open("emby", urllib.request.Request(url, headers={"X-Emby-Token": svc_key("emby")}), TIMEOUT) as r:
            data = r.read(PO_IMG_MAX + 1)
        if len(data) > PO_IMG_MAX:
            return None
        im = Image.open(io.BytesIO(data))
        im.load()
        return im.convert("RGB")
    except urllib.error.HTTPError as e:
        if e.code != 404:
            warns.append(f"poster HTTP {e.code}")
    except Exception as e:      # network errors, broken or unknown image data: a placeholder tile instead
        warns.append(f"poster: {type(e).__name__}")
    return None


def po_placeholder(title, w, h):
    from PIL import Image, ImageDraw
    hsh = int(hashlib.sha1(title.encode()).hexdigest()[:6], 16)
    c1, c2 = PO_C[("a1", "a2", "a3")[hsh % 3]], PO_C["card"]
    im = Image.new("RGB", (w, h), c2)
    d = ImageDraw.Draw(im)
    for y in range(h):          # vertical gradient accent -> card
        t = y / max(h - 1, 1)
        d.line([(0, y), (w, y)], fill=tuple(int(a * (1 - t) * 0.55 + b * (1 - (1 - t) * 0.55)) for a, b in zip(c1, c2)))
    f = po_font(True, max(18, w // 9))
    lines = po_wrap(d, title, f, w - 24, 4)
    lh = f.size + 8
    y0 = (h - lh * len(lines)) // 2
    for i, ln in enumerate(lines):
        d.text(((w - po_tw(d, ln, f)) // 2, y0 + i * lh), ln, font=f, fill=PO_C["fg"])
    return im


def po_render(sections, more, head, sub, counts, out, warns):
    """Draw the collage PNG (PO_W wide, height as needed) -> (width, height)."""
    from PIL import Image, ImageDraw, ImageFilter, ImageOps
    import concurrent.futures
    n = sum(len(v) for _, v, _ in sections)
    cols = 3 if n <= 9 else 4 if n <= 16 else 5
    M, G = 48, 22
    tw = (PO_W - 2 * M - (cols - 1) * G) // cols
    th = tw * 3 // 2
    fs = {3: 30, 4: 26, 5: 23}[cols]
    ft, fm, fb = po_font(True, fs), po_font(False, fs - 3), po_font(True, max(18, fs - 5))
    fh, fsub, fsec = po_font(True, 60), po_font(False, 32), po_font(True, 40)
    cell = th + 16 + 2 * (fs + 8) + fs + 14
    sec_h = 96
    top = 56 + 78 + 46 + 46 + 40
    height = top + sum(sec_h + math.ceil(len(v) / cols) * (cell + G) for _, v, _ in sections if v) + (70 if more else 0) + 90
    img = Image.new("RGB", (PO_W, height), PO_C["bg"])
    glow = Image.new("RGB", (PO_W // 8, height // 8), PO_C["bg"])   # soft accent light, cheap at 1/8 scale
    gd = ImageDraw.Draw(glow)
    gd.ellipse([-40, -50, 80, 40], fill=(70, 34, 70))
    gd.ellipse([70, -40, 180, 30], fill=(40, 34, 90))
    img.paste(glow.filter(ImageFilter.GaussianBlur(14)).resize((PO_W, height)), (0, 0))
    d = ImageDraw.Draw(img)
    hf = fh
    while po_tw(d, head, hf) > PO_W - 2 * M and hf.size > 36:
        hf = po_font(True, hf.size - 4)
    y = 56
    d.text((M, y), head, font=hf, fill=PO_C["fg"])
    y += 78
    d.text((M, y), po_fit(d, sub, fsub, PO_W - 2 * M), font=fsub, fill=PO_C["mute"])
    y += 46
    d.text((M, y), po_fit(d, counts, fsub, PO_W - 2 * M), font=fsub, fill=PO_C["a3"])
    y += 46 + 14
    for i in range(PO_W - 2 * M):   # accent rule a1 -> a2
        t = i / (PO_W - 2 * M)
        d.line([(M + i, y), (M + i, y + 4)], fill=tuple(int(a + (b - a) * t) for a, b in zip(PO_C["a1"], PO_C["a2"])))
    y = top
    want = [it for _, v, _ in sections for it in v]
    with concurrent.futures.ThreadPoolExecutor(6) as ex:
        pics = list(ex.map(lambda it: po_image(it.get("img"), tw * 2, warns), want))
    pic = {id(it): p for it, p in zip(want, pics)}
    mask = Image.new("L", (tw, th), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, tw - 1, th - 1], radius=18, fill=255)
    for name, v, total in sections:
        if not v:
            continue
        d.text((M, y + 28), name, font=fsec, fill=PO_C["fg"])
        cnt = str(total)
        d.text((PO_W - M - po_tw(d, cnt, fsec), y + 28), cnt, font=fsec, fill=PO_C["mute"])
        y += sec_h
        for k, it in enumerate(v):
            x0, y0 = M + (k % cols) * (tw + G), y + (k // cols) * (cell + G)
            p = pic.get(id(it))
            p = ImageOps.fit(p, (tw, th), Image.LANCZOS) if p else po_placeholder(it["title"], tw, th)
            d.rounded_rectangle([x0 + 3, y0 + 6, x0 + tw + 3, y0 + th + 6], radius=18, fill=(5, 5, 9))
            img.paste(p, (x0, y0), mask)
            if it["kind"] == "show":
                badge = ("NEU · " if it.get("new_series") else "+") + f"{it['episodes']} Ep."
                bw = po_tw(d, badge, fb) + 26
                d.rounded_rectangle([x0 + 10, y0 + 10, x0 + 10 + bw, y0 + 10 + fb.size + 16], radius=(fb.size + 16) // 2,
                                    fill=PO_C["a1"] if it.get("new_series") else PO_C["a2"])
                d.text((x0 + 23, y0 + 14), badge, font=fb, fill=(255, 255, 255))
            ty = y0 + th + 14
            for ln in po_wrap(d, it["title"], ft, tw):
                d.text((x0, ty), ln, font=ft, fill=PO_C["fg"])
                ty += fs + 8
            ty = y0 + th + 14 + 2 * (fs + 8) + 2
            mx = x0
            meta = " · ".join(str(s) for s in (it.get("year"), po_seasons(it["seasons"]) if it.get("seasons") else None) if s)
            if meta:
                d.text((mx, ty), meta, font=fm, fill=PO_C["mute"])
                mx += po_tw(d, meta + "  ", fm)
            if it.get("rating") is not None:
                r = fm.size * 0.42
                po_star(d, mx + r, ty + fm.size * 0.62, r, PO_C["star"])
                d.text((mx + 2 * r + 6, ty), f"{it['rating']:.1f}", font=fm, fill=PO_C["star"])
        y += math.ceil(len(v) / cols) * (cell + G)
    if more:
        s = f"+ {more} weitere · {more} more"
        d.text(((PO_W - po_tw(d, s, fsec)) // 2, y + 6), s, font=fsec, fill=PO_C["mute"])
        y += 70
    s = "Wünsche? Über Seerr anfragen · Requests via Seerr"
    d.text(((PO_W - po_tw(d, s, fm)) // 2, y + 24), s, font=fm, fill=PO_C["mute"])
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    tmp = out + ".tmp"
    img.save(tmp, "PNG", optimize=True)
    os.replace(tmp, out)
    return img.size


def cmd_posters(a):
    try:
        import PIL  # noqa: F401
    except ImportError:
        die("posters needs Pillow for this python3 (apt: python3-pil)")
    if a.days < 1 or a.max < 1:
        die("--days and --max must be at least 1")
    warns, now = [], now_utc()
    since = now - timedelta(days=a.days)
    uid = ct_guid(lambda: seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER"))
    items, skipped = po_collect(uid, since, warns)
    items.sort(key=po_rank, reverse=True)
    movies = [x for x in items if x["kind"] == "movie"]
    shows = [x for x in items if x["kind"] == "show"]
    qs = min(len(shows), a.max - min(len(movies), max(a.max // 2, a.max - len(shows))))
    qm = min(len(movies), a.max - qs)       # best rated per section; each gets at least half of --max if it can use it
    shown, more = movies[:qm] + shows[:qs], len(items) - qm - qs
    eps = sum(x["episodes"] for x in shows)
    head, sub, counts, caption = po_texts(now, a.days, len(movies), len(shows), eps)
    day = now.astimezone(ZRH).strftime("%Y-%m-%d")
    out = os.path.expanduser(a.out or os.path.join(REPORT_DIR, f"new-on-server-{day}.png"))
    size = None
    if items:
        sections = [("Filme · Movies", movies[:qm], len(movies)), ("Serien · Shows", shows[:qs], len(shows))]
        size = po_render(sections, more, head, sub, counts, out, warns)
    warns = list(dict.fromkeys(warns))
    send = len(items) >= PO_NOTE_MIN
    left = ", ".join(f"{v} {k}" for k, v in sorted(skipped.items()) if v)
    if a.cron and items:
        note = os.path.join(os.path.expanduser(PO_INBOX), f"media-posters-{day}.md")
        body = [f"# media posters: weekly collage ready ({head})", f"- Image: {out} ({size[0]}x{size[1]})",
                f"- New: {counts} = {len(items)} items" + (f"; left out: {left}" if left else ""),
                f"- Send: {'yes' if send else 'no'} (JOBS.md: to him as a photo only with >= {PO_NOTE_MIN} new items; "
                "never to friends, he forwards it himself)",
                "- Caption: " + caption.replace("\n", " / ")]
        body += [f"- Warning: {w}" for w in warns]
        os.makedirs(os.path.dirname(note), exist_ok=True)
        with open(note + ".tmp", "w") as f:
            f.write("\n".join(body) + "\n")
        os.replace(note + ".tmp", note)
    if a.json:
        emit_json({"path": out if items else None, "size": list(size) if size else None, "header": head,
                   "subtitle": sub, "counts": counts, "caption": caption, "movies": len(movies), "shows": len(shows),
                   "episodes": eps, "total": len(items), "shown": len(shown), "more": more, "send": send,
                   "skipped": dict(skipped), "warnings": warns,
                   "items": [{k: x.get(k) for k in ("kind", "id", "title", "year", "rating", "episodes", "seasons",
                                                    "new_series")} for x in shown]})
    elif items:
        print(f"Collage: {out} ({size[0]}x{size[1]})")
        print(f"{head} · {counts}" + (f" · left out: {left}" if left else ""))
        print(f"Caption: {caption}")
    else:
        print(f"Nothing new in the last {a.days} days" + (f" (left out: {left})" if left else "") + ".")
    for w in warns:
        print(f"media: warning: {w}", file=sys.stderr)
    sys.exit(3 if warns else 0)


# ---------- digest: daily / weekly summary cards for the friends' Seerr Telegram group (GET-only; Pillow) ----------
# Posting goes through Seerr's own bot (token + chat id read from Seerr's Telegram settings at send time, held in
# memory only); off unless ~/.config/media/digest.json has "enabled": true. Card and caption carry no names (who
# asked, who watched: the Mini App pages only); no paths, no IPs.
DG_CONF = os.environ.get("MEDIA_DIGEST_CONF") or "~/.config/media/digest.json"
DG_STATE = os.environ.get("MEDIA_DIGEST_STATE") or "~/.local/state/media/digest.json"
DG_TG_REAL = "https://api.telegram.org"
DG_TG_API = os.environ.get("MEDIA_DIGEST_TG_API") or DG_TG_REAL
DG_SNAP_DAYS = 10
DG_WD = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
DG_MAX_H = 2560        # Telegram keeps photos at most 2560 px on the long side: taller cards get scaled down
DG_QRANK = {"blurayraw": 7, "bluray": 6, "webdl": 5, "web": 5, "webrip": 4, "television": 3, "tv": 3, "hdtv": 3,
            "dvd": 2}
DG_FOOT = "Want something? Request it in Seerr"


def dg_json(path):
    try:
        with open(os.path.expanduser(path)) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def dg_save(st):
    p = os.path.expanduser(DG_STATE)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p + ".tmp", "w") as f:
        json.dump(st, f, ensure_ascii=False)
    os.replace(p + ".tmp", p)


def dg_num(n):
    return f"{int(n):,}"


def dg_first(name, names):
    """A Seerr display name -> a first name only (no surname, no email); the config's "names" map wins."""
    name = str(name or "").strip()
    if name in names:
        return str(names[name])
    s = name.split("@")[0]
    s = re.sub(r"\d+$", "", re.split(r"[\s._+\-]+", s)[0] if s else "")
    if not re.search(r"[^\W\d_]", s):
        return None
    return s[:1].upper() + s[1:] if s.islower() else s


def dg_requests(uid, since, conf, done, warns):
    """Seerr requests that became available in the window -> [{kind, title, year, who: [first names], img, ...}]."""
    names, floor, found, skip = conf.get("names") or {}, iso_z(since)[:19], {}, 0
    for _ in range(20):
        d = get("seerr", f"/api/v1/request?filter=available&sort=modified&take=50&skip={skip}") or {}
        res = d.get("results") or []
        for r in res:
            m, when = r.get("media") or {}, str(r.get("updatedAt") or "")[:19]
            if when < floor or r.get("status") == 3 or m.get("status") not in (4, 5) or str(r.get("id")) in done:
                continue
            mt, tmdb = r.get("type") or m.get("mediaType"), m.get("tmdbId")
            if mt not in ("movie", "tv") or not tmdb:
                continue
            g = found.setdefault((mt, tmdb), {"kind": "movie" if mt == "movie" else "show", "tmdb": tmdb,
                                              "tvdb": m.get("tvdbId"), "who": [], "req_ids": [], "when": when})
            g["req_ids"].append(str(r.get("id")))
            who = dg_first((r.get("requestedBy") or {}).get("displayName"), names)
            if who and who not in g["who"]:
                g["who"].append(who)
        skip += len(res)
        if not res or str(res[-1].get("updatedAt") or "")[:19] < floor or skip >= ((d.get("pageInfo") or {}).get("results") or 0):
            break
    out = []
    for (mt, tmdb), g in sorted(found.items(), key=lambda kv: kv[1]["when"], reverse=True):
        try:
            x = get("seerr", f"/api/v1/{mt}/{int(tmdb)}") or {}
        except ApiError as e:
            warns.append(f"Seerr title {mt} {tmdb}: {e}")
            x = {}
        g["title"] = x.get("title") or x.get("name") or "?"
        g.update(tmdb_kind=mt, poster=x.get("posterPath"), overview=x.get("overview"), vote=x.get("voteAverage"))
        y = str(x.get("releaseDate") or x.get("firstAirDate") or "")[:4]
        g["year"], g["rating"], g["img"] = (int(y) if y.isdigit() else None), None, None
        pid = f"tmdb.{int(tmdb)}" if mt == "movie" or not g.get("tvdb") else f"tvdb.{int(g['tvdb'])}"
        try:
            e = get("emby", f"{EMBY}/Users/{uid}/Items?AnyProviderIdEquals={q(pid)}&Recursive=true&Limit=1"
                            f"&IncludeItemTypes={'Movie' if mt == 'movie' else 'Series'}&Fields=ImageTags,ProductionYear") or {}
            hit = (e.get("Items") or [None])[0] or {}
            g["emby_id"] = hit.get("Id")
            if (hit.get("ImageTags") or {}).get("Primary"):
                g["img"] = hit.get("Id")
        except ApiError:
            pass                    # no poster: the row draws a placeholder
        out.append(g)
    return out


def dg_names(who, n=4):
    """["Jacky", "Timon", "Ana"] -> "Jacky, Timon & Ana"; more than n -> "Jacky, Timon, Ana, Bo +2"."""
    who = list(who or [])
    if len(who) > n:
        return ", ".join(who[:n]) + f" +{len(who) - n}"
    return " & ".join(who) if len(who) <= 2 else ", ".join(who[:-1]) + " & " + who[-1]


def dg_watched(since, conf):
    """Tracearr plays (>= MIN_PLAY_S) since `since`, per title -> ranked [{kind, title, year, img, who}]
    (who = the viewers' first names, most plays first: for the Mini App pages, never the card or the Telegraph page)."""
    tracearr_cfg()
    names = conf.get("names") or {}
    agg, cur = {}, None
    for _ in range(40):
        d = get("tracearr", "/api/v2/public/history?pageSize=100" + (f"&cursor={q(cur)}" if cur else ""),
                timeout=max(TIMEOUT, 60)) or {}
        rows, stop = d.get("data") or [], False
        for h in rows:
            st = zdt(h.get("started_at"))
            if not st:
                continue
            if st < since:
                stop = True
                continue
            mt, ms = h.get("media_type"), h.get("duration_ms")
            ms = ms if isinstance(ms, (int, float)) else h.get("progress_ms") or 0
            if mt not in ("movie", "episode") or ms < MIN_PLAY_S * 1000:
                continue
            ep = mt == "episode"
            title = h.get("show_title") if ep else h.get("media_title")
            img = h.get("grandparent_rating_key") if ep else h.get("rating_key")
            if not title:
                continue
            g = agg.setdefault(("show" if ep else "movie", str(img or norm(title))), {
                "kind": "show" if ep else "movie", "title": title, "year": None if ep else h.get("year"),
                "rating": None, "img": img, "tmdb": None if ep else h.get("tmdb_id"), "users": set(), "plays": 0,
                "last": "", "by": collections.Counter()})
            u = h.get("user") or {}
            g["users"].add(str(u.get("id") or ""))
            first = dg_first(u.get("username"), names)
            if first:
                g["by"][first] += 1
            g["plays"] += 1
            g["last"] = max(g["last"], str(h.get("started_at") or ""))
        cur = (d.get("meta") or {}).get("nextCursor")
        if stop or not cur or not rows:
            break
    need = max(1, int(conf.get("min_viewers") or 1))
    out = sorted((g for g in agg.values() if len(g["users"]) >= need),
                 key=lambda g: (len(g["users"]), g["plays"], g["last"]), reverse=True)
    for g in out:
        g["uids"] = sorted(g.pop("users"))
        g["viewers"] = len(g["uids"])
        g["who"] = [n for n, _ in g.pop("by").most_common()]
    return out


def dg_merge_top(top):
    """One entry per (kind, title): a replaced file's old Emby id and its new one, once both carry the English title,
    pool their viewers, plays and names; re-ranked like dg_watched."""
    merged = {}
    for x in top:
        m = merged.setdefault((x["kind"], x["title"]), x)
        if m is not x:
            m["uids"] = sorted(set(m.get("uids") or []) | set(x.get("uids") or []))
            m["viewers"] = len(m["uids"]) or max(m.get("viewers") or 0, x.get("viewers") or 0)
            m["plays"] = (m.get("plays") or 0) + (x.get("plays") or 0)
            m["who"] = list(dict.fromkeys((m.get("who") or []) + (x.get("who") or [])))
            m["last"] = max(str(m.get("last") or ""), str(x.get("last") or ""))
    return sorted(merged.values(), key=lambda g: (g.get("viewers") or 0, g.get("plays") or 0, str(g.get("last") or "")),
                  reverse=True)


def dg_top_line(x):
    """A most-watched entry's second line on the card: viewer and play counts, else kind (+ year): no names."""
    v, p = x.get("viewers") or 0, x.get("plays") or 0
    bits = ([plural(v, "viewer")] if v > 1 else []) + ([plural(p, "play")] if p > 1 else [])
    if len(bits) < 2:
        kind = "Show" if x["kind"] == "show" else "Movie"
        bits.insert(0, kind + (f" · {x['year']}" if kind == "Movie" and x.get("year") and not bits else ""))
    return " · ".join(bits)


def dg_library():
    """Radarr movies + Sonarr series with files now: {movies: {id: bytes}, shows: {id: bytes}, episodes, bytes}."""
    mv = get("radarr", "/api/v3/movie", timeout=max(TIMEOUT, 90)) or []
    se = get("sonarr", "/api/v3/series", timeout=max(TIMEOUT, 90)) or []
    movies = {str(m["id"]): int(m.get("sizeOnDisk") or 0) for m in mv if m.get("hasFile") and m.get("id") is not None}
    shows, eps = {}, 0
    for s in se:
        st = s.get("statistics") or {}
        if (st.get("episodeFileCount") or 0) > 0 and s.get("id") is not None:
            shows[str(s["id"])] = int(st.get("sizeOnDisk") or 0)
            eps += int(st["episodeFileCount"])
    return {"movies": movies, "shows": shows, "episodes": eps, "bytes": sum(movies.values()) + sum(shows.values())}


def dg_qual(r):
    qq = (r.get("quality") or {}).get("quality") or {}
    src = str(qq.get("source") or "").lower()
    rank = 7 if str(qq.get("modifier") or "").lower() == "remux" else DG_QRANK.get(src, 0)
    return int(qq.get("resolution") or 0), rank


def dg_changes(since, warns):
    """Radarr/Sonarr history of the window: bytes imported/deleted, upgrades vs downgrades (deleted file's quality
    vs the import that replaced it), deletions that were not upgrades (cleanups), per unit (movies/episodes)."""
    out = {"added": 0, "freed": 0, "up": collections.Counter(), "down": collections.Counter(),
           "clean": collections.Counter(), "ok": []}
    for svc, unit, key in (("radarr", "movies", "movieId"), ("sonarr", "episodes", "episodeId")):
        inc = "includeMovie=true" if svc == "radarr" else "includeSeries=true&includeEpisode=true"
        try:
            recs = get(svc, f"/api/v3/history/since?date={q(iso_z(since))}&{inc}") or []
        except ApiError as e:
            warns.append(f"{svc} history: {e}")
            continue
        out["ok"].append(svc)
        imports, dels = {}, []
        for r in recs if isinstance(recs, list) else recs.get("records") or []:
            ev, size = r.get("eventType"), (r.get("data") or {}).get("size")
            size = int(size) if str(size or "").isdigit() else 0
            if ev in PO_IMPORT:
                out["added"] += size
                imports.setdefault(r.get(key), []).append(r)
            elif ev in PO_DELETE:
                out["freed"] += size
                dels.append(r)
        for r in dels:
            if (r.get("data") or {}).get("reason") != "Upgrade":
                out["clean"][unit] += 1
                continue
            t0 = zdt(r.get("date"))
            cand = imports.get(r.get(key)) or []
            new = min(cand, key=lambda i: abs(((zdt(i.get("date")) or t0) - t0).total_seconds())) if cand and t0 else None
            (out["down"] if new and dg_qual(new) < dg_qual(r) else out["up"])[unit] += 1
    return out


def dg_snapshot(st, lib, day):
    """Keep one library snapshot per day (DG_SNAP_DAYS) -> the one closest to 7 days back (6-9 days), or None."""
    snaps = {k: v for k, v in (st.get("library") or {}).items() if isinstance(v, dict)}
    if lib:
        snaps[day] = {"movies": lib["movies"], "shows": lib["shows"], "episodes": lib["episodes"], "bytes": lib["bytes"]}
    d0 = date.fromisoformat(day)
    keep = {k: v for k, v in snaps.items() if re.fullmatch(r"\d{4}-\d\d-\d\d", k)
            and 0 <= (d0 - date.fromisoformat(k)).days <= DG_SNAP_DAYS}
    st["library"] = keep
    old = [k for k in keep if 6 <= (d0 - date.fromisoformat(k)).days <= 9]
    return keep[min(old, key=lambda k: abs((d0 - date.fromisoformat(k)).days - 7))] if old else None


def dg_mix(items):
    """Movies (best rated first) and shows (brand-new series first, then rated) interleaved, so any first N is a mix."""
    mv = sorted((x for x in items if x["kind"] == "movie"), key=po_rank, reverse=True)
    sh = sorted((x for x in items if x["kind"] != "movie"), key=lambda x: (bool(x.get("new_series")),) + po_rank(x),
                reverse=True)
    out = []
    for i in range(max(len(mv), len(sh))):
        out += [x[i] for x in (mv, sh) if i < len(x)]
    return out


def dg_english(items, uid, warns):
    """English TMDB titles (Seerr's locale) for Emby items, by the item's Tmdb id; Emby's name stays as the fallback.
    Also fills year/rating where the item has none (the most-watched rows come from Tracearr without them)."""
    import concurrent.futures
    ek = lambda x: str(x.get("eid") or x.get("img") or "")
    ids = sorted({ek(x) for x in items if re.fullmatch(r"[0-9a-fA-F]+", ek(x))})
    meta = {}
    for i in range(0, len(ids), 50):
        try:
            d = get("emby", f"{EMBY}/Users/{uid}/Items?Ids={q(','.join(ids[i:i + 50]))}"
                            "&Fields=ProviderIds,ProductionYear,CommunityRating") or {}
            meta.update({str(x.get("Id")): x for x in d.get("Items") or []})
        except ApiError as e:
            warns.append(f"Emby ids for English titles: {e}")
    want = {}
    for x in items:
        e = meta.get(ek(x))
        if not e and not x.get("eid") and str(x.get("tmdb") or "").isdigit() and x["kind"] == "movie":
            try:            # a play of a file Emby has since replaced (upgrade = new item id): find it by Tmdb id
                d = get("emby", f"{EMBY}/Users/{uid}/Items?AnyProviderIdEquals={q('tmdb.' + str(x['tmdb']))}"
                                "&IncludeItemTypes=Movie&Recursive=true&Limit=1&Fields=ProviderIds,ProductionYear,CommunityRating") or {}
                e = (d.get("Items") or [None])[0]
            except ApiError:
                e = None
            x["img"] = (e or {}).get("Id") if ((e or {}).get("ImageTags") or {}).get("Primary") else None
            if not e:
                want.setdefault(("movie", int(x["tmdb"])), []).append(x)
        if not e:
            continue
        x["emby_id"] = e.get("Id")
        x["year"] = x.get("year") or e.get("ProductionYear")
        if x.get("rating") is None:
            x["rating"] = po_rating(e)
        tmdb = po_pid(e, "tmdb")
        if tmdb:
            want.setdefault(("movie" if x["kind"] == "movie" else "tv", tmdb), []).append(x)

    def one(k):
        try:
            return get("seerr", f"/api/v1/{k[0]}/{k[1]}") or {}
        except ApiError:
            return {}               # not on TMDB / Seerr down: Emby's name stays
    keys = sorted(want)
    with concurrent.futures.ThreadPoolExecutor(6) as ex:
        for k, d in zip(keys, ex.map(one, keys)):
            for x in want[k]:
                x["title"] = d.get("title") or d.get("name") or x["title"]
                x.update(tmdb_kind=k[0], tmdb=k[1], poster=d.get("posterPath"), overview=d.get("overview"),
                         vote=d.get("voteAverage"))


def dg_counts(movies, shows, eps):
    en = [plural(movies, "movie")] if movies else []
    if shows:
        en.append(f"{plural(shows, 'show')} ({plural(eps, 'episode')})")
    return ", ".join(en)


# --- drawing (the posters collage's look: PO_C colours, po_* fonts, tiles and header) ---
def dg_glow(img):
    """The soft pink/violet glow behind the header (scaled to the card's height, as on the posters collage)."""
    from PIL import Image, ImageDraw, ImageFilter
    W = img.width
    glow = Image.new("RGB", (W // 8, img.height // 8), PO_C["bg"])
    gd = ImageDraw.Draw(glow)
    gd.ellipse([-40, -50, 80, 40], fill=(70, 34, 70))
    gd.ellipse([70, -40, 180, 30], fill=(40, 34, 90))
    img.paste(glow.filter(ImageFilter.GaussianBlur(14)).resize((W, img.height)), (0, 0))


def dg_rule(d, y, W, M=48):
    for i in range(W - 2 * M):
        t = i / (W - 2 * M)
        d.line([(M + i, y), (M + i, y + 4)], fill=tuple(int(a + (b - a) * t) for a, b in zip(PO_C["a1"], PO_C["a2"])))


def dg_header(img, d, head, sub, counts):
    M, W = 48, img.width
    dg_glow(img)
    hf, fsub = po_font(True, 58), po_font(False, 32)
    while po_tw(d, head, hf) > W - 2 * M and hf.size > 36:
        hf = po_font(True, hf.size - 4)
    d.text((M, 52), head, font=hf, fill=PO_C["fg"])
    d.text((M, 128), po_fit(d, sub, fsub, W - 2 * M), font=fsub, fill=PO_C["mute"])
    d.text((M, 174), po_fit(d, counts, fsub, W - 2 * M), font=fsub, fill=PO_C["a3"])
    dg_rule(d, 234, W, M)
    return 262


def dg_sec(d, x, y, w, name, right=None, size=36):
    f = po_font(True, size)
    d.text((x, y), po_fit(d, name, f, w - (po_tw(d, right, f) + 24 if right else 0)), font=f, fill=PO_C["fg"])
    if right:
        d.text((x + w - po_tw(d, right, f), y), right, font=f, fill=PO_C["mute"])
    return y + 62


def dg_badge(d, x, y, s, fill, f):
    w = po_tw(d, s, f) + 26
    d.rounded_rectangle([x, y, x + w, y + f.size + 16], radius=(f.size + 16) // 2, fill=fill)
    d.text((x + 13, y + 4), s, font=f, fill=(255, 255, 255))


def dg_grid_geo(cols, lines):
    G = 22 if cols <= 4 else 16
    tw = (PO_W - 96 - (cols - 1) * G) // cols
    th = tw * 3 // 2
    fs = {3: 30, 4: 28, 5: 24, 6: 21}[cols]
    return G, tw, th, fs, th + 14 + lines * (fs + 8) + fs + 12


def dg_grid_h(n, cols, lines):
    G, _, _, _, cell = dg_grid_geo(cols, lines)
    rows = math.ceil(n / cols)
    return rows * cell + max(rows - 1, 0) * G


def dg_grid(img, d, y, items, cols, lines, pics, ranked=False):
    """Rows of poster tiles in the posters collage's style; ranked = 1..N badges instead of the episode badge."""
    from PIL import Image, ImageDraw, ImageOps
    G, tw, th, fs, cell = dg_grid_geo(cols, lines)
    ft, fm, fb = po_font(True, fs), po_font(False, fs - 3), po_font(True, max(18, fs - 3))
    mask = Image.new("L", (tw, th), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, tw - 1, th - 1], radius=16, fill=255)
    for k, it in enumerate(items):
        x0, y0 = 48 + (k % cols) * (tw + G), y + (k // cols) * (cell + G)
        p = pics.get(id(it))
        p = ImageOps.fit(p, (tw, th), Image.LANCZOS) if p else po_placeholder(it["title"], tw, th)
        d.rounded_rectangle([x0 + 3, y0 + 6, x0 + tw + 3, y0 + th + 6], radius=16, fill=(5, 5, 9))
        img.paste(p, (x0, y0), mask)
        if ranked:
            r = fb.size + 8
            d.ellipse([x0 + 10, y0 + 10, x0 + 10 + 2 * r, y0 + 10 + 2 * r], fill=PO_C["a1"] if k == 0 else PO_C["a2"])
            s = str(k + 1)
            d.text((x0 + 10 + r - po_tw(d, s, fb) / 2, y0 + 10 + r - fb.size * 0.62), s, font=fb, fill=(255, 255, 255))
        elif it.get("episodes"):
            n = it["episodes"]
            dg_badge(d, x0 + 10, y0 + 10, (f"NEW · {n} ep" if it.get("new_series") else f"+{n} ep") + ("" if n == 1 else "s"),
                     PO_C["a1"] if it.get("new_series") else PO_C["a2"], fb)
        ty = y0 + th + 14
        for ln in po_wrap(d, it["title"], ft, tw, lines):
            d.text((x0, ty), ln, font=ft, fill=PO_C["fg"])
            ty += fs + 8
        dg_meta(d, x0, y0 + th + 14 + lines * (fs + 8) + 2, tw, it, fm)
    return y + dg_grid_h(len(items), cols, lines)


def dg_meta(d, x0, ty, tw, it, fm):
    """A tile's meta line: year · seasons (or "Show") and the ★ rating, fitted to tw."""
    meta = " · ".join(str(s) for s in (it.get("year"), po_seasons(it["seasons"]) if it.get("seasons") else None,
                                       None if it.get("year") or it.get("seasons") else
                                       ("Show" if it["kind"] == "show" else None)) if s)
    mx = x0
    if meta:
        d.text((mx, ty), po_fit(d, meta, fm, tw), font=fm, fill=PO_C["mute"])
        mx += po_tw(d, meta + "  ", fm)
    if it.get("rating") is not None and mx + fm.size * 3 < x0 + tw:
        r = fm.size * 0.42
        po_star(d, mx + r, ty + fm.size * 0.62, r, PO_C["star"])
        d.text((mx + 2 * r + 6, ty), f"{it['rating']:.1f}", font=fm, fill=PO_C["star"])


DG_ROW = 100


def dg_rows(img, d, x, y, w, rows, pics, rank0=None):
    """Thumbnail rows: [rank] poster thumb, title, a second line (kind, year, counts)."""
    from PIL import Image, ImageDraw, ImageOps
    tw, th = 60, 90
    ft, fm, fr = po_font(True, 28), po_font(False, 24), po_font(True, 38)
    mask = Image.new("L", (tw, th), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, tw - 1, th - 1], radius=10, fill=255)
    for k, it in enumerate(rows):
        yy, xx = y + k * DG_ROW, x
        if rank0 is not None:
            s = str(rank0 + k)
            d.text((xx + (44 - po_tw(d, s, fr)) / 2, yy + 22), s, font=fr,
                   fill=PO_C["a1"] if rank0 + k == 1 else PO_C["mute"])
            xx += 54
        p = pics.get(id(it))
        p = ImageOps.fit(p, (tw, th), Image.LANCZOS) if p else po_placeholder(it["title"], tw, th)
        img.paste(p, (xx, yy), mask)
        tx, room = xx + tw + 18, w - (xx - x) - tw - 18
        d.text((tx, yy + 10), po_fit(d, it["title"], ft, room), font=ft, fill=PO_C["fg"])
        d.text((tx, yy + 50), po_fit(d, it["line"], fm, room), font=fm, fill=PO_C["mute"])
    return y + len(rows) * DG_ROW


def dg_rows2(img, d, y, items, pics, ranked=False):
    """Two columns of rows, column-major (1-5 left, 6-10 right) -> y below."""
    if not items:
        return y
    half = math.ceil(len(items) / 2) if len(items) > 1 else 1
    cw = (PO_W - 96 - 40) // 2
    for i, col in enumerate((items[:half], items[half:])):
        dg_rows(img, d, 48 + i * (cw + 40), y, cw, col, pics, (1 + i * half) if ranked else None)
    return y + half * DG_ROW


def dg_tiles(d, y, tiles):
    n, G = len(tiles), 18
    w = (PO_W - 96 - (n - 1) * G) // n
    fl, fv, fs = po_font(False, 24), po_font(True, 44), po_font(False, 22)
    for k, (label, value, sub, col) in enumerate(tiles):
        x = 48 + k * (w + G)
        d.rounded_rectangle([x, y, x + w, y + 168], radius=18, fill=PO_C["card"])
        d.rounded_rectangle([x, y, x + w, y + 8], radius=4, fill=PO_C[col])
        d.text((x + 18, y + 24), po_fit(d, label, fl, w - 36), font=fl, fill=PO_C["mute"])
        vf = fv
        while po_tw(d, value, vf) > w - 36 and vf.size > 26:
            vf = po_font(True, vf.size - 2)
        d.text((x + 18, y + 62), value, font=vf, fill=PO_C["fg"])
        d.text((x + 18, y + 124), po_fit(d, sub, fs, w - 36), font=fs, fill=PO_C["mute"])
    return y + 168


def dg_chips(d, y, chips, draw=True):
    f, x = po_font(True, 28), 48
    for s, col in chips:
        w = po_tw(d, s, f) + 36
        if x + w > PO_W - 48 and x > 48:
            x, y = 48, y + f.size + 36
        if draw:
            d.rounded_rectangle([x, y, x + w, y + f.size + 22], radius=(f.size + 22) // 2, fill=PO_C["card"],
                                outline=PO_C[col], width=3)
            d.text((x + 18, y + 7), s, font=f, fill=PO_C["fg"])
        x += w + 14
    return y + f.size + 22


def dg_pics(items, warns):
    import concurrent.futures
    items = [it for it in items if it.get("img")]
    with concurrent.futures.ThreadPoolExecutor(6) as ex:
        got = list(ex.map(lambda it: po_image(it["img"], it.get("_w", 400), warns), items))
    return {id(it): p for it, p in zip(items, got)}


def dg_daily_fit(n_new, n_req, n_top):
    """How many new tiles / request rows / most-watched entries fit in DG_MAX_H (trim most watched, then new)."""
    new, req, top = min(n_new, 12), min(n_req, 6), min(n_top, 10)

    def h(new, req, top):
        return (262 + (62 + dg_grid_h(new, 4, 2) + 30 if new else 0) + (62 + math.ceil(req / 2) * DG_ROW + 20 if req else 0)
                + (62 + math.ceil(top / 2) * DG_ROW + 20 if top else 0) + 80)
    while h(new, req, top) > DG_MAX_H:
        if top > 6:
            top -= 2
        elif new > 8:
            new = (math.ceil(new / 4) - 1) * 4
        elif req > 2:
            req -= 2
        else:
            break
    return new, req, top, h(new, req, top)


def dg_render(kind, v, out, warns):
    """Draw the daily or weekly card PNG (1080 wide, as tall as the content needs, at most DG_MAX_H) -> (w, h)."""
    from PIL import Image, ImageDraw
    W, M = PO_W, 48
    if kind == "daily":
        nn, nr, nt, h = dg_daily_fit(len(v["new"]), len(v["reqs"]), len(v["top"]))
        new, reqs, top = v["new"][:nn], v["reqs"][:nr], v["top"][:nt]
        for it in new:
            it["_w"] = 460
        for it in reqs + top:
            it["_w"] = 160
        img = Image.new("RGB", (W, h), PO_C["bg"])
        d = ImageDraw.Draw(img)
        y = dg_header(img, d, v["head"], v["sub"], v["counts"])
        pics = dg_pics(new + reqs + top, warns)
        if new:
            more = len(v["new"]) - len(new)
            y = dg_sec(d, M, y, W - 2 * M, "New", f"+{more} more" if more else str(len(new)))
            y = dg_grid(img, d, y, new, 4, 2, pics) + 30
        if reqs:
            more = len(v["reqs"]) - len(reqs)
            y = dg_sec(d, M, y, W - 2 * M, "Requests fulfilled", f"+{more} more" if more else str(len(reqs)))
            y = dg_rows2(img, d, y, reqs, pics) + 20
        if top:
            y = dg_sec(d, M, y, W - 2 * M, "Most watched today")
            y = dg_rows2(img, d, y, top, pics, ranked=True) + 20
    else:
        top, new = v["top"][:10], v["new"][:10]
        f0 = ImageDraw.Draw(Image.new("RGB", (W, 10)))
        ch = dg_chips(f0, 0, v["chips"], draw=False) if v["chips"] else 0
        h = (262 + 168 + 34 + (62 + dg_grid_h(len(top), 5, 1) + 30 if top else 0)
             + (62 + dg_grid_h(len(new), 5, 2) + 30 if new else 0) + (62 + ch + 20 if v["chips"] else 0) + 80)
        for it in top + new:
            it["_w"] = 380
        img = Image.new("RGB", (W, h), PO_C["bg"])
        d = ImageDraw.Draw(img)
        y = dg_header(img, d, v["head"], v["sub"], v["counts"])
        pics = dg_pics(top + new, warns)
        y = dg_tiles(d, y, v["tiles"]) + 34
        if top:
            y = dg_sec(d, M, y, W - 2 * M, "Most watched this week")
            y = dg_grid(img, d, y, top, 5, 1, pics, ranked=True) + 30
        if new:
            more = v["new_total"] - len(new)
            y = dg_sec(d, M, y, W - 2 * M, "New this week", f"+{more} more" if more > 0 else None)
            y = dg_grid(img, d, y, new, 5, 2, pics) + 30
        if v["chips"]:
            y = dg_sec(d, M, y, W - 2 * M, "Changes")
            y = dg_chips(d, y, v["chips"]) + 20
    f = po_font(False, 24)
    d.text(((W - po_tw(d, DG_FOOT, f)) // 2, h - 56), DG_FOOT, font=f, fill=PO_C["mute"])
    return dg_save_png(img, out)


def dg_save_png(img, out):
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    img.save(out + ".tmp", "PNG", optimize=True)
    os.replace(out + ".tmp", out)
    return img.size


# --- compact style (digest.json "style": "compact", the default; "full" = the tall card above) ---
# A 4:5 teaser Telegram's chat view shows whole (a taller photo is cropped to its middle there): header with the
# date + one counts line, the top 8 new titles as a 4 x 2 poster grid (title one line + one meta line, so every row
# lines up), one strip for fulfilled requests (daily) or the library (weekly), most watched as a top-3 row, and a
# footer with "+N more in the list" (the "📖 Open list" button under the photo is the Mini App with everything).
DG_C_H = 1350           # 1080 x 1350 = 4:5
DG_C_NEW, DG_C_TOP = 8, 3
DG_C_HEAD, DG_C_GAP, DG_C_STRIP, DG_C_FOOT = 188, 22, 56, 78
DG_C_LABEL, DG_C_ROW = 44, 80


def dg_c_geo():
    G = 20
    tw = (PO_W - 96 - 3 * G) // 4
    th = tw * 3 // 2
    return G, tw, th, th + 74          # tile pitch: poster, title line, meta line


def dg_c_grid_h(n):
    G, _, _, cell = dg_c_geo()
    rows = math.ceil(n / 4)
    return rows * cell + max(rows - 1, 0) * G


def dg_c_height(n_grid, strip_top, n_top, strip_bottom):
    """The compact card's height for these sections (the same steps dg_render_c draws)."""
    y = DG_C_HEAD
    if n_grid:
        y += dg_c_grid_h(n_grid) + DG_C_GAP
    if strip_top:
        y += DG_C_STRIP + DG_C_GAP
    if n_top:
        y += DG_C_LABEL + DG_C_ROW + DG_C_GAP
    if strip_bottom:
        y += DG_C_STRIP + DG_C_GAP
    return y - DG_C_GAP + DG_C_FOOT


def dg_c_header(img, d, head, counts):
    M, W = 48, img.width
    dg_glow(img)
    hf, fc = po_font(True, 56), po_font(False, 30)
    while po_tw(d, head, hf) > W - 2 * M and hf.size > 36:
        hf = po_font(True, hf.size - 4)
    d.text((M, 34), head, font=hf, fill=PO_C["fg"])
    d.text((M, 108), po_fit(d, counts, fc, W - 2 * M), font=fc, fill=PO_C["a3"])
    dg_rule(d, 164, W, M)
    return DG_C_HEAD


def dg_c_grid(img, d, y, items, pics):
    """4 poster tiles a row; title on one line (ellipsis), the meta line right under it: rows always line up."""
    from PIL import Image, ImageDraw, ImageOps
    G, tw, th, cell = dg_c_geo()
    ft, fm, fb = po_font(True, 26), po_font(False, 23), po_font(True, 21)
    mask = Image.new("L", (tw, th), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, tw - 1, th - 1], radius=16, fill=255)
    for k, it in enumerate(items):
        x0, y0 = 48 + (k % 4) * (tw + G), y + (k // 4) * (cell + G)
        p = pics.get(id(it))
        p = ImageOps.fit(p, (tw, th), Image.LANCZOS) if p else po_placeholder(it["title"], tw, th)
        d.rounded_rectangle([x0 + 3, y0 + 6, x0 + tw + 3, y0 + th + 6], radius=16, fill=(5, 5, 9))
        img.paste(p, (x0, y0), mask)
        if it.get("episodes"):
            n = it["episodes"]
            dg_badge(d, x0 + 10, y0 + 10, (f"NEW · {n} ep" if it.get("new_series") else f"+{n} ep") + ("" if n == 1 else "s"),
                     PO_C["a1"] if it.get("new_series") else PO_C["a2"], fb)
        if it.get("req"):                   # a fulfilled request, on the poster's foot (who asked: the Mini App)
            dg_badge(d, x0 + 10, y0 + th - fb.size - 26, "Requested", PO_C["a3"], fb)
        d.text((x0, y0 + th + 12), po_fit(d, it["title"], ft, tw), font=ft, fill=PO_C["fg"])
        dg_meta(d, x0, y0 + th + 46, tw, it, fm)
    return y + dg_c_grid_h(len(items))


def dg_c_strip(d, y, label, col, entries, total=None):
    """One rounded line: an accent label, then entries [[(text, bold, colour), …], …] until the room ends;
    entries left out (or total - shown) become "+N more" on the right."""
    M, W = 48, PO_W
    fb, fr = po_font(True, 26), po_font(False, 26)
    d.rounded_rectangle([M, y, W - M, y + DG_C_STRIP], radius=DG_C_STRIP // 2, fill=PO_C["card"])
    d.ellipse([M + 20, y + DG_C_STRIP // 2 - 6, M + 32, y + DG_C_STRIP // 2 + 6], fill=PO_C[col])
    ty = y + (DG_C_STRIP - 36) // 2
    x = M + 46
    d.text((x, ty), label, font=fb, fill=PO_C[col])
    x += po_tw(d, label, fb) + 18
    right = W - M - 24
    total = len(entries) if total is None else total

    def width(runs):
        return sum(po_tw(d, t, fb if b else fr) for t, b, _ in runs)
    shown = 0
    for k, runs in enumerate(entries):
        rest = total - k - 1
        tail = po_tw(d, f"+{rest} more", fr) + 24 if rest > 0 else 0
        sep = po_tw(d, "  ·  ", fr) if k else 0
        if k and x + sep + width(runs) > right - tail:
            break
        if k:
            d.text((x, ty), "  ·  ", font=fr, fill=PO_C["mute"])
            x += sep
        if not k and x + width(runs) > right - tail:        # the first entry always shows: shorten its first run
            t0, b0, c0 = runs[0]
            room = right - tail - x - width(runs[1:])
            runs = [(po_fit(d, t0, fb if b0 else fr, max(room, 40)), b0, c0)] + list(runs[1:])
        for t, b, c in runs:
            f = fb if b else fr
            if x + po_tw(d, t, f) > right:
                t = po_fit(d, t, f, right - x)
            d.text((x, ty), t, font=f, fill=PO_C[c])
            x += po_tw(d, t, f)
        shown += 1
    if total > shown:
        s = f"+{total - shown} more"
        d.text((right - po_tw(d, s, fr), ty), s, font=fr, fill=PO_C["mute"])
    return y + DG_C_STRIP


def dg_c_top(img, d, y, label, items, pics):
    """Most watched as one row: three ranked entries with a small poster, title and kind."""
    from PIL import Image, ImageDraw, ImageOps
    M = 48
    d.text((M, y), label, font=po_font(True, 28), fill=PO_C["fg"])
    y += DG_C_LABEL
    G, tw, th = 24, 54, DG_C_ROW
    cw = (PO_W - 2 * M - 2 * G) // 3
    ft, fm, fr = po_font(True, 24), po_font(False, 21), po_font(True, 34)
    mask = Image.new("L", (tw, th), 0)
    ImageDraw.Draw(mask).rounded_rectangle([0, 0, tw - 1, th - 1], radius=10, fill=255)
    for k, it in enumerate(items):
        x = M + k * (cw + G)
        s = str(k + 1)
        d.text((x + (30 - po_tw(d, s, fr)) / 2, y + 16), s, font=fr, fill=PO_C["a1"] if k == 0 else PO_C["mute"])
        p = pics.get(id(it))
        p = ImageOps.fit(p, (tw, th), Image.LANCZOS) if p else po_placeholder(it["title"], tw, th)
        img.paste(p, (x + 40, y), mask)
        tx = x + 40 + tw + 14
        room = cw - (tx - x)
        d.text((tx, y + 10), po_fit(d, it["title"], ft, room), font=ft, fill=PO_C["fg"])
        d.text((tx, y + 45), po_fit(d, it.get("line") or "", fm, room), font=fm, fill=PO_C["mute"])
    return y + DG_C_ROW


def dg_c_footer(d, h, more):
    f, fb = po_font(False, 24), po_font(True, 24)
    runs = ([(f"+{more} more in the list", fb, PO_C["a3"]), ("  ·  ", f, PO_C["mute"])] if more > 0 else [])
    runs.append(("Request more in Seerr" if more > 0 else DG_FOOT, f, PO_C["mute"]))
    x = (PO_W - sum(po_tw(d, t, ff) for t, ff, _ in runs)) // 2
    for t, ff, c in runs:
        d.text((x, h - 54), t, font=ff, fill=c)
        x += po_tw(d, t, ff)


def dg_tag_who(new, reqs):
    """Mark the new titles that fulfil a request (same Emby id, else same kind + title): "req" (the card's badge) and
    "req_who", the requesters' first names (the Mini App pages only)."""
    for r in reqs:
        r["req"], r["req_who"] = True, list(r.get("who") or [])
    for x in new:
        for r in reqs:
            if ((r.get("emby_id") and r["emby_id"] == x.get("id"))
                    or (r["kind"] == x["kind"] and r["title"].casefold() == str(x.get("title") or "").casefold())):
                x["req"] = True
                x["req_who"] = list(dict.fromkeys((x.get("req_who") or []) + r["req_who"]))
                r["_tile"] = r.get("_tile", []) + [id(x)]


def dg_c_plan(kind, v):
    """What the compact card shows -> (grid items, more, strip_top, top, strip_bottom)."""
    if kind == "daily":
        pool, total = (v["new"], len(v["new"])) if v["new"] else (v["reqs"], len(v["reqs"]))
        grid = pool[:DG_C_NEW]
        more = total - len(grid)
        on_grid = {id(x) for x in grid}
        reqs = [x for x in v["reqs"] if id(x) not in on_grid and not on_grid & set(x.get("_tile") or [])]
        top_strip = ("Request fulfilled" if len(reqs) == 1 else "Requests fulfilled", "a3",
                     [[(x["title"], True, "fg")] for x in reqs]) if reqs else None
        bottom = None
    else:
        grid = v["new"][:DG_C_NEW]
        more = v["new_total"] - len(grid)
        top_strip = None
        bottom = ("Library", "a2", [[(s, False, "fg")] for s in v["lib_line"]]) if v.get("lib_line") else None
    top = v["top"][:DG_C_TOP]
    while dg_c_height(len(grid), top_strip, len(top), bottom) > DG_C_H and len(grid) > 4:
        more += len(grid) - 4
        grid = grid[:4]
    return grid, more, top_strip, top, bottom


def dg_render_c(kind, v, out, warns):
    """Draw the compact daily or weekly card (1080 wide, at most DG_C_H tall) -> (w, h)."""
    from PIL import Image, ImageDraw
    grid, more, top_strip, top, bottom = dg_c_plan(kind, v)
    h = dg_c_height(len(grid), top_strip, len(top), bottom)
    for it in grid:
        it["_w"] = 460
    for it in top:
        it["_w"] = 160
    img = Image.new("RGB", (PO_W, h), PO_C["bg"])
    d = ImageDraw.Draw(img)
    y = dg_c_header(img, d, v["page_title"], v["counts"])
    pics = dg_pics(grid + top, warns)
    if grid:
        y = dg_c_grid(img, d, y, grid, pics) + DG_C_GAP
    if top_strip:
        y = dg_c_strip(d, y, *top_strip) + DG_C_GAP
    if top:
        y = dg_c_top(img, d, y, "Most watched today" if kind == "daily" else "Most watched this week", top, pics) + DG_C_GAP
    if bottom:
        y = dg_c_strip(d, y, *bottom) + DG_C_GAP
    dg_c_footer(d, h, more)
    return dg_save_png(img, out)


def dg_style(conf, warns):
    s = str(conf.get("style") or "compact").strip().lower()
    if s not in ("compact", "full"):
        warns.append(f'digest.json "style": {s!r} is not compact or full: compact used')
        s = "compact"
    return s


# --- Telegram: Seerr's own bot, its own chat (the token stays in memory; never printed, logged or stored) ---
def dg_tg_target():
    s = get("seerr", "/api/v1/settings/notifications/telegram") or {}
    o = s.get("options") or {}
    tok, chat = str(o.get("botAPI") or ""), str(o.get("chatId") or "")
    if not s.get("enabled") or not tok or not chat:
        raise ApiError("Seerr's Telegram agent is off or has no bot token / chat id")
    if not re.fullmatch(r"\d{5,}:[A-Za-z0-9_-]{20,}", tok):
        raise ApiError("Seerr's Telegram bot token has an unexpected format")
    return tok, chat, o.get("messageThreadId")


def dg_post(png, caption, page_url=None):
    """sendPhoto as Seerr's bot to Seerr's chat -> message_id. Errors never carry the token or the URL."""
    if DG_TG_API != DG_TG_REAL and LIVE:
        raise ApiError("MEDIA_DIGEST_TG_API works only with a test config (the real token goes to Telegram only)")
    tok, chat, thread = dg_tg_target()
    b = "----mediadigest" + hashlib.sha1(os.urandom(16)).hexdigest()
    fields = {"chat_id": chat, "caption": caption[:1024]}
    if page_url:
        fields["reply_markup"] = json.dumps({"inline_keyboard": [[{"text": "📖 Open list", "url": page_url}]]})
    if str(thread or "").strip():
        fields["message_thread_id"] = str(thread).strip()
    body = b"".join(f'--{b}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode() for k, v in fields.items())
    with open(png, "rb") as f:
        body += (f'--{b}\r\nContent-Disposition: form-data; name="photo"; filename="digest.png"\r\n'
                 'Content-Type: image/png\r\n\r\n').encode() + f.read() + f"\r\n--{b}--\r\n".encode()
    req = urllib.request.Request(f"{DG_TG_API}/bot{tok}/sendPhoto", data=body, method="POST",
                                 headers={"Content-Type": f"multipart/form-data; boundary={b}"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            res = json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            desc = str(json.loads(e.read() or b"{}").get("description") or "")
        except ValueError:
            desc = ""
        raise ApiError(f"telegram HTTP {e.code}: {desc.replace(tok, '***')[:200]}") from None
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as e:
        raise ApiError(f"telegram unreachable: {type(e).__name__}") from None
    finally:
        tok = req = None
    mid = (res.get("result") or {}).get("message_id") if res.get("ok") else None
    if not mid:
        raise ApiError(f"telegram refused: {str(res.get('description') or '')[:200]}")
    return mid


# --- Telegraph "Instant View" page per card (config "telegraph": true; --page with --dry-run publishes one preview) ---
# Public-by-link: titles, years, ratings, TMDB posters/overviews and links into his Seerr only. No requester names,
# no sizes, paths or IPs. The account token lives in DG_TPH_KEY (0600) and is never printed.
DG_TPH_REAL = "https://api.telegra.ph"
DG_TPH_API = os.environ.get("MEDIA_DIGEST_TELEGRAPH_API") or DG_TPH_REAL
DG_TPH_KEY = os.environ.get("MEDIA_DIGEST_TELEGRAPH_KEY") or "~/.secrets/telegraph-media"
DG_TMDB_IMG = "https://image.tmdb.org/t/p/w500"


def dg_tph_call(method, fields):
    req = urllib.request.Request(f"{DG_TPH_API}/{method}", data=urllib.parse.urlencode(fields).encode(), method="POST",
                                 headers={"Content-Type": "application/x-www-form-urlencoded"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            res = json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        raise ApiError(f"telegraph HTTP {e.code} on {method}") from None
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as e:
        raise ApiError(f"telegraph unreachable: {type(e).__name__}") from None
    finally:
        req = fields = None
    if not res.get("ok"):
        raise ApiError(f"telegraph {method}: {re.sub(r'[^A-Z0-9_ ]', '', str(res.get('error') or ''))[:80]}")
    return res.get("result") or {}


def dg_tph_token(conf):
    """The Telegraph account token (DG_TPH_KEY); the first call creates the account and stores it 0600."""
    p = os.path.expanduser(DG_TPH_KEY)
    try:
        with open(p) as f:
            t = f.read().strip()
        if t:
            return t
    except OSError:
        pass
    name = str(conf.get("telegraph_author") or "Media")
    r = dg_tph_call("createAccount", {"short_name": name[:32], "author_name": name[:128]})
    t = str(r.get("access_token") or "")
    if not t:
        raise ApiError("telegraph createAccount gave no token")
    os.makedirs(os.path.dirname(p), mode=0o700, exist_ok=True)
    fd = os.open(p + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(t + "\n")
    os.replace(p + ".tmp", p)
    return t


def dg_emby_web(conf, warns):
    """(public Emby base URL, ServerId) for item links, or None. The base is Seerr's Emby externalHostname (or the
    config's "emby_public_url"): a name, never an IP; checked live: its public info has this server's id and
    /web/index.html answers 200 (the item route itself is a client-side #! fragment)."""
    base = str(conf.get("emby_public_url") or (get("seerr", "/api/v1/settings/jellyfin") or {}).get("externalHostname") or "")
    sp = urllib.parse.urlsplit(base.strip())
    host = sp.hostname or ""
    try:
        ipaddress.ip_address(host)
        is_ip = True
    except ValueError:
        is_ip = False
    test_host = not LIVE and host == "127.0.0.1"      # the tests' fake server only
    if sp.scheme not in ("http", "https") or not host or ((is_ip or "." not in host) and not test_host):
        warns.append("no public Emby address (a name, not an IP): page without links")
        return None
    base = f"{sp.scheme}://{sp.netloc}{sp.path}".rstrip("/")
    sid = str((get("emby", f"{EMBY}/System/Info/Public") or {}).get("Id") or "")
    try:
        with urllib.request.urlopen(base + f"{EMBY}/System/Info/Public", timeout=15) as r:
            same = str(json.loads(r.read() or b"{}").get("Id") or "") == sid
        with urllib.request.urlopen(base + "/web/index.html", timeout=15) as r:
            web = r.status == 200
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as e:
        warns.append(f"public Emby address not reachable ({type(e).__name__}): page without links")
        return None
    if not (sid and same and web):
        warns.append("public Emby address is not this server or has no web app: page without links")
        return None
    return base, sid


def dg_trim(s, n=220):
    s = re.sub(r"\s+", " ", str(s or "")).strip()
    if len(s) <= n:
        return s
    cut = s[:n]
    i = cut.rfind(". ")
    return cut[:i + 1] if i > n // 2 else cut.rsplit(" ", 1)[0] + "…"


def dg_page_item(x, web, rank=None):
    eid = str(x.get("emby_id") or "")
    link = (f"{web[0]}/web/index.html#!/item?id={eid}&serverId={web[1]}"
            if web and re.fullmatch(r"[0-9a-fA-F]+", eid) else None)          # not in Emby (yet): no link
    out = []
    if re.fullmatch(r"/[\w.-]+\.(jpg|jpeg|png)", str(x.get("poster") or "")):
        out.append({"tag": "figure", "children": [{"tag": "img", "attrs": {"src": DG_TMDB_IMG + x["poster"]}}]})
    t = (f"{rank}. " if rank else "") + x["title"]
    out.append({"tag": "h4", "children": [{"tag": "a", "attrs": {"href": link}, "children": [t]} if link else t]})
    r = x.get("rating") if x.get("rating") is not None else x.get("vote")
    eps = x.get("episodes")
    meta = [str(x["year"]) if x.get("year") else None, "Movie" if x["kind"] == "movie" else "Show",
            f"★ {float(r):.1f}" if isinstance(r, (int, float)) and r > 0 else None,
            ("new series · " if x.get("new_series") else "+") + plural(eps, "episode") if eps else None]
    out.append({"tag": "p", "children": [{"tag": "em", "children": [" · ".join(m for m in meta if m)]}]})
    if dg_trim(x.get("overview")):
        out.append({"tag": "p", "children": [dg_trim(x.get("overview"))]})
    return out


def dg_page_nodes(kind, v, web):
    nodes = [{"tag": "p", "children": [v["sub"] + ": " + v["counts"] + "."
                                       + (" Tap a title to open it in Emby." if web else "")]}]
    secs = ([("New", v["page_new"], False), ("Requests fulfilled", v["reqs"], False), ("Most watched today", v["top"], True)]
            if kind == "daily" else [("Most watched this week", v["top"], True), ("New this week", v["page_new"], False)])
    for name, items, ranked in secs:
        if not items:
            continue
        nodes.append({"tag": "h3", "children": [f"{name} ({len(items)})" if not ranked else name]})
        for i, x in enumerate(items):
            nodes += dg_page_item(x, web, i + 1 if ranked else None)
    nodes.append({"tag": "hr"})
    if web:
        nodes.append({"tag": "p", "children": [{"tag": "a", "attrs": {"href": web[0] + "/web/index.html"}, "children": ["Open Emby"]}]})
    nodes.append({"tag": "p", "children": ["Want something? Request it in Seerr."]})
    return nodes


def dg_publish_page(kind, v, conf, warns):
    """createPage on Telegraph -> the page URL (a test API only with a test config)."""
    if DG_TPH_API != DG_TPH_REAL and LIVE:
        raise ApiError("MEDIA_DIGEST_TELEGRAPH_API works only with a test config")
    web = dg_emby_web(conf, warns)
    nodes = dg_page_nodes(kind, v, web)
    content = json.dumps(nodes, ensure_ascii=False)
    while len(content.encode()) > 60000 and v["page_new"]:     # Telegraph's 64 KB page limit
        v["page_new"] = v["page_new"][:-5]
        nodes = dg_page_nodes(kind, v, web)
        content = json.dumps(nodes, ensure_ascii=False)
    author = str(conf.get("telegraph_author") or "Media")[:128]
    r = dg_tph_call("createPage", {"access_token": dg_tph_token(conf), "title": v["page_title"][:256],
                                   "author_name": author, "content": content, "return_content": "false"})
    url = str(r.get("url") or "")
    if not re.fullmatch(r"https://[\w.-]+/[\w%.-]+", url):
        raise ApiError("telegraph createPage gave no page url")
    return url


# --- Telegram Mini App: static pages in the cards' look on the web VM's /media/ ---
