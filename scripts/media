def wr_html(s, plays, covers):
    """The offline single-file story page (no external requests; covers are data: URIs)."""
    E = html.escape

    def cov(item, title, cls="cov"):
        src = covers.get(str(item)) if item else None
        if src:
            return f'<img class="{cls}" src="{src}" alt="{E(title)}" loading="lazy">'
        ini = "".join(w[0] for w in re.findall(r"\w+", title)[:2]).upper() or "?"
        return f'<div class="{cls}" role="img" aria-label="{E(title)}">{E(ini)}</div>'

    def bars(rows, mx):
        return '<div class="bars">' + "".join(
            f'<div class="bar"><span class="lbl">{E(lbl)}</span><i style="width:{max(2, round(100 * v / mx)) if mx else 2}%"></i>'
            f'<em>{E(val)}</em></div>' for lbl, v, val in rows) + "</div>"

    yr = s["year"]
    span = f"so far · to {wr_ddmm(s['to'])}.{yr}" if s["partial"] else "the whole year"
    sec = [f'<section class="s1"><div class="kick">Emby Wrapped</div><h1>Your {yr}<br>on the big screen</h1>'
           f'<div class="sub">{E(span)}</div><div class="big">{s["hours"]:g} h</div>'
           f'<div class="sub">of films and shows, scroll down ↓</div></section>']
    if not s["plays"]:
        sec.append('<section class="s2"><h2>Nothing played yet.</h2></section>')
    else:
        sec.append(f'<section class="s2"><div class="kick">The year in numbers</div><h2>{plural(s["plays"], "play")} '
                   f'on {s["days"]} days</h2><div class="grid">'
                   f'<div class="tile"><b>{s["films"]}</b><span>films</span></div>'
                   f'<div class="tile"><b>{s["episodes"]}</b><span>episodes</span></div>'
                   f'<div class="tile"><b>{s["shows"]}</b><span>shows</span></div>'
                   f'<div class="tile"><b>{round(s["hours"] / max(1, s["days"]), 1):g} h</b><span>per watching day</span></div>'
                   '</div></section>')
        if s.get("genres"):
            g = s["genres"]
            sec.append(f'<section class="s3"><div class="kick">Your genres</div><h2>Mostly {E(g[0]["name"])}</h2>'
                       + bars([(x["name"], x["pct"], f'{x["pct"]} %') for x in g], g[0]["pct"]) + "</section>")
        if s.get("top_shows"):
            items = "".join(f'<div class="row"><span class="rank">{i}</span>{cov(x["cover"], x["name"])}<div>'
                            f'<div class="t">{E(x["name"])}</div><div class="m">{plural(x["episodes"], "episode")} · '
                            f'{x["hours"]:g} h</div></div></div>' for i, x in enumerate(s["top_shows"], 1))
            sec.append(f'<section class="s4"><div class="kick">Top shows</div><h2>{E(s["top_shows"][0]["name"])} '
                       f'ruled your year</h2><div class="list">{items}</div></section>')
        b = s["binge"]
        d = date.fromisoformat(b["day"])
        head = (f'{b["episodes"]} episodes in one day' if b["episodes"] else f'{b["hours"]:g} hours in one day')
        sec.append(f'<section class="s1"><div class="kick">Binge record</div><div class="row">'
                   f'{cov(b["cover"], b["show"], "cov lg")}<div><h2>{E(head)}</h2><div class="sub">'
                   f'{WD_LONG[d.weekday()][:-1]} {d:%d.%m.%Y} · {b["hours"]:g} h</div><div class="sub">mostly '
                   f'{E(b["show"])}</div></div></div></section>')
        mx_h, mx_w = max(s["hours_of_day"]) or 1, max(s["weekdays"]) or 1
        hist = "".join(f'<i title="{h:02d}:00 · {v:g} h" style="height:{max(2, round(100 * v / mx_h))}%"'
                       + (' class="top"' if h == s["fav_hour"] else "") + "></i>" for h, v in enumerate(s["hours_of_day"]))
        wdb = "".join(f'<div><i style="height:{max(3, round(100 * v / mx_w))}%"></i>{WD[i][:2]}</div>'
                      for i, v in enumerate(s["weekdays"]))
        sec.append(f'<section class="s5"><div class="kick">When you watch</div><h2>{WD_LONG[WD.index(s["fav_weekday"])]}, '
                   f'around {s["fav_hour"]:02d}:00</h2><div class="wd">{wdb}</div><div class="hist">{hist}</div>'
                   '<div class="axis"><span>00</span><span>06</span><span>12</span><span>18</span><span>23</span></div>'
                   "</section>")
        rw, f, l = s.get("rewatched"), s["first"], s["latest"]
        rows = []
        if rw:
            rows.append(f'<div class="row">{cov(rw["cover"], rw["title"])}<div><div class="kick">Most rewatched</div>'
                        f'<div class="t">{E(rw["title"])}</div><div class="m">{rw["times"]} times</div></div></div>')
        for lbl, x in (("First play", f), ("Latest play", l)):
            rows.append(f'<div class="row">{cov(x["cover"], x["title"])}<div><div class="kick">{lbl}</div>'
                        f'<div class="t">{E(x["title"])}</div><div class="m">{wr_ddmm(x["at"])}.{x["at"][:4]} '
                        f'{x["at"][11:16]}</div></div></div>')
        sec.append(f'<section class="s3"><div class="kick">Bookends</div><h2>{"Worth a second look" if rw else "Start to now"}'
                   f'</h2><div class="list">{"".join(rows)}</div></section>')
        if s.get("decades") or s.get("uhd_pct") is not None:
            dmx = max((x["films"] for x in s.get("decades") or []), default=1)
            ring = (f'<div class="row"><div class="ring" style="--p:{s["uhd_pct"]}"><b>{s["uhd_pct"]}%</b></div>'
                    f'<div class="sub">of your time in 4K<br>{plural(s["uhd_films"], "film")} in 4K</div></div>'
                    if s.get("uhd_pct") is not None else "")
            sec.append(f'<section class="s4"><div class="kick">Films by decade</div><h2>'
                       + (f'Hooked on the {E(s["top_decade"])}' if s.get("top_decade") else "Your films")
                       + "</h2>" + bars([(x["decade"], x["films"], str(x["films"])) for x in s.get("decades") or []], dmx)
                       + ring + "</section>")
        if s.get("film_wall"):
            wall = "".join(cov(x["cover"], x["title"]) for x in s["film_wall"][:WR_WALL])
            more_n = len(s["film_wall"]) - WR_WALL
            sec.append(f'<section class="s2"><div class="kick">Your film wall</div><h2>{plural(s["films"], "film")}</h2>'
                       f'<div class="wall">{wall}</div>' + (f'<div class="sub">+{more_n} more</div>' if more_n > 0 else "")
                       + "</section>")
        chips = "".join(f'<span class="chip">{E(x["name"])} · {x["pct"]} %</span>' for x in s.get("screens") or [])
        sec.append(f'<section class="s5"><div class="kick">Fun fact</div><div class="fact">{E(s.get("fun_fact") or "")}</div>'
                   + "".join(f'<div class="sub">{E(x)}</div>' for x in (s.get("facts") or [])[1:3])
                   + (f'<div class="kick">Your screens</div><div class="chips">{chips}</div>' if chips else "")
                   + "</section>")
    gen = now_utc().astimezone(ZRH).strftime("%d.%m.%Y %H:%M")
    return ("<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">"
            "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">"
            "<meta name=\"color-scheme\" content=\"dark\"><meta name=\"theme-color\" content=\"#0b0b12\">"
            f"<title>Emby Wrapped {yr}</title><style>{WR_CSS}</style></head><body>" + "".join(sec)
            + f"<footer>Generated {gen} from Emby Playback Reporting · your own plays only · offline page</footer>"
            "</body></html>\n")


def cmd_wrapped(a):
    today = now_utc().astimezone(ZRH).date()
    yr = a.year or today.year
    if not 2000 <= yr <= today.year:
        die(f"--year must be between 2000 and {today.year}")
    warns = []
    guid = wr_guid()
    rows = wr_rows(guid, yr)
    items = (soft(lambda: wr_items(rows), warns, "Emby library") or {}) if rows else {}
    s, plays = wr_stats(rows, items, yr, today)
    s["card"] = wr_card(s)
    if a.html:
        out = os.path.expanduser(a.html.replace("{year}", str(yr)))
        covers, cache, budget, cw = {}, {}, [WR_COVER_BUDGET], []
        if not a.no_covers and plays:
            want = [x["cover"] for x in s.get("top_shows") or []] + [(s.get("binge") or {}).get("cover")]
            want += [x["cover"] for x in (s.get("rewatched") or {}, s.get("first") or {}, s.get("latest") or {}) if x]
            want += [x["cover"] for x in (s.get("film_wall") or [])[:WR_WALL]]
            for i in want:
                if i and str(i) not in covers:
                    src = wr_cover(str(i), cache, budget, cw)
                    if src:
                        covers[str(i)] = src
        tmp = f"{out}.tmp{os.getpid()}"
        try:
            os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
            with open(tmp, "w") as fh:
                fh.write(wr_html(s, plays, covers))
            os.replace(tmp, out)
        except OSError as e:
            die(f"can't write {out}: {e.strerror or e}")
        s["html"] = {"path": out, "bytes": os.path.getsize(out), "covers": len(covers)}
        if cw:
            warns.append(f"covers: {len(cw)} failed ({cw[0]})")
    if a.json:
        emit_json({k: v for k, v in s.items()} | ({"warnings": warns} if warns else {}))
    else:
        print(s["card"])
        if a.html:
            h = s["html"]
            print(f"\nHTML: {h['path']} ({h['bytes'] / 1024:.0f} KB, {h['covers']} covers)")
    finish([w for w in warns if not w.startswith("covers:")], a.json)


# ---------- doctor: why hasn't a Seerr request reached Emby yet? ----------
# Reads Seerr requests + Radarr/Sonarr (movie/series, episodes, queue, history, interactive search) + Emby (provider id
# / name lookup) and fixes the routine cases: re-search, monitor again, drop + blocklist a failed/stalled download so
# the arr grabs another, retry a failed Seerr request. Never deletes or replaces library files; a name-mismatch grab
# (--grab) only on the owner's word.

DR_STATE = os.environ.get("MEDIA_DOCTOR_STATE") or "~/.local/state/media/doctor.json"
DR_SEARCH_DAYS = _env_num("MEDIA_DOCTOR_SEARCH_DAYS", 7)   # re-search / indexer probe per title at most this often
DR_RETRY_DAYS = 3                                          # Seerr retry per request at most this often
DR_STALL_H = _env_num("MEDIA_DOCTOR_STALL_HOURS", 48)      # a torrent stalled this long -> drop + re-grab
DR_FRESH_H = 24                                            # younger requests: the arr is still on it
DR_RETRY_MAX_DAYS = 90                                     # failed Seerr requests older than this: left alone
DR_CINEMA_DAYS = 90                                        # in cinemas this long without a home date -> "out"
DR_PROBES = int(_env_num("MEDIA_DOCTOR_PROBES", 12))       # interactive indexer searches per run
DR_NOTE_MIN = int(_env_num("MEDIA_DOCTOR_NOTE_MIN", 3))    # --cron: an ~/inbox note only from this many stuck on him
DR_INBOX = os.environ.get("MEDIA_DOCTOR_INBOX") or "~/inbox"
DR_PROBE_TIMEOUT = _env_num("MEDIA_DOCTOR_PROBE_TIMEOUT", 90)
DR_UNKNOWN = ("unknown movie", "unable to match", "unknown series", "unable to parse")
DR_ICON = {"available": "✅", "on_emby": "✅", "on_emby_other": "✅", "on_disk": "💾", "downloading": "⬇️",
           "queued": "⏳", "regrab": "🔁", "import_blocked": "⛔", "mismatch": "🔤", "rejected": "🚫",
           "not_released": "📅", "airing": "📅", "no_release": "🔍", "missing_eps": "🔍", "searching": "🔎",
           "fresh": "🆕", "pending": "⏸", "retried": "🔁", "no_metadata": "❔", "not_requested": "➕", "removed": "🗑",
           "error": "⚠️"}
DR_OWNER = {"import_blocked", "mismatch", "rejected", "pending", "error"}         # sorted first: his call
DR_ORDER = ["mismatch", "rejected", "import_blocked", "pending", "error", "regrab", "retried", "searching",
            "no_metadata", "missing_eps", "no_release", "fresh", "queued", "downloading", "not_released", "airing",
            "on_disk", "on_emby_other", "on_emby", "available", "removed", "not_requested"]
DR_SHOWN = set(DR_ORDER[:DR_ORDER.index("no_release") + 1])                     # --all: listed in full
DR_WAITING = {"fresh", "queued", "downloading", "not_released", "airing"}       # --all: one line each
DR_FWD = {   # (German, English) lines he can forward; {t} title, {eta}, {when_de}/{when_en}, {n}, {o}
    "available": ('"{t}" ist schon auf Emby 🎬', '"{t}" is already on Emby 🎬'),
    "on_emby": ('"{t}" ist schon auf Emby 🎬 (in der Anfrage-Liste steht\'s evtl. noch kurz als offen)',
