    "sci-fi": "Science Fiction", "scifi": "Science Fiction", "science-fiction": "Science Fiction",
    "suspense": "Thriller", "musical": "Music", "anime": "Animation", "children": "Kids", "sports": "Sport",
    "krimi": "Crime", "komödie": "Comedy", "abenteuer": "Adventure", "liebesfilm": "Romance", "romantik": "Romance",
    "dokumentarfilm": "Documentary", "dokumentation": "Documentary", "familie": "Family", "historie": "History",
    "kriegsfilm": "War", "musik": "Music", "zeichentrick": "Animation", "mystery-film": "Mystery",
    "драма": "Drama", "комедија": "Comedy", "ратни": "War", "трилер": "Thriller", "акциони": "Action",
    "љубавни": "Romance", "авантуристички": "Adventure", "крими": "Crime", "историјски": "History",
    "породични": "Family", "мистерија": "Mystery", "научна фантастика": "Science Fiction", "хорор": "Horror",
    "анимирани": "Animation", "документарни": "Documentary", "фантастика": "Fantasy", "музички": "Music",
    "вестерн": "Western",
}
TN_MOODS = {
    "light": ("Comedy", "Romance"), "funny": ("Comedy",),
    "chill": ("Comedy", "Animation", "Documentary"), "cozy": ("Comedy", "Romance", "Animation"),
    "dark": ("Thriller", "Crime", "Horror", "Mystery"), "tense": ("Thriller", "Mystery", "Crime"),
    "scary": ("Horror",), "action": ("Action", "Adventure"), "epic": ("Adventure", "Fantasy", "War", "History"),
    "mind": ("Science Fiction", "Mystery"), "smart": ("Science Fiction", "Documentary", "History", "Mystery"),
    "learn": ("Documentary", "History"), "doc": ("Documentary",), "docu": ("Documentary",),
    "date": ("Romance", "Comedy"), "romantic": ("Romance",), "sad": ("Drama",), "deep": ("Drama", "History", "War"),
    "kids": ("Family", "Animation", "Kids"),
}
TN_MOOD_AVOID = {m: {"Horror", "Thriller", "War"} for m in ("light", "funny", "chill", "cozy", "date", "romantic", "kids")}
TN_SLOTS = {"A": "🍿", "B": "📺", "C": "✨"}

Q_TN_PLAYS = ("SELECT ItemId FROM PlaybackActivity WHERE lower(replace(UserId,'-','')) = '{G}' AND PlayDuration >= 120"
              " GROUP BY ItemId ORDER BY max(DateCreated) DESC LIMIT 300")
Q_TN_MAP = ("SELECT ud.userId, count(*) FROM {L}UserDatas ud JOIN {L}MediaItems mi ON mi.UserDataKeyId = ud.UserDataKeyId"
            " WHERE (ud.played = 1 OR ud.playbackPositionTicks > 0) AND mi.Id IN ({IDS}) GROUP BY ud.userId"
            " ORDER BY 2 DESC LIMIT 5")
Q_TN_USER = ("SELECT 'U', mi.Id, mi.type, coalesce(mi.SeriesId,''), coalesce(mi.ParentIndexNumber,''),"
             " coalesce(mi.IndexNumber,''), ud.played, coalesce(ud.LastPlayedDateInt,''), ud.isFavorite,"
             " ud.playbackPositionTicks FROM {L}UserDatas ud JOIN {L}MediaItems mi ON mi.UserDataKeyId = ud.UserDataKeyId"
             " WHERE ud.userId = {U} AND mi.type IN (5,6,8)"
             " AND (ud.played = 1 OR ud.playbackPositionTicks > 0 OR ud.isFavorite = 1)")


def tn_clean(col):
    return f"replace(replace(coalesce({col},''),char(30),' '),char(31),' ')"


Q_TN_ITEMS = ("SELECT 'I', m.Id, m.type, " + tn_clean("m.Name") + ", coalesce(m.ProductionYear,''),"
              " coalesce(m.CommunityRating,''), coalesce(m.RunTimeTicks,''), " + tn_clean("m.ProviderIds") + ","
              " coalesce(m.DateCreated,''), " + tn_clean("coalesce((SELECT group_concat(g.Name,'|') FROM {L}ItemLinks2 il"
                                                          " JOIN {L}MediaItems g ON g.Id = il.LinkedId"
                                                          " WHERE il.ItemId = m.Id AND il.Type = 2), m.Genres)") +
              " FROM {L}MediaItems m WHERE m.type IN (5,6) AND m.ExtraType IS NULL AND (m.type = 6 OR m.Path IS NOT NULL)")
Q_TN_EPS = ("SELECT 'E', Id, SeriesId, coalesce(ParentIndexNumber,''), coalesce(IndexNumber,''), " + tn_clean("Name") + ","
            " coalesce(RunTimeTicks,''), coalesce(DateCreated,'') FROM {L}MediaItems"
            " WHERE type = 8 AND Path IS NOT NULL AND SeriesId IN ({IDS})")


def tn_sql(sql, db):
    """One read-only SELECT on Emby's library or playback DB. The lockdown verb ({db} template) takes it as is; the
    root command opens playback_reporting.db, so library tables are reached through ATTACH ... AS lib there."""
    lib = db == "library" and "{db}" not in emby_sql_cmd()
    sql = sql.replace("{L}", "lib." if lib else "").rstrip().rstrip(";") + ";\n"
    if lib:
        sql = f"ATTACH 'file:{EMBY_DIR}/library.db?immutable=1' AS lib;\n" + sql
    return emby_sql(sql, db)


def tn_num(s, cast=float):
    try:
        return cast(s) if s not in ("", None) else None
    except ValueError:
        return None


def tn_genres(raw):
    """'Sci-Fi & Fantasy|Krimi' -> {'Science Fiction', 'Fantasy', 'Crime'} (TMDB's English names)."""
    out = set()
    for g in re.split(r"[|,]", str(raw or "")):
        g = g.strip()
        parts = [g] if g.lower() in TN_ALIASES else re.split(r"\s+(?:&|and)\s+", g)
        for p in (x.strip() for x in parts):
            if p:
                out.add(TN_ALIASES.get(p.lower()) or TN_CANON.get(p.lower()) or p)
    return out


def tn_mood(words):
    """Mood words -> (label, genre set, genres to avoid, unknown words, quality). A word is a mood, a genre, an alias
    or a quality word ("good", "best", "gute" ...: rating first)."""
    label, genres, avoid, unknown, quality = [], set(), set(), [], False
    for w in words:
        k = w.lower().strip(" ,.!")
        if not k:
            continue
        if k in TN_QUALITY:
            label.append(k)
            quality = True
            continue
        hit = TN_MOODS.get(k) or ((TN_ALIASES.get(k) or TN_CANON.get(k)),)
        if hit[0]:
            label.append(k)
            genres |= set(hit)
            avoid |= TN_MOOD_AVOID.get(k, set())
        else:
            unknown.append(w)
    return " ".join(label) or None, genres, avoid - genres, unknown, quality


def tn_minutes(w):
    """'90' / '90m' / '1h30' / '1.5h' / '2h' -> minutes (a bare number up to 6 = hours), else None."""
    w = w.lower().strip()
    m = re.fullmatch(r"(\d{1,2})h(\d{1,2})(?:m|min)?", w)
    if m:
        return int(m[1]) * 60 + int(m[2])
    m = re.fullmatch(r"(\d+(?:[.,]\d+)?)\s*(?:h|hr|hrs|hour|hours|std)", w)
    if m:
        return round(float(m[1].replace(",", ".")) * 60)
    m = re.fullmatch(r"(\d{1,3})\s*(m|min|mins|minutes|')?", w)
    if m:
        n = int(m[1])
        return n * 60 if n <= 6 and not m[2] else n
    return None


def tn_parse_args(text):
    """Free text after /tonight -> (mood words, minutes or None)."""
    words, mins = [], None
    for w in str(text or "").split():
        n = tn_minutes(w)
        if n is not None and mins is None:
            mins = n
        else:
            words.append(w)
    return words, mins


def tn_recency(ts, now_ts):
    """Weight of a play by age: 1.15 today, ~0.5 after 7 months; 0.15 for unknown or bulk-marked dates."""
    if not ts:
        return 0.15
    return 0.15 + math.exp(-max(0.0, now_ts - ts) / 86400 / 240)


def tn_jitter(day, key):
    """A stable 0..1 per day and title: varies the order between days without randomness in tests."""
    return int(hashlib.sha256(f"{day}:{key}".encode()).hexdigest()[:8], 16) / 0xFFFFFFFF


def tn_link(template, emby_id):
    """Emby web deep link for another item: Seerr's mediaUrl with the item id swapped."""
    if not template or not emby_id:
        return None
    url, n = re.subn(r"([?&#]id=)[^&#]+", lambda m: m.group(1) + str(emby_id), template, count=1)
    return url if n else None


def tn_qual(r):
    """Rating 0..10 -> 0 at 5, 0.5 at 7, 1 at 9 (more above); unknown counts as 6."""
    return max(0.0, ((6.0 if r is None else r) - 5.0) / 4.0)


def tn_md(s):
    """Escape Markdown specials in a title."""
    return re.sub(r"([\\`*_\[\]])", r"\\\1", str(s))


class Tonight:
    def __init__(self, a, st, warns):
        self.a, self.st, self.warns = a, st, warns
        self.now = now_utc()
        self.now_ts = self.now.timestamp()
        self.day = self.now.astimezone(ZRH).date()
        self.items, self.ud, self.pref, self.finished = {}, [], {}, []
        self.lib_tmdb, self.requested, self.link_tpl = set(), set(), None
        self.seen_movies = self.seen_shows = 0
        self.me, self.mood, self.avoid, self.time, self.quality = None, set(), set(), None, False
        self.notes, self.used_because = [], set()
        self.seerr_cache, self.checks_left, self.check_fails = {}, TN_VOTE_CHECKS, 0
        shown = st.get("shown") or {}
        self.shown = {k: v for k, v in shown.items() if self.age(v) is not None and self.age(v) <= TN_KEEP_DAYS}

    def age(self, day):
        try:
            return (self.day - date.fromisoformat(day)).days
        except (TypeError, ValueError):
            return None

    def recent(self, key):
        """Shown within the repeat window (episode picks: a shorter one)."""
        age = self.age(self.shown.get(key))
        return age is not None and age < (TN_EP_REPEAT_DAYS if key.startswith("e:") else TN_REPEAT_DAYS)

    # --- data -------------------------------------------------------------------------------------------------
    def seerr_me(self):
        if self.me is None:
            self.me = seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER")
        return self.me

    def emby_uid(self):
        """The owner's internal Emby user id (UserDatas.userId): MEDIA_TONIGHT_EMBY_UID, the cached mapping, or the
        user whose played items overlap most with his Playback Reporting plays (his Emby id = Seerr's jellyfinUserId)."""
        env = os.environ.get("MEDIA_TONIGHT_EMBY_UID")
        if env:
            if not env.isdigit():
                raise ApiError("MEDIA_TONIGHT_EMBY_UID must be a number")
            return int(env)
        cache = self.st.get("emby") or {}
        try:
            guid = re.sub(r"[^0-9a-f]", "", str(self.seerr_me().get("jellyfinUserId") or "").lower())
        except ApiError as e:
            if isinstance(cache.get("uid"), int):
                return cache["uid"]               # Seerr is down: the cached mapping still holds
            raise ApiError(f"can't tell which Emby user is yours: {e}")
        if len(guid) != 32:
            raise ApiError(f"Seerr user {TONIGHT_USER!r} has no linked Emby account")
        gh = hashlib.sha256(guid.encode()).hexdigest()[:16]
        age = self.age(cache.get("at"))
        if cache.get("guid") == gh and isinstance(cache.get("uid"), int) and age is not None and age < TN_MAP_DAYS:
            return cache["uid"]
        plays = [r[0] for r in tn_sql(Q_TN_PLAYS.replace("{G}", guid), "playback") if r and r[0].isdigit()]
        if not plays:
            raise ApiError("no plays of yours in Emby's Playback Reporting to find your Emby user by")
        counts = sorted(((int(r[0]), int(r[1])) for r in tn_sql(Q_TN_MAP.replace("{IDS}", ",".join(plays)), "library")
                         if len(r) >= 2 and r[0].isdigit() and r[1].isdigit()), key=lambda x: -x[1])
        if not counts or counts[0][1] < 3 or (len(counts) > 1 and counts[0][1] < 1.5 * counts[1][1]):
            raise ApiError("can't tell your Emby user from the others (set MEDIA_TONIGHT_EMBY_UID)")
        self.st["emby"] = {"uid": counts[0][0], "guid": gh, "at": self.day.isoformat()}
        return counts[0][0]

    def load_emby(self):
        uid = self.emby_uid()
        for r in tn_sql(Q_TN_ITEMS, "library"):
            if r[0] != "I" or len(r) < 10 or not r[1].isdigit():
                continue
            ids, ticks = pids(r[7]), tn_num(r[6], int)
            rating = tn_num(r[5])
            it = {"id": r[1], "kind": "movie" if r[2] == "5" else "tv", "name": r[3], "year": tn_num(r[4], int),
                  "rating": rating if rating and rating > 0 else None, "mins": round(ticks / TICKS_PER_MIN) if ticks else None,
                  "tmdb": ids.get("tmdb"), "added": tn_num(r[8], int), "genres": tn_genres(r[9])}
            self.items[it["id"]] = it
            if it["kind"] == "movie" and it["tmdb"]:
                self.lib_tmdb.add(str(it["tmdb"]))
        rows = [r for r in tn_sql(Q_TN_USER.replace("{U}", str(int(uid))), "library") if r[0] == "U" and len(r) >= 10]
        stamps = collections.Counter(r[7] for r in rows if r[7])
        for r in rows:
            ts = tn_num(r[7], int)
            if ts is not None and (ts < 946684800 or stamps[r[7]] >= TN_BULK):
                ts = None                       # year-1 placeholders and bulk "mark played" are not watch dates
            self.ud.append({"id": r[1], "type": int(r[2]), "series": r[3] or None, "s": tn_num(r[4], int),
                            "e": tn_num(r[5], int), "played": r[6] == "1", "ts": ts, "fav": r[8] == "1",
                            "pos": (tn_num(r[9], int) or 0) > 0})
        self.taste()

    def taste(self):
        """Genre preferences (0..1) from his plays, weighted by recency, relative to how common a genre is in the
        library (Drama everywhere says less than Science Fiction); plus the titles he finished recently."""
        w, per_series, fav_series = collections.Counter(), {}, set()
        for r in self.ud:
            seen = r["played"] or r["pos"]
            if r["type"] == 5 and seen and r["id"] in self.items:
                it = self.items[r["id"]]
                self.seen_movies += 1
                x = tn_recency(r["ts"], self.now_ts) + (1.0 if r["fav"] else 0.0)
                for g in it["genres"]:
                    w[g] += x
                if r["played"] and r["ts"] and self.now_ts - r["ts"] <= TN_BECAUSE_DAYS * 86400:
                    self.finished.append((r["ts"], it, "finished"))
            elif r["type"] == 8 and seen and r["series"] in self.items:
                ps = per_series.setdefault(r["series"], [0, None])
                ps[0] += 1
                if r["ts"] and (ps[1] is None or r["ts"] > ps[1]):
                    ps[1] = r["ts"]
            elif r["type"] == 6 and r["fav"]:
                fav_series.add(r["id"])
        for sid, (n, ts) in per_series.items():
            it = self.items[sid]
            self.seen_shows += 1
            x = 1.5 * min(1.0, n / 6) * tn_recency(ts, self.now_ts) + (1.0 if sid in fav_series else 0.0)
            for g in it["genres"]:
                w[g] += x
            if ts and self.now_ts - ts <= TN_BECAUSE_DAYS * 86400 and n >= 3:
                self.finished.append((ts, it, "watched"))
        self.finished.sort(key=lambda f: -f[0])
        lib = collections.Counter(g for it in self.items.values() for g in it["genres"])
        n_lib, total = max(1, len(self.items)), sum(w.values())
        lift = {g: (v / total) / math.sqrt(lib[g] / n_lib) for g, v in w.items() if lib[g] >= 5 and total}
        top = max(lift.values(), default=0)
        self.pref = {g: v / top for g, v in lift.items()} if top else {}

    def affinity(self, genres):
        ws = sorted((self.pref.get(g, 0.0) for g in genres), reverse=True)
        if not ws:
            return 0.2
        return (ws[0] + 0.5 * (ws[1] if len(ws) > 1 else 0.0)) / 1.5

    def top_genres(self, genres, n=2):
        """The genres to name: mood genres first, then the ones he likes most."""
        return sorted(genres, key=lambda g: (g not in self.mood, -self.pref.get(g, 0.0), g))[:n]

    def because(self, genres, kind=None):
        """'because you finished X' from his recent titles sharing the most-liked genres; titles with many genres
        count less (they match everything), the same kind a bit more, the most recent wins ties, and each title
        explains one pick only."""
        best = None
        for _, it, verb in self.finished[:40]:
            if it["name"] in self.used_because:
                continue
            shared = genres & it["genres"]
            sc = sum(self.pref.get(g, 0.0) for g in shared) / math.sqrt(len(it["genres"]) or 1)
            sc += 0.1 if shared and it["kind"] == kind else 0.0
            if shared and sc > 0.2 and (best is None or sc > best[0] + 1e-9):
                best = (sc, it, verb)
        if not best:
            return None
        self.used_because.add(best[1]["name"])
        return f"because you {best[2]} {best[1]['name']}"

    def min_film(self):
        return min(TN_MIN_FILM, self.time // 2) if self.time else TN_MIN_FILM

    def kids(self, genres):
        """Penalty for Family/Kids titles unless the mood or his own plays point there."""
        if not genres & {"Family", "Kids"} or self.mood & {"Family", "Kids"} or self.pref.get("Family", 0) >= 0.5:
            return 0.0
        return TN_KIDS_PENALTY

    def fits(self, genres):
        """Matches the mood: one of its genres and none it avoids."""
        return bool(genres & self.mood) and not genres & self.avoid

    def mood_filter(self, cands, genres_of, what):
        """Keep the candidates matching the mood; when none does, keep all and say so."""
        if not self.mood or not cands:
            return cands
        hit = [c for c in cands if self.fits(genres_of(c))]
        if not hit:
            self.note(f"nothing {what} fits the mood; picked without it")
        return hit or cands

    def note(self, text):
        """An owner-facing line (also a warning)."""
        self.notes.append(text)
        self.warns.append(text)

    def seerr_item(self, kind, tmdb):
        """Seerr's movie/tv record of a TMDB id, once per run (None when it failed; raises nothing)."""
        k = (kind, str(tmdb))
        if k not in self.seerr_cache:
            try:
                self.seerr_cache[k] = get("seerr", f"/api/v1/{kind}/{int(tmdb)}") or {}
            except (ApiError, ValueError) as e:
                self.seerr_cache[k] = e
        v = self.seerr_cache[k]
        return v if isinstance(v, dict) else None

    def rating(self, it):
        """The rating to rank by: checked against TMDB's vote count when that was done (verify), else Emby's
        CommunityRating (0..10), with a suspiciously high one (VisionQuest's 10.0) counted as unknown (None)."""
        if "eff" in it:
            return it["eff"]
        r = it["rating"]
        return None if r is None or r > TN_SUSPECT else r

    def shown_rating(self, it):
        """The rating the card shows: Emby's (TMDB's when Emby's was suspect and TMDB has votes); never a damped one."""
        return it["shown"] if "eff" in it else self.rating(it)

    def verify(self, it):
        """Check a library title's rating against TMDB's vote count (through Seerr; budgeted per run): damp it towards
        TN_VOTE_PRIOR by the count, use TMDB's average when Emby's is missing or suspect. True when the title was
        already checked (nothing changed), False when this call settled it."""
        if "eff" in it:
            return True
        r, votes, base = it["rating"], None, self.rating(it)
        if it["tmdb"] and str(it["tmdb"]).isdigit() and self.checks_left > 0:
            self.checks_left -= 1
            k = ("movie" if it["kind"] == "movie" else "tv", str(it["tmdb"]))
            d = self.seerr_item(*k)
            if d is None:
                self.check_fails += 1
                if self.check_fails >= 2:
                    self.checks_left = 0        # Seerr is struggling: rank by Emby's ratings alone
                self.warns.append(f"Seerr ratings: {self.seerr_cache[k]}")
            elif isinstance(d.get("voteCount"), int) and d["voteCount"] >= 0:
                votes, avg = d["voteCount"], d.get("voteAverage")
                if (r is None or r > TN_SUSPECT) and votes > 0 and isinstance(avg, (int, float)) and avg > 0:
                    base = float(avg)
        it["votes"], it["shown"] = votes, base
        if votes is not None and base is not None:
            m_rating, m_votes = TN_VOTE_PRIOR
            it["eff"] = (votes * base + m_votes * m_rating) / (votes + m_votes)
        else:
            it["eff"] = base
        return False

    def best(self, cands, score, floor, key=lambda c: c):
        """The top candidate by score(c, rating). Only leaders get their rating verified (lazily, one at a time); while
        anything reaches `floor` (a known rating), candidates under it are left out. -> (choice, floor held)."""
        def ok(c):
            r = self.rating(key(c))
            return r is not None and r >= floor
        pool = [c for c in cands if ok(c)]
        floored = bool(pool)
        pool = pool or list(cands)
        while pool:
            c = max(pool, key=lambda c: score(c, self.rating(key(c))))
            if self.verify(key(c)):
                return c, floored
            if floored and not ok(c):
                pool = [x for x in pool if x is not c]
        return (max(cands, key=lambda c: score(c, self.rating(key(c)))) if cands else None), False

    def rated(self, it):
        """The pick's rating fields: shown rating (1 decimal) and TMDB's vote count when it was checked."""
        r = self.shown_rating(it)
        return {"rating": round(r, 1) if r else None, "votes": it.get("votes")}

    def link(self, kind, tmdb, emby_id):
        """Emby web deep link of a library item: Seerr's mediaUrl of a library title (any one) is the template,
        the item id is ours (Seerr's stored id can be stale after Emby re-ids a replaced file)."""
        if not self.link_tpl and tmdb and self.link_tpl is None:
            url = None
            try:
                d = self.seerr_item(kind, int(tmdb))
            except ValueError:
                d = {}
            if d is None:
                self.warns.append(f"Seerr link: {self.seerr_cache[(kind, str(int(tmdb)))]}")
                self.link_tpl = ""              # don't ask again this run
            else:
                url = (d.get("mediaInfo") or {}).get("mediaUrl")
            if url and str(url).startswith(("http://", "https://")) and tn_link(url, 1):
                self.link_tpl = url
        return tn_link(self.link_tpl, emby_id)

    # --- picks ------------------------------------------------------------------------------------------------
    def pick_movie(self):
        """A: an unwatched library movie, by taste, rating and freshness (his own available requests get a bonus).
        Rated under TN_OK_RATING only when nothing better fits; with a quality word ("good scifi") the floor is
        TN_GOOD_RATING and the ranking rating x taste."""
        seen = {r["id"] for r in self.ud if r["type"] == 5 and (r["played"] or r["pos"])}
        cands = [it for it in self.items.values() if it["kind"] == "movie" and it["id"] not in seen
                 and not self.recent(f"m:{it['id']}")
                 and (it["rating"] is None or it["rating"] >= TN_MIN_RATING)
                 and (not it["mins"] or it["mins"] >= self.min_film())
                 and (not self.time or (it["mins"] and it["mins"] <= self.time))]
        cands = self.mood_filter(cands, lambda it: it["genres"], "unwatched in the library")
        if not cands:
            return None

        def score(it, r):
            req = str(it["tmdb"]) in self.requested
            if self.quality:
                return (tn_qual(r) * (0.4 + 0.6 * self.affinity(it["genres"])) + (0.05 if req else 0.0)
                        - self.kids(it["genres"]) + 0.03 * tn_jitter(self.day, it["id"]))
            fresh = 0.0
            if it["added"]:
                days = (self.now_ts - it["added"]) / 86400
                fresh = 0.1 if days <= 30 else 0.05 if days <= 90 else 0.0
            return (0.5 * self.affinity(it["genres"]) + 0.3 * tn_qual(r) + fresh + (0.2 if req else 0.0)
                    - self.kids(it["genres"]) + 0.08 * tn_jitter(self.day, it["id"]))
        it, floored = self.best(cands, score, TN_GOOD_RATING if self.quality else TN_OK_RATING)
        if self.quality and not floored:
            self.note(f"no unwatched movie rated ★{TN_GOOD_RATING:.0f}+ fits; picked the best rated")
        why = []
        if str(it["tmdb"]) in self.requested:
            why.append("you requested it" + (f", on Emby since {datetime.fromtimestamp(it['added'], ZRH):%d.%m}"
                                              if it["added"] else ""))
        else:
            b = self.because(it["genres"], "movie")
            if b:
                why.append(b)
            elif it["added"] and self.now_ts - it["added"] <= 30 * 86400:
                why.append(f"new on Emby since {datetime.fromtimestamp(it['added'], ZRH):%d.%m}")
        g = self.top_genres(it["genres"])
        if g:
            why.append(", ".join(g))
        return {"slot": "A", "kind": "movie", "key": f"m:{it['id']}", "title": it["name"], "year": it["year"],
                "runtime_min": it["mins"], **self.rated(it),
                "genres": sorted(it["genres"]), "why": " · ".join(why) or "unwatched in your library",
                "tmdb": int(it["tmdb"]) if str(it["tmdb"] or "").isdigit() else None, "emby_id": it["id"],
                "link": self.link("movie", it["tmdb"], it["id"]), "in_library": True}

    def pick_show(self):
        """B: the next unwatched episode of a show in progress, else a well-rated show he hasn't started."""
        prog = {}
        for r in self.ud:
            if r["type"] != 8 or r["series"] not in self.items or not (r["played"] or r["pos"]):
                continue
            p = prog.setdefault(r["series"], {"last": None, "max": (0, -1), "seen": set()})
            if r["played"]:
                p["seen"].add(r["id"])
                if r["s"] and r["e"] is not None:
                    p["max"] = max(p["max"], (r["s"], r["e"]))
            if r["ts"] and (p["last"] is None or r["ts"] > p["last"]):
                p["last"] = r["ts"]
        active = sorted((sid for sid, p in prog.items() if p["last"] and self.now_ts - p["last"] <= TN_ACTIVE_DAYS * 86400),
                        key=lambda sid: -prog[sid]["last"])[:20]
        def fscore(it, r):
            return (0.55 * self.affinity(it["genres"]) + (0.6 if self.quality else 0.35) * (r or 0.0) / 10
                    - self.kids(it["genres"]) + 0.08 * tn_jitter(self.day, it["id"])
                    + (1.0 if self.fits(it["genres"]) else 0.0))
        fresh = [it for it in self.items.values() if it["kind"] == "tv" and it["id"] not in prog
                 and (self.rating(it) or 0) >= 7.5 and not self.recent(f"s:{it['id']}")]
        fresh = sorted(fresh, key=lambda it: -fscore(it, self.rating(it)))[:8]
        want = active + [it["id"] for it in fresh]
        if not want:
            return None
        eps = collections.defaultdict(list)
        for r in tn_sql(Q_TN_EPS.replace("{IDS}", ",".join(want)), "library"):
            if r[0] == "E" and len(r) >= 8 and tn_num(r[3], int) and tn_num(r[4], int) is not None:
                ticks = tn_num(r[6], int)
                eps[r[2]].append({"id": r[1], "s": int(r[3]), "e": int(r[4]), "name": r[5],
                                  "mins": round(ticks / TICKS_PER_MIN) if ticks else None, "added": tn_num(r[7], int)})
        for v in eps.values():
            v.sort(key=lambda e: (e["s"], e["e"]))
        fits = (lambda ep: not self.time or (ep["mins"] and ep["mins"] <= self.time))

        nexts = []
        for sid in active:
            p = prog[sid]
            nxt = next((e for e in eps.get(sid, []) if (e["s"], e["e"]) > p["max"] and e["id"] not in p["seen"]), None)
            if nxt and fits(nxt) and not self.recent(f"e:{nxt['id']}"):
                nexts.append((sid, nxt))
        starts = [(it, next((e for e in eps.get(it["id"], []) if fits(e)), None)) for it in fresh]
        starts = [c for c in starts if c[1] and (c[1]["s"], c[1]["e"]) <= (1, 1)]
        start = []

        def first_start():
            """The best new show to start, its rating checked (still >= 7.5 after the vote count), or None."""
            if not start:
                c, floored = self.best(starts, lambda c, r: fscore(c[0], r), 7.5, key=lambda c: c[0])
                start.append(c if floored else None)
            return start[0]
        if self.mood:
            hit = [c for c in nexts if self.fits(self.items[c[0]]["genres"])]
            if hit:
                nexts = hit
            elif first_start() and self.fits(first_start()[0]["genres"]):
                nexts = []                      # a new show fits the mood better than the ones in progress
            elif nexts or first_start():
                self.note("no show fits the mood; picked without it")

        def score(c):
            p, ep = prog[c[0]], c[1]
            new_ep = 0.3 if ep["added"] and ep["added"] > p["last"] else 0.0
            return (math.exp(-(self.now_ts - p["last"]) / 86400 / 21) + new_ep
                    + 0.2 * self.affinity(self.items[c[0]]["genres"]) + 0.05 * tn_jitter(self.day, ep["id"]))
        if nexts:
            sid, ep = max(nexts, key=score)
            show, p = self.items[sid], prog[sid]
            left = sum(1 for e in eps[sid] if (e["s"], e["e"]) > (ep["s"], ep["e"]) and e["id"] not in p["seen"])
            if ep["added"] and ep["added"] > p["last"]:
                why = f"new episode, on Emby since {datetime.fromtimestamp(ep['added'], ZRH):%d.%m}"
            elif p["max"][0]:
                why = (f"next up: you watched S{p['max'][0]:02d}E{p['max'][1]:02d} on "
                       f"{datetime.fromtimestamp(p['last'], ZRH):%d.%m}")
            else:
                why = f"next up: you last watched it on {datetime.fromtimestamp(p['last'], ZRH):%d.%m}"
            if left:
                why += f" · {left} more after this"
            kind, key = "episode", f"e:{ep['id']}"
        else:
            if not first_start():
                return None
            show, ep = first_start()
            sid, kind, key = show["id"], "series", f"s:{show['id']}"
            n = len(eps[sid])
            why = " · ".join(x for x in ["new to you", self.because(show["genres"], "tv"),
                                         ", ".join(self.top_genres(show["genres"])), plural(n, "episode") + " on Emby"] if x)
        return {"slot": "B", "kind": kind, "key": key, "title": show["name"], "year": show["year"],
                "episode": f"S{ep['s']:02d}E{ep['e']:02d}", "episode_title": ep["name"] or None,
                "runtime_min": ep["mins"] or show["mins"], **self.rated(show),
                "genres": sorted(show["genres"]), "why": why,
                "tmdb": int(show["tmdb"]) if str(show["tmdb"] or "").isdigit() else None,
                "emby_id": ep["id"], "series_id": sid,       # Play on TV starts exactly this episode (emby_id)
                "link": self.link("tv", show["tmdb"], ep["id"] if kind == "episode" else sid),  # a new show: its page
                "in_library": True}

    def pick_new(self):
        """C: a well-rated, recent or trending movie that is not on the server or requested (Seerr discover)."""
        names = {g["id"]: g["name"] for g in (get("seerr", "/api/v1/genres/movie") or []) if g.get("id")}
        ids = {TN_CANON.get(str(n).lower(), n): i for i, n in names.items()}
        want = sorted(self.mood or self.pref, key=lambda g: (-self.pref.get(g, 0.0), g))
        want = [g for g in want if g in ids][:3]
        since = (self.day - timedelta(days=4 * 365)).isoformat()
        rt = f"&withRuntimeLte={self.time}" if self.time else ""
        pool = {}

        def genres_of(x):
            return {TN_CANON.get(str(names.get(i, "")).lower(), names.get(i)) for i in x.get("genreIds") or []} - {None}

        def usable(x):
            return (x.get("id") and is_new(x) and str(x["id"]) not in self.lib_tmdb and not self.recent(f"t:{x['id']}")
                    and (x.get("voteAverage") or 0) >= (7.0 if self.quality else 6.5)
                    and (x.get("voteCount") or 0) >= 50 and (x.get("releaseDate") or "9") <= self.day.isoformat()
                    and not self.kids(genres_of(x)))     # requesting kids' films for him makes no sense
        for g in want:
            for page in range(1, 4):            # the next page only while a page brings nothing usable (he has it all)
                d = get("seerr", f"/api/v1/discover/movies?page={page}&genre={ids[g]}&sortBy=popularity.desc"
                                 f"&voteAverageGte={7.2 if self.quality else 6.8}&voteCountGte=150"
                                 f"&primaryReleaseDateGte={since}&primaryReleaseDateLte={self.day}{rt}") or {}
                res = d.get("results") or []
                for x in res:
                    pool.setdefault(x.get("id"), (x, False))
                if any(usable(x) for x in res) or page >= (tn_num(d.get("totalPages"), int) or 1):
                    break
        if not self.mood or not pool:
            for x in (get("seerr", "/api/v1/discover/trending?page=1&language=en") or {}).get("results") or []:
                if x.get("mediaType") == "movie" and x.get("id"):
                    pool[x["id"]] = (x, True)
        cands = [(x, tr) for x, tr in pool.values() if usable(x)]
        cands = self.mood_filter(cands, lambda c: genres_of(c[0]), "new on TMDB")
        cands.sort(key=lambda c: -(0.5 * self.affinity(genres_of(c[0])) + (0.6 if self.quality else 0.35) * c[0]["voteAverage"] / 10
                                   + (0.1 if c[1] else 0.0) - self.kids(genres_of(c[0]))
                                   + 0.08 * tn_jitter(self.day, c[0]["id"])))
        for x, trending in cands[:4]:
            det = details(x["id"], "movie")
            mins = det.get("runtime") or None
            if not is_new(det) or (self.time and (not mins or mins > self.time)) or (mins and mins < self.min_film()):
                continue
            gs = genres_of(x)
            label = self.top_genres(gs, 1)
            why = ["trending now" if trending else f"popular {label[0] if label else 'pick'} from {year(det)}"]
            b = self.because(gs, "movie")
            if b:
                why.append(b)
            elif gs:
                why.append(", ".join(self.top_genres(gs)))
            return {"slot": "C", "kind": "movie", "key": f"t:{x['id']}", "title": title_of(det),
                    "year": tn_num(year(det), int) or year(det),
                    "runtime_min": mins, "rating": round(det.get("voteAverage") or x["voteAverage"], 1),
                    "genres": sorted(gs), "why": " · ".join(why), "tmdb": int(x["id"]), "link": None,
                    "in_library": False, "request": {"data": f"mt:req:{int(x['id'])}",
                                                     "cmd": f"media request {int(x['id'])} --type movie"}}
        return None


def tn_line(p, md):
    """'🍿 Title (2024) · 120 min · ★7.9' (+ episode, + 'not on Emby yet')."""
    t = tn_md(p["title"]) if md else p["title"]
    t = f"**{t}**" if md else t
    if p.get("episode"):
        head = f"{t} {p['episode']}"
        if p.get("episode_title") and not re.fullmatch(r"(?i)episode \d+", p["episode_title"]):
            et = tn_md(p["episode_title"]) if md else p["episode_title"]
            head += f" “{et}”"
    else:
        head = f"{t} ({p['year']})" if p.get("year") else t
    bits = [head]
    if p.get("runtime_min"):
        bits.append(f"{p['runtime_min']} min")
    if p.get("rating"):
        few = p.get("votes") is not None and p["votes"] < TN_FEW_VOTES
        bits.append(f"★{p['rating']:.1f}" + (f" ({plural(p['votes'], 'vote')})" if few else ""))
    if not p.get("in_library"):
        bits.append("not on Emby yet")
    return f"{TN_SLOTS[p['slot']]} " + " · ".join(bits)


def tn_message(picks, mood_label, mins, warns, md=True):
    head = "🎬 **Movie night**" if md else "🎬 Movie night"
    extra = [x for x in (mood_label, f"≤ {mins} min" if mins else None) if x]
    lines = [head + (" · " + " · ".join(extra) if extra else "")]
    for p in picks:
        lines += ["", tn_line(p, md), p["why"]]
    if not picks:
        lines += ["", "Nothing fits tonight" + (" (try without the mood or time limit)" if extra else "") + "."]
    if warns:
        lines += ["", "⚠️ " + "; ".join(warns)[:300]]
    return "\n".join(lines)


def tn_buttons(picks):
    rows, play_on = [], play_enabled()
    for p in picks:
        if p.get("link"):
            name = p["title"] if len(p["title"]) <= 24 else p["title"][:23] + "…"
            ep = f" {p['episode']}" if p.get("episode") and p.get("kind") == "episode" else ""   # a new show links its page
            rows.append([{"text": f"▶ {name}{ep}", "url": p["link"]}])
        if p.get("in_library") and p.get("emby_id") and play_on:
            tv = {"text": "📺 Play on TV", "data": f"mt:play:{p['emby_id']}"}
            if p.get("link"):
                rows[-1].append(tv)
            else:
                rows.append([tv])
        if p.get("request"):
            name = p["title"] if len(p["title"]) <= 24 else p["title"][:23] + "…"
            rows.append([{"text": f"➕ Request {name}", "data": p["request"]["data"]}])
    rows.append([{"text": "🎲 3 more", "data": "mt:more"}])
    return rows


def tn_lock():
    """Exclusive lock on the state (bounded wait); None when another run holds it too long."""
    os.makedirs(os.path.dirname(TONIGHT_STATE) or ".", exist_ok=True)
    f = open(TONIGHT_STATE + ".lock", "w")
    for _ in range(120):
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            time.sleep(0.5)
    f.close()
    return None


def cmd_tonight(a):
    words, mins = tn_parse_args(a.args)
    if a.mood:
        words += a.mood.split()
    if a.time is not None:
        if a.time < 1:
            die("--time must be at least 1 minute")
        mins = a.time
    lock = None if a.dry_run else tn_lock()
    st = botlib.load_json(TONIGHT_STATE, {}) or {}
    if not isinstance(st, dict):
        st = {}
    last = st.get("last") or {}
    if a.more and not words and mins is None:        # "3 more": same mood and time as last time
        words, mins = list(last.get("words") or []), last.get("time")
    warns = []
    label, mood, avoid, unknown, quality = tn_mood(words)
    t = Tonight(a, st, warns)
    t.mood, t.avoid, t.time, t.quality = mood, avoid, mins, quality
    if unknown:
        t.note(f"unknown mood {' '.join(unknown)!r} (try: {', '.join(sorted(TN_MOODS))} or a genre)")
    picks, failed = [], 0
    try:
        t.requested = set(ready_movies(seerr_paged(f"/api/v1/user/{int(t.seerr_me()['id'])}/requests")))
    except ApiError as e:
        warns.append(f"Seerr: {e}")
    try:
        t.load_emby()
        emby_ok = True
    except ApiError as e:
        warns.append(f"Emby: {e}")
        t.notes.append("Emby's data didn't load: no library picks")
        emby_ok, failed = False, 2
    for slot, fn, needs_emby in (("A", t.pick_movie, True), ("B", t.pick_show, True), ("C", t.pick_new, False)):
        if needs_emby and not emby_ok:
            continue
        try:
            p = fn()
        except ApiError as e:
            warns.append(f"pick {slot}: {e}")
            t.notes.append({"A": "the movie pick", "B": "the show pick", "C": "the new pick"}[slot] + " failed")
            failed += 1
            continue
        if p:
            picks.append(p)
    warns[:] = list(dict.fromkeys(warns))
    if not picks and failed:
        die("no picks: " + "; ".join(warns)[:400])
    if not a.dry_run:
        for p in picks:
            t.shown[p["key"]] = t.day.isoformat()
        st.update({"shown": t.shown, "last": {"at": iso_z(t.now), "words": words, "time": mins,
                                              "picks": [p["key"] for p in picks]}})
        if lock:
            botlib.save_json(TONIGHT_STATE, st, ensure_ascii=False, indent=1, sort_keys=True)
        else:
            warns.append("state busy (another run); picks not remembered")
    out = {"generated": iso_z(t.now), "mood": label, "quality": quality, "time": mins,
           "taste": {"top_genres": sorted(t.pref, key=lambda g: (-t.pref[g], g))[:5], "movies_seen": t.seen_movies,
                     "shows_seen": t.seen_shows},
           "picks": picks, "warnings": warns, "message": tn_message(picks, label, mins, t.notes),
           "buttons": tn_buttons(picks), "dry_run": bool(a.dry_run)}
    cont = ct_tonight_button(t.seerr_me, picks, warns)
    if cont:
        out["buttons"].insert(len(out["buttons"]) - 1, cont)       # above "🎲 3 more"
        out["continue"] = cont[0]["data"]
    if a.json:
        emit_json(out)
    else:
        print(tn_message(picks, label, mins, [], md=False))
        for p in picks:
            if p.get("link"):
                print(f"   {p['slot']}: {p['link']}")
            if p.get("request"):
                print(f"   {p['slot']}: button {p['request']['data']} = {p['request']['cmd']}")
        if out.get("continue"):
            print(f"   continue: button {out['continue']}")
        for w in warns:
            print(f"!! {w}")
    if failed:
        sys.exit(3)


# ---------- group: movie night with friends: library movies nobody in the group has seen, plus a poll ----------
# Read-only: GET /emby/Users and /emby/Users/{id}/Items (each member's played and partly watched movies), two Playback
# Reporting SELECTs (who played in the last GR_ACTIVE_DAYS, movie plays of GR_MIN_PLAY_S+), tonight's library load and
# rating checks. Names only the group's members; never who watched what. Remembers nothing.
GR_ACTIVE_DAYS = 180       # the default group: him + every enabled Emby user with a play this recent
GR_MIN_PLAY_S = 1200       # a member's Playback Reporting plays of a movie summing to this many seconds count as seen
GR_MAX = 8                 # picks at most (a poll takes 2-12 options)
GR_SAME_LEAD = 0.35        # score penalty per earlier pick sharing one of its two defining genres (mixes genres)
GR_SHARED = 0.2            # ... and for sharing genres with earlier picks at all
GR_NAMES_SHOWN = 4         # the header names this many members, then "+N"
GR_WORKERS = 8             # parallel Emby calls for the members' histories
GR_STOP = {"with", "and", "mit", "und", "me", "i", "ich", "for", "für", "&", "+", "plus", "us", "uns", "friends"}
GR_NUM = ["1️⃣", "2️⃣", "3️⃣", "4️⃣", "5️⃣", "6️⃣", "7️⃣", "8️⃣"]
GR_POLL_Q = "Movie night: which one?"
GR_POLL_LEN = 100          # Telegram's limit per poll option
Q_GR_ACTIVE = ("SELECT lower(replace(UserId,'-','')), count(*) FROM PlaybackActivity"
               " WHERE substr(DateCreated,1,10) >= '{SINCE}' GROUP BY 1")
Q_GR_PLAYS = ("SELECT lower(replace(UserId,'-','')), ItemId FROM PlaybackActivity WHERE ItemType = 'Movie'"
              " GROUP BY 1, 2 HAVING sum(PlayDuration) >= {MIN}")


def gr_norm(s):
    """'Zoë ' -> 'zoe': accents off, case folded, letters and digits only."""
    s = unicodedata.normalize("NFKD", str(s or ""))
    return re.sub(r"[^0-9a-z]", "", "".join(c for c in s if not unicodedata.combining(c)).casefold())


def gr_users():
    """Emby users (GET /Users) -> [{"id": 32 hex, "first", "key", "disabled", "active": last activity or None}]."""
    out = []
    for u in get("emby", f"{EMBY}/Users") or []:
        g = re.sub(r"[^0-9a-f]", "", str(u.get("Id") or "").lower())
        if not GUID_RE.fullmatch(g):
            continue
        name = str(u.get("Name") or "?")
        out.append({"id": g, "first": (name.split() or ["?"])[0], "key": gr_norm(name),
                    "disabled": bool((u.get("Policy") or {}).get("IsDisabled")), "active": zdt(u.get("LastActivityDate"))})
    return out


def gr_match(users, want):
    """A typed name -> (user, None) or (None, reason): the exact name, else its first word, else a unique prefix."""
    k = gr_norm(want)
    if not k:
        return None, "unknown"
    hit = [u for u in users if u["key"] == k] or [u for u in users if gr_norm(u["first"]) == k]
    if not hit and len(k) >= 2:
        hit = [u for u in users if u["key"].startswith(k)]
    if len(hit) == 1:
        return hit[0], None
    return None, ("could be " + ", ".join(sorted(u["first"] for u in hit))) if hit else "unknown"


def gr_split(text):
    """--with 'Ana, Ben' -> ['Ana', 'Ben']."""
    return [w for w in re.split(r"[,;/\s]+", str(text or "")) if w and w.lower() not in GR_STOP]


def gr_words(text):
    """Free text after /movienight -> (names, mood words, minutes). Moods, genres, quality words and times work as in
    /tonight; any other word is a name."""
    words, mins = tn_parse_args(text)
    names, moods = [], []
    for w in words:
        k = w.lower().strip(" ,.!")
        if not k or k in GR_STOP:
            continue
        label, _, _, unknown, quality = tn_mood([w])
        (moods if (label or quality) and not unknown else names).append(w.strip(" ,.!"))
    return names, moods, mins


def gr_seen_api(uid):
    """One member's played or partly watched movies (GET-only) -> (Emby item ids, TMDB ids)."""
    ids, tmdb = set(), set()
    for f in ("IsPlayed", "IsResumable"):
        d = get("emby", f"{EMBY}/Users/{q(uid)}/Items?Recursive=true&IncludeItemTypes=Movie&Filters={f}"
                        "&Fields=ProviderIds&EnableImages=false&EnableUserData=false") or {}
        for x in d.get("Items") or []:
            if x.get("Id"):
                ids.add(str(x["Id"]))
            t = {str(k).lower(): v for k, v in (x.get("ProviderIds") or {}).items()}.get("tmdb")
            if t:
                tmdb.add(str(t))
    return ids, tmdb


class Group(Tonight):
    """Tonight's library, taste and rating checks, picking several unseen movies with mixed genres."""
    def __init__(self, a, st, warns):
        super().__init__(a, st, warns)
        self.quality = True                 # ★7+ while any fit, ranked rating x taste
        self.seen_ids, self.seen_tmdb, self.lib_genres = set(), set(), collections.Counter()

    def lead(self, it):
        """The genre that sets a movie apart: its rarest one among the library's movies."""
        return min(it["genres"], key=lambda g: (self.lib_genres[g], g)) if it["genres"] else None

    def tags(self, it):
        """Its two defining genres: the rarest in the library, the mood's own genres left out (they all share those)."""
        gs = (it["genres"] - self.mood) or it["genres"]
        return set(sorted(gs, key=lambda g: (self.lib_genres[g], g))[:2])

    def picks(self, n):
        self.lib_genres = collections.Counter(g for it in self.items.values() if it["kind"] == "movie"
                                              for g in it["genres"])
        for i in list(self.seen_ids):
            it = self.items.get(i)
            if it and it["tmdb"]:
                self.seen_tmdb.add(str(it["tmdb"]))
        cands = [it for it in self.items.values() if it["kind"] == "movie" and it["id"] not in self.seen_ids
                 and not (it["tmdb"] and str(it["tmdb"]) in self.seen_tmdb)
                 and (it["rating"] is None or it["rating"] >= TN_MIN_RATING)
                 and (not it["mins"] or it["mins"] >= self.min_film())
                 and (not self.time or (it["mins"] and it["mins"] <= self.time))]
        cands = self.mood_filter(cands, lambda it: it["genres"], "that nobody has seen")
        out, taken, used, under = [], [], collections.Counter(), 0
        while cands and len(out) < n:
            def score(it, r):
                gs = it["genres"]
                return (tn_qual(r) * (0.55 + 0.45 * self.affinity(gs)) - self.kids(gs)
                        - GR_SAME_LEAD * sum(1 for t in taken if t & self.tags(it))
                        - GR_SHARED * sum(1 for g in gs if used[g]) / max(1, len(gs))
                        + 0.04 * tn_jitter(self.day, it["id"]))
            it, floored = self.best(cands, score, TN_GOOD_RATING)
            cands = [c for c in cands if c is not it and not (it["tmdb"] and c["tmdb"] == it["tmdb"])]
            under += 0 if floored else 1
            taken.append(self.tags(it))
            used.update(it["genres"])
            out.append(self.card(it, len(out) + 1))
        if under:
            self.note(f"{under} of the {plural(len(out), 'pick')} rated under ★{TN_GOOD_RATING:.0f}: "
                      f"not enough unseen ★{TN_GOOD_RATING:.0f}+ movies fit")
        return out

    def card(self, it, n):
        why = []
        if str(it["tmdb"]) in self.requested:
            why.append("you requested it")
        elif it["added"] and self.now_ts - it["added"] <= 30 * 86400:
            why.append(f"new on Emby since {datetime.fromtimestamp(it['added'], ZRH):%d.%m}")
        else:
            b = self.because(it["genres"], "movie")
            if b:
                why.append(b)
            elif it["year"] and it["year"] < 2000:
                why.append(f"a classic from {it['year']}")
        g = self.top_genres(it["genres"])
        if g:
            why.append(", ".join(g))
        return {"n": n, "kind": "movie", "title": it["name"], "year": it["year"], "runtime_min": it["mins"],
                **self.rated(it), "genres": sorted(it["genres"]), "lead": self.lead(it),
                "why": " · ".join(why) or "nobody has seen it",
                "tmdb": int(it["tmdb"]) if str(it["tmdb"] or "").isdigit() else None, "emby_id": it["id"],
                "link": self.link("movie", it["tmdb"], it["id"]), "in_library": True}


def gr_who(names, default, md=True):
    if not names:
        return "just you"
    if default and len(names) > GR_NAMES_SHOWN:
        return f"you + {len(names)} others active in {GR_ACTIVE_DAYS} days"
    shown = [tn_md(x) if md else x for x in names[:GR_NAMES_SHOWN]]
    return "you + " + ", ".join(shown) + (f" +{len(names) - len(shown)}" if len(names) > len(shown) else "")


def gr_line(p, md=True):
    """'1️⃣ Title (2024) · 120 min · ★7.9'."""
    t = tn_md(p["title"]) if md else p["title"]
    bits = [(f"**{t}**" if md else t) + (f" ({p['year']})" if p.get("year") else "")]
    if p.get("runtime_min"):
        bits.append(f"{p['runtime_min']} min")
    if p.get("rating"):
        few = p.get("votes") is not None and p["votes"] < TN_FEW_VOTES
        bits.append(f"★{p['rating']:.1f}" + (f" ({plural(p['votes'], 'vote')})" if few else ""))
    return f"{GR_NUM[p['n'] - 1]} " + " · ".join(bits)


def gr_message(picks, names, default, label, mins, notes, md=True):
    head = "🎬 **Movie night**" if md else "🎬 Movie night"
    extra = [x for x in (gr_who(names, default, md), label, f"≤ {mins} min" if mins else None) if x]
    lines = [head + " · " + " · ".join(extra)]
    if picks:
        lines.append("Nobody in the group has seen these:" if names else "You haven't seen these:")
    for p in picks:
        lines += ["", gr_line(p, md), p["why"]]
    if not picks:
        lines += ["", "Nothing unseen fits" + (" (try without the mood or time limit)" if label or mins else "") + "."]
    elif len(picks) >= 2:
        lines += ["", "🗳 Poll below: forward it to the group."]
    if notes:
        lines += ["", "⚠️ " + "; ".join(notes)[:300]]
    return "\n".join(lines)


def gr_poll(picks):
    """send_poll's arguments (without chat_id): non-anonymous, one answer; None under 2 picks."""
    opts = []
    for p in picks:
        o = p["title"] + (f" ({p['year']})" if p.get("year") else "")
        opts.append(o if len(o) <= GR_POLL_LEN else o[:GR_POLL_LEN - 1] + "…")
    return {"question": GR_POLL_Q, "options": opts, "anonymous": False, "multiple": False} if len(opts) >= 2 else None


def gr_buttons(picks, play_on):
    """One row per pick: ▶ Emby web link + 📺 Play on TV (mt:play:<id>, play enabled only)."""
    rows = []
    for p in picks:
        name = p["title"] if len(p["title"]) <= 24 else p["title"][:23] + "…"
        row = [{"text": f"▶ {name}", "url": p["link"]}] if p.get("link") else []
        if play_on and p.get("emby_id"):
            row.append({"text": "📺 Play on TV" if row else f"📺 {name}", "data": f"mt:play:{p['emby_id']}"})
        if row:
            rows.append(row)
    return rows


def cmd_group(a):
    import concurrent.futures
    if not 1 <= a.n <= GR_MAX:
        die(f"-n must be 1..{GR_MAX}")
    names, words, mins = gr_words(a.args)
    names += gr_split(a.with_)
    if a.mood:
        words += a.mood.split()
    if a.time is not None:
        if a.time < 1:
            die("--time must be at least 1 minute")
        mins = a.time
    if not (CFG.get("emby") or {}).get("key"):
        die(f"no emby url/key in {SECRETS}: can't tell who has seen what")
    st = botlib.load_json(TONIGHT_STATE, {}) or {}      # read only: tonight's cached Emby user mapping
    warns, failed = [], 0
    label, mood, avoid, unknown, _ = tn_mood(words)
    g = Group(a, st if isinstance(st, dict) else {}, warns)
    g.mood, g.avoid, g.time = mood, avoid, mins
    if unknown:
        g.note(f"unknown mood {' '.join(unknown)!r}")
    try:
        users = gr_users()
    except ApiError as e:
        die(f"Emby users: {e}")
    try:
        me = ct_guid(g.seerr_me)
    except ApiError as e:
        me = None
        warns.append(f"your Emby user: {e}")
    default, members, lost = not names, [], []
    if names:
        for w in names:
            u, why = gr_match(users, w)
            if u is None:
                lost.append(w)
                g.note(f"{w!r}: no such Emby user" if why == "unknown" else f"{w!r} {why}: left out")
            elif u["id"] != me and u not in members:
                members.append(u)
    else:
        since = (g.day - timedelta(days=GR_ACTIVE_DAYS)).isoformat()
        try:
            act = {r[0] for r in tn_sql(Q_GR_ACTIVE.replace("{SINCE}", since), "playback") if r}
            members = [u for u in users if u["id"] in act and u["id"] != me and not u["disabled"]]
        except ApiError as e:
            warns.append(f"Playback Reporting: {e}; the group = Emby's last activity instead")
            cut = g.now - timedelta(days=GR_ACTIVE_DAYS)
            members = [u for u in users if u["active"] and u["active"] >= cut and u["id"] != me and not u["disabled"]]
    try:
        g.requested = set(ready_movies(seerr_paged(f"/api/v1/user/{int(g.seerr_me()['id'])}/requests")))
    except ApiError as e:
        warns.append(f"Seerr: {e}")
    try:
        g.load_emby()                                   # library, his own UserDatas, his taste
    except ApiError as e:
        die(f"Emby library: {e}")
    g.seen_ids |= {r["id"] for r in g.ud if r["type"] == 5 and (r["played"] or r["pos"])}
    who = ([{"id": me, "first": "you"}] if me else []) + members

    def seen_of(u):
        try:
            return u, gr_seen_api(u["id"]), None
        except ApiError as e:
            return u, None, e
    with concurrent.futures.ThreadPoolExecutor(max_workers=GR_WORKERS) as ex:
        res = list(ex.map(seen_of, who))
    unchecked = []
    for u, seen, err in res:
        if seen is None:
            unchecked.append(u["first"])
            warns.append(f"Emby history of {u['first']}: {err}")
            continue
        g.seen_ids |= seen[0]
        g.seen_tmdb |= seen[1]
    if unchecked:
        failed += 1
        g.note(f"couldn't check what {', '.join(unchecked)} saw")
    try:
        ids = {u["id"] for u in who}
        g.seen_ids |= {r[1] for r in tn_sql(Q_GR_PLAYS.replace("{MIN}", str(GR_MIN_PLAY_S)), "playback")
                       if len(r) >= 2 and r[0] in ids}
    except ApiError as e:
        warns.append(f"Playback Reporting plays: {e}")
    picks = g.picks(a.n)
    warns[:] = list(dict.fromkeys(warns))
    play_on = play_enabled()
    first = [u["first"] for u in members]
    out = {"generated": iso_z(g.now), "mood": label, "time": mins,
           "group": {"names": first, "size": len(members) + 1, "default": default,
                     "active_days": GR_ACTIVE_DAYS if default else None, "not_found": lost, "unchecked": unchecked},
           "picks": picks, "warnings": warns, "message": gr_message(picks, first, default, label, mins, g.notes),
           "poll": gr_poll(picks), "buttons": gr_buttons(picks, play_on), "play_on_tv": play_on}
    if a.json:
        emit_json(out)
    else:
        print(gr_message(picks, first, default, label, mins, [], md=False))
        if out["poll"]:
            print(f"   poll: {GR_POLL_Q} " + " | ".join(out["poll"]["options"]))
        for row in out["buttons"]:
            print("   " + " · ".join(f"{b['text']} = {b.get('data') or b.get('url')}" for b in row))
        for w in warns:
            print(f"!! {w}")
    if failed:
        sys.exit(3)


# ---------- play: start a library item on the TV (Emby remote control; HA wakes the TV and opens the Emby app) ----------
# Staged behind PLAY_CFG {"enabled": true}: without it only --dry-run runs (and the tonight card shows no TV button).
# Emby (the "emby" {url,key} entry, X-Emby-Token): GET /Items, GET /Sessions, GET /Users/{uid}/Items/{id},
# POST /Sessions/{id}/Playing. HA only through ~/bin/ha: state reads, media_player/remote turn_on, select_source.
PLAY_CFG = os.path.expanduser(os.environ.get("MEDIA_PLAY_CONFIG") or "~/.config/media/play.json")
HA_BIN = os.environ.get("MEDIA_HA_BIN") or os.path.expanduser("~/bin/ha")
PLAY_WAIT = _env_num("MEDIA_PLAY_WAIT", 60)          # seconds per stage: TV on, app open, Emby session up
PLAY_CONFIRM = _env_num("MEDIA_PLAY_CONFIRM", 20)    # seconds until the session reports the item playing
PLAY_POLL = _env_num("MEDIA_PLAY_POLL", 2)
PLAY_LOCK = os.path.expanduser(os.environ.get("MEDIA_PLAY_LOCK") or "~/.local/state/media/play.lock")
PLAY_KEYS = {"enabled": bool, "tv": str, "wake": str, "app": str, "device": str, "client": str, "resume": bool}
PLAY_ENV = {"tv": "MEDIA_PLAY_TV", "wake": "MEDIA_PLAY_WAKE", "app": "MEDIA_PLAY_APP",
            "device": "MEDIA_PLAY_DEVICE", "client": "MEDIA_PLAY_CLIENT"}      # never "enabled": only the file
# Private device notes shared with ~/bin/emby: {"<Emby DeviceName substring>": {lan_mbit, prefer_over_mbit, client,
# source, label}}. A device's limit = prefer_over_mbit, else PREFER_SHARE x lan_mbit (Mbit/s of the item's bitrate).
PLAY_DEVICES = os.path.expanduser(os.environ.get("MEDIA_PLAY_DEVICES") or "~/.config/emby/devices.json")
PREFER_SHARE = 0.8
DEV_NUM = ("lan_mbit", "prefer_over_mbit")
DEV_TEXT = ("client", "source", "label")
DOC_NETS = [ipaddress.ip_network(n) for n in ("192.0.2.0/24", "198.51.100.0/24", "203.0.113.0/24", "2001:db8::/32")]
TV_ON =("on", "idle", "playing", "paused", "buffering")
TURN_ON_BIT = 128                                    # MediaPlayerEntityFeature.TURN_ON
PLAYABLE = ("Movie", "Episode", "Video", "MusicVideo")
ITEM_RE = re.compile(r"[0-9]{1,12}|[0-9a-f]{32}")
TV_RE = re.compile(r"media_player\.[a-z0-9_]{1,80}")
WAKE_RE = re.compile(r"(media_player|remote)\.[a-z0-9_]{1,80}")
TEXT_RE = re.compile(r"[\w .+()&'-]{1,40}")
EMBY = "/emby"


class PlayRefused(Exception):
    """Refused before anything was sent (exit 2)."""


def play_config():
    """PLAY_CFG merged with MEDIA_PLAY_* env overrides -> (cfg, problems). enabled only from the file, only when true
    and nothing is wrong."""
    cfg, problems = {"app": "Emby", "client": "Emby", "resume": True, "wake": None, "tv": None, "device": None}, []
    try:
        with open(PLAY_CFG) as f:
            raw = json.load(f)
        if not isinstance(raw, dict):
            raise ValueError("not a JSON object")
        cfg["_file"] = "present"
        for k, v in raw.items():
            if k in PLAY_KEYS and isinstance(v, PLAY_KEYS[k]):
                cfg[k] = v
            elif k in PLAY_KEYS:
                problems.append(f"{k} must be a {PLAY_KEYS[k].__name__}")
    except FileNotFoundError:
        cfg["_file"] = "absent"
    except (OSError, ValueError) as e:
        cfg["_file"] = "unreadable"
        problems.append(f"{os.path.basename(PLAY_CFG)}: {type(e).__name__}")
    for k, env in PLAY_ENV.items():
        if os.environ.get(env):
            cfg[k] = os.environ[env]
    for k, rx in (("tv", TV_RE), ("wake", WAKE_RE), ("app", TEXT_RE), ("device", TEXT_RE), ("client", TEXT_RE)):
        if cfg.get(k) is not None and not rx.fullmatch(str(cfg[k])):
            problems.append(f"{k} is not valid")
            cfg[k] = None
    for k in ("tv", "device"):
        if not cfg.get(k):
            problems.append(f"no {k} set (play.json or {PLAY_ENV[k]})")
    cfg["enabled"] = cfg.get("enabled") is True and cfg["_file"] == "present" and not problems
    return cfg, problems


def play_enabled():
    try:
        return play_config()[0]["enabled"]
    except Exception:
        return False


# The exact calls, as text: the dry run prints these and the real run logs the same strings.
def ha_argv(*args):
    return [HA_BIN] + [str(x) for x in args]


def ha_state_argv(eid):
    return ha_argv("state", eid, "--json")


def ha_call_argv(service, eid, data=None):
    return ha_argv("call", service, eid, *([json.dumps(data)] if data else []), "--wait", "3")


def show_argv(argv):
    return " ".join(["ha"] + [a if re.fullmatch(r"[\w.,:/=+-]+", a) else "'" + a.replace("'", "'\\''") + "'"
                              for a in argv[1:]])


def p_item(item):
    return f"{EMBY}/Items?Ids={q(item)}&Recursive=true&Fields=RunTimeTicks,MediaSources"


def p_user_item(uid, item):
    return f"{EMBY}/Users/{q(uid)}/Items/{q(item)}"


def p_sessions(sid=None):
    return f"{EMBY}/Sessions" + (f"?Id={q(sid)}" if sid else "")


def p_play(sid, item, start=0):
    return (f"{EMBY}/Sessions/{q(sid)}/Playing?ItemIds={q(item)}&PlayCommand=PlayNow"
            + (f"&StartPositionTicks={int(start)}" if start else ""))


def ha_run(argv):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=TIMEOUT + 15, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        raise ApiError(f"{show_argv(argv)}: timed out")
    except OSError as e:
        raise ApiError(f"{show_argv(argv)}: {type(e).__name__}")
    return r.returncode, r.stdout, r.stderr


def ha_state(eid):
    argv = ha_state_argv(eid)
    code, out, err = ha_run(argv)
    if code != 0:
        raise ApiError(f"{show_argv(argv)}: exit {code}: {(err or out).strip()[:200]}")
    try:
        d = json.loads(out)
    except ValueError:
        raise ApiError(f"{show_argv(argv)}: not JSON")
    if not isinstance(d, dict):
        raise ApiError(f"{show_argv(argv)}: several entities match")
    a = d.get("attributes") or {}
    try:
        feats = int(a.get("supported_features") or 0)
    except (TypeError, ValueError):
        feats = 0
    return {"state": d.get("state"), "source": a.get("source"), "features": feats}


def ha_call(service, eid, data=None):
    argv = ha_call_argv(service, eid, data)
    code, out, err = ha_run(argv)
    if code not in (0, 3):           # 3 = sent, new state not confirmed: we poll ourselves
        raise ApiError(f"{show_argv(argv)}: exit {code}: {(err or out).strip()[:200]}")
    return show_argv(argv)


def wait_for(fn, secs, what):
    end = time.monotonic() + secs
    while True:
        v = fn()
        if v:
            return v
        if time.monotonic() >= end:
            raise ApiError(f"gave up after {secs:g}s waiting for {what}")
        time.sleep(PLAY_POLL)


def lan_ep(ep):
    """True for an Emby RemoteEndPoint ('ip', 'ip:port', '[v6]:port') in the profile's LAN prefix, else on a private,
    loopback or link-local address (documentation ranges never count: Python calls them private)."""
    host = str(ep or "").strip()
    host = host[1:].split("]")[0] if host.startswith("[") else (host.rsplit(":", 1)[0] if host.count(":") == 1 else host)
    try:
        pre = assistant_profile.get("network.lan_prefix") or ""
    except Exception:
        pre = ""
    if pre and host.startswith(pre):
        return True
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        return False
    ip = getattr(ip, "ipv4_mapped", None) or ip
    if any(ip.version == n.version and ip in n for n in DOC_NETS):
        return False
    return ip.is_private or ip.is_loopback or ip.is_link_local


def pick_session(sessions, cfg, lan=False):
    """The newest remote-controllable video session of the TV's Emby app (Client and DeviceName substrings);
    lan: only sessions from a LAN address (a generic device name could also be a friend's device)."""
    dev, cli = str(cfg.get("device") or "").lower(), str(cfg.get("client") or "").lower()
    hits = [s for s in sessions or [] if isinstance(s, dict) and s.get("SupportsRemoteControl")
            and "Video" in (s.get("PlayableMediaTypes") or []) and dev and dev in str(s.get("DeviceName") or "").lower()
            and cli in str(s.get("Client") or "").lower() and (not lan or lan_ep(s.get("RemoteEndPoint")))]
    return max(hits, key=lambda s: str(s.get("LastActivityDate") or ""), default=None)


def play_devices():
    """devices.json -> ({name: entry}, problems). A missing file = no devices; a bad entry or field is skipped and
    named (it never blocks play: the play.json device stays the target)."""
    base = os.path.basename(PLAY_DEVICES)
    try:
        with open(PLAY_DEVICES) as f:
            raw = json.load(f)
    except FileNotFoundError:
        return {}, []
    except (OSError, ValueError) as e:
        return {}, [f"{base}: {type(e).__name__}"]
    if not isinstance(raw, dict):
        return {}, [f"{base}: not a JSON object"]
    out, problems = {}, []
    for name, v in raw.items():
        if not TEXT_RE.fullmatch(str(name)) or not isinstance(v, dict):
            problems.append(f"{base}: an entry is not valid")
            continue
        d = {"name": name}
        for k in DEV_NUM:
            x = v.get(k)
            if x is not None and (isinstance(x, bool) or not isinstance(x, (int, float)) or not 0 < x <= 100000):
                problems.append(f"{name}: {k} must be a positive number")
            elif x is not None:
                d[k] = float(x)
        for k in DEV_TEXT:
            x = v.get(k)
            if x is not None and not (isinstance(x, str) and TEXT_RE.fullmatch(x)):
                problems.append(f"{name}: {k} is not valid")
            elif x is not None:
                d[k] = x
        out[name] = d
    return out, problems


def dev_limit(d):
    """Item bitrate (Mbit/s) above which another device is preferred over this one; None = no known limit."""
    if d.get("prefer_over_mbit"):
        return d["prefer_over_mbit"]
    return PREFER_SHARE * d["lan_mbit"] if d.get("lan_mbit") else None


def dev_key(name, devs):
    """The devices.json key for an Emby device name: same name (any case), else a key contained in it (or it in a key)."""
    n = str(name or "").lower()
    if not n:
        return None
    return (next((k for k in devs if k.lower() == n), None)
            or next((k for k in devs if k.lower() in n or n in k.lower()), None))


def play_targets(cfg, devs):
    """[the play.json device (HA wakes the TV and opens its app), then every other devices.json device (played through
    its own LAN Emby session; "source" = the TV input that shows it, optional)]."""
    pk = dev_key(cfg.get("device"), devs)
    prim = dict(devs.get(pk) or {})
    prim.update(name=cfg.get("device") or "<device>", source=cfg.get("app") or "Emby", primary=True,
                match={"device": cfg.get("device"), "client": cfg.get("client")}, lan=False)
    out = [prim]
    for k, d in devs.items():
        if k != pk:
            out.append(dict(d, source=d.get("source"), primary=False, lan=True,
                            match={"device": k, "client": d.get("client") or ""}))
    for t in out:
        t.setdefault("label", t["name"])
        t["limit"] = dev_limit(t)
    return out


def find_target(targets, want):
    """--target DEVICE -> the target (name or label, any case; else a unique name substring), or PlayRefused."""
    w = str(want or "").strip().lower()
    hits = [t for t in targets if w in (t["name"].lower(), t["label"].lower())] or \
           [t for t in targets if w and w in t["name"].lower()]
    if len(hits) != 1:
        known = ", ".join(t["name"] for t in targets)
        raise PlayRefused(f"{'ambiguous' if hits else 'unknown'} --target {want!r} (known: {known})")
    return hits[0]


def _int(v):
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return 0


def item_media(item):
    """(bitrate in bit/s or None, '4K remux' / '4K' / '1080p' / '') of the item's default (first) media source."""
    srcs = (item or {}).get("MediaSources") or []
    src = srcs[0] if srcs and isinstance(srcs[0], dict) else {}
    w = max((_int(s.get("Width")) for s in src.get("MediaStreams") or [] if isinstance(s, dict)
             and s.get("Type") == "Video"), default=0)
    res = "4K" if w >= 3200 else "1080p" if w >= 1800 else ""
    remux = "remux" in f"{src.get('Name') or ''} {src.get('Path') or ''}".lower()
    return _int(src.get("Bitrate")) or None, " ".join(x for x in (res, "remux" if remux else "") if x)


def needs_sessions(targets, bitrate, forced):
    """The choice reads /Sessions only when the item is above the default device's limit and another device exists."""
    lim = targets[0]["limit"]
    return forced is None and len(targets) > 1 and bool(bitrate) and lim is not None and bitrate / 1e6 > lim


def choose_target(targets, bitrate, sessions, forced=None, kind=""):
    """-> {target, reason, hint, mbit}: the default device unless the item is above its limit and another device that
    fits has an online LAN session (the one with the most headroom wins); the hint names a stutter risk."""
    mbit = bitrate / 1e6 if bitrate else None
    prim = targets[0]

    def fits(t):
        return mbit is None or t["limit"] is None or mbit <= t["limit"]

    def hint(t):
        if fits(t):
            return None
        alt = max((x for x in targets if x is not t and fits(x)), key=lambda x: x["limit"] or math.inf, default=None)
        return (f"{kind + ' ' if kind else ''}{mbit:.0f} Mbit: may stutter on {t['label']}"
                + (f" — {alt['label']} handles it" if alt else ""))

    def out(t, reason):
        return {"target": t, "reason": reason, "hint": hint(t), "mbit": round(mbit, 1) if mbit else None}
    if forced is not None:
        return out(forced, "--target")
    if mbit is None:
        return out(prim, "bitrate unknown: the default device")
    if fits(prim):
        return out(prim, f"{mbit:.0f} Mbit fits {prim['label']}"
                         + (f" (limit {prim['limit']:g})" if prim["limit"] is not None else ""))
    over = f"{mbit:.0f} Mbit is above {prim['label']}'s {prim['limit']:g} Mbit limit"
    if sessions is None:
        return out(prim, over + "; sessions not read")
    online = [t for t in targets[1:] if fits(t) and pick_session(sessions, t["match"], t["lan"])]
    if online:
        t = max(online, key=lambda x: x["limit"] or math.inf)
        return out(t, f"{over}; {t['label']} is online")
    return out(prim, over + "; no faster device is online")


def resume_ticks(item, cfg, from_start):
    ud = (item or {}).get("UserData") or {}
    pos = int(ud.get("PlaybackPositionTicks") or 0)
    return pos if cfg.get("resume", True) and not from_start and pos > 0 and not ud.get("Played") else 0


def play_plan(a, cfg, t, targets, forced=None):
    """[(call, when)]: every call the real run can make for target t, in order, with the condition that triggers it."""
    tv, wake, app, it = cfg.get("tv") or "<tv>", cfg.get("wake"), t.get("source"), a.item
    wait, conf, poll = f"{PLAY_WAIT:g}", f"{PLAY_CONFIRM:g}", f"{PLAY_POLL:g}"
    steps = [(f"GET  {p_item(it)}", "always: the item exists and is a movie/episode; bitrate of its default source")]
    if forced is None and len(targets) > 1 and targets[0]["limit"] is not None:
        steps.append((f"GET  {p_sessions()}", f"bitrate above {targets[0]['label']}'s {targets[0]['limit']:g} Mbit: "
                                              f"is a faster device online ({', '.join(x['name'] for x in targets[1:])})"))
    steps.append((show_argv(ha_state_argv(tv)), "always: TV state, source, supported_features"))
    if not a.no_wake:
        steps.append((show_argv(ha_call_argv("media_player.turn_on", tv)),
                      f"TV off/unavailable and it supports turn_on (feature bit {TURN_ON_BIT})"))
        if wake:
            steps.append((show_argv(ha_call_argv(wake.split(".")[0] + ".turn_on", wake)),
                          "TV off/unavailable, no turn_on on the TV: wakes it over HDMI-CEC"))
        steps.append((show_argv(ha_state_argv(tv)), f"after a wake: every {poll}s, up to {wait}s, until the TV is on"))
    resume = not a.from_start and cfg.get("resume", True)
    if app:
        steps += [(show_argv(ha_call_argv("media_player.select_source", tv, {"source": app})), f"TV source is not {app}"),
                  (show_argv(ha_state_argv(tv)), f"after select_source: every {poll}s, up to {wait}s, until source = {app}")]
    m = t["match"]
    steps += [(f"GET  {p_sessions()}", f"every {poll}s, up to {wait}s, until a remote-controllable video session with "
                                       f"Client ~ {m.get('client')!r} and DeviceName ~ {m.get('device')!r}"
                                       + (" from the LAN" if t["lan"] else "") + " shows up"),
              (f"GET  {p_user_item('{session.UserId}', it)}", "resume point and played flag for the session's user"),
              (f"POST {p_play('{session.Id}', it)}" + ("[&StartPositionTicks={resume}]" if resume else ""),
               "always" + (": from the resume point when there is one" if resume else ": from the start")),
              (f"GET  {p_sessions('{session.Id}')}", f"every {poll}s, up to {conf}s, until NowPlayingItem.Id = {it}")]
    base = ((CFG.get("emby") or {}).get("url") or "<emby url>").rstrip("/")
    return [(re.sub(r"^(GET|POST) ( ?)/", lambda m: f"{m.group(1)} {m.group(2)}{base}/", c)
             .replace("%7Bsession.Id%7D", "{session.Id}").replace("%7Bsession.UserId%7D", "{session.UserId}"), w)
            for c, w in steps]


def play_probe(a, cfg, t, item, ss):
    """--dry-run --probe: the read-only calls of the plan, live, each failing softly (item/sessions: the dry run's)."""
    out = {}
    for name, eid in (("tv", cfg.get("tv")), ("wake", cfg.get("wake"))):
        if eid:
            try:
                out[name] = ha_state(eid)
            except ApiError as e:
                out[name] = {"error": str(e)}
    if not (CFG.get("emby") or {}).get("key"):
        out["emby"] = {"error": f"no emby url/key in {SECRETS}"}
        return out
    if isinstance(item, ApiError):
        out["item"] = {"error": str(item)}
    else:
        out["item"] = {"found": bool(item), "type": (item or {}).get("Type"), "name": (item or {}).get("Name")}
    try:
        ss = (get("emby", p_sessions()) or []) if ss is None else ss
        s = pick_session(ss, t["match"], t["lan"])
        out["sessions"] = {"total": len(ss), "match": bool(s), "remote_control": sum(1 for x in ss if isinstance(x, dict) and x.get("SupportsRemoteControl")),
                           "clients": sorted({f"{x.get('Client')} @ {x.get('DeviceName')}" for x in ss if isinstance(x, dict)})[:10]}
    except ApiError as e:
        out["sessions"] = {"error": str(e)}
    return out


def dry_choice(a, targets, forced):
    """The dry run's target choice: Emby GETs only (the item; /Sessions when the choice needs them), failing softly.
    -> (choice, item | ApiError | None, sessions | None, calls made)."""
    item, ss, calls = None, None, []
    if not (CFG.get("emby") or {}).get("key"):
        return choose_target(targets, None, None, forced), None, None, calls
    try:
        calls.append(f"GET {p_item(a.item)}")
        items = (get("emby", p_item(a.item)) or {}).get("Items") or []
        item = items[0] if items and isinstance(items[0], dict) else None
    except ApiError as e:
        item = e
    br, kind = item_media(item) if isinstance(item, dict) else (None, "")
    if needs_sessions(targets, br, forced):
        try:
            calls.append(f"GET {p_sessions()}")
            ss = get("emby", p_sessions()) or []
        except ApiError:
            ss = None
    return choose_target(targets, br, ss, forced, kind), item, ss, calls


def play_dry(a, cfg, problems, targets, dprob, forced):
    ch, item, ss, calls = dry_choice(a, targets, forced)
    t = ch["target"]
    steps = play_plan(a, cfg, t, targets, forced)
    probe = play_probe(a, cfg, t, item, ss) if a.probe else None
    why = "enabled, real mode runs" if cfg["enabled"] else (
        f"real mode refuses: {PLAY_CFG} is {cfg['_file']}" + (f"; {'; '.join(problems)}" if problems else "")
        + ("" if problems else '; needs "enabled": true'))
    has_key = bool((CFG.get("emby") or {}).get("key"))
    if a.json:
        emit_json({"dry_run": True, "item": a.item, "enabled": cfg["enabled"], "config": cfg["_file"],
                   "problems": problems, "tv": cfg.get("tv"), "wake": cfg.get("wake"), "app": cfg.get("app"),
                   "emby_key": has_key, "target": t["name"], "target_label": t["label"], "primary": t["primary"],
                   "reason": ch["reason"], "hint": ch["hint"], "mbit": ch["mbit"], "devices": [x["name"] for x in targets],
                   "device_problems": dprob, "emby_reads": calls,
                   "steps": [{"n": i + 1, "call": c, "when": w} for i, (c, w) in enumerate(steps)], "probe": probe})
        return
    print(f"media play {a.item}: dry run, nothing sent to HA or a player"
          + (f" ({len(calls)} read-only Emby GET{'s' if len(calls) != 1 else ''})" if calls else " (no network)"))
    print(f"config: {why}")
    print(f"target: {t['name']} ({ch['reason']})")
    if ch["hint"]:
        print(f"hint: {ch['hint']}")
    if dprob:
        print(f"devices: {'; '.join(dprob)}")
    if isinstance(item, ApiError):
        print(f"item: {item}")
    print(f"TV {cfg.get('tv')} · wake {cfg.get('wake') or '-'} · app {cfg.get('app')} · "
          f"Emby key {'set' if has_key else 'missing (add an emby {url,key} entry)'}")
    for i, (c, w) in enumerate(steps, 1):
        print(f"{i:2}. {c}\n      when: {w}")
    if probe is not None:
        print("probe (read-only, live):")
        for k, v in probe.items():
            print(f"  {k}: {json.dumps(v, ensure_ascii=False)}")


def play_real(a, cfg, targets, forced):
    """Pick the target by bitrate, wake the TV, open the target's app or input, find its session, PlayNow, read back.
    Returns (exit code, result dict)."""
    log, res = [], {"item": a.item, "sent": False}

    def step(msg):
        log.append(msg)
        if not a.json:
            print(f"· {msg}")

    tv = cfg["tv"]
    items = (get("emby", p_item(a.item)) or {}).get("Items") or []
    step(f"GET {p_item(a.item)} -> {len(items)} item(s)")
    if not items:
        raise PlayRefused(f"no Emby item {a.item}")
    if items[0].get("Type") not in PLAYABLE:
        raise PlayRefused(f"item {a.item} is a {items[0].get('Type')}, not a movie or episode")
    res["title"] = items[0].get("Name")
    br, kind = item_media(items[0])
    ss = None
    if needs_sessions(targets, br, forced):
        try:
            ss = get("emby", p_sessions()) or []
        except ApiError as e:
            step(f"sessions not read: {e}")
    ch = choose_target(targets, br, ss, forced, kind)
    t, app = ch["target"], ch["target"].get("source")
    res.update(target=t["name"], target_label=t["label"], primary=t["primary"], reason=ch["reason"], hint=ch["hint"])
    step(f"target {t['name']}: {ch['reason']}")
    st = ha_state(tv)
    step(f"TV {st['state']}, source {st['source']}")
    if st["state"] not in TV_ON:
        if a.no_wake:
            raise ApiError(f"the TV is {st['state']} (--no-wake)")
        if st["features"] & TURN_ON_BIT:
            step(ha_call("media_player.turn_on", tv))
        elif cfg.get("wake"):
            step(ha_call(cfg["wake"].split(".")[0] + ".turn_on", cfg["wake"]))
        else:
            raise ApiError("the TV is off, has no turn_on and no wake entity is set")
        st = wait_for(lambda: (lambda s: s if s["state"] in TV_ON else None)(ha_state(tv)), PLAY_WAIT, "the TV to turn on")
        step(f"TV {st['state']}, source {st['source']}")
    if app and st["source"] != app:
        step(ha_call("media_player.select_source", tv, {"source": app}))
        wait_for(lambda: ha_state(tv)["source"] == app, PLAY_WAIT, f"the TV to open {app}")
        step(f"TV source {app}")
    elif not app:
        step(f"TV input left as is (no source for {t['name']} in {os.path.basename(PLAY_DEVICES)})")
    sess = wait_for(lambda: pick_session(get("emby", p_sessions()), t["match"], t["lan"]), PLAY_WAIT,
                    "the TV's Emby session" if t["primary"] else f"{t['label']}'s Emby session")
    sid = sess["Id"]
    step(f"session {sess.get('Client')} @ {sess.get('DeviceName')}")
    item = get("emby", p_user_item(sess.get("UserId"), a.item)) or {}
    start = resume_ticks(item, cfg, a.from_start)
    api("emby", "POST", p_play(sid, a.item, start))
    res.update(sent=True, resume_min=round(start / TICKS_PER_MIN) if start else 0)
    step(f"POST {p_play(sid, a.item, start)}")

    def playing():
        ss = get("emby", p_sessions(sid)) or []
        return any(str(((s or {}).get("NowPlayingItem") or {}).get("Id")) == a.item for s in ss)
    try:
        wait_for(playing, PLAY_CONFIRM, "playback to start")
    except ApiError as e:
        res.update(ok=False, note=str(e), log=log)
        return 3, res
    res.update(ok=True, log=log)
    return 0, res


def cmd_play(a):
    if not ITEM_RE.fullmatch(a.item or ""):
        die("play: ITEM_ID must be an Emby item id (digits)", 2)
    cfg, problems = play_config()
    devs, dprob = play_devices()
    targets = play_targets(cfg, devs)
    try:
        forced = find_target(targets, a.target) if a.target is not None else None
    except PlayRefused as e:
        die(f"play: {e}", 2)
    if a.dry_run:
        return play_dry(a, cfg, problems, targets, dprob, forced)
    if a.probe:
        die("play: --probe only goes with --dry-run", 2)
    if not cfg["enabled"]:
        die(f"play is staged: real mode needs {PLAY_CFG} with {{\"enabled\": true}}"
            + (f" ({'; '.join(problems)})" if problems else f" (now: {cfg['_file']})"), 2)
    if not (CFG.get("emby") or {}).get("key"):
        die(f"play: no emby url/key in {SECRETS}", 2)
    os.makedirs(os.path.dirname(PLAY_LOCK), exist_ok=True)
    with open(PLAY_LOCK, "w") as lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            die("play: another play is running", 2)
        try:
            code, res = play_real(a, cfg, targets, forced)
        except PlayRefused as e:
            die(f"play: {e}", 2)
    where = "the TV" if res.get("primary", True) else res.get("target_label")
    if a.json:
        emit_json(res)
    elif code == 0:
        print(f"▶ Playing {res.get('title')} on {where}" + (f" (from {res['resume_min']} min)" if res.get("resume_min") else ""))
    else:
        print(f"Sent {res.get('title')} to {where}, but it isn't playing yet: {res.get('note')}")
    if res.get("hint") and not a.json:
        print(res["hint"])
    if code:
        sys.exit(code)


# ---------- continue: Emby's Continue watching for his user, one "📺" button per item (mt:play:<movie or episode id>) ----------
# GET-only: /Users/{uid}/Items/Resume (Emby 4.9+ merges next episodes into it), /Shows/NextUp (LegacyNextUp), and per
# next episode the series' last played episode (its date). uid = his Seerr user's linked Emby account, as tonight.
CT_FIELDS = "UserDataLastPlayedDate,RunTimeTicks,SeriesName,SeriesId,ParentIndexNumber,IndexNumber,ProductionYear"
CT_FETCH = 24              # Resume entries read per run
CT_MAX = 8                 # -n cap
CT_RECENT_DAYS = 14        # tonight's "▶ Continue" button: last watched within this many days
CT_BTN = 22                # title length on a button
CT_LINE = 45               # title length in a message line
GUID_RE = re.compile(r"[0-9a-f]{32}")


def ct_guid(rec):
    """His Emby user id (32 hex, the API's form) from MEDIA_CONTINUE_EMBY_USER, else the Seerr record's linked account."""
    env = os.environ.get("MEDIA_CONTINUE_EMBY_USER")
    raw = env if env else str((rec() if callable(rec) else rec or {}).get("jellyfinUserId") or "")
    g = re.sub(r"[^0-9a-f]", "", raw.lower())
    if not GUID_RE.fullmatch(g):
        raise ApiError("MEDIA_CONTINUE_EMBY_USER must be an Emby user id (32 hex)" if env
                       else f"Seerr user {TONIGHT_USER!r} has no linked Emby account")
    return g


def p_resume(uid, n=CT_FETCH):
    return f"{EMBY}/Users/{q(uid)}/Items/Resume?Limit={int(n)}&Recursive=true&MediaTypes=Video&Fields={CT_FIELDS}"


def p_nextup(uid, n):
    return f"{EMBY}/Shows/NextUp?UserId={q(uid)}&Limit={int(n)}&LegacyNextUp=true&Fields={CT_FIELDS}"


def p_last_ep(uid, series):
    return (f"{EMBY}/Users/{q(uid)}/Items?ParentId={q(series)}&Recursive=true&IncludeItemTypes=Episode&IsPlayed=true"
            f"&SortBy=DatePlayed&SortOrder=Descending&Limit=1&Fields=UserDataLastPlayedDate")


def ct_num(v):
    """An int field from Emby, or None (missing, bool or not a number)."""
    return v if isinstance(v, int) and not isinstance(v, bool) else (int(v) if isinstance(v, str) and v.isdigit() else None)


def ct_cut(s, n):
    s = re.sub(r"\s+", " ", str(s or "")).strip() or "?"
    return s if len(s) <= n else s[:n - 1].rstrip() + "…"


def ct_item(x, src):
    """An Emby Resume/NextUp entry -> item dict, or None (played, not a movie/episode, or not a plain item id: a
    series, season or folder id never becomes a play button)."""
    if not isinstance(x, dict):
        return None
    iid, typ = str(x.get("Id") or ""), x.get("Type")
    ud = x.get("UserData") if isinstance(x.get("UserData"), dict) else {}
    if typ not in PLAYABLE or not ITEM_RE.fullmatch(iid) or ud.get("Played"):
        return None
    ep = typ == "Episode"
    s, e = ct_num(x.get("ParentIndexNumber")), ct_num(x.get("IndexNumber"))
    pos, run = ct_num(ud.get("PlaybackPositionTicks")) or 0, ct_num(x.get("RunTimeTicks")) or 0
    last = zdt(ud.get("LastPlayedDate"))
    if last and last.year < 2000:
        last = None                                  # Emby's year-1 placeholder
    return {"id": iid, "kind": "episode" if ep else ("movie" if typ == "Movie" else "video"),
            "title": str((x.get("SeriesName") if ep else None) or x.get("Name") or "?"),
            "episode": f"S{s:02d}E{e:02d}" if ep and s is not None and e is not None else None,
            "episode_title": x.get("Name") if ep else None,
            "series_id": str(x["SeriesId"]) if ep and x.get("SeriesId") else None,
            "year": None if ep else ct_num(x.get("ProductionYear")),
            "pos_min": max(1, round(pos / TICKS_PER_MIN)) if pos > 0 else 0,
            "runtime_min": round(run / TICKS_PER_MIN) if run > 0 else None,
            "state": "resume" if pos > 0 else "next", "source": src,
            "last_played": iso_z(last) if last else None, "last_from": "item" if last else None}


def ct_series_date(uid, series):
    """When he last finished an episode of `series` (aware datetime) or None; fails softly."""
    try:
        r = get("emby", p_last_ep(uid, series)) or {}
        x = (r.get("Items") or [None])[0]
        d = zdt(((x or {}).get("UserData") or {}).get("LastPlayedDate")) if isinstance(x, dict) else None
        return d if d and d.year >= 2000 else None
    except (ApiError, AttributeError, TypeError):
        return None


def ct_collect(uid, n, warns):
    """His Continue watching, first n: Resume in Emby's order, then Next Up entries it lacks (one entry per series).
    Emby 4.9+ merges next episodes into Resume: its order stands. An older Emby lists them only under Next Up: then
    the list is ordered by last watched (a next episode by its series' last play). Resume failing raises ApiError."""
    res = get("emby", p_resume(uid)) or {}
    raw = [(x, "resume") for x in (res.get("Items") or [] if isinstance(res, dict) else [])]
    try:
        nu = get("emby", p_nextup(uid, max(n, 8))) or {}
        raw += [(x, "nextup") for x in (nu.get("Items") or [] if isinstance(nu, dict) else [])]
    except ApiError as e:
        warns.append(f"Next Up: {e}")
    items, ids, series = [], set(), set()
    for x, src in raw:
        it = ct_item(x, src)
        if not it or it["id"] in ids or (it["series_id"] and it["series_id"] in series):
            continue
        ids.add(it["id"])
        if it["series_id"]:
            series.add(it["series_id"])
        items.append(it)
    merged = any(it["source"] == "resume" and it["state"] == "next" for it in items)
    extra = any(it["source"] == "nextup" for it in items)
    sort = extra and not merged
    for it in items[:n + 4 if sort else n]:
        if not it["last_played"] and it["series_id"]:
            d = ct_series_date(uid, it["series_id"])
            if d:
                it.update(last_played=iso_z(d), last_from="series")
    if sort:
        items.sort(key=lambda it: it["last_played"] or "", reverse=True)    # stable: undated keep their order
    return items[:n], len(items)


def ct_when(iso, now):
    d = zdt(iso)
    if not d:
        return None
    days = (now.astimezone(ZRH).date() - d.astimezone(ZRH).date()).days
    if days <= 0:
        return "today"
    if days == 1:
        return "yesterday"
    if days < 7:
        return f"{days} days ago"
    return ldate(d, "%d.%m." if d.astimezone(ZRH).year == now.astimezone(ZRH).year else "%d.%m.%Y")


def ct_line(it, now, md=True):
    """'🍿 Title (2024) · 27 of 92 min · yesterday' / '📺 Show S04E07 · next up · 45 min · 3 days ago'."""
    t = ct_cut(it["title"], CT_LINE)
    head = f"**{tn_md(t)}**" if md else t
    if it.get("episode"):
        head += f" {it['episode']}"
    elif it.get("year"):
        head += f" ({it['year']})"
    bits, run = [head], it.get("runtime_min")
    if it["state"] == "resume":
        bits.append(f"{it['pos_min']} of {run} min" if run else f"at {it['pos_min']} min")
    else:
        bits += (["next up"] if it["kind"] == "episode" else []) + ([f"{run} min"] if run else [])
    when = ct_when(it.get("last_played"), now)
    if when:
        bits.append(when)
    return ("📺 " if it["kind"] == "episode" else "🍿 ") + " · ".join(bits)


def ct_button_title(it, n=CT_BTN):
    return ct_cut(it["title"], n) + (f" {it['episode']}" if it.get("episode") else "")


def ct_message(items, now, play_on, notes, md=True):
    lines = ["▶ **Continue watching**" if md else "▶ Continue watching", ""]
    lines += [ct_line(it, now, md) for it in items] or ["Nothing to continue: no partly watched movies or next episodes."]
    if items and not play_on:
        lines += ["", "Play on TV is switched off, so no buttons."]
    if notes:
        lines += ["", "⚠️ " + "; ".join(notes)[:300]]
    return "\n".join(lines)


def ct_buttons(items, play_on):
    return [[{"text": f"📺 {ct_button_title(it)}", "data": f"mt:play:{it['id']}"}] for it in items] if play_on else []


def ct_tonight_button(seerr_rec, picks, warns):
    """Tonight's "▶ Continue <title>" button (one row) for the newest Continue-watching item he watched within
    CT_RECENT_DAYS, skipping tonight's own picks; None when play is off, Emby has no key or nothing is recent."""
    if not play_enabled() or not (CFG.get("emby") or {}).get("key"):
        return None
    try:
        items, _ = ct_collect(ct_guid(seerr_rec), 4, [])
    except ApiError as e:
        warns.append(f"continue: {e}")
        return None
    now, taken = now_utc(), {str(p.get("emby_id")) for p in picks if p.get("emby_id")}
    for it in items:
        d = zdt(it.get("last_played"))
        if it["id"] not in taken and d and (now - d).total_seconds() <= CT_RECENT_DAYS * 86400:
            return [{"text": f"▶ Continue {ct_button_title(it)}", "data": f"mt:play:{it['id']}"}]
    return None


def cmd_continue(a):
    if a.n > CT_MAX:
        die(f"-n is at most {CT_MAX}")
    if not (CFG.get("emby") or {}).get("key"):
        die(f"continue: no emby url/key in {SECRETS}")
    warns, now = [], now_utc()
    uid = ct_guid(lambda: seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER"))
    items, total = ct_collect(uid, a.n, warns)
    play_on = play_enabled()
    notes = ["Next Up didn't load"] if warns else []
    out = {"generated": iso_z(now), "items": items, "total": total, "play_enabled": play_on, "warnings": warns,
           "message": ct_message(items, now, play_on, notes), "buttons": ct_buttons(items, play_on)}
    if a.json:
        emit_json(out)
    else:
        print(ct_message(items, now, play_on, [], md=False))
        for it in items:
            print(f"   button: mt:play:{it['id']} = media play {it['id']}")
        for w in warns:
            print(f"!! {w}")
    if warns:
        sys.exit(3)


# ---------- vibe: 4 library movies for a mood or "like <film>" (local EmbeddingGemma index; Emby GET-only) ----------
# Index = his Emby movie library's own metadata (title, year, genres, tagline, overview, rating, runtime; no user
# data), embedded with EmbeddingGemma by a llama-server this command starts on a free 127.0.0.1 port and stops after
# the run (MEDIA_VIBE_EMBED_URL = an OpenAI-style /v1/embeddings endpoint instead: tests). Files in VIBE_DIR:
# index.json (items, per-item text hash, the vectors file's name) + vectors-<hash>.f32 (unit rows in item order).
# A query re-reads the library (one paged GET) and embeds up to VIBE_LIVE_NEW new titles itself; `--refresh` (cron,
# nightly) does the rest. His played/partly watched movies (GET, his user only) rank lower; nobody else's history.
VIBE_DIR = os.path.expanduser(os.environ.get("MEDIA_VIBE_DIR") or "~/.local/state/vibe")
VIBE_SERVER = os.path.expanduser(os.environ.get("MEDIA_VIBE_SERVER") or "~/opt/llama.cpp/build/bin/llama-server")
VIBE_MODEL = os.path.expanduser(os.environ.get("MEDIA_VIBE_MODEL") or "~/opt/llm-models/embeddinggemma-300M-Q8_0.gguf")
VIBE_EMBED_URL = os.environ.get("MEDIA_VIBE_EMBED_URL")
VIBE_N, VIBE_MAX = 4, 8
VIBE_MIN_RATING = 6.5      # picks rated below this only when too few rated titles fit
VIBE_SHORT = 100           # "short" / "kurz" = at most this many minutes
VIBE_SEEN = 0.12           # score penalty for a movie he played (partly watched: half)
VIBE_TILT = 0.03           # +/- this for ratings 2 points above/below 7
VIBE_SAME_FROM = 0.82      # diversity: a candidate this similar to an earlier pick ...
VIBE_SAME = 0.6            # ... loses this x the excess
VIBE_POOL = 40             # candidates the diversity pass looks at
VIBE_REF_W = 0.5           # "like X" plus words: X's vector weighs this much, the words the rest
VIBE_GENRE_W = 0.10        # "like X": + this x the genre overlap with X (Jaccard)
VIBE_MOOD_W = 0.04         # mood words (tonight's TN_MOODS, genre names): + this for a matching genre ...
VIBE_AVOID_W = 0.06        # ... and - this for a genre the mood avoids (cozy: no horror/thriller/war)
VIBE_BATCH = 32
VIBE_DOC_CHARS = 1200
VIBE_LIVE_NEW = 48
VIBE_BOOT_S = 30
VIBE_FIELDS = "Overview,Genres,Taglines,ProviderIds,ProductionYear,CommunityRating,RunTimeTicks"
VIBE_SHORT_WORDS = {"short", "shorter", "quick", "kurz", "kurzer", "kurzes", "kurzen"}
VIBE_CAP_WORDS = {"under", "max", "unter", "below", "<", "≤", "<="}
VIBE_LIKE = re.compile(r"(?i)(?:^|\s)(?:something\s+)?(?:like|similar\s+to|à\s+la|a\s+la|ähnlich\s+wie|aehnlich\s+wie|wie)\s+(\S.*)$")
VIBE_GENRE_ALIASES = {  # Serbian metadata genres seen in the library (German ones: tonight's TN_ALIASES)
    "драма": "Drama", "комедија": "Comedy", "ратни": "War", "љубавни": "Romance", "трилер": "Thriller",
    "крими": "Crime", "акциони": "Action", "историјски": "History", "авантуристички": "Adventure", "тв филм": "TV Movie",
    "породични": "Family", "хорор": "Horror", "научна фантастика": "Science Fiction", "фантастика": "Fantasy",
    "мистерија": "Mystery", "анимација": "Animation", "анимирани": "Animation", "документарни": "Documentary",
    "музички": "Music", "вестерн": "Western", "tv-film": "TV Movie"}
VIBE_GENRE_SHORT = {"Science Fiction": "Sci-Fi", "Documentary": "Docu", "TV Movie": "TV movie"}
VIBE_STOP = {"with", "and", "the", "for", "that", "this", "some", "something", "movie", "movies", "film", "films", "mit",
             "und", "der", "die", "das", "ein", "eine", "einen", "but", "more", "less", "really", "very", "about"}
VIBE_HINT = ("🎬 /vibe + a mood or a film, e.g.\n/vibe cozy rainy sunday\n/vibe mind-bending scifi like Arrival\n"
             "/vibe short funny 90min\n/vibe a dark crime series")
VIBE_KINDS = {"movie": {"type": "Movie", "index": "index.json", "vec": "vectors-", "noun": "movies"},
              "series": {"type": "Series", "index": "series-index.json", "vec": "series-vectors-", "noun": "series"}}
VIBE_SERIES_WORDS = {"series", "serie", "serien", "serija", "serije", "seriju", "tv-series", "tvseries", "miniseries",
                     "mini-series", "show", "shows", "tv-show", "tv-shows", "tvshow", "tvshows", "сериј", "серија",
                     "серије", "серију"}
VIBE_TV_ALIASES = {  # TMDB TV genre halves in German/Serbian metadata ("Krieg & Politik") -> TMDB's English names
    "krieg": "War", "politik": "Politics", "seifenoper": "Soap", "kinder": "Kids", "nachrichten": "News",
    "сапуница": "Soap", "дечји": "Kids", "ријалити": "Reality", "рат": "War", "политика": "Politics"}
VIBE_BARELY = 0.25         # series: at most this share (or 2 episodes) watched = barely started, ranked as unwatched


def vb_canon(genres):
    """Emby genre names (English, German, Serbian) -> TMDB's English names, order kept, no duplicates."""
    out = []
    for g in genres:
        g = " ".join(str(g).split())
        for c in sorted(tn_genres(g)) if g.lower() not in VIBE_GENRE_ALIASES else [VIBE_GENRE_ALIASES[g.lower()]]:
            c = VIBE_TV_ALIASES.get(c.lower(), c)
            if c not in out:
                out.append(c)
    return out


def vb_tokens(text):
    """'cozy rainy sunday short' / 'heist under 2h' -> (words, minutes cap or None, short?)."""
    words, mins, short, cap_next = [], None, False, False
    for w in str(text or "").split():
        lw = w.lower().strip(",.!?;:")
        if lw in VIBE_SHORT_WORDS:
            short = True
            continue
        if lw in VIBE_CAP_WORDS:
            cap_next = True
            continue
        n = tn_minutes(lw.lstrip("<≤")) if (cap_next or re.search(r"\d\s*(h|hr|hrs|hours?|std|m|min|mins|minutes|')$", lw)
                                               or re.fullmatch(r"\d{1,2}h\d{1,2}(m|min)?", lw)) else None
        cap_next = False
        if n is not None and mins is None and n > 0:
            mins = n
            continue
        words.append(w)
    return words, (mins or (VIBE_SHORT if short else None)), short


def vb_doc(x):
    """One library item -> the embedded document text (EmbeddingGemma's document prompt)."""
    head = f"{x['title']} ({x['year']})" if x.get("year") else x["title"]
    bits = [head + "."] + (["TV series."] if x.get("kind") == "series" else [])
    if x.get("genres"):
        bits.append("Genres: " + ", ".join(x["genres"]) + ".")
    if x.get("tagline"):
        bits.append(x["tagline"].rstrip(".") + ".")
    if x.get("overview"):
        bits.append(x["overview"])
    return (f"title: {x['title']} | text: " + " ".join(bits))[:VIBE_DOC_CHARS]


def vb_query_text(words, kind="movie"):
    """EmbeddingGemma's query prompt; "<words> movie" ranked better than the bare words in live checks."""
    s = " ".join(words)
    if kind == "series":
        s += " TV series"
    elif not re.search(r"(?i)\b(movie|movies|film|films|filme)\b", s):
        s += " movie"
    return "task: search result | query: " + s


def vb_hash(doc):
    return hashlib.sha1((os.path.basename(VIBE_MODEL) + "\n" + doc).encode()).hexdigest()[:16]


def vb_library(kind="movie"):
    """His Emby movie (or series) library (GET, paged) -> [{id, title, year, genres, rating, min, tagline, overview,
    tmdb}] (+ kind "series": no runtime)."""
    out, start, total, typ = [], 0, None, VIBE_KINDS[kind]["type"]
    while total is None or start < total:
        d = get("emby", f"{EMBY}/Items?Recursive=true&IncludeItemTypes={typ}&Fields={VIBE_FIELDS}&EnableImages=false"
                        f"&EnableUserData=false&SortBy=SortName&StartIndex={start}&Limit={PAGE}") or {}
        rows = d.get("Items") or []
        total = int(d.get("TotalRecordCount") or 0)
        for x in rows:
            if x.get("Type", typ) != typ or not x.get("Id") or not x.get("Name"):
                continue
            pid = {str(k).lower(): v for k, v in (x.get("ProviderIds") or {}).items()}
            r = x.get("CommunityRating")
            ticks = x.get("RunTimeTicks") or 0
            out.append({"id": str(x["Id"]), "title": str(x["Name"]).strip(), "year": x.get("ProductionYear"),
                        "genres": vb_canon(x.get("Genres") or [])[:5],
                        "rating": round(float(r), 1) if isinstance(r, (int, float)) and 0 < r <= 10 else None,
                        "min": round(ticks / TICKS_PER_MIN) if ticks else None,
                        "tagline": " ".join(str((x.get("Taglines") or [""])[0] or "").split())[:160],
                        "overview": " ".join(str(x.get("Overview") or "").split())[:900],
                        "tmdb": str(pid.get("tmdb") or "") or None})
            if kind == "series":
                out[-1].update(kind="series", min=None)
        if not rows:
            break
        start += len(rows)
    return out


class VibeEmbed:
    """EmbeddingGemma for one run: MEDIA_VIBE_EMBED_URL, else a llama-server on a free loopback port (stopped on exit)."""
    def __init__(self, background=False):
        self.url, self.proc, self.background = VIBE_EMBED_URL, None, background
        self.opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))

    def __enter__(self):
        if self.url:
            return self
        for f in (VIBE_SERVER, VIBE_MODEL):
            if not os.path.exists(f):
                raise ApiError(f"embedding: missing {f}")
        s = socket.socket()
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
        s.close()
        argv = [VIBE_SERVER, "--host", "127.0.0.1", "--port", str(port), "-m", VIBE_MODEL, "--embeddings",
                "-c", "2048", "-b", "2048", "-ub", "2048", "-np", "1", "-t", "8"]
        self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     start_new_session=True, preexec_fn=(lambda: os.nice(10)) if self.background else None)
        self.url = f"http://127.0.0.1:{port}"
        end = time.time() + VIBE_BOOT_S
        while time.time() < end:
            if self.proc.poll() is not None:
                raise ApiError("embedding server exited at start")
            try:
                with self.opener.open(self.url + "/health", timeout=2) as r:
                    if r.status == 200:
                        return self
            except (OSError, http.client.HTTPException):
                pass
            time.sleep(0.05)
        raise ApiError(f"embedding server not up within {VIBE_BOOT_S} s")

    def __exit__(self, *exc):
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
                self.proc.wait(5)

    def embed(self, texts):
        """texts -> unit vectors (lists of floats), in order."""
        out = []
        for i in range(0, len(texts), VIBE_BATCH):
            chunk = texts[i:i + VIBE_BATCH]
            req = urllib.request.Request(self.url.rstrip("/") + "/v1/embeddings", json.dumps({"input": chunk}).encode(),
                                         {"Content-Type": "application/json"}, method="POST")
            try:
                with self.opener.open(req, timeout=max(TIMEOUT, 120)) as r:
                    d = json.loads(r.read())
            except (OSError, ValueError, http.client.HTTPException) as e:
                raise ApiError(f"embedding: {type(e).__name__}")
            rows = sorted(d.get("data") or [], key=lambda x: x.get("index", 0))
            if len(rows) != len(chunk):
                raise ApiError(f"embedding: {len(rows)} vectors for {len(chunk)} texts")
            for row in rows:
                v = [float(x) for x in row.get("embedding") or []]
                n = math.sqrt(sum(x * x for x in v)) or 1.0
                out.append([x / n for x in v])
        return out


def vb_load(kind="movie"):
    """(index dict, flat float array of vectors) or (None, None) when there is no usable index."""
    import array
    idx = botlib.load_json(os.path.join(VIBE_DIR, VIBE_KINDS[kind]["index"]), None)
    if not isinstance(idx, dict) or not idx.get("items") or not idx.get("vectors"):
        return None, None
    vec = array.array("f")
    try:
        with open(os.path.join(VIBE_DIR, os.path.basename(idx["vectors"])), "rb") as f:
            vec.frombytes(f.read())
    except (OSError, ValueError):
        return None, None
    if not idx.get("dim") or len(vec) != len(idx["items"]) * idx["dim"]:
        return None, None
    return idx, vec


def vb_save(idx, rows, kind="movie"):
    """Write vectors-<hash>.f32 then index.json (atomic), then drop older vector files (series: series-*)."""
    import array
    os.makedirs(VIBE_DIR, mode=0o700, exist_ok=True)
    vec = array.array("f")
    for r in rows:
        vec.extend(r)
    blob = vec.tobytes()
    pre = VIBE_KINDS[kind]["vec"]
    name = f"{pre}{hashlib.sha1(blob).hexdigest()[:12]}.f32"
    tmp = os.path.join(VIBE_DIR, name + ".tmp")
    with open(tmp, "wb") as f:
        f.write(blob)
    os.replace(tmp, os.path.join(VIBE_DIR, name))
    idx["vectors"] = name
    botlib.atomic_write(os.path.join(VIBE_DIR, VIBE_KINDS[kind]["index"]), json.dumps(idx, ensure_ascii=False))
    for f in os.listdir(VIBE_DIR):
        if f.startswith(pre) and f.endswith(".f32") and f != name:
            try:
                os.remove(os.path.join(VIBE_DIR, f))
            except OSError:
                pass


def vb_lock(block):
    """The index lock (fcntl): an open file, or None when another run holds it and block is False."""
    os.makedirs(VIBE_DIR, mode=0o700, exist_ok=True)
    f = open(os.path.join(VIBE_DIR, ".lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | (0 if block else fcntl.LOCK_NB))
    except OSError:
        f.close()
        return None
    return f


def vb_sync(lib, idx, vec, emb, limit=None):
    """Bring the index in line with the library: keep unchanged rows, embed new/changed ones (at most limit;
    None = all), drop removed ones -> (index, rows, counts)."""
    old, dim = {}, (idx or {}).get("dim")
    if idx and vec is not None:
        for i, it in enumerate(idx["items"]):
            old[it["id"]] = (it.get("h"), vec[i * dim:(i + 1) * dim])
    items, rows, todo = [], [], []
    for x in lib:
        doc = vb_doc(x)
        h = vb_hash(doc)
        prev = old.get(x["id"])
        if prev and prev[0] == h:
            items.append(dict(x, h=h))
            rows.append(list(prev[1]))
        else:
            todo.append((x, doc, h))
    n_new = sum(1 for x, _, _ in todo if x["id"] not in old)
    skipped = todo[limit:] if limit is not None else []
    todo = todo[:limit] if limit is not None else todo
    if todo:
        vs = emb.embed([d for _, d, _ in todo])
        for (x, _, h), v in zip(todo, vs):
            items.append(dict(x, h=h))
            rows.append(v)
    for x, _, _ in skipped:             # changed titles keep their old vector until the nightly run
        prev = old.get(x["id"])
        if prev:
            items.append(dict(x, h=prev[0]))
            rows.append(list(prev[1]))
    keep = {x["id"] for x in lib}
    counts = {"items": len(items), "embedded": len(todo), "new": n_new, "pending": len(skipped),
              "removed": sum(1 for k in old if k not in keep)}
    new_dim = len(rows[0]) if rows else dim
    out = dict(idx or {}, items=items, dim=new_dim, model=os.path.basename(VIBE_MODEL), built=iso_z(now_utc()))
    return out, rows, counts


def vb_stored_tpl():
    """The Emby web link template kept in either index (no Seerr call), or None."""
    for k in VIBE_KINDS.values():
        tpl = (botlib.load_json(os.path.join(VIBE_DIR, k["index"]), None) or {}).get("link_tpl")
        if tpl:
            return tpl
    return None


def vb_link_tpl(idx, lib, warns, kind="movie"):
    """Seerr's mediaUrl of one library title = the Emby web link template (kept in the index)."""
    if idx.get("link_tpl"):
        return idx["link_tpl"]
    if kind == "series" and vb_stored_tpl():
        idx["link_tpl"] = vb_stored_tpl()
        return idx["link_tpl"]
    t = Tonight(argparse.Namespace(), {}, warns)
    for x in lib[:5]:
        if x.get("tmdb"):
            url = t.link("movie" if kind == "movie" else "tv", x["tmdb"], x["id"])
            if url:
                idx["link_tpl"] = t.link_tpl
                return t.link_tpl
            if t.link_tpl == "":
                break
    return None


def vb_refresh(quiet=False, full=False):
    """Both indexes: movies (Emby returning none ends the run) then series (none = nothing to do)."""
    lines, warns = [], []
    lock = vb_lock(True)
    try:
        with VibeEmbed(background=True) as emb:
            for kind in VIBE_KINDS:
                lib = vb_library(kind)
                if not lib:
                    if kind == "movie":
                        die("vibe: Emby returned no movies; index left as it is")
                    continue
                idx, vec = (None, None) if full else vb_load(kind)
                t0 = time.time()
                idx, rows, c = vb_sync(lib, idx, vec, emb)
                vb_link_tpl(idx, lib, warns, kind)
                vb_save(idx, rows, kind)
                lines.append(f"vibe index: {c['items']} {VIBE_KINDS[kind]['noun']} ({c['new']} new, "
                             f"{c['embedded'] - c['new']} changed, {c['removed']} removed; {c['embedded']} embedded in "
                             f"{time.time() - t0:.1f} s) → {VIBE_DIR}")
    finally:
        lock.close()
    if not quiet:
        for x in lines:
            print(x)
        for w in dict.fromkeys(warns):
            print(f"!! {w}")


def vb_find(idx, words):
    """Leading words that name a library title (longest first; an optional year after it) -> (item index, rest)."""
    by = collections.defaultdict(list)
    for i, it in enumerate(idx["items"]):
        by[norm(it["title"])].append(i)
    for k in range(len(words), 0, -1):
        key = norm(" ".join(words[:k]))
        if not key or key not in by:
            continue
        rest = words[k:]
        hits = by[key]
        yr = re.fullmatch(r"\(?((?:19|20)\d\d)\)?", rest[0]) if rest else None
        if yr:
            same = [i for i in hits if str(idx["items"][i].get("year")) == yr[1]]
            if same:
                hits, rest = same, rest[1:]
        best = max(hits, key=lambda i: idx["items"][i].get("rating") or 0)
        return best, rest
    return None, words


def vb_fuzzy(idx, phrase):
    import difflib
    keys = {}
    for i, it in enumerate(idx["items"]):
        keys.setdefault(norm(it["title"]), i)
    m = difflib.get_close_matches(norm(phrase), list(keys), n=1, cutoff=0.86)
    return keys[m[0]] if m else None


def vb_parse(idx, text):
    """Query text -> {words, ref (item index or None), mins, short, note}."""
    words, mins, short = vb_tokens(text)
    s = " ".join(words)
    ref, note, rest_words = None, None, words
    m = VIBE_LIKE.search(s)
    if m:
        before = s[:m.start()].split()
        after = m[1].split()
        ref, rest = vb_find(idx, after)
        if ref is None:
            cut = next((j for j, w in enumerate(after) if w.lower() in ("but", "aber", "and", "und", "with", "mit")), len(after))
            ref = vb_fuzzy(idx, " ".join(after[:cut]))
            rest = after[cut:] if ref is not None else after
            if ref is None and 0 < cut <= 5 and after[0].lower() not in VIBE_STOP | {"a", "an", "i", "me", "you"}:
                note = f"“{' '.join(after[:cut])}” isn't in the library: matched on the words"
        rest_words = before + [w for w in rest if w.lower() not in ("but", "aber")]
    else:
        r, rest = vb_find(idx, words)
        if r is not None and not rest:
            ref, rest_words = r, []
    parts = [x for w in rest_words for x in [w] + (w.split("-") if "-" in w else [])]
    _, genres, avoid, _, _ = tn_mood(parts)
    return {"words": rest_words, "ref": ref, "mins": mins, "short": short, "note": note, "genres": genres, "avoid": avoid}


def sr_user_series(uid):
    """His Emby series with his user data (GET, his user only) -> [{id, title, year, rating, total, unplayed, played}];
    total/unplayed count every episode file (specials included)."""
    d = get("emby", f"{EMBY}/Users/{q(uid)}/Items?Recursive=true&IncludeItemTypes=Series"
                    "&Fields=RecursiveItemCount,CommunityRating,ProductionYear&EnableImages=false") or {}
    out = []
    for x in d.get("Items") or [] if isinstance(d, dict) else []:
        if not isinstance(x, dict) or not x.get("Id") or x.get("Type", "Series") != "Series":
            continue
        ud = x.get("UserData") if isinstance(x.get("UserData"), dict) else {}
        r = x.get("CommunityRating")
        out.append({"id": str(x["Id"]), "title": str(x.get("Name") or "?").strip(), "year": ct_num(x.get("ProductionYear")),
                    "rating": round(float(r), 1) if isinstance(r, (int, float)) and 0 < r <= 10 else None,
                    "total": ct_num(x.get("RecursiveItemCount")) or 0, "unplayed": ct_num(ud.get("UnplayedItemCount")),
                    "played": bool(ud.get("Played"))})
    return out


def vb_series_state(s):
    """One sr_user_series row -> (state, watched, total): played (all), partly, barely (<= 2 or VIBE_BARELY), None."""
    tot, un = s["total"], s["unplayed"]
    if not tot or un is None:
        return ("played", tot, tot) if s["played"] else (None, 0, tot)
    w = max(0, tot - un)
    if s["played"] or un == 0:
        return "played", tot, tot
    if w == 0:
        return None, 0, tot
    return ("barely" if w <= 2 or w / tot <= VIBE_BARELY else "partly"), w, tot


def vb_seen(warns, kind="movie"):
    """His played / partly watched ids (GET, his Emby user only) -> ({id: state}, {id: (watched, total)}) or
    (None, {}). Movies: played | partly; series: played | partly | barely (see vb_series_state)."""
    try:
        uid = ct_guid(lambda: seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER"))
        if kind == "series":
            states, prog = {}, {}
            for s in sr_user_series(uid):
                st, w, tot = vb_series_state(s)
                prog[s["id"]] = (w, tot)
                if st:
                    states[s["id"]] = st
            return states, prog
        out = []
        for f in ("IsPlayed", "IsResumable"):
            d = get("emby", f"{EMBY}/Users/{q(uid)}/Items?Recursive=true&IncludeItemTypes=Movie&Filters={f}"
                            "&EnableImages=false&EnableUserData=false") or {}
            out.append({str(x["Id"]) for x in d.get("Items") or [] if x.get("Id")})
        return dict({i: "partly" for i in out[1]}, **{i: "played" for i in out[0]}), {}
    except ApiError as e:
        warns.append(f"couldn't check what you've seen: {e}")
        return None, {}


def vb_dot(a, b):
    return sum(map(operator.mul, a, b))


def vb_rank(idx, vec, qv, p, seen_map, n):
    """Similarity + rating tilt - seen penalty; runtime cap; ★6.5+ first; greedy diversity."""
    dim, items = idx["dim"], idx["items"]
    refg = set(items[p["ref"]].get("genres") or []) if p["ref"] is not None else set()
    good, low = [], []
    for i, it in enumerate(items):
        if i == p["ref"]:
            continue
        if p["mins"] and it.get("min") and it["min"] > p["mins"]:
            continue
        row = vec[i * dim:(i + 1) * dim]
        s = vb_dot(qv, row)
        r = it.get("rating")
        s += VIBE_TILT * max(-1.0, min(1.0, ((r if r else 6.5) - 7.0) / 2.0))
        g = set(it.get("genres") or [])
        if refg:
            s += VIBE_GENRE_W * len(g & refg) / len(g | refg)
        if g & p.get("genres", set()):
            s += VIBE_MOOD_W
        if g & p.get("avoid", set()):
            s -= VIBE_AVOID_W
        seen = (seen_map or {}).get(it["id"])
        s -= {"played": VIBE_SEEN, "partly": VIBE_SEEN / 2}.get(seen, 0)
        (low if r is not None and r < VIBE_MIN_RATING else good).append((s, i, seen))
    good.sort(reverse=True)
    low.sort(reverse=True)
    pool = good[:VIBE_POOL] + (low[:VIBE_POOL] if len(good) < n else [])
    picks, rows = [], {}
    while pool and len(picks) < n:
        best = None
        for k, (s, i, seen) in enumerate(pool):
            row = rows.setdefault(i, vec[i * dim:(i + 1) * dim])
            near = max((vb_dot(row, rows[j]) for _, j, _ in picks), default=0.0)
            adj = s - VIBE_SAME * max(0.0, near - VIBE_SAME_FROM)
            if best is None or adj > best[0]:
                best = (adj, k)
        picks.append(pool.pop(best[1]))
    return picks


def vb_genres(gs, n=3):
    return [VIBE_GENRE_SHORT.get(g, g) for g in gs[:n]]


def vb_snip(it, n=90):
    s = it.get("tagline") or ""
    if not s and it.get("overview"):
        s = re.split(r"(?<=[.!?])\s", it["overview"], maxsplit=1)[0]
    s = s.strip()
    return s if len(s) <= n else s[:n - 1].rstrip(" ,;:") + "…"


def vb_why(it, ref, words, seen, prog=None):
    """One line: shared genres with the reference film, or the query words found in the title's text; + a snippet."""
    gs = it.get("genres") or []
    if ref:
        shared = [g for g in gs if g in (ref.get("genres") or [])]
        head = (" + ".join(vb_genres(shared, 2)) + f" like {ref['title']}") if shared else f"close to {ref['title']}"
    else:
        hay = " ".join([it.get("title") or "", it.get("tagline") or "", it.get("overview") or "", " ".join(gs)]).lower()
        hits = [w for w in dict.fromkeys(re.sub(r"[^\w-]", "", x.lower()) for x in words)
                if len(w) >= 4 and w not in VIBE_STOP and w in hay]
        head = ", ".join(vb_genres(gs)) or "—"
        if hits:
            head += " · " + ", ".join(hits[:3])
    snip = vb_snip(it)
    line = head + (f" · “{snip}”" if snip else "")
    if seen and prog and prog[1]:
        line += " · 👁 " + ("seen" if seen == "played" else f"{prog[0]} of {prog[1]} eps watched")
    elif seen:
        line += " · 👁 " + ("seen" if seen == "played" else "started")
    return line


def vb_label(p, idx):
    ref = idx["items"][p["ref"]] if p["ref"] is not None else None
    bits = []
    if ref:
        bits.append(f"like {ref['title']}" + (f" ({ref['year']})" if ref.get("year") else ""))
    if p["words"]:
        bits.append(" ".join(p["words"]))
    if p["mins"]:
        bits.append(f"≤ {p['mins']} min")
    return " · ".join(bits)


def vb_message(picks, label, notes, md=True, links=False, kind="movie"):
    head = "🎬 Vibe" if kind == "movie" else "📺 Vibe · series"
    lines = [(head.replace("Vibe", "**Vibe**") if md else head) + (f" · {label}" if label else "")]
    for k, p in enumerate(picks):
        t = (f"**{tn_md(p['title'])}**" if md else p["title"]) + (f" ({p['year']})" if p.get("year") else "")
        bits = [t] + ([f"{p['runtime_min']} min"] if p.get("runtime_min") else []) + \
               ([f"{p['episodes']} eps"] if p.get("episodes") else []) + \
               ([f"★{p['rating']:.1f}"] if p.get("rating") else [])
        lines += ["", f"{GR_NUM[k]} " + " · ".join(bits), tn_md(p["why"]) if md else p["why"]]
        if links and p.get("link"):
            lines.append(f"▶ {p['link']}")
    if not picks:
        lines += ["", "Nothing in the library fits" + (" (try without the time limit)" if "min" in (label or "") else "") + "."]
    if notes:
        lines += ["", "⚠️ " + "; ".join(notes)[:300]]
    return "\n".join(lines)


def vb_kind(text, forced=False):
    """(kind, text without the series words): 'a dark crime series' / 'eine Serie' / 'a tv show' -> series. Words in
    the "like <title>" part never count; with forced the text stays as it is unless it has series words."""
    words = text.split()
    m = VIBE_LIKE.search(text)
    head_n = len(text[:m.start()].split()) if m else len(words)
    clean = [w.lower().strip(",.!?;:") for w in words]
    keep, hit = [], False
    for i, w in enumerate(words):
        if i < head_n and (clean[i] in VIBE_SERIES_WORDS or
                           (clean[i] == "tv" and i + 1 < head_n and clean[i + 1] in VIBE_SERIES_WORDS)):
            hit = True
            continue
        keep.append(w)
    if hit:
        return "series", " ".join(keep)
    return ("series" if forced else "movie"), text


def vb_names_title(idx, text):
    """Does text ("like X ...", or the whole text) name a title of this index? (no embedding needed)"""
    if not idx or not idx.get("items"):
        return False
    m = VIBE_LIKE.search(text)
    words = (m[1] if m else text).split()
    if not words:
        return False
    r, rest = vb_find(idx, words)
    if r is not None and (m or not rest):
        return True
    if not m:
        return False
    cut = next((j for j, w in enumerate(words) if w.lower() in ("but", "aber", "and", "und", "with", "mit")), len(words))
    return vb_fuzzy(idx, " ".join(words[:cut])) is not None


def vb_pick_kind(text, forced):
    """Series words or --series -> series, unless the whole text is a movie title ("the truman show"); a "like <title>"
    or bare title that names a series but no movie -> series; else movie."""
    kind, rest = vb_kind(text, forced)
    load = lambda k: botlib.load_json(os.path.join(VIBE_DIR, VIBE_KINDS[k]["index"]), None)
    if kind == "series" and not forced:
        midx = load("movie")
        if midx and not VIBE_LIKE.search(text) and vb_names_title(midx, text) and not vb_names_title(load("series"), text):
            return "movie", text
        return kind, rest
    m = VIBE_LIKE.search(text)
    if kind == "movie" and (m or (len(text.split()) <= 6 and tn_mood(text.split())[3])):   # mood words ("dark") stay moods
        sidx = load("series")
        if sidx and vb_names_title(sidx, text) and not vb_names_title(load("movie"), text):
            return "series", text
    return kind, rest


def cmd_vibe(a):
    if not 1 <= a.n <= VIBE_MAX:
        die(f"-n must be 1..{VIBE_MAX}")
    if not (CFG.get("emby") or {}).get("key"):
        die(f"vibe: no emby url/key in {SECRETS}")
    if a.refresh:
        vb_refresh(quiet=a.quiet, full=a.full)
        return
    text = " ".join(" ".join(a.text).split())[:300]
    if not text:
        if a.json:
            emit_json({"hint": VIBE_HINT, "picks": [], "message": VIBE_HINT, "text": VIBE_HINT, "buttons": []})
        else:
            print(VIBE_HINT)
        return
    kind, text = vb_pick_kind(text, a.series)
    warns, notes = [], []
    try:
        lib = vb_library(kind)
    except ApiError as e:
        lib = None
        warns.append(f"Emby library: {e}")
    idx, vec = vb_load(kind)
    if idx is None and not lib:
        die("vibe: no index yet and Emby is unreachable")
    with VibeEmbed() as emb:
        if lib:
            lock = vb_lock(idx is None)          # the first run builds the whole index (waits for a running build)
            if lock:
                try:
                    if idx is None:
                        idx, vec = vb_load(kind)     # built meanwhile by another run
                    idx2, rows, c = vb_sync(lib, idx, vec, emb, None if idx is None else VIBE_LIVE_NEW)
                    if c["embedded"] or c["removed"] or idx is None:
                        vb_link_tpl(idx2, lib, warns, kind)
                        vb_save(idx2, rows, kind)
                        idx, vec = vb_load(kind)
                    elif not idx2.get("link_tpl") and vb_link_tpl(idx2, lib, warns, kind):
                        vb_save(idx2, rows, kind)
                        idx, vec = vb_load(kind)
                finally:
                    lock.close()
        if idx is None:
            die("vibe: no index (run `media vibe --refresh`)")
        p = vb_parse(idx, text)
        if p["note"]:
            notes.append(p["note"])
        dim = idx["dim"]
        qv = None
        if p["words"] or p["ref"] is None:
            qv = emb.embed([vb_query_text(p["words"] or ["a great movie" if kind == "movie" else "a great"], kind)])[0]
        if p["ref"] is not None:
            rv = list(vec[p["ref"] * dim:(p["ref"] + 1) * dim])
            if qv:
                mix = [VIBE_REF_W * x + (1 - VIBE_REF_W) * y for x, y in zip(rv, qv)]
                n = math.sqrt(sum(x * x for x in mix)) or 1.0
                qv = [x / n for x in mix]
            else:
                qv = rv
    if len(qv) != dim:
        die("vibe: the index was built with another model (run `media vibe --refresh --full`)")
    seen_map, prog = vb_seen(warns, kind)
    if seen_map is None:
        notes.append("couldn't check what you've seen")
    ref = idx["items"][p["ref"]] if p["ref"] is not None else None
    tpl = idx.get("link_tpl")
    picks = []
    for s, i, seen in vb_rank(idx, vec, qv, p, seen_map, a.n):
        it = idx["items"][i]
        pg = prog.get(it["id"])
        picks.append({"emby_id": it["id"], "title": it["title"], "year": it.get("year"), "tmdb": it.get("tmdb"),
                      "rating": it.get("rating"), "runtime_min": it.get("min"), "genres": it.get("genres") or [],
                      "seen": seen, "score": round(s, 4), "why": vb_why(it, ref, p["words"], seen, pg),
                      "link": tn_link(tpl, it["id"])})
        if kind == "series":
            picks[-1].update(kind="series", episodes=pg[1] if pg else None, watched=pg[0] if pg else None)
    warns[:] = list(dict.fromkeys(warns))
    label = vb_label(p, idx)
    play_on = play_enabled() and kind == "movie"      # a series id is no play target
    out = {"generated": iso_z(now_utc()), "query": text, "label": label, "kind": kind,
           "ref": {"emby_id": ref["id"], "title": ref["title"], "year": ref.get("year")} if ref else None,
           "max_min": p["mins"], "picks": picks, "warnings": warns,
           "message": vb_message(picks, label, notes, kind=kind),
           "text": vb_message(picks, label, notes, md=False, links=True, kind=kind),
           "buttons": gr_buttons(picks, play_on), "play_on_tv": play_on,
           "index": {"items": len(idx["items"]), "built": idx.get("built")}}
    if a.json:
        emit_json(out)
    else:
        print(vb_message(picks, label, notes, md=False, kind=kind))
        for row in out["buttons"]:
            print("   " + " · ".join(f"{b['text']} = {b.get('data') or b.get('url')}" for b in row))
        for w in warns:
            print(f"!! {w}")


# ---------- finish: shows he started and paused (his Emby user only; GET-only) ----------
FIN_N, FIN_MAX = 5, 10
FIN_IDLE_DAYS = 14         # a show counts as paused after this many days without a play
FIN_WORKERS = 8
FIN_CLOSE_W = 0.6          # score = this x closeness to the end + the rest x the rating (5..9 -> 0..1)
FIN_EP_FIELDS = "ParentIndexNumber,IndexNumber,RunTimeTicks,SeriesName,SeriesId,LocationType,UserDataLastPlayedDate"
FIN_HEAD = "🏁 Finish next"
FIN_GAPS_LEN = 24          # skipped episodes as codes up to this length, else a count


def fin_eps(uid, sid, played):
    """His played (or unplayed) regular episodes of one series: no specials (season 0), no virtual (missing) ones."""
    d = get("emby", f"{EMBY}/Users/{q(uid)}/Items?ParentId={q(sid)}&Recursive=true&IncludeItemTypes=Episode"
                    f"&IsPlayed={'true' if played else 'false'}&Fields={FIN_EP_FIELDS}&EnableImages=false") or {}
    return [x for x in (d.get("Items") or [] if isinstance(d, dict) else [])
            if isinstance(x, dict) and x.get("Type", "Episode") == "Episode" and ct_num(x.get("ParentIndexNumber")) != 0
            and x.get("LocationType") != "Virtual" and ITEM_RE.fullmatch(str(x.get("Id") or ""))]


def fin_last(x):
    d = zdt(((x.get("UserData") or {}) if isinstance(x.get("UserData"), dict) else {}).get("LastPlayedDate"))
    return d if d and d.year >= 2000 else None


def fin_show(uid, s, now, idle_days):
    """One started series -> a finish item, or None (nothing played/left, or played within idle_days)."""
    played, left = fin_eps(uid, s["id"], True), fin_eps(uid, s["id"], False)
    if not played or not left:
        return None
    key = lambda x: (ct_num(x.get("ParentIndexNumber")) or 0, ct_num(x.get("IndexNumber")) or 0)
    dates = [d for d in map(fin_last, played + left) if d]
    last = max(dates) if dates else None
    if last and (now - last).total_seconds() < idle_days * 86400:
        return None
    # next = the first unplayed episode in season/episode order after the furthest one he got to (played, or
    # started = has a resume point); earlier unplayed ones are skipped gaps (or lost their played state in a
    # re-import), not the place to continue. Nothing after it -> only gaps left: the first gap, ranked last.
    resum = [x for x in left if ct_num(((x.get("UserData") or {}) if isinstance(x.get("UserData"), dict) else {})
                                       .get("PlaybackPositionTicks"))]
    order = sorted(left, key=key)
    far = max(played + resum, key=key)
    if any(x is far for x in resum):
        nxt = far
    else:
        nxt = next((x for x in order if key(x) > key(far)), None)
    gaps = [x for x in order if key(x) < key(far)]
    gaps_only = nxt is None
    nxt = nxt or order[0]
    it = ct_item(dict(nxt, SeriesName=nxt.get("SeriesName") or s["title"], SeriesId=nxt.get("SeriesId") or s["id"]),
                 "finish")
    if not it:
        return None
    total, n_left = len(played) + len(left), len(left)
    close = 0.5 * len(played) / total + 0.5 / (1 + n_left / 3)
    rn = max(0.0, min(1.0, ((s["rating"] if s["rating"] else 6.5) - 5) / 4))
    it.update(title=s["title"], series_id=s["id"], year=s["year"], rating=s["rating"], left=n_left, total=total,
              watched=len(played), last_played=iso_z(last) if last else None, last_from="series" if last else None,
              score=round(FIN_CLOSE_W * close + (1 - FIN_CLOSE_W) * rn, 4), gaps_only=gaps_only,
              gaps=fin_gaps(gaps, key) if gaps else None, gaps_n=len(gaps), furthest=fin_code(far, key))
    return it


def fin_code(x, key):
    s, e = key(x)
    return f"S{s:02d}E{e:02d}"


def fin_gaps(eps, key):
    """Skipped episodes, short: 'S02E01–E03', 'S01E03, S02E05–E06', or '7 episodes' when that gets long."""
    by = collections.defaultdict(list)
    for x in eps:
        s, e = key(x)
        by[str(s)].append(e)
    txt = eps_txt(by)
    return txt if len(txt) <= FIN_GAPS_LEN else plural(len(eps), "episode")


def fin_collect(uid, idle_days, warns):
    """(items best first, number of started series looked at); shows that fail to load -> warns."""
    import concurrent.futures
    now = now_utc()
    cand = [s for s in sr_user_series(uid) if s["total"] and s["unplayed"] is not None and 0 < s["unplayed"] < s["total"]
            and not s["played"]]
    items, failed = [], []
    with concurrent.futures.ThreadPoolExecutor(max_workers=FIN_WORKERS) as ex:
        futs = {ex.submit(fin_show, uid, s, now, idle_days): s for s in cand}
        for f in concurrent.futures.as_completed(futs):
            try:
                it = f.result()
            except ApiError as e:
                failed.append((futs[f]["title"], str(e)))
                continue
            if it:
                items.append(it)
    if failed:
        warns.append(f"{len(failed)} show(s) didn't load: " + ", ".join(t for t, _ in failed[:3])
                     + f" ({failed[0][1]})")
    items.sort(key=lambda it: (it["gaps_only"], -it["score"], it["left"], it["title"].lower()))
    return items, len(cand)


def fin_line(it, md=True):
    """'Hijack · 3 of 8 left · ★7.4'."""
    t = ct_cut(it["title"], CT_LINE)
    bits = [f"**{tn_md(t)}**" if md else t, f"{it['left']} of {it['total']} left"]
    if it.get("rating"):
        bits.append(f"★{it['rating']:.1f}")
    return "📺 " + " · ".join(bits)


def fin_next(it, now):
    """'next S01E06 at 20 min · last watched 3 Sep · skipped S01E03'; only gaps left ->
    'watched to S03E08 · skipped S02E01–E03 · last watched 22.08.'"""
    when = ct_when(it.get("last_played"), now)
    if it.get("gaps_only"):
        s = f"watched to {it['furthest']} · skipped {it['gaps']}"
        if it["state"] == "resume":
            s += f" ({it['episode']} at {it['pos_min']} min)"
        return s + (f" · last watched {when}" if when else "")
    s = f"next {it['episode']}" if it.get("episode") else "next episode"
    if it["state"] == "resume":
        s += f" at {it['pos_min']} min"
    s += f" · last watched {when}" if when else ""
    return s + (f" · skipped {it['gaps']}" if it.get("gaps") else "")


def fin_message(items, now, idle_days, notes, md=True, links=False, tpl=None, play_on=False):
    lines = [f"**{FIN_HEAD}**" if md else FIN_HEAD, f"Started, paused {idle_days}+ days, episodes left", ""]
    for it in items:
        lines += [fin_line(it, md), "   " + fin_next(it, now)]
        if links and tn_link(tpl, it["id"]):
            lines.append("   ▶ " + tn_link(tpl, it["id"]))
    if not items:
        lines.append("Nothing to finish: no paused shows with episodes left.")
    elif md and not play_on:
        lines += ["", "Play on TV is switched off, so no buttons."]
    if notes:
        lines += ["", "⚠️ " + "; ".join(notes)[:300]]
    return "\n".join(lines).rstrip()


def cmd_finish(a):
    if not 1 <= a.n <= FIN_MAX:
        die(f"-n must be 1..{FIN_MAX}")
    if a.days < 0:
        die("--days must be 0 or more")
    if not (CFG.get("emby") or {}).get("key"):
        die(f"finish: no emby url/key in {SECRETS}")
    warns, now = [], now_utc()
    uid = ct_guid(lambda: seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER"))
    items, n_started = fin_collect(uid, a.days, warns)
    total = len(items)
    items = items[:a.n]
    play_on, tpl = play_enabled(), vb_stored_tpl()
    notes = ["some shows didn't load"] if warns else []
    out = {"generated": iso_z(now), "items": items, "total": total, "started": n_started, "idle_days": a.days,
           "play_enabled": play_on, "warnings": warns,
           "message": fin_message(items, now, a.days, notes, play_on=play_on),
           "text": fin_message(items, now, a.days, notes, md=False, links=True, tpl=tpl),
           "buttons": ct_buttons(items, play_on)}
    if a.json:
        emit_json(out)
    else:
        print(fin_message(items, now, a.days, [], md=False, links=True, tpl=tpl))
        for it in items if play_on else []:
            print(f"   button: mt:play:{it['id']} = media play {it['id']}")
        for w in warns:
            print(f"!! {w}")
    if warns:
        sys.exit(3)


# ---------- franchise: missing parts of film series he owns ----------

FR_STATE = os.path.expanduser(os.environ.get("MEDIA_FRANCHISE_STATE") or "~/.local/state/franchise")
FR_POLL_MAX = 10           # options per poll
FR_PER_COLL = 3            # poll: at most this many titles of one series
FR_POLL_LEN = 100          # Telegram's limit per poll option
FR_POLL_Q = "Complete these film series? Pick any (each pick = a Seerr request):"
FR_BAYES_M, FR_BAYES_C = 500, 6.0   # rating shrunk toward 6.0 with the weight of 500 votes
FR_SKIP = {"requested": "requested in Seerr", "wanted": "in Radarr (wanted or downloading)",
           "unmonitored": "unmonitored in Radarr", "excluded": "on Radarr's exclusion list",
           "blocklisted": "on Seerr's blocklist", "unreleased": "not released yet"}


def fr_load(name, default):
    try:
        with open(os.path.join(FR_STATE, name)) as f:
            d = json.load(f)
        return d if isinstance(d, type(default)) else default
    except (OSError, ValueError):
        return default


def fr_save(name, obj):
    os.makedirs(FR_STATE, mode=0o700, exist_ok=True)
    path = os.path.join(FR_STATE, name)
    tmp = f"{path}.tmp{os.getpid()}"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def fr_short(name):
    """'The Matrix Collection' -> 'The Matrix'."""
    s = re.sub(r"\s*[-–:]?\s*collection$", "", str(name or "?"), flags=re.I).strip()
    return s or str(name or "?")


def fr_rating(avg, votes):
    v = max(0, int(votes or 0))
    return (v * float(avg or 0) + FR_BAYES_M * FR_BAYES_C) / (v + FR_BAYES_M)


def fr_tmdb_rating(p):
    r = ((p.get("ratings") or {}).get("tmdb") or {})
    return r.get("value") or 0, r.get("votes") or 0


def fr_collections():
    """Radarr's collections + {tmdbId: Radarr movie}; an ApiError ends the command (nothing to work with)."""
    cols = get("radarr", "/api/v3/collection") or []
    movies = {m.get("tmdbId"): m for m in get("radarr", "/api/v3/movie") or [] if m.get("tmdbId")}
    return cols, movies


def fr_gaps(min_owned, warns):
    """Series where he owns >= min_owned parts and a released part is missing.
    -> (gaps sorted best first, skip counts, ignored series count)."""
    cols, movies = fr_collections()
    ign = fr_load("ignore.json", {}).get("collections") or {}
    today = now_utc().astimezone(ZRH).date().isoformat()
    skipped = collections.Counter()
    n_ignored, seerr_ok, out = 0, True, []
    for c in cols:
        parts = [p for p in c.get("movies") or [] if p.get("tmdbId")]
        owned = {p["tmdbId"] for p in parts if (movies.get(p["tmdbId"]) or {}).get("hasFile")}
        if len(owned) < min_owned or len(owned) == len(parts):
            continue
        cid = c.get("tmdbId")
        if str(cid) in ign:
            n_ignored += 1
            continue
        why, cand = {}, []
        for p in parts:
            t = p["tmdbId"]
            rm = movies.get(t)
            if t in owned:
                continue
            if rm:
                why[t] = "wanted" if rm.get("monitored") else "unmonitored"
            elif p.get("isExcluded"):
                why[t] = "excluded"
            elif p.get("status") != "released":
                why[t] = "unreleased"
            else:
                cand.append(p)
        sp = {}
        if cand and seerr_ok:            # Seerr: requests, Emby-only copies, release dates, votes, extra parts
            d = soft(lambda: get("seerr", f"/api/v1/collection/{int(cid)}?language=en"), warns, "Seerr")
            if d is None:
                seerr_ok = False         # one failure: Radarr-only from here on (no N timeouts)
            else:
                sp = {x.get("id"): x for x in d.get("parts") or [] if x.get("id")}
        known = {p["tmdbId"] for p in parts}
        for t, x in sp.items():          # Seerr knows a part Radarr's collection cache doesn't
            if t not in known and t not in owned and (x.get("mediaType") or "movie") == "movie":
                cand.append({"tmdbId": t, "title": x.get("title"), "year": int(year(x)) if year(x).isdigit() else None,
                             "status": "released" if (x.get("releaseDate") or "9999") <= today else "announced"})
                if cand[-1]["status"] != "released":
                    why[t] = "unreleased"
                    cand.pop()
        for t, x in sp.items():          # Emby has it (Seerr's library sync): owned, even without Radarr
            if ((x.get("mediaInfo") or {}).get("status")) in (4, 5):
                owned.add(t)
        gaps = []
        for p in cand:
            t = p["tmdbId"]
            x = sp.get(t) or {}
            st = (x.get("mediaInfo") or {}).get("status")
            if t in owned:
                continue
            if st in (2, 3):
                why[t] = "requested"
            elif st == 6:
                why[t] = "blocklisted"
            elif x and not (x.get("releaseDate") and x["releaseDate"] <= today):
                why[t] = "unreleased"
            else:
                gaps.append((p, x))
        if len(owned) < min_owned:
            continue
        skipped.update(why.values())
        if not gaps:
            continue
        votes_all = sum((x.get("voteCount") if x else fr_tmdb_rating(p)[1]) or 0
                        for p in parts for x in [sp.get(p["tmdbId"])])
        total = len(owned) + len(gaps)
        name = fr_short(c.get("title"))
        for p, x in gaps:
            avg, votes = (x.get("voteAverage"), x.get("voteCount")) if x else fr_tmdb_rating(p)
            yr = (x.get("releaseDate") or "")[:4] if x else str(p.get("year") or "")
            score = fr_rating(avg, votes) + 0.35 * math.log10(1 + votes_all) + len(owned) / total
            out.append({"collection": name, "collection_id": cid, "owned": len(owned), "missing": len(gaps),
                "title": p.get("title") or x.get("title") or "?", "year": int(yr) if yr.isdigit() else None,
                "tmdb": p["tmdbId"], "rating": round(float(avg or 0), 1), "votes": int(votes or 0),
                "score": round(score, 3)})
    out.sort(key=lambda g: (-g["score"], g["collection"], g["year"] or 0))
    return out, dict(skipped), n_ignored


def fr_base(s):
    """Comparable name: no parentheses, no leading article, casefolded."""
    s = re.sub(r"\s*\([^)]*\)", "", str(s or "")).strip().casefold()
    return re.sub(r"^(the|a|an)\s+", "", s)


def fr_option(g):
    """'Series: Title (year)'; just 'Title (year)' when the title already starts with the series name."""
    t = g["title"] if fr_base(g["title"]).startswith(fr_base(g["collection"])) else f"{g['collection']}: {g['title']}"
    o = t + (f" ({g['year']})" if g.get("year") else "")
    return o if len(o) <= FR_POLL_LEN else o[:FR_POLL_LEN - 1] + "…"


def fr_poll_picks(gaps):
    """Best titles, at most FR_PER_COLL per series and FR_POLL_MAX in all; series kept together, oldest first."""
    per, picks = collections.Counter(), []
    for g in gaps:
        if len(picks) >= FR_POLL_MAX:
            break
        if per[g["collection_id"]] < FR_PER_COLL:
            per[g["collection_id"]] += 1
            picks.append(g)
    rank = {}
    for i, g in enumerate(picks):
        rank.setdefault(g["collection_id"], i)
    return sorted(picks, key=lambda g: (rank[g["collection_id"]], g["year"] or 0, g["title"]))


def fr_skip_txt(skipped, n_ignored):
    bits = [f"{n} {FR_SKIP.get(k, k)}" for k, n in sorted(skipped.items(), key=lambda kv: (-kv[1], kv[0]))]
    if n_ignored:
        bits.append(f"{n_ignored} ignored series")
    return "Skipped: " + "; ".join(bits) if bits else ""


def fr_by_series(gaps):
    groups = collections.OrderedDict()
    for g in gaps:
        groups.setdefault(g["collection_id"], []).append(g)
    return list(groups.values())


def fr_list(a):
    warns = []
    gaps, skipped, n_ign = fr_gaps(a.min_owned, warns)
    series = fr_by_series(gaps)
    if a.poll_json:
        picks = fr_poll_picks(gaps)
        opts = [fr_option(g) for g in picks]
        poll = ({"question": FR_POLL_Q, "options": opts, "anonymous": False, "multiple": True}
                if len(opts) >= 2 else None)
        if opts:
            fr_save("last-poll.json", {"at": iso_z(now_utc()), "options": opts, "ids": [g["tmdb"] for g in picks]})
        if not picks:
            msg = "No film series with a missing part right now."
        elif poll:
            msg = (f"🎬 {len(series)} film series you own {'has a gap' if len(series) == 1 else 'have gaps'}; "
                   f"the best {len(picks)} missing parts are in the poll.")
        else:
            msg = f"🎬 One gap: {opts[0]} (★{picks[0]['rating']}). Request it?"
        emit_json({"message": msg, "poll": poll,
                   "ids": [g["tmdb"] for g in picks], "picks": picks,
                   "request": "media franchise request --picked 'OPTION | OPTION'",
                   "warnings": warns})
        finish(warns, True)
        return
    if a.json:
        emit_json({"min_owned": a.min_owned, "series": len(series), "titles": len(gaps), "gaps": gaps,
                   "skipped": skipped, "ignored_series": n_ign, "warnings": warns})
        finish(warns, True)
        return
    if not gaps:
        print(f"No film series with a missing released part (owned ≥ {a.min_owned}).")
    else:
        print(f"Film series with missing parts (owned ≥ {a.min_owned}): {len(series)} series, "
              f"{plural(len(gaps), 'title')}")
        for grp in series[:a.n]:
            g0 = grp[0]
            print(f"{g0['collection']} ({g0['owned']} owned, {len(grp)} missing):")
            for g in grp:
                yr = f" ({g['year']})" if g.get("year") else ""
                print(f"  {g['title']}{yr} ★{g['rating']} ({g['votes']} votes)  tmdb:{g['tmdb']}")
        more(series, a.n, indent="")
    s = fr_skip_txt(skipped, n_ign)
    if s:
        print(s)
    finish(warns)


def fr_find_collection(cols, key):
    """A collection by TMDB id or (part of) its name; die on none or several."""
    if str(key).isdigit():
        hit = [c for c in cols if str(c.get("tmdbId")) == str(key)]
    else:
        k = key.casefold().strip()
        hit = [c for c in cols if fr_short(c.get("title")).casefold() == k] or \
              [c for c in cols if k in str(c.get("title") or "").casefold()]
    if not hit:
        die(f"no collection matches {key!r} (use its TMDB id or name; see media franchise --json)")
    if len(hit) > 1:
        die(f"{key!r} matches {len(hit)} collections: " + "; ".join(
            f"{c.get('title')} ({c.get('tmdbId')})" for c in hit[:6]))
    return hit[0]


def fr_ignore(a, on):
    st = fr_load("ignore.json", {})
    ign = st.get("collections") or {}
    if not a.items:
        die(f"usage: media franchise {'ignore' if on else 'unignore'} COLLECTION_ID|NAME ...")
    if on:
        cols = fr_collections()[0]
    for key in a.items:
        if on:
            c = fr_find_collection(cols, key)
            ign[str(c.get("tmdbId"))] = {"title": c.get("title"), "at": now_utc().astimezone(ZRH).date().isoformat()}
            print(f"Ignoring {c.get('title')} ({c.get('tmdbId')}): no more franchise gaps from it.")
        else:
            k = key.casefold().strip()
            hit = [i for i, v in ign.items() if i == key or k in str(v.get("title") or "").casefold()]
            if len(hit) != 1:
                die(f"{key!r} matches {len(hit)} ignored collections" + (": " + ", ".join(
                    ign[i].get("title") or i for i in hit) if hit else ""))
            print(f"No longer ignoring {ign.pop(hit[0]).get('title')} ({hit[0]}).")
    st["collections"] = ign
    fr_save("ignore.json", st)


def fr_ignored(a):
    ign = fr_load("ignore.json", {}).get("collections") or {}
    if a.json:
        emit_json([{"collection_id": int(i) if i.isdigit() else i, **v} for i, v in ign.items()])
        return
    if not ign:
        print("No ignored collections.")
    for i, v in sorted(ign.items(), key=lambda kv: str(kv[1].get("title"))):
        print(f"{v.get('title')} ({i}), since {v.get('at') or '?'}")


def fr_picked_ids(texts):
    last = fr_load("last-poll.json", {})
    m = dict(zip(last.get("options") or [], last.get("ids") or []))
    ids, bad = [], []
    for t in texts:
        for o in (s.strip() for s in t.split(" | ")):
            if o:
                (ids.append(m[o]) if o in m else bad.append(o))
    if bad:
        die("not in the last franchise poll: " + "; ".join(repr(b) for b in bad)
            + (" (no poll saved yet)" if not m else ""))
    return ids


def fr_request(a):
    ids = []
    for x in a.items:
        if not str(x).isdigit():
            die(f"not a TMDB movie id: {x!r}")
        ids.append(int(x))
    if a.picked:
        ids += fr_picked_ids(a.picked)
    ids = list(dict.fromkeys(ids))
    if not ids:
        die("usage: media franchise request TMDB_ID ... | --picked 'OPTION | OPTION' [--dry-run]")
    ok = 0
    for t in ids:             # the approved request path: the same checks and POST as `media request --type movie`
        try:
            cmd_request(argparse.Namespace(tmdb_id=t, type="movie", seasons=None, dry_run=a.dry_run))
            ok += 1
        except ApiError as e:
            print(f"media: tmdb:{t}: {e}", file=sys.stderr)
        except SystemExit:
            pass              # die() already said why (e.g. blocklisted)
    if ok < len(ids):
        sys.exit(1 if ok == 0 else 3)


def cmd_franchise(a):
    if a.min_owned < 1:
        die("--min-owned must be at least 1")
    act = a.action or "list"
    if act != "list" and (a.json or a.poll_json) and act != "ignored":
        die(f"--json/--poll-json are for the gap list, not {act}")
    if act in ("list", "ignored") and a.items:
        die(f"unexpected arguments: {' '.join(a.items)}")
    if act != "request" and (a.picked or a.dry_run):
        die("--picked/--dry-run go with: media franchise request")
    {"list": fr_list, "request": fr_request, "ignore": lambda a: fr_ignore(a, True),
     "unignore": lambda a: fr_ignore(a, False), "ignored": fr_ignored}[act](a)


# --- wrapped: his year in review (Emby Playback Reporting, his user only) -----------------------------------------
# Tracearr's history starts late in the year, so a whole year comes from Emby's Playback Reporting DB (read-only SQL,
# rows filtered to his Emby user id in the query) + library.db metadata; covers from Emby's image API (GET).
WR_DAY_START_H = 5             # a viewing day runs 05:00-04:59: a night's binge counts for the evening it started
WR_FULL = 0.6                  # a day counts as a (re)watch of an item from this share of its runtime
WR_4K_W, WR_4K_H = 3200, 2000  # 4K: >= this wide (scope crops) or this tall
WR_COVER_H = 240               # cover height asked from Emby (px)
WR_COVER_MAX = 150 * 1024      # one cover at most (bytes)
WR_COVER_BUDGET = int(2.2 * 1024 * 1024)   # all covers together: the page stays < ~3 MB
WR_IDS_CHUNK = 300             # ids per library query
WR_WALL = 18                   # posters on the film wall
WD_LONG = ["Mondays", "Tuesdays", "Wednesdays", "Thursdays", "Fridays", "Saturdays", "Sundays"]
Q_WR_TABS = "SELECT name FROM sqlite_master WHERE type='table' AND name LIKE 'PlaybackActivity%'"
Q_WR_ITEMS = ("SELECT 'I', m.Id, m.type, " + tn_clean("m.Name") + ", coalesce(m.ProductionYear,''),"
              " coalesce(m.RunTimeTicks,''), coalesce(m.Width,''), coalesce(m.Height,''), coalesce(m.SeriesId,''),"
              " coalesce(m.ParentIndexNumber,''), coalesce(m.IndexNumber,''), "
              + tn_clean("coalesce((SELECT group_concat(g.Name,'|') FROM {L}ItemLinks2 il JOIN {L}MediaItems g"
                         " ON g.Id = il.LinkedId WHERE il.ItemId = m.Id AND il.Type = 2), m.Genres)") +
              " FROM {L}MediaItems m WHERE m.Id IN ({IDS})"
              " OR m.Id IN (SELECT s.SeriesId FROM {L}MediaItems s WHERE s.Id IN ({IDS}))")

WR_COLS = ("SELECT 'I', m.Id, m.type, " + tn_clean("m.Name") + ", coalesce(m.ProductionYear,''),"
           " coalesce(m.RunTimeTicks,''), coalesce(m.Width,''), coalesce(m.Height,''), coalesce(m.SeriesId,''),"
           " coalesce(m.ParentIndexNumber,''), coalesce(m.IndexNumber,''), ")
Q_WR_TOP = WR_COLS + tn_clean("coalesce((SELECT group_concat(g.Name,'|') FROM {L}ItemLinks2 il JOIN {L}MediaItems g"
                              " ON g.Id = il.LinkedId WHERE il.ItemId = m.Id AND il.Type = 2), m.Genres)") + \
    " FROM {L}MediaItems m WHERE m.type IN (5,6) AND m.ExtraType IS NULL"
Q_WR_EPS = WR_COLS + "'' FROM {L}MediaItems m WHERE m.type = 8 AND m.SeriesId IN ({IDS})"

def wr_guid():
    """His Emby user id (32 hex): MEDIA_WRAPPED_GUID, else his Seerr user's linked Emby account."""
    raw = os.environ.get("MEDIA_WRAPPED_GUID")
    if not raw:
        try:
            raw = seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER").get("jellyfinUserId")
        except ApiError as e:
            raise ApiError(f"can't tell which Emby user is yours: {e}")
    g = re.sub(r"[^0-9a-f]", "", str(raw or "").lower())
    if len(g) != 32:
        raise ApiError(f"Seerr user {TONIGHT_USER!r} has no linked Emby account")
    return g


def wr_rows(guid, yr):
    """His Movie/Episode rows of Playback Reporting around the year (local wall time), deduped over backup tables."""
    tabs = [r[0] for r in tn_sql(Q_WR_TABS, "playback") if r and re.fullmatch(r"PlaybackActivity\w*", r[0])]
    if not tabs:
        raise ApiError("no PlaybackActivity table (Playback Reporting plugin missing?)")
    union = " UNION ALL ".join(f"SELECT DateCreated, UserId, ItemId, ItemType, ItemName, PlayDuration, ClientName FROM {t}"
                               for t in tabs)
    sql = (f"SELECT DateCreated, ItemId, max(ItemType), {tn_clean('max(ItemName)')}, max(coalesce(PlayDuration,0)),"
           f" {tn_clean('max(ClientName)')} FROM ({union}) WHERE lower(replace(UserId,'-','')) = '{guid}'"
           f" AND ItemType IN ('Movie','Episode') AND DateCreated >= '{yr:04d}-01-01' AND DateCreated < '{yr + 1:04d}-01-02'"
           " GROUP BY DateCreated, ItemId ORDER BY DateCreated")
    out = []
    for r in tn_sql(sql, "playback"):
        if len(r) < 6 or not r[1].isdigit():
            continue
        try:
            ts = datetime.strptime(r[0][:19].replace("T", " "), "%Y-%m-%d %H:%M:%S")
            secs = int(float(r[4] or 0))
        except ValueError:
            continue
        out.append({"ts": ts, "id": r[1], "type": r[2], "name": r[3].strip(), "secs": max(0, secs),
                    "client": r[5].strip() or "?"})
    return out


def wr_parse(r):
    """One Q_WR_* row -> (id, item dict) or None."""
    if r[0] != "I" or len(r) < 12 or not r[1].isdigit():
        return None
    ticks = tn_num(r[5], int)
    return r[1], {"kind": {"5": "movie", "6": "series", "8": "episode"}.get(r[2], r[2]), "name": r[3].strip(),
                  "year": tn_num(r[4], int), "secs": round(ticks / 10 ** 7) if ticks else None, "cid": r[1],
                  "w": tn_num(r[6], int) or 0, "h": tn_num(r[7], int) or 0, "series": r[8] or None,
                  "season": tn_num(r[9], int), "ep": tn_num(r[10], int), "genres": sorted(tn_genres(r[11]))}


def wr_query(sql, ids):
    out = {}
    ids = sorted(set(ids), key=int)
    for i in range(0, len(ids), WR_IDS_CHUNK):
        for r in tn_sql(sql.replace("{IDS}", ",".join(ids[i:i + WR_IDS_CHUNK])), "library"):
            x = wr_parse(r)
            if x:
                out[x[0]] = x[1]
    return out


def wr_items(rows):
    """library.db metadata for his played ids: {played id: item}. Upgrades and re-imports give items new ids, so a
    played id that is gone is matched by name: a film by its title, an episode by 'Show - s01e02 - ...' to the show
    and its current episode."""
    ids = {r["id"] for r in rows}
    items = wr_query(Q_WR_ITEMS, ids)
    gone = {r["id"]: r for r in rows if r["id"] not in items}
    if not gone:
        return items
    top = {}
    for r in tn_sql(Q_WR_TOP, "library"):
        x = wr_parse(r)
        if x:
            top[x[0]] = x[1]
    films, shows = {}, {}
    for i, it in sorted(top.items(), key=lambda kv: -(kv[1]["w"] or 0)):     # the widest copy of a film wins
        (films if it["kind"] == "movie" else shows).setdefault(norm(it["name"]), (i, it))
    want_eps = {}
    for pid, r in gone.items():
        if r["type"] == "Movie":
            hit = films.get(norm(r["name"])) or films.get(norm(YEAR_SUFFIX.sub("", r["name"])))
            if hit:
                items[pid] = hit[1]
            continue
        m = re.match(r"(?i)^(.*?)\s+-\s+s(\d+)e(\d+)\b", r["name"])
        hit = shows.get(norm(m.group(1) if m else r["name"].split(" - ")[0]))
        if not hit:
            continue
        items.setdefault(hit[0], hit[1])
        ep = {"kind": "episode", "name": r["name"], "year": None, "secs": None, "cid": None, "w": 0, "h": 0,
              "series": hit[0], "season": int(m.group(2)) if m else None, "ep": int(m.group(3)) if m else None,
              "genres": []}
        items[pid] = ep
        want_eps.setdefault(hit[0], []).append(ep)
    if want_eps:
        cur = {}
        for it in wr_query(Q_WR_EPS, want_eps).values():
            cur.setdefault((it["series"], it["season"], it["ep"]), it)
        for sid, eps in want_eps.items():
            for ep in eps:
                hit = cur.get((sid, ep["season"], ep["ep"]))
                if hit:
                    ep.update({k: hit[k] for k in ("secs", "w", "h", "cid")})
    return items


def wr_hm(secs):
    h, m = divmod(int(round(secs / 60)), 60)
    return f"{h} h {m:02d} min" if h else f"{m} min"


def wr_stats(rows, items, yr, today):
    """The year's numbers from his rows: plays = one item per viewing day (>= 2 min, capped at 1.25x its runtime)."""
    agg = {}
    for r in rows:
        day = (r["ts"] - timedelta(hours=WR_DAY_START_H)).date()
        if day.year != yr:
            continue
        a = agg.setdefault((r["id"], day), {"id": r["id"], "type": r["type"], "pname": r["name"], "day": day,
                                            "first": r["ts"], "raw": 0, "parts": []})
        a["raw"] += r["secs"]
        a["first"] = min(a["first"], r["ts"])
        a["parts"].append((r["ts"], r["secs"], r["client"]))
    plays = []
    for a in agg.values():
        it = items.get(a["id"]) or {}
        movie = a["type"] == "Movie"
        rt = it.get("secs")
        secs = min(a["raw"], rt * 1.25 if rt else (4 if movie else 2) * 3600)
        if secs < MIN_PLAY_S:
            continue
        ser = items.get(it.get("series") or "") or {}
        if movie:
            title, key = it.get("name") or a["pname"], ("m", a["id"])
            uk = ("m", it.get("cid") or a["id"])
        else:
            show = ser.get("name") or a["pname"].split(" - ")[0].strip() or "?"
            key = ("s", it.get("series") or show.lower())
            se = f" S{it['season']:02d}E{it['ep']:02d}" if it.get("season") is not None and it.get("ep") is not None else ""
            title = show
            a["label"] = show + se
            uk = ("e", key[1], it.get("season"), it.get("ep")) if se else ("e", a["id"])
        a.update(secs=secs, scale=secs / a["raw"] if a["raw"] else 0, movie=movie, title=title, key=key,
                 year=it.get("year") if movie else ser.get("year"), rt=rt, uk=uk,
                 cover=(it.get("cid") or a["id"]) if movie else it.get("series"),
                 genres=it.get("genres") if movie else ser.get("genres"), w=it.get("w", 0), h=it.get("h", 0),
                 full=secs >= WR_FULL * rt if rt else secs >= 20 * 60)
        a.setdefault("label", title)
        plays.append(a)
    plays.sort(key=lambda p: p["first"])
    total = sum(p["secs"] for p in plays)
    out = {"year": yr, "partial": yr == today.year, "to": today.isoformat() if yr == today.year else f"{yr}-12-31",
           "hours": round(total / 3600, 1), "plays": len(plays), "days": len({p["day"] for p in plays}),
           "films": len({p["uk"] for p in plays if p["movie"]}), "film_plays": sum(p["movie"] for p in plays),
           "episodes": len({p["uk"] for p in plays if not p["movie"]}),
           "episode_plays": sum(not p["movie"] for p in plays),
           "shows": len({p["key"] for p in plays if not p["movie"]})}
    if not plays:
        return out, plays
    # genres by time watched (episodes take their show's genres)
    gs, gtot = collections.Counter(), 0
    for p in plays:
        if p["genres"]:
            gtot += p["secs"]
            for g in p["genres"]:
                gs[g] += p["secs"] / len(p["genres"])
    out["genres"] = [{"name": g, "pct": round(100 * s / gtot), "hours": round(s / 3600, 1)} for g, s in gs.most_common(5)]
    # shows by time watched
    sh = {}
    for p in plays:
        if not p["movie"]:
            s = sh.setdefault(p["key"], {"name": p["title"], "eps": set(), "secs": 0, "cover": p["cover"]})
            s["eps"].add(p["uk"])
            s["secs"] += p["secs"]
    out["top_shows"] = [{"name": s["name"], "episodes": len(s["eps"]), "hours": round(s["secs"] / 3600, 1),
                         "cover": s["cover"]} for s in sorted(sh.values(), key=lambda s: (-s["secs"], s["name"]))[:5]]
    # longest binge: most episodes in one viewing day (else the longest day)
    per_day = collections.defaultdict(list)
    for p in plays:
        per_day[p["day"]].append(p)
    def day_rank(d):
        eps = [p for p in per_day[d] if not p["movie"]]
        return (len(eps), sum(p["secs"] for p in per_day[d]), d)
    bd = max(per_day, key=day_rank)
    eps = [p for p in per_day[bd] if not p["movie"]]
    top = collections.Counter(p["title"] for p in (eps or per_day[bd])).most_common(1)[0]
    lead = next(p for p in (eps or per_day[bd]) if p["title"] == top[0])
    out["binge"] = {"day": bd.isoformat(), "episodes": len(eps), "hours": round(sum(p["secs"] for p in per_day[bd]) / 3600, 1),
                    "show": top[0], "show_episodes": top[1] if eps else 0, "cover": lead["cover"]}
    # when: weekday of the viewing day, start hour of each part (both by time watched)
    wd, hr, cl = [0.0] * 7, [0.0] * 24, collections.Counter()
    for p in plays:
        wd[p["day"].weekday()] += p["secs"]
        for ts, s, c in p["parts"]:
            hr[ts.hour] += s * p["scale"]
            cl[c] += s * p["scale"]
    out["weekdays"] = [round(x / 3600, 1) for x in wd]
    out["hours_of_day"] = [round(x / 3600, 1) for x in hr]
    out["fav_weekday"] = WD[max(range(7), key=lambda i: (wd[i], -i))]
    out["fav_hour"] = max(range(24), key=lambda i: (hr[i], -i))
    out["screens"] = [{"name": c, "pct": round(100 * s / total)} for c, s in cl.most_common(3)]
    # most rewatched: most viewing days with a (near) full watch
    rw = collections.defaultdict(set)
    for p in plays:
        if p["full"]:
            rw[p["uk"]].add(p["day"])
    best = max(rw.items(), key=lambda kv: (len(kv[1]), -min(kv[1]).toordinal()), default=None)
    if best and len(best[1]) >= 2:
        p = next(x for x in plays if x["uk"] == best[0])
        out["rewatched"] = {"title": p["label"], "times": len(best[1]), "movie": p["movie"], "cover": p["cover"],
                            "last": max(best[1]).isoformat()}
    else:
        out["rewatched"] = None
    f, l = plays[0], plays[-1]
    out["first"] = {"title": f["label"], "at": f["first"].isoformat(timespec="minutes"), "cover": f["cover"], "movie": f["movie"]}
    out["latest"] = {"title": l["label"], "at": l["first"].isoformat(timespec="minutes"), "cover": l["cover"], "movie": l["movie"]}
    # films: decades (distinct films), wall (distinct, by first watch), longest
    films = {}
    for p in plays:
        if p["movie"] and p["uk"] not in films:
            films[p["uk"]] = p
    dec = collections.Counter(f"{p['year'] // 10 * 10}s" for p in films.values() if p["year"])
    out["decades"] = [{"decade": d, "films": n} for d, n in sorted(dec.items())]
    out["top_decade"] = max(dec.items(), key=lambda kv: (kv[1], kv[0]))[0] if dec else None
    out["film_wall"] = [{"title": p["title"], "year": p["year"], "cover": p["cover"]} for p in films.values()]
    longest = max((p for p in films.values() if p["rt"]), key=lambda p: p["rt"], default=None)
    # 4K share of the time watched (items with known dimensions)
    known = [p for p in plays if p["w"] or p["h"]]
    k4 = sum(p["secs"] for p in known if p["w"] >= WR_4K_W or p["h"] >= WR_4K_H)
    out["uhd_pct"] = round(100 * k4 / sum(p["secs"] for p in known)) if known else None
    out["uhd_films"] = sum(1 for p in films.values() if p["w"] >= WR_4K_W or p["h"] >= WR_4K_H)
    # fun facts, best first
    night = sum(hr[h] for h in (23, 0, 1, 2, 3, 4)) / total
    facts = []
    if night >= 0.2:
        facts.append(f"🦉 Night owl: {round(100 * night)} % of your watching started after 23:00.")
    if total >= 48 * 3600:
        facts.append(f"⏳ That's {total / 86400:.1f} days of non-stop watching.")
    if longest:
        facts.append(f"🏔 Longest film: {longest['title']} ({wr_hm(longest['rt'])}).")
    if cl:
        c, s = cl.most_common(1)[0]
        facts.append(f"📺 {round(100 * s / total)} % of it on {c}.")
    out["facts"] = facts
    out["fun_fact"] = facts[0] if facts else None
    return out, plays


def wr_ddmm(iso):
    return f"{iso[8:10]}.{iso[5:7]}"


def wr_card(s):
    """<= 8 plain lines for Telegram."""
    span = f"{s['year']} so far (to {wr_ddmm(s['to'])})" if s["partial"] else str(s["year"])
    lines = [f"🎬 Emby Wrapped {span}"]
    if not s["plays"]:
        return "\n".join(lines + [f"No plays of yours in {s['year']} yet." if s["partial"] else f"No plays of yours in {s['year']}."])
    lines.append(f"⏱ {s['hours']:g} h · {plural(s['films'], 'film')} · {plural(s['episodes'], 'episode')}"
                 f" of {plural(s['shows'], 'show')}")
    if s.get("genres"):
        lines.append("🎭 " + ", ".join(f"{g['name']} {g['pct']} %" for g in s["genres"][:3]))
    if s.get("top_shows"):
        lines.append("📺 " + ", ".join(f"{x['name']} ({x['episodes']} ep)" for x in s["top_shows"][:3]))
    b = s["binge"]
    d = date.fromisoformat(b["day"])
    if b["episodes"]:
        lines.append(f"🍿 Binge record: {b['episodes']} episodes on {WD[d.weekday()]} {d:%d.%m}"
                     + (f" ({b['show']})" if b["show_episodes"] * 2 >= b["episodes"] else ""))
    else:
        lines.append(f"🍿 Longest day: {b['hours']:g} h on {WD[d.weekday()]} {d:%d.%m}")
    when = f"📅 {WD_LONG[WD.index(s['fav_weekday'])]} around {s['fav_hour']:02d}:00"
    if s.get("uhd_pct") is not None:
        when += f" · 4K {s['uhd_pct']} %"
    if s.get("top_decade"):
        when += f" · films: the {s['top_decade']}"
    lines.append(when)
    first = f"first {s['first']['title']} {wr_ddmm(s['first']['at'])}"
    lines.append(f"🔁 {s['rewatched']['title']} {s['rewatched']['times']}× · {first}" if s.get("rewatched")
                 else f"🔁 No rewatches · {first}")
    if s.get("fun_fact"):
        lines.append(s["fun_fact"])
    return "\n".join(lines[:8])


def wr_cover(item_id, cache, budget, warns):
    """A small Emby cover as a data: URI (GET with the key in a header), or None; stays within the byte budget."""
    if not item_id or not str(item_id).isdigit():
        return None
    if item_id in cache:
        return cache[item_id]
    cache[item_id] = None
    c = CFG.get("emby") or {}
    if not c.get("url") or not c.get("key"):
        return None
    url = c["url"].rstrip("/") + f"{EMBY}/Items/{item_id}/Images/Primary?maxHeight={WR_COVER_H}&quality=70"
    try:
        with svc_open("emby", urllib.request.Request(url, headers={"X-Emby-Token": svc_key("emby")}), TIMEOUT) as r:
            ctype, data = r.headers.get_content_type(), r.read(WR_COVER_MAX + 1)
    except urllib.error.HTTPError as e:
        if e.code != 404:
            warns.append(f"cover HTTP {e.code}")
        return None
    except (urllib.error.URLError, OSError, http.client.HTTPException, ApiError) as e:
        warns.append(f"cover: {type(e).__name__}")
        return None
    if ctype not in ("image/jpeg", "image/png", "image/webp") or len(data) > WR_COVER_MAX or len(data) > budget[0]:
        return None
    budget[0] -= len(data)
    cache[item_id] = f"data:{ctype};base64,{base64.b64encode(data).decode()}"
    return cache[item_id]


