def dg_esc(s):
    return html.escape(str(s if s is not None else ""), quote=True)


def dg_web_who(x, watched=False):
    """The names line of a page item: "for Jacky & Timon" (requesters) or "watched by Noah · 5 plays" (viewers)."""
    if watched:
        p = x.get("plays") or 0
        return " · ".join(s for s in (("watched by " + dg_names(x["who"])) if x.get("who") else "",
                                      plural(p, "play") if p > 1 else "") if s)
    return ("for " + dg_names(x["req_who"])) if x.get("req_who") else ""


def dg_web_item(x, web, rank=None, row=False, hide_badge=False, who="", foot=False):
    """One poster tile (or list row) in the cards' look; a link to the Emby item when it is in Emby. `who`: a names
    line under the meta line, or (foot=True) a badge on the poster's foot."""
    eid = str(x.get("emby_id") or "")
    link = (f"{web[0]}/web/index.html#!/item?id={eid}&serverId={web[1]}"
            if web and re.fullmatch(r"[0-9a-fA-F]+", eid) else None)
    hsh = int(hashlib.sha1(str(x["title"]).encode()).hexdigest()[:6], 16)
    ph = ("#ff4f8b", "#7b5cff", "#22d3a6")[hsh % 3]
    img = (f'<img loading="lazy" alt="" src="https://image.tmdb.org/t/p/w342{dg_esc(x["poster"])}">'
           if re.fullmatch(r"/[\w.-]+\.(jpg|jpeg|png)", str(x.get("poster") or "")) else
           f'<div class="ph">{dg_esc(x["title"])}</div>')
    badge = ""
    if rank and not row:
        badge = f'<span class="rank{" first" if rank == 1 else ""}">{rank}</span>'
    elif x.get("episodes") and not hide_badge:
        n = x["episodes"]
        badge = (f'<span class="badge{" new" if x.get("new_series") else ""}">'
                 + (f"NEW · {n} ep" if x.get("new_series") else f"+{n} ep") + ("" if n == 1 else "s") + "</span>")
    r = x.get("rating") if x.get("rating") is not None else x.get("vote")
    meta = " · ".join(str(s) for s in (x.get("year"), po_seasons(x["seasons"]) if x.get("seasons") else None,
                                       "Show" if x["kind"] == "show" and (row or not x.get("year")) else
                                       ("Movie" if row else None)) if s)
    star = f' <span class="star">★ {float(r):.1f}</span>' if isinstance(r, (int, float)) and r > 0 else ""
    if who and foot and not row:
        badge += f'<span class="req">{dg_esc(who)}</span>'
    poster = f'<div class="poster" style="--ph:{ph}">{img}{badge}</div>'
    body = f'<div class="t">{dg_esc(x["title"])}</div><div class="m">{dg_esc(meta)}{star}</div>'
    if who and (row or not foot):
        body += f'<div class="m who">{dg_esc(who)}</div>'
    if row:
        n = f'<div class="n{" first" if rank == 1 else ""}">{rank}</div>' if rank else ""
        inner, cls, tag = f'{n}{poster}<div class="tx">{body}</div>', "row", "li"
    else:
        inner, cls, tag = poster + body, "tile", "div"
    if link:
        el = f'<a class="{cls}" href="{dg_esc(link)}" data-ext target="_blank" rel="noopener">{inner}</a>'
        return f"<li>{el}</li>" if row else el
    return f'<li class="{cls}">{inner}</li>' if row else f'<{tag} class="{cls}">{inner}</{tag}>'


def dg_web_doc(title, body, index=False, pages=None):
    head = ('<!doctype html><html lang="en"><head><meta charset="utf-8">'
            '<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">'
            '<meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer">'
            f'<title>{dg_esc(title)}</title><link rel="stylesheet" href="style.css?v={DG_ASSET_V}">'
            '<script src="https://telegram.org/js/telegram-web-app.js"></script>'
            f'<script src="app.js?v={DG_ASSET_V}" defer></script></head>')
    data = (f'<script type="application/json" id="pages">{json.dumps(pages or [])}</script>' if index else "")
    return head + f'<body{" data-index" if index else ""}><main>{body}</main>{data}</body></html>\n'


DG_ASSET_V = hashlib.sha1((DG_CSS + DG_JS).encode()).hexdigest()[:8]


def dg_web_page(kind, v, web):
    """The page body of one digest, sections as on the card, with more titles and the names: requesters on the new
    posters and request rows, viewers (and plays) under each most-watched title."""
    out = [f'<header><h1>{dg_esc(v["head"])}</h1><p class="sub">{dg_esc(v["sub"])}</p>'
           f'<p class="counts">{dg_esc(v["counts"])}</p><div class="rule"></div></header>']
    if kind == "weekly":
        cols = ("a1", "a2", "a3", "star")
        out.append('<div class="stats">' + "".join(
            f'<div class="stat" style="border-top-color:var(--{cols[i % 4]})"><div class="l">{dg_esc(l)}</div>'
            f'<div class="v">{dg_esc(val)}</div><div class="s">{dg_esc(s)}</div></div>'
            for i, (l, val, s, _) in enumerate(v["tiles"])) + "</div>")
        if v["top"]:
            out.append('<section><h2>Most watched this week</h2><div class="grid">'
                       + "".join(dg_web_item(x, web, i + 1, who=dg_web_who(x, True)) for i, x in enumerate(v["top"]))
                       + "</div></section>")
        if v["page_new"]:
            out.append(f'<section><h2>New this week <span>{v["new_total"]}</span></h2><div class="grid">'
                       + "".join(dg_web_item(x, web, who=dg_web_who(x), foot=True) for x in v["page_new"]) + "</div></section>")
        if v["chips"]:
            out.append('<section><h2>Changes</h2><div class="chips">' + "".join(
                f'<span class="chip" style="border-color:var(--{c})">{dg_esc(s)}</span>' for s, c in v["chips"])
                + "</div></section>")
    else:
        if v["page_new"]:
            out.append(f'<section><h2>New <span>{len(v["new"])}</span></h2><div class="grid">'
                       + "".join(dg_web_item(x, web, who=dg_web_who(x), foot=True) for x in v["page_new"]) + "</div></section>")
        if v["reqs"]:
            out.append(f'<section><h2>Requests fulfilled <span>{len(v["reqs"])}</span></h2><ul class="rows">'
                       + "".join(dg_web_item(x, web, row=True, who=dg_web_who(x)) for x in v["reqs"]) + "</ul></section>")
        if v["top"]:
            out.append('<section><h2>Most watched today</h2><ol class="rows">'
                       + "".join(dg_web_item(x, web, i + 1, row=True, who=dg_web_who(x, True)) for i, x in enumerate(v["top"]))
                       + "</ol></section>")
    out.append('<footer>Want something? Request it in Seerr<br><a href="./">All digests</a>'
               + (" · tap a poster to open it in Emby" if web else "") + "</footer>")
    return "".join(out)


def dg_web_publish(kind, v, pid, title, web, warns):
    """Write the page, today/week, the index and the assets, prune old pages, mirror the folder to the VM."""
    import shutil
    d = os.path.expanduser(DG_WEB_DIR)
    os.makedirs(os.path.join(d, "fonts"), exist_ok=True)

    def put(name, text):
        with open(os.path.join(d, name + ".tmp"), "w") as f:
            f.write(text)
        os.replace(os.path.join(d, name + ".tmp"), os.path.join(d, name))
    page = dg_web_doc(title, dg_web_page(kind, v, web))
    put(f"{pid}.html", page)
    put("today.html" if kind == "daily" else "week.html", page)
    put("style.css", DG_CSS)
    put("app.js", DG_JS)
    for fn in ("NotoSans-Regular.ttf", "NotoSans-Bold.ttf"):
        src, dst = os.path.join(PO_FONTS, "noto", fn), os.path.join(d, "fonts", fn)
        if os.path.exists(src) and not os.path.exists(dst):
            shutil.copyfile(src, dst)
    idx = dg_json(os.path.join(d, "pages.json"))
    idx[pid] = {"title": title, "kind": kind}
    today = now_utc().astimezone(ZRH).date()

    def age(p):
        try:
            if p.startswith("d-"):
                return (today - date.fromisoformat(p[2:])).days
            y, w = p[2:].split("-")
            return (today - date.fromisocalendar(int(y), int(w), 7)).days
        except ValueError:
            return 10 ** 6
    idx = {p: e for p, e in idx.items() if DG_PAGE_ID.fullmatch(p) and age(p) <= DG_WEB_KEEP[p[0]]}
    for fn in os.listdir(d):
        if fn.endswith(".html") and DG_PAGE_ID.fullmatch(fn[:-5]) and fn[:-5] not in idx:
            os.unlink(os.path.join(d, fn))
    put("pages.json", json.dumps(idx, ensure_ascii=False))
    order = sorted(idx, key=lambda p: (-age(p), p[0] == "d"), reverse=True)
    body = ('<header><h1>Media digest</h1><p class="sub">What is new and most watched on the server</p>'
            '<div class="rule"></div></header><section class="list">'
            + "".join(f'<a href="{p}">{dg_esc(idx[p]["title"])}<span>{"week" if p[0] == "w" else "day"}</span></a>'
                      for p in order) + '</section><footer>Want something? Request it in Seerr</footer>')
    put("index.html", dg_web_doc("Media digest", body, index=True, pages=order))
    if DG_WEB_DEST:
        dest = DG_WEB_DEST.rstrip("/") + "/"
        rsh = []
    else:
        vm = str(assistant_profile.get("network.hosts.web_vm") or "")
        if not re.fullmatch(r"\w[\w.-]*(@\w[\w.-]*)?", vm):     # host or user@host (ssh alias), never an option
            raise ApiError("no web VM in the profile (network.hosts.web_vm)")
        dest, rsh = f"{vm}:/etc/nginx/dash-www/media/", ["-e", "ssh -o ConnectTimeout=10 -o BatchMode=yes"]
    r = subprocess.run(["timeout", "-k", "10", "120", "rsync", "-rlt", "--delete", "--timeout=60", "--chmod=F644,D755",
                        *rsh, d.rstrip("/") + "/", dest], capture_output=True, text=True)
    if r.returncode:
        raise ApiError(f"web publish: rsync exit {r.returncode}")
    return pid


def dg_units(c, extra_m=0, extra_s=0):
    parts = [plural(c["movies"] + extra_m, "movie")] if c["movies"] + extra_m else []
    parts += [plural(extra_s, "show")] if extra_s else []
    parts += [plural(c["episodes"], "episode")] if c["episodes"] else []
    return ", ".join(parts)


def cmd_digest(a):
    try:
        import PIL  # noqa: F401
    except ImportError:
        die("digest needs Pillow for this python3 (apt: python3-pil)")
    kind = "weekly" if a.weekly else "daily"
    conf, st, warns, now = dg_json(DG_CONF), dg_json(DG_STATE), [], now_utc()
    loc = now.astimezone(ZRH)
    day, since = loc.strftime("%Y-%m-%d"), now - timedelta(days=7 if a.weekly else 1)
    live = not a.dry_run
    style = dg_style(conf, warns)
    if live and not conf.get("enabled"):
        print(f"media digest: off ({DG_CONF} has no \"enabled\": true); nothing posted. --dry-run renders a preview.")
        return
    last = st.get(kind) or {}
    if live and last.get("day") == day and not a.force:
        print(f"media digest: the {kind} card was posted today already (message {last.get('message_id')}); --force posts again")
        return
    uid = ct_guid(lambda: seerr_user_rec(TONIGHT_USER, "MEDIA_TONIGHT_USER"))
    new = dg_mix(soft(lambda: po_collect(uid, since, warns)[0], warns, "Emby new items") or [])
    movies, shows = [x for x in new if x["kind"] == "movie"], [x for x in new if x["kind"] == "show"]
    eps = sum(x["episodes"] for x in shows)
    top = (soft(lambda: dg_watched(since, conf), warns, "Tracearr plays") or [])[:10]
    for x in new:
        x["eid"] = x.get("id")                      # the Emby id finds the Tmdb id (with or without a poster)
    dg_english(new[:40] + top, uid, warns)
    top = dg_merge_top(top)
    for x in top:
        x["line"] = dg_top_line(x)
    lib = soft(dg_library, warns, "library size")
    prev = dg_snapshot(st, lib, day)
    en = dg_counts(len(movies), len(shows), eps)
    v = {"new": new, "top": top, "page_new": new[:40]}
    if kind == "daily":
        done = set() if a.force else {k for k, d in (st.get("requests_posted") or {}).items() if str(d) < day}
        # posted today still count today (the day's page lists them); posted on an earlier day: never again
        reqs = soft(lambda: dg_requests(uid, since, conf, done, warns), warns, "Seerr requests") or []
        for x in reqs:
            x["line"] = ("Movie" if x["kind"] == "movie" else "Show") + (f" · {x['year']}" if x.get("year") else "")
        dg_tag_who(new, reqs)
        nr = len(reqs)
        v["page_title"] = f"New today · {DG_WD[loc.weekday()]} {loc.day} {PO_MON[loc.month - 1]}"
        v["pid"] = f"d-{day}"
        v.update(reqs=reqs, head=v["page_title"],
                 sub="New on the server in the last 24 hours")
        v["counts"] = " · ".join(p for p in (en.replace(", ", " · "), plural(nr, "request") + " fulfilled" if nr else "") if p) \
            or "nothing new"
        happened = bool(new or reqs)
        cap = (f"🎬 New on the server today: {en or 'no new titles'}"
               + (f" · {plural(nr, 'request')} fulfilled" if nr else "") + "."
               + ("\nMost watched: " + ", ".join(x["title"] for x in top[:3]) + "." if top else ""))
        short = [plural(n, w) for n, w in ((len(movies), "movie"), (len(shows), "show")) if n] \
            or ([plural(nr, "request") + " fulfilled"] if nr else ["nothing new"])
        cap_c = "🎬 New today · " + " · ".join(short)
    else:
        kw = loc.isocalendar()[1]
        start = loc - timedelta(days=6)         # Sunday 19:00 run: Mon-Sun
        rng = (f"{start.day}–{loc.day} {PO_MON[loc.month - 1]}" if start.month == loc.month
               else f"{start.day} {PO_MON[start.month - 1]} – {loc.day} {PO_MON[loc.month - 1]}")
        dg_tag_who(new, soft(lambda: dg_requests(uid, since, conf, set(), warns), warns, "Seerr requests") or [])
        ch = dg_changes(since, warns)
        gone_m = sorted(set(prev["movies"]) - set(lib["movies"])) if prev and lib else []
        gone_s = sorted(set(prev["shows"]) - set(lib["shows"])) if prev and lib else []
        chips = []
        if dg_units(ch["up"]):
            chips.append((f"Upgraded: {dg_units(ch['up'])}", "a3"))
        if dg_units(ch["down"]):
            chips.append((f"Downgraded: {dg_units(ch['down'])}", "star"))
        if dg_units(ch["clean"], len(gone_m), len(gone_s)):
            chips.append((f"Removed: {dg_units(ch['clean'], len(gone_m), len(gone_s))}", "a1"))
        tiles = []                  # no storage stats on the weekly card or page: counts only
        if lib:
            tiles += [("Movies", dg_num(len(lib["movies"])), f"+{len(movies)} new" if movies else "in the library", "a1"),
                      ("Shows", dg_num(len(lib["shows"])), f"{dg_num(lib['episodes'])} episodes", "a2")]
        v["page_title"] = f"Week {kw} · {rng}"
        v["pid"] = f"w-{loc.isocalendar()[0]}-{kw}"
        v.update(head=f"Week {kw} on the server", sub=f"The week in review · {rng}",
                 counts=(en.replace(", ", " · ") + " new") if en else "nothing new",
                 tiles=tiles or [("Library", "?", "not checked", "a2")], chips=chips, new=new[:10], new_total=len(new), reqs=[])
        happened = bool(new or top or chips)
        short = [plural(n, w) for n, w in ((len(movies), "movie"), (len(shows), "show")) if n]
        cap_c = f"📊 New in week {kw} · " + " · ".join(short) if short else f"📊 Week {kw} · no new titles"
        v["lib_line"] = [f"{dg_num(len(lib['movies']))} movies", f"{dg_num(len(lib['shows']))} shows"] if lib else []
        cap = (f"📊 Week {kw} on the server: " + (f"{en} new" if en else "no new titles") + "."
               + ("\nMost watched: " + ", ".join(x["title"] for x in top[:3]) + "." if top else "")
               + (f"\nLibrary: {dg_num(len(lib['movies']))} movies, {dg_num(len(lib['shows']))} shows."
                  if lib else ""))
    page_url = web_pid = None
    if happened and (a.web or (live and conf.get("miniapp"))):
        if kind == "weekly":
            v["page_new"] = new[:40]
        web = soft(lambda: dg_emby_web(conf, warns), warns, "Emby public address")
        web_pid = soft(lambda: dg_web_publish(kind, v, v["pid"], v["page_title"], web, warns), warns, "Mini App page")
        ml, wb = str(conf.get("miniapp_link") or "").rstrip("/"), str(conf.get("web_base") or "").rstrip("/")
        if web_pid and (ml or wb):
            page_url = f"{ml}?startapp={web_pid}" if ml else f"{wb}/{web_pid}"
    if happened and not page_url and (a.page or (live and conf.get("telegraph"))):
        page_url = soft(lambda: dg_publish_page(kind, v, conf, warns), warns, "Telegraph page")
    if style == "full":
        link = f"\n📖 All titles: {page_url}" if page_url else ""
        cap = cap[:1024 - len(link)] + link
    else:                       # compact: one or two short lines; the "📖 Open list" button carries the link
        cap = (cap_c + (f"\n🔥 Most watched: {top[0]['title']}" if top else ""))[:1024]
    out = os.path.expanduser(a.out or os.path.join(REPORT_DIR, f"digest-{kind}-{day}.png"))
    size, mid = None, None
    if happened:
        size = (dg_render if style == "full" else dg_render_c)(kind, v, out, warns)
        with open(os.path.splitext(out)[0] + ".txt", "w") as f:
            f.write(cap + "\n")
    if live and happened:
        mid = dg_post(out, cap, page_url)
        st[kind] = {"day": day, "message_id": mid, "at": iso_z(now)}
        if kind == "daily":
            rp = {k: d for k, d in (st.get("requests_posted") or {}).items() if d >= (loc.date() - timedelta(days=14)).isoformat()}
            rp.update({rid: day for x in v["reqs"] for rid in x["req_ids"]})
            st["requests_posted"] = rp
    if not live:                # a dry run keeps only its library snapshot: never race the cron run's posted ids
        st = dict(dg_json(DG_STATE), library=st.get("library") or {})
    dg_save(st)
    warns = list(dict.fromkeys(warns))
    if a.json:
        emit_json({"kind": kind, "style": style, "path": out if happened else None, "caption_path": os.path.splitext(out)[0] + ".txt" if happened else None,
                   "size": list(size) if size else None, "caption": cap if happened else None, "posted": bool(mid),
                   "page_url": page_url, "web_page": web_pid,
                   "message_id": mid, "new_movies": len(movies), "new_shows": len(shows), "new_episodes": eps,
                   "new_titles": [x["title"] for x in new],
                   "requests": [{"title": x["title"], "who": x["who"]} for x in v.get("reqs") or []],
                   "top": [x["title"] for x in top], "chips": [c for c, _ in v.get("chips") or []],
                   "tiles": [list(t[:3]) for t in v.get("tiles") or []], "warnings": warns})
    elif not happened:
        print(f"Nothing new for the {kind} card: no card, nothing posted.")
    else:
        print(f"Card: {out} ({size[0]}x{size[1]})\nCaption: {os.path.splitext(out)[0]}.txt")
        print(f"Page: {page_url}" if page_url else "Page: none")
        print(f"Posted: message {mid}" if mid else "Dry run: not posted.")
    for w in warns:
        print(f"media: warning: {w}", file=sys.stderr)
    sys.exit(3 if warns else 0)


# ---------- poster: cached Emby Primary images for picture cards (GET-only; Pillow) ----------
PS_CACHE = os.environ.get("MEDIA_POSTER_CACHE") or "~/.cache/media/posters"
PS_MAX_AGE = _env_num("MEDIA_POSTER_MAX_AGE_DAYS", 30) * 86400
PS_MAX_IDS = 12
PS_ID = re.compile(r"[0-9A-Za-z]{1,40}")


def ps_prune(d, now_s):
    """Once a day: drop cached posters not refreshed in 2x the max age (they would be fetched again anyway)."""
    stamp = os.path.join(d, ".pruned")
    try:
        if now_s - os.stat(stamp).st_mtime < 86400:
            return
    except OSError:
        pass
    try:
        with os.scandir(d) as it:
            for e in it:
                if e.name.endswith(".jpg") and now_s - e.stat().st_mtime > 2 * PS_MAX_AGE:
                    os.unlink(e.path)
        with open(stamp, "w"):
            pass
    except OSError:
        pass


def ps_one(item_id, width, d, warns):
    """(path or None, fetched): the cached poster when fresh, else Emby's Primary image re-encoded as JPEG."""
    import io, tempfile
    from PIL import Image
    path = os.path.join(d, f"{item_id}-w{width}.jpg")
    try:
        st = os.stat(path)
        if st.st_size > 0 and time.time() - st.st_mtime < PS_MAX_AGE:
            return path, False
    except OSError:
        pass
    c = CFG.get("emby") or {}
    url = c["url"].rstrip("/") + f"{EMBY}/Items/{item_id}/Images/Primary?maxWidth={width}&quality=90"
    try:
        with svc_open("emby", urllib.request.Request(url, headers={"X-Emby-Token": svc_key("emby")}),
                     min(TIMEOUT, 6)) as r:
            data = r.read(PO_IMG_MAX + 1)
        if len(data) > PO_IMG_MAX:
            warns.append("poster too big")
            return None, False
        im = Image.open(io.BytesIO(data))
        im.load()
        im = im.convert("RGB")
        if im.width > width:
            im = im.resize((width, max(1, round(im.height * width / im.width))), Image.LANCZOS)
        fd, tmp = tempfile.mkstemp(prefix=f".{item_id}.", suffix=".jpg", dir=d)
        try:
            with os.fdopen(fd, "wb") as fh:
                im.save(fh, "JPEG", quality=88)
            os.replace(tmp, path)
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
        return path, True
    except urllib.error.HTTPError as e:
        if e.code != 404:
            warns.append(f"poster HTTP {e.code}")
    except Exception as e:      # network errors, broken or unknown image data: the card draws a placeholder
        warns.append(f"poster: {type(e).__name__}")
    return None, False


def cmd_poster(a):
    import concurrent.futures
    try:
        import PIL  # noqa: F401
    except ImportError:
        die("poster needs Pillow for this python3 (apt: python3-pil)")
    if not 64 <= a.width <= 1200:
        die("--width must be 64..1200", 2)
    ids = list(dict.fromkeys(a.ids))
    bad = [i for i in ids if not PS_ID.fullmatch(i)]
    if bad or not ids or len(ids) > PS_MAX_IDS:
        die(f"poster: 1..{PS_MAX_IDS} Emby item ids (letters and digits)", 2)
    c = CFG.get("emby") or {}
    if not c.get("url") or not c.get("key"):
        die(f"poster: no emby url/key in {SECRETS}")
    d = os.path.expanduser(PS_CACHE)
    os.makedirs(d, mode=0o700, exist_ok=True)
    ps_prune(d, time.time())
    warns = []
    with concurrent.futures.ThreadPoolExecutor(6) as ex:
        res = list(ex.map(lambda i: ps_one(i, a.width, d, warns), ids))
    out = {i: p for i, (p, _) in zip(ids, res)}
    if a.json:
        emit_json({"posters": out, "fetched": sum(f for _, f in res), "cached": sum(bool(p) and not f for p, f in res),
                   "warnings": sorted(set(warns))})
    else:
        for i in ids:
            print(f"{i} {out[i] or '-'}")
    if warns:
        sys.exit(3)


def main():
    if not ({"-h", "--help"} & set(sys.argv[1:2])):
        assistant_profile.require_feature("media", "media")
    p = argparse.ArgumentParser(prog="media", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    s = sp.add_parser("search"); s.add_argument("query", nargs="+")
    s.add_argument("--type", choices=["movie", "tv"]); s.add_argument("-n", type=int, default=8)
    r = sp.add_parser("request"); r.add_argument("tmdb_id", type=int)
    r.add_argument("--type", choices=["movie", "tv"], required=True)
    r.add_argument("--seasons", help="'all' (default for tv) or e.g. 1,2")
    r.add_argument("--dry-run", action="store_true", help="show what would be requested")
    r.add_argument("--json", action="store_true", help="machine-readable result")
    st = sp.add_parser("status"); st.add_argument("title", nargs="*")
    st.add_argument("--type", choices=["movie", "tv"]); st.add_argument("--tmdb", type=int)
    st.add_argument("-n", type=int, default=1, help="how many search matches to show")
    qu = sp.add_parser("queue")
    rc = sp.add_parser("recent"); rc.add_argument("-n", type=int, default=15)
    for x in (s, st, qu, rc):
        x.add_argument("--json", action="store_true", help="machine-readable output")
    # read-only extras
    ai = sp.add_parser("airing", help="episodes and movie releases coming up (Zurich time)")
    ai.add_argument("--days", type=int, default=7)
    ai.add_argument("--cinema", action="store_true", help="also list cinema releases")
    mi = sp.add_parser("missing", help="monitored episodes/movies without a file")
    cu = sp.add_parser("cutoff", help="files below their quality profile's cutoff")
    for x in (mi, cu):
        x.add_argument("-n", type=int, default=10, help="lines per section")
    he = sp.add_parser("health", help="Sonarr/Radarr health + Seerr status; exit 2 on problems")
    he.add_argument("--quiet", action="store_true", help="print nothing when all is fine")
    tr = sp.add_parser("trending", help="trending on TMDB (via Seerr)")
    si = sp.add_parser("similar", help="recommendations for a title (via Seerr)")
    si.add_argument("title", nargs="*"); si.add_argument("--tmdb", type=int)
    for x in (tr, si):
        x.add_argument("--type", choices=["movie", "tv"]); x.add_argument("-n", type=int, default=10)
        x.add_argument("--new", action="store_true", help="only titles not on the server or requested")
    ho = sp.add_parser("hogs", help="biggest titles on disk (read-only)")
    ho.add_argument("--top", type=int, default=20); ho.add_argument("--type", choices=["movie", "tv"])
    ho.add_argument("--sort", choices=["size", "stale"], default="size",
                    help="stale = size x years since anything new arrived")
    uw = sp.add_parser("unwatched", help="cleanup candidates nobody watches (read-only)")
    uw.add_argument("--top", type=int, default=15); uw.add_argument("--type", choices=["movie", "tv"])
    uw.add_argument("--days", type=int, default=180, help="no play for this many days (default 180)")
    uw.add_argument("--min-age", type=int, default=90, help="only titles on disk longer than this (default 90)")
    uw.add_argument("--report", nargs="?", const="auto", metavar="FILE",
                    help="write the full markdown table (default ~/reports/media/unwatched-DATE.md)")
    uw.add_argument("--no-emby", action="store_true", help="Tracearr history only (skip Emby's DB over ssh)")
    for x in (ai, mi, cu, he, tr, si, ho, uw):
        x.add_argument("--json", action="store_true", help="machine-readable output")
    rw = sp.add_parser("ready-watch", help="cron: text the owner when his requests are ready on Emby")
    rw.add_argument("--dry-run", action="store_true", help="print what would be sent; save nothing")
    rw.add_argument("--status", action="store_true", help="show the watcher's state")
    tn = sp.add_parser("tonight", help="three picks for tonight: a library movie, a show, something new to request")
    tn.add_argument("--mood", help="light, dark, funny, action, mind, learn, ... or a genre")
    tn.add_argument("--time", type=int, metavar="MIN", help="time budget in minutes")
    tn.add_argument("--args", default="", metavar="TEXT", help="free text after /tonight, e.g. 'light 90', '1h30 scifi'")
    tn.add_argument("--more", action="store_true", help="3 new picks with the last run's mood and time")
    tn.add_argument("--dry-run", action="store_true", help="don't remember the picks")
    tn.add_argument("--json", action="store_true", help="machine-readable output with the Telegram message and buttons")
    co = sp.add_parser("continue", help="his Emby Continue watching (Resume + Next Up) with a Play-on-TV button each")
    co.add_argument("-n", type=int, default=4, help=f"items (default 4, at most {CT_MAX})")
    co.add_argument("--json", action="store_true", help="machine-readable output with the Telegram message and buttons")
    gr = sp.add_parser("group", help="movie night with friends: library movies nobody in the group has seen, + a poll")
    gr.add_argument("--with", dest="with_", default="", metavar="NAMES",
                    help=f"Emby users besides him, comma-separated (default: all with a play in {GR_ACTIVE_DAYS} days)")
    gr.add_argument("--mood", help="light, dark, funny, action, mind, ... or a genre")
    gr.add_argument("--time", type=int, metavar="MIN", help="time budget in minutes")
    gr.add_argument("--args", default="", metavar="TEXT", help="free text after /movienight: names, moods, a time")
    gr.add_argument("-n", type=int, default=4, help=f"picks (default 4, at most {GR_MAX})")
    gr.add_argument("--json", action="store_true", help="machine-readable output with the message, poll and buttons")
    vb = sp.add_parser("vibe", help="4 library movies for a mood or 'like <film>' (local embedding index)")
    vb.add_argument("text", nargs="*", help="a mood, words, 'like <film>', 'short', a time like 90min / 'under 2h'")
    vb.add_argument("-n", type=int, default=VIBE_N, help=f"picks (default {VIBE_N}, at most {VIBE_MAX})")
    vb.add_argument("--json", action="store_true", help="machine-readable: message + buttons (session), text (plain, links)")
    vb.add_argument("--series", "--tv", action="store_true", help="series instead of movies (also: a series word in TEXT)")
    vb.add_argument("--refresh", action="store_true", help="update both indexes (new/changed/removed titles; cron)")
    vb.add_argument("--full", action="store_true", help="with --refresh: re-embed every title")
    vb.add_argument("--quiet", action="store_true", help="with --refresh: print nothing on success")
    fi = sp.add_parser("finish", help="shows he started and paused, closest to the end first")
    fi.add_argument("-n", type=int, default=FIN_N, help=f"shows (default {FIN_N}, at most {FIN_MAX})")
    fi.add_argument("--days", type=int, default=FIN_IDLE_DAYS, help=f"paused = no play for this many days ({FIN_IDLE_DAYS})")
    fi.add_argument("--json", action="store_true", help="machine-readable: message + buttons (session), text (plain, links)")
    fr = sp.add_parser("franchise", help="film series he owns with missing parts (TMDB collections) + a request poll")
    fr.add_argument("action", nargs="?", default="list", choices=["list", "request", "ignore", "unignore", "ignored"],
                    help="list (default, read-only); request TMDB_ID...; ignore/unignore COLLECTION_ID|NAME; ignored")
    fr.add_argument("items", nargs="*", help="TMDB movie ids (request) or collection ids/names (ignore, unignore)")
    fr.add_argument("--min-owned", type=int, default=2, help="series with at least this many parts on the server (2)")
    fr.add_argument("-n", type=int, default=15, help="series shown in the text list (default 15)")
    fr.add_argument("--json", action="store_true", help="machine-readable gap list")
    fr.add_argument("--poll-json", action="store_true", help="send_poll arguments: the best <= 10 gaps, multiple "
                                                             "choice; remembered for request --picked")
    fr.add_argument("--picked", action="append", default=[], metavar="TEXT",
                    help="request: poll option texts (the poll_answer's poll_options, ' | '-separated)")
    fr.add_argument("--dry-run", action="store_true", help="request: show the POSTs, send nothing")
    wr = sp.add_parser("wrapped", help="his Emby year in review: text card, --json, --html page (his plays only)")
    wr.add_argument("--year", type=int, help="the year (default: this year, so far)")
    wr.add_argument("--json", action="store_true", help="machine-readable stats + the card")
    wr.add_argument("--html", nargs="?", const="~/reports/media/emby-wrapped-{year}.html", metavar="OUT",
                    help="also write the offline story page (default ~/reports/media/emby-wrapped-YEAR.html)")
    wr.add_argument("--no-covers", action="store_true", help="with --html: no Emby cover thumbnails")
    dr = sp.add_parser("doctor", help="why a Seerr request hasn't reached Emby yet; fixes the routine cases")
    dr.add_argument("title", nargs="*", help="one title (default: every open request, like --all)")
    dr.add_argument("--all", action="store_true", help="every open Seerr request (the default without a TITLE)")
    dr.add_argument("--type", choices=["movie", "tv"])
    dr.add_argument("--mine", action="store_true", help="--all: only his own requests")
    dr.add_argument("--days", type=int, default=180, help="--all: requests of the last N days (default 180, 0 = all)")
    dr.add_argument("--dry-run", action="store_true", help="diagnose only: no fixes, no state (indexer probes still run)")
    dr.add_argument("--no-probe", action="store_true", help="no interactive indexer searches (cached results still count)")
    dr.add_argument("--grab", action="store_true", help="TITLE only: grab the best release of a name/year mismatch "
                                                        "(owner's OK)")
    dr.add_argument("-n", type=int, default=15, help="lines per group (default 15)")
    dr.add_argument("--cron", action="store_true", help="weekly cron: --all with the routine fixes, one summary line; "
                    "an ~/inbox/media-doctor-DATE.md note only when MEDIA_DOCTOR_NOTE_MIN (3)+ requests need him")
    dr.add_argument("--json", action="store_true", help="machine-readable: items, message (session), text (instant)")
    pl = sp.add_parser("play", help="staged: start an Emby item on the TV (wakes it, opens the Emby app)")
    pl.add_argument("item", metavar="ITEM_ID", help="Emby item id (a movie or an episode)")
    pl.add_argument("--target", metavar="DEVICE", help="play on this device (devices.json name or label, or the play.json "
                                                       "device); skips the bitrate choice")
    pl.add_argument("--dry-run", action="store_true", help="print the target choice and the exact calls; send nothing "
                                                           "(Emby GETs only)")
    pl.add_argument("--probe", action="store_true", help="with --dry-run: also run the plan's read-only calls live")
    pl.add_argument("--from-start", action="store_true", help="ignore the resume point")
    pl.add_argument("--no-wake", action="store_true", help="don't turn the TV on; fail if it is off")
    pl.add_argument("--json", action="store_true", help="machine-readable output")
    ps = sp.add_parser("poster", help="cached Emby poster images of item ids for picture cards (GET-only)")
    ps.add_argument("ids", nargs="+", metavar="ID", help="Emby item ids (a series id for a show's poster)")
    ps.add_argument("--width", type=int, default=400, help="max width in px (default 400)")
    ps.add_argument("--json", action="store_true", help="machine-readable output")
    po = sp.add_parser("posters", help="weekly 'Neu auf dem Server' collage PNG of what Emby added (GET-only)")
    po.add_argument("--days", type=int, default=7, help="window in days (default 7)")
    po.add_argument("--max", type=int, default=PO_MAX, help=f"posters at most (default {PO_MAX}); the rest = '+N more'")
    po.add_argument("--out", metavar="PATH", help="PNG path (default ~/reports/media/new-on-server-DATE.png)")
    po.add_argument("--cron", action="store_true", help="weekly cron: also an ~/inbox/media-posters-DATE.md note")
    po.add_argument("--json", action="store_true", help="machine-readable summary")
    dg = sp.add_parser("digest", help="daily/weekly summary card for the friends' Seerr Telegram group (off by default)")
    dgk = dg.add_mutually_exclusive_group(required=True)
    dgk.add_argument("--daily", action="store_true", help="last 24 h: new movies/episodes, fulfilled requests, most watched")
    dgk.add_argument("--weekly", action="store_true", help="last 7 days: top 5, new, library counts, changes (no storage stats)")
    dg.add_argument("--dry-run", action="store_true", help="render PNG + caption only, never post")
    dg.add_argument("--page", action="store_true", help="also publish the Telegraph page (with --dry-run: a preview; live runs follow the config's \"telegraph\")")
    dg.add_argument("--web", action="store_true", help="also publish the Mini App pages (with --dry-run: a preview; live runs follow the config's \"miniapp\")")
    dg.add_argument("--force", action="store_true", help="post again today / include requests already posted")
    dg.add_argument("--out", metavar="PATH", help="PNG path (default ~/reports/media/digest-KIND-DATE.png; caption .txt next to it)")
    dg.add_argument("--json", action="store_true", help="machine-readable summary")
    a, extra = p.parse_known_args()
    if extra and a.cmd == "franchise" and not any(x.startswith("-") for x in extra):
        a.items += extra          # ids after an option (request --dry-run 123): argparse leaves them over
    elif extra:
        p.error(f"unrecognized arguments: {' '.join(extra)}")
    if a.cmd == "search":
        a.query = " ".join(a.query)
    if a.cmd in ("status", "similar", "doctor"):
        a.title = " ".join(a.title)
    if getattr(a, "n", 1) < 1 or getattr(a, "top", 1) < 1:
        die("-n/--top must be at least 1")
    cmds = {"search": cmd_search, "request": cmd_request, "status": cmd_status, "queue": cmd_queue,
            "recent": cmd_recent, "airing": cmd_airing, "missing": cmd_missing, "cutoff": cmd_cutoff,
            "health": cmd_health, "trending": cmd_trending, "similar": cmd_similar, "hogs": cmd_hogs,
            "unwatched": cmd_unwatched, "ready-watch": cmd_ready_watch, "tonight": cmd_tonight,
            "play": cmd_play, "continue": cmd_continue, "group": cmd_group, "vibe": cmd_vibe,
            "finish": cmd_finish, "franchise": cmd_franchise, "wrapped": cmd_wrapped,
            "doctor": cmd_doctor, "posters": cmd_posters, "poster": cmd_poster,
            "digest": cmd_digest}
    try:
        cmds[a.cmd](a)
    except ApiError as e:
        die(str(e))
    except KeyboardInterrupt:
        die("interrupted", 130)


if __name__ == "__main__":
    main()
