WATCH_DAYS = 7          # chats with a followed plan up to this many days ahead are re-read when they keep talking
REFRESH_QUIET_S = 180   # ... once the chat has been quiet this long
REFRESH_WAIT_S = 900    # ... or this long after its first new message
REFRESH_GAP_S = 900     # at most one re-read per chat in this time
REFRESH_DAY_MAX = 8     # ... and this many per chat a day (each one is a vault LLM job)
REFRESH_JOBS = 2        # re-reads running at once
