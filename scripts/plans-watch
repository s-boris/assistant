REFRESH_BACK_DAYS = 2   # the re-read window starts at the plan's message day, at most this many days back
JOB_MAX_AGE_S = 1500    # the vault keeps a job's result 30 min
PLAN_MIN = 90           # a plan without an end blocks this many minutes in the clash check
REFRESH = os.environ.get('PLANS_WATCH_REFRESH', 'on') != 'off'
CATS = (('group', '👥 Group plans and invitations'), ('proposal', '❓ Proposals'), ('plan', '📅 Plans'),
        ('sale', '🎟 Ticket sales and registrations'), ('deadline', '⏰ Deadlines and to-dos'))
HOW = {
    'group': 'did he already answer? `vault ask tg --chat KEY --kind yesno "Did the owner say he joins WHAT on DATE?"`'
             ' → yes: add it; no answer: ONE question to him with buttons (📅 Add / Skip); declined: skip',
    'proposal': 'not fixed yet: ask him only if it is his to decide (buttons), else skip until it is confirmed',
    'plan': 'his own booking, appointment or trip → add it (skill calendar: location, travel legs) and tell him in one '
            'line; someone else\'s plan or a part of a trip already in the calendar → skip or enrich that event',
    'sale': 'for an artist or event he follows (rave-radar artists, his calendar)? → `remind add --owner` 15 min '
            'before; check which event, city and edition first (`vault ask gmail REF --kind short`); else skip',
    'deadline': 'his own to-do with a real date → `remind add --owner` (the morning of, or the day before); a generic '
                'notice to all users → skip',
    'updated': 'the chat changed or added details after the plan was noted (time, place, people): if I added it, fix '
               'my event (time, place, travel legs) and tell him in one line; a clash with his calendar → one line or '
               'one question with buttons (which one wins); "title unclear" → `vault ask tg --chat KEY --kind short '
               '"What is planned on DATE?"`; then ack the key again',
}

WEEKDAYS = {}                                          # word -> 0..6 (Monday 0); German, Swiss German, English, French
for _i, _words in enumerate((
        'montag montags mo mon monday mondays mäntig mäntigs lundi',
        'dienstag dienstags di tue tues tuesday tuesdays zischtig ziischtig zischtigs mardi',
        'mittwoch mittwochs mi wed weds wednesday wednesdays mittwuch mittwuch mitwuch mercredi',
        'donnerstag donnerstags do thu thur thurs thursday thursdays dunnstig donnstig dunschtig donnschtig '
        'dunnschtig donschtig jeudi',
        'freitag freitags fr fri friday fridays fritig friitig frytig vendredi',
        'samstag samstags sa sat saturday saturdays samschtig samstig samedi',
        'sonntag sonntags so sun sunday sundays sunntig sundig suntig dimanche')):
    for _w in _words.split():
        WEEKDAYS[_w] = _i
WD_RE = re.compile(r'(?i)(?<![^\W\d_])(' + '|'.join(sorted(map(re.escape, WEEKDAYS), key=len, reverse=True)) +
                   r')(?=morgen|abend|mittag|nachmittag|vormittag|nacht|znacht|morning|evening|night|[^\w]|$)')
MONTHS = {'jan': 1, 'januar': 1, 'january': 1, 'janvier': 1, 'feb': 2, 'februar': 2, 'february': 2, 'février': 2,
          'mar': 3, 'mär': 3, 'märz': 3, 'march': 3, 'mars': 3, 'apr': 4, 'april': 4, 'avril': 4, 'mai': 5, 'may': 5,
          'jun': 6, 'juni': 6, 'june': 6, 'juin': 6, 'jul': 7, 'juli': 7, 'july': 7, 'juillet': 7, 'aug': 8,
          'august': 8, 'août': 8, 'sep': 9, 'sept': 9, 'september': 9, 'septembre': 9, 'okt': 10, 'oct': 10,
          'oktober': 10, 'october': 10, 'octobre': 10, 'nov': 11, 'november': 11, 'novembre': 11, 'dez': 12,
          'dec': 12, 'dezember': 12, 'december': 12, 'décembre': 12}
EXPLICIT_RE = re.compile(r'(?i)\b\d{4}-\d{2}-\d{2}\b|\b\d{1,2}\.\s?\d{1,2}\.?(?!\d)|\b\d{1,2}\.?\s(?:' +
                         '|'.join(sorted(map(re.escape, MONTHS), key=len, reverse=True)) + r')\b|\b(?:' +
                         '|'.join(sorted(map(re.escape, MONTHS), key=len, reverse=True)) + r')\s\d{1,2}\b')
TODAY_RE = re.compile(r'(?i)(?<![^\W\d_])(heute|hüt|hut|today|tonight|heit)(?![^\W\d_])')
DAYNUM_RE = re.compile(r'(?<![\d.:])(\d{1,2})\.(?!\s?\d)')   # "6." with no month after it
SALE_RE = re.compile(r'(?i)(pre-?sale|presale|vorverkauf|general sale|on sale|ticket|pre-?regist|registration|'
                     r'early ?bird|sale\b|anmeldeschluss)')
STOP = set('''the and with from for this that your yours their them they then than have has had will would
should could must need needs about more less only also just other some these those there here which what when where
who whom whose into onto over under again every each very much many before after until during within without while
since soon later latest early earliest last next first please thanks today tomorrow tonight night time date dates day
days week weeks month year make made take done doing does going come coming back home trip plan plans event events
