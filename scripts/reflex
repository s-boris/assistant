#!/usr/local/bin/python3.13 -I
"""reflex: the brain's reflex registry v0: add | rm | revise | history | review | ls | show |
log | fire | match | counts.
`reflex --help`. The registry starts empty: the brain adds reflexes from its own traces.
Source: ~/opt/assistant (packages/loop).

Finds its libraries next to itself: deployed, ~/bin/lib/{core,loop}; in the repo, ../core and ../packages/loop.
$ASSISTANT_LIB (a directory holding core/ and loop/) overrides both. Stdlib only.
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_roots = [
    os.environ.get("ASSISTANT_LIB", ""),
    os.path.join(_here, "lib"),
    os.path.join(_here, ".."),
    os.path.join(_here, "..", "packages"),
]
for _pkg in ("core", "loop"):
    for _r in _roots:
        if _r and os.path.isfile(os.path.join(_r, _pkg, "__init__.py")):
            _r = os.path.abspath(_r)
            if _r not in sys.path:
                sys.path.insert(0, _r)
            break

if __name__ == "__main__":
    from loop import cli

    try:
        sys.exit(cli.reflex_main())
    except BrokenPipeError:  # a reader that quit early (| head)
        sys.exit(0)
