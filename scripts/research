#!/usr/bin/env python3
"""research: the mechanical parts of on-demand deep research (skill research). Token-free; nothing leaves the box.

  research new QUESTION... [--slug S] [--date YYYY-MM-DD] [--json]
        start one: picks the id YYYY-MM-DD-slug, makes ROOT/work/<id>/notes/ for the researchers' notes and a report
        skeleton ROOT/<id>.md (front matter: question, date, started; headings to fill). Prints the paths.
  research render MD [--sources JSON] [--out HTML] [--check] [--json]
        report markdown -> one self-contained, phone-friendly HTML page next to it (ROOT/<id>.html): bottom-line box,
        confidence pills, section cards, numbered citations and a deduplicated sources list. Every http(s) link in the
        body becomes a source: `([Source](URL))` / `([A](u1); [B](u2))` turn into superscript numbers, other links keep
        their text plus a number. Sources are deduplicated by normalized URL (scheme, www., tracking params, fragment,
        trailing slash) and numbered by first use. --sources = optional enrichment {"sources": [{url, title, publisher,
        date, type, note}]} (or a bare list). --check validates only. Prints JSON (paths, counts, warnings, summary).
  research summary MD      the <= 8-line Telegram summary (title, bottom line, signposts, confidence, sources, time)
  research list [-n N] [--json]   delivered reports in ROOT (date-prefixed .md), newest first

Report markdown: optional front matter between --- lines (title, question, date, started (epoch s), minutes, agents,
confidence high|medium|low, assumptions (string or "- item" list), summary ("- item" list for Telegram)); `# Title`
(if no title in front matter), the bottom-line paragraph(s) before the first `## `, then `## ` sections. Inline
confidence markers {high} {medium} {low} render as pills. Raw HTML in the markdown is escaped (web-derived text).
ROOT = $RESEARCH_DIR or ~/reports/research. Usage events: skill.research start/render (USAGE=off disables).
Exit: 0 ok, 2 usage or missing file, 3 report fails validation (no title, no cited source).
Needs markdown-it-py (~/opt/research-venv, pinned in the repo's ops/requirements/research.txt; re-execs into it).
"""
import datetime as dt
import html
import json
import os
import re
import sys
import time
import unicodedata
import urllib.parse

HOME = os.path.expanduser("~")
VENV_PY = os.environ.get("RESEARCH_VENV_PY") or os.path.join(HOME, "opt/research-venv/bin/python3")
try:
    from markdown_it import MarkdownIt
except ImportError:  # re-exec once inside the venv
    if os.path.exists(VENV_PY) and not os.environ.get("RESEARCH_REEXEC"):
        os.environ["RESEARCH_REEXEC"] = "1"
        os.execv(VENV_PY, [VENV_PY, "-I", os.path.realpath(__file__)] + sys.argv[1:])
    sys.stderr.write("research: markdown-it-py missing (rebuild ~/opt/research-venv, see ~/boot.sh)\n")
    sys.exit(2)

ROOT = os.environ.get("RESEARCH_DIR") or os.path.join(HOME, "reports/research")
ID_RE = re.compile(r"^(\d{4}-\d{2}-\d{2})-[a-z0-9][a-z0-9-]*$")
CONF = ("high", "medium", "low")
GENERIC = re.compile(r"^(source|sources|src|link|here|this|ref|reference|citation)(\s*[a-z0-9]{0,2})?$", re.I)
TRACKING = re.compile(r"^(utm_.*|fbclid|gclid|mc_[a-z]+|ref|ref_src|igshid|si|spm)$", re.I)
STOP = set("a an the for of in on to and or with from by at is are was what which who how why when where best good "
           "me my i we our you your research find look up into about vs versus please should can do does 2026".split())
def die(msg, code=2):
    sys.stderr.write(f"research: {msg}\n")
    sys.exit(code)


def log(kind, outcome=None, **attrs):
    """usage event: invoke (a research started) or run (a render; outcome ok | invalid). Never raises."""
    try:
        sys.path.insert(0, os.path.join(HOME, "bin/lib"))
        import usage
        usage.log("skill.research", kind, channel="session", outcome=outcome,
                  attrs={k: v for k, v in attrs.items() if v is not None})
    except Exception:
        pass


# ---------------------------------------------------------------- ids, front matter
def slugify(text, words=5, limit=48):
    t = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode().lower()
    toks = [w for w in re.findall(r"[a-z0-9]+", t) if w not in STOP] or re.findall(r"[a-z0-9]+", t) or ["report"]
    s = "-".join(toks[:words])[:limit].strip("-")
    return s or "report"


def parse_front(text):
    """Minimal front matter: `key: value` lines and `key:` followed by `- item` lines. Returns (meta, body)."""
    meta = {}
    if not text.startswith("---\n"):
        return meta, text
    end = text.find("\n---", 4)
    if end < 0:
        return meta, text
    block, body = text[4:end], text[end + 4:].lstrip("\n")
    key = None
    for line in block.splitlines():
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        m = re.match(r"^\s*-\s+(.*)$", line)
        if m and key:
            if not isinstance(meta.get(key), list):
                meta[key] = [] if meta.get(key) in ("", None) else [meta[key]]
            meta[key].append(m.group(1).strip().strip('"'))
            continue
        m = re.match(r"^([A-Za-z_][\w-]*)\s*:\s*(.*)$", line)
        if m:
            key = m.group(1).lower()
            meta[key] = m.group(2).strip().strip('"')
    return meta, body


def as_list(v):
    if v in (None, ""):
        return []
    return v if isinstance(v, list) else [v]


# ---------------------------------------------------------------- citations
def norm_url(u):
    try:
        p = urllib.parse.urlsplit(u.strip())
    except ValueError:
        return u.strip()
    host = (p.hostname or "").lower()
    host = host[4:] if host.startswith("www.") else host
    q = [(k, v) for k, v in urllib.parse.parse_qsl(p.query, keep_blank_values=True) if not TRACKING.match(k)]
    path = re.sub(r"/+$", "", p.path) or ""
    return f"{host}{(':' + str(p.port)) if p.port else ''}{path}" + (("?" + urllib.parse.urlencode(q)) if q else "")


def domain(u):
    h = (urllib.parse.urlsplit(u).hostname or "").lower()
    return h[4:] if h.startswith("www.") else h


class Sources:
    def __init__(self, extra=None):
        self.items, self.by_key = [], {}
        self.extra = {}
        for s in extra or []:
            if isinstance(s, dict) and str(s.get("url", "")).startswith(("http://", "https://")):
                self.extra[norm_url(s["url"])] = s

    def cite(self, url, text, section):
        k = norm_url(url)
        if k not in self.by_key:
            ex = self.extra.get(k, {})
            self.by_key[k] = len(self.items) + 1
            self.items.append({"n": len(self.items) + 1, "url": url, "key": k, "labels": [], "count": 0,
                               "sections": [], "title": ex.get("title"), "publisher": ex.get("publisher"),
                               "date": ex.get("date"), "type": ex.get("type"), "note": ex.get("note")})
        it = self.items[self.by_key[k] - 1]
        it["count"] += 1
        t = (text or "").strip()
        if t and not GENERIC.match(t) and t not in it["labels"]:
            it["labels"].append(t)
        if section and section not in it["sections"]:
            it["sections"].append(section)
        return it["n"]


LINK = r"\[((?:[^\[\]]|\[[^\]]*\])*)\]\((https?://[^\s)]+(?:\([^\s)]*\)[^\s)]*)*)\)"
GROUP_RE = re.compile(r"\(\s*" + LINK + r"(?:\s*[;,]\s*" + LINK + r")*\s*\)")
LINK_RE = re.compile(LINK)
CODE_RE = re.compile(r"(`+)(.+?)\1", re.S)


def mark(nums):
    return "⟦c:" + ",".join(str(n) for n in nums) + "⟧"


def cite_text(md, src, section):
    """Replace link citations by markers; leave code spans alone."""
    parts, last = [], 0
    for m in CODE_RE.finditer(md):
        parts.append((False, md[last:m.start()]))
        parts.append((True, m.group(0)))
        last = m.end()
    parts.append((False, md[last:]))
    out = []
    for is_code, chunk in parts:
        if is_code:
            out.append(chunk)
            continue

        def group(m):
            nums = [src.cite(u, t, section) for t, u in LINK_RE.findall(m.group(0))]
            return mark(nums)

        chunk = GROUP_RE.sub(group, chunk)
        chunk = LINK_RE.sub(lambda m: (m.group(1) if not GENERIC.match(m.group(1).strip()) else "")
                            + mark([src.cite(m.group(2), m.group(1), section)]), chunk)
        out.append(chunk)
    return "".join(out)


# ---------------------------------------------------------------- markdown -> html
def md_engine():
    return MarkdownIt("commonmark", {"html": False, "typographer": True}).enable(["table", "strikethrough"])


def post(h):
    h = re.sub(r"⟦c:([\d,]+)⟧", lambda m: '<sup class="cite">' + ",".join(
        f'<a href="#s{n}">{n}</a>' for n in m.group(1).split(",")) + "</sup>", h)
    h = re.sub(r"\{(high|medium|low)\}", lambda m: f'<span class="conf c-{m.group(1)}">{m.group(1)}</span>', h)
    h = h.replace("<table>", '<div class="tw"><table>').replace("</table>", "</table></div>")
    return h


def split_sections(body):
    """-> (title or None, lead markdown, [(heading, markdown)]); ignores # lines inside code fences."""
    title, lead, secs, cur, fence = None, [], [], None, False
    for line in body.splitlines():
        if re.match(r"^\s*(```|~~~)", line):
            fence = not fence
        if not fence and re.match(r"^# (?!#)", line) and title is None and cur is None and not "".join(lead).strip():
            title = line[2:].strip()
            continue
        if not fence and re.match(r"^## (?!#)", line):
            cur = [line[3:].strip(), []]
            secs.append(cur)
            continue
        (cur[1] if cur else lead).append(line)
    return title, "\n".join(lead).strip(), [(h, "\n".join(b).strip()) for h, b in secs]


def anchor(text, used):
    a = slugify(text, words=6, limit=40) or "s"
    a, i = ("x-" + a if a[0].isdigit() else a), 2
    base = a
    while a in used:
        a, i = f"{base}-{i}", i + 1
    used.add(a)
    return a


def plain(md):
    t = re.sub(r"⟦c:[\d,]+⟧", "", md)
    t = re.sub(r"\{(high|medium|low)\}", "", t)
    t = re.sub(r"\(\s*\)", "", t)
    t = LINK_RE.sub(lambda m: "" if GENERIC.match(m.group(1).strip()) else m.group(1), t)
    t = re.sub(r"[*_`#>]+", "", t)
    t = re.sub(r"\s+", " ", t).strip()
    return re.sub(r"\s+([.,;:!?])", r"\1", t)


def first_sentences(text, limit=230):
    sents = re.split(r"(?<=[.!?])\s+(?=[A-Z0-9])", text)
    out = ""
    for s in sents:
        if out and len(out) + len(s) + 1 > limit:
            break
        out = (out + " " + s).strip()
    return out if len(out) <= limit else out[:limit - 1].rsplit(" ", 1)[0] + "…"


SKIP_SIGNPOSTS = re.compile(r"^(conclusion|sources|references|method|how sure|confidence|assumptions|gaps|open questions)",
                            re.I)


def load(md_path, sources_path=None):
    if not os.path.isfile(md_path):
        die(f"no such report: {md_path}")
    with open(md_path, encoding="utf-8") as f:
        meta, body = parse_front(f.read())
    extra = []
    sp = sources_path or os.path.join(os.path.dirname(md_path), "work",
                                      os.path.splitext(os.path.basename(md_path))[0], "sources.json")
    if os.path.isfile(sp):
        try:
            with open(sp, encoding="utf-8") as f:
                d = json.load(f)
            extra = d.get("sources", []) if isinstance(d, dict) else d
        except (OSError, ValueError) as e:
            if sources_path:
                die(f"bad sources file {sp}: {e}")
    elif sources_path:
        die(f"no such sources file: {sources_path}")
    t, lead, secs = split_sections(body)
    title = meta.get("title") or t or ""
    src = Sources(extra)
    lead_c = cite_text(lead, src, "Bottom line")
    secs_c = [(h, cite_text(b, src, h)) for h, b in secs]
    return meta, title, lead_c, secs_c, src


def stats(meta, md_path, src, secs, lead):
    minutes = meta.get("minutes")
    if not minutes and str(meta.get("started", "")).isdigit():
        minutes = max(1, round((os.path.getmtime(md_path) - int(meta["started"])) / 60))
    conf = str(meta.get("confidence", "")).lower()
    body = lead + "".join(b for _, b in secs)
    pills = {c: len(re.findall(r"\{" + c + r"\}", body)) for c in CONF}
    return {"minutes": int(minutes) if str(minutes).isdigit() else None, "confidence": conf if conf in CONF else None,
            "agents": int(meta["agents"]) if str(meta.get("agents", "")).isdigit() else None,
            "sources": len(src.items), "domains": len({domain(s["url"]) for s in src.items}),
            "citations": sum(s["count"] for s in src.items), "sections": len(secs), "pills": pills}


def summary_text(meta, title, lead, secs, st, file_note="📄 Full report attached (opens offline)"):
    lines = [f"🔎 {plain(title)}"]
    bl = first_sentences(plain(lead)) if lead else ""
    if bl:
        lines.append(bl)
    bullets = [plain(b) for b in as_list(meta.get("summary"))][:4]
    if not bullets:
        bullets = [plain(h) for h, _ in secs if not SKIP_SIGNPOSTS.match(plain(h))][:4]
    lines += ["• " + (b if len(b) <= 110 else b[:109].rsplit(" ", 1)[0] + "…") for b in bullets]
    tail = []
    if st["confidence"]:
        tail.append(f"Confidence: {st['confidence']}")
    tail.append(f"{st['sources']} sources")
    if st["minutes"]:
        tail.append(f"{st['minutes']} min")
    lines.append(" · ".join(tail))
    if file_note:
        lines.append(file_note)
    return "\n".join(lines[:8])


# ---------------------------------------------------------------- page
CSS = """
