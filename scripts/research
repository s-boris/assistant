def esc(s):
    return html.escape(str(s if s is not None else ""))


def page(meta, title, lead, secs, src, st):
    md = md_engine()
    used = {"bottom-line", "sources", "method"}
    nav, body = [], []
    if lead:
        body.append(f'<section class="bluf" id="bottom-line"><h2>Bottom line</h2>{post(md.render(lead))}</section>')
        nav.append(('bottom-line', "Bottom line"))
    for h, b in secs:
        a = anchor(plain(h), used)
        nav.append((a, plain(h)))
        hh = post(md.renderInline(h))
        body.append(f'<section id="{a}"><h2>{hh}</h2>{post(md.render(b))}</section>')
    rows = []
    for s in src.items:
        label = s["title"] or (s["labels"][0] if s["labels"] else domain(s["url"]))
        bits = [b for b in (s["publisher"] or domain(s["url"]), s["date"], s["type"]) if b]
        cited = f"cited {s['count']}×" + (" · " + ", ".join(s["sections"][:3]) if s["sections"] else "")
        note = f" · {esc(s['note'])}" if s.get("note") else ""
        rows.append(f'<li id="s{s["n"]}"><span class="n">{s["n"]}</span><span class="st">'
                    f'<a href="{esc(s["url"])}">{esc(label)}</a><span class="d">{esc(" · ".join(bits))} · '
                    f'{esc(cited)}{note}</span></span></li>')
    body.append(f'<section id="sources"><h2>Sources ({len(src.items)})</h2>'
                f'<p class="muted sub">{st["domains"]} sites. Numbers in the text jump here; links need a connection.</p>'
                f'<ol class="src">{"".join(rows)}</ol></section>')
    nav.append(("sources", "Sources"))
    dl = []
    for k, v in (("Question", meta.get("question")), ("Assumptions", "; ".join(as_list(meta.get("assumptions")))),
                 ("Researched", meta.get("date")), ("Agents", st["agents"]),
                 ("Time", f"{st['minutes']} min" if st["minutes"] else None)):
        if v:
            dl.append(f"<dt>{esc(k)}</dt><dd>{esc(v)}</dd>")
    if dl:
        body.append(f'<section id="method"><h2>Question and method</h2><dl>{"".join(dl)}</dl></section>')
        nav.append(("method", "Method"))
    tags = []
    if st["confidence"]:
        tags.append(f'<span class="tag">Confidence <span class="conf c-{st["confidence"]}">{st["confidence"]}</span></span>')
    tags.append(f'<span class="tag">{st["sources"]} sources</span>')
    if st["minutes"]:
        tags.append(f'<span class="tag">{st["minutes"]} min</span>')
    q = f'<p class="sub">{esc(meta.get("question"))}</p>' if meta.get("question") else ""
    navh = "".join(f'<a href="#{a}">{esc(t)}</a>' for a, t in nav)
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">'
            f'<meta name="color-scheme" content="light dark"><title>{esc(plain(title))}</title><style>{CSS}</style></head>'
            f'<body><header class="wrap"><div class="eyebrow">Research · {esc(meta.get("date") or "")}</div>'
            f'<h1>{esc(plain(title))}</h1>{q}<div class="meta">{"".join(tags)}</div></header>'
            f'<nav><div class="wrap">{navh}</div></nav><main class="wrap">{"".join(body)}</main>'
            f'<footer class="wrap">Built by research render from cited web sources. Everything but the links works '
            f'offline.</footer></body></html>\n')


# ---------------------------------------------------------------- commands
def opt(args, name, default=None, flag=False):
    if name not in args:
        return default
    i = args.index(name)
    if flag:
        del args[i]
        return True
    if i + 1 >= len(args):
        die(f"{name} needs a value")
    v = args[i + 1]
    del args[i:i + 2]
    return v


def cmd_new(args):
    as_json = opt(args, "--json", False, True)
    slug = opt(args, "--slug")
    day = opt(args, "--date") or dt.date.today().isoformat()
    if not re.match(r"^\d{4}-\d{2}-\d{2}$", day):
        die("--date must be YYYY-MM-DD")
    q = " ".join(args).strip()
    if not q:
        die("usage: research new QUESTION... [--slug S] [--date YYYY-MM-DD]")
    base = f"{day}-{slugify(slug or q)}"
    rid, i = base, 2
    while os.path.exists(os.path.join(ROOT, rid + ".md")) or os.path.exists(os.path.join(ROOT, "work", rid)):
        rid, i = f"{base}-{i}", i + 1
    work = os.path.join(ROOT, "work", rid)
    os.makedirs(os.path.join(work, "notes"), exist_ok=True)
    md = os.path.join(ROOT, rid + ".md")
    qq = q.replace("\n", " ").replace('"', "'")
    with open(md, "w", encoding="utf-8") as f:
        f.write(f'---\ntitle: \nquestion: "{qq}"\ndate: {day}\nstarted: {int(time.time())}\nagents: \n'
                f"confidence: \nassumptions:\nsummary:\n---\n\n# TITLE\n\nBOTTOM LINE.\n\n## SIGNPOST 1\n\n"
                f"## How sure this is\n")
    with open(os.path.join(work, "meta.json"), "w", encoding="utf-8") as f:
        json.dump({"id": rid, "question": q, "started": int(time.time())}, f)
    out = {"id": rid, "md": md, "html": os.path.join(ROOT, rid + ".html"), "work": work,
           "notes": os.path.join(work, "notes"), "sources": os.path.join(work, "sources.json")}
    log("invoke", step="start")
    print(json.dumps(out, ensure_ascii=False) if as_json else "\n".join(f"{k}: {v}" for k, v in out.items()))


def cmd_render(args):
    as_json = opt(args, "--json", False, True)
    check = opt(args, "--check", False, True)
    sources = opt(args, "--sources")
    out = opt(args, "--out")
    if len(args) != 1:
        die("usage: research render MD [--sources JSON] [--out HTML] [--check] [--json]")
    mdp = os.path.abspath(args[0])
    meta, title, lead, secs, src = load(mdp, sources)
    st = stats(meta, mdp, src, secs, lead)
    errors, warns = [], []
    if not title or title.strip().upper() == "TITLE":
        errors.append("no title (front matter title or a # heading)")
    if not src.items:
        errors.append("no cited source (cite with ([Source](https://…)))")
    if not lead or lead.strip() == "BOTTOM LINE.":
        warns.append("no bottom line before the first ## section")
    if not st["confidence"]:
        warns.append("no overall confidence in front matter (high|medium|low)")
    if re.search(r"^##\s+(sources|references)\s*$", "\n".join("## " + h for h, _ in secs), re.I | re.M):
        warns.append("hand-written Sources section: the sources list is generated, drop it")
    for h, b in secs:
        if not b.strip():
            warns.append(f"empty section: {plain(h)}")
    html_path = os.path.abspath(out) if out else os.path.splitext(mdp)[0] + ".html"
    res = {"md": mdp, "html": None if check else html_path, "title": plain(title), **st,
           "errors": errors, "warnings": warns}
    if not errors:
        res["summary"] = summary_text(meta, title, lead, secs, st)
        if not check:
            tmp = html_path + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(page(meta, title, lead, secs, src, st))
            os.replace(tmp, html_path)
            res["bytes"] = os.path.getsize(html_path)
            log("run", "ok", step="render", sources=st["sources"], minutes=st["minutes"], sections=st["sections"],
                agents=st["agents"], conf=st["confidence"])
    elif not check:
        log("run", "invalid", step="render")
    if as_json:
        print(json.dumps(res, ensure_ascii=False, indent=1))
    else:
        for e in errors:
            print(f"ERROR {e}")
        for w in warns:
            print(f"warn  {w}")
        if not errors:
            print(("checked " if check else f"wrote {html_path} ") + f"({st['sources']} sources, {st['citations']} citations)")
    sys.exit(3 if errors else 0)


def cmd_summary(args):
    if len(args) != 1:
        die("usage: research summary MD")
    mdp = os.path.abspath(args[0])
    meta, title, lead, secs, src = load(mdp)
    if not title:
        die("no title", 3)
    print(summary_text(meta, title, lead, secs, stats(meta, mdp, src, secs, lead)))


def cmd_list(args):
    as_json = opt(args, "--json", False, True)
    n = int(opt(args, "-n", "20"))
    rows = []
    try:
        names = sorted(os.listdir(ROOT), reverse=True)
    except OSError:
        names = []
    for name in names:
        rid, ext = os.path.splitext(name)
        if ext != ".md" or not ID_RE.match(rid):
            continue
        p = os.path.join(ROOT, name)
        meta, title, lead, secs, src = load(p)
        hp = os.path.join(ROOT, rid + ".html")
        rows.append({"id": rid, "date": ID_RE.match(rid).group(1), "title": plain(title or rid),
                     "confidence": meta.get("confidence") or None, "sources": len(src.items), "md": p,
                     "html": hp if os.path.exists(hp) else None})
        if len(rows) >= n:
            break
    if as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=1))
        return
    if not rows:
        print("no research reports yet")
    for r in rows:
        print(f"{r['date']}  {r['title'][:60]}  · {r['confidence'] or '?'} · {r['sources']} src"
              f"{'' if r['html'] else ' · no html'}\n            {r['html'] or r['md']}")


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    cmd, args = argv[0], argv[1:]
    fn = {"new": cmd_new, "render": cmd_render, "summary": cmd_summary, "list": cmd_list}.get(cmd)
    if not fn:
        die(f"unknown command {cmd!r} (new, render, summary, list)")
    fn(args)


if __name__ == "__main__":
    main(sys.argv[1:])
