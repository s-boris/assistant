LLM = os.environ.get("SELF_REVIEW_LLM", f"{_BIN_REAL}/llm-local")
BIN = Path(os.environ.get("SELF_REVIEW_BIN", f"{WT}/bin"))
HARD_RULES = os.environ.get("SELF_REVIEW_HARD_RULES", "/etc/claude-code/CLAUDE.md")
EXTRA_SRC = [p for p in os.environ.get("SELF_REVIEW_EXTRA_SRC", f"{WT}/opt/claude-vault").split(":") if p]

MEM = ".claude/projects/-home-node-workspace/memory"
