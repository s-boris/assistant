@media (max-width:420px){td,th{font-size:.85rem}.price{font-size:1rem}}
@media print{.bar{display:none}section{break-inside:avoid;box-shadow:none}}
"""


def esc(s):
    return html.escape(str(s if s is not None else ""))


def money(d, x):
    return f'{d["currency"]} {x:,.0f}'.replace(",", "'")


def link_ok(u):
    return isinstance(u, str) and (u.startswith("https://") or u.startswith("http://"))


def cancel_badge(p, checked_day):
    fc = p.get("free_cancel_until")
    if not fc:
        return '<span class="b nr">non-refundable</span>'
    try:
        days = (date.fromisoformat(fc) - checked_day).days
    except ValueError:
        return f'<span class="b free">free cancel {esc(fc)}</span>'
    cls = "soon" if days <= 10 else "free"
    return f'<span class="b {cls}">free cancel to {esc(ddmm(fc))}</span>'


def render(d):
    checked_day = date.fromisoformat(d["checked_day"]) if d.get("checked_day") else date.today()
    plans, rs, ppl = d["plans"], routes(d), max(int(d["people"]), 1)
    chips = "".join(f'<button class="chip" data-plan="{esc(p["id"])}" aria-pressed="{"true" if i == 0 else "false"}">'
                    f'{esc(p.get("short") or p["label"])}</button>' for i, p in enumerate(plans))
    chips += '<span style="width:10px;flex:none"></span>' + "".join(
        f'<button class="chip" data-style="{esc(s["id"])}" aria-pressed="false">{esc(s.get("emoji", ""))} {esc(s["label"])}</button>'
        for s in d["styles"])
    out = []
    dec = ""
    if d.get("decision") or d.get("book_by"):
        dec = '<section class="decide"><h2>The decision</h2>'
        if d.get("decision"):
            dec += f'<p><b>{esc(d["decision"])}</b></p>'
        if d.get("book_by"):
            dec += f'<p>Book by <b>{esc(ddmm(d["book_by"]))}</b>{" · " + esc(d["book_by_why"]) if d.get("book_by_why") else ""}</p>'
        for x in d.get("advice") or []:
            dec += f"<p>{esc(x)}</p>"
        dec += "</section>"
    out.append(dec)
    for p in plans:
        combos = [r for r in rs if r["plan"] == p["id"] and r["style"] == "mix" and r["why"] and not r["missing"]]
        if not combos:
            continue
        cards = ""
        for r in combos:
            fc = (cancel_badge({"free_cancel_until": r["free_cancel_until"]}, checked_day) if r["all_free"]
                  else '<span class="b nr">has a non-refundable part</span>')
            rec_badge = '<span class="b pk">★ recommended</span>'
            items = ""
            for lg in r["legs"]:
                nm = (f'<a href="{esc(lg["url"])}">{esc(lg["name"])}</a>' if link_ok(lg.get("url")) else esc(lg["name"]))
                why = r["why"].get(lg["stop"])
                items += (f'<li><b>{esc(stop_name(d, lg["stop"]).split(" ·")[0])} · {esc(lg["nights"])} n</b> · {nm} · '
                          f'{money(d, lg["total"])}{"<div class=muted>" + esc(why) + "</div>" if why else ""}</li>')
            cards += (f'<div class="combo{" rec" if r["recommended"] else ""}"><div class="top"><h3>{esc(r["label"])}</h3>'
                      f'<div class="price">{money(d, r["pp"])}<span class="pp">p.p. · {money(d, r["total"])} total</span></div></div>'
                      f'{"<p class=meta>" + esc(r["note"]) + "</p>" if r["note"] else ""}<ol class="legs">{items}</ol>'
                      f'<div class="badges">{fc}{rec_badge if r["recommended"] else ""}</div></div>')
        out.append(f'<section data-plan-sec="{esc(p["id"])}"><h2>Combos · {esc(p["label"])}</h2>{cards}</section>')
    for p in plans:
        legs = " → ".join(f'{esc(stop_name(d, lg["stop"]).split(" ·")[0])} {nights(lg)} n ({esc(ddmm(lg["from"]))})'
                          for lg in p["legs"])
        rows = ""
        for r in [r for r in rs if r["plan"] == p["id"]]:
            if r["missing"]:
                rows += (f'<tr><td>{esc(r["label"])}</td><td class="muted" colspan="3">no priced option for '
                         f'{esc(", ".join(stop_name(d, m) for m in r["missing"]))}</td></tr>')
                continue
            fc = (f'free to {esc(ddmm(r["free_cancel_until"]))}' if r["all_free"] else "has non-refundable part")
            rows += (f'<tr><td><b>{esc(r["label"])}</b><div class="muted">{esc(" + ".join(r["options"]))}</div></td>'
                     f'<td class="n">{money(d, r["total"])}</td><td class="n"><b>{money(d, r["pp"])}</b></td>'
                     f'<td class="muted">{fc}</td></tr>')
        out.append(f'<section data-plan-sec="{esc(p["id"])}"><h2>Route totals · {esc(p["label"])}</h2>'
                   f'<p class="muted">{legs}</p><table><tr><th>Route</th><th>Total</th><th>Per person</th>'
                   f'<th>Cancel</th></tr>{rows}</table></section>')
    for st in d["stops"]:
        opts = [o for o in d["options"] if o["stop"] == st["id"]]
        body = ""
        for s in d["styles"]:
            group = [o for o in opts if o.get("style") == s["id"]]
            if not group:
                continue
            group.sort(key=lambda o: (not o.get("pick"), (price(o, plans[0]["id"]) or {"total": 1e9})["total"]))
            cards = ""
            for o in group:
                pr = ""
                for p in plans:
                    leg = next((lg for lg in p["legs"] if lg["stop"] == st["id"]), None)
                    x = price(o, p["id"])
                    n = nights(leg) if leg else None
                    if x:
                        ppn = f'{money(d, x["total"] / ppl / n)} p.p./night' if n else ""
                        pr += (f'<div class="price" data-plan="{esc(p["id"])}">{money(d, x["total"])}'
                               f'<span class="pp">{ppn}</span></div>')
                    else:
                        pr += f'<div class="price" data-plan="{esc(p["id"])}"><span class="pp">no price for these dates</span></div>'
                badges = ""
                for p in plans:
                    x = price(o, p["id"])
                    badges += f'<span data-plan="{esc(p["id"])}">{cancel_badge(x, checked_day) if x else ""}</span>'
                if o.get("pick"):
                    badges += '<span class="b pk">★ pick</span>'
                if o.get("breakfast"):
                    badges += '<span class="b">breakfast</span>'
                if o.get("rating"):
                    badges += f'<span class="b">{esc(o["rating"])}{" (" + esc(o["reviews"]) + ")" if o.get("reviews") else ""}</span>'
                dist = []
                for kind, lab in (("jetty", "⛴"), ("dive", "🤿")):
                    nb = nearest(d, o, kind)
                    if nb:
                        dist.append(f"{lab} {esc(nb[1])} {fmt_km(nb[0])}")
                if o.get("area_note"):
                    dist.append(esc(o["area_note"]))
                name = (f'<a href="{esc(o["url"])}">{esc(o["name"])}</a>' if link_ok(o.get("url")) else esc(o["name"]))
                notes = "".join(f'<p class="meta" data-plan="{esc(p["id"])}">{esc(price(o, p["id"])["note"])}</p>'
                                for p in plans if price(o, p["id"]) and price(o, p["id"]).get("note"))
                cards += (f'<div class="card{" pick" if o.get("pick") else ""}" data-style="{esc(s["id"])}">'
                          f'<div class="top"><div><h3>{name}</h3><p class="meta">{esc(o.get("type") or "")}'
                          f'{" · " + esc(o["beds"]) if o.get("beds") else ""}</p></div>{pr}</div>'
                          f'<p class="meta">{" · ".join(dist)}</p>'
                          f'{"<p class=meta>" + esc(o["notes"]) + "</p>" if o.get("notes") else ""}{notes}'
                          f'<div class="badges">{badges}</div></div>')
            body += (f'<div data-style-group="{esc(s["id"])}"><div class="style-h">{esc(s.get("emoji", ""))} '
                     f'{esc(s["label"])} · {esc(s.get("blurb", ""))}</div><div class="cards">{cards}</div></div>')
        legs = " · ".join(f'{esc(p.get("short") or p["id"])}: {esc(ddmm(lg["from"]))}–{esc(ddmm(lg["to"]))}'
                          for p in plans for lg in p["legs"] if lg["stop"] == st["id"])
        out.append(f'<section><h2>{esc(st["name"])}</h2><p class="muted">{legs}</p>{body}</section>')
    gone = [x for x in d.get("unavailable") or [] if isinstance(x, dict) and x.get("name")]
    if gone:
        out.append('<section class="gone"><h2>Checked, not available</h2><ul>' + "".join(
            f'<li>{esc(x["name"])} · {esc(stop_name(d, x.get("stop", "")))}{" · " + esc(x["note"]) if x.get("note") else ""}</li>'
            for x in gone) + "</ul></section>")
    for x in d.get("footnotes") or []:
        out.append(f'<p class="muted">{esc(x)}</p>')
    js = """<script>(function(){var plan=null,style=null;
function q(s){return document.querySelectorAll(s)}
function apply(){q('[data-plan]').forEach(function(e){if(e.tagName!=='BUTTON')e.hidden=(e.dataset.plan!==plan)});
q('[data-plan-sec]').forEach(function(e){e.hidden=(e.dataset.planSec!==plan)});
q('[data-style-group]').forEach(function(e){e.hidden=!!style&&e.dataset.styleGroup!==style});
q('button[data-plan]').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.plan===plan)});
q('button[data-style]').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.style===style)});
try{localStorage.setItem('stay-compare',JSON.stringify({plan:plan,style:style}))}catch(e){}}
var first=document.querySelector('button[data-plan]');plan=first?first.dataset.plan:null;
try{var s=JSON.parse(localStorage.getItem('stay-compare')||'{}');if(s.plan&&document.querySelector('button[data-plan="'+s.plan+'"]'))plan=s.plan;style=s.style||null}catch(e){}
q('button[data-plan]').forEach(function(b){b.onclick=function(){plan=b.dataset.plan;apply()}});
q('button[data-style]').forEach(function(b){b.onclick=function(){style=(style===b.dataset.style)?null:b.dataset.style;apply()}});
apply()})();</script>"""
    title = f'{d.get("trip", "Trip")} stays'
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" '
            f'content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light dark">'
            f'<title>{esc(title)}</title><style>{CSS}</style></head><body><header class="wrap">'
            f'<div class="eyebrow">Stay planner · {esc(d["people"])} people · nothing booked</div>'
            f'<h1>{esc(d.get("emoji", ""))} {esc(title)}</h1><p class="sub">{esc(d.get("subtitle") or "")}</p>'
            f'<p class="muted">Prices checked {esc(d.get("checked") or "")}. {esc(d.get("source_note") or "")}</p></header>'
            f'<div class="bar"><div class="wrap chips">{chips}</div></div><main class="wrap">{"".join(out)}</main>'
            f'<footer class="wrap">Made by stay-compare. Distances are straight lines. Prices move: re-check before booking. '
            f'Works offline; links need a connection.</footer>{js}</body></html>\n')


def section(d):
    plan = d["plans"][0]
    rs = [r for r in routes(d) if r["plan"] == plan["id"] and not r["missing"]]
    groups = []
    for st in d["stops"]:
        rows = []
        for s in d["styles"]:
            for o in sorted([o for o in d["options"] if o["stop"] == st["id"] and o.get("style") == s["id"]],
                            key=lambda o: (not o.get("pick"), (price(o, plan["id"]) or {"total": 1e9})["total"])):
                p = price(o, plan["id"])
                if not p:
                    continue
                nb = [f"{lab} {fmt_km(x[0])}" for kind, lab in (("jetty", "⛴"), ("dive", "🤿")) for x in [nearest(d, o, kind)] if x]
                rows.append([f'{"★ " if o.get("pick") else ""}{o["name"]}', s.get("emoji", s["id"]),
                             money(d, p["total"]),
                             ("free to " + ddmm(p["free_cancel_until"])) if p.get("free_cancel_until") else "non-refundable",
                             " ".join(nb)])
        if rows:
            links = [[o["name"], o["url"]] for o in d["options"]
                     if o["stop"] == st["id"] and (o.get("pick") and link_ok(o.get("url")))]
            groups.append({"title": st["name"], "table": {"head": ["Stay", "", plan.get("short") or "Total", "Cancel", "Distance"],
                                                          "rows": rows}, "links": links})
    return {"id": "stays", "title": "Stays shortlist",
            "intro": f'{plan["label"]}. Nothing booked; prices checked {d.get("checked", "")}.',
            "rows": [[r["label"], f'{money(d, r["pp"])} p.p. · ' + " + ".join(r["options"])] for r in rs],
            "note": d.get("decision") and f'Open: {d["decision"]}', "groups": groups}


def main(argv):
    a = argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if a else 1
    cmd, rest = a[0], a[1:]
    out = None
    if "--out" in rest:
        i = rest.index("--out")
        if i + 1 >= len(rest):
            print("stay-compare: --out needs a file", file=sys.stderr)
            return 1
        out = rest[i + 1]
        rest = rest[:i] + rest[i + 2:]
    if cmd not in ("render", "summary", "section", "routes") or len(rest) != 1:
        print("stay-compare: render|summary|section|routes DATA.json [--out FILE] (--help)", file=sys.stderr)
        return 1
    try:
        d = load(rest[0])
    except Bad as e:
        print(f"stay-compare: {e}", file=sys.stderr)
        return 1
    if cmd == "summary":
        text = "\n".join(summary(d)) + "\n"
    elif cmd == "routes":
        text = json.dumps(routes(d), ensure_ascii=False, indent=1) + "\n"
    elif cmd == "section":
        text = json.dumps(section(d), ensure_ascii=False, indent=1) + "\n"
    else:
        text = render(d)
    if out:
        out = os.path.expanduser(out)
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        with open(out + ".tmp", "w") as f:
            f.write(text)
        os.replace(out + ".tmp", out)
        print(f"stay-compare: {cmd} -> {out} ({os.path.getsize(out) // 1024} KB)")
    else:
        sys.stdout.write(text)
    try:
        import usage
        usage.log("bin.stay-compare", "exec", outcome="ok", attrs={"cmd": cmd, "options": len(d["options"])})
    except Exception:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
