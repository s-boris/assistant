a{color:var(--accent);text-underline-offset:3px;overflow-wrap:anywhere}
.wrap{max-width:820px;margin:0 auto;padding:0 16px}
header{padding:26px 0 8px}.eyebrow{font-family:var(--f-mono);font-size:.75rem;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-2)}
