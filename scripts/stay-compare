--accent-tint:#173331;--warm:#f0a46c;--warm-tint:#3a2618;--bad:#f08a8a;--bad-tint:#3a1c1c;--ok:#7ccf8a;--shade:rgba(0,0,0,.35);color-scheme:dark}
*,*::before,*::after{box-sizing:border-box}
