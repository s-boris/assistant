#!/usr/bin/env python3
"""stay-compare: compare accommodation shortlists for a multi-stop trip (styles x stops x date plans).

usage:
  stay-compare render DATA.json [--out FILE]   offline, phone-sized HTML comparison page (light + dark)
  stay-compare summary DATA.json               Telegram-ready summary, <= 8 short lines
  stay-compare section DATA.json [--out FILE]  a trip-pack extras section (JSON) with the shortlist per stop
  stay-compare routes DATA.json                route totals per plan as JSON

DATA (written by hand or by a research agent; trip values live with the data, never here):
  {"trip", "people", "currency", "checked" (text), "book_by" (YYYY-MM-DD), "decision" (question text),
   "plans": [{"id", "label", "legs": [{"stop", "from", "to"}]}]   first plan = primary,
   "stops": [{"id", "name"}],
   "poi": {"<stop id>": [{"name", "kind": "jetty|dive|other", "lat", "lon"}]},
   "styles": [{"id", "label", "emoji", "blurb"}]   (default villa / resort / guesthouse),
   "routes": [{"label", "picks": {"<stop id>": "<style id>"}, "why": {"<stop id>": text}, "note", "recommended"}]
             extra mixed routes; a route with "why" also gets a combo card (per-stop reasons) on the page,
   "style_routes": false   hide the pure one-style routes (default: shown first),
   "options": [{"stop", "style", "name", "url", "type", "beds", "rating", "reviews", "lat", "lon", "breakfast",
                "pick" (bool: preferred in its stop+style), "notes",
                "prices": {"<plan id>": {"total", "free_cancel_until" (YYYY-MM-DD|null), "note"}}}]}
Route totals: per plan, per style, the pick (else the cheapest priced option with free cancellation, else the
cheapest) in each stop; p.p. = total / people. Distances: straight line to the stop's nearest jetty and dive
centre (haversine), "~" because roads are longer.
exit: 0 ok, 1 bad arguments or unreadable data. Logs one usage event per run (bin.stay-compare; USAGE=off).
"""
import html, json, math, os, sys
from datetime import date

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

DEFAULT_STYLES = [{"id": "villa", "label": "Villa / apartment", "emoji": "🏡", "blurb": "own rooms + kitchen"},
                  {"id": "resort", "label": "Resort / hotel", "emoji": "🏨", "blurb": "beach, service, breakfast"},
                  {"id": "guesthouse", "label": "Guesthouse", "emoji": "🛏", "blurb": "small, local, breakfast"}]


class Bad(Exception):
    pass


def load(path):
    try:
        with open(os.path.expanduser(path)) as f:
            d = json.load(f)
    except (OSError, ValueError) as e:
        raise Bad(f"cannot read {path}: {type(e).__name__}")
    if not isinstance(d, dict) or not d.get("plans") or not d.get("stops") or not isinstance(d.get("options"), list):
        raise Bad("data needs plans, stops and options")
    d.setdefault("people", 1)
    d.setdefault("currency", "CHF")
    d["styles"] = d.get("styles") or DEFAULT_STYLES
    d["options"] = [o for o in d["options"] if isinstance(o, dict) and o.get("name") and o.get("stop")]
    return d


def km(a, b):
    try:
        la1, lo1, la2, lo2 = (math.radians(float(x)) for x in (a["lat"], a["lon"], b["lat"], b["lon"]))
    except (KeyError, TypeError, ValueError):
        return None
    h = math.sin((la2 - la1) / 2) ** 2 + math.cos(la1) * math.cos(la2) * math.sin((lo2 - lo1) / 2) ** 2
    return 6371 * 2 * math.asin(math.sqrt(h))


def nearest(d, o, kind):
    best = None
    for p in (d.get("poi") or {}).get(o["stop"]) or []:
        if p.get("kind") == kind:
            k = km(o, p)
            if k is not None and (best is None or k < best[0]):
                best = (k, p["name"])
    return best


def fmt_km(x):
    return f"~{x * 1000:.0f} m" if x < 1 else f"~{x:.1f} km"


def nights(leg):
    try:
        return (date.fromisoformat(leg["to"]) - date.fromisoformat(leg["from"])).days
    except (KeyError, TypeError, ValueError):
        return None


def price(o, plan):
    p = (o.get("prices") or {}).get(plan)
    return p if isinstance(p, dict) and isinstance(p.get("total"), (int, float)) else None


def choose(d, stop, style, plan):
    """The option a route uses: the pick, else the cheapest free-cancel option, else the cheapest; priced only."""
    cands = [o for o in d["options"] if o["stop"] == stop and o.get("style") == style and price(o, plan)]
    if not cands:
        return None
    picks = [o for o in cands if o.get("pick")]
    if picks:
        return picks[0]
    free = [o for o in cands if price(o, plan).get("free_cancel_until")]
    return min(free or cands, key=lambda o: price(o, plan)["total"])


def routes(d):
    out = []
    specs = [] if d.get("style_routes") is False else [
        {"label": f'{s.get("emoji", "")} {s["label"]}'.strip(), "style": s["id"],
         "picks": {st["id"]: s["id"] for st in d["stops"]}} for s in d["styles"]]
    specs += [dict(r, style="mix") for r in d.get("routes") or [] if isinstance(r, dict) and r.get("picks")]
    for plan in d["plans"]:
        for spec in specs:
            total, parts, cancel, missing, legs = 0, [], [], [], []
            for leg in plan.get("legs") or []:
                o = choose(d, leg["stop"], spec["picks"].get(leg["stop"]), plan["id"])
                if not o:
                    missing.append(leg["stop"])
                    continue
                p = price(o, plan["id"])
                total += p["total"]
                parts.append(o["name"])
                cancel.append(p.get("free_cancel_until"))
                legs.append({"stop": leg["stop"], "nights": nights(leg), "name": o["name"], "url": o.get("url"),
                             "total": round(p["total"]), "free_cancel_until": p.get("free_cancel_until")})
            n = sum(nights(lg) or 0 for lg in plan.get("legs") or [])
            ppl = max(int(d["people"]), 1)
            out.append({"plan": plan["id"], "label": spec["label"], "style": spec["style"], "picks": spec["picks"],
                        "total": round(total), "pp": round(total / ppl), "pp_night": round(total / ppl / n) if n else None,
                        "options": parts, "missing": missing, "legs": legs,
                        "why": spec.get("why") if isinstance(spec.get("why"), dict) else {},
                        "note": spec.get("note") or "", "recommended": bool(spec.get("recommended")),
                        "free_cancel_until": None if (None in cancel or not cancel) else min(cancel),
                        "all_free": bool(cancel) and None not in cancel})
    return out


def stop_name(d, sid):
    return next((s["name"] for s in d["stops"] if s["id"] == sid), sid)


def ddmm(s):
    try:
        x = date.fromisoformat(s)
        return f"{x.day:02d}.{x.month:02d}"
    except (TypeError, ValueError):
        return s or ""


def summary(d):
    plan = d["plans"][0]
    rs = [r for r in routes(d) if r["plan"] == plan["id"]]
    cur, lines = d["currency"], []
    legs = " · ".join(f'{stop_name(d, lg["stop"]).split(" ·")[0]} {nights(lg)}' for lg in plan["legs"])
    lines.append(f'{d.get("emoji", "🧳")} {d.get("trip", "Trip")} stays · {d["people"]} people · {legs} nights')
    for r in rs[:4]:
        if r["missing"]:
            continue
        lines.append(f'{r["label"]}: ~{cur} {r["pp"]:,} p.p. ({" + ".join(r["options"])})'.replace(",", "'"))
    free = [r for r in rs if r["all_free"]]
    if free:
        first = min(r["free_cancel_until"] for r in free)
        lines.append(f"All routes above cancel free; earliest deadline {ddmm(first)}")
    if d.get("book_by"):
        lines.append(f'Book by {ddmm(d["book_by"])}' + (f' ({d["book_by_why"]})' if d.get("book_by_why") else ""))
    if d.get("decision"):
        lines.append(f'Your call: {d["decision"]}')
    return lines[:8]


CSS = """
:root{--ground:#f4f1ea;--paper:#fffdf8;--ink:#1c2430;--ink-2:#5a6472;--line:#ddd7cb;--accent:#0f6b6b;--accent-tint:#dcefed;
--warm:#a5521b;--warm-tint:#f7e6d9;--bad:#a12a2a;--bad-tint:#f6dede;--ok:#2f7a3d;--shade:rgba(28,36,48,.06);
--f-body:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--f-mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--ground:#10161b;--paper:#172027;--ink:#e5eaee;--ink-2:#98a4b1;
--line:#28333d;--accent:#6cc5c0;--accent-tint:#173331;--warm:#f0a46c;--warm-tint:#3a2618;--bad:#f08a8a;--bad-tint:#3a1c1c;--ok:#7ccf8a;
--shade:rgba(0,0,0,.35);color-scheme:dark}}
