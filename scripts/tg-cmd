def redact(text):
    try:
        sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
        import secretscan
        return secretscan.redact(text)
    except Exception:
        return text


def finish(text):
    text = redact(text.strip())
    if len(text) > MAX_CHARS:
        text = text[: MAX_CHARS - 2].rstrip() + "\n…"
    print(text)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if len(argv) == 2 else 2
    name, args = argv[1], argv[2:]
    if args and (name.lstrip("/") not in ARGS or len(args) > 1):
        what = "take one argument at most" if name.lstrip("/") in ARGS else "take no arguments"
        print(f"tg-cmd: commands {what}; got {' '.join(argv[1:])!r}", file=sys.stderr)
        return 2
    if name == "--list":
        for n, (desc, _) in COMMANDS.items():
            print(f"/{n:<10} {desc}")
        return 0
    if name.lstrip("/") not in COMMANDS:
        print(f"tg-cmd: unknown command {name!r} (known: {', '.join(COMMANDS)})", file=sys.stderr)
        return 2
    name = name.lstrip("/")
    try:
        if pictures_on() and name in PICTURES:
            picture(name, *args)
        else:
            finish(COMMANDS[name][1](*args))
        return 0
    except Fail as e:
        finish(f"⚠️ /{name} failed: {e}.\nAsk me in a normal message (\"{FALLBACK_HINT[name]}?\") and I'll look.")
    except Exception as e:  # a bug here must still give the owner a sensible answer
        finish(f"⚠️ /{name} failed ({type(e).__name__}).\nAsk me in a normal message (\"{FALLBACK_HINT[name]}?\") and I'll look.")
    return 3


EXIT_OUTCOME = {0: "ok", 2: "usage", 3: "fail"}   # 2 = usage hint (not a failure); 3 = the owner got a "⚠️ failed"


def _usage_log(argv, rc, t0):
    """One usage-store exec record per command run (`usage`: latency, outcome, caller channel, actor: owner only when
    the plugin / voice relay / app ran it; agent = a Claude session or subagent; test = TG_CMD_TEST/USAGE_TEST set);
    never fails."""
    try:
        name = argv[1].lstrip("/") if len(argv) > 1 else ""
        if name not in COMMANDS or os.environ.get("TG_CMD_NOW") or os.environ.get("TG_CMD_BIN"):   # tests: no record
            return
        sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))
        import usage
        ch = usage.caller_channel()
        usage.log("tg." + name, "exec", channel=ch, actor=usage.caller_actor(ch), ms=(_time.time() - t0) * 1000,
                  outcome=EXIT_OUTCOME.get(rc, "error"),
                  attrs={"args": len(argv) > 2, "picture": bool(pictures_on() and name in PICTURES), "rc": rc})
    except Exception:
        pass


if __name__ == "__main__":
    import time as _time
    _t0 = _time.time()
    _rc = main(sys.argv)
    _usage_log(sys.argv, _rc, _t0)
    sys.exit(_rc)
