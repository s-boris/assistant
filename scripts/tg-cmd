        return PARTY_HINT
    code, out, err = run(["party", verb], 18, "Party lights", full=True)
    if code not in (0, 1) or not out.strip():
        last = next((l for l in reversed(err.strip().splitlines()) if l.strip()), "")
        raise Fail(f"Party lights: {last.strip()[:120] or f'exit {code}'}")
    return out


