def cmd_gohome(arg=None):
    """`gohome [STOP]`: its own card (<= 8 lines, read-only: transport API, calcache, `vault ha now`)."""
    return run(["gohome", *([arg] if arg else [])], 18, "way home")


def load_json_file(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def span(a, b):
    """'21–27.11', '27.11–1.12', '30.12.2026–2.1.2027'."""
    if a.year != b.year:
        return f"{a.day}.{a.month}.{a.year}–{b.day}.{b.month}.{b.year}"
    return f"{a.day}–{b.day}.{b.month}" if a.month == b.month else f"{a.day}.{a.month}–{b.day}.{b.month}"


def load_trips():
    """Trips from trip-conditions' trips.json, pretrip-check's trip.json and the optional tg-cmd trips.json, merged
    by name: [{name, emoji, from, to (dates), legs [str], match [str], todo [str], link, pack (path)}]."""
    trips = {}

    def add(name, start, end, emoji=None, legs=(), match=(), todo=(), link=None, pack=None):
        if not name:
            return
        try:
            start, end = date.fromisoformat(str(start)), date.fromisoformat(str(end or start))
        except ValueError:
            if name.lower() not in trips:                   # dates may be left out only to add to a known trip
                return
            start = end = None
        t = trips.setdefault(name.lower(), {"name": name, "emoji": None, "from": start, "to": end, "legs": [],
                                            "match": [name], "todo": [], "link": None, "pack": None})
        t["emoji"] = t["emoji"] or emoji
        t["link"] = t["link"] or link
        t["pack"] = t["pack"] or (pack if isinstance(pack, str) and pack else None)
        for k, v in (("legs", legs), ("match", match), ("todo", todo)):
            t[k] += [x for x in v if isinstance(x, str) and x and x not in t[k]]

    for t in (load_json_file(TRIP_CONDITIONS, {}).get("trips") or {}).values():
        if not isinstance(t, dict):
            continue
        stays = []
        for l in t.get("legs") or []:
            try:
                stays.append(f"{l['name']} {span(date.fromisoformat(l['from']), date.fromisoformat(l['to']))}")
            except (KeyError, TypeError, ValueError):
                pass
        add(t.get("name"), t.get("from"), t.get("to"), t.get("emoji"), ["🏝 " + " › ".join(stays)] if stays else [])
    p = load_json_file(PRETRIP, {})
    if isinstance(p, dict):
        add(p.get("name"), p.get("from"), p.get("until"), legs=["✈️ " + x for x in p.get("legs") or [] if isinstance(x, str)])
    x = load_json_file(TRIPS_EXTRA, {})
    for t in (x.get("trips") if isinstance(x, dict) else x) or []:
        if isinstance(t, dict):
            add(t.get("name"), t.get("from"), t.get("to"), t.get("emoji"), t.get("legs") or [], t.get("match") or [],
                t.get("todo") or [], t.get("link"), t.get("pack"))
    return sorted(trips.values(), key=lambda t: (t["from"], t["to"]))


def trip_matches(t, text):
    low = text.lower()
    return any(m.lower() in low for m in t["match"]) or bool(t["emoji"] and t["emoji"] in text)


def owner_reminders():
    out = []
    for l in run(["remind", "list"], 6, "reminders").splitlines():
        m = REM_RE.match(l)
        if m and m.group(2):
            text = re.sub(r"  \((?:tag [^)]*|every [^)]*)\)$", "", m.group(3))
            out.append((datetime.strptime(m.group(1), "%Y-%m-%d %H:%M"), text))
    return out


def waiting_on_owner():
    """TODO.md "Waiting on you" titles + the status before any '(' (the board's internal notes stay out)."""
    try:
        with open(TODO_MD) as f:
            text = f.read()
    except OSError:
        return []
    m = re.search(r"^## Waiting on you\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    out = []
    for l in (m.group(1).splitlines() if m else []):
        i = re.match(r"^- \*\*(.+?)\*\*(?:\s*[—–-]\s*(.*))?$", l)
        if i:
            out.append(i.group(1) + (": " + i.group(2).split("(")[0].strip(" ;,") if i.group(2) else ""))
    return out


def trip_head(t):
    today, nights = now().date(), (t["to"] - t["from"]).days
    when = f"{t['from']:%a} {span(t['from'], t['to'])}" if nights else day_txt(t["from"])
    if t["from"] > today:
        n = (t["from"] - today).days
        rel = "tomorrow" if n == 1 else f"in {n} days"
    elif today == t["to"] and nights:
        rel = "last day"
    else:
        rel = f"day {(today - t['from']).days + 1} of {nights + 1}" if nights else "today"
    return f"{t['emoji'] or '🧳'} {t['name']} · {when}" + (f" ({nights} nights)" if nights > 1 else "") + f" · {rel}"


def trip_pack_line(t):
    """'📦 Offline pack 24 KB (20.10) · "send the pack" → ~/reports/…' when the trip's pack file exists, else None."""
    if not t.get("pack"):
        return None
    path = os.path.expanduser(t["pack"])
    try:
        st = os.stat(path)
    except OSError:
        return None
    home = os.path.expanduser("~")
    shown = "~" + path[len(home):] if path.startswith(home + "/") else path
    return (f"📦 Offline pack {max(1, round(st.st_size / 1024))} KB ({datetime.fromtimestamp(st.st_mtime):%d.%m})"
            f" · “send the pack” → {shown}")


def trip_list(trips):
    rows = [f"{t['emoji'] or '🧳'} {t['name']} · "
            + (span(t['from'], t['to']) if t['to'] > t['from'] else f"{t['from'].day}.{t['from'].month}")
            + (f" · in {(t['from'] - now().date()).days} d" if t["from"] > now().date() else " · now")
            + (" 📦" if trip_pack_line(t) else "") for t in trips]
    more = [f"+ {len(rows) - 8} more"] if len(rows) > 8 else []
    return "\n".join([f"🧳 Trips ahead ({len(rows)})"] + rows[:8] + more + ["/trip WORDS shows one"])


def trip_select(arg=None):
    """(answer, trip, trips ahead, query): answer = a text-only reply (no trip, the list, an unknown name), else None."""
    today = now().date()
    trips = [t for t in load_trips() if t["to"] >= today]
    if not trips:
        return "🧳 No trip planned.", None, trips, ""
    q = (arg or "").strip().lower().lstrip("/")
    if q in ("list", "all", "trips"):
        return trip_list(trips), None, trips, q
    if q:
        pick = next((t for t in trips if q in t["name"].lower()), None) or \
            next((t for t in trips if any(q in m.lower() or (len(m) >= 4 and m.lower() in q) for m in t["match"])), None)
        if not pick:
            return f"🧳 No trip ahead called “{clip(arg.strip(), 30)}”.\n/trip list shows them.", None, trips, q
        trips = [pick] + [x for x in trips if x is not pick]
    return None, trips[0], trips, q


def cmd_trip(arg=None):
    answer, t, trips, q = trip_select(arg)
    return answer or trip_text(t, trips, q)


def trip_text(t, trips, q):
    pack = trip_pack_line(t)
    lines = [trip_head(t)] + t["legs"][:3]
    try:
        trains = [g for g in legs_ahead() if t["from"] <= g["_dep"].date() <= t["to"] + timedelta(days=1)]
    except Fail:
        trains = []
    lines += ["🚆 " + leg_line(g) for g in trains[:2]]
    todos = [f"☐ {clip(x, 70)}" for x in t["todo"]]
    todos += [f"☐ {clip(x, 70)}" for x in waiting_on_owner() if trip_matches(t, x)]
    try:
        rem = owner_reminders()
    except Fail:
        rem = []
    for at, text in rem:
        if at.date() <= t["to"] and trip_matches(t, text):
            text = re.sub(r"^\W*" + re.escape(t["name"]) + r"\W*:\s*", "", text, flags=re.I) or text
            todos.append(f"☐ {at:%d.%m} {short_title(text)}")
    room = 10 - len(lines) - (1 if t["link"] else 0) - (1 if pack else 0) - (1 if todos else 0)
    if todos:
        lines.append("Open:")
        if len(todos) > room:
            todos = todos[: room - 1] + [f"+ {len(todos) - room + 1} more (ask me)"]
        lines += todos
    elif not t["link"]:
        lines.append("Nothing open.")
    if t["link"]:
        lines.append(f"🗺 {t['link']}")
    if pack:
        lines.append(pack)
    if len(trips) > 1 and len(lines) < 10 and not q:
        lines.append(f"Then: {trips[1]['emoji'] or '🧳'} {trips[1]['name']} {span(trips[1]['from'], trips[1]['to'])}"
                     + (" · 📦 pack ready" if trip_pack_line(trips[1]) else ""))
    return "\n".join(lines)


def trip_conf(t):
    """(key, trip) from trip-conditions' config with t's name (its place legs), else (None, None)."""
    for k, v in (load_json_file(TRIP_CONDITIONS, {}).get("trips") or {}).items():
        if isinstance(v, dict) and str(v.get("name") or "").lower() == t["name"].lower():
            return k, v
    return None, None


def aware(s):
    d = datetime.fromisoformat(s)
    return d if d.tzinfo else d.replace(tzinfo=TZ)


def trip_flights(t):
    """flight-watch's flights from the day before the trip to the day after, as journeys (a leg that leaves where the
    last one landed within 24 h joins it), soonest first; [] when flight-watch fails."""
    try:
        rows = json.loads(run(["flight-watch", "list", "--json"], 5, "flights") or "[]")
    except (Fail, ValueError):
        return []
    fl = []
    for f in rows if isinstance(rows, list) else []:
        try:
            f = {**f, "_dep": aware(f["dep"]), "_arr": aware(f["arr"])}
        except (KeyError, TypeError, ValueError):
            continue
        if t["from"] - timedelta(days=1) <= local_dt(f["dep"]).date() <= t["to"] + timedelta(days=1):
            fl.append(f)
    out = []
    for f in sorted(fl, key=lambda f: f["_dep"]):
        last = out[-1][-1] if out else None
        if last and last.get("to") == f.get("from") and timedelta(0) <= f["_dep"] - last["_arr"] < timedelta(hours=24):
            out[-1].append(f)
        else:
            out.append([f])
    return out


def trip_conditions(key):
    """`trip-conditions KEY --json --days 1 --no-advisory` (today's sea and dive estimate per place), None on failure."""
    try:
        d = json.loads(run(["trip-conditions", key, "--json", "--days", "1", "--no-advisory"], 7, "conditions"))
        return d if isinstance(d, dict) else None
    except (Fail, ValueError):
        return None


def flight_no(s):
    return re.sub(r"^([A-Z0-9]{2})(\d+[A-Z]?)$", r"\1 \2", str(s or "").replace(" ", "")) or "?"


def journey_route(j, label):
    """(label, stops, hops) for Card.route: stops with local times (each airport's own offset), hops = flight numbers."""
    stops = [(card_txt(j[0].get("from") or "?"), f"{j[0]['_dep']:%a %H:%M}")]
    for a, b in zip(j, j[1:]):
        stops.append((card_txt(a.get("to") or "?"), f"{a['_arr']:%H:%M}–{b['_dep']:%H:%M}"))
    stops.append((card_txt(j[-1].get("to") or "?"), f"{j[-1]['_arr']:%a %H:%M}"))
    return (label, f"{j[0]['_dep']:%a %d.%m}"), stops, [flight_no(f.get("no")) for f in j]


def trip_countdown(t, journeys, place=None):
    """(big value, label) for the /trip card: days or hours to the first flight (else the start), the trip day."""
    n, today = now(), now().date()
    first = journeys[0][0] if journeys else None
    dep = local_dt(first["dep"]) if first else None
    if dep and dep.date() > t["from"] + timedelta(days=1):
        dep, first = None, None
    target = dep or datetime.combine(t["from"], datetime.min.time())
    what = f"{flight_no(first.get('no'))} {target:%a %d.%m %H:%M}" if first else f"starts {t['from']:%a %d.%m}"
    if target > n:
        days = (target.date() - today).days
        if days >= 2:
            return str(days), f"days to go · {what}"
        hours = max(1, -int(-(target - n).total_seconds() // 3600))
        return f"{hours} h", f"to go · {what}"
    total = (t["to"] - t["from"]).days + 1
    if today >= t["to"] and total > 1:
        return "Last day", "of " + plural(total, "day")
    day = max(1, (today - t["from"]).days + 1)
    return f"Day {day}", f"of {total}" + (f" · {place}" if place else "")


DIVE_PILL = {"go": ("Long-range: go", (24, 70, 44), "GOOD"), "marginal": ("Long-range: maybe", (82, 58, 20), "WARN"),
             "no": ("Long-range: no", (90, 30, 30), "BAD")}
VIS_COLOUR = {"good": "GOOD", "fair": "WARN", "reduced": "BAD"}


def trip_tiles(legs, cond, ci):
    """Card.tiles items, one per place leg: dates, spot, today's dive estimate (trip-conditions), wind, waves, sea."""
    recs = {r.get("leg"): r for d in (cond or {}).get("days") or [] if isinstance(d, dict)
            for r in d.get("legs") or [] if isinstance(r, dict)}
    rank = {"go": 2, "marginal": 1, "no": 0}
    items, scores = [], []
    for i, l in enumerate(legs):
        until = legs[i + 1]["from"] if i + 1 < len(legs) else l["to"]
        sub = [f"{span(l['from'], until)} · {plural((until - l['from']).days, 'night')}"]
        if l.get("spot"):
            sub.append(card_txt(l["spot"]))
        it = {"title": card_txt(l["name"]), "color": l.get("_color"), "sub": sub, "pill": None, "lines": []}
        r = recs.get(l["name"])
        dv = (r or {}).get("dive") or {}
        if dv.get("long_range") in DIVE_PILL:
            s_, fill, col = DIVE_PILL[dv["long_range"]]
            it["pill"] = (s_, fill, getattr(ci, col))
        if dv.get("visibility"):
            it["lines"].append((f"Vis {dv['visibility']}", getattr(ci, VIS_COLOUR.get(dv["visibility"], "TEXT2"))))
        wind, sea = (r or {}).get("wind") or {}, (r or {}).get("sea") or {}
        bits = [f"{round(wind['kn'])} kn" if isinstance(wind.get("kn"), (int, float)) else "",
                f"waves {sea['wave_m']:.1f} m" if isinstance(sea.get("wave_m"), (int, float)) else ""]
        if any(bits):
            it["lines"].append(" · ".join(b for b in bits if b))
        if isinstance(sea.get("temp_c"), (int, float)):
            it["lines"].append((f"Sea {round(sea['temp_c'])}°", ci.TEXT2))
        if not r:
            it["lines"].append((card_txt(l.get("dive_label") or "no reading"), ci.TEXT2))
        items.append(it)
        scores.append((rank.get(dv.get("long_range"), -1), {"good": 2, "fair": 1, "reduced": 0}.get(dv.get("visibility"), -1)))
    if len(set(scores)) > 1 and scores.count(max(scores)) == 1 and max(scores)[0] >= 1:
        items[scores.index(max(scores))]["star"] = True      # the one clearly best place to dive today
    return items


def trip_render(t, text):
    from concurrent.futures import ThreadPoolExecutor
    ci = cardimg()
    key, conf = trip_conf(t)
    with ThreadPoolExecutor(max_workers=2) as ex:
        fj = ex.submit(trip_flights, t)
        fc = ex.submit(trip_conditions, key) if key else None
        journeys, cond = fj.result(), (fc.result() if fc else None)
    today = now().date()
    legs = []
    for l in (conf or {}).get("legs") or []:
        try:
            legs.append({**l, "from": date.fromisoformat(l["from"]), "to": date.fromisoformat(l["to"])})
        except (KeyError, TypeError, ValueError):
            pass
    legs.sort(key=lambda l: l["from"])
    here = next((l["name"] for l in reversed(legs) if l["from"] <= today <= l["to"]), None)
    nights = (t["to"] - t["from"]).days
    when = f"{t['from']:%a %d.%m} – {t['to']:%a %d.%m}" if nights else f"{t['from']:%a %d.%m}"
    c = ci.Card(card_txt(t["name"]) or "Trip", when + (f" · {plural(nights, 'night')}" if nights else ""))
    value, label = trip_countdown(t, journeys, card_txt(here) if here else None)
    c.big(value, label, color=ci.ACCENT)
    landed = now().replace(tzinfo=TZ)
    for i, j in [(i, j) for i, j in enumerate(journeys) if j[-1]["_arr"] > landed][:3]:   # flown journeys drop off
        name = "Out" if i == 0 and len(journeys) > 1 else "Back" if i == len(journeys) - 1 and len(journeys) > 1 else "Flight"
        c.route(*journey_route(j, name))
    if legs:
        c.gap(8)
        c.rich(ci.PAD, c.y + 18, " → ".join(plain(l["name"]) for l in legs), ci.font(34, True), ci.TEXT,
               maxw=c.w - 2 * ci.PAD, glyph=ci.TEXT2)
        c.y += 56
        c.trip_strip(legs, t["from"], t["to"], today if t["from"] <= today <= t["to"] else None)
        for l in legs:
            if l.get("crossing") and c.room(120):
                c.rich(ci.PAD, c.y + 16, f"{l['from'].day}.{l['from'].month} · {plain(l['crossing'])}", ci.font(26),
                       ci.TEXT2, maxw=c.w - 2 * ci.PAD)
                c.y += 40
        c.gap(10)
        c.tiles(trip_tiles(legs, cond, ci), max_h=max(160, c.h - ci.PAD - 40 - 44 - c.y))
    else:
        for r in [plain(x) for x in t["legs"] if plain(x)][:4]:   # the trip's own leg lines, → drawn
            c.rich(ci.PAD, c.y + 20, r, ci.font(30), ci.TEXT, maxw=c.w - 2 * ci.PAD, glyph=ci.TEXT2)
            c.y += 46
    n_open = sum(1 for ln in text.splitlines() if ln.startswith("☐"))
    more = re.search(r"^\+ (\d+) more \(ask me\)$", text, re.M)
    n_open += int(more.group(1)) if more else 0
    bits = [plural(n_open, "open to-do") if n_open else "nothing open", "offline pack ready" if trip_pack_line(t) else ""]
    c.lines([(" · ".join(b for b in bits if b), ci.TEXT2)], size=28)
    foot = []
    if legs:
        mode = (((cond or {}).get("days") or [{}])[0] or {}).get("mode")
        foot.append("Dive: today's estimate from wind and waves" + (" (a preview, not your dates)" if mode == "preview" else "")
                    if cond else "No sea reading right now")
    c.trim(min_height=640, footer=bool(foot))
    if foot:
        c.footer(" · ".join(foot))
    return c.save("trip")


def pic_trip(arg=None):
    answer, t, trips, q = trip_select(arg)
    if answer:
        return answer, answer, None
    text = trip_text(t, trips, q)
    return text, text, lambda: trip_render(t, text)


def _words(s):
    return {w for w in re.findall(r"\w{4,}", (s or "").lower())}


def leg_events(legs):
    """Events he is going to, from 🚆 titles like 'A → B (Artist)' / '(after X)': [(date, name, town)]."""
    out = []
    for g in legs:
        m = re.search(r"\((?:after\s+)?([^()]+)\)\s*$", g.get("title") or "")
        if not m:
            continue
        after = bool(re.search(r"\(after\s", g["title"]))
        d = g["_dep"].date() - timedelta(days=1 if after and g["_dep"].hour < 12 else 0)
        town = g.get("from") if after else g.get("to")
        town = re.sub(r"\s+(?:HB|Hbf|Bf|Bahnhof|SBB)$", "", (town or "").split(",")[0].strip())
        out.append((d, m.group(1).strip(), town))
    return out


def cmd_rave():
    items = json.loads(run(["rave-radar", "list", "--days", "180", "--json"], 6, "rave radar") or "[]")
    try:
        legs = legs_ahead()
    except Fail:
        legs = []
    going = leg_events(legs)
    trips = load_trips()
    rows, used = [], set()
    for i in items:
        if not isinstance(i, dict):
            continue
        try:
            d = date.fromisoformat(i["date"]) if i.get("date") else None
        except ValueError:
            d = None
        city = i.get("city") or ""
        hits = {k for k, (gd, name, town) in enumerate(going) if d and gd == d
                and (_words(name) & _words(i.get("artist")) or _words(town) & _words(city))}
        used |= hits
        rows.append((d, i.get("artist") or i.get("title") or "?", city, i.get("kind"), i.get("venue"), bool(hits),
                     i.get("presale"), i.get("soldout")))
    extra = []
    for k, (d, name, town) in enumerate(going):         # one row per event: the trip there and back name it twice
        if k not in used and not any(e[0] == d and _words(e[1]) & _words(name) for e in extra):
            extra.append((d, name, town))
    rows += [(d, name, town, "show", None, True, None, False) for d, name, town in extra]
    if not rows:
        return "🎧 No upcoming raves on the radar."
    rows.sort(key=lambda r: (r[0] is None, r[0] or date.max))
    out = [f"🎧 Raves · next {min(len(rows), RAVE_ROWS)}" + (f" of {len(rows)}" if len(rows) > RAVE_ROWS else "")]
    for d, artist, city, kind, venue, go, presale, soldout in rows[:RAVE_ROWS]:
        where = f"{venue} lineup, {city}" if kind == "lineup" and venue else city
        marks = []
        if go:
            marks.append("🎟 going")
        away = next((t for t in trips if d and t["from"] <= d <= t["to"]), None)
        if away and not go:
            marks.append(f"✈️ clashes with {away['name']}")
        if soldout:
            marks.append("sold out")
        try:
            if presale and date.fromisoformat(str(presale)[:10]) >= now().date():
                marks.append(f"presale {date.fromisoformat(str(presale)[:10]):%d.%m}")
        except ValueError:
            pass
        out.append(clip(f"{day_txt(d) if d else 'date tba'} · {artist} · {where}" + "".join(f" · {m}" for m in marks), 80))
    return "\n".join(out)


# /back: one catch-up card after time away. Read-only and token-free: remind's recent.json + place-state.json and
# `remind list`, `bills list`, `media recent`, the latest unraid-health report, `gift-radar list`, `calcache show`.
# Counts and titles of his own reminders, bills, media and calendar only; birthdays as first names.
REMIND_DIR = os.path.dirname(os.path.expanduser(os.environ.get("REMIND_DB") or "~/.local/state/remind/reminders.json"))
UNRAID_REPORTS = os.path.expanduser(os.environ.get("TG_CMD_UNRAID_REPORTS") or "~/reports/unraid")
BACK_DAYS = 2            # default window without a recent trip in place-state
BACK_MAX_DAYS = 30       # recent.json keeps fired reminders 30 days
BACK_TRIP_FRESH_H = 72   # a home arrival this recent makes the whole absence the default window
BACK_USAGE = "Use /back or /back N (N = days, 1–30)."
SFMT = "%Y-%m-%d %H:%M"
MEDIA_CAP = 40           # `media recent -n`
MEDIA_RE = re.compile(r"^\w{3} (\d\d)\.(\d\d) (\d\d):(\d\d)\s+(movie|tv)\s+(.+?)\s*$")
REPORT_RE = re.compile(r"^(\d{4}-\d\d-\d\d)\.md$")
FLAG_RE = re.compile(r"^- \*\*(WARN|CRIT)\*\* (.+?)(?: \((baseline|since (\d{4}-\d\d-\d\d))\))?\s*$")
BDAY_RE = re.compile(r"^\w{3} (\d\d)\.(\d\d)\.(\d{4})\s+in\s+(\d+) d\s+(\S.*?)(?:\s{2,}\S.*)?$")


def sdt(s):
    try:
        return datetime.strptime(s, SFMT)
    except (TypeError, ValueError):
        return None


def back_window(arg):
    """(since, header) for /back [N]; None when N is bad. Default: the whole absence when place-state shows he is
    away now or came home within BACK_TRIP_FRESH_H, else the last BACK_DAYS days."""
    t = now()
    if arg is not None and arg.strip():
        a = arg.strip().lower().removesuffix("d").strip()
        if not a.isdigit() or not 1 <= int(a) <= BACK_MAX_DAYS:
            return None
        return t - timedelta(days=int(a)), f"last {int(a)} day{'s' if int(a) != 1 else ''}"
    st = load_json_file(os.path.join(REMIND_DIR, "place-state.json"), {})
    st = st if isinstance(st, dict) else {}
    trip = st.get("trip") if isinstance(st.get("trip"), dict) else {}
    left = None
    if st.get("zone") not in (None, "home") and sdt(st.get("left")):
        left = sdt(st["left"])
    elif sdt(trip.get("left")) and sdt(trip.get("back")) and t - sdt(trip["back"]) <= timedelta(hours=BACK_TRIP_FRESH_H):
        left = sdt(trip["left"])
    if left and t - left <= timedelta(days=BACK_MAX_DAYS):
        return left, f"since {day_txt(left.date())} {left:%H:%M}"
    return t - timedelta(days=BACK_DAYS), f"last {BACK_DAYS} days"


def names(xs, n=2, width=26):
    """'A, B (+3)' from the first n titles."""
    xs = [clip(x, width) for x in xs if x]
    return ", ".join(xs[:n]) + (f" (+{len(xs) - n})" if len(xs) > n else "")


def when_txt(at):
    return f"{day_txt(at.date())} {at:%H:%M}"


def back_fired(since):
    """Owner reminders fired since `since` (remind's recent.json); open = not yet snoozed or done."""
    rec = load_json_file(os.path.join(REMIND_DIR, "recent.json"), {})
    rows = sorted((sdt(o.get("fired")), o.get("state"), short_title(o.get("text") or ""))
                  for o in (rec.values() if isinstance(rec, dict) else []) if isinstance(o, dict) and o.get("owner")
                  and sdt(o.get("fired")) and sdt(o.get("fired")) >= since)
    if not rows:
        return None
    still = [title for _, state, title in rows if state == "fired"]
    return f"⏰ {len(rows)} reminder{'s' if len(rows) != 1 else ''} fired · " + \
        (f"open: {names(still)}" if still else "all handled")


def back_upcoming(_since):
    """His timed reminders due in the next 48 h (`remind list`, owner ones only)."""
    t, rows = now(), []
    for l in run(["remind", "list"], 6, "reminders").splitlines():
        m = REM_RE.match(l)
        if m and m.group(2):
            at = datetime.strptime(m.group(1), SFMT)
            if t <= at <= t + timedelta(hours=48):
                text = re.sub(r"  \((?:tag [^)]*|every [^)]*)\)", "", m.group(3))
                rows.append(f"{when_txt(at)} {clip(short_title(text), 24)}")
    return f"🔜 Next 48 h: {names(rows, 2, 44)}" if rows else None


def back_bills(_since):
    """Open bills due within 7 days (overdue too), payee + day only."""
    today, rows = now().date(), []
    for b in sorted(json.loads(run(["bills", "list", "--open", "--json"], 6, "bill tracker") or "[]"),
                    key=lambda b: b.get("due") or ""):
        try:
            due = date.fromisoformat(b["due"])
        except (KeyError, TypeError, ValueError):
            continue
        if (due - today).days <= 7:
            rows.append(f"{clip(b.get('payee') or '?', 20)} " + ("overdue" if due < today else day_txt(due)))
    return f"💳 {len(rows)} bill{'s' if len(rows) != 1 else ''} due ≤ 7 d: {names(rows, 2, 32)}" if rows else None


def back_media(since):
    """New in the library since `since` (`media recent`: Radarr/Sonarr imports, newest first) → count + 2 titles."""
    t, titles, hits = now(), [], 0
    for l in run(["media", "recent", "-n", str(MEDIA_CAP)], 12, "media").splitlines():
        m = MEDIA_RE.match(l.strip())
        if not m:
            continue
        d, mo, hh, mi = (int(x) for x in m.groups()[:4])
        try:
            at = datetime(t.year, mo, d, hh, mi)
        except ValueError:
            continue
        if at > t + timedelta(days=1):
            at = at.replace(year=t.year - 1)
        if at < since:
            continue
        hits += 1
        title = re.sub(r" \(\d{4}\)$", "", m.group(6)) if m.group(5) == "movie" else re.sub(r" S\d+ .*$", "", m.group(6))
        if title not in titles:
            titles.append(title)
    more = "+" if hits >= MEDIA_CAP else ""      # every line in the window: there may be more
    return f"🎬 New on Emby: {len(titles)}{more} · {names(titles)}" if titles else None


def back_server(since):
    """Warnings of the latest daily unraid-health report that are new since `since` (its "New since last run"
    when the report is that recent, and known issues marked since a day in the window); baseline ones never."""
    try:
        reps = sorted(f for f in os.listdir(UNRAID_REPORTS) if REPORT_RE.match(f))
    except OSError:
        return None
    if not reps:
        return None
    rday = REPORT_RE.match(reps[-1]).group(1)
    flags, sec = [], None
    try:
        with open(os.path.join(UNRAID_REPORTS, reps[-1])) as f:
            for l in f:
                if l.startswith("## "):
                    sec = "new" if l.startswith("## New since") else "known" if l.startswith("## Known issues") else None
                    continue
                m = FLAG_RE.match(l.rstrip("\n")) if sec else None
                if not m:
                    continue
                day = rday if sec == "new" else m.group(4)
                if day and day >= f"{since:%Y-%m-%d}":
                    flags.append((m.group(1) != "CRIT", re.sub(r"^Unraid warning: ", "", m.group(2))))
    except OSError as e:
        raise Fail(f"server report: {type(e).__name__}")
    if not flags:
        return None
    crit = sum(1 for w, _ in flags if not w)
    head = " + ".join(x for x in (f"{crit} critical" if crit else "",
                                    f"{len(flags) - crit} warning{'s' if len(flags) - crit != 1 else ''}"
                                    if len(flags) > crit else "") if x)
    return f"🖥 Server: {head} · {names([t for _, t in sorted(flags, key=lambda x: x[0])], 2, 36)}"


def back_birthdays(_since):
    """Birthdays in the next 7 days (`gift-radar list`, which reads the people-and-dates memory): first names."""
    rows = []
    for l in run(["gift-radar", "list", "--days", "7", "--date", f"{now():%Y-%m-%d}"], 6, "birthdays").splitlines():
        m = BDAY_RE.match(l.strip())
        if m:
            d = date(int(m.group(3)), int(m.group(2)), int(m.group(1)))
            rows.append(f"{m.group(5).split()[0]} {day_txt(d)}")
    return f"🎂 {names(rows, 3, 24)}" if rows else None


def back_next_event(_since):
    """The next calendar event from calcache (all-day ones from tomorrow on; today's all-day markers skipped)."""
    code, out, _ = run(["calcache", "show", "--days", "14", "--json"], 6, "calendar", full=True)
    if code == 3:
        return None                                  # no cache yet
    if code != 0:
        raise Fail("calendar: calcache failed")
    t, best = now(), None
    for e in json.loads(out or "[]"):
        try:
            if e.get("all_day"):
                at, timed = datetime.fromisoformat(e["start"][:10]), False
                if at.date() <= t.date():
                    continue
            else:
                at, timed = datetime.fromisoformat(e["start"]).astimezone(TZ).replace(tzinfo=None), True
                if at < t:
                    continue
        except (KeyError, TypeError, ValueError):
            continue
        if best is None or at < best[0]:
            best = (at, timed, e)
    if not best:
        return None
    at, timed, e = best
    town = e.get("town")
    return f"📅 Next: {when_txt(at) if timed else day_txt(at.date())} {clip(e.get('title') or '?', 40)}" + \
        (f" · {town}" if town else "")


BACK_SOURCES = [("reminders", back_fired), ("reminders", back_upcoming), ("bills", back_bills), ("Emby", back_media),
                ("server", back_server), ("birthdays", back_birthdays), ("calendar", back_next_event)]


def cmd_back(arg=None):
    win = back_window(arg)
    if win is None:
        return BACK_USAGE
    since, label = win
    from concurrent.futures import ThreadPoolExecutor
    with ThreadPoolExecutor(len(BACK_SOURCES)) as ex:
        futs = [(what, ex.submit(fn, since)) for what, fn in BACK_SOURCES]
    lines, failed = [], []
    for what, fu in futs:
        try:
            line = fu.result()
        except Exception:  # Fail or a bug in one source: the rest of the card still goes out
            if what not in failed:
                failed.append(what)
            continue
        if line:
            lines.append(clip(line, 110))
    if len(failed) == len({w for w, _ in BACK_SOURCES}):
        raise Fail("no data source answered")
    out = [f"👋 Catch-up · {label}"] + (lines or ["Nothing new, nothing due soon."])
    if failed:
        out.append("⚠️ Not checked: " + ", ".join(failed))
    return "\n".join(out)


# ---------------------------------------------------------------- /pack
# A short packing list for the next event within PACK_DAYS (calcache + the trip files): the private template of its
# type (PACK_TEMPLATES) plus event lines: photo ID (the entry asks for ID / an age limit), passport + EUR (abroad),
# toothbrush + charger (a night away), earplugs + powerbank (a train home after midnight). `pack --todo` copies it
# into HA.
PACK_TEMPLATES = os.path.expanduser(os.environ.get("TG_CMD_PACK_TEMPLATES") or f"{CONF}/tg-cmd/pack-templates.json")
PACK_DAYS = 10           # /pack alone: the next typed event starting within this many days
PACK_LINES = 10          # whole card, header included
PACK_ORDER = ("wedding", "rave", "beach", "business")
PACK_KEYWORDS = {        # title words per type (+ the template's own "match"; rave also matches rave-radar's artists)
    "wedding": r"wedding|hochzeit|hochziit|heirat|trauung|mariage|matrimonio|\bgig\b|dj[- ]?set|sound ?gear",
    "rave": r"\brave|club|techno|festival|open[- ]?air|afterhour|warehouse|boiler room",
    "beach": r"beach|strand|ferien|holiday|vacation|urlaub|vacances|\binsel|island",
    "business": r"visit|besuch|meeting|customer|kunde|client|conference|konferenz|workshop|summit|expo|messe|"
                r"offsite|onsite|business|dienstreise",       # counts only abroad
}
PACK_ALIASES = {"club": "rave", "techno": "rave", "party": "rave", "gig": "wedding", "hochzeit": "wedding",
                "dj": "wedding", "work": "business", "abroad": "business", "trip": "beach", "holiday": "beach",
                "long": "beach"}
PACK_EXTRAS = (          # (reason, item, skipped when an item already matches)
    ("abroad", "🛂 Passport", r"passport"),
    ("abroad", "💶 EUR cash", r"\bEUR\b|€|\beuro"),
    ("id", "🪪 Official photo ID", r"photo id|passport|\bID\b"),
    ("overnight", "🪥 Toothbrush", r"toothbrush|wash ?bag|toiletr"),
    ("overnight", "🔌 Phone charger", r"charger"),
    ("night_train", "👂 Earplugs", r"earplug"),
    ("night_train", "🔋 Powerbank", r"power ?bank"),
)
PACK_FLAG_RE = re.compile("[\U0001F1E6-\U0001F1FF]{2}")
PACK_HOME_FLAGS = {"\U0001F1E8\U0001F1ED"}
PACK_ID_RE = re.compile(r"(?<![\d+])(?:18|16|21)\s*\+|\bID\b")   # title fallback for caches without id_check


def pack_templates():
    d = load_json_file(PACK_TEMPLATES, None)
    types = d.get("types") if isinstance(d, dict) else None
    out = {str(k).lower(): v for k, v in (types or {}).items() if isinstance(v, dict) and isinstance(v.get("items"), list)}
    if not out:
        raise Fail("no packing templates yet")
    return out


def pack_artists():
    """rave-radar's artist names + aliases (lowercase); [] when it is missing or fails."""
    try:
        code, out, _ = run(["rave-radar", "artists", "list", "--json"], 6, "artists", full=True)
        rows = json.loads(out) if code == 0 else []
    except (Fail, ValueError):
        return []
    names = []
    for a in rows if isinstance(rows, list) else []:
        if isinstance(a, dict):
            names += [n.strip().lower() for n in [a.get("name"), *(a.get("aliases") or [])]
                      if isinstance(n, str) and len(n.strip()) >= 3]
    return names


def artist_hit(text, names):
    """An artist named in text: whole words, or close enough for a typo ("Brechja") when the name is 6+ letters."""
    import difflib
    low = text.lower()
    toks = re.findall(r"[\w'&.-]+", low)
    for n in names:
        if re.search(r"(?<!\w)" + re.escape(n) + r"(?!\w)", low):
            return True
        k = len(n.split())
        if len(n) >= 6 and any(difflib.SequenceMatcher(None, " ".join(toks[i:i + k]), n).ratio() >= 0.85
                               for i in range(len(toks) - k + 1)):
            return True
    return False


def pack_type(ctx, abroad, days, types, artists, is_trip=False):
    for k in PACK_ORDER + tuple(t for t in types if t not in PACK_ORDER):
        if k not in types or (k == "business" and not abroad):
            continue
        pats = [PACK_KEYWORDS.get(k)] + [re.escape(m) for m in types[k].get("match") or [] if isinstance(m, str) and m]
        if any(p and re.search(p, ctx, re.I) for p in pats) or (k == "rave" and artist_hit(ctx, artists)):
            return k
    if (is_trip or days >= 4) and "beach" in types:
        return "beach"
    return "business" if abroad and "business" in types else None


def pack_candidates(types):
    """Upcoming events (calcache, no travel legs or @Town markers) and trips, each {name, start, type, abroad, id,
    overnight, night_train}, soonest first."""
    t = now()
    code, out, _ = run(["calcache", "show", "--days", "21", "--json"], 6, "calendar", full=True)
    if code not in (0, 3):
        raise Fail("calendar: calcache failed")
    evs = []
    for e in (json.loads(out or "[]") if code == 0 else []):
        try:
            if e.get("all_day"):
                s, en = datetime.fromisoformat(e["start"][:10]), datetime.fromisoformat(e["end"][:10])
            else:
                s = datetime.fromisoformat(e["start"]).astimezone(TZ).replace(tzinfo=None)
                en = datetime.fromisoformat(e["end"]).astimezone(TZ).replace(tzinfo=None)
        except (KeyError, TypeError, ValueError, AttributeError):
            continue
        evs.append(dict(e, s=s, e=en, title=str(e.get("title") or ""), flags=e.get("flags") or {}))
    artists = pack_artists()
    legs = [g for g in evs if g["flags"].get("travel")]
    out = []
    for e in evs:
        f, title = e["flags"], e["title"]
        if f.get("travel") or title.startswith("@") or e["e"] <= t:
            continue
        near = [g for g in legs if g["s"] < e["e"] + timedelta(hours=3) and g["e"] > e["s"] - timedelta(hours=4)]
        ctx = " ".join([title] + [p for g in near for p in re.findall(r"\(([^)]{1,80})\)", g["title"])])
        abroad = bool(f.get("abroad") or "✈" in title or any(g["flags"].get("travel") == "flight" for g in near)
                      or set(PACK_FLAG_RE.findall(title)) - PACK_HOME_FLAGS)
        night_train = any(g["flags"].get("travel") in ("train", "bus") and g["s"] >= e["s"]
                          and g["s"].hour < 7
                          and ((g.get("train") or {}).get("to") == "home" or re.search(r"→\s*home\b", g["title"], re.I))
                          for g in near)
        days = (e["e"] - e["s"]).days
        out.append({"name": title, "ctx": ctx, "start": e["s"], "end": e["e"], "all_day": bool(e.get("all_day")),
                    "type": pack_type(ctx, abroad, days, types, artists), "abroad": abroad,
                    "id": bool(f.get("id_check") or PACK_ID_RE.search(title)), "night_train": night_train,
                    "overnight": bool(days >= 2 or (f.get("away_overnight") and not night_train))})
    for tr in load_trips():
        if not tr["from"] or tr["to"] < t.date():
            continue
        same = [c for c in out if c["start"].date() <= tr["to"] and c["end"].date() >= tr["from"]]
        txt = " ".join([tr["name"], tr["emoji"] or ""] + tr["legs"])
        abroad = bool("✈" in txt or "🏝" in txt or set(PACK_FLAG_RE.findall(txt)) - PACK_HOME_FLAGS)
        days = (tr["to"] - tr["from"]).days + 1
        kind = pack_type(tr["name"], abroad, days, types, artists, is_trip=True)
        if any(trip_matches(tr, c["ctx"]) or (kind and c["type"] == kind) for c in same):
            continue                                    # the calendar event itself says more (times, legs, flags)
        out.append({"name": tr["name"], "ctx": txt, "start": datetime.combine(tr["from"], datetime.min.time()),
                    "end": datetime.combine(tr["to"], datetime.min.time()) + timedelta(days=1), "all_day": True,
                    "type": kind, "abroad": abroad, "id": False, "night_train": False, "overnight": days >= 2})
    return sorted(out, key=lambda c: c["start"])


def pack_build(arg=None):
    """(header, items) for the card, or (message, None) for list/usage/nothing-found answers."""
    types = pack_templates()
    a = (arg or "").strip()
    low = a.lower().lstrip("/")
    if low in ("list", "types", "help", "?"):
        rows = [f"{(v.get('emoji') or '•')} {k} · {clip(str(v.get('label') or k), 34)} ({len(v['items'])})"
                for k, v in types.items()]
        return "\n".join(["🎒 Packing lists"] + rows[:PACK_LINES - 2] +
                         ["/pack TYPE shows one · /pack = next event (10 d)"]), None
    t = now()
    cands = pack_candidates(types)
    kind = PACK_ALIASES.get(low, low)
    if not a:
        ev = next((c for c in cands if c["type"] and c["start"] <= t + timedelta(days=PACK_DAYS)), None)
        if not ev:
            return f"🎒 Nothing to pack for in the next {PACK_DAYS} days.\n/pack list shows the lists · /pack TYPE shows one.", None
        kind = ev["type"]
    elif kind in types:
        ev = next((c for c in cands if c["type"] == kind), None)
    else:
        ev = next((c for c in cands if low in c["name"].lower()), None) or \
            next((c for c in cands if low in c["ctx"].lower()), None)
        if not ev:
            return f"🎒 No list or event called “{clip(a, 30)}”.\nLists: {', '.join(types)} (/pack list).", None
        if not ev["type"]:
            return f"🎒 {clip(ev['name'], 40)}: no list fits it.\n/pack TYPE picks one: {', '.join(types)}.", None
        kind = ev["type"]
    tpl = types[kind]
    items = [x.strip() for x in tpl["items"] if isinstance(x, str) and x.strip()]
    extra = []
    for reason, item, pat in PACK_EXTRAS if ev else ():
        if ev[reason] and not any(re.search(pat, x, re.I) for x in extra + items):
            extra.append(item)
    icon = tpl.get("emoji") or "🎒"
    if ev:
        d = ev["start"].date()
        n = (d - t.date()).days
        head = f"🎒 {icon} {clip(ev['name'], 36)} · {day_txt(d)}" + (f" (in {n} d)" if n >= 2 else "")
    else:
        head = f"🎒 {icon} {clip(str(tpl.get('label') or kind), 40)}"
    return head, extra + items


def pack_card(head, items):
    room = PACK_LINES - 1
    per = max(1, -(-len(items) // room))
    return "\n".join([head] + [" · ".join(items[i:i + per]) for i in range(0, len(items), per)])


def cmd_pack(arg=None):
    head, items = pack_build(arg)
    return head if items is None else pack_card(head, items)



# ---------------------------------------------------------------- /sleep (healthlib: his own Health Connect days)
def healthlib():
    """~/bin/lib/healthlib.py (next to this script, else ~/bin/lib; TG_CMD_HEALTHLIB = a file for tests)."""
    import importlib.util
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib", "healthlib.py")
    path = os.environ.get("TG_CMD_HEALTHLIB") or (here if os.path.exists(here) else os.path.join(REAL_LIB, "healthlib.py"))
    spec = importlib.util.spec_from_file_location("healthlib", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def sleep_facts():
    H = healthlib()
    tz, t = H.zone(), H.now()
    rows, tags = H.load(t=t)
    since = (date.fromtimestamp(t) - timedelta(days=40)).isoformat()
    ins = H.insights(rows, tags, tz, t, gym=H.gym_days(since))
    return H, tz, t, rows, ins


def cmd_sleep():
    H, tz, t, rows, ins = sleep_facts()
    return "\n".join(H.card_lines(ins, tz))


def pic_sleep():
    H, tz, t, rows, ins = sleep_facts()
    lines = H.card_lines(ins, tz)
    text = "\n".join(lines)
    if not ins.get("nights"):
        return text, "", None
    cap = " · ".join(lines[:2])[:200]

    def render():
        ci = cardimg()
        bars = H.chart_rows(rows, tz, t, 14)
        d1 = datetime.fromtimestamp(t, tz).date()
        c = ci.Card("Sleep & energy", f"{d1 - timedelta(days=13):%d.%m}–{d1:%d.%m} · Health Connect, summarised on the phone")
        last = ins.get("last") or {}
        tiles = [(H.hm(last["sleep_min"]) if last.get("sleep_min") is not None else "–", "last night")]
        if ins.get("debt7_min") is not None:
            d = ins["debt7_min"]
            tiles.append((H.hm(d) if abs(d) >= 15 else "0", "7-day debt" if d >= 0 else "7-day surplus",
                          ci.WARN if d >= 180 else ci.TEXT))
        elif ins.get("avg7_min") is not None:
            tiles.append((H.hm(ins["avg7_min"]), "7-day avg"))
        if ins.get("steps7") is not None:
            tiles.append((f"{ins['steps7'] / 1000:.1f}k", "steps / day"))
        c.stats(tiles)
        base = ins.get("baseline_min")
        vals = [round(h, 1) if h is not None else 0 for _, h in bars]
        cols = [ci.FAINT if h is None else (ci.WARN if base and h * 60 < base - 60 else ci.ACCENT) for _, h in bars]
        note = "Hours asleep per night" + (f" (usual {H.hm(base)}; amber = 1 h+ under)" if base else "")
        c.bar_chart(vals, [lb for lb, _ in bars], height=420, colors=cols, value_fmt=lambda v: f"{v:.1f}" if v else "", note=note)
        c.lines([x.replace("→", "›") for x in lines[2:]], size=28)   # the card font has no →
        return c.save("sleep")
    return text, cap, render


