.flag{display:block;background:var(--warm-tint);color:var(--warm);border-radius:8px;padding:5px 10px;font-size:.85rem}
.check{list-style:none;padding:0}.check li{margin:0}
.check label{display:flex;gap:10px;align-items:flex-start;padding:7px 0;border-top:1px solid var(--line)}
.check li:first-child label{border-top:0}
.check input{flex:none;width:20px;height:20px;margin:2px 0 0;accent-color:var(--accent)}
.check input:checked+span{text-decoration:line-through;color:var(--ink-2)}
footer{color:var(--ink-2);font-size:.8rem;padding:8px 0 40px}
@media print{nav{display:none}section{break-inside:avoid;box-shadow:none}}"""


def render_html(s, plan):
    E = html.escape
    pp = plan.get('phases') or {}
    out = ['<!doctype html><html lang="en"><head><meta charset="utf-8">',
           '<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">',
           '<meta name="color-scheme" content="light dark">',
           f'<title>{E(plan.get("page_title") or "DJ set card")}</title><style>{CSS}</style></head><body>',
           f'<header class="wrap"><div class="eyebrow">{E(plan.get("eyebrow") or "DJ set card")}</div>',
           f'<h1>{E(plan.get("title") or "DJ set")}</h1>']
    if plan.get('sub'):
        out.append(f'<p class="sub">{E(plan["sub"])}</p>')
    out.append('</header><nav><div class="wrap"><a href="#plan">Plan</a><a href="#set">Set</a>'
               '<a href="#flags">Flags</a><a href="#backup">Backup</a><a href="#how">How</a></div></nav>'
               '<main class="wrap">')
    # plan
    out.append('<section id="plan"><h2>Phase plan</h2><ul class="rows">')
    for p in s['phases']:
        meta = pp.get(p['name']) or {}
        tr = p['tracks']
        stats = 'no tracks'
        if tr:
            bp = [t['bpm'] for t in tr]
            es = [en(t) for t in tr]
            ids = {id(t) for t in tr}
            fl = sum(1 for x in s['transitions'] if x['flags'] and x['i'] < s['count'] and id(s['_order'][x['i']]) in ids
                     and id(s['_order'][x['i'] + 1]) in ids)
            stats = (f'{len(tr)} tracks · {min(bp):.0f}–{max(bp):.0f} BPM · energy {min(es):.0f}–{max(es):.0f}'
                     f' · {len(tr) - 1 - fl} blends, {fl} cuts')
        out.append(f'<li><span class="when">{E(meta.get("time") or "")}</span><span><b>'
                   f'{E(meta.get("label") or p["name"].title())}</b>'
                   + (f' — {E(meta["brief"])}' if meta.get('brief') else '')
                   + f'<br><span class="muted">{E(stats)}</span></span></li>')
    out.append('</ul>')
    for n in plan.get('intro') or []:
        out.append(f'<p class="tip">{E(n)}</p>')
    out.append('</section>')
    # set
    flagged = {t['i']: t for t in s['transitions'] if t['flags']}
    out.append('<section id="set"><h2>Ordered set</h2><p class="muted">BPM · Camelot · energy (1–10). '
               'Neighbours are ±1 Camelot and ≤ 6 % BPM unless flagged.</p>')
    n = 0
    for p in s['phases']:
        if not p['tracks']:
            continue
        meta = pp.get(p['name']) or {}
        out.append(f'<h3>{E(meta.get("label") or p["name"].title())}'
                   + (f' · {E(meta["time"])}' if meta.get('time') else '') + '</h3><ol class="set">')
        for k, t in enumerate(p['tracks']):
            n += 1
            sp = cam_split(t.get('camelot'))
            hue = ((sp[0] - 1) * 30) if sp else 0
            chip = (f'<span class="cam" style="background:hsl({hue} 70% 50% / .18)">{E(t.get("camelot") or "?")}'
                    '</span>')
            sub = []
            if t.get('key'):
                sub.append(t['key'])
            if t.get('version'):
                sub.append(f'{t["version"]} version')
            if t.get('bpm_unsure'):
                sub.append(f'BPM unsure, maybe {t["bpm_alt"]:.0f}')
            if t.get('from_list'):
                sub.append('from list')
            if t.get('want') and norm(base_title(t['want'].split(' - ')[-1])) not in norm(label(t)):
                sub.append(f'for {t["want"]}')
            w = max(4, min(100, int((en(t) - 1) / 9 * 100)))
            out.append(f'<li class="{"first" if k == 0 else ""}"><span class="n">{n}</span><span class="tt">'
                       f'{E(t.get("artist") or "")} – {E(t.get("title") or "")}'
                       + (f'<small>{E(" · ".join(sub))}</small>' if sub else '')
                       + f'</span><span class="meta">{t["bpm"]:.0f} {chip} E{en(t):.0f}</span>'
                       f'<span class="bar"><i style="width:{w}%"></i></span></li>')
            f = flagged.get(n - 1)
            if f and k < len(p['tracks']) - 1:
                mark = '⚠ hard' if f['severity'] == 'hard' else '✂ cut'
                out.append(f'<li class="hard"><span class="flag">{mark} · {E(f["what"])}</span></li>')
        out.append('</ol>')
    if s['missing']:
        out.append('<p class="muted">Not in the set (no match or no preview): '
                   + E(', '.join(r.get('want') or label(r) for r in s['missing'])) + '</p>')
    out.append('</section>')
    # flags
    out.append('<section id="flags"><h2>Hard transitions</h2>')
    hard = [f for f in flagged.values() if f['severity'] == 'hard']
    cuts = len(flagged) - len(hard)
    if cuts:
        out.append(f'<p class="muted">{cuts} more key-only or small tempo changes are marked ✂ in the set: '
                   'mix them on a breakdown or drum intro, or echo out and drop in.</p>')
    if hard:
        out.append('<ul class="rows">')
        for f in hard:
            br = f' Bridge: {f["bridge"]}.' if f.get('bridge') else ''
            pc = ' (phase change)' if f['phase_change'] else ''
            out.append(f'<li><span class="when">{f["i"] + 1}→{f["i"] + 2}</span><span>{E(f["from"])} → '
                       f'{E(f["to"])}{pc}<br><span class="muted">{E(f["what"])}. {E(f["tip"].capitalize())}.'
                       f'{E(br)}</span></span></li>')
        out.append('</ul>')
    elif not flagged:
        out.append('<p>None: every neighbour is within ±1 Camelot and 6 % BPM.</p>')
    out.append('</section>')
    # checklist
    out.append('<section id="backup"><h2>Backup checklist</h2><ul class="check">')
    for c in plan.get('checklist') or []:
        out.append(f'<li><label><input type="checkbox"><span>{E(c)}</span></label></li>')
    out.append('</ul></section>')
    # how
    out.append('<section id="how"><h2>How this was made</h2><ul>')
    for c in (plan.get('notes') or []) + [
            'BPM and key are estimated from 30-second Deezer previews (librosa); Deezer\'s own BPM is used '
            'where the preview disagrees. Energy is a rough 1–10 mix of loudness, onset density, percussion '
            'and brightness.',
            'Check the values against your DJ software\'s analysis before the gig; a "?" key means low confidence.']:
        out.append(f'<li>{E(c)}</li>')
    out.append('</ul></section></main>')
    out.append(f'<footer class="wrap">{E(plan.get("footer") or "Made with trackinfo")}</footer></body></html>')
    return '\n'.join(out)


# ---------------------------------------------------------------- CLI

def usage(msg=None):
    if msg:
        print(f'trackinfo: {msg}', file=sys.stderr)
    print(__doc__.split('List formats:')[0].strip(), file=sys.stderr)
    return 2


def main(argv):
    opts = {'json': False, 'refresh': False, 'offline': False, 'file': None, 'phases': None, 'html': None,
            'plan': None}
    cmd = 'analyse'
    if argv and argv[0] in COMMANDS:
        cmd = argv.pop(0)
    if cmd == 'help':
        print(__doc__)
        return 0
    args, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in ('-h', '--help'):
            print(__doc__)
            return 0
        if a in ('--json', '--refresh', '--offline'):
            opts[a[2:]] = True
        elif a in ('--file', '--phases', '--html', '--plan'):
            if i + 1 >= len(argv):
                return usage(f'{a} needs a value')
            opts[a[2:]] = argv[i + 1]
            i += 1
        elif a.startswith('--'):
            return usage(f'unknown option {a}')
        else:
            args.append(a)
        i += 1
    phases = [p.strip().lower() for p in (opts['phases'] or ','.join(DEFAULT_PHASES)).split(',') if p.strip()]
    try:
        if opts['file'] == '-' and cmd in ('analyse', 'set') and not opts['offline']:
            need_librosa()  # re-exec before stdin is read
        entries = []
        if opts['file']:
            entries = parse_list(read_text(opts['file']), phases)
        for a in args:
            p = os.path.expanduser(a)
            entries.append(file_entry(p) if is_audio(p) else parse_list(a, phases)[0])
        if cmd == 'parse':
            print(json.dumps(entries, ensure_ascii=False, indent=1))
            return 0
        if cmd == 'forget':
            cache = jsonstate.load(CACHE, {})
            gone = [label(e) for e in entries if cache.pop(entry_key(e), None) is not None]
            write_json(CACHE, cache)
            print(f'forgot {len(gone)} of {len(entries)}')
            return 0
        if cmd == 'set' and not entries:
            entries = jsonstate.load(LAST, [])
            if not entries:
                return usage('set needs --file LIST or tracks (no earlier list)')
        if not entries:
            return usage('no tracks given')
        if cmd in ('analyse', 'set') and (opts['file'] or args):
            write_json(LAST, entries)
        results = analyse_all(entries, opts['refresh'], opts['offline'] or cmd == 'show')
        if cmd == 'set':
            s = build_set(results, phases)
            if opts['html']:
                plan = jsonstate.load(os.path.expanduser(opts['plan']), {}) if opts['plan'] else {}
                tmp = f'{opts["html"]}.tmp{os.getpid()}'
                with open(tmp, 'w', encoding='utf-8') as fh:
                    fh.write(render_html(s, plan))
                os.replace(tmp, opts['html'])
            if opts['json']:
                print(json.dumps(set_json(s), ensure_ascii=False, indent=1))
            else:
                print_set(s)
                if opts['html']:
                    print(f'card: {opts["html"]}')
            return 0 if s['count'] else 1
        if opts['json']:
            keep = ('artist', 'title', 'want', 'phase', 'bpm', 'bpm_local', 'bpm_deezer', 'bpm_agree', 'bpm_unsure',
                    'bpm_alt', 'camelot', 'key', 'key_conf', 'energy', 'version', 'deezer_id', 'source', 'from_list',
                    'error')
            print(json.dumps([{k: r[k] for k in keep if r.get(k) is not None} for r in results],
                             ensure_ascii=False, indent=1))
        else:
            print(f'  {"BPM":>6}  {"CAM":>3}  {"KEY":<4}  {"ENRG":>5}  TRACK')
            for r in results:
                print(fmt_track(r))
        return 0 if any(r.get('bpm') for r in results) else 1
    except Fail as e:
        print(f'trackinfo: {e}', file=sys.stderr)
        return 1
    except OSError as e:
        print(f'trackinfo: {e}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
