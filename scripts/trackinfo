#!/usr/bin/env -S python3 -I
"""trackinfo: BPM, key (Camelot) and a rough energy level per track, and a harmonic order for a DJ set.

Usage:
  trackinfo "Artist - Title" ...        analyse tracks: Deezer public search -> 30 s preview -> local librosa
                                        estimate of BPM, key, Camelot and energy (1-10); results are cached
  trackinfo --file LIST                 the same for a list (formats below); --file - reads stdin
  trackinfo show "Artist - Title" ...   cached results only, no network
  trackinfo set [--file LIST] [--phases warmup,floor,peak] [--html OUT [--plan PLAN.json]]
                                        order a list (default: the last list analysed). Phases come from the
                                        list, else the tracks are split by energy. Within a phase: rising
                                        energy with harmonic neighbours (+-1 Camelot, <= 6 % BPM jump;
                                        half/double time counts). Hard transitions are flagged with a tip and,
                                        when one exists, a bridge track. --html writes a phone card; PLAN.json
                                        adds title, phase times and briefs, a checklist and notes.
  trackinfo parse --file LIST           show how a list is read (no network)
  trackinfo forget "Artist - Title" ... drop cached results
Options: --json, --refresh (re-analyse), --offline (cache and list values only)

List formats:
  "Artist - Title" lines ("1. " numbering is fine), optional "| BPM | KEY | ENERGY" columns
  (KEY as Camelot 8A, Open Key 1m, or Am / F#m / Db); "## phase" or "[phase]" headers, or
  "phase: Artist - Title"; "#" comments. M3U/M3U8 playlists (#EXTINF names, local file paths).
  CSV/TSV exports (Rekordbox, Serato, Traktor) with Artist + Title / Track Title / Name columns; their
  BPM / Key / Energy columns are used as given. Paths to local audio files are analysed locally (60 s
  from the middle of the track).

Env: TRACKINFO_STATE (cache dir, default ~/.local/state/trackinfo), TRACKINFO_API (Deezer base URL),
     TRACKINFO_PY (Python with librosa, default ~/opt/trackinfo-venv), TRACKINFO_RPS (requests/s, max 5).
"""
import csv
import hashlib
import html
import io
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

_here = os.path.dirname(os.path.realpath(__file__))
for _lib in (os.path.join(pwd.getpwuid(os.getuid()).pw_dir, 'bin', 'lib'), os.path.expanduser('~/bin/lib'),
             os.path.join(_here, 'lib')):
    sys.path.insert(0, _lib)                              # own lib dir first; ~/bin/lib for a copy elsewhere
if not os.path.isdir(os.path.join(_here, 'lib', 'core')) and os.path.isdir(os.path.join(_here, '..', 'core')):
    sys.path.insert(0, os.path.dirname(_here))            # the repo checkout (scripts/): its own core
from core import http as web, jsonstate  # noqa: E402

HOME = os.path.expanduser('~')
STATE = os.environ.get('TRACKINFO_STATE') or os.path.join(HOME, '.local/state/trackinfo')
CACHE = os.path.join(STATE, 'cache.json')
LAST = os.path.join(STATE, 'last-list.json')
API = (os.environ.get('TRACKINFO_API') or 'https://api.deezer.com').rstrip('/')
VENV_PY = os.environ.get('TRACKINFO_PY') or os.path.join(HOME, 'opt/trackinfo-venv/bin/python3')
try:
    RPS = max(0.5, min(5.0, float(os.environ.get('TRACKINFO_RPS') or 4)))
except ValueError:
    RPS = 4.0
UA = 'trackinfo/1.0 (personal DJ set prep)'
SR = 22050
NOTFOUND_RETRY = 7 * 86400
AUDIO_EXT = {'.mp3', '.wav', '.flac', '.aif', '.aiff', '.m4a', '.aac', '.ogg', '.opus', '.wma', '.alac'}
DEFAULT_PHASES = ['warmup', 'floor', 'peak']
MAX_KEY_STEP = 1
MAX_BPM_JUMP = 0.06
COMMANDS = ('set', 'show', 'parse', 'forget', 'help')

MAJ_NAMES = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'F#', 'G', 'Ab', 'A', 'Bb', 'B']
MIN_NAMES = ['Cm', 'C#m', 'Dm', 'Ebm', 'Em', 'Fm', 'F#m', 'Gm', 'G#m', 'Am', 'Bbm', 'Bm']
# Key profiles (index 0 = tonic). shaath = KeyFinder-style (best on a 10-track pop/EDM check: 5 exact, 10 within
# +-1 Camelot), kk = Krumhansl-Kessler, temperley = Temperley 1999.
PROFILES = {
    'shaath': ([6.6, 2.0, 3.5, 2.3, 4.6, 4.0, 2.5, 5.2, 2.4, 3.7, 2.3, 3.4],
               [6.5, 2.7, 3.5, 5.4, 2.6, 3.5, 2.5, 5.2, 4.0, 2.7, 4.3, 3.2]),
    'kk': ([6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88],
           [6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17]),
    'temperley': ([5.0, 2.0, 3.5, 2.0, 4.5, 4.0, 2.0, 4.5, 2.0, 3.5, 1.5, 4.0],
                  [5.0, 2.0, 3.5, 4.5, 2.0, 4.0, 2.0, 4.5, 3.5, 2.0, 1.5, 4.0]),
}
KEY_PROFILE = os.environ.get('TRACKINFO_KEYPROFILE') or 'shaath'


class Fail(Exception):
    pass


# ---------------------------------------------------------------- small helpers

def norm(s):
    s = unicodedata.normalize('NFKD', str(s or '')).encode('ascii', 'ignore').decode().lower()
    s = re.sub(r'[^a-z0-9]+', ' ', s.replace('&', ' and '))
    return ' '.join(s.split())


def base_title(t):
    t = re.sub(r'\s*[(\[][^)\]]*[)\]]', '', t or '')
    t = re.split(r'\s+(?:feat\.?|ft\.?|featuring)\s+', t, flags=re.I)[0]
    t = re.split(r'\s+-\s+', t)[0]
    return t.strip()


def first_artist(a):
    return re.split(r'\s*(?:,|&|\bx\b|\bfeat\.?|\bft\.?|\bfeaturing\b|\band\b|\bvs\.?)\s*', a or '',
                    flags=re.I)[0].strip()


def lin(x, lo, hi):
    return max(0.0, min(1.0, (x - lo) / (hi - lo)))


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f'{path}.tmp{os.getpid()}'
    with open(tmp, 'w', encoding='utf-8') as fh:
        json.dump(data, fh, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def label(e):
    a, t = e.get('artist') or '', e.get('title') or ''
    return f'{a} - {t}' if a else t


# ---------------------------------------------------------------- keys

def camelot(pc, minor):
    n = ((((pc + (3 if minor else 0)) % 12) * 7) % 12 + 7) % 12 + 1
    return f'{n}{"A" if minor else "B"}'


def cam_split(c):
    m = re.fullmatch(r'(1[0-2]|[1-9])([AB])', c or '')
    return (int(m.group(1)), m.group(2)) if m else None


def key_name(cam):
    for pc in range(12):
        if camelot(pc, True) == cam:
            return MIN_NAMES[pc]
        if camelot(pc, False) == cam:
            return MAJ_NAMES[pc]
    return ''


def parse_key(s):
    """Camelot from '8A', '8a', Open Key '1m'/'1d', or 'Am', 'F#m', 'Db', 'A min', 'Bb major'; else None."""
    s = (s or '').strip().replace('♯', '#').replace('♭', 'b')
    m = re.fullmatch(r'(1[0-2]|0?[1-9])\s*([AaBb])', s)
    if m:
        return f'{int(m.group(1))}{m.group(2).upper()}'
    m = re.fullmatch(r'(1[0-2]|0?[1-9])\s*([mMdD])', s)
    if m:
        n = (int(m.group(1)) - 1 + 7) % 12 + 1
        return f'{n}{"A" if m.group(2).lower() == "m" else "B"}'
    m = re.fullmatch(r'([A-Ga-g])\s*([#b]?)\s*(m|min|minor|maj|major|dur|moll)?', s)
    if m:
        pc = {'c': 0, 'd': 2, 'e': 4, 'f': 5, 'g': 7, 'a': 9, 'b': 11}[m.group(1).lower()]
        pc = (pc + {'#': 1, 'b': -1, '': 0}[m.group(2)]) % 12
        q = (m.group(3) or '').lower()
        return camelot(pc, q in ('m', 'min', 'minor', 'moll'))
    return None


def corr(a, b):
    n = len(a)
    ma, mb = sum(a) / n, sum(b) / n
    num = sum((x - ma) * (y - mb) for x, y in zip(a, b))
    da = sum((x - ma) ** 2 for x in a) ** 0.5
    db = sum((y - mb) ** 2 for y in b) ** 0.5
    return num / (da * db) if da and db else 0.0


def estimate_key(chroma, profile=None):
    """(camelot, key name, confidence) from a 12-bin chroma profile (C first)."""
    maj, mnr = PROFILES.get(profile or KEY_PROFILE, PROFILES['shaath'])
    scores = []
    for pc in range(12):
        for minor, prof in ((False, maj), (True, mnr)):
            rot = [prof[(i - pc) % 12] for i in range(12)]
            scores.append((corr(chroma, rot), pc, minor))
    scores.sort(reverse=True)
    best, second = scores[0], scores[1]
    pc, minor = best[1], best[2]
    return camelot(pc, minor), (MIN_NAMES if minor else MAJ_NAMES)[pc], round(best[0] - second[0], 3)


def cam_dist(a, b):
    sa, sb = cam_split(a), cam_split(b)
    if not sa or not sb:
        return None
    d = abs(sa[0] - sb[0]) % 12
    return min(d, 12 - d) + (0 if sa[1] == sb[1] else 1)


def bpm_jump(a, b):
    """(relative jump, factor) with half/double time allowed: 0.03 = 3 %."""
    if not a or not b:
        return None, 1
    return min((abs(b * f / a - 1), f) for f in (1, 2, 0.5))


# ---------------------------------------------------------------- energy

def energy_from(f, bpm):
    """Rough 1-10 energy from the stored audio features (loudness, onset density, percussion, brightness)."""
    if not f:
        return None
    b = bpm or 120
    while b < 80:
        b *= 2
    while b >= 160:
        b /= 2
    # ranges = 10th..90th percentile over a 40-track pop/latin/EDM sample of Deezer previews
    e = (0.25 * lin(f.get('rms_db', -8), -11.0, -4.5) + 0.25 * lin(f.get('onset_rate', 3.5), 2.0, 5.6)
         + 0.20 * lin(f.get('perc', 0.3), 0.18, 0.56) + 0.15 * lin(f.get('hf', 0.27), 0.18, 0.37)
         + 0.15 * lin(b, 90, 130))
    return round(1 + 9 * e, 1)


# ---------------------------------------------------------------- network

_last_req = [0.0]


def throttle():
    gap = 1.0 / RPS - (time.monotonic() - _last_req[0])
    if gap > 0:
        time.sleep(gap)
    _last_req[0] = time.monotonic()


def fetch(url, timeout=15, raw=False):
    for attempt in range(3):
        throttle()
        req = urllib.request.Request(url, headers={'User-Agent': UA})
        try:
            with web.open(req, timeout=timeout) as r:
                body = r.read(25_000_000)
        except urllib.error.HTTPError as e:
            if e.code in (429, 503) and attempt < 2:
                time.sleep(2 * (attempt + 1))
                continue
            raise Fail(f'HTTP {e.code} from {urllib.parse.urlsplit(url).netloc}')
        except (urllib.error.URLError, OSError) as e:
            if attempt < 1:
                time.sleep(1)
                continue
            raise Fail(f'network error: {getattr(e, "reason", e)}')
        if raw:
            return body
        try:
            data = json.loads(body)
        except ValueError:
            raise Fail('bad JSON from Deezer')
        err = data.get('error') if isinstance(data, dict) else None
        if err:
            if isinstance(err, dict) and err.get('code') == 4 and attempt < 2:  # quota: back off
                time.sleep(5 * (attempt + 1))
                continue
            raise Fail(f'Deezer error: {err.get("message") if isinstance(err, dict) else err}')
        return data
    raise Fail('Deezer rate limit')


BAD_WORDS = ('remix', 'live', 'acoustic', 'instrumental', 'karaoke', 'cover', 'slowed', 'sped up', 'nightcore',
             'tribute', 'made famous', 'originally performed', 'in the style of', 'piano', 'lullaby', '8d',
             'reverb', 'cover band', 'tribute band')


def version_words(t, want_title='', want_artist=''):
    have = f'{norm(t.get("title"))} {norm((t.get("artist") or {}).get("name"))}'
    want = f'{norm(want_title)} {norm(want_artist)}'
    return [w for w in BAD_WORDS if re.search(rf'\b{w}\b', have) and not re.search(rf'\b{w}\b', want)]


def pick(cands, artist, title):
    """Acceptable Deezer candidates for artist/title, best first (originals before remixes and covers)."""
    wa, wt, wb = norm(first_artist(artist)), norm(title), norm(base_title(title))
    full_a = norm(artist)
    ok = []
    for i, t in enumerate(cands):
        ca = norm((t.get('artist') or {}).get('name'))
        ct = norm(t.get('title'))
        cb = norm(base_title(t.get('title_short') or t.get('title')))
        if wa and not (ca and (wa in ca or ca in wa or ca in full_a)):
            continue
        if not cb or not (cb == wb or cb.startswith(wb) or (wb.startswith(cb) and len(cb) >= 4)):
            continue
        bad = len(version_words(t, title, artist))
        extra = set(wt.split()) - set(wb.split()) - {'feat', 'ft', 'featuring', 'mix', 'edit', 'version', 'radio',
                                                      'original', 'remix'} - set(full_a.split())
        score = ((0 if t.get('preview') else 10) + 3 * bad + (0 if ct == wt or cb == wb else 1)
                 + (0 if not wa or ca in (wa, full_a) else 2) + (2 if extra and not extra <= set(ct.split()) else 0))
        ok.append((score, i, t))
    return [t for _, _, t in sorted(ok, key=lambda x: x[:2])]


def deezer_find(artist, title):
    fa, bt = first_artist(artist), base_title(title) or title
    queries = [f'{fa} {bt}'.strip()]
    if fa:  # advanced syntax as a fallback (it often returns nothing)
        queries.append(f'artist:"{fa}" track:"{bt}"')
    for q in queries:
        data = fetch(f'{API}/search?q={urllib.parse.quote(q)}&limit=25')
        hits = pick(data.get('data') or [], artist, title)
        if hits:
            return hits
    return []


# ---------------------------------------------------------------- audio analysis (venv)

def need_librosa():
    import importlib.util
    if importlib.util.find_spec('librosa') and importlib.util.find_spec('numpy'):
        return
    if os.environ.get('_TRACKINFO_REEXEC'):
        raise Fail(f'librosa is missing in {sys.executable}')
    if not os.path.exists(VENV_PY):
        raise Fail(f'needs the librosa venv {VENV_PY} (boot.sh rebuilds it)')
    sys.stdout.flush()
    env = dict(os.environ, _TRACKINFO_REEXEC='1')
    os.execve(VENV_PY, [VENV_PY, '-I', os.path.abspath(__file__)] + sys.argv[1:], env)


def duration(path):
    p = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', path],
                       capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
    try:
        return float(p.stdout.strip())
    except ValueError:
        return 0.0


def decode(path, start=None, dur=None):
    import numpy as np
    cmd = ['ffmpeg', '-v', 'error', '-nostdin']
    if start:
        cmd += ['-ss', f'{start:.2f}']
    cmd += ['-i', path]
    if dur:
        cmd += ['-t', f'{dur:.2f}']
    cmd += ['-vn', '-ac', '1', '-ar', str(SR), '-f', 'f32le', '-']
    p = subprocess.run(cmd, capture_output=True, timeout=180, stdin=subprocess.DEVNULL)
    if p.returncode:
        raise Fail('ffmpeg could not decode the audio')
    return np.frombuffer(p.stdout, dtype=np.float32).copy()


def refine_bpm(oenv, bpm, hop):
    """Sub-frame tempo from the onset autocorrelation peak at 8/4/2 beats (parabolic interpolation)."""
    import numpy as np
    x = oenv - oenv.mean()
    n = len(x)
    f = np.fft.rfft(x, 2 * n)
    ac = np.fft.irfft(f * np.conj(f))[:n]
    fps = SR / hop
    for k in (8, 4, 2, 1):
        lag = k * 60 * fps / bpm
        if lag * 1.04 >= n * 0.6:
            continue
        lo, hi = max(1, int(lag * 0.97)), min(n - 2, int(lag * 1.03) + 1)
        if hi <= lo:
            continue
        i = lo + int(np.argmax(ac[lo:hi + 1]))
        a, b, c = ac[i - 1], ac[i], ac[i + 1]
        den = a - 2 * b + c
        off = 0.5 * (a - c) / den if den else 0.0
        refined = k * 60 * fps / (i + off)
        if abs(refined - bpm) / bpm < 0.03:
            return float(refined)
    return float(bpm)


def analyse_audio(path, start=None, dur=None):
    import warnings
    warnings.filterwarnings('ignore')
    import numpy as np
    import librosa
    y = decode(path, start, dur)
    if len(y) < SR * 8:
        raise Fail('audio too short')
    hop = 256
    yh, yp = librosa.effects.hpss(y)
    oenv = librosa.onset.onset_strength(y=y, sr=SR, hop_length=hop, aggregate=np.median)
    tempo, beats = librosa.beat.beat_track(onset_envelope=oenv, sr=SR, hop_length=hop, start_bpm=120)
    coarse = float(np.atleast_1d(tempo)[0]) or 120.0
    if len(beats) > 8:
        med = float(np.median(np.diff(beats)))
        if med > 0:
            coarse = 60 * SR / (hop * med)
    bpm = refine_bpm(oenv, coarse, hop)
    while bpm < 70:
        bpm *= 2
    while bpm > 190:
        bpm /= 2
    alt = tempo_alt(oenv, bpm, hop)
    chroma = librosa.feature.chroma_cqt(y=yh, sr=SR, hop_length=1024, bins_per_octave=36).mean(axis=1)
    rms = librosa.feature.rms(y=y, hop_length=512)[0]
    onsets = librosa.onset.onset_detect(onset_envelope=oenv, sr=SR, hop_length=hop)
    ph, hh = float(np.sum(yp ** 2)), float(np.sum(yh ** 2))
    spec = np.abs(librosa.stft(y, n_fft=2048, hop_length=512))
    freqs = librosa.fft_frequencies(sr=SR, n_fft=2048)
    feats = {
        'rms_db': round(float(20 * np.log10(np.percentile(rms, 75) + 1e-9)), 2),
        'onset_rate': round(len(onsets) / (len(y) / SR), 3),
        'perc': round(ph / (ph + hh + 1e-12), 4),
        'hf': round(float(spec[freqs >= 4000].sum() / (spec.sum() + 1e-9)), 4),
        'seconds': round(len(y) / SR, 1),
    }
    res = {'bpm_local': round(bpm, 2), 'chroma': [round(float(v), 4) for v in chroma], 'feats': feats}
    if alt:
        res['bpm_alt'] = round(alt, 1)
    return res


def tempo_alt(oenv, bpm, hop):
    """A 3:4 / 2:3 tempo that explains the onsets about as well (latin and swing grooves), else None."""
    import numpy as np
    x = oenv - oenv.mean()
    n = len(x)
    f = np.fft.rfft(x, 2 * n)
    ac = np.fft.irfft(f * np.conj(f))[:n]
    fps = SR / hop

    def comb(b):
        vals = []
        for k in (1, 2, 3, 4):
            lag = k * 60 * fps / b
            lo, hi = int(lag * 0.98), int(lag * 1.02) + 1
            if hi >= n * 0.6:
                break
            vals.append(max(0.0, float(ac[lo:hi + 1].max())))
        return sum(vals) / (len(vals) * ac[0]) if vals and ac[0] > 0 else 0.0

    base = comb(bpm)
    alts = [b for b in (bpm * 3 / 4, bpm * 4 / 3, bpm * 2 / 3, bpm * 3 / 2) if 70 <= b <= 190]
    best = max(alts, key=comb, default=None)
    return best if best and base > 0 and comb(best) >= 0.92 * base else None


def align_bpm(local, dz):
    """Pick the octave of the local estimate nearest Deezer's BPM; (bpm, relative disagreement or None)."""
    if not dz or dz <= 0:
        return local, None
    best = min((local * f for f in (0.5, 1, 2)), key=lambda b: abs(b - dz))
    return best, abs(best - dz) / dz


def finish(res):
    """Fill bpm/key/camelot/energy from the raw analysis fields."""
    if res.get('bpm_local'):
        bpm, dis = align_bpm(res['bpm_local'], res.get('bpm_deezer'))
        if dis is not None and dis > 0.04 and res.get('bpm_alt'):
            b2, d2 = align_bpm(res['bpm_alt'], res['bpm_deezer'])  # the 3:4 / 2:3 reading matches Deezer
            if d2 <= 0.04:
                bpm, dis = b2, d2
        res['bpm_agree'] = None if dis is None else round(dis, 3)
        # Deezer's value comes from the whole track; prefer it when the 30 s preview disagrees (> 4 %)
        res['bpm'] = res['bpm_deezer'] if dis is not None and dis > 0.04 else bpm
    elif res.get('bpm_deezer'):
        res['bpm'] = res['bpm_deezer']
    if res.get('bpm'):
        b = res['bpm']
        while b > 175:  # display octave: 178 -> 89, 200 -> 100; 171 stays
            b /= 2
        while b < 70:
            b *= 2
        res['bpm'] = round(b, 1)
    res['bpm_unsure'] = bool(res.get('bpm_alt') and not res.get('bpm_deezer'))
    if res.get('chroma'):
        res['camelot'], res['key'], res['key_conf'] = estimate_key(res['chroma'])
    res['energy'] = energy_from(res.get('feats'), res.get('bpm'))
    return res


# ---------------------------------------------------------------- lists

def entry_key(e):
    if e.get('path'):
        return 'file:' + hashlib.sha1(os.path.abspath(e['path']).encode()).hexdigest()[:16]
    raw = f'{norm(first_artist(e.get("artist")))}|{norm(base_title(e.get("title")))}'
    return hashlib.sha1(raw.encode()).hexdigest()[:16]


def given(e, bpm=None, key=None, energy=None):
    try:
        b = float(str(bpm).replace(',', '.')) if bpm not in (None, '') else None
        if b and 40 <= b <= 250:
            e['given_bpm'] = round(b, 1)
    except ValueError:
        pass
    cam = parse_key(key) if key else None
    if not cam and key:
        m = re.search(r'\b(1[0-2]|[1-9])([AB])\b', str(key))
        cam = m and f'{m.group(1)}{m.group(2)}'
    if cam:
        e['given_camelot'] = cam
    m = re.search(r'(\d+(?:[.,]\d+)?)', str(energy or ''))
    if m and 0 < float(m.group(1).replace(',', '.')) <= 10:
        e['given_energy'] = float(m.group(1).replace(',', '.'))
    return e


def split_name(s):
    s = re.sub(r'^\s*\d{1,3}\s*[.)]\s+', '', s.strip())
    parts = re.split(r'\s+[-–—]\s+', s, maxsplit=1)
    if len(parts) == 2:
        return {'artist': parts[0].strip(), 'title': parts[1].strip()}
    return {'artist': '', 'title': s}


def file_entry(path, name=None):
    e = split_name(name) if name else split_name(os.path.splitext(os.path.basename(path))[0])
    e['path'] = path
    return e


def read_text(path):
    raw = sys.stdin.buffer.read() if path == '-' else open(os.path.expanduser(path), 'rb').read()
    for bom, enc in ((b'\xff\xfe', 'utf-16'), (b'\xfe\xff', 'utf-16'), (b'\xef\xbb\xbf', 'utf-8-sig')):
        if raw.startswith(bom):
            return raw.decode(enc, 'replace')
    try:
        return raw.decode('utf-8')
    except UnicodeDecodeError:
        return raw.decode('latin-1')


def is_audio(p):
    return os.path.splitext(p)[1].lower() in AUDIO_EXT and os.path.isfile(p)


def parse_table(text):
    lines = [ln for ln in text.splitlines() if ln.strip()]
    first = lines[0]
    delim = '\t' if '\t' in first else (';' if first.count(';') > first.count(',') else ',')
    rows = list(csv.reader(io.StringIO('\n'.join(lines)), delimiter=delim))
    hdr = [norm(h) for h in rows[0]]

    def col(*names):
        for n in names:
            if n in hdr:
                return hdr.index(n)
        return None

    ia = col('artist', 'artists', 'artist name')
    it = col('track title', 'title', 'name', 'track name', 'track', 'song')
    if ia is None or it is None:
        return None
    ib, ik = col('bpm', 'tempo'), col('key', 'initial key', 'musical key', 'tonality', 'camelot')
    ie, ic = col('energy'), col('comments', 'comment')
    ip, iph = col('location', 'file', 'path', 'file path'), col('phase')
    out = []
    for r in rows[1:]:
        def g(i):
            return r[i].strip() if i is not None and i < len(r) else ''
        if not g(it):
            continue
        e = {'artist': g(ia), 'title': g(it)}
        loc = g(ip)
        if loc.startswith('file://'):
            loc = urllib.parse.unquote(urllib.parse.urlsplit(loc).path)
        if loc and is_audio(loc):
            e['path'] = loc
        if g(iph):
            e['phase'] = g(iph).lower()
        energy = g(ie) or (re.search(r'energy\s*(\d+)', g(ic), re.I) or [None, ''])[1]
        out.append(given(e, g(ib), g(ik) or (g(ic) if parse_key(g(ic)[:3]) else ''), energy))
    return out


def parse_list(text, phases=None):
    phases = phases or DEFAULT_PHASES
    lines = [ln for ln in text.splitlines() if ln.strip()]
    if not lines:
        return []
    first = lines[0]
    if re.search(r'[\t,;]', first) and not first.upper().startswith('#EXT'):
        table = parse_table(text)  # None unless the header has Artist + Title/Name columns
        if table is not None:
            return table
    out, phase, pending = [], None, None
    for ln in lines:
        s = ln.strip()
        if s.upper().startswith('#EXTM3U'):
            continue
        m = re.match(r'#EXTINF:[^,]*,(.*)$', s)
        if m:
            pending = m.group(1).strip()
            continue
        m = re.fullmatch(r'(?:##+\s*|\[)\s*([A-Za-z][\w -]{0,30}?)\s*\]?\s*(?:[:(·|].*)?', s)
        if m and (s.startswith('##') or s.startswith('[')):
            name = re.sub(r'[\s_-]+', '', m.group(1).lower())
            if name in phases:  # other "##" lines are comments
                phase = name
            continue
        if s.startswith('#'):
            continue
        p = os.path.expanduser(s)
        if s.startswith('file://'):
            p = urllib.parse.unquote(urllib.parse.urlsplit(s).path)
        if is_audio(p):
            e = file_entry(p, pending)
        elif pending:
            e = split_name(pending)
        else:
            m = re.match(r'([A-Za-z]+):\s+(.+)$', s)
            ph = None
            if m and m.group(1).lower() in phases:
                ph, s = m.group(1).lower(), m.group(2)
            cols = [c.strip() for c in s.split('|')]
            e = split_name(cols[0])
            given(e, *(cols[1:4] + [None] * (3 - len(cols[1:4]))))
            if ph:
                e['phase'] = ph
        pending = None
        if phase and 'phase' not in e:
            e['phase'] = phase
        out.append(e)
    return out


# ---------------------------------------------------------------- analysis driver

def apply_given(res, e):
    r = dict(res)
    r['artist'] = r.get('artist') or e.get('artist', '')
    r['title'] = r.get('title') or e.get('title', '')
    r['want'] = label(e)
    if e.get('phase'):
        r['phase'] = e['phase']
    src = []
    if e.get('given_bpm'):
        r['bpm'] = e['given_bpm']
        src.append('bpm')
    if e.get('given_camelot'):
        r['camelot'] = e['given_camelot']
        r['key'] = key_name(e['given_camelot'])
        src.append('key')
    if e.get('given_energy'):
        r['energy'] = e['given_energy']
        src.append('energy')
    if src:
        r['from_list'] = src
    if r.get('energy') is None and r.get('bpm'):
        r['energy'] = energy_from(None, r['bpm'])
    if not r.get('bpm') and not r.get('camelot') and not r.get('error'):
        r['error'] = 'no analysis (offline)'
    return r


def analyse_one(e, cache, refresh=False, offline=False):
    k = entry_key(e)
    hit = cache.get(k)
    if hit and not refresh and (not hit.get('error') or offline or time.time() - hit.get('t', 0) < NOTFOUND_RETRY):
        return apply_given(finish(dict(hit)), e)
    has_all = e.get('given_bpm') and e.get('given_camelot') and e.get('given_energy')
    if offline or has_all:
        return apply_given({}, e)
    res = {}
    try:
        if e.get('path'):
            d = duration(e['path'])
            start = max(0.0, d / 2 - 30) if d > 75 else None
            res = analyse_audio(e['path'], start, 60 if d > 75 else None)
            res.update(artist=e.get('artist', ''), title=e.get('title', ''), source='file')
        else:
            hits = deezer_find(e.get('artist', ''), e.get('title', ''))
            if not hits:
                res = {'error': 'not found on Deezer'}
            else:
                t = hits[0]
                info = fetch(f'{API}/track/{t["id"]}')
                res = {'deezer_id': t['id'], 'artist': (t.get('artist') or {}).get('name', ''),
                       'title': t.get('title', ''), 'source': 'deezer preview',
                       'bpm_deezer': float(info.get('bpm') or 0) or None, 'gain': info.get('gain')}
                vw = version_words(t, e.get('title', ''), e.get('artist', ''))
                if vw:
                    res['version'] = vw[0]
                for other in [h for h in hits[1:] if not version_words(h, e.get('title', ''), e.get('artist', ''))][:2]:
                    if res['bpm_deezer']:
                        break
                    b = float(fetch(f'{API}/track/{other["id"]}').get('bpm') or 0)
                    if b > 0:  # the same song in another release
                        res['bpm_deezer'] = b
                prev = info.get('preview') or t.get('preview')
                if not prev:
                    res['error'] = 'no preview on Deezer'
                else:
                    audio = fetch(prev, timeout=30, raw=True)
                    os.makedirs(STATE, exist_ok=True)
                    with tempfile.NamedTemporaryFile(dir=STATE, prefix='.preview-', suffix='.mp3') as fh:
                        fh.write(audio)
                        fh.flush()
                        res.update(analyse_audio(fh.name))
    except Fail as ex:
        return apply_given({'error': str(ex)}, e)  # transient: not cached
    res['t'] = int(time.time())
    cache[k] = res
    return apply_given(finish(dict(res)), e)


def analyse_all(entries, refresh=False, offline=False, progress=True):
    cache = jsonstate.load(CACHE, {})
    todo = [e for e in entries if refresh or entry_key(e) not in cache]
    if todo and not offline:
        need_librosa()
    out = []
    for i, e in enumerate(entries, 1):
        fresh = refresh or entry_key(e) not in cache
        if progress and fresh and not offline and sys.stderr.isatty():
            print(f'  [{i}/{len(entries)}] {label(e)}', file=sys.stderr)
        out.append(analyse_one(e, cache, refresh, offline))
        if fresh and not offline:
            write_json(CACHE, cache)
    return out


def fmt_track(r):
    if r.get('error') and not r.get('bpm'):
        return f'  {"--":>6}  {"--":>3}  {"":<4}  {"":>5}  {r.get("want") or label(r)}  ({r["error"]})'
    bpm = (f'{r["bpm"]:.1f}' + ('?' if r.get('bpm_unsure') else '')) if r.get('bpm') else '--'
    cam = r.get('camelot') or '--'
    key = (r.get('key') or '') + ('?' if (r.get('key_conf') or 1) < 0.03 else '')
    en = f'E{r["energy"]:.1f}' if r.get('energy') is not None else ''
    notes = []
    if r.get('bpm_deezer'):
        notes.append(f'deezer {r["bpm_deezer"]:g}')
    if r.get('bpm_unsure'):
        notes.append(f'or {r["bpm_alt"]:g}')
    if r.get('version'):
        notes.append(f'{r["version"]} version')
    if r.get('from_list'):
        notes.append('list: ' + ','.join(r['from_list']))
    name = label(r)
    if r.get('want') and norm(base_title(r['want'].split(' - ')[-1])) not in norm(name):
        notes.append(f'for "{r["want"]}"')
    tail = f'  [{"; ".join(notes)}]' if notes else ''
    return f'  {bpm:>6}  {cam:>3}  {key:<4}  {en:>5}  {name}{tail}'


# ---------------------------------------------------------------- set ordering

def pair_info(a, b):
    kd = cam_dist(a.get('camelot'), b.get('camelot'))
    j, f = bpm_jump(a.get('bpm'), b.get('bpm'))
    flags = []
    if kd is None or kd > MAX_KEY_STEP:
        flags.append('key')
    if j is None or j > MAX_BPM_JUMP:
        flags.append('bpm')
    return kd, j, f, flags


def en(t):
    return t.get('energy') if t.get('energy') is not None else 5.0


def pair_cost(a, b):
    kd, j, f, flags = pair_info(a, b)
    kd = 3 if kd is None else kd
    j = 0.1 if j is None else j
    ea, eb = en(a), en(b)
    # a flagged transition costs 10 per kind; an energy drop of ~3 costs as much (energy rises within a phase)
    drop = max(0.0, felt(a.get('bpm')) - felt(b.get('bpm')))  # tempo should rise too (10 BPM down = 1.5)
    return ((10 if 'key' in flags else 0) + 0.5 * kd + (10 if 'bpm' in flags else 0) + 15 * j
            + (0.5 if f != 1 else 0) + 3 * max(0.0, ea - eb) + 0.2 * abs(eb - ea) + 0.15 * drop)


def felt(bpm):
    b = bpm or 120.0
    while b >= 160:
        b /= 2
    while b < 80:
        b *= 2
    return b


def start_cost(t, seq, prev):
    return (pair_cost(prev, t) if prev else 0.0) + 0.5 * (en(t) - min(en(x) for x in seq))


def seq_cost(seq, prev=None):
    return start_cost(seq[0], seq, prev) + sum(pair_cost(a, b) for a, b in zip(seq, seq[1:]))


def exact_order(tracks, prev=None):
    """Cheapest order by Held-Karp dynamic programming (the cost is pairwise); fine up to ~15 tracks."""
    n = len(tracks)
    C = [[pair_cost(a, b) for b in tracks] for a in tracks]
    S = [start_cost(t, tracks, prev) for t in tracks]
    INF = float('inf')
    full = (1 << n) - 1
    dp = [[INF] * n for _ in range(1 << n)]
    back = [[-1] * n for _ in range(1 << n)]
    for j in range(n):
        dp[1 << j][j] = S[j]
    for mask in range(1, full + 1):
        row = dp[mask]
        bits = [i for i in range(n) if mask >> i & 1]
        if len(bits) < 2:
            continue
        for j in bits:
            pm = mask ^ (1 << j)
            prow = dp[pm]
            best, arg = INF, -1
            for i in bits:
                if i != j:
                    v = prow[i] + C[i][j]
                    if v < best:
                        best, arg = v, i
            row[j], back[mask][j] = best, arg
    j = min(range(n), key=lambda k: dp[full][k])
    order, mask = [], full
    while j != -1:
        order.append(j)
        j, mask = back[mask][j], mask ^ (1 << j)
    return [tracks[i] for i in reversed(order)]


def improve(seq, prev):
    best = seq_cost(seq, prev)
    for _ in range(25):
        moved = False
        for i in range(len(seq)):
            for j in range(len(seq)):
                if i == j:
                    continue
                s2 = seq[:]
                s2.insert(j, s2.pop(i))
                c = seq_cost(s2, prev)
                if c < best - 1e-9:
                    seq, best, moved = s2, c, True
        if not moved:
            break
    return seq


def order_phase(tracks, prev=None):
    if len(tracks) <= 1:
        return list(tracks)
    if len(tracks) <= 15:
        return exact_order(list(tracks), prev)
    best = None
    for s in sorted(tracks, key=en)[:4]:
        seq, rem = [s], [t for t in tracks if t is not s]
        while rem:
            ranked = sorted(rem, key=en)
            rk = {id(t): i / max(1, len(ranked) - 1) for i, t in enumerate(ranked)}
            nxt = min(rem, key=lambda t: pair_cost(seq[-1], t) + 1.5 * rk[id(t)])
            seq.append(nxt)
            rem.remove(nxt)
        seq = improve(seq, prev)
        c = seq_cost(seq, prev)
        if best is None or c < best[0]:
            best = (c, seq)
    return best[1]


def assign_phases(tracks, phases):
    labelled = [t for t in tracks if t.get('phase') in phases]
    if labelled:
        means = {}
        for p in phases:
            es = [en(t) for t in labelled if t['phase'] == p]
            if es:
                means[p] = sum(es) / len(es)
        for t in tracks:
            if t.get('phase') not in phases:
                t['phase'] = min(means, key=lambda p: abs(means[p] - en(t)))
        return
    s = sorted(tracks, key=lambda t: (en(t), t.get('bpm') or 0))
    k = len(phases)
    for i, t in enumerate(s):
        t['phase'] = phases[min(k - 1, i * k // len(s))]


def tip(a, b, kd, j, f, flags, pool):
    parts = []
    if 'key' in flags:
        parts.append(f'key {a.get("camelot") or "?"}→{b.get("camelot") or "?"}')
    if 'bpm' in flags and j is not None:
        sign = '+' if (b['bpm'] * f) >= a['bpm'] else '-'
        played = f' = {b["bpm"] * f:.0f} {"double" if f == 2 else "half"}-time' if f != 1 else ''
        parts.append(f'BPM {sign}{j * 100:.0f} % ({a["bpm"]:.0f}→{b["bpm"]:.0f}{played})')
    if flags == ['key']:
        how = 'mix on a breakdown or drum intro, or echo out and drop in'
    elif flags == ['bpm']:
        how = 'cut on the first beat of a phrase, or ride the pitch over 16-32 bars'
    else:
        how = 'echo out / cut on a phrase start; no blend'
    bridge = None
    for t in sorted(pool, key=lambda t: abs(en(t) - (en(a) + en(b)) / 2)):
        if t is a or t is b:
            continue
        if not pair_info(a, t)[3] and not pair_info(t, b)[3]:
            bridge = label(t)
            break
    return ', '.join(parts), how, bridge


def build_set(results, phases):
    ok = [r for r in results if r.get('bpm') and r.get('camelot')]
    missing = [r for r in results if not (r.get('bpm') and r.get('camelot'))]
    assign_phases(ok, phases)
    ordered, prev, out_phases = [], None, []
    for p in phases:
        seq = order_phase([t for t in ok if t['phase'] == p], prev)
        if seq:
            prev = seq[-1]
        ordered += seq
        out_phases.append({'name': p, 'tracks': seq})
    trans = []
    for i, (a, b) in enumerate(zip(ordered, ordered[1:])):
        kd, j, f, flags = pair_info(a, b)
        t = {'i': i, 'from': label(a), 'to': label(b), 'key_dist': kd,
             'bpm_jump': None if j is None else round(j, 3), 'half_double': f != 1,
             'energy_delta': round(en(b) - en(a), 1), 'phase_change': a['phase'] != b['phase'], 'flags': flags}
        if flags:
            t['what'], t['tip'], t['bridge'] = tip(a, b, kd, j, f, flags, ok)
            t['severity'] = 'hard' if len(flags) == 2 or (j or 1) > 0.10 else 'cut'
        trans.append(t)
    return {'phases': out_phases, 'transitions': trans, 'missing': missing, 'count': len(ordered), '_order': ordered}


def set_json(s):
    keep = ('artist', 'title', 'want', 'phase', 'bpm', 'bpm_deezer', 'bpm_unsure', 'bpm_alt', 'camelot', 'key',
            'key_conf', 'energy', 'version', 'deezer_id', 'from_list', 'error')
    slim = lambda r: {k: r[k] for k in keep if r.get(k) is not None}  # noqa: E731
    return {'phases': [{'name': p['name'], 'tracks': [slim(t) for t in p['tracks']]} for p in s['phases']],
            'transitions': s['transitions'], 'missing': [slim(r) for r in s['missing']], 'count': s['count']}


def print_set(s):
    n = 0
    flagged = {t['i']: t for t in s['transitions'] if t['flags']}
    for p in s['phases']:
        tr = p['tracks']
        if not tr:
            continue
        bpms = [t['bpm'] for t in tr]
        ens = [en(t) for t in tr]
        print(f'{p["name"].upper()}  ({len(tr)} tracks, {min(bpms):.0f}-{max(bpms):.0f} BPM, '
              f'energy {min(ens):.1f}-{max(ens):.1f})')
        for t in tr:
            n += 1
            print(f' {n:>2}{fmt_track(t)}')
            f = flagged.get(n - 1)
            if f:
                extra = f'; bridge: {f["bridge"]}' if f.get('bridge') else ''
                print(f'      !! {f["what"]}: {f["tip"]}{extra}')
    hard = sum(1 for t in flagged.values() if t['severity'] == 'hard')
    at_change = sum(1 for t in flagged.values() if t['phase_change'])
    print(f'{s["count"]} tracks, {len(flagged)} flagged transition(s), {hard} hard'
          + (f' ({at_change} at phase changes)' if at_change else ''))
    for r in s['missing']:
        print(f'  not in the set: {r.get("want") or label(r)} ({r.get("error") or "no BPM/key"})')


