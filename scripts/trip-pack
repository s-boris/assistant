class Fail(Exception):
    pass


def load_countries():
    """Merge the private country table (places the public script must not name) into COUNTRIES."""
    x = jsonstate.load(COUNTRIES_FILE, {})
    for k, v in (x.get("countries", x) if isinstance(x, dict) else {}).items():
        if not (isinstance(v, dict) and re.fullmatch(r"[A-Za-z]{2}", str(k)) and v.get("name") and v.get("cur") and v.get("plug")):
            continue
        COUNTRIES[k.upper()] = {"eu": False, "europe": False, "extra": "", **v,
                                "tips": [t for t in v.get("tips") or [] if isinstance(t, str)],
                                "rail": [tuple(r) for r in v.get("rail") or [] if isinstance(r, (list, tuple)) and len(r) == 2]}


def now():
    n = E("TRIP_PACK_NOW")
    return datetime.strptime(n, "%Y-%m-%d %H:%M") if n else datetime.now(TZ).replace(tzinfo=None)


def span(a, b):
    if a == b:
        return f"{a:%a} {a.day}.{a.month}."
    if a.year != b.year:
        return f"{a.day}.{a.month}.{a.year}–{b.day}.{b.month}.{b.year}"
    return f"{a:%a} {a.day}.–{b:%a} {b.day}.{b.month}." if a.month == b.month else f"{a:%a} {a.day}.{a.month}.–{b:%a} {b.day}.{b.month}."


def ddmm(d):
    return f"{d.day:02d}.{d.month:02d}"


def slug(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-") or "trip"


def trips():
    x = jsonstate.load(TRIPS, {})
    out = []
    for t in (x.get("trips") if isinstance(x, dict) else x) or []:
        if not isinstance(t, dict) or not t.get("name"):
            continue
        try:
            t = dict(t, _from=date.fromisoformat(str(t["from"])), _to=date.fromisoformat(str(t.get("to") or t["from"])))
        except (KeyError, ValueError):
            t = dict(t, _from=None, _to=None)
        out.append(t)
    return out


def find_trip(q):
    q = q.strip().lower()
    ts = trips()
    for pred in (lambda t: t["name"].lower() == q, lambda t: q in t["name"].lower(),
                 lambda t: any(q in str(m).lower() or str(m).lower() in q for m in t.get("match") or [] if m)):
        hit = [t for t in ts if pred(t)]
        if hit:
            dated = [t for t in hit if t["_from"]]
            return (dated or hit)[0]
    return None


# ---------------------------------------------------------------- fetch (network seam)
def fetch(kind, url):
    if FIXTURES:
        p = os.path.join(FIXTURES, f"{kind}.json")
        if not os.path.exists(p):
            raise Fail(f"{kind}: no fixture")
        return jsonstate.load(p, None)
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with web.open(req, timeout=20) as r:
            return json.loads(r.read().decode())
    except Exception as e:  # network, HTTP or JSON: the pack still gets written
        raise Fail(f"{kind}: {type(e).__name__}")


def geocode(p, problems, offline):
    if isinstance(p.get("lat"), (int, float)) and isinstance(p.get("lon"), (int, float)):
        return p["lat"], p["lon"]
    key = f"{p['town'].lower()}|{(p.get('country') or '').upper()}"
    cache = jsonstate.load(os.path.join(CACHE, "geo.json"), {}) if not FIXTURES else {}
    if key in cache:
        return tuple(cache[key])
    if offline:
        return None
    q = {"name": p["town"], "count": 5, "language": "en", "format": "json"}
    if p.get("country"):
        q["countryCode"] = p["country"].upper()
    try:
        d = fetch("geocode", "https://geocoding-api.open-meteo.com/v1/search?" + urllib.parse.urlencode(q))
        res = [r for r in (d or {}).get("results") or [] if not p.get("country") or r.get("country_code", "").upper() == p["country"].upper()]
        if not res:
            raise Fail(f"geocode: {p['town']} not found")
        ll = (round(res[0]["latitude"], 4), round(res[0]["longitude"], 4))
    except (Fail, KeyError, TypeError) as e:
        problems.append(str(e) if isinstance(e, Fail) else f"geocode: {type(e).__name__}")
        return None
    if not FIXTURES:
        cache[key] = ll
        try:
            os.makedirs(CACHE, exist_ok=True)
            with open(os.path.join(CACHE, "geo.json"), "w") as f:
                json.dump(cache, f)
        except OSError:
            pass
    return ll


def weather(places, today, problems, offline):
    out = []
    for p in places:
        days = [p["_from"] + timedelta(days=i) for i in range((p["_to"] - p["_from"]).days + 1)]
        days = [d for d in days if d >= today]
        if not days:
            continue
        w = {"town": p["town"], "days": [], "note": None}
        near = [d for d in days if (d - today).days <= FORECAST_DAYS]
        far = [d for d in days if d not in near]
        if far:
            w["note"] = f"Forecast from {ddmm(far[0] - timedelta(days=FORECAST_DAYS))}" + (
                f" (for {ddmm(far[0])})" if near else "")
        if near and offline:
            w["note"] = "No forecast (built offline)"
        elif near:
            ll = geocode(p, problems, offline)
            if not ll:
                w["note"] = "No forecast (place not found)"
            else:
                q = {"latitude": ll[0], "longitude": ll[1], "timezone": "auto", "start_date": near[0].isoformat(),
                     "end_date": near[-1].isoformat(), "daily": "weather_code,temperature_2m_max,temperature_2m_min,"
                     "precipitation_probability_max,precipitation_sum,wind_speed_10m_max"}
                try:
                    d = (fetch("forecast", "https://api.open-meteo.com/v1/forecast?" + urllib.parse.urlencode(q)) or {})["daily"]
                    for i, ds in enumerate(d["time"]):
                        code = d["weather_code"][i]
                        icon, txt = next(((ic, t) for codes, ic, t in WMO if code in codes), ("·", "–"))
                        w["days"].append({"date": ds, "icon": icon, "text": txt, "tmax": d["temperature_2m_max"][i],
                                          "tmin": d["temperature_2m_min"][i],
                                          "rain_pct": d["precipitation_probability_max"][i],
                                          "rain_mm": d["precipitation_sum"][i], "wind": d["wind_speed_10m_max"][i]})
                except Fail as e:
                    problems.append(str(e))
                    w["note"] = "Forecast unavailable when built"
                except (KeyError, TypeError, IndexError):
                    problems.append("forecast: unexpected answer")
                    w["note"] = "Forecast unavailable when built"
        out.append(w)
    return out


# ---------------------------------------------------------------- calendar legs (calcache)
def local_dt(s):
    d = datetime.fromisoformat(s)
    return d.astimezone(TZ).replace(tzinfo=None) if d.tzinfo else d


def calendar(t, problems):
    """(legs, events, note): calcache travel legs and the trip's own calendar events; note when not cached."""
    try:
        r = subprocess.run([os.path.join(BIN, "calcache"), "age", "--json"], capture_output=True, text=True, timeout=10)
        age = json.loads(r.stdout or "{}") if r.returncode in (0, 1) else {}
        r = subprocess.run([os.path.join(BIN, "calcache"), "show", "--days", "21", "--json"], capture_output=True,
                           text=True, timeout=10)
        if r.returncode == 3:
            return [], [], "Calendar not cached"
        if r.returncode != 0:
            raise Fail("calendar: calcache failed")
        evs = json.loads(r.stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired, Fail) as e:
        problems.append(str(e) if isinstance(e, Fail) else "calendar: calcache failed")
        return [], [], "Calendar unavailable when built"
    win = (age or {}).get("window") or []
    note = None
    if len(win) == 2 and win[1] < t["_to"].isoformat():
        note = f"Calendar cached only up to {ddmm(date.fromisoformat(win[1]))}"
    words = [str(m).lower() for m in t.get("match") or [] if m] + [t["name"].lower()] + \
            [p["town"].lower() for p in t["places"]]
    legs, own = [], []
    for e in evs if isinstance(evs, list) else []:
        try:
            if e.get("all_day"):
                s, en = datetime.fromisoformat(e["start"][:10]), datetime.fromisoformat(e["end"][:10])
            else:
                s, en = local_dt(e["start"]), local_dt(e["end"])
        except (KeyError, TypeError, ValueError):
            continue
        f, title = e.get("flags") or {}, str(e.get("title") or "")
        hit = any(w and w in (title + " " + str(e.get("town") or "")).lower() for w in words)
        if f.get("travel"):
            d = s.date()
            inside = t["_from"] <= d <= t["_to"]
            edge = t["_from"] - timedelta(days=1) <= d <= t["_to"] + timedelta(days=1)
            if inside or (edge and (hit or f.get("travel") == "flight" or f.get("abroad"))):
                legs.append({"start": s.isoformat(timespec="minutes"), "end": en.isoformat(timespec="minutes"),
                             "title": title, "kind": f.get("travel"), "_s": s, "_e": en})
        elif hit and s.date() <= t["_to"] and (en - timedelta(seconds=1)).date() >= t["_from"]:
            own.append({"title": title, "start": s.date().isoformat() if e.get("all_day") else s.isoformat(timespec="minutes"),
                        "all_day": bool(e.get("all_day")), "_s": s, "_e": en})
    return sorted(legs, key=lambda g: g["_s"]), own, note


# ---------------------------------------------------------------- packing
def packing(t, countries, home_c, problems):
    d = jsonstate.load(TEMPLATES, None)
    types = {str(k).lower(): v for k, v in ((d or {}).get("types") or {}).items() if isinstance(v, dict)}
    kind = str(t.get("type") or ("business" if t.get("abroad") or any(c != home_c for c in countries) else "")).lower()
    tpl = types.get(kind) or {}
    if kind and not tpl:
        problems.append(f"packing: no {kind} template")
    items = [x.strip() for x in tpl.get("items") or [] if isinstance(x, str) and x.strip()]
    hc = COUNTRIES.get(home_c, {})
    curs = sorted({COUNTRIES[c]["cur"] for c in countries if c in COUNTRIES and COUNTRIES[c]["cur"] != hc.get("cur")})
    plugs = sorted({COUNTRIES[c]["plug"] for c in countries if c in COUNTRIES and COUNTRIES[c]["plug"] != hc.get("plug")})
    reasons = {"abroad": any(c != home_c for c in countries), "cash": bool(curs), "adapter": bool(plugs and hc),
               "overnight": t["_to"] > t["_from"]}
    extra = []
    for reason, item, pat in EXTRAS:
        item = item.format(cur="/".join(curs), plugs="type " + " / ".join(plugs))
        pat = pat.format(cur="|".join(map(re.escape, curs)) or "x^")
        if reasons[reason] and not any(re.search(pat, x, re.I) for x in extra + items):
            extra.append(item)
    return {"type": kind or None, "label": tpl.get("label") or kind or None, "emoji": tpl.get("emoji"),
            "items": extra + items}


# ---------------------------------------------------------------- model
def _txt(x, n=600):
    return str(x).strip()[:n] if isinstance(x, (str, int, float)) and str(x).strip() else ""


def _link_ok(u):
    return bool(re.match(r"^(https?://|tel:|mailto:)\S+$", u))


def clean_block(b):
    """One extras block -> {title, intro, note, rows, table, items, links} with only well-formed parts, or None."""
    if not isinstance(b, dict):
        return None
    out = {"title": _txt(b.get("title"), 120), "intro": _txt(b.get("intro"), 1200), "note": _txt(b.get("note"), 1200),
           "rows": [], "table": None, "items": [], "links": []}
    for r in b.get("rows") or []:
        if isinstance(r, (list, tuple)) and len(r) >= 2 and _txt(r[1]):
            out["rows"].append([_txt(r[0], 60), _txt(r[1], 1200)])
    tb = b.get("table")
    if isinstance(tb, dict) and isinstance(tb.get("rows"), list):
        head = [_txt(h, 60) for h in tb.get("head") or []]
        rows = [[_txt(c, 400) for c in r] for r in tb["rows"] if isinstance(r, (list, tuple)) and r]
        if rows:
            out["table"] = {"head": head, "rows": rows}
    out["items"] = [_txt(i, 1200) for i in b.get("items") or [] if _txt(i)]
    for lk in b.get("links") or []:
        if isinstance(lk, (list, tuple)) and len(lk) == 2 and _link_ok(str(lk[1])):
            out["links"].append([_txt(lk[0], 120) or str(lk[1]), str(lk[1])])
    if not any((out["intro"], out["note"], out["rows"], out["table"], out["items"], out["links"])) and not b.get("groups"):
        return None
    return out


def load_extras(t, problems):
    """The trip's own pages from its extras file: day by day, sections, emergency lines. Never raises."""
    empty = {"days": [], "days_title": "Day by day", "sections": [], "emergency": []}
    given = t.get("extras")
    path = os.path.expanduser(str(given)) if given else os.path.join(EXTRAS_DIR, slug(t["name"]) + ".json")
    if not given and not os.path.exists(path):
        return empty
    try:
        with open(path) as f:
            x = json.load(f)
        if not isinstance(x, dict):
            raise ValueError("not an object")
    except (OSError, ValueError):
        problems.append(f"extras: {os.path.basename(path)} unreadable")
        return empty
    base = os.path.dirname(os.path.abspath(path))
    days = []
    for d in x.get("days") or []:
        if not isinstance(d, dict):
            continue
        try:
            day = date.fromisoformat(str(d.get("date")))
        except ValueError:
            continue
        days.append({"date": day.isoformat(), "label": f"{day:%a} {ddmm(day)}", "where": _txt(d.get("where"), 60),
                     "title": _txt(d.get("title"), 200), "tag": _txt(d.get("tag"), 30),
                     "items": [_txt(i, 600) for i in d.get("items") or [] if _txt(i)]})
    days.sort(key=lambda d: d["date"])
    sections, ids = [], set()
    for s in x.get("sections") or []:
        if isinstance(s, dict) and s.get("include"):
            ip = os.path.expanduser(str(s["include"]))
            ip = ip if os.path.isabs(ip) else os.path.join(base, ip)
            try:
                with open(ip) as f:
                    inc = json.load(f)
                if not isinstance(inc, dict):
                    raise ValueError("not an object")
            except (OSError, ValueError):
                problems.append(f"extras: {os.path.basename(ip)} unreadable")
                continue
            s = dict(inc, **{k: v for k, v in s.items() if k != "include"})
        sec = clean_block(s)
        if not sec or not sec["title"]:
            continue
        sid = slug(str(s.get("id") or sec["title"]))[:24] or "extra"
        sid = "x-" + sid if sid in BUILTIN_IDS else sid
        while sid in ids:
            sid += "-2"
        ids.add(sid)
        groups = [g for g in (clean_block(g) for g in s.get("groups") or []) if g]
        sections.append(dict(sec, id=sid, groups=groups))
    emergency = [{"where": _txt(e.get("where"), 60), "text": _txt(e.get("text"), 600)}
                 for e in x.get("emergency") or [] if isinstance(e, dict) and _txt(e.get("text"))]
    return {"days": days, "days_title": _txt(x.get("days_title"), 60) or "Day by day", "sections": sections,
            "emergency": emergency}


def build(t, offline):
    load_countries()
    today, problems = now().date(), []
    places = []
    for p in t.get("places") or []:
        if not isinstance(p, dict) or not p.get("town"):
            continue
        try:
            pf = date.fromisoformat(str(p.get("from") or t["_from"]))
            pt = date.fromisoformat(str(p.get("to") or p.get("from") or t["_to"]))
        except ValueError:
            pf, pt = t["_from"], t["_to"]
        places.append(dict(p, country=str(p.get("country") or "").upper(), _from=pf, _to=pt))
    t = dict(t, places=places)
    home_c = str(assistant_profile.get("locale.country", "") or "").upper()
    home_town = assistant_profile.get("home.town", "") or ""
    countries = list(dict.fromkeys(p["country"] for p in places if p["country"]))
    legs, own, cal_note = calendar(t, problems)
    if not places:   # no places listed: the towns of the trip's own calendar events
        towns = list(dict.fromkeys(re.sub(r".*\(([^)]+)\)\s*$", r"\1", e["title"]) for e in own if "(" in e["title"]))
        places = [{"town": x, "country": "", "_from": t["_from"], "_to": t["_to"]} for x in towns]
    transport, tips = [], []
    for c in countries:
        info = COUNTRIES.get(c)
        if info:
            transport += [{"label": l, "url": u, "where": info["name"]} for l, u in info["rail"]]
            tips += [{"where": info["name"], "text": x} for x in info["tips"]]
    cities = dict(CITIES)
    extra = jsonstate.load(CITIES_FILE, {})
    for k, v in (extra if isinstance(extra, dict) else {}).items():
        if isinstance(v, dict):
            cities[k.lower()] = {"aliases": v.get("aliases") or [], "links": [tuple(x) for x in v.get("links") or []]}
    seen = set()
    for p in places:
        name = p["town"].lower()
        for k, v in cities.items():
            if k not in seen and (name == k or name in v["aliases"]):
                seen.add(k)
                transport += [{"label": l, "url": u, "where": p["town"]} for l, u in v["links"]]
    for x in t.get("links") or []:
        if isinstance(x, dict) and x.get("url"):
            transport.append({"label": x.get("label") or x["url"], "url": x["url"], "where": x.get("where") or ""})
    hc = COUNTRIES.get(home_c, {})
    money = []
    nofx = {COUNTRIES[c]["cur"] for c in countries if c in COUNTRIES and COUNTRIES[c].get("fx") is False}
    for cur in sorted({COUNTRIES[c]["cur"] for c in countries if c in COUNTRIES}):
        m = {"currency": cur, "rate": None, "rate_date": None}
        if cur in nofx:
            m["note"] = "no reference rate"
        elif hc and cur != hc["cur"] and not offline:
            try:
                fx = fetch("fx", f"https://api.frankfurter.dev/v2/rate/{hc['cur']}/{cur}") or {}
                if fx.get("quote") != cur:
                    raise Fail(f"fx: no rate for {cur}")
                m.update(rate=round(float(fx["rate"]), 4), rate_date=fx.get("date"), base=hc["cur"])
            except (Fail, AttributeError, KeyError, TypeError, ValueError) as e:
                problems.append(str(e) if isinstance(e, Fail) else "fx: unexpected answer")
        money.append(m)
    abroad = [c for c in countries if c != home_c]
    roaming = None
    if hc and not hc.get("eu") and any(COUNTRIES.get(c, {}).get("eu") for c in abroad):
        roaming = (f"{hc.get('adj', hc['name'])} plans don't fall under the EU's roam-like-at-home rules. Check your plan "
                   "before you leave: EU data included? Otherwise add a roaming pack or an eSIM, and keep data roaming "
                   "off until then.")
    far = [c for c in abroad if c in COUNTRIES and not COUNTRIES[c].get("europe")]
    if hc and far and not roaming:
        roaming = (f"{hc.get('adj', hc['name'])} plans charge a lot for roaming outside Europe. Check your plan before you "
                   "leave: add a roaming pack or a local/eSIM data plan, and keep data roaming off until then.")
    if not countries or any(COUNTRIES.get(c, {"europe": True}).get("europe") for c in countries):
        emergency = [{"where": "Europe", "text": "112: emergency, free from any phone"}]
    else:
        emergency = [{"where": "Mobile", "text": "112 often reaches the local emergency line from a mobile; the local "
                                                 "numbers below come first"}]
    emergency += [{"where": COUNTRIES[c]["name"], "text": COUNTRIES[c]["extra"]} for c in countries
                  if c in COUNTRIES and COUNTRIES[c]["extra"]]
    plugs = [{"where": COUNTRIES[c]["name"], "type": COUNTRIES[c]["plug"]} for c in countries if c in COUNTRIES]
    w = weather(places, today, problems, offline)
    ex = load_extras(t, problems)
    emergency = ex["emergency"] + emergency
    planned = [x for x in t.get("legs") or [] if isinstance(x, str) and x]
    return {
        "trip": t["name"], "emoji": t.get("emoji") or "🧳", "from": t["_from"].isoformat(), "to": t["_to"].isoformat(),
        "dates": span(t["_from"], t["_to"]), "days_until": (t["_from"] - today).days, "home_town": home_town,
        "places": [{k: v for k, v in p.items() if not k.startswith("_")} | {"dates": span(p["_from"], p["_to"])}
                   for p in places],
        "calendar": [{k: v for k, v in e.items() if not k.startswith("_")} for e in own],
        "legs": [{k: v for k, v in g.items() if not k.startswith("_")} | {"when": f"{g['_s']:%a} {ddmm(g['_s'])} {g['_s']:%H:%M}–{g['_e']:%H:%M}"}
                 for g in legs],
        "legs_note": None if legs else "Legs not booked yet", "calendar_note": cal_note, "planned": planned,
        "transport": transport, "tips": tips, "weather": w, "money": money, "plugs": plugs,
        "emergency": emergency, "roaming": roaming, "packing": packing(t, countries, home_c, problems),
        "built": now().strftime("%Y-%m-%d %H:%M"), "problems": problems,
        "days": ex["days"], "days_title": ex["days_title"], "extras": ex["sections"],
    }


