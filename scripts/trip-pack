def esc(s):
    return html.escape(str(s if s is not None else ""))


def block(b, sub=False):
    out = f'<h3>{esc(b["title"])}</h3>' if sub and b["title"] else ""
    if b["intro"]:
        out += f"<p>{esc(b['intro'])}</p>"
    if b["note"]:
        out += f'<p class="note">{esc(b["note"])}</p>'
    if b["rows"]:
        out += '<ul class="rows">' + "".join(f'<li><span class="when">{esc(a)}</span><span>{esc(c)}</span></li>'
                                            for a, c in b["rows"]) + "</ul>"
    if b["table"]:
        tb = b["table"]
        head = "<tr>" + "".join(f"<th>{esc(h)}</th>" for h in tb["head"]) + "</tr>" if tb["head"] else ""
        out += f'<div class="tw"><table>{head}' + "".join(
            "<tr>" + "".join(f"<td>{esc(c)}</td>" for c in r) + "</tr>" for r in tb["rows"]) + "</table></div>"
    if b["items"]:
        out += "<ul>" + "".join(f"<li>{esc(i)}</li>" for i in b["items"]) + "</ul>"
    if b["links"]:
        out += '<p class="muted">' + " · ".join(f'<a href="{esc(u)}">{esc(lb)}</a>' for lb, u in b["links"]) + "</p>"
    return out


def render(m):
    secs = []

    def sec(sid, title, body):
        secs.append((sid, title, f'<section id="{sid}"><h2>{esc(title)}</h2>{body}</section>'))

    rows = "".join(f'<li><span class="when">{esc(p["dates"])}</span><span><b>{esc(p["town"])}</b>'
                   f'{", " + esc(COUNTRIES.get(p["country"], {}).get("name", p["country"])) if p["country"] else ""}'
                   f'{" · " + esc(p["what"]) if p.get("what") else ""}</span></li>' for p in m["places"])
    cal = "".join(f'<li><span class="when">{"all day" if e["all_day"] else esc(e["start"][11:16])}</span>'
                  f'<span>📅 {esc(e["title"])}</span></li>' for e in m["calendar"])
    sec("where", "Where & when", f'<ul class="rows">{rows}{cal}</ul>' if rows or cal else '<p class="muted">No places listed.</p>')
    body = ""
    if m["legs"]:
        body = '<ul class="rows">' + "".join(f'<li><span class="when">{esc(g["when"])}</span><span>{esc(g["title"])}</span></li>'
                                            for g in m["legs"]) + "</ul>"
    else:
        body = f'<p class="note">{esc(m["legs_note"])}</p>'
        if m["planned"]:
            body += '<p class="muted">Planned:</p><ul>' + "".join(f"<li>{esc(x)}</li>" for x in m["planned"]) + "</ul>"
    if m["calendar_note"]:
        body += f'<p class="muted">{esc(m["calendar_note"])}.</p>'
    if m["home_town"]:
        body += f'<p class="muted">Door to door from and back to {esc(m["home_town"])}.</p>'
    sec("legs", "Legs", body)
    if m.get("days"):
        body = '<p id="todaylink"><a href="#">Jump to today</a></p>' + "".join(
            f'<div class="day" data-date="{esc(d["date"])}" id="d{esc(d["date"])}"><div class="dh"><span class="when">'
            f'{esc(d["label"])}</span><b>{esc(d["where"])}</b><span>{esc(d["title"])}</span>'
            f'{f"<span class=tag>{esc(d[chr(116)+chr(97)+chr(103)])}</span>" if d["tag"] else ""}</div>'
            + ("<ul>" + "".join(f"<li>{esc(i)}</li>" for i in d["items"]) + "</ul>" if d["items"] else "") + "</div>"
            for d in m["days"])
        sec("days", m.get("days_title") or "Day by day", body)
    for x in m.get("extras") or []:
        body = block(x) + "".join(block(g, sub=True) for g in x["groups"])
        sec(x["id"], x["title"], body)
    if m["transport"] or m["tips"]:
        body = '<ul class="rows">' + "".join(
            f'<li><span class="when">{esc(x["where"])}</span><span><a href="{esc(x["url"])}">{esc(x["label"])}</a></span></li>'
            for x in m["transport"]) + "</ul>"
        if m["tips"]:
            body += "<ul>" + "".join(f'<li>{esc(x["text"])}</li>' for x in m["tips"]) + "</ul>"
        sec("transport", "Getting around", body)
    body = ""
    for w in m["weather"]:
        body += f"<h3 style='font-size:1rem;margin:10px 0 4px'>{esc(w['town'])}</h3>"
        if w["days"]:
            body += "<table><tr><th>Day</th><th></th><th>°C</th><th>Rain</th><th>Wind</th></tr>" + "".join(
                f"<tr><td>{esc(datetime.fromisoformat(d['date']).strftime('%a %d.%m'))}</td><td>{d['icon']} {esc(d['text'])}</td>"
                f"<td>{round(d['tmin'])}–{round(d['tmax'])}</td><td>{esc(d['rain_pct'])} % · {esc(d['rain_mm'])} mm</td>"
                f"<td>{round(d['wind'])} km/h</td></tr>" for d in w["days"]) + "</table>"
        if w["note"]:
            body += f'<p class="note">{esc(w["note"])}</p>'
    sec("weather", "Weather", (body or '<p class="muted">Trip is over.</p>') +
        '<p class="muted">open-meteo, as of the build time below. Rebuild for a fresh one.</p>')
    body = ""
    for x in m["money"]:
        rate = (f' · 1 {esc(x["base"])} ≈ {x["rate"]} {esc(x["currency"])} <span class="muted">(reference rate {esc(x["rate_date"])})</span>'
                if x.get("rate") else (f' <span class="muted">· {esc(x["note"])}</span>' if x.get("note") else ""))
        body += f'<p><span class="big">{esc(x["currency"])}</span>{rate}</p>'
    if m["plugs"]:
        body += "<p>Plugs: " + " · ".join(f'{esc(p["where"])} type {esc(p["type"])}' for p in m["plugs"]) + "</p>"
    if m["roaming"]:
        body += f'<p class="note">📶 {esc(m["roaming"])}</p>'
    sec("money", "Money, plugs & phone", body or '<p class="muted">Nothing special.</p>')
    sec("sos", "Emergency", '<ul class="rows">' + "".join(
        f'<li><span class="when">{esc(x["where"])}</span><span>{esc(x["text"])}</span></li>' for x in m["emergency"]) + "</ul>")
    pk = m["packing"]
    if pk["items"]:
        key = "trip-pack:" + slug(m["trip"])
        lis = "".join(f'<li><label><input type="checkbox" data-i="{i}"><span>{esc(x)}</span></label></li>'
                      for i, x in enumerate(pk["items"]))
        head = f'<p class="muted">{esc(pk.get("emoji") or "🎒")} {esc(pk["label"])} list · ticks stay in this browser</p>' if pk["label"] else ""
        sec("pack", "Packing", f'{head}<ul class="check" id="check" data-key="{esc(key)}">{lis}</ul>')
    if m["problems"]:
        sec("issues", "Not checked", "<ul>" + "".join(f"<li>{esc(p)}</li>" for p in m["problems"]) + "</ul>")
    towns = " · ".join(dict.fromkeys(p["town"] for p in m["places"]))
    n = m["days_until"]
    rel = "today" if n == 0 else "tomorrow" if n == 1 else f"in {n} days" if n > 1 else "under way" if n < 0 else ""
    nav = "".join(f'<a href="#{sid}">{esc(title.split(",")[0].split(" &")[0].split(" (")[0])}</a>' for sid, title, _ in secs)
    js = """<script>(function(){var ul=document.getElementById('check');if(!ul)return;var k=ul.dataset.key,s={};
try{s=JSON.parse(localStorage.getItem(k)||'{}')}catch(e){}
ul.querySelectorAll('input').forEach(function(b){b.checked=!!s[b.dataset.i];b.addEventListener('change',function(){
s[b.dataset.i]=b.checked;try{localStorage.setItem(k,JSON.stringify(s))}catch(e){}})})})();
(function(){var d=new Date(),p=function(n){return(n<10?'0':'')+n},t=d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate());
var el=null;document.querySelectorAll('.day').forEach(function(x){if(x.dataset.date<t)x.classList.add('past');
if(x.dataset.date===t){x.classList.add('today');el=x}});var l=document.getElementById('todaylink');
if(el&&l){l.style.display='block';l.firstChild.setAttribute('href','#'+el.id)}})();</script>"""
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">'
            f'<meta name="color-scheme" content="light dark"><title>{esc(m["trip"])} pack</title><style>{CSS}</style></head>'
            f'<body><header class="wrap"><div class="eyebrow">Offline trip pack · {esc(rel)}</div>'
            f'<h1>{esc(m["emoji"])} {esc(m["trip"])}</h1><p class="sub">{esc(m["dates"])}{" · " + esc(towns) if towns else ""}</p>'
            f'</header><nav><div class="wrap">{nav}</div></nav><main class="wrap">'
            + "".join(s for _, _, s in secs) +
            f'</main><footer class="wrap">Built {esc(m["built"])} by trip-pack from the trip file and the calendar cache. '
            f'Links need a connection; everything else works offline.</footer>{js}</body></html>\n')


def main(argv):
    a = argv[1:]
    if not a or a[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if a else 1
    if a[0] == "--list":
        for t in trips():
            if t["_from"]:
                print(f"{t.get('emoji') or '🧳'} {t['name']} · {span(t['_from'], t['_to'])}"
                      + (f" · {t['pack']}" if t.get("pack") else ""))
        return 0
    out, as_json, offline, q = None, False, False, []
    i = 0
    while i < len(a):
        if a[i] == "--out" and i + 1 < len(a):
            out, i = a[i + 1], i + 2
            continue
        if a[i] == "--json":
            as_json = True
        elif a[i] == "--no-fetch":
            offline = True
        elif a[i].startswith("-") and a[i] != "-":
            print(f"trip-pack: unknown option {a[i]}", file=sys.stderr)
            return 1
        else:
            q.append(a[i])
        i += 1
    if not q:
        print("trip-pack: which trip? (trip-pack --list)", file=sys.stderr)
        return 1
    t = find_trip(" ".join(q))
    if not t:
        print(f"trip-pack: no trip matches {' '.join(q)!r} (trip-pack --list)", file=sys.stderr)
        return 1
    if not t["_from"]:
        print(f"trip-pack: {t['name']} has no dates in {TRIPS}", file=sys.stderr)
        return 1
    m = build(t, offline)
    page = render(m)
    out = out or os.path.expanduser(t.get("pack") or os.path.join(OUTDIR, f"{slug(t['name'])}-pack.html"))
    if out == "-":
        sys.stdout.write(page)
    else:
        out = os.path.expanduser(out)
        os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
        tmp = out + ".tmp"
        with open(tmp, "w") as f:
            f.write(page)
        os.replace(tmp, out)
    m["out"] = out
    try:
        import usage
        usage.log("bin.trip-pack", "exec", outcome="partial" if m["problems"] else "ok",
                  attrs={"days": len(m["days"]), "extras": len(m["extras"])})
    except Exception:
        pass
    if as_json:
        print(json.dumps(m, ensure_ascii=False, indent=1))
    elif out != "-":
        legs = f"{len(m['legs'])} legs" if m["legs"] else "legs not booked yet"
        fc = sum(len(w["days"]) for w in m["weather"])
        print(f"{m['emoji']} {m['trip']} · {m['dates']} · {legs} · forecast {fc} days · "
              f"{len(m['packing']['items'])} to pack -> {out} ({os.path.getsize(out) // 1024} KB)")
    for p in m["problems"]:
        print(f"trip-pack: {p}", file=sys.stderr)
    return 2 if m["problems"] else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
