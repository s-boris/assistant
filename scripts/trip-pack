#!/usr/bin/env python3
"""trip-pack: one self-contained offline HTML pack for a trip in tg-cmd's trips.json.

usage:
  trip-pack TRIP [--out FILE|-] [--json] [--no-fetch]
  trip-pack --list

TRIP     a trip's name or one of its "match" words (case-insensitive substring), e.g. "belgium"
--out    where the HTML goes: FILE, or - for stdout (default: the trip's "pack" path,
         else ~/reports/trips/<name>-pack.html)
--json   print the pack's data (places, legs, weather, money, packing, out) instead of the summary line
--no-fetch  no network: no geocoding, forecast or exchange rate (the page says so)
--list   trips with dates and their pack path

The pack (phone-sized, works offline, light + dark): towns and dates, the legs from calcache once they are in
the calendar (else "legs not booked yet" + the trip's planned legs), local transport links per country and city
(rail, airport transfers), an open-meteo forecast per place when the day is <= 14 days away (else "forecast
from DD.MM"), currency (+ the central-bank reference rate from the home currency; Frankfurter v2, keyless), plugs, emergency numbers, a roaming reminder
for a home plan outside the EU, and the trip type's packing list from tg-cmd's pack-templates.json as a
checklist (ticks stay in that browser).

Trip entry (trips.json "trips"): name, emoji, from, to (YYYY-MM-DD), legs [text], match [words], type
(pack template: business, beach, ...; default business when abroad), places [{town, country (ISO-2),
from, to, what, lat, lon}] (lat/lon optional: geocoded by open-meteo, cached), pack (output path), extras (JSON
file with the trip's own pages; default TRIP_PACK_EXTRAS_DIR/<slug>.json when it exists).
Extras file: {"days": [{date YYYY-MM-DD, where, title, items [text], tag}] -> "Day by day" (today is marked on
the phone), "days_title", "sections": [{id, title, intro, note, rows [[left, right]], table {head, rows},
items [text], links [[label, url]], groups [same fields + title]} or {"include": "other.json"} (a section file,
path relative to the extras file)] -> one page section each after Legs, "emergency": [{where, text}] -> first
lines of Emergency}. Links: http(s), tel: and mailto: only. A broken extras file = exit 2, the rest still built.
Home town and country come from the assistant profile (home.town, locale.country), never from here.

exit: 0 written, 1 trip not found / no dates / bad arguments, 2 written but a source failed (named in
the page and on stderr).
env: TRIP_PACK_TRIPS (else TG_CMD_TRIPS, else ~/.config/tg-cmd/trips.json), TRIP_PACK_TEMPLATES (else
TG_CMD_PACK_TEMPLATES), TRIP_PACK_BIN (dir with calcache), TRIP_PACK_NOW ("YYYY-MM-DD HH:MM"),
TRIP_PACK_CACHE (geocode cache dir), TRIP_PACK_OUTDIR, TRIP_PACK_CITIES (extra city table, JSON; default
~/.config/trip-pack/cities.json), TRIP_PACK_COUNTRIES (extra country table, JSON {"XX": {name, cur, plug, rail
[[label, url]], extra, tips, europe, fx}}: fx false = no reference rate for that currency, europe false = the 112 line and
the roaming note for a trip outside Europe; default ~/.config/trip-pack/countries.json), TRIP_PACK_FIXTURES (tests: dir with geocode.json / forecast.json / fx.json instead of the network),
TRIP_PACK_EXTRAS_DIR (default ~/.config/trip-pack/extras). Each build logs one usage event (bin.trip-pack; USAGE=off).
"""
import html, json, os, pwd, re, subprocess, sys, urllib.parse, urllib.request
from datetime import date, datetime, timedelta

sys.dont_write_bytecode = True
_here = os.path.dirname(os.path.realpath(__file__))
for _lib in (os.path.join(pwd.getpwuid(os.getuid()).pw_dir, "bin", "lib"), os.path.expanduser("~/bin/lib"),
             os.path.join(_here, "lib")):
    sys.path.insert(0, _lib)                              # own lib dir first; ~/bin/lib for a copy elsewhere
if not os.path.isdir(os.path.join(_here, "lib", "core")) and os.path.isdir(os.path.join(_here, "..", "core")):
    sys.path.insert(0, os.path.dirname(_here))            # the repo checkout (scripts/): its own core
import assistant_profile  # noqa: E402
from core import http as web, jsonstate  # noqa: E402

TZ = assistant_profile.tz()
E = os.environ.get
CONF = os.path.expanduser("~/.config")
TRIPS = os.path.expanduser(E("TRIP_PACK_TRIPS") or E("TG_CMD_TRIPS") or f"{CONF}/tg-cmd/trips.json")
TEMPLATES = os.path.expanduser(E("TRIP_PACK_TEMPLATES") or E("TG_CMD_PACK_TEMPLATES") or f"{CONF}/tg-cmd/pack-templates.json")
BIN = os.path.expanduser(E("TRIP_PACK_BIN") or "~/bin")
CACHE = os.path.expanduser(E("TRIP_PACK_CACHE") or "~/.cache/trip-pack")
OUTDIR = os.path.expanduser(E("TRIP_PACK_OUTDIR") or "~/reports/trips")
CITIES_FILE = os.path.expanduser(E("TRIP_PACK_CITIES") or f"{CONF}/trip-pack/cities.json")
COUNTRIES_FILE = os.path.expanduser(E("TRIP_PACK_COUNTRIES") or f"{CONF}/trip-pack/countries.json")
FIXTURES = E("TRIP_PACK_FIXTURES")
EXTRAS_DIR = os.path.expanduser(E("TRIP_PACK_EXTRAS_DIR") or f"{CONF}/trip-pack/extras")
BUILTIN_IDS = {"where", "legs", "days", "transport", "weather", "money", "sos", "pack", "issues"}
FORECAST_DAYS = 14
UA = "trip-pack/1 (personal offline travel sheet)"

