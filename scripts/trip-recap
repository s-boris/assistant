JS = """
const figs=[...document.querySelectorAll('figure[data-i]')],full=JSON.parse(document.getElementById('full').textContent);
const lb=document.getElementById('lb'),li=lb.querySelector('img'),lc=lb.querySelector('p');let cur=-1;
function show(i){if(i<0||i>=figs.length)return;cur=i;const f=figs[i];li.src=full[f.dataset.i]||f.querySelector('img').src;lc.textContent=f.dataset.cap||'';lb.classList.add('on')}
figs.forEach((f,i)=>f.addEventListener('click',()=>show(i)));
lb.addEventListener('click',e=>{if(e.target!==li)lb.classList.remove('on')});
document.addEventListener('keydown',e=>{if(!lb.classList.contains('on'))return;if(e.key==='Escape')lb.classList.remove('on');if(e.key==='ArrowRight')show(cur+1);if(e.key==='ArrowLeft')show(cur-1)});
document.querySelectorAll('[data-go]').forEach(d=>d.addEventListener('click',()=>{const f=document.getElementById('p'+d.dataset.go);if(f){f.scrollIntoView({behavior:'smooth',block:'center'});f.classList.remove('flash');void f.offsetWidth;f.classList.add('flash')}}));
"""


def esc(s):
    return html.escape(str(s), quote=True)


def day_colors(days):
    n = max(1, len(days))
    out = {}
    for i, d in enumerate(days):
        r, g, b = colorsys.hls_to_rgb((0.55 + 0.8 * i / n) % 1.0, 0.45, 0.65)
        out[d] = "#%02x%02x%02x" % (int(r * 255), int(g * 255), int(b * 255))
    return out


def render_map(items, dives, cfg, coast, island_color):
    pts = [(it["lat"], it["lon"]) for it in items if it.get("lat") is not None]
    bbox = cfg.get("map_bbox") or (coast or {}).get("bbox")
    if not bbox:
        if not pts:
            return "", 0
        la, lo = [p[0] for p in pts], [p[1] for p in pts]
        pad = max(0.02, (max(la) - min(la)) * 0.12, (max(lo) - min(lo)) * 0.12)
        bbox = [min(la) - pad, min(lo) - pad, max(la) + pad, max(lo) + pad]
    S, W, N, E = bbox
    kx = math.cos(math.radians((S + N) / 2))
    width = 1000.0
    sc = width / max(1e-9, (E - W) * kx)
    height = (N - S) * sc

    def xy(lat, lon):
        return (lon - W) * kx * sc, (N - lat) * sc

    def inside(lat, lon):
        return S <= lat <= N and W <= lon <= E

    def path(seq, close):
        return "M" + " L".join("%.1f %.1f" % xy(a, b) for a, b in seq) + (" Z" if close else "")

    o = [f'<svg class="map" viewBox="0 0 {width:.0f} {height:.0f}" role="img" aria-label="Map of photo locations">']
    for r in (coast or {}).get("rings", []):
        o.append(f'<path class="land" d="{path(r, True)}"/>')
    for l in (coast or {}).get("lines", []):
        o.append(f'<path class="coast" d="{path(l, False)}"/>')
    geo = [it for it in items if it.get("lat") is not None and inside(it["lat"], it["lon"])]
    if len(geo) >= 2:
        o.append(f'<path class="track" d="{path([(it["lat"], it["lon"]) for it in geo], False)}"/>')
    for r in cfg.get("regions") or []:
        an = r.get("label") or ([sum(a[0] for a in r["anchors"]) / len(r["anchors"]), sum(a[1] for a in r["anchors"]) / len(r["anchors"])] if r.get("anchors") else None)
        if an and inside(*an):
            x, y = xy(*an)
            o.append(f'<text class="lbl" x="{x + 14:.1f}" y="{y:.1f}" fill="{island_color.get(r["name"], GREY)}">{esc(r["name"])}</text>')
    for d in dives:
        if d.get("lat") is None or not inside(d["lat"], d["lon"]):
            continue
        x, y = xy(d["lat"], d["lon"])
        tip = f"Dive · {d['site']} · {d['t']:%d.%m %H:%M}" + (f" · {d['depth']} m" if d.get("depth") else "")
        o.append(f'<path class="dive" d="M{x:.1f} {y - 13:.1f} L{x + 10:.1f} {y:.1f} L{x:.1f} {y + 13:.1f} L{x - 10:.1f} {y:.1f} Z"><title>{esc(tip)}</title></path>')
    for it in geo:
        x, y = xy(it["lat"], it["lon"])
        o.append(f'<circle class="dot" cx="{x:.1f}" cy="{y:.1f}" r="{9 if it.get("pick") else 7}" fill="{it["dcolor"]}" data-go="{it["id"]}">'
                 f'<title>{esc(it["t"].strftime("%a %d.%m %H:%M"))} · {esc(it["island"])}</title></circle>')
    o.append("</svg>")
    return "\n".join(o), len([it for it in items if it.get("lat") is not None]) - len(geo)


def figure(it, with_id):
    cap = f"{it['t']:%a %d.%m %H:%M} · {it['island']}" + (" · underwater" if it.get("underwater") else "") + f" · {os.path.basename(it['path'])}"
    badges = []
    if it["kind"] == "video":
        badges.append("▶ %d:%02d" % divmod(int(it.get("duration") or 0), 60))
    if it.get("underwater"):
        badges.append("🌊")
    if it.get("pick"):
        badges.append("★")
    img = f'<img alt="" loading="lazy" src="data:image/jpeg;base64,{it["thumb"]}">' if it.get("thumb") else ""
    return (f'<figure{" id=p" + str(it["id"]) if with_id else ""} class="{"pick" if it.get("pick") else ""}" data-i="{it["id"]}" data-cap="{esc(cap)}">'
            f'{img}{"<span class=badge>" + " ".join(badges) + "</span>" if badges else ""}<figcaption>{it["t"]:%H:%M}</figcaption></figure>')


def render_page(items, picks, dives, cfg, coast, title, previews, skipped):
    islands = []
    for it in items:
        if it["island"] not in islands:
            islands.append(it["island"])
    reg_names = [r["name"] for r in cfg.get("regions") or []]
    island_color = {name: PALETTE[i % len(PALETTE)] for i, name in enumerate(reg_names)}
    for name in islands:
        if name not in island_color:
            island_color[name] = GREY if name in ("Elsewhere", "Unknown") else PALETTE[len(island_color) % len(PALETTE)]
    days = sorted({it["day"] for it in items})
    dcol = day_colors(days)
    for it in items:
        it["dcolor"] = dcol[it["day"]]
    svg, outside = render_map(items, dives, cfg, coast, island_color)
    by_day = {d: [it for it in items if it["day"] == d] for d in days}
    dives_by_day = {}
    for d in dives:
        dives_by_day.setdefault(d["t"].date().isoformat(), []).append(d)

    def main_island(v):
        cnt = {}
        for it in v:
            cnt[it["island"]] = cnt.get(it["island"], 0) + 1
        return [k for k, _ in sorted(cnt.items(), key=lambda kv: -kv[1])]

    nph, nvid = sum(it["kind"] == "photo" for it in items), sum(it["kind"] == "video" for it in items)
    span = f"{dt.date.fromisoformat(days[0]):%d.%m.%Y} – {dt.date.fromisoformat(days[-1]):%d.%m.%Y}" if days else ""
    p = ['<!doctype html><html lang="en"><head><meta charset="utf-8">',
         '<meta name="viewport" content="width=device-width,initial-scale=1">',
         "<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'unsafe-inline'\">",
         f"<title>{esc(title)}</title><style>{CSS}</style></head><body><main>",
         f"<h1>{esc(title)}</h1>",
         f'<p class="sub">{esc(span)} · {len(days)} days · {nph} photos' + (f" · {nvid} video{'s' if nvid > 1 else ''}" if nvid else "")
         + (f" · {len(dives)} dives" if dives else "") + " · " + " · ".join(
             f'<span class="chip" style="--c:{island_color[i]}">{esc(i)} {sum(x["island"] == i for x in items)}</span>' for i in islands) + "</p>"]
    if svg:
        p.append(svg)
        leg = "Dots = photos and videos with GPS, coloured by day (tap one to jump to it); dashed line = the route in time order"
        leg += "; ◆ = dives" if any(d.get("lat") is not None for d in dives) else ""
        leg += f"; {outside} more with GPS off this map" if outside else ""
        p.append(f'<p class="legend">{leg}.</p>')
    p.append('<nav class="days">')
    for d in days:
        isl = main_island(by_day[d])
        nd = len(dives_by_day.get(d, []))
        p.append(f'<a class="day" href="#d{d}" style="--c:{island_color[isl[0]]}"><b>{dt.date.fromisoformat(d):%a %d.%m}</b>'
                 f'{esc(" / ".join(isl))} · {len(by_day[d])}' + (f" · {nd} dive{'s' if nd > 1 else ''}" if nd else "") + "</a>")
    p.append("</nav>")
    if picks:
        p.append(f'<section><h2>Best of · {len(picks)} picks</h2><p class="meta">Chosen for sharpness, exposure and faces, spread over the days; '
                 f'these went into the montage in this order.</p><div class="grid">')
        p += [figure(it, False) for it in picks]
        p.append("</div></section>")
    for d in days:
        v = by_day[d]
        isl = main_island(v)
        chips = "".join(f'<span class="chip" style="--c:{island_color[i]}">{esc(i)}</span>' for i in isl)
        nphd = sum(x['kind'] == 'photo' for x in v)
        meta = [f"{nphd} photo{'s' if nphd != 1 else ''}"]
        nv = sum(x["kind"] == "video" for x in v)
        if nv:
            meta.append(f"{nv} video{'s' if nv > 1 else ''}")
        for dv in dives_by_day.get(d, []):
            meta.append(f"dive {dv['t']:%H:%M} {dv['site']}" + (f" {dv['depth']} m" if dv.get("depth") else "") + f" {dv['minutes']} min")
        p.append(f'<section id="d{d}"><h2>{dt.date.fromisoformat(d):%A %d.%m}{chips}</h2><p class="meta">{esc(" · ".join(meta))}</p><div class="grid">')
        p += [figure(it, True) for it in v]
        p.append("</div></section>")
    foot = f"Made locally by trip-recap on {dt.date.today():%d.%m.%Y}. This page loads nothing from the internet."
    if coast:
        foot += f" Coastline: {esc(coast.get('attribution', ''))}."
    if skipped:
        foot += f" Skipped {skipped} files (HEIC/RAW: export them as JPEG to include them)."
    full = {str(k): "data:image/jpeg;base64," + v for k, v in previews.items()}
    p.append(f"<footer>{foot}</footer></main>")
    p.append('<div id="lb" role="dialog"><img alt=""><p></p></div>')
    p.append('<script type="application/json" id="full">' + json.dumps(full).replace("</", "<\\/") + "</script>")
    p.append(f"<script>{JS}</script></body></html>")
    return "\n".join(p)


# ---------- montage ----------
def build_montage(picks, out, a, title, log):
    from PIL import Image, ImageOps
    if not os.access(VIDMONTAGE, os.X_OK):
        log.append(f"montage skipped: vidmontage not found ({VIDMONTAGE})")
        return None
    src = os.path.join(out, "montage-src")
    if os.path.isdir(src):
        shutil.rmtree(src)
    os.makedirs(src)
    W, H = a.size
    files, uw_ok = [], 0
    for i, it in enumerate(picks, 1):
        dst = os.path.join(src, f"{i:03d}.jpg")
        with Image.open(it["path"]) as im:
            im = ImageOps.exif_transpose(im).convert("RGB")
            im.thumbnail((W, H))
            im.save(dst, "JPEG", quality=92)  # no EXIF: the montage inputs carry no GPS
        if it.get("uwfix") and os.access(UWFIX, os.X_OK):
            fixed = os.path.join(src, f"{i:03d}-uw.jpg")
            r = subprocess.run([UWFIX, dst, "-o", fixed, "--quiet", "--strength", str(a.uw_strength)],
                               capture_output=True, text=True, timeout=300, stdin=subprocess.DEVNULL)
            if r.returncode == 0 and os.path.exists(fixed):
                dst, uw_ok = fixed, uw_ok + 1
            else:
                log.append(f"uwfix failed on pick {i}; used it uncorrected: " + (r.stderr or "")[-200:].strip())
        files.append(dst)
    mp4 = os.path.join(out, "montage.mp4")
    cmd = [VIDMONTAGE, "-o", mp4, "--photo-secs", str(a.photo_secs), "--size", f"{W}x{H}", "--title", title]
    if a.music:
        cmd += ["--music", a.music]
    r = subprocess.run(cmd + files, capture_output=True, text=True, timeout=3600, stdin=subprocess.DEVNULL)
    if r.returncode != 0 or not os.path.exists(mp4):
        log.append("vidmontage failed: " + (r.stderr or r.stdout)[-400:].strip())
        return None
    return {"path": mp4, "uw_corrected": uw_ok}


def size_arg(s):
    try:
        w, h = (int(x) for x in s.lower().split("x"))
    except ValueError:
        raise argparse.ArgumentTypeError("want WxH, e.g. 1920x1080")
    if w < 2 or h < 2 or w % 2 or h % 2:
        raise argparse.ArgumentTypeError("width and height must be even")
    return w, h


def main(argv):
    if argv[:1] == ["coast"]:
        return cmd_coast(argv[1:])
    ap = argparse.ArgumentParser(prog="trip-recap", description="Offline trip recap: map, day timeline, best photos, montage.")
    ap.add_argument("dir")
    ap.add_argument("-o", "--out")
    ap.add_argument("--config", default=CONFIG)
    ap.add_argument("--count", type=int, default=40)
    ap.add_argument("--music")
    ap.add_argument("--title")
    ap.add_argument("--no-montage", action="store_true")
    ap.add_argument("--size", type=size_arg, default=(1920, 1080))
    ap.add_argument("--photo-secs", type=float, default=3.5)
    ap.add_argument("--uw-strength", type=float, default=0.8)
    ap.add_argument("--uw-threshold", type=float, default=0.75)
    ap.add_argument("--dives", default="auto", help="auto (divelog), none, or a divelog list --json file")
    ap.add_argument("--camera-tz", help="zone for EXIF times without an offset (default: trip zone)")
    ap.add_argument("--since")
    ap.add_argument("--until")
    ap.add_argument("--workers", type=int, default=min(6, os.cpu_count() or 2))
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)
    reexec()
    from zoneinfo import ZoneInfo
    import concurrent.futures as cf, multiprocessing as mp
    from PIL import Image, ImageOps

    src_dir = os.path.abspath(a.dir)
    if not os.path.isdir(src_dir):
        sys.exit(f"not a directory: {a.dir}")
    if a.music and not os.path.isfile(a.music):
        sys.exit(f"music file not found: {a.music}")
    cfg = jsonstate.load(a.config, {}) if a.config else {}
    tzname = cfg.get("tz") or jsonstate.load(DIVELOG_CONFIG, {}).get("tz") or "UTC"
    trip_tz = ZoneInfo(tzname)
    cam_tz = ZoneInfo(a.camera_tz) if a.camera_tz else trip_tz
    coast = None
    if cfg.get("coast"):
        cp = cfg["coast"] if os.path.isabs(cfg["coast"]) else os.path.join(os.path.dirname(os.path.abspath(a.config)), cfg["coast"])
        coast = jsonstate.load(cp, None)
    out = os.path.abspath(a.out or os.path.join(HOME, "jobs/trip-recap", os.path.basename(src_dir.rstrip("/")) or "trip"))
    os.makedirs(out, exist_ok=True)
    title = a.title or cfg.get("title") or os.path.basename(src_dir)

    jobs, skipped = [], 0
    for root, dirs, names in os.walk(src_dir):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".") and os.path.abspath(os.path.join(root, d)) != out)
        for n in sorted(names):
            ext = os.path.splitext(n)[1].lower()
            path = os.path.join(root, n)
            if n.startswith("."):
                continue
            if ext in PHOTO:
                jobs.append([path, "photo"])
            elif ext in VIDEO:
                jobs.append([path, "video"])
            elif ext in SKIPPED:
                skipped += 1
    if not jobs:
        sys.exit(f"no photos or videos in {a.dir}")
    thumb = 280 if len(jobs) <= 400 else 220 if len(jobs) <= 1000 else 180
    jobs = [(p, k, thumb) for p, k in jobs]
    with cf.ProcessPoolExecutor(max_workers=max(1, a.workers), mp_context=mp.get_context("fork")) as ex:
        res = list(ex.map(analyze, jobs, chunksize=4))

    items, errors = [], []
    for it in res:
        if it.get("error"):
            errors.append(it)
            continue
        t, src = None, "file"
        if it["kind"] == "photo" and it.get("exif_time"):
            t, src = exif_time(it["exif_time"], it.get("exif_off"), cam_tz, trip_tz), "exif"
        elif it["kind"] == "video" and it.get("video_time"):
            t, src = iso_time(it["video_time"], trip_tz), "video"
        if t is None:
            t, src = dt.datetime.fromtimestamp(os.path.getmtime(it["path"]), trip_tz).replace(tzinfo=None), "file"
        it["t"], it["time_src"], it["day"] = t, src, t.date().isoformat()
        items.append(it)
    if a.since:
        items = [it for it in items if it["day"] >= a.since]
    if a.until:
        items = [it for it in items if it["day"] <= a.until]
    if not items:
        sys.exit("no usable photos or videos (all unreadable or outside --since/--until)")
    items.sort(key=lambda it: (it["t"], it["path"]))
    for i, it in enumerate(items):
        it["id"] = i
    assign_regions(items, cfg)
    dives = load_dives(a.dives)
    for it in items:
        dive = next((d for d in dives if d["t"] - dt.timedelta(minutes=10) <= it["t"] <= d["t"] + dt.timedelta(minutes=d["minutes"] + 20)), None)
        cast = it.get("uw_cast") or 0
        # underwater = blue/green cast, or shot during a logged dive without GPS (action cam, not the phone on the boat);
        # uwfix only where the cast is there: flash or pre-corrected shots keep their colours
        it["uwfix"] = bool(cast >= a.uw_threshold or (dive and cast >= 0.4))
        it["underwater"] = bool(it["uwfix"] or (dive and it.get("lat") is None))
        if dive:
            it["dive"] = dive["id"]
    picks = select([it for it in items if it["kind"] == "photo"], max(0, a.count))
    for it in picks:
        it["pick"] = True
    previews = {}
    for it in picks:
        try:
            with Image.open(it["path"]) as im:
                if im.format == "JPEG":
                    im.draft("RGB", (1600, 1600))
                previews[it["id"]] = jpeg_b64(ImageOps.exif_transpose(im).convert("RGB"), 1024, 76)
        except Exception:
            pass

    page = render_page(items, picks, dives, cfg, coast, title, previews, skipped)
    html_path = os.path.join(out, "index.html")
    with open(html_path + ".tmp", "w") as f:
        f.write(page)
    os.replace(html_path + ".tmp", html_path)
    with open(os.path.join(out, "picks.txt"), "w") as f:
        f.write("".join(it["path"] + ("\tunderwater" if it.get("underwater") else "") + ("\tuwfix" if it.get("uwfix") else "") + "\n" for it in picks))
    log = []
    montage = None
    if not a.no_montage and len(picks) >= 2:
        montage = build_montage(picks, out, a, title, log)
    keep = ("id", "path", "kind", "day", "time_src", "lat", "lon", "island", "island_src", "sharp", "exposure", "faces",
            "uw_cast", "underwater", "uwfix", "dive", "score", "dup_of", "pick", "duration")
    recap = {"title": title, "tz": tzname, "items": [dict({k: it[k] for k in keep if k in it}, t=it["t"].isoformat(timespec="seconds")) for it in items],
             "errors": [{"path": e["path"], "error": e["error"]} for e in errors], "skipped": skipped,
             "dives": [dict(d, t=d["t"].isoformat(timespec="minutes")) for d in dives]}
    with open(os.path.join(out, "recap.json"), "w") as f:
        json.dump(recap, f, ensure_ascii=False, indent=1)

    isl = {}
    for it in items:
        isl[it["island"]] = isl.get(it["island"], 0) + 1
    src_n = {}
    for it in items:
        src_n[it["island_src"]] = src_n.get(it["island_src"], 0) + 1
    summary = {
        "photos": sum(it["kind"] == "photo" for it in items), "videos": sum(it["kind"] == "video" for it in items),
        "skipped": skipped, "unreadable": len(errors), "days": len({it["day"] for it in items}), "islands": isl,
        "island_source": src_n, "with_gps": sum(it.get("lat") is not None for it in items),
        "picks": len(picks), "picks_underwater": sum(bool(it.get("underwater")) for it in picks), "picks_uwfix": sum(bool(it.get("uwfix")) for it in picks),
        "picks_with_faces": sum(bool(it.get("faces")) for it in picks), "duplicates_dropped": sum("dup_of" in it for it in items),
        "dives": len(dives), "faces_model": os.path.exists(FACE_MODEL),
        "page": html_path, "page_mb": round(os.path.getsize(html_path) / 1e6, 2), "picks_file": os.path.join(out, "picks.txt"),
        "montage": montage["path"] if montage else None, "montage_uw_corrected": montage["uw_corrected"] if montage else 0, "notes": log,
    }
    if a.json:
        print(json.dumps(summary, ensure_ascii=False, indent=1))
    else:
        print(f"trip-recap: {summary['photos']} photos, {summary['videos']} videos, {summary['days']} days"
              + (f", {skipped} skipped (HEIC/RAW)" if skipped else "") + (f", {len(errors)} unreadable" if errors else ""))
        print("islands: " + ", ".join(f"{k} {v}" for k, v in isl.items()) + f" (GPS on {summary['with_gps']})")
        print(f"picks: {len(picks)} ({summary['picks_underwater']} underwater, {summary['picks_with_faces']} with faces) -> {summary['picks_file']}")
        print(f"page: {html_path} ({summary['page_mb']} MB)")
        if montage:
            print(f"montage: {montage['path']}")
        for line in log:
            print(line)


if __name__ == "__main__":
    main(sys.argv[1:])
