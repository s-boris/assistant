#!/usr/bin/env -S python3 -I
"""trip-recap: an offline trip recap from a folder of photos and videos, made locally.

Usage:
  trip-recap DIR [-o OUT] [--config FILE] [--count 40] [--music FILE] [--title T] [--no-montage]
                 [--size 1920x1080] [--photo-secs 3.5] [--uw-strength 0.8] [--dives auto|none|FILE.json]
                 [--camera-tz TZ] [--since YYYY-MM-DD] [--until YYYY-MM-DD] [--workers N] [--json]
  trip-recap coast S,W,N,E -o FILE [--from OSM.json] [--tolerance-m 25]

DIR (recursive): JPEG/PNG/WebP photos and videos. EXIF time (+ OffsetTimeOriginal) and GPS from photos,
creation time and ISO 6709 location from videos (ffprobe); no time -> file mtime. Items are grouped by
day (trip time zone) and island/region: nearest region anchor from the config; no GPS -> the island of
the nearest GPS item that day, else the trip leg for that date (config "legs", else the divelog legs).
OUT (default ~/jobs/trip-recap/<DIR name>) gets:
  index.html   one self-contained page: vector map (coastline from the config's coast file, no tiles,
               no network at view time; CSP forbids it), day timeline, thumbnails, dive markers (divelog)
  picks.txt    the best --count photos: sharpness (Laplacian variance), exposure, faces (YuNet, local),
               burst duplicates dropped, spread over the days; underwater = blue/green colour cast
               (or taken during a logged dive)
  montage.mp4  vidmontage of the picks in time order; underwater picks go through uwfix first
  recap.json   everything above incl. GPS: private, stays in OUT
`coast` builds a coast file once (Overpass natural=coastline in the box, stitched and simplified).
Nothing about the photos leaves the machine; stdout carries counts only, never coordinates.
"""
import argparse, base64, bisect, colorsys, datetime as dt, html, io, json, math, os, pwd, re, shutil, subprocess, sys

_here = os.path.dirname(os.path.realpath(__file__))
for _lib in (os.path.join(pwd.getpwuid(os.getuid()).pw_dir, "bin", "lib"), os.path.expanduser("~/bin/lib"),
             os.path.join(_here, "lib")):
    sys.path.insert(0, _lib)                              # own lib dir first; ~/bin/lib for a copy elsewhere
if not os.path.isdir(os.path.join(_here, "lib", "core")) and os.path.isdir(os.path.join(_here, "..", "core")):
    sys.path.insert(0, os.path.dirname(_here))            # the repo checkout (scripts/): its own core
from core import http as web, jsonstate  # noqa: E402

HOME = os.path.expanduser("~")
VENV_PY = os.environ.get("TRIP_RECAP_PY") or os.path.join(HOME, "opt/dive-venv/bin/python")
CONFIG = os.environ.get("TRIP_RECAP_CONFIG") or os.path.join(HOME, ".config/trip-recap/trip.json")
FACE_MODEL = os.environ.get("TRIP_RECAP_FACE_MODEL") or os.path.join(HOME, "opt/trip-recap-models/face_detection_yunet_2023mar.onnx")
VIDMONTAGE = os.environ.get("TRIP_RECAP_VIDMONTAGE") or shutil.which("vidmontage") or os.path.join(HOME, "bin/vidmontage")
UWFIX = os.environ.get("TRIP_RECAP_UWFIX") or shutil.which("uwfix") or os.path.join(HOME, "bin/uwfix")
DIVELOG = os.environ.get("TRIP_RECAP_DIVELOG") or shutil.which("divelog") or os.path.join(HOME, "bin/divelog")
DIVELOG_CONFIG = os.environ.get("DIVELOG_CONFIG") or os.path.join(HOME, ".config/divelog/config.json")
PHOTO = {".jpg", ".jpeg", ".png", ".webp", ".tif", ".tiff", ".bmp"}
SKIPPED = {".heic", ".heif", ".dng", ".cr2", ".cr3", ".nef", ".arw", ".orf", ".rw2", ".raw"}
VIDEO = {".mp4", ".mov", ".m4v", ".mkv", ".avi", ".webm", ".3gp", ".mts", ".m2ts", ".mpg", ".mpeg", ".wmv"}
OVERPASS = ["https://overpass-api.de/api/interpreter", "https://overpass.kumi.systems/api/interpreter",
            "https://overpass.private.coffee/api/interpreter"]
PALETTE = ["#0b7a75", "#c2571a", "#6d4bb3", "#2f6db5", "#a33a5b", "#4f7d2a", "#8a6d00", "#5a6470"]
GREY = "#7a8288"
os.environ.setdefault("OPENCV_LOG_LEVEL", "ERROR")


def reexec():
    try:
        import numpy, cv2, PIL  # noqa: F401
        return
    except ImportError:
        pass
    if os.environ.get("TRIP_RECAP_REEXEC") or not os.path.exists(VENV_PY):
        sys.exit(f"trip-recap needs numpy, opencv and Pillow (venv {VENV_PY})")
    os.environ["TRIP_RECAP_REEXEC"] = "1"
    os.execv(VENV_PY, [VENV_PY, "-I", os.path.abspath(__file__), *sys.argv[1:]])


# ---------- metadata ----------
def _num(v):
    try:
        return float(v)
    except Exception:
        try:
            return v[0] / v[1]
        except Exception:
            return None


def _dms(v, ref):
    try:
        d, m, s = (_num(x) for x in v)
    except Exception:
        return None
    if None in (d, m, s):
        return None
    x = d + m / 60 + s / 3600
    if isinstance(ref, bytes):
        ref = ref.decode(errors="ignore")
    return -x if str(ref or "").strip().upper()[:1] in ("S", "W") else x


def _clean(s):
    if isinstance(s, bytes):
        s = s.decode(errors="ignore")
    return str(s or "").strip().strip("\x00").strip()


def exif_time(s, off, cam_tz, trip_tz):
    m = re.match(r"(\d{4})[:-](\d\d)[:-](\d\d)[ T](\d\d):(\d\d):(\d\d)", _clean(s))
    if not m:
        return None
    try:
        t = dt.datetime(*map(int, m.groups()))
    except ValueError:
        return None
    if t.year < 1990:
        return None
    mo = re.match(r"([+-])(\d\d):?(\d\d)$", _clean(off))
    if mo:
        sign = 1 if mo.group(1) == "+" else -1
        t = t.replace(tzinfo=dt.timezone(sign * dt.timedelta(hours=int(mo.group(2)), minutes=int(mo.group(3)))))
    else:
        t = t.replace(tzinfo=cam_tz)
    return t.astimezone(trip_tz).replace(tzinfo=None)


def iso_time(s, trip_tz):
    s = _clean(s)
    if not s:
        return None
    s = s.replace("Z", "+00:00")
    s = re.sub(r"([+-]\d\d)(\d\d)$", r"\1:\2", s)
    try:
        t = dt.datetime.fromisoformat(s)
    except ValueError:
        return None
    if t.tzinfo is None:
        t = t.replace(tzinfo=dt.timezone.utc)  # QuickTime creation_time is UTC
    if t.year < 1990:
        return None
    return t.astimezone(trip_tz).replace(tzinfo=None)


def iso6709(s):
    m = re.match(r"\s*([+-]\d+(?:\.\d+)?)([+-]\d+(?:\.\d+)?)", _clean(s))
    if not m:
        return None
    lat, lon = float(m.group(1)), float(m.group(2))
    return (lat, lon) if abs(lat) <= 90 and abs(lon) <= 180 and (lat, lon) != (0.0, 0.0) else None


# ---------- per-file analysis (worker processes) ----------
_FD = [None]


def count_faces(arr):
    if not os.path.exists(FACE_MODEL):
        return None
    import cv2
    h, w = arr.shape[:2]
    if _FD[0] is None:
        _FD[0] = cv2.FaceDetectorYN.create(FACE_MODEL, "", (w, h), 0.8, 0.3, 50)
    _FD[0].setInputSize((w, h))
    _, faces = _FD[0].detect(cv2.cvtColor(arr, cv2.COLOR_RGB2BGR))
    if faces is None:
        return 0
    mn = 0.04 * min(w, h)
    return int(sum(1 for f in faces if f[2] >= mn and f[3] >= mn))


def cast_score(arr):
    """0..1: share of mid-tone pixels whose red is crushed against green/blue (underwater look)."""
    import numpy as np
    a = arr[::4, ::4].astype(np.float32)
    r, g, b = a[..., 0], a[..., 1], a[..., 2]
    lum = (r + g + b) / 3
    m = lum > 20  # clipped highlights stay in: big white areas mean sky/sand, not open water
    if m.sum() < 50:
        return 0.0
    gb = np.maximum(g, b)
    frac = float(((r < 0.62 * gb) & (gb - r > 25))[m].mean())
    hi = float(np.percentile(r[m], 98)) / max(1.0, float(np.percentile(gb[m], 98)))
    return round(frac if hi < 0.85 else frac * 0.5, 3)  # white clouds/sand keep red highs: sky, not sea


def dhash(gray):
    import cv2
    s = cv2.resize(gray, (9, 8), interpolation=cv2.INTER_AREA)
    v = 0
    for bit in (s[:, 1:] > s[:, :-1]).flatten():
        v = (v << 1) | int(bit)
    return v


def jpeg_b64(im, side, q):
    t = im.copy()
    t.thumbnail((side, side))
    buf = io.BytesIO()
    t.convert("RGB").save(buf, "JPEG", quality=q, optimize=True)
    return base64.b64encode(buf.getvalue()).decode()


def analyze_photo(path, thumb):
    from PIL import Image, ImageOps
    import numpy as np, cv2
    out = {"path": path, "kind": "photo"}
    try:
        with Image.open(path) as im0:
            ex = im0.getexif()
            sub, gps = ex.get_ifd(0x8769), ex.get_ifd(0x8825)
            out["exif_time"] = _clean(sub.get(0x9003) or sub.get(0x9004) or ex.get(0x0132))
            out["exif_off"] = _clean(sub.get(0x9011) or sub.get(0x9010))
            if gps.get(2) and gps.get(4):
                lat, lon = _dms(gps.get(2), gps.get(1)), _dms(gps.get(4), gps.get(3))
                if lat is not None and lon is not None and abs(lat) <= 90 and abs(lon) <= 180 and (lat, lon) != (0, 0):
                    out["lat"], out["lon"] = lat, lon
            if im0.format == "JPEG":
                im0.draft("RGB", (1600, 1600))
            im = ImageOps.exif_transpose(im0).convert("RGB")
        im.thumbnail((1024, 1024))
        arr = np.asarray(im)
        gray = cv2.cvtColor(arr, cv2.COLOR_RGB2GRAY)
        out["sharp"] = round(float(cv2.Laplacian(gray, cv2.CV_64F).var()), 2)
        g = gray.astype(np.float32) / 255
        mean, std = float(g.mean()), float(g.std())
        clip = float((gray < 8).mean() + (gray > 247).mean())
        exp = (1 - abs(mean - 0.48) / 0.42 - 2 * clip) * min(1.0, std / 0.12)
        out["exposure"] = round(max(0.0, min(1.0, exp)), 3)
        out["uw_cast"] = cast_score(arr)
        out["faces"] = count_faces(arr)
        out["dhash"] = dhash(gray)
        out["thumb"] = jpeg_b64(im, thumb, 72)
    except Exception as e:
        out["error"] = f"{type(e).__name__}: {e}"[:200]
    return out


def analyze_video(path, thumb):
    out = {"path": path, "kind": "video"}
    try:
        r = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration:format_tags:stream_tags",
                            "-of", "json", path], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
        info = json.loads(r.stdout or "{}")
        tags = {k.lower(): v for k, v in ((info.get("format") or {}).get("tags") or {}).items()}
        for s in info.get("streams") or []:
            for k, v in (s.get("tags") or {}).items():
                tags.setdefault(k.lower(), v)
        dur = float((info.get("format") or {}).get("duration") or 0)
        out["duration"] = round(dur, 1)
        out["video_time"] = tags.get("com.apple.quicktime.creationdate") or tags.get("creation_time") or ""
        loc = iso6709(tags.get("com.apple.quicktime.location.iso6709") or tags.get("location") or tags.get("location-eng") or "")
        if loc:
            out["lat"], out["lon"] = loc
        r = subprocess.run(["ffmpeg", "-v", "error", "-ss", f"{min(1.0, dur / 2):.2f}", "-i", path, "-frames:v", "1",
                            "-vf", f"scale=w={thumb}:h={thumb}:force_original_aspect_ratio=decrease",
                            "-f", "image2pipe", "-vcodec", "mjpeg", "-q:v", "5", "-"],
                           capture_output=True, timeout=120, stdin=subprocess.DEVNULL)
        if r.returncode == 0 and r.stdout:
            out["thumb"] = base64.b64encode(r.stdout).decode()
            try:
                from PIL import Image
                import numpy as np
                out["uw_cast"] = cast_score(np.asarray(Image.open(io.BytesIO(r.stdout)).convert("RGB")))
            except Exception:
                pass
    except Exception as e:
        out["error"] = f"{type(e).__name__}: {e}"[:200]
    return out


def analyze(job):
    path, kind, thumb = job
    return analyze_photo(path, thumb) if kind == "photo" else analyze_video(path, thumb)


# ---------- grouping ----------
def km(a, b):
    la1, lo1, la2, lo2 = map(math.radians, (a[0], a[1], b[0], b[1]))
    h = math.sin((la2 - la1) / 2) ** 2 + math.cos(la1) * math.cos(la2) * math.sin((lo2 - lo1) / 2) ** 2
    return 12742 * math.asin(min(1.0, math.sqrt(h)))


def trip_legs(cfg):
    legs = cfg.get("legs") or jsonstate.load(DIVELOG_CONFIG, {}).get("legs") or []
    out = []
    for l in legs:
        try:
            out.append((dt.date.fromisoformat(l["from"]), dt.date.fromisoformat(l["to"]), l["area"]))
        except (KeyError, ValueError, TypeError):
            pass
    return out


def assign_regions(items, cfg):
    regions, maxkm, auto = cfg.get("regions") or [], float(cfg.get("max_km", 40)), []
    for it in items:
        if it.get("lat") is None:
            continue
        p = (it["lat"], it["lon"])
        best = min(((km(p, a), r["name"]) for r in regions for a in r.get("anchors") or []), default=None)
        if best and best[0] <= maxkm:
            it["island"] = best[1]
        elif regions:
            it["island"] = "Elsewhere"
        else:
            name = next((c[1] for c in auto if km(c[0], p) <= 20), None)
            if name is None:
                name = f"Area {len(auto) + 1}"
                auto.append((p, name))
            it["island"] = name
        it["island_src"] = "gps"
    legs = trip_legs(cfg)
    by_day = {}
    for it in items:
        if it.get("island"):
            by_day.setdefault(it["day"], []).append(it)
    for it in items:
        if it.get("island"):
            continue
        same = by_day.get(it["day"]) or []
        if same:
            near = min(same, key=lambda o: abs((o["t"] - it["t"]).total_seconds()))
            it["island"], it["island_src"] = near["island"], "time"
            continue
        d = it["t"].date()
        leg = next((l[2] for l in legs if l[0] <= d <= l[1]), None)
        it["island"], it["island_src"] = (leg, "leg") if leg else ("Unknown", "none")


def load_dives(spec):
    if spec == "none":
        return []
    if spec == "auto":
        if not os.access(DIVELOG, os.X_OK):
            return []
        try:
            r = subprocess.run([DIVELOG, "list", "--json"], capture_output=True, text=True, timeout=60, stdin=subprocess.DEVNULL)
            data = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else []
        except (subprocess.SubprocessError, ValueError, OSError):
            data = []
    else:
        data = jsonstate.load(spec, None)
        if data is None:
            sys.exit(f"cannot read dives file {spec}")
    dives = []
    for x in data if isinstance(data, list) else []:
        try:
            t = dt.datetime.fromisoformat(x["when"]).replace(tzinfo=None)
        except (KeyError, ValueError, TypeError):
            continue
        dives.append({"id": x.get("id"), "t": t, "minutes": x.get("time") or 60, "site": x.get("site") or "Dive",
                      "lat": x.get("lat"), "lon": x.get("lon"), "depth": x.get("depth"), "area": x.get("area")})
    return dives


def select(photos, n):
    c = [p for p in photos if "error" not in p]
    if not c:
        return []
    ls = sorted(math.log1p(p["sharp"]) for p in c)
    for p in c:
        sr = bisect.bisect_left(ls, math.log1p(p["sharp"])) / max(1, len(c) - 1)
        f = p.get("faces") or 0
        face = 1.0 if 1 <= f <= 4 else 0.7 if f > 4 else 0.0
        p["score"] = round(0.45 * sr + 0.35 * p["exposure"] + 0.20 * face, 4)
    kept = []
    for p in sorted(c, key=lambda p: -p["score"]):
        dup = next((k for k in kept if abs((k["t"] - p["t"]).total_seconds()) <= 180
                    and bin(k["dhash"] ^ p["dhash"]).count("1") <= 10), None)
        if dup:
            p["dup_of"] = dup["id"]
        else:
            kept.append(p)
    if len(kept) > n:
        good = [p for p in kept if p["exposure"] >= 0.2]
        kept = good if len(good) >= n else kept
    if len(kept) <= n:
        return sorted(kept, key=lambda p: p["t"])
    days = {}  # variety buckets: each day, with its underwater shots as their own bucket
    for p in kept:
        days.setdefault((p["day"], bool(p.get("underwater"))), []).append(p)
    w = {d: math.sqrt(len(v)) for d, v in days.items()}
    tot = sum(w.values())
    picks = []
    for d, v in days.items():
        picks += sorted(v, key=lambda p: -p["score"])[:min(len(v), max(1, int(n * w[d] / tot)))]
    picks = sorted(picks, key=lambda p: -p["score"])[:n]
    have = {p["id"] for p in picks}
    picks += sorted((p for p in kept if p["id"] not in have), key=lambda p: -p["score"])[:n - len(picks)]
    return sorted(picks, key=lambda p: p["t"])


# ---------- coast ----------
def simplify(pts, tol_m):
    if len(pts) < 3:
        return pts
    kx, ky = 111320 * math.cos(math.radians(pts[0][0])), 110540
    xy = [(p[1] * kx, p[0] * ky) for p in pts]
    keep = [False] * len(pts)
    keep[0] = keep[-1] = True
    stack = [(0, len(pts) - 1)]
    while stack:
        i, j = stack.pop()
        if j <= i + 1:
            continue
        (x1, y1), (x2, y2) = xy[i], xy[j]
        dx, dy = x2 - x1, y2 - y1
        L = math.hypot(dx, dy)
        best, bi = -1.0, -1
        for k in range(i + 1, j):
            x, y = xy[k]
            d = abs(dy * (x - x1) - dx * (y - y1)) / L if L > 0 else math.hypot(x - x1, y - y1)
            if d > best:
                best, bi = d, k
        if best > tol_m:
            keep[bi] = True
            stack += [(i, bi), (bi, j)]
    return [p for p, k in zip(pts, keep) if k]


def coast_from_osm(osm, tol_m, bbox):
    pool = [[(round(n["lat"], 6), round(n["lon"], 6)) for n in el["geometry"]]
            for el in osm.get("elements", []) if el.get("type") == "way" and len(el.get("geometry") or []) >= 2]
    rings, lines = [], []
    while pool:
        cur = pool.pop()
        grown = True
        while grown and cur[0] != cur[-1]:
            grown = False
            for i, w in enumerate(pool):
                if w[0] == cur[-1]:
                    cur, grown = cur + w[1:], True
                elif w[-1] == cur[0]:
                    cur, grown = w + cur[1:], True
                if grown:
                    pool.pop(i)
                    break
        s = [[round(a, 5), round(b, 5)] for a, b in simplify(cur, tol_m)]
        if cur[0] == cur[-1]:
            la, lo = [p[0] for p in cur], [p[1] for p in cur]
            if km((min(la), min(lo)), (max(la), max(lo))) * 1000 < 250 or len(s) < 4:
                continue  # rocks and islets: noise at map scale
            rings.append(s)
        elif len(s) >= 2:
            lines.append(s)
    return {"attribution": "© OpenStreetMap contributors (ODbL)", "bbox": list(bbox), "rings": rings, "lines": lines}


def cmd_coast(argv):
    ap = argparse.ArgumentParser(prog="trip-recap coast")
    ap.add_argument("bbox", help="S,W,N,E in degrees")
    num = r"-?\d+(?:\.\d+)?"
    bb = [x for x in argv if re.fullmatch(",".join([num] * 4), x)]
    if bb:  # a southern box starts with "-": keep argparse from reading it as an option
        argv = [x for x in argv if x != bb[0]] + ["--", bb[0]]
    ap.add_argument("-o", required=True)
    ap.add_argument("--from", dest="src", help="saved Overpass JSON instead of fetching")
    ap.add_argument("--tolerance-m", type=float, default=25)
    a = ap.parse_args(argv)
    try:
        S, W, N, E = (float(x) for x in a.bbox.split(","))
    except ValueError:
        sys.exit("bbox must be S,W,N,E")
    if a.src:
        osm = jsonstate.load(a.src, None)
        if osm is None:
            sys.exit(f"cannot read {a.src}")
    else:
        import urllib.parse, urllib.request
        q = f'[out:json][timeout:90];way["natural"="coastline"]({S},{W},{N},{E});out geom;'
        osm = None
        for url in OVERPASS:
            try:
                req = urllib.request.Request(url, data=urllib.parse.urlencode({"data": q}).encode(),
                                             headers={"User-Agent": "trip-recap/1 (offline map build)"})
                with web.open(req, timeout=100) as r:
                    osm = json.loads(r.read())
                break
            except Exception as e:
                print(f"overpass {url}: {type(e).__name__}", file=sys.stderr)
        if osm is None:
            sys.exit("all Overpass mirrors failed; retry later or pass --from")
    data = coast_from_osm(osm, a.tolerance_m, (S, W, N, E))
    tmp = a.o + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, separators=(",", ":"))
    os.replace(tmp, a.o)
    pts = sum(len(r) for r in data["rings"]) + sum(len(l) for l in data["lines"])
    print(f"coast: {len(data['rings'])} islands, {len(data['lines'])} open lines, {pts} points -> {a.o}")


