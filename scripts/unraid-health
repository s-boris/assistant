def _local_tz():
    for name in (os.environ.get("UNRAID_HEALTH_TZ"), assistant_profile.tz_name()):
        try:
            if name:
                return ZoneInfo(name)
        except Exception:
            pass
    return dt.timezone.utc


LOCAL_TZ = _local_tz()                 # all times in reports/messages; the server itself runs on UTC

# Fullness is judged in bands (% used, strictly above): a finding alerts when it enters a higher band,
# not while it stays in one; today's levels are the baseline.
ARRAY_DISK_BANDS = (90.0, 95.0, 98.0)  # array data disks: 90 warn, 95 and 98 critical
FS_BANDS = (90.0, 95.0)                # pools, libvirt.img, flash, RAM filesystems
DOCKER_BANDS = (75.0, 90.0, 95.0)      # docker.img fills in steps: 75 warns once, 90 again, 95 critical
SPACE_HYST = 1.0                       # must drop this far below its band to leave it
# docker.img growth: warn once when it grew >= 5 GB per 24 h against unraid-capacity's daily sample taken
# 20-48 h before this run (a longer gap is scaled down to 24 h, a shorter one is never scaled up)
DOCKER_GROWTH_WARN = 5e9
GROWTH_REF_MIN_H, GROWTH_REF_MAX_H = 20, 48
CAPACITY_SAMPLES = Path(os.environ.get("UNRAID_HEALTH_CAPACITY_SAMPLES",
                                       HOME / ".local/state/unraid-capacity/samples.jsonl"))
# Degraded array (a member disabled/emulated, not being rebuilt): warn; critical from 7 days on, or when an away
# period (trip-conditions' trips.json, calendar trips of 2+ away nights) starts within 14 days or is running
DEGRADED_STATUSES = ("DISK_DSBL", "DISK_DSBL_NEW", "DISK_NP_DSBL", "DISK_NP_MISSING", "DISK_INVALID")
DEGRADED_CRIT_DAYS, DEGRADED_AWAY_DAYS = 7, 14
TRIPS_FILE = Path(os.environ.get("UNRAID_HEALTH_TRIPS", HOME / ".config/trip-conditions/trips.json"))
CALCACHE_FILE = Path(os.environ.get("UNRAID_HEALTH_CALCACHE", HOME / ".local/state/calcache/events.json"))
ARRAY_FREE_WARN, ARRAY_FREE_CRIT = 3e12, 1e12   # total free bytes across all data disks
PARITY_FALLBACK_DAYS = 40              # max age of the last parity check when no schedule is set
PARITY_GRACE_DAYS = 7                  # with a schedule: overdue after interval + this
HDD_WARN, HDD_CRIT = 50, 55            # defaults; Unraid's dynamix.cfg hot/max win when set
SSD_WARN, SSD_CRIT = 65, 75            # defaults; Unraid's dynamix.cfg hotssd/maxssd win when set
# Floors over Unraid's generic limits (50/55 HDD, 60/70 SSD fire on every parity sync):
# HDDs use hddheat's rule (58 alert, 60 urgent); NVMe pools (SN850X, spec 0-85 °C) run 60-62 under load.
HDD_FLOOR_WARN, HDD_FLOOR_CRIT = 58, 60
SSD_FLOOR_WARN, SSD_FLOOR_CRIT = 65, 75
HDDHEAT_LOG = Path(os.environ.get("UNRAID_HEALTH_HDDHEAT_LOG", HOME / ".local/state/hddheat/runs.log"))
HDDHEAT_FRESH = 2 * 3600               # hddheat counts as active when it logged a run this recently
ACK_FILE = Path(os.environ.get("UNRAID_HEALTH_ACK_FILE", HOME / ".config/unraid-health/ack.json"))
REBUILD_STATUSES = ("DISK_INVALID", "DISK_DSBL", "DISK_DSBL_NEW")
TEMP_HYST = 3
CPU_WARN, CPU_CRIT = 95, 100    # i9-13900K: TjMax 100 °C, 80–90 under load is normal (hwtrend uses 95 too)
CPUTEMP_BIN = os.environ.get("UNRAID_HEALTH_CPUTEMP", str(HOME / "bin/cputemp-log"))   # 24 h CPU heat logger
CPU_THR_WARN_MIN = 30   # package-throttled minutes in 24 h; short TjMax touches add up to ~10-20 min a day
                        # under the vault's LLM load, so 30+ means clearly worse (cooler, dust, fan, new load)
CPU_P95_WARN = 95       # p95 °C of the 24 h samples (hottest of package/core), judged with >= CPU_HEAT_MIN_H logged
CPU_HEAT_MIN_H = 6
CPU_THR_CLEAR = 2 / 3   # an active CPU-throttle WARN clears below 2/3 of the minutes limit and TEMP_HYST below p95
NVME_WEAR_WARN, NVME_WEAR_CRIT = 80, 95
MEM_AVAIL_WARN, MEM_AVAIL_CRIT = 10.0, 5.0    # % of RAM still available
