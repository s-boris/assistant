LOAD_PER_CPU_WARN = 2.0

SUBJ_PREFIX = re.compile(r"^(Alert|Warning|Notice)\s*\[[^\]]*\]\s*-\s*")
NORMAL_RX = re.compile(r"returned to normal (\w+)", re.I)   # "Disk 6 returned to normal temperature"
NORMAL_CAT = {"temperature": "temp", "utilization": "space"}
LEVELS = {"info": 0, "warn": 1, "crit": 2}
LNAME = {"info": "info", "warn": "warning", "crit": "critical"}
TAG = {"info": "INFO", "warn": "WARN", "crit": "CRIT"}

# Kernel/syslog lines worth knowing about (grep -E on the server; matched lines are deduplicated here).
SYSLOG_PATTERN = (
    r"I/O error|[Cc]ritical medium error|Medium Error|md: disk[0-9]+ (read|write) error|"
    r"BTRFS (error|critical|warning)|XFS \([^)]*\): (Corruption|Metadata corruption|metadata I/O error|"
    r"Internal error|.*[Ss]hutting down)|Machine Check|Hardware Error|Out of memory|oom-kill|"
    r"invoked oom-killer|Call Trace|ata[0-9.]+: (exception Emask|failed command|hard resetting link)|"
    r"nvme[0-9]+.*([Tt]imeout|controller is down|Removing after probe failure)|[Uu]nclean shutdown"
)
SYSLOG_KINDS = [
    ("I/O error", r"I/O error|[Cc]ritical medium error|Medium Error|md: disk[0-9]+ (read|write) error"),
    ("BTRFS", r"BTRFS"), ("XFS", r"XFS"), ("hardware error", r"Machine Check|Hardware Error"),
    ("out of memory", r"Out of memory|oom-kill|oom-killer"), ("kernel call trace", r"Call Trace"),
    ("SATA link", r"ata[0-9.]+:"), ("NVMe", r"nvme"), ("unclean shutdown", r"[Uu]nclean shutdown"),
]

# ----------------------------------------------------------------------------- collector
# Runs on the server inside the dispatcher's `health` verb. STRICTLY READ-ONLY. Everything sits in
# main(), so bash reads the whole script before running it and no command can eat the script
# from stdin (main's stdin is /dev/null).
COLLECTOR = r'''# unraid-health collector: STRICTLY READ-ONLY.
# Reads files and runs read-only queries only. Never writes files, never changes array, disk,
# container or VM state, never wakes a spun-down disk: smartctl runs only on disks Unraid reports
# as spinning (spundown=0), and with -n standby, so a disk that spun down meanwhile is skipped too.
main() {
export LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
E=/var/local/emhttp
S() { printf '\n=====UH %s\n' "$*"; }
val() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}\$/\1/p" "$2" 2>/dev/null | head -n 1; }

S meta
echo "now=$(date +%s)"
echo "host=$(hostname)"
echo "boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
awk '/^btime /{print "btime=" $2}' /proc/stat
echo "uptime=$(cut -d' ' -f1 /proc/uptime)"
echo "loadavg=$(cut -d' ' -f1-3 /proc/loadavg)"
echo "nproc=$(nproc 2>/dev/null)"
echo "cpu_model=$(awk -F': *' '/^model name/{print $2; exit}' /proc/cpuinfo)"
echo "unraid_version=$(val version /etc/unraid-version)"
if [ -e /etc/localtime ]; then echo "tz_ok=1"; else echo "tz_ok=0"; fi
echo "tz_link=$(readlink /etc/localtime 2>/dev/null)"
echo "boot_mount_opts=$(awk '$2=="/boot"{print $4; exit}' /proc/mounts)"
echo "docker_enabled=$(val DOCKER_ENABLED /boot/config/docker.cfg)"
echo "vm_service=$(val SERVICE /boot/config/domain.cfg)"
echo "notify_unread_count=$(ls /tmp/notifications/unread 2>/dev/null | wc -l)"
echo "notify_archive_count=$(ls /tmp/notifications/archive 2>/dev/null | wc -l)"
if [ -f /boot/logs/syslog-previous ]; then
  echo "prevlog_mtime=$(stat -c %Y /boot/logs/syslog-previous)"
  echo "prevlog_shutdown_marks=$(tail -n 80 /boot/logs/syslog-previous | grep -cE 'rc\.(0|6)|Sending all processes the SIG|Unmounting local file systems|System halted|Restarting system|Power down')"
fi
echo "preclear=$(pgrep -af 'preclear_disk\.sh' 2>/dev/null | grep -oE '/dev/[A-Za-z0-9]+' | sort -u | tr '\n' ' ')"

S var
grep -E '^(version|NAME|mdState|mdNum[A-Za-z]+|mdResync[A-Za-z]*|sbSynced2?|sbSyncErrs|sbSyncExit|sbClean|sbNumDisks|fsState|fsProgress|fsNumMounted|fsNumUnmountable|fsUnmountableMask|shareMoverActive|startMode|safeMode|configValid|spindownDelay|timeZone)=' $E/var.ini 2>/dev/null
S disks
cat $E/disks.ini 2>/dev/null
S devs
cat $E/devs.ini 2>/dev/null
S monitor
cat $E/monitor.ini 2>/dev/null
S display
sed -n '/^\[display\]/,/^\[/p' /boot/config/plugins/dynamix/dynamix.cfg 2>/dev/null | grep -E '^(warning|critical|hot|max|hotssd|maxssd)='
S parity_log
tail -n 15 /boot/config/parity-checks.log 2>/dev/null
S parity_cfg
sed -n '/^\[parity\]/,/^\[/p' /boot/config/plugins/dynamix/dynamix.cfg 2>/dev/null | grep -v '^\['
S parity_cron
grep -hE 'mdcmd (check|nocorrect)' /boot/config/plugins/dynamix/*.cron 2>/dev/null | head -n 1
S meminfo
grep -E '^(MemTotal|MemAvailable|SwapTotal|SwapFree):' /proc/meminfo
S sensors
timeout 15 sensors -j 2>/dev/null
S df
timeout 20 df -PT -B1 / /boot /var/log /run /var/lib/docker /etc/libvirt 2>/dev/null
awk '$3=="btrfs"{print $2}' /proc/mounts | sort -u | while read -r m; do
  m=$(printf '%b' "$m")
  S btrfs_stats "$m"
  timeout 20 btrfs device stats "$m" </dev/null 2>&1
done
if command -v zpool >/dev/null 2>&1; then S zpool; timeout 20 zpool status -x </dev/null 2>&1; fi

# SMART: Unraid's cached attributes for every disk; live smartctl only for disks that are spinning.
awk -F= '
  function out() { if (name != "") print name, (dev == "" ? "-" : dev), (sd == "" ? "-" : sd), (tr == "" ? "-" : tr) }
  /^\[/ { out(); name = $0; gsub(/[\[\]"]/, "", name); dev = ""; sd = ""; tr = ""; next }
  $1 == "device"    { v = $2; gsub(/"/, "", v); dev = v }
  $1 == "spundown"  { v = $2; gsub(/"/, "", v); sd = v }
  $1 == "transport" { v = $2; gsub(/"/, "", v); tr = v }
  END { out() }' $E/disks.ini $E/devs.ini 2>/dev/null |
while read -r name dev sd tr; do
  [ "$dev" = "-" ] && continue
  [ "$tr" = "usb" ] && continue
  f="$E/smart/$name"
  if [ -s "$f" ]; then S smart_cache "$name" "$dev" "$(stat -c %Y "$f")"; cat "$f"; fi
  if [ "$sd" = "0" ]; then
    case "$tr" in
      nvme) opts="-H -A -i" ;;
      scsi|sas) opts="-n standby -H -A -i -l error" ;;
      *) opts="-n standby -H -A -i" ;;
    esac
    S smartctl "$name" "$dev"
    timeout 40 smartctl $opts "/dev/$dev" </dev/null 2>&1
    echo "=====UH_RC $?"
  fi
done

S docker
ps_out=$(timeout 20 docker ps -a --no-trunc --format '{{.ID}}|{{.Names}}|{{.State}}|{{.Status}}' 2>&1); rc=$?
echo "rc=$rc"
printf '%s\n' "$ps_out"
if [ "$rc" -eq 0 ]; then
  ids=$(printf '%s\n' "$ps_out" | awk -F'|' '$1 != "" && $2 != "@SELF@" {print $1}')
  S docker_inspect
  [ -n "$ids" ] && timeout 30 docker inspect --format '{{.ID}}|{{.Name}}|{{.State.Status}}|{{.State.ExitCode}}|{{.RestartCount}}|{{.State.StartedAt}}|{{.State.FinishedAt}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.OOMKilled}}|{{.HostConfig.RestartPolicy.Name}}|{{.Config.Image}}|{{.State.Error}}' $ids 2>&1
fi
if [ -S /var/run/libvirt/libvirt-sock ] && command -v virsh >/dev/null 2>&1; then
  S virsh
  timeout 15 virsh list --all 2>&1
  echo "=====UH_RC $?"
fi

S notify_unread
ls -t /tmp/notifications/unread 2>/dev/null | grep '\.notify$' | head -n 200 | while read -r f; do
  echo "@file=$f"; cat "/tmp/notifications/unread/$f" 2>/dev/null; echo
done
S syslog_errors
grep -ahE '@PATTERN@' /var/log/syslog.1 /var/log/syslog 2>/dev/null | tail -n 300
S end
}
main </dev/null
exit 0
'''


def collector_script():
    return COLLECTOR.replace("@SELF@", SELF_CONTAINER).replace("@PATTERN@", SYSLOG_PATTERN)


# ----------------------------------------------------------------------------- SSH lockdown switch
UNRAID_SSH = os.environ.get("UNRAID_SSH_BIN") or os.path.expanduser("~/bin/unraid-ssh")


def lockdown_mode():
    return botlib.lockdown_mode(UNRAID_SSH)


# ----------------------------------------------------------------------------- small helpers
def unq(v):
    v = v.strip()
    if len(v) >= 2 and v[0] == v[-1] == '"':
        v = v[1:-1]
    return v


def to_int(v, default=None):
    try:
        return int(str(v).strip().replace(",", ""))
    except (TypeError, ValueError):
        return default


def to_float(v, default=None):
    try:
        return float(str(v).strip())
    except (TypeError, ValueError):
        return default


def first_int(s):
    m = re.match(r"\s*(\d+)", s or "")
    return int(m.group(1)) if m else None


def fmt_bytes(n):
    if n is None:
        return "?"
    n = float(n)
    for unit in ("B", "kB", "MB", "GB", "TB", "PB"):
        if abs(n) < 1000 or unit == "PB":
            return f"{n:.0f} {unit}" if unit in ("B", "kB") or n >= 100 else f"{n:.1f} {unit}"
        n /= 1000.0


def fmt_ts(ts, fmt="%Y-%m-%d %H:%M"):
    if not ts:
        return "?"
    return dt.datetime.fromtimestamp(ts, LOCAL_TZ).strftime(fmt)


def docker_ts(s):
    """Docker's RFC 3339 UTC time ('2026-10-09T09:41:37.70Z') -> epoch, None for the zero time."""
    try:
        t = dt.datetime.strptime(s[:19], "%Y-%m-%dT%H:%M:%S").replace(tzinfo=dt.timezone.utc)
        return None if t.year < 1971 else t.timestamp()
    except (ValueError, TypeError):
        return None


def cron_match(field, value, lo, hi):
    if field == "*":
        return True
    for part in field.split(","):
        step = 1
        if "/" in part:
            part, s = part.split("/", 1)
            step = int(s)
        if part == "*":
            a, b = lo, hi
        elif "-" in part:
            a, b = (int(x) for x in part.split("-", 1))
        else:
            a = b = int(part)
        if a <= value <= b and (value - a) % step == 0:
            return True
    return False


CMP = {"le": lambda a, b: a <= b, "lt": lambda a, b: a < b, "eq": lambda a, b: a == b,
       "ge": lambda a, b: a >= b, "gt": lambda a, b: a > b}


def cron_interval_days(fields, command):
    """Longest gap in days between runs of a cron schedule, including Unraid's week-of-month guards
    like `[[ $(date +%e -d -7days) -le 7 ]] &&`. None if it can't be worked out."""
    try:
        _, _, dom, mon, dow = fields
        conds = [(int(off or 0), op, int(n)) for off, op, n in
                 re.findall(r"date \+%[ed](?: -d ([+-]?\d+) ?days?)?\)\s*-(le|lt|eq|ge|gt)\s*(\d+)", command)]
        start = dt.datetime.now(LOCAL_TZ).date() - dt.timedelta(days=400)
        days = []
        for i in range(1200):
            d = start + dt.timedelta(days=i)
            if not cron_match(mon, d.month, 1, 12):
                continue
            wd = d.isoweekday() % 7
            dom_ok = cron_match(dom, d.day, 1, 31)
            dow_ok = cron_match(dow, wd, 0, 7) or (wd == 0 and cron_match(dow, 7, 0, 7))
            if not ((dom_ok and dow_ok) if "*" in (dom, dow) else (dom_ok or dow_ok)):
                continue
            if all(CMP[op]((d + dt.timedelta(days=off)).day, n) for off, op, n in conds):
                days.append(d)
        if len(days) < 2:
            return None
        return max((b - a).days for a, b in zip(days, days[1:]))
    except (ValueError, TypeError):
        return None


def fmt_dur(sec):
    if sec is None:
        return "?"
    sec = int(sec)
    d, r = divmod(sec, 86400)
    h, r = divmod(r, 3600)
    m = r // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m:02d}m"
    return f"{m}m"


def fmtv(v, unit=""):
    if v is None:
        return "?"
    if isinstance(v, float):
        v = round(v, 1)
        if v == int(v):
            v = int(v)
    return f"{v}{unit}"


def shorten(s, n):
    s = " ".join(str(s).split())
    return s if len(s) <= n else s[: n - 1] + "…"


atomic_write = botlib.atomic_write


# ----------------------------------------------------------------------------- parsing
def parse_kv(text):
    out = {}
    for line in text.splitlines():
        if "=" in line and not line.lstrip().startswith("["):
            k, v = line.split("=", 1)
            out[k.strip()] = unq(v)
    return out


def parse_ini(text):
    out, cur = {}, None
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith(("#", ";")):
            continue
        m = re.fullmatch(r'\[\s*"?([^"\]]*)"?\s*\]', line)
        if m:
            cur = out.setdefault(m.group(1), {})
            continue
        if "=" in line:
            k, v = line.split("=", 1)
            (cur if cur is not None else out.setdefault("", {}))[k.strip()] = unq(v)
    return out


ATA_RE = re.compile(r"^\s*(\d{1,3})\s+(\S+)\s+0x[0-9a-fA-F]+\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(\S+)\s+(.*)$")


def parse_smart(text):
    r = {"kind": None, "health": None, "temp": None, "attrs": {}, "standby": False, "grown": None,
         "uncorrected": None, "nonmedium": None, "nvme": {}, "model": None, "serial": None, "poh": None}
    if not text:
        return r
    if re.search(r"Device is in (STANDBY|SLEEP|IDLE\S*) mode", text):
        r["standby"] = True
    unc, have_unc = 0, False
    for line in text.splitlines():
        m = ATA_RE.match(line)
        if m:
            r["attrs"][int(m.group(1))] = {
                "name": m.group(2), "value": to_int(m.group(3)), "worst": to_int(m.group(4)),
                "thresh": to_int(m.group(5)), "when_failed": m.group(8), "raw": first_int(m.group(9)),
                "raw_str": m.group(9).strip()}
            r["kind"] = "ata"
            continue
        s = line.strip()
        if (m := re.match(r"SMART overall-health self-assessment test result:\s*(\S+)", s)):
            r["health"] = m.group(1)
        elif (m := re.match(r"SMART Health Status:\s*(.+)", s)):
            r["health"] = m.group(1).strip()
            r["kind"] = r["kind"] or "scsi"
        elif (m := re.match(r"Current Drive Temperature:\s+(\d+)", s)):
            r["temp"] = int(m.group(1))
            r["kind"] = r["kind"] or "scsi"
        elif (m := re.match(r"Elements in grown defect list:\s+(\d+)", s)):
            r["grown"] = int(m.group(1))
            r["kind"] = "scsi"
        elif (m := re.match(r"(read|write|verify):\s+(.+)$", s)):
            parts = m.group(2).split()
            if parts and parts[-1].isdigit():
                unc += int(parts[-1])
                have_unc = True
        elif (m := re.match(r"Non-medium error count:\s+(\d+)", s)):
            r["nonmedium"] = int(m.group(1))
        elif (m := re.match(r"Critical Warning:\s+0x([0-9a-fA-F]+)", s)):
            r["nvme"]["critical_warning"] = int(m.group(1), 16)
            r["kind"] = "nvme"
        elif (m := re.match(r"Temperature:\s+(\d+) Celsius", s)):
            r["temp"] = int(m.group(1))
        elif (m := re.match(r"Available Spare:\s+(\d+)%", s)):
            r["nvme"]["spare"] = int(m.group(1))
        elif (m := re.match(r"Available Spare Threshold:\s+(\d+)%", s)):
            r["nvme"]["spare_threshold"] = int(m.group(1))
        elif (m := re.match(r"Percentage Used:\s+(\d+)%", s)):
            r["nvme"]["used"] = int(m.group(1))
        elif (m := re.match(r"Media and Data Integrity Errors:\s+([\d,]+)", s)):
            r["nvme"]["media_errors"] = to_int(m.group(1))
        elif (m := re.match(r"(Warning|Critical)\s+Comp\. Temperature Time:\s+([\d,]+)", s)):
            r["nvme"][f"{m.group(1)[:4].lower()}_temp_min"] = to_int(m.group(2))   # minutes above WCTEMP/CCTEMP
        elif (m := re.match(r"Unsafe Shutdowns:\s+([\d,]+)", s)):
            r["nvme"]["unsafe_shutdowns"] = to_int(m.group(1))
        elif (m := re.match(r"Power On Hours:\s+([\d,]+)", s)):
            r["poh"] = to_int(m.group(1))
        elif (m := re.match(r"Accumulated power on time, hours:minutes\s+(\d+)", s)):
            r["poh"] = int(m.group(1))
        elif (m := re.match(r"(?:Device Model|Model Number|Product):\s+(.+)", s)):
            r["model"] = m.group(1).strip()
        elif (m := re.match(r"Serial [Nn]umber:\s+(.+)", s)):
            r["serial"] = m.group(1).strip()
    if have_unc:
        r["uncorrected"] = unc
    if r["kind"] == "ata":
        if r["temp"] is None:
            for aid in (194, 190):
                if aid in r["attrs"] and r["attrs"][aid]["raw"] is not None:
                    r["temp"] = r["attrs"][aid]["raw"]
                    break
        if 9 in r["attrs"]:
            r["poh"] = r["attrs"][9]["raw"]
    return r


def parse_df(text):
    out = {}
    for line in text.splitlines():
        p = line.split()
        if len(p) >= 7 and p[2].isdigit() and p[3].isdigit() and p[4].isdigit():
            out[" ".join(p[6:])] = {"dev": p[0], "type": p[1], "size": int(p[2]), "used": int(p[3]),
                                    "avail": int(p[4])}
    return out


def parse_btrfs(text):
    """btrfs device stats -> ({counter: total over devices}, sorted device list)."""
    c, devs = {}, set()
    for line in text.splitlines():
        m = re.match(r"\[(.+?)\]\.(\w+)\s+(-?\d+)", line.strip())
        if m:
            devs.add(m.group(1))
            name = m.group(2).replace("_io_errs", "").replace("_errs", "")
            c[name] = c.get(name, 0) + int(m.group(3))
    return c, sorted(devs)


def parse_docker(ps_text, inspect_text):
    rc, ps, other = None, [], []
    for line in ps_text.splitlines():
        if line.startswith("rc=") and rc is None:
            rc = to_int(line[3:])
            continue
        p = line.split("|", 3)
        if len(p) == 4 and re.fullmatch(r"[0-9a-f]{12,64}", p[0]):
            ps.append({"id": p[0], "name": p[1], "state": p[2], "status": p[3]})
        elif line.strip():
            other.append(line.strip())
    insp = {}
    for line in inspect_text.splitlines():
        p = line.split("|", 11)
        if len(p) < 11 or not re.fullmatch(r"[0-9a-f]{12,64}", p[0]):
            continue
        name = p[1].lstrip("/")
        insp[name] = {"id": p[0], "name": name, "status": p[2], "exit": to_int(p[3], 0),
                      "restarts": to_int(p[4], 0), "started": p[5], "finished": p[6], "health": p[7],
                      "oom": p[8] == "true", "policy": p[9], "image": p[10],
                      "error": p[11] if len(p) > 11 else ""}
    return {"rc": rc, "ps": ps, "inspect": insp, "error": " ".join(other)[:300]}


def parse_virsh(text):
    vms = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith(("Id ", "---")) or s.startswith("error"):
            continue
        cols = re.split(r"\s{2,}", s)
        if len(cols) >= 3:
            vms[cols[1]] = cols[2]
    return vms


def parse_notifications(text):
    out, cur = [], None
    for line in text.splitlines():
        if line.startswith("@file="):
            cur = {"file": line[6:].strip()}
            out.append(cur)
        elif cur is not None and "=" in line:
            k, v = line.split("=", 1)
            cur[k.strip()] = unq(v)
    return out


def parse_parity_log(text, tzname):
    try:
        tz = ZoneInfo(tzname or assistant_profile.tz_name())
    except Exception:
        tz = dt.timezone.utc
    out = []
    for line in text.splitlines():
        p = line.strip().split("|")
        if len(p) < 5:
            continue
        try:
            ts = dt.datetime.strptime(" ".join(p[0].split()), "%Y %b %d %H:%M:%S").replace(tzinfo=tz).timestamp()
        except ValueError:
            ts = None
        out.append({"when": " ".join(p[0].split()), "ts": ts, "duration": to_int(p[1]), "speed": to_int(p[2]),
                    "exit": to_int(p[3]), "errors": to_int(p[4]),
                    "action": p[5] if len(p) > 5 and p[5] else "check", "size": to_int(p[6]) if len(p) > 6 else None})
    return out


def parse_sensors(text):
    try:
        j = json.loads(text)
    except (ValueError, TypeError):
        return None
    res = {"cpu": None, "cpu_high": None, "cpu_crit": None, "cpu_label": None, "board": None}
    pref = ["CPU Temp", "Package id 0", "Tdie", "Tctl"]
    for chip, feats in j.items():
        if not isinstance(feats, dict):
            continue
        cpu_chip = chip.startswith(("coretemp", "k10temp", "zenpower"))
        cores = []
        for label, vals in feats.items():
            if not isinstance(vals, dict):
                continue
            inp = next((v for k, v in vals.items() if k.endswith("_input")), None)
            if inp is None:
                continue
            if label == "MB Temp" and res["board"] is None:
                res["board"] = inp
            if not cpu_chip:
                continue
            if label in pref and (res["cpu_label"] not in pref or pref.index(label) < pref.index(res["cpu_label"])):
                res.update(cpu=inp, cpu_label=label,
                           cpu_high=next((v for k, v in vals.items() if k.endswith("_max")), None),
                           cpu_crit=next((v for k, v in vals.items() if k.endswith("_crit")), None))
            elif label.startswith("Core"):
                cores.append(inp)
        if cpu_chip and res["cpu"] is None and cores:
            res.update(cpu=max(cores), cpu_label="hottest core")
    return res


def split_sections(raw):
    secs, cur = [], None
    for line in raw.splitlines():
        if line.startswith("=====UH "):
            parts = line[8:].split(" ")
            cur = {"name": parts[0], "args": parts[1:], "lines": [], "rc": None}
            secs.append(cur)
        elif line.startswith("=====UH_RC "):
            if cur is not None:
                cur["rc"] = to_int(line.split()[1])
        elif cur is not None:
            cur["lines"].append(line)
    for s in secs:
        s["text"] = "\n".join(s["lines"]).strip("\n")
    return secs


SECTION_PARSERS = {"meta": parse_kv, "var": parse_kv, "display": parse_kv, "parity_cfg": parse_kv,
                   "disks": parse_ini, "devs": parse_ini, "monitor": parse_ini, "df": parse_df,
                   "parity_log": str, "zpool": str, "parity_cron": str.strip,
                   "sensors": lambda t: parse_sensors(t) if t.strip() else None}


def parse_all(raw):
    d = {"meta": {}, "var": {}, "disks": {}, "devs": {}, "monitor": {}, "display": {}, "parity_log": "",
         "parity_cfg": {}, "parity_cron": "",
         "meminfo": {}, "sensors": None, "df": {}, "btrfs": {}, "zpool": None, "smart": {}, "docker": None,
         "virsh": None, "notifications": [], "syslog": [], "sections": []}
    docker_ps, docker_inspect = None, ""
    for s in split_sections(raw):
        n, t, a = s["name"], s["text"], s["args"]
        d["sections"].append(n)
        if n in SECTION_PARSERS:
            d[n] = SECTION_PARSERS[n](t)
        elif n == "meminfo":
            for line in t.splitlines():
                m = re.match(r"(\w+):\s+(\d+)", line)
                if m:
                    d["meminfo"][m.group(1)] = int(m.group(2)) * 1024
        elif n == "btrfs_stats":
            counters, devs = parse_btrfs(t)
            d["btrfs"][" ".join(a)] = {"counters": counters, "devs": devs, "text": t}
        elif n == "smart_cache" and len(a) >= 3:
            d["smart"].setdefault(a[0], {})["cache"] = {"dev": a[1], "mtime": to_int(a[2]), "text": t}
        elif n == "smartctl" and len(a) >= 2:
            d["smart"].setdefault(a[0], {})["live"] = {"dev": a[1], "rc": s["rc"], "text": t}
        elif n == "docker":
            docker_ps = t
        elif n == "docker_inspect":
            docker_inspect = t
        elif n == "virsh":
            d["virsh"] = {"rc": s["rc"], "vms": parse_virsh(t), "text": t}
        elif n == "notify_unread":
            d["notifications"] = parse_notifications(t)
        elif n == "syslog_errors":
            d["syslog"] = [line for line in t.splitlines() if line.strip()]
    if docker_ps is not None:
        d["docker"] = parse_docker(docker_ps, docker_inspect)
    return d


# ----------------------------------------------------------------------------- evaluation
# ----------------------------------------------------------------------------- sync, hddheat, acks
def resync_info(v, disks):
    """The running (or paused) sync from var.ini, plus the slots a parity sync / data rebuild writes to
    (mdResyncAction "recon P|Q|Dn ..."; P = idx 0, Q = idx 29, Dn = idx n). None when no sync runs."""
    size, pos = to_int(v.get("mdResyncSize"), 0), to_int(v.get("mdResyncPos"), 0)
    if not pos:
        return None
    action = v.get("mdResyncAction", "")
    parts = action.split()
    kind = ("Parity check" if parts[:1] == ["check"] and len(parts) > 1 else
            "Read check" if parts[:1] == ["check"] else
            "Parity sync" if parts[:1] == ["recon"] and parts[1:2] in (["P"], ["Q"], ["P", "Q"]) else
            "Data rebuild" if parts[:1] == ["recon"] else
            "Disk clear" if parts[:1] == ["clear"] else action or "Sync")
    dt_s, db = to_int(v.get("mdResyncDt"), 0), to_int(v.get("mdResyncDb"), 0)
    speed = db * 1024 / dt_s if dt_s else None
    paused = to_int(v.get("mdResync"), 0) == 0
    eta = (size - pos) * 1024 / speed if speed and not paused else None
    targets = []
    if parts[:1] == ["recon"]:
        by_idx = {str(to_int(x.get("idx"))): n for n, x in disks.items() if x.get("type") in ("Parity", "Data")}
        for tok in parts[1:]:
            idx = "0" if tok == "P" else "29" if tok == "Q" else tok[1:] if re.fullmatch(r"D\d+", tok) else None
            if idx in by_idx:
                targets.append(by_idx[idx])
    return {"kind": kind, "action": action, "pct": 100.0 * pos / size if size else None,
            "speed": speed, "eta": eta, "paused": paused, "targets": targets}


def sync_progress(s):
    return (f"{s['kind'].lower()} {'paused at ' if s['paused'] else ''}{s['pct'] or 0:.1f}%"
            + (f", about {fmt_dur(s['eta'])} left" if s.get("eta") else ""))


def hddheat_active(now):
    """hddheat (cron, every 10 min) owns array/parity HDD heat while it keeps logging runs."""
    try:
        return abs(now - HDDHEAT_LOG.stat().st_mtime) < HDDHEAT_FRESH
    except OSError:
        return False


ACK_FORMS = ("container", "stopped", "disk", "key", "text")
STOPPED_KEYS = ("exited:*", "dead", "gone")   # stopped:NAME covers ctr:NAME:<these>


def ack_active(a, today):
    """An ack applies while today is before its expiry date; "never" does not expire."""
    return str(a.get("expires")) == "never" or str(a.get("expires")) > today


def load_acks(path):
    """-> (acks, problem). A broken file never stops the check: no acks apply and the report says so."""
    if not path.exists():
        return [], None
    try:
        acks = json.loads(path.read_text()).get("acks", [])
        if not isinstance(acks, list):
            raise ValueError("'acks' is not a list")
    except Exception as e:
        return [], f"ack file {path} unreadable ({e.__class__.__name__}: {e}); no acks applied"
    return [a for a in acks if isinstance(a, dict) and a.get("match") and a.get("expires")], None


def ack_matches(a, f):
    if LEVELS.get(f.get("level"), 0) > LEVELS.get(a.get("max_level", "warn"), 1):
        return False
    kind, _, val = str(a["match"]).partition(":")
    key, title = f.get("key", ""), f.get("msg") or f.get("title") or ""
    return bool(val) and (kind == "container" and fnmatchcase(key, f"ctr:{val}:*")
                          or kind == "stopped" and any(fnmatchcase(key, f"ctr:{val}:{x}") for x in STOPPED_KEYS)
                          or kind == "disk" and f.get("subject") == val
                          or kind == "key" and fnmatchcase(key, val)
                          or kind == "text" and val.lower() in title.lower())


def local_date(ts):
    return dt.datetime.fromtimestamp(ts, LOCAL_TZ).date().isoformat()


def held_disk(x, seen_id=""):
    """Does (or did) this array slot hold a disk? A device id now or in the superblock, a superblock size, an
    (emulated) filesystem, Unraid's red "disabled" colour, or an id an earlier run saw in the slot (seen_id). Only
    a slot with none of these never held one: an unassigned parity2 slot reads DISK_NP_DSBL, grey-off, sizeSb 0."""
    return bool(x.get("id") or x.get("idSb") or seen_id or to_int(x.get("sizeSb"), 0) > 0
                or to_int(x.get("fsSize"), 0) > 0 or x.get("fsStatus") == "Mounted"
                or str(x.get("color", "")).startswith("red"))


def away_periods():
    """[(first day, last day, source)] he is away: trip-conditions' trips (from/to) and calendar trips of 2+
    consecutive away nights (core.away; last day = the last night). Unreadable sources count as none."""
    out = []
    try:
        data = json.loads(TRIPS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = {}
    trips = data.get("trips", data) if isinstance(data, dict) else data
    for t in trips.values() if isinstance(trips, dict) else trips if isinstance(trips, list) else []:
        try:
            out.append((dt.date.fromisoformat(str(t["from"])[:10]), dt.date.fromisoformat(str(t["to"])[:10]), "trip"))
        except (KeyError, TypeError, ValueError):
            continue
    if away_rule is not None:
        try:
            cal = away_rule.trips(away_rule.load(str(CALCACHE_FILE)), 2)
            out += [(t["from"], t["last_night"], "calendar") for t in cal]
        except Exception:
            pass
    return sorted(p for p in out if p[0] <= p[1])


def fmt_day(d):
    return f"{d.day:02d}.{d.month:02d}."


SYSLOG_TS = re.compile(r"`(\w{3} +\d{1,2} \d\d:\d\d:\d\d) \S+ kernel: md: (\w+) (?:read|write) error")


def degraded_seed(slot, now, report_dir):
    """When did `slot` turn degraded, for a slot this state has no record of (first run of this rule, or a lost
    state)? The first of the unbroken run of daily reports up to yesterday that list it as disabled or as an empty
    slot, refined by that report's first md read/write error line for it; None when yesterday's doesn't."""
    if not report_dir:
        return None
    day, first, text = dt.datetime.fromtimestamp(now, LOCAL_TZ).date(), None, ""
    rx = re.compile(rf"\b{re.escape(slot)}: status DISK_\w*DSBL|empty slot\(s\): [^\n]*\b{re.escape(slot)}\b"
                    rf"|Array degraded: [^\n]*\b{re.escape(slot)}\b")
    for _ in range(KEEP_REPORTS):
        day -= dt.timedelta(days=1)
        try:
            t = (Path(report_dir) / f"{day.isoformat()}.md").read_text(encoding="utf-8", errors="replace")
        except OSError:
            break
        if not rx.search(t):
            break
        first, text = day, t
    if first is None:
        return None
    since = dt.datetime.combine(first, dt.time(), LOCAL_TZ).timestamp()
    for stamp, s in SYSLOG_TS.findall(text):
        if s != slot:
            continue
        try:
            when = dt.datetime.strptime(f"{first.year} {stamp}", "%Y %b %d %H:%M:%S")
        except ValueError:
            continue
        if when.date() > first:
            when = when.replace(year=first.year - 1)
        since = when.replace(tzinfo=LOCAL_TZ).timestamp()   # the failure itself, usually the evening before
        break
    return since


def load_capacity_samples(path=None, tail=12):
    """The last `tail` daily samples of unraid-capacity (samples.jsonl); [] when there are none."""
    try:
        lines = Path(path or CAPACITY_SAMPLES).read_text(encoding="utf-8", errors="replace").splitlines()[-tail:]
    except OSError:
        return []
    out = []
    for ln in lines:
        try:
            s = json.loads(ln)
        except ValueError:
            continue
        if isinstance(s, dict):
            out.append(s)
    return out


class Check:
    """Turns parsed data + previous state into findings, then diffs them against the last run."""

    def __init__(self, d, prev, first_run, now, acks=None, report_dir=None):
        self.d, self.prev, self.first_run, self.now = d, prev, first_run, now
        self.report_dir = report_dir   # read only: dates a degraded slot this state has no record of
        self.pa = {} if first_run else prev.get("active", {})
        self.conds, self.events, self.info, self.gaps = [], [], [], []
        self.m = {}      # metrics for the report / json
        self.st = {}     # state parts to persist
        today = local_date(now)
        self.acks = [a for a in acks or [] if ack_active(a, today)]
        self.acks_expired = [a for a in acks or [] if not ack_active(a, today)]
        self.acked = []
        self.sync = None

    def ack_for(self, f):
        return next((a for a in self.acks if ack_matches(a, f)), None)

    # findings -------------------------------------------------------------
    def cond(self, key, level, title, cat, subject="", value=None, step=None, unit="", detail=""):
        self.conds.append({"key": key, "level": level, "title": title, "cat": cat, "subject": subject,
                           "value": value, "step": step, "unit": unit, "detail": detail, "kind": "cond"})

    def event(self, key, level, title, cat, subject="", detail=""):
        self.events.append({"key": key, "level": level, "title": title, "cat": cat, "subject": subject,
                            "detail": detail, "kind": "event"})

    def plevel(self, key):
        p = self.pa.get(key)
        return p.get("level") if p else None

    def leveled(self, key, value, warn, crit, hyst):
        """Level for a value with thresholds (>= warn / >= crit); an active finding clears only
        once the value drops `hyst` below its threshold (no flapping on borderline readings)."""
        prev = self.plevel(key)
        if value >= crit or (prev == "crit" and value >= crit - hyst):
            return "crit"
        if value >= warn or (prev in ("warn", "crit") and value >= warn - hyst):
            return "warn"
        return None

    def safe(self, fn):
        try:
            fn()
        except Exception as e:  # a bug in one check must not kill the whole run
            self.gaps.append(f"internal error in {fn.__name__}: {e.__class__.__name__}: {e}")
            traceback.print_exc(file=sys.stderr)

    def run(self):
        for fn in (self.system, self.cpu_heat, self.array, self.parity, self.drives, self.space, self.pools,
                   self.containers, self.vms, self.syslog):
            self.safe(fn)
        return self

    # system -----------------------------------------------------------------
    def system(self):
        meta, mi = self.d["meta"], self.d["meminfo"]
        load = [to_float(x) for x in meta.get("loadavg", "").split()]
        nproc = to_int(meta.get("nproc"), 1) or 1
        sysm = {"host": meta.get("host", "?"), "version": meta.get("unraid_version", "?"),
                "cpu_model": meta.get("cpu_model", ""), "uptime": to_float(meta.get("uptime")),
                "btime": to_int(meta.get("btime")), "load": load, "nproc": nproc,
                "server_now": to_int(meta.get("now")), "tz_ok": meta.get("tz_ok") == "1",
                "tz_link": meta.get("tz_link", ""), "preclear": meta.get("preclear", "").split(),
                "mem_total": mi.get("MemTotal"), "mem_avail": mi.get("MemAvailable"),
                "swap_total": mi.get("SwapTotal"), "swap_free": mi.get("SwapFree")}
        self.m["system"] = sysm
        if not meta:
            self.gaps.append("collector meta section missing")
            return
        # clock drift between server and container (would skew ages)
        if sysm["server_now"] and abs(sysm["server_now"] - self.now) > 300:
            self.cond("sys:clock", "warn", f"Server clock is off by {int(sysm['server_now'] - self.now)} s",
                      "sys")
        # reboot since last run
        bid, pbid = meta.get("boot_id"), self.prev.get("boot_id")
        if bid and pbid and bid != pbid:
            btime = sysm["btime"] or 0
            sb_clean = self.d["var"].get("sbClean", "")
            plm, marks = to_int(meta.get("prevlog_mtime")), to_int(meta.get("prevlog_shutdown_marks"), 0)
            last_seen = self.prev.get("server_now") or 0
            clean = (sb_clean != "no" and plm is not None and marks > 0
                     and last_seen - 60 <= plm <= btime + 120)
            why = ("Unraid flags an unclean shutdown" if sb_clean == "no"
                   else "no clean-shutdown log was saved" if plm is None
                   else "the last saved shutdown log is older than the previous check")
            if clean:
                self.event("sys:reboot", "info", f"Server was rebooted (clean shutdown {fmt_ts(plm)}, "
                           f"up since {fmt_ts(btime)})", "sys")
            else:
                self.event("sys:reboot", "warn", f"Server rebooted unexpectedly: up since {fmt_ts(btime)}, {why}",
                           "sys")
        pv = self.prev.get("unraid_version")
        if pv and sysm["version"] != "?" and pv != sysm["version"]:
            self.event("sys:version", "info", f"Unraid was updated: {pv} → {sysm['version']}", "sys")
        # timezone file (Unraid 7.3's trimmed zoneinfo may lack the configured zone)
        if meta.get("tz_ok") == "0":
            zone = sysm["tz_link"].split("zoneinfo/")[-1] or "?"
            self.cond("sys:timezone", "warn", f"Server timezone {zone} is missing from zoneinfo: the clock and "
                      "scheduled jobs (mover, parity check, TRIM) run on UTC", "sys")
        # load
        if len(load) == 3 and load[2] is not None and load[2] > LOAD_PER_CPU_WARN * nproc:
            self.cond("sys:load", "warn", f"Load is very high: {load[2]:.1f} (15-min) on {nproc} threads", "sys")
        # memory / swap
        if sysm["mem_total"] and sysm["mem_avail"] is not None:
            pct = 100.0 * sysm["mem_avail"] / sysm["mem_total"]
            if pct < MEM_AVAIL_WARN:
                lvl = "crit" if pct < MEM_AVAIL_CRIT else "warn"
                self.cond("sys:memory", lvl, f"Memory is low: {fmt_bytes(sysm['mem_avail'])} available "
                          f"({pct:.1f}% of {fmt_bytes(sysm['mem_total'])})", "sys")
        else:
            self.gaps.append("memory figures not available")
        if sysm["swap_total"]:
            used = 100.0 * (sysm["swap_total"] - (sysm["swap_free"] or 0)) / sysm["swap_total"]
            if used > SWAP_USED_WARN:
                self.cond("sys:swap", "warn", f"Swap is {used:.0f}% used", "sys")
        # CPU temperature
        sen = self.d["sensors"]
        self.m["sensors"] = sen
        if sen and sen.get("cpu") is not None:
            warn = sen.get("cpu_high") or CPU_WARN
            warn = min(warn, CPU_WARN) if warn > 0 else CPU_WARN
            lvl = self.leveled("sys:cpu_temp", sen["cpu"], warn, max(CPU_CRIT, warn + 5), TEMP_HYST)
            if lvl:
                self.cond("sys:cpu_temp", lvl, f"CPU is hot: {sen['cpu']:.0f}°C", "temp", subject="cpu")
        else:
            self.gaps.append("CPU temperature: sensors gave no CPU reading")
        if meta.get("boot_mount_opts") and not meta["boot_mount_opts"].startswith("rw"):
            self.cond("boot:ro", "crit", "Flash drive (/boot) is not mounted read-write", "array", subject="flash")

    def cpu_heat(self):
        """The last 24 h of cputemp-log: always a report line; WARN when throttling stays high."""
        if not os.access(CPUTEMP_BIN, os.X_OK):
            return                     # logger not installed here: nothing to report
        end = dt.datetime.fromtimestamp(self.now, LOCAL_TZ).replace(tzinfo=None, microsecond=0)
        span = f"{end - dt.timedelta(hours=24):%Y-%m-%d %H:%M:%S}..{end:%Y-%m-%d %H:%M:%S}"
        try:
            p = subprocess.run([CPUTEMP_BIN, "summary", span, "--json"], capture_output=True, text=True,
                               timeout=60, stdin=subprocess.DEVNULL)
            a = json.loads(p.stdout)["windows"]["all"]
        except (OSError, subprocess.SubprocessError, ValueError, KeyError, TypeError) as e:
            self.gaps.append(f"CPU heat: cputemp-log gave no usable summary ({e.__class__.__name__})")
            return
        if not a.get("rows"):
            self.gaps.append("CPU heat: cputemp-log logged nothing in the last 24 h (`cputemp-log status`)")
            return
        thr_min, p95, hours = (a.get("thr_s") or 0) / 60, a.get("p95"), a.get("hours") or 0
        self.m["cpu_heat"] = {"rows": a["rows"], "hours": hours, "max": a.get("max"), "p95": p95,
                              "thr_min": round(thr_min, 1), "mean_w": a.get("mean_w"), "mhz": a.get("mhz"),
                              "limit_min": CPU_THR_WARN_MIN, "limit_p95": CPU_P95_WARN}
        held = self.plevel("sys:cpu_throttle") is not None
        lim_min = CPU_THR_WARN_MIN * (CPU_THR_CLEAR if held else 1)
        lim_p95 = CPU_P95_WARN - (TEMP_HYST if held else 0)
        hot_min = thr_min > lim_min
        hot_p95 = p95 is not None and hours >= CPU_HEAT_MIN_H and p95 >= lim_p95
        if hot_min or hot_p95:
            why = " and ".join(x for x, on in ((f"{thr_min:.0f} min package-throttled", hot_min),
                                               (f"p95 {p95:.0f}°C", hot_p95)) if on)
            self.cond("sys:cpu_throttle", "warn", f"CPU throttles a lot: {why} in 24 h (limit {CPU_THR_WARN_MIN} "
                      f"min / p95 {CPU_P95_WARN}°C; `cputemp-log summary`)", "temp", subject="cpu",
                      value=round(thr_min, 1), unit=" min")

    # array --------------------------------------------------------------------
    def array(self):
        v, disks = self.d["var"], self.d["disks"]
        if not v or not disks:
            self.cond("collector:emhttp", "warn", "Unraid state files (var.ini/disks.ini) could not be read", "array")
            return
        arr = [x for x in disks.values() if x.get("type") in ("Parity", "Data")]
        # last id seen per slot (this run's slots + earlier runs'): a slot that lost its device still "held a disk"
        hist = {n: i for n, i in (self.prev.get("slot_hist") or {}).items() if i}
        hist.update({n: i for n, i in (self.prev.get("slots") or {}).items() if i})
        hist.update({n: x.get("id") for n, x in disks.items() if x.get("id")})
        # never held a disk (e.g. no parity2 assigned): expected, the only exemption. An id seen before counts for
        # data slots only: a parity slot emptied on purpose (New Config) reads like one never assigned
        seen = {x.get("name"): hist.get(x.get("name"), "") for x in arr if x.get("type") == "Data"}
        empty = [x for x in arr if x.get("status") in ("DISK_NP_DSBL", "DISK_NP")
                 and not held_disk(x, seen.get(x.get("name"), ""))]
        empty_dsbl = sum(1 for x in empty if x.get("status") == "DISK_NP_DSBL")
        degr = [x for x in arr if x.get("status") in DEGRADED_STATUSES and x not in empty]
        # disabled with its device gone (emulated): carried by array:degraded alone, not the generic disk CRITs
        gone = [x for x in degr if x.get("status") == "DISK_NP_DSBL" and not x.get("id")]
        a = {"state": v.get("mdState"), "fs_state": v.get("fsState"),
             "parity": [x["name"] for x in arr if x.get("type") == "Parity" and (x.get("id") or x.get("idSb"))],
             "data": [x["name"] for x in arr if x.get("type") == "Data" and held_disk(x, seen.get(x.get("name"), ""))],
             "empty_slots": [x["name"] for x in empty],
             "disabled": to_int(v.get("mdNumDisabled"), 0), "invalid": to_int(v.get("mdNumInvalid"), 0),
             "missing": to_int(v.get("mdNumMissing"), 0), "expected_dsbl": empty_dsbl,
             "mover": v.get("shareMoverActive") == "yes", "safe_mode": v.get("safeMode") == "yes"}
        self.m["array"] = a
        if a["state"] != "STARTED":
            self.cond("array:state", "crit", f"Array is not started (mdState={a['state']}, fsState={a['fs_state']})",
                      "array")
        unm = to_int(v.get("fsNumUnmountable"), 0)
        if unm:
            self.cond("array:unmountable", "crit", f"{unm} disk(s) unmountable {v.get('fsUnmountableMask', '')}".strip(),
                      "array")
        self.sync = sync = resync_info(v, disks)
        targets = set(sync["targets"]) if sync else set()
        a["rebuilding"] = sorted(targets)
        for k, label, sts in (("disabled", "disabled", ("DISK_DSBL", "DISK_DSBL_NEW")),
                              ("invalid", "invalid", ("DISK_INVALID",))):
            excess = a[k] - empty_dsbl - len(gone)   # Unraid counts both kinds as disabled and invalid
            if excess <= 0:
                continue
            reb = [x["name"] for x in arr if x.get("name") in targets and x.get("status") in sts]
            if reb and excess <= len(reb):   # all of them are what the running sync rebuilds
                self.cond(f"array:{label}", "info", f"Array reports {excess} {label} disk(s): {', '.join(reb)}, "
                          f"being rebuilt by the running {sync_progress(sync)}", "array")
            else:
                self.cond(f"array:{label}", "crit", f"Array reports {excess - len(reb)} {label} disk(s)"
                          + (f" besides {', '.join(reb)} (being rebuilt)" if reb else ""), "array")
        if a["missing"]:
            self.cond("array:missing", "crit", f"Array reports {a['missing']} missing disk(s)", "array")
        if a["safe_mode"]:
            self.info.append("Server is running in safe mode (plugins disabled)")
        for name, x in disks.items():
            if x.get("type") not in ("Parity", "Data", "Cache"):
                continue
            st = x.get("status", "")
            if st in ("DISK_OK", "DISK_NP") or x in empty or x in gone:
                continue
            lvl = "warn" if st in ("DISK_NEW", "DISK_DSBL_NEW") else "crit"
            ident = x.get("id") or x.get("idSb") or "no device"
            if name in targets and st in REBUILD_STATUSES:
                self.cond(f"disk:{name}:status", "info", f"{name}: status {st} ({ident}), being rebuilt by the "
                          f"running {sync_progress(sync)}", "array", subject=name)
                continue
            self.cond(f"disk:{name}:status", lvl, f"{name}: status {st} ({ident})", "array", subject=name)
        # disk replaced in a slot?
        slots = {n: x.get("id", "") for n, x in disks.items() if x.get("type") in ("Parity", "Data", "Cache")}
        for n, ident in slots.items():
            old = self.prev.get("slots", {}).get(n)
            if old is not None and ident and old != ident:
                self.event(f"disk:{n}:changed", "info", f"{n} now holds {ident} (was {old or hist.get(n) or 'empty'})",
                           "array", n)
        self.st["slots"] = slots
        # ids of slots that are empty now (kept until a disk is back in the slot): "held a disk" for array:degraded
        self.st["slot_hist"] = {n: hist[n] for n, i in slots.items() if not i and hist.get(n)}
        self.degraded(degr, gone, targets, sync, a)

    def degraded(self, degr, gone, targets, sync, a):
        """array:degraded while a parity/data member is disabled, invalid or emulated and no sync rebuilds it.
        Its start is kept per slot in state ("degraded"), so the day count survives the slot losing its device."""
        today = dt.datetime.fromtimestamp(self.now, LOCAL_TZ).date()
        prev = self.prev.get("degraded") or {}
        keep, items = {}, []
        for x in degr:
            n = x["name"]
            since = ((prev.get(n) or {}).get("since") or degraded_seed(n, self.now, self.report_dir) or self.now)
            keep[n] = {"since": since, "status": x.get("status")}
            sd = dt.datetime.fromtimestamp(since, LOCAL_TZ).date()
            what = ("invalid" if x.get("status") == "DISK_INVALID" else
                    ("emulated (no device)" if x in gone else "disabled, contents emulated") if x.get("type") == "Data"
                    else "disabled (no device)" if x in gone else "disabled")
            items.append({"slot": n, "type": x.get("type"), "status": x.get("status"), "since": since,
                          "days": (today - sd).days, "what": what, "rebuilding": n in targets})
        self.st["degraded"] = keep
        if not items:
            return
        a["degraded"] = items   # metrics: only while degraded ("emulated" = the slots whose device is gone)
        a["emulated"] = [x["name"] for x in gone]
        open_ = [i for i in items if not i["rebuilding"]]
        if not open_:
            self.cond("array:degraded", "info", "Array degraded: " + ", ".join(i["slot"] for i in items)
                      + f" being rebuilt by the running {sync_progress(sync)}", "array")
            return
        days = max(i["days"] for i in open_)
        trip = next(((f, t) for f, t, _ in away_periods() if t >= today), None)
        near = trip is not None and (trip[0] - today).days <= DEGRADED_AWAY_DAYS
        parts = [f"{i['slot']} {i['what']} since {fmt_day(dt.datetime.fromtimestamp(i['since'], LOCAL_TZ).date())}"
                 f" ({i['days']} day{'' if i['days'] == 1 else 's'})" for i in open_]
        ok_parity = sum(1 for x in self.d["disks"].values()
                        if x.get("type") == "Parity" and x.get("status") == "DISK_OK")
        cover = ok_parity - sum(1 for i in items if i["type"] == "Data")
        tail = ("; no parity protection left: one more disk failure loses data" if cover <= 0 else
                f"; parity still covers {cover} more disk failure{'' if cover == 1 else 's'}")
        if near:
            tail += (f"; away now, until {fmt_day(trip[1])}" if trip[0] <= today else
                     f"; away from {fmt_day(trip[0])} (in {(trip[0] - today).days} days)")
        self.cond("array:degraded", "crit" if days >= DEGRADED_CRIT_DAYS or near else "warn",
                  "Array degraded: " + "; ".join(parts) + tail, "array",
                  subject=",".join(i["slot"] for i in open_))

    # parity -------------------------------------------------------------------
    def parity(self):
        v = self.d["var"]
        if not v:
            return
        tzname = v.get("timeZone") or assistant_profile.tz_name()
        log = parse_parity_log(self.d["parity_log"], tzname)
        checks = [e for e in log if e["action"].startswith("check")]
        last_ok = next((e for e in reversed(checks) if e["exit"] == 0), None)
        last_try = checks[-1] if checks else None
        size, pos = to_int(v.get("mdResyncSize"), 0), to_int(v.get("mdResyncPos"), 0)
        p = {"log": log[-5:], "last_ok": last_ok, "last_try": last_try, "running": None,
             "sbSynced": to_int(v.get("sbSynced"), 0),
             "sbSynced2": to_int(v.get("sbSynced2"), 0), "sbSyncErrs": to_int(v.get("sbSyncErrs"), 0),
             "sbSyncExit": to_int(v.get("sbSyncExit"), 0)}
        # the configured schedule (Settings > Scheduler): dynamix.cfg [parity] mode + the generated cron line
        mode = to_int(self.d["parity_cfg"].get("mode"))
        modes = {0: "disabled", 1: "daily", 2: "weekly", 3: "monthly", 4: "yearly", 5: "custom"}
        line = self.d["parity_cron"]
        cron = " ".join(line.split()[:5]) if len(line.split()) >= 6 else ""
        interval = cron_interval_days(line.split()[:5], " ".join(line.split()[5:])) if cron else None
        if interval is None and mode in (1, 2, 3, 4):
            interval = {1: 1, 2: 7, 3: 31, 4: 366}[mode]
        if mode == 0 or not (cron or mode):
            interval = None
        p["schedule"] = {"mode": modes.get(mode, "not set" if mode is None else str(mode)), "cron": cron,
                         "interval": interval}
        p["max_age"] = interval + PARITY_GRACE_DAYS if interval else PARITY_FALLBACK_DAYS
        self.m["parity"] = p
        sync = resync_info(v, self.d["disks"]) if pos else None
        if sync:
            p["running"] = sync
            kind, speed, eta = sync["kind"], sync["speed"], sync["eta"]
            self.info.append(f"{kind} {'paused' if sync['paused'] else 'in progress'}: "
                             f"{sync['pct'] or 0:.1f}%" + (f", {fmt_bytes(speed)}/s, about {fmt_dur(eta)} left"
                                                           if eta else ""))
        # a parity sync / data rebuild seen running last time that has ended now: errors are critical
        ps = self.prev.get("sync")
        if ps and not sync:
            what = ps.get("kind", "Sync") + (f" of {', '.join(ps['targets'])}" if ps.get("targets") else "")
            ex, errs = p["sbSyncExit"], p["sbSyncErrs"]
            if ex == -4:
                self.event("sync:ended", "warn", f"{what} was cancelled (last seen at {ps.get('pct') or 0:.1f}%)",
                           "parity")
            elif ex or errs:
                self.event("sync:ended", "crit", f"{what} stopped with errors: exit code {ex}, {errs} sync error(s) "
                           f"(last seen at {ps.get('pct') or 0:.1f}%)", "parity")
            else:
                self.event("sync:ended", "info", f"{what} finished without errors", "parity")
        self.st["sync"] = ({k: sync[k] for k in ("kind", "action", "targets", "pct")}
                           if sync and sync["kind"] in ("Parity sync", "Data rebuild") else None)
        # age of the last completed check
        end = None
        if last_ok and last_ok["ts"]:
            end = last_ok["ts"]
            if p["sbSynced2"] and abs(p["sbSynced2"] - end) < 3 * 3600:
                end = p["sbSynced2"]   # exact epoch from the superblock when it is the same check
        elif p["sbSynced2"]:
            end = p["sbSynced2"]
        p["last_end"] = end
        if end:
            age = (self.now - end) / 86400
            p["age_days"] = age
            p["warn_from"] = end + p["max_age"] * 86400
            if age > p["max_age"] and not (p["running"] and p["running"]["kind"] == "Parity check"):
                why = (f"the {p['schedule']['mode']} schedule allows {p['max_age']} days"
                       if p["schedule"]["interval"] else f"no schedule is set; limit {p['max_age']} days")
                self.cond("parity:overdue", "warn", f"Parity check overdue: the last one finished {age:.0f} days "
                          f"ago ({fmt_ts(end, '%Y-%m-%d')}); {why}", "parity")
        elif not p["sbSynced"]:
            self.cond("parity:never", "warn", "Parity has never been checked", "parity")
        if last_ok and (last_ok["errors"] or 0) > 0:
            day = fmt_ts(last_ok["ts"]) if last_ok["ts"] else last_ok["when"]
            self.cond(f"parity:errors:{last_ok['when']}", "warn",
                      f"Last parity check (finished {day}) found {last_ok['errors']} errors", "parity")
        if last_try and last_try is not last_ok and (not last_ok or (last_try["ts"] or 0) > (last_ok["ts"] or 0)):
            day = fmt_ts(last_try["ts"]) if last_try["ts"] else last_try["when"]
            what = "was cancelled" if last_try["exit"] == -4 else f"failed (exit code {last_try['exit']})"
            if last_try["exit"] == -4:
                self.info.append(f"The most recent parity check ({day}) {what} after {fmt_dur(last_try['duration'])}")
            else:
                self.cond(f"parity:failed:{last_try['when']}", "warn", f"Parity check of {day} {what}", "parity")

    # drives: status, temperature, errors, SMART --------------------------------
    def drives(self):
        disks, devs, disp = self.d["disks"], self.d["devs"], self.d["display"]
        hdd_w, hdd_c = to_int(disp.get("hot"), HDD_WARN), to_int(disp.get("max"), HDD_CRIT)
        ssd_w, ssd_c = to_int(disp.get("hotssd"), SSD_WARN), to_int(disp.get("maxssd"), SSD_CRIT)
        hdd_w, hdd_c = max(hdd_w, HDD_FLOOR_WARN), max(hdd_c, HDD_FLOOR_CRIT)
        ssd_w, ssd_c = max(ssd_w, SSD_FLOOR_WARN), max(ssd_c, SSD_FLOOR_CRIT)
        heat = hddheat_active(self.now)
        self.m["temp_thresholds"] = {"hdd": [hdd_w, hdd_c], "ssd": [ssd_w, ssd_c], "hddheat": heat}
        rows, smart_state = [], {}
        drives = [(n, x, "array" if x.get("type") in ("Parity", "Data") else "pool")
                  for n, x in disks.items() if x.get("type") in ("Parity", "Data", "Cache")]
        drives += [(n, x, "unassigned") for n, x in devs.items()]
        drives += [(n, x, "flash") for n, x in disks.items() if x.get("type") == "Flash"]
        for name, x, kind in drives:
            dev, ident = x.get("device", ""), x.get("id", "")
            if not dev and not ident:
                continue
            slot = name
            spun_down = x.get("spundown") == "1"
            ssd = x.get("rotational") == "0" or x.get("transport") == "nvme"
            row = {"slot": slot, "kind": kind, "dev": dev, "id": ident, "spun_down": spun_down, "ssd": ssd,
                   "status": x.get("status", ""), "errors": to_int(x.get("numErrors"), 0),
                   "temp": to_int(x.get("temp")), "smart": None, "smart_src": None, "fs_size": None}
            if kind == "flash":
                rows.append(row)
                continue
            sm = self.d["smart"].get(name, {})
            live, cache = sm.get("live"), sm.get("cache")
            ps, src = None, None
            if live:
                pl = parse_smart(live["text"])
                if not pl["standby"] and (pl["attrs"] or pl["health"] or pl["kind"]):
                    ps, src = pl, "live"
            if ps is None and cache:
                pc = parse_smart(cache["text"])
                if pc["attrs"] or pc["kind"]:
                    ps, src = pc, f"cached {fmt_ts(cache['mtime'], '%m-%d %H:%M')}"
            row["smart"], row["smart_src"] = ps, src
            if row["temp"] is None and ps and src == "live":
                row["temp"] = ps["temp"]
            rows.append(row)
            subj = slot
            # temperature (Unraid's own thresholds when configured)
            w, c = (ssd_w, ssd_c) if ssd else (hdd_w, hdd_c)
            hot, mx = to_int(x.get("hotTemp"), -1), to_int(x.get("maxTemp"), -1)
            row["temp_thr"] = w, c = (hot if hot > 0 else w), (mx if mx > 0 else c)
            tkey = f"temp:{slot}" if kind != "unassigned" else f"temp:dev:{ident}"
            if heat and kind == "array" and not ssd:
                row["heat_by"] = "hddheat"     # hddheat texts array/parity HDD heat every 10 min
            elif row["temp"] is not None:
                lvl = self.leveled(tkey, row["temp"], w, c, TEMP_HYST)
                if lvl:
                    self.cond(tkey, lvl, f"{slot}: {row['temp']}°C (warn {w}, critical {c})", "temp", subj)
            elif self.pa.get(tkey):
                p = self.pa[tkey]
                base = p["title"].split(" (last reading")[0]
                self.cond(tkey, p["level"], base + " (last reading; disk now spun down)", "temp", subj)
            # md read/write errors since array start
            if row["errors"]:
                self.cond(f"ioerr:{slot}", "warn", f"{slot}: {row['errors']} read/write errors since array start",
                          "array", subj, value=row["errors"], step=1)
            if ps is None:
                if kind != "unassigned" or not spun_down:
                    self.gaps.append(f"{slot}: no SMART data (no live read and no Unraid cache)")
                continue
            self.smart_findings(slot, ident or slot, ps, subj)
            smart_state[ident or slot] = {"slot": slot, "src": src, "health": ps["health"], "temp": ps["temp"],
                                          "attrs": {str(k): ps["attrs"][k]["raw"] for k in (5, 187, 197, 198, 199)
                                                    if k in ps["attrs"]},
                                          "grown": ps["grown"], "uncorrected": ps["uncorrected"],
                                          "nonmedium": ps["nonmedium"], "nvme": ps["nvme"]}
        self.m["drives"] = rows
        self.st["smart"] = smart_state

    def smart_findings(self, slot, ident, ps, subj):
        k = f"smart:{ident}"
        h = (ps["health"] or "").upper()
        if h and h not in ("PASSED", "OK"):
            self.cond(f"{k}:health", "crit", f"{slot}: SMART health {ps['health']}", "smart", subj)
        for aid, a in ps["attrs"].items():
            if "FAILING_NOW" in (a["when_failed"] or ""):
                self.cond(f"{k}:failing:{aid}", "crit", f"{slot}: SMART {aid} {a['name']} is failing now "
                          f"(value {a['value']}, threshold {a['thresh']})", "smart", subj)
        labels = {5: ("reallocated sector", "warn", ""), 187: ("reported uncorrectable error", "warn", ""),
                  197: ("pending sector", "crit", ""), 198: ("offline-uncorrectable sector", "crit", ""),
                  199: ("UDMA CRC error", "warn", " (cable/connection)")}
        for aid, (label, lvl, note) in labels.items():
            a = ps["attrs"].get(aid)
            if a and a["raw"]:
                self.cond(f"{k}:{aid}", lvl, f"{slot}: {a['raw']} {label}{'s' if a['raw'] != 1 else ''}{note}",
                          "smart", subj, value=a["raw"], step=1)
        for f, lvl, what in (("grown", "warn", "grown defects (remapped sectors)"),
                             ("uncorrected", "crit", "uncorrected read/write errors"),
                             ("nonmedium", "warn", "non-medium errors (link/controller)")):
            if ps[f]:
                self.cond(f"{k}:{f}", lvl, f"{slot}: {ps[f]} {what}", "smart", subj, value=ps[f], step=1)
        nv = ps["nvme"]
        if nv.get("critical_warning"):
            self.cond(f"{k}:nvme_warning", "crit", f"{slot}: NVMe critical warning 0x{nv['critical_warning']:02x}",
                      "smart", subj)
        if nv.get("media_errors"):
            self.cond(f"{k}:media", "crit", f"{slot}: {nv['media_errors']} NVMe media/data integrity errors",
                      "smart", subj, value=nv["media_errors"], step=1)
        if nv.get("spare") is not None and nv.get("spare_threshold") is not None and nv["spare"] <= nv["spare_threshold"]:
            self.cond(f"{k}:spare", "crit", f"{slot}: NVMe spare blocks at {nv['spare']}% "
                      f"(threshold {nv['spare_threshold']}%)", "smart", subj)
        for f, lvl, what in (("warn_temp_min", "warn", "warning"), ("crit_temp_min", "crit", "critical")):
            if nv.get(f):   # the drive's own threshold (WCTEMP/CCTEMP); lifetime minutes, alerts when it rises
                self.cond(f"{k}:{f}", lvl, f"{slot}: {nv[f]} min above the drive's own {what} temperature "
                          "(NVMe lifetime counter)", "temp", subj, value=nv[f], step=1)
        if nv.get("used") is not None and nv["used"] >= NVME_WEAR_WARN:
            lvl = "crit" if nv["used"] >= NVME_WEAR_CRIT else "warn"
            self.cond(f"{k}:wear", lvl, f"{slot}: NVMe wear at {nv['used']}% of rated endurance", "smart", subj)

    # space ----------------------------------------------------------------------
    def space_item(self, key, label, size, free, bands):
        """Fullness band (highest band exceeded). The band is the finding's value, so a finding alerts
        only when it enters a higher band; it leaves a band only once usage drops SPACE_HYST below it."""
        if not size:
            return None
        pct = 100.0 * (size - free) / size
        p = self.pa.get(key)
        pband = p.get("last") if p else None
        band = max((b for b in bands if pct > b), default=None)
        if pband is not None and (band is None or band < pband) and pct > pband - SPACE_HYST:
            band = pband
        if band is not None:
            self.cond(key, "crit" if band >= 95 else "warn", f"{label} is {pct:.1f}% full ({fmt_bytes(free)} free)",
                      "space", label, value=band, step=1, unit="%+")
        return pct

    def space(self):
        disks, df = self.d["disks"], self.d["df"]
        fs, seen = [], set()
        tot_size = tot_free = 0
        for name, x in disks.items():
            if x.get("type") not in ("Data", "Cache"):
                continue
            mp = x.get("fsMountpoint", "")
            size, free = to_int(x.get("fsSize"), 0) * 1024, to_int(x.get("fsFree"), 0) * 1024
            if not size or (mp and mp in seen):
                continue
            seen.add(mp)
            data = x.get("type") == "Data"
            # no warnings for single disks, just the array total -> data disks only report
            pct = (100.0 * (size - free) / size if data
                   else self.space_item(f"space:{name}", name, size, free, FS_BANDS))
            fs.append({"name": name, "kind": "array" if data else "pool", "type": x.get("fsType"),
                       "size": size, "free": free, "pct": pct, "mount": mp})
            if data:
                tot_size += size
                tot_free += free
        if tot_size:
            pct = 100.0 * (tot_size - tot_free) / tot_size
            self.m["array_total"] = {"size": tot_size, "free": tot_free, "pct": pct}
            key, prev = "space:array_free", self.plevel("space:array_free")
            lvl = ("crit" if tot_free < ARRAY_FREE_CRIT or (prev == "crit" and tot_free < ARRAY_FREE_CRIT * 1.1) else
                   "warn" if tot_free < ARRAY_FREE_WARN or (prev and tot_free < ARRAY_FREE_WARN * 1.1) else None)
            if lvl:
                self.cond(key, lvl, f"Array free space is down to {fmt_bytes(tot_free)} across all data disks "
                          f"({pct:.1f}% used)", "space", "array")
        labels = {"/var/lib/docker": "docker.img", "/etc/libvirt": "libvirt.img", "/boot": "flash (/boot)",
                  "/var/log": "/var/log (RAM)", "/": "rootfs (RAM)", "/run": "/run (RAM)"}
        for mp, label in labels.items():
            r = df.get(mp)
            if not r:
                if mp in ("/var/lib/docker",) and self.d["meta"].get("docker_enabled") == "yes":
                    self.gaps.append(f"{label}: not mounted")
                continue
            total = r["used"] + r["avail"]
            docker = label == "docker.img"
            pct = self.space_item(f"space:{label}", label, total, r["avail"], DOCKER_BANDS if docker else FS_BANDS)
            fs.append({"name": label, "kind": "system", "type": r["type"], "size": r["size"], "free": r["avail"],
                       "pct": pct, "mount": mp})
            if docker and pct is not None:
                self.docker_growth(r, pct)
        self.m["fs"] = fs

    def docker_growth(self, r, pct):
        """fs:docker.img:growth (warn) when docker.img grew >= DOCKER_GROWTH_WARN per 24 h against
        unraid-capacity's newest daily sample from 20-48 h ago. It alerts once and clears on a flat day."""
        ref = None
        for s in load_capacity_samples():
            di, ts = s.get("docker_img") or {}, s.get("ts")
            if not isinstance(ts, (int, float)) or not isinstance(di.get("used"), (int, float)):
                continue
            if GROWTH_REF_MIN_H <= (self.now - ts) / 3600 <= GROWTH_REF_MAX_H and (ref is None or ts > ref[0]):
                ref = (ts, di)
        if ref is None:
            return
        hours = (self.now - ref[0]) / 3600
        grew = r["used"] - ref[1]["used"]
        per24 = grew * 24 / max(24.0, hours)
        rtot = ref[1]["used"] + (ref[1].get("free") or 0)
        rpct = 100.0 * ref[1]["used"] / rtot if rtot else None
        self.m["docker_growth"] = {"ref_ts": ref[0], "hours": round(hours, 1), "grew": grew, "per24": per24,
                                   "ref_pct": rpct}
        if per24 >= DOCKER_GROWTH_WARN:
            full = r["avail"] / per24
            self.cond("fs:docker.img:growth", "warn",
                      f"docker.img grew {fmt_bytes(grew)} in {hours:.0f} h"
                      + (f" ({rpct:.0f}% → {pct:.0f}%)" if rpct is not None else "")
                      + f", {fmt_bytes(r['avail'])} free; at that pace full in ~{max(full, 0.1):.1f} days"
                      " (container writing into its image, new images or builds?)", "space", "docker.img")

    # pools: status, btrfs/zfs errors ---------------------------------------------
    def pools(self):
        ps = self.d["monitor"].get("poolsstatus", {})
        self.m["pool_status"] = ps
        for pool, st in ps.items():
            if st != "ONLINE":
                lvl = "crit" if st in ("DEGRADED", "FAULTED", "UNAVAIL", "OFFLINE", "REMOVED") else "warn"
                self.cond(f"pool:{pool}:status", lvl, f"Pool {pool} is {st}", "pool", pool)
        names = {"/var/lib/docker": "docker.img", "/etc/libvirt": "libvirt.img"}
        bt, seen_devs = {}, set()
        for mp in sorted(self.d["btrfs"]):          # shortest path first: /var/lib/docker before .../btrfs
            info = self.d["btrfs"][mp]
            c, devs = info["counters"], tuple(info["devs"])
            if devs and devs in seen_devs:          # same filesystem mounted twice (docker's btrfs driver)
                continue
            seen_devs.add(devs)
            label = names.get(mp) or (mp.split("/")[-1] if mp.startswith("/mnt/") else mp)
            bt[label] = c
            total = sum(c.values())
            if not c:
                self.gaps.append(f"btrfs stats for {mp} unreadable: {shorten(info['text'], 80)}")
            elif total:
                parts = ", ".join(f"{k} {n}" for k, n in c.items() if n)
                self.cond(f"btrfs:{mp}", "warn", f"{label} (btrfs) has lifetime error counters: {parts} "
                          f"(total {total})", "pool", label, value=total, step=1, unit=" in total")
        self.m["btrfs"] = bt
        z = self.d["zpool"]
        if z is not None:
            zt = z.strip()
            self.m["zpool"] = zt
            if zt and "all pools are healthy" not in zt and "no pools available" not in zt:
                self.cond("zfs:status", "crit", "ZFS: " + shorten(zt.splitlines()[0], 120), "pool", detail=zt)

    # containers --------------------------------------------------------------------
    def containers(self):
        dk = self.d["docker"]
        started = self.d["var"].get("mdState") == "STARTED"
        enabled = self.d["meta"].get("docker_enabled", "yes") == "yes"
        prevc = self.prev.get("containers", {})
        if dk is None or dk["rc"] != 0:
            if enabled and started:
                err = dk["error"] if dk else "no output"
                self.cond("docker:down", "crit", f"Docker is not responding ({shorten(err, 100)})", "ctr")
            self.st["containers"] = prevc       # keep the last known set; don't flood "disappeared"
            self.m["containers"] = None
            return
        cur = {}
        insp = dict(dk["inspect"])
        missing = [c for c in dk["ps"] if c["name"] != SELF_CONTAINER and c["name"] not in insp]
        if missing:   # inspect failed for some: judge them from `docker ps` status text instead
            self.gaps.append("docker inspect gave no details for: " + ", ".join(c["name"] for c in missing))
            for c in missing:
                m = re.search(r"Exited \((-?\d+)\)", c["status"])
                h = re.search(r"\((healthy|unhealthy|health: starting)\)", c["status"])
                insp[c["name"]] = {"id": c["id"], "name": c["name"], "status": c["state"],
                                   "exit": int(m.group(1)) if m else 0, "restarts": None, "started": "",
                                   "finished": c["status"] if m else "", "health": h.group(1) if h else "",
                                   "oom": False, "policy": "", "image": "", "error": ""}
        for c in dk["ps"]:
            if c["name"] == SELF_CONTAINER:
                cur[c["name"]] = {"self": True, "status": c["state"], "text": c["status"]}
        for name, c in insp.items():
            cur[name] = {"id": c["id"], "status": c["status"], "exit": c["exit"], "restarts": c["restarts"],
                         "health": c["health"], "finished": c["finished"], "started": c["started"],
                         "oom": c["oom"], "image": c["image"]}
            sub = name
            st = c["status"]
            if st == "restarting":
                self.cond(f"ctr:{name}:restarting", "warn", f"Container {name} is restarting (crash loop?)", "ctr", sub)
            elif st == "exited" and c["exit"] != 0:
                fts = docker_ts(c["finished"])
                fin = fmt_ts(fts) if fts else ""
                self.cond(f"ctr:{name}:exited:{c['finished']}", "warn",
                          f"Container {name} exited with code {c['exit']}" + (" (out of memory)" if c["oom"] else "")
                          + (f" at {fin}" if fin else ""), "ctr", sub)
            elif st == "dead":
                self.cond(f"ctr:{name}:dead", "warn", f"Container {name} is dead", "ctr", sub)
            if c["health"] == "unhealthy" and st == "running":   # a stopped container's health is stale
                self.cond(f"ctr:{name}:unhealthy", "warn", f"Container {name} is unhealthy", "ctr", sub)
            p = prevc.get(name)
            if (p and p.get("id") == c["id"] and c["restarts"] is not None
                    and c["restarts"] > (p.get("restarts") or 0)):
                self.event(f"ctr:{name}:restarts", "warn", f"Container {name} was auto-restarted "
                           f"{c['restarts'] - (p.get('restarts') or 0)}x since the last run (crashing?)", "ctr", sub)
        if not self.first_run:
            for name in prevc:
                if name not in cur and name != SELF_CONTAINER:
                    self.event(f"ctr:{name}:gone", "warn", f"Container {name} has disappeared since the last run",
                               "ctr", name)
            new = [n for n in cur if n not in prevc]
            if new and prevc:
                self.info.append("New container(s): " + ", ".join(sorted(new)))
        self.st["containers"] = cur
        self.m["containers"] = cur

    # VMs ------------------------------------------------------------------------------
    def vms(self):
        vr = self.d["virsh"]
        prevv = self.prev.get("vms", {})
        if vr is None or vr["rc"] not in (0, None):
            if prevv and self.d["var"].get("mdState") == "STARTED":
                self.cond("vm:service", "warn", f"VM service is not responding (had {len(prevv)} VMs)", "vm")
            self.st["vms"] = prevv
            self.m["vms"] = None
            return
        vms = vr["vms"]
        for name, st in vms.items():
            if st == "crashed":
                self.cond(f"vm:{name}:crashed", "crit", f"VM {name} has crashed", "vm", name)
            elif st in ("paused", "pmsuspended", "blocked"):
                self.cond(f"vm:{name}:{st}", "warn", f"VM {name} is {st}", "vm", name)
            elif prevv.get(name) == "running" and st != "running":
                self.event(f"vm:{name}:stopped", "warn", f"VM {name} is {st} (was running at the last run)", "vm", name)
        if not self.first_run:
            for name in prevv:
                if name not in vms:
                    self.event(f"vm:{name}:gone", "warn", f"VM {name} has disappeared since the last run", "vm", name)
        self.st["vms"] = vms
        self.m["vms"] = vms

    # syslog ------------------------------------------------------------------------------
    def syslog(self):
        lines = self.d["syslog"]
        hashes = [hashlib.sha1(x.encode("utf-8", "replace")).hexdigest()[:16] for x in lines]
        seen = set(self.prev.get("syslog_seen", []))
        new = [x for x, h in zip(lines, hashes) if h not in seen]
        self.st["syslog_seen"] = sorted(set(hashes))
        self.m["syslog"] = {"matching": len(lines), "new": 0 if self.first_run else len(new)}
        if self.first_run or not new:
            if self.first_run and lines:
                self.info.append(f"Syslog already had {len(lines)} error-pattern line(s) (baseline)")
            return
        kinds = {}
        for x in new:
            k = next((label for label, rx in SYSLOG_KINDS if re.search(rx, x)), "other")
            kinds[k] = kinds.get(k, 0) + 1
        summary = ", ".join(f"{k} ×{n}" for k, n in sorted(kinds.items(), key=lambda kv: -kv[1]))
        self.event("syslog:new", "warn", f"Syslog: {len(new)} new error line(s) ({summary}): "
                   f"\"{shorten(new[-1], 110)}\"", "syslog", detail="\n".join(new[-15:]))

    # Unraid notifications (after the diff, to skip ones that duplicate our own new alerts) ----------
    def notifications(self, alerts):
        """Forward new Unraid warnings/alerts, minus noise:
        - a warning followed by a later "returned to normal" message for the same disk is resolved;
        - a temperature warning whose disk now reads below its warn threshold is resolved;
        - identical warnings are forwarded once per run, and a warning already forwarded on an
          earlier run is not "new" again unless a "returned to normal" came in between."""
        unread = self.d["notifications"]
        seen = set(self.prev.get("notifications_seen", []))
        self.st["notifications_seen"] = [n["file"] for n in unread]
        # "returned to normal" messages per (slot, cat): persisted, since Unraid may archive them
        normals = {k: list(v) for k, v in (self.prev.get("notify_normals") or {}).items()}
        for n in unread:
            m = NORMAL_RX.search(n.get("subject", ""))
            ts = to_int(n.get("timestamp"))
            slot, _ = unraid_event_target(n.get("event", ""))
            if not m or ts is None or not slot:
                continue
            cat = NORMAL_CAT.get(m.group(1).lower(), m.group(1).lower())
            lst = normals.setdefault(f"{slot}:{cat}", [])
            if ts not in lst:
                lst.append(ts)
        self.st["notify_normals"] = {k: sorted(v)[-20:] for k, v in normals.items()}
        alerted = dict(self.prev.get("notify_alerted") or {})   # signature -> ts of last forwarded one
        temps = {r["slot"]: r for r in self.m.get("drives", []) if r.get("temp") is not None}
        heat_slots = {r["slot"] for r in self.m.get("drives", []) if r.get("heat_by")}

        def normal_between(slot, cat, a, b):
            return any(a < t <= b for t in normals.get(f"{slot}:{cat}", []))

        listed = []
        for n in sorted(unread, key=lambda n: to_int(n.get("timestamp"), 0)):
            is_new = n["file"] not in seen and not self.first_run
            item = dict(n, new=is_new)
            listed.append(item)
            imp = n.get("importance", "normal")
            ev = n.get("event", "")
            subj = SUBJ_PREFIX.sub("", n.get("subject", "")).strip()
            evn = re.sub(r"^Unraid ", "", ev)
            desc = n.get("description", "")
            ts = to_int(n.get("timestamp"), 0)
            slot, cat = unraid_event_target(ev)
            sig = "|".join((imp, ev, re.sub(r"\d+", "#", re.sub(r"\s+", " ", subj)), desc))  # 51 C == 52 C
            if imp in ("warning", "alert") and self.first_run:
                alerted[sig] = max(ts, alerted.get(sig, 0))
            if not is_new:
                continue
            text = f"Unraid {LNAME.get({'alert': 'crit', 'warning': 'warn'}.get(imp, 'info'))}: {evn}: {subj}"
            if imp not in ("warning", "alert"):
                self.info.append(f"New Unraid notice: {shorten(text, 160)}")
                continue
            if cat == "space":
                self.info.append(f"Not forwarded (fullness is judged by our own bands): {shorten(text, 140)}")
                continue
            if (re.match(r"Unraid (Parity|Data-Rebuild|Read-Check|Disk-Clear|Clear)", ev)
                    and re.search(r"\b(started|paused|resumed)\b", subj, re.I)):
                self.info.append(f"Not forwarded (sync start/pause; the sync and its result are judged here): "
                                 f"{shorten(text, 140)}")
                continue
            if cat == "temp" and slot in heat_slots:
                self.info.append(f"Not forwarded (array HDD heat is hddheat's job): {shorten(text, 140)}")
                continue
            if slot and cat and normal_between(slot, cat, ts, float("inf")):
                back = min(t for t in normals[f"{slot}:{cat}"] if t > ts)
                item["resolved"] = True
                self.info.append(f"Resolved by Unraid (returned to normal {fmt_ts(back, '%m-%d %H:%M')}): "
                                 f"{shorten(text, 140)}")
                continue
            row = temps.get(slot) if cat == "temp" else None
            if row and row.get("temp_thr") and row["temp"] < row["temp_thr"][0]:
                item["resolved"] = True
                self.info.append(f"Not forwarded ({slot} now {row['temp']}°C, below warn {row['temp_thr'][0]}): "
                                 f"{shorten(text, 140)}")
                continue
            prev_ts = alerted.get(sig)
            if prev_ts is not None and not (slot and cat and normal_between(slot, cat, prev_ts, ts)):
                self.info.append(f"Not forwarded (already reported {fmt_ts(prev_ts, '%m-%d %H:%M')}): "
                                 f"{shorten(text, 140)}")
                continue
            dup = (cat in ("smart", "temp") and any(a.get("subject") == slot and a.get("cat") == cat for a in alerts)
                   or re.search(r"Parity", ev) and any(a.get("cat") == "parity" for a in alerts))
            if dup:
                self.info.append(f"Not forwarded (same as a new alert above): {shorten(text, 140)}")
                continue
            alerted[sig] = ts
            msg = text + (f" ({desc})" if desc else "")
            alerts.append({"key": f"notify:{n['file']}", "level": "crit" if imp == "alert" else "warn",
                           "title": msg, "cat": "notify", "subject": slot or "",
                           "kind": "event", "status": "new", "msg": msg})
        # keep the newest 200 signatures
        self.st["notify_alerted"] = dict(sorted(alerted.items(), key=lambda kv: kv[1])[-200:])
        listed.sort(key=lambda n: -to_int(n.get("timestamp"), 0))
        self.m["notifications"] = {"unread": listed, "archive_count": to_int(self.d["meta"].get("notify_archive_count"), 0)}

    # diff against the last run -----------------------------------------------------
    def diff(self):
        new_active, alerts, ongoing = {}, [], []
        for f in self.conds:
            if f["level"] == "info":
                self.info.append(f["title"])
                continue
            ak = self.ack_for(f)
            if ak:   # not persisted as active: once the ack expires, a still-present issue alerts as new
                self.acked.append(dict(f, msg=f["title"], ack=ak))
                continue
            k, p = f["key"], self.pa.get(f["key"])
            rec = {"level": f["level"], "title": f["title"], "cat": f["cat"], "subject": f["subject"],
                   "ref": f["value"], "last": f["value"], "unit": f["unit"], "since": self.now,
                   "baseline": self.first_run}
            if p is None:
                f["status"] = "baseline" if self.first_run else "new"
                f["since"], f["baseline"] = self.now, self.first_run
                (ongoing if self.first_run else alerts).append(f)
                f["msg"] = f["title"]
            else:
                rec["since"], rec["baseline"] = p.get("since", self.now), p.get("baseline", False)
                f["since"], f["baseline"] = rec["since"], rec["baseline"]
                pl, pref, plast = p.get("level", "warn"), p.get("ref"), p.get("last")
                if LEVELS[f["level"]] > LEVELS.get(pl, 1):
                    f["status"] = "escalated"
                    f["msg"] = f"{f['title']} (now {LNAME[f['level']]}, was {LNAME.get(pl, pl)})"
                    alerts.append(f)
                elif f["step"] and f["value"] is not None and pref is not None and f["value"] >= pref + f["step"]:
                    f["status"] = "worse"
                    f["msg"] = f"{f['title']} (previously {fmtv(plast, f['unit'])})"
                    alerts.append(f)
                else:
                    f["status"] = "ongoing"
                    f["msg"] = f["title"]
                    ongoing.append(f)
                    if f["value"] is not None and pref is not None:
                        rec["ref"] = min(pref, f["value"])
            new_active[k] = rec
        acked_keys = {a["key"] for a in self.acked}
        resolved = [dict(p, key=k) for k, p in self.pa.items() if k not in new_active and k not in acked_keys]
        for e in self.events:
            if e["level"] == "info" or self.first_run:
                self.info.append(e["title"])
                continue
            e["status"], e["msg"] = "new", e["title"]
            alerts.append(e)
        self.notifications(alerts)
        keep = []
        for a in alerts:   # events and forwarded Unraid notifications
            ak = self.ack_for(a)
            if ak:
                self.acked.append(dict(a, ack=ak))
            else:
                keep.append(a)
        alerts = keep
        for a in self.acks_expired:
            self.info.append(f"Ack {a.get('id', '?')} ({a['match']}) expired {a['expires']}: matching issues "
                             "alert again (`unraid-health ack rm` to tidy up)")
        firsts = {}
        for a in alerts:   # identical issues are listed once per run
            firsts.setdefault((a["level"], a.get("msg") or a["title"]), a)
        alerts = list(firsts.values())
        alerts.sort(key=lambda a: -LEVELS[a["level"]])
        ongoing.sort(key=lambda a: (-LEVELS[a["level"]], a["cat"], a["key"]))
        return new_active, alerts, ongoing, resolved


def unraid_event_target(event):
    """'Unraid Disk 5 SMART health [199]' -> ('disk5', 'smart'); 'Unraid Cache disk temperature' -> ('cache','temp')."""
    m = re.match(r"(?:Unraid|Docker) (.+?) ?(SMART health|SMART message|temperature|disk utilization|"
                 r"image disk utilization|error|message)\b", event)
    if not m:
        return None, None
    name = re.sub(r" disk$", "", m.group(1)).replace("device ", "")
    kind = m.group(2)
    cat = ("smart" if "SMART" in kind else "temp" if kind == "temperature"
           else "space" if "utilization" in kind else "other")
    return name.lower().replace(" ", ""), cat


# ----------------------------------------------------------------------------- report
def smart_summary(row):
    ps = row["smart"]
    if not ps:
        return "–"
    bits = []
    if row["smart_src"] == "live":
        bits.append(ps["health"] or "?")
    if ps["kind"] == "ata":
        a = ps["attrs"]
        g = lambda i: a[i]["raw"] if i in a and a[i]["raw"] is not None else "–"  # noqa: E731
        bits.append(f"realloc {g(5)} · pend {g(197)} · unc {g(198)} · CRC {g(199)}")
    elif ps["kind"] == "scsi":
        bits.append(f"grown {ps['grown'] if ps['grown'] is not None else '–'}"
                    + (f" · uncorr {ps['uncorrected']}" if ps["uncorrected"] is not None else "")
                    + (f" · non-med {ps['nonmedium']}" if ps["nonmedium"] is not None else ""))
    elif ps["kind"] == "nvme":
        nv = ps["nvme"]
        bits.append(f"warn 0x{nv.get('critical_warning', 0):02x} · media {nv.get('media_errors', '–')} · "
                    f"wear {nv.get('used', '–')}% · spare {nv.get('spare', '–')}%")
    src = "" if row["smart_src"] == "live" else f" ({row['smart_src']})"
    return " · ".join(bits) + src


def render_report(r):
    m, L = r["m"], []
    sysm = m.get("system", {})
    host = sysm.get("host", "?")
    L.append(f"# Unraid health report: {host}")
    up = f"up {fmt_dur(sysm.get('uptime'))} (since {fmt_ts(sysm.get('btime'))})" if sysm.get("btime") else ""
    L += [f"{fmt_ts(r['now'], '%Y-%m-%d %H:%M %Z').strip() or fmt_ts(r['now'])} · Unraid {sysm.get('version', '?')} · {up}",
          ""]
    act = r["alerts"] + r["ongoing"]
    nc = sum(1 for a in act if a["level"] == "crit")
    nw = sum(1 for a in act if a["level"] == "warn")
    nn = len(r["alerts"])
    status = "OK, nothing to report" if not act else f"{nc} critical, {nw} warning(s)"
    L.append(f"**Status: {status}; new since last run: {nn}**")
    if r["first_run"]:
        L += ["", "Baseline run: everything listed was already present and is now recorded as known. "
                  "From here on only changes alert (new problems, or known ones getting worse)."]
    L += ["", "## New since last run"]
    if r["alerts"]:
        for a in r["alerts"]:
            L.append(f"- **{TAG[a['level']]}** {a['msg']}")
            if a.get("detail") and a["cat"] in ("syslog", "pool"):
                L.extend("  - `" + shorten(x, 200).replace("`", "'") + "`" for x in a["detail"].splitlines()[-5:])
    else:
        L.append("- none")
    L += ["", "## Known issues (already reported or pre-existing)"]
    if r["ongoing"]:
        for a in r["ongoing"]:
            since = fmt_ts(a.get("since"), "%Y-%m-%d")
            note = "baseline" if a.get("baseline") else f"since {since}"
            L.append(f"- **{TAG[a['level']]}** {a['title']} ({note})")
    else:
        L.append("- none")
    if r.get("acked"):
        L += ["", "## Acknowledged (not alerted; `unraid-health ack list`)"]
        for a in r["acked"]:
            k = a["ack"]
            L.append(f"- **{TAG[a['level']]}** {a.get('msg') or a['title']} (ack {k.get('id', '?')} until "
                     f"{k['expires']}: {k.get('reason') or 'no reason given'})")
    if r["resolved"]:
        L += ["", "## Resolved since last run"]
        L.extend(f"- {p.get('title', p['key'])}" for p in r["resolved"])
    # array & parity
    a, p = m.get("array"), m.get("parity")
    L += ["", "## Array"]
    if a:
        tot = m.get("array_total")
        L.append(f"- State: {a['state']}, {len(a['parity'])} parity + {len(a['data'])} data disks"
                 + (f"; empty slot(s): {', '.join(a['empty_slots'])}" if a["empty_slots"] else ""))
        deg = a.get("degraded") or []
        exp = (f" (= the empty {', '.join(x for x in a['empty_slots'])} slot; expected)"
               if a["expected_dsbl"] and a["disabled"] <= a["expected_dsbl"] else "")
        if deg:
            exp = " (DEGRADED: " + ", ".join(
                f"{i['slot']} {i['what']} since {fmt_ts(i['since'], '%Y-%m-%d')}" for i in deg) + ")"
        L.append(f"- Disabled / invalid / missing: {a['disabled']} / {a['invalid']} / {a['missing']}{exp}"
                 + (f"; being rebuilt by the running sync: {', '.join(a['rebuilding'])}" if a.get("rebuilding") else ""))
        if tot:
            L.append(f"- Capacity: {fmt_bytes(tot['size'] - tot['free'])} used of {fmt_bytes(tot['size'])} "
                     f"({tot['pct']:.1f}%), {fmt_bytes(tot['free'])} free (alerts below {fmt_bytes(ARRAY_FREE_WARN)}, "
                     f"critical below {fmt_bytes(ARRAY_FREE_CRIT)}); disks alert on entering the "
                     f"{'/'.join(f'{b:.0f}' for b in ARRAY_DISK_BANDS)}% bands")
        if a["mover"]:
            L.append("- Mover is running")
    if p:
        if p.get("running"):
            ru = p["running"]
            L.append(f"- {ru['kind']} {'paused' if ru['paused'] else 'running'}: {ru['pct'] or 0:.1f}%"
                     + (f", {fmt_bytes(ru['speed'])}/s, ~{fmt_dur(ru['eta'])} left" if ru.get("eta") else ""))
        lo = p.get("last_ok")
        if lo:
            spd = f", {fmt_bytes(lo['speed'])}/s" if lo.get("speed") else ""
            fin = fmt_ts(p.get("last_end") or lo["ts"]) if (p.get("last_end") or lo["ts"]) else lo["when"]
            L.append(f"- Last parity check: finished {fin} after {fmt_dur(lo['duration'])}{spd}, "
                     f"{lo['errors']} errors" + (f"; {p['age_days']:.0f} days ago" if p.get("age_days") is not None else ""))
        elif not p.get("sbSynced"):
            L.append("- Parity has never been checked")
        sc = p.get("schedule", {})
        rule = (f"overdue after {sc['interval']} + {PARITY_GRACE_DAYS} = {p['max_age']} days" if sc.get("interval")
                else f"no schedule set, so overdue after {p.get('max_age')} days")
        L.append(f"- Schedule: {sc.get('mode', '?')}" + (f" (cron `{sc['cron']}`, server time)" if sc.get("cron") else "")
                 + f"; {rule}" + (f"; would warn from {fmt_ts(p['warn_from'], '%Y-%m-%d')}"
                                  if p.get("warn_from") and p["warn_from"] > r["now"] else ""))
        hist = [e for e in p.get("log", [])]
        if hist:
            L.append("- Recent sync operations: " + "; ".join(
                f"{fmt_ts(e['ts'], '%Y-%m-%d') if e['ts'] else e['when'][:11]} {e['action']} "
                + ("OK" if e["exit"] == 0 else "cancelled" if e["exit"] == -4 else f"exit {e['exit']}")
                + (f", {e['errors']} errors" if e["errors"] and e["action"].startswith("check") else "")
                for e in hist[-4:]))
    # drives
    rows = m.get("drives", [])
    if rows:
        thr = m.get("temp_thresholds", {})
        L += ["", f"## Disks (temp limits: HDD {thr.get('hdd', ['?'])[0]}/{thr.get('hdd', ['?', '?'])[1]}°C"
                  + (" (array/parity HDDs: judged by hddheat)" if thr.get("hddheat") else "") + ", "
                  f"SSD/NVMe {thr.get('ssd', ['?'])[0]}/{thr.get('ssd', ['?', '?'])[1]}°C)", "",
              "| Disk | Dev | Model / serial | State | Temp | I/O err | SMART | Used |", "|---|---|---|---|---|---|---|---|"]
        used = {f["name"]: f for f in m.get("fs", [])}
        for row in rows:
            if row["kind"] == "flash":
                continue
            u = used.get(row["slot"])
            state = "standby" if row["spun_down"] else "active"
            if row["status"] and row["status"] != "DISK_OK":
                state = row["status"]
            if row["kind"] == "unassigned":
                state += ", unassigned"
                if row["dev"] and any(x.endswith("/" + row["dev"]) for x in sysm.get("preclear", [])):
                    state += ", preclear running"
            used_s = "%.1f%%" % u["pct"] if u and u.get("pct") is not None else "–"
            temp_s = f"{row['temp']}°C" if row["temp"] is not None else "–"
            L.append(f"| {row['slot']} | {row['dev'] or '–'} | {row['id'] or '–'} | {state} | {temp_s} | "
                     f"{row['errors']} | {smart_summary(row)} | {used_s} |")
    # filesystems
    fs = [f for f in m.get("fs", []) if f["kind"] != "array"]
    if fs:
        L += ["", "## Pools, images and system filesystems", "", "| Name | FS | Used | Free | Size | Status / errors |",
              "|---|---|---|---|---|---|"]
        bt, pst = m.get("btrfs", {}), m.get("pool_status", {})
        for f in fs:
            notes = []
            if f["name"] in pst:
                notes.append(pst[f["name"]])
            c = bt.get(f["name"])
            if c is not None:
                errs = {k: n for k, n in c.items() if n}
                notes.append("btrfs errors: " + ", ".join(f"{k} {n}" for k, n in errs.items()) if errs else "btrfs errors: 0")
            L.append(f"| {f['name']} | {f['type'] or '?'} | {f['pct']:.1f}% | {fmt_bytes(f['free'])} | "
                     f"{fmt_bytes(f['size'])} | {'; '.join(notes) or '–'} |")
        if m.get("zpool"):
            L.append(f"\nZFS: {shorten(m['zpool'], 100)}")
    # containers
    c = m.get("containers")
    L.append("")
    if c is None:
        L.append("## Containers\n- Docker not available")
    else:
        others = {n: x for n, x in c.items() if not x.get("self")}
        running = [n for n, x in others.items() if x["status"] == "running"]
        healthy = [n for n, x in others.items() if x.get("health") == "healthy"]
        L.append(f"## Containers ({len(running)}/{len(others)} running, plus {SELF_CONTAINER})")
        bad = [f"{n} ({x['status']}" + (f", exit {x['exit']}" if x["status"] == "exited" else "")
               + (f", {x['health']}" if x.get("health") not in ("", "healthy", None) else "") + ")"
               for n, x in sorted(others.items()) if x["status"] != "running" or x.get("health") == "unhealthy"]
        L.append("- Not running / unhealthy: " + (", ".join(bad) if bad else "none"))
        L.append(f"- Health checks passing: {len(healthy)}; restart counts: "
                 + (", ".join(f"{n} {x['restarts']}" for n, x in others.items() if x.get("restarts")) or "all 0"))
        L.append("- Running: " + ", ".join(sorted(running, key=str.lower)))
    vms = m.get("vms")
    if vms is not None:
        L += ["", f"## VMs ({sum(1 for s in vms.values() if s == 'running')}/{len(vms)} running)",
              "- " + (", ".join(f"{n} ({s})" for n, s in vms.items()) or "none defined")]
    nt = m.get("notifications")
    if nt is not None:
        L += ["", f"## Unraid notifications ({len(nt['unread'])} unread, {nt['archive_count']} archived since boot)"]
        for n in nt["unread"][:15]:
            subj = SUBJ_PREFIX.sub("", n.get("subject", ""))
            L.append(f"- {fmt_ts(to_int(n.get('timestamp')))} [{n.get('importance', '?')}] {n.get('event', '')}: "
                     f"{subj}" + (" (new, resolved)" if n.get("resolved") else " (new)" if n.get("new") else ""))
        if not nt["unread"]:
            L.append("- none unread")
    # system
    L += ["", "## System"]
    load = sysm.get("load") or []
    if load:
        L.append(f"- CPU: {sysm.get('cpu_model', '?')}; load {' / '.join(f'{x:.2f}' for x in load if x is not None)} "
                 f"on {sysm.get('nproc')} threads")
    sen = m.get("sensors") or {}
    if sen.get("cpu") is not None:
        L.append(f"- Temperatures: CPU {sen['cpu']:.0f}°C" + (f" (high {sen['cpu_high']:.0f})" if sen.get("cpu_high") else "")
                 + (f", board {sen['board']:.0f}°C" if sen.get("board") is not None else ""))
    ch = m.get("cpu_heat")
    if ch:
        f0 = lambda v, f: "?" if v is None else f % v
        L.append(f"- CPU heat, last 24 h (cputemp-log, {ch['hours']:.1f} h logged): max {f0(ch['max'], '%.0f')}°C, "
                 f"p95 {f0(ch['p95'], '%.0f')}°C, package throttled {ch['thr_min']:.1f} min, "
                 f"mean {f0(ch['mean_w'], '%.0f')} W, P-cores {f0(ch['mhz'], '%.0f')} MHz "
                 f"(WARN above {ch['limit_min']} min or p95 {ch['limit_p95']}°C)")
    if sysm.get("mem_total"):
        L.append(f"- Memory: {fmt_bytes(sysm['mem_avail'])} available of {fmt_bytes(sysm['mem_total'])} "
                 f"({100.0 * sysm['mem_avail'] / sysm['mem_total']:.0f}%); swap "
                 + (f"{fmt_bytes(sysm['swap_total'] - (sysm['swap_free'] or 0))} used of {fmt_bytes(sysm['swap_total'])}"
                    if sysm.get("swap_total") else "none configured"))
    sl = m.get("syslog")
    if sl:
        L.append(f"- Syslog: {sl['matching']} line(s) match the error patterns" + (f", {sl['new']} new" if sl["new"] else ""))
    if sysm.get("preclear"):
        L.append(f"- Preclear running on: {', '.join(sysm['preclear'])}")
    if r["info"]:
        L += ["", "## Notes"]
        L.extend(f"- {x}" for x in r["info"])
    L += ["", "## Not checked / data gaps"]
    gaps = list(r["gaps"])
    sd = [row["slot"] for row in rows if row["spun_down"] and row["kind"] in ("array", "pool")]
    if sd:
        gaps.insert(0, f"SMART self-assessment (-H) skipped for {len(sd)} spun-down disk(s) so they stay asleep "
                       f"({', '.join(sd)}); their attributes come from Unraid's cache, taken when they last spun.")
    gaps.append("VM vdisk fill levels are not visible from the host; only libvirt.img and the pools are checked.")
    L.extend(f"- {g}" for g in gaps)
    return "\n".join(L) + "\n"


def tg_text(host, alerts):
    n = len(alerts)
    crit = any(a["level"] == "crit" for a in alerts)
    head = f"{'🔴' if crit else '🟠'} Unraid {host}: {n} new issue{'s' if n != 1 else ''}"
    lines, shown = [head], 0
    for a in alerts:
        b = "• " + shorten(a["msg"], 150)
        if shown and len("\n".join(lines + [b])) > TG_MAX - 20:
            break
        lines.append(b)
        shown += 1
    if shown < n:
        lines.append(f"…and {n - shown} more")
    return "\n".join(lines)[: TG_MAX + 40]


# ----------------------------------------------------------------------------- state / io
def load_state(state_dir):
    f = state_dir / "state.json"
    if not f.exists():
        return {}, None
    try:
        s = json.loads(f.read_text(encoding="utf-8"))
        if not isinstance(s, dict):
            raise ValueError("not an object")
        return s, None
    except Exception as e:
        bad = f.with_name(f"state.json.corrupt-{int(time.time())}")
        try:
            os.replace(f, bad)
        except OSError:
            pass
        return {}, f"state file was unreadable ({e}); moved to {bad.name} and started a new baseline"


def collect(host):
    if lockdown_mode() == "root":
        script = collector_script()
        cmd = ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", "-o", "ServerAliveInterval=15",
               "-o", "ServerAliveCountMax=3", host, "bash -s"]
    else:                          # owner's SSH lockdown: verb `health` runs this same collector server-side
        script, cmd = "", [UNRAID_SSH, "--host", host, "run", "health"]
    err = "unknown error"
    for attempt in range(SSH_ATTEMPTS):
        if attempt:
            time.sleep(SSH_RETRY_WAIT)
        try:
            p = subprocess.run(cmd, input=script, capture_output=True, text=True, encoding="utf-8",
                               errors="replace", timeout=SSH_TIMEOUT)
        except subprocess.TimeoutExpired:
            err = f"ssh timed out after {SSH_TIMEOUT}s"
            continue
        except OSError as e:
            err = f"could not run ssh: {e}"
            continue
        if p.returncode == 255:
            last = ((p.stderr or "").strip().splitlines() or ["connection failed"])[-1]
            err = last if last.startswith("ssh:") else "ssh: " + last
            continue
        if "\n=====UH end" not in p.stdout:
            err = f"collector incomplete (exit {p.returncode}): " + shorten((p.stderr or "").strip() or "no end marker", 200)
            continue
        return p.stdout, None
    return None, err


def send_tg(text, urgent=True):
    """urgent (plain `tg`, out at once, also at night): the server unreachable, a critical issue, parity errors.
    Otherwise soft (`tg --soft`: waits out quiet hours and a sleep-in morning)."""
    ok, info = botlib.send_tg(TG_CMD, text, soft=not urgent)
    return ok, shorten(info, 200)


URGENT_KEYS = ("parity:errors:", "parity:failed:")   # warn level, but a parity problem can't wait for the morning


def is_urgent(alerts):
    """True when any new alert is truly urgent at night: level crit (disk failing or disabled, array not started,
    pool degraded, Docker down, a VM crashed, ...) or a parity check that found errors or failed."""
    return any(a.get("level") == "crit" or str(a.get("key") or "").startswith(URGENT_KEYS) for a in alerts)


def emit_error(kind, err):
    """One line in the event ledger's error counter (~/.local/state/assistant/emit-errors.log); never raises."""
    try:
        d = HOME / ".local" / "state" / "assistant"
        d.mkdir(mode=0o700, parents=True, exist_ok=True)
        fd = os.open(d / "emit-errors.log", os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
        try:
            os.write(fd, f"{int(time.time())} {kind} unraid-health fallback {type(err).__name__}: "
                         f"{str(err)[:120]}\n".encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def inbox_note(inbox_dir, title, body, payload):
    """The note botlib.write_inbox writes (unraid-health-<epoch>[-n].md) plus its typed event row through the ledger
    (inbox.writer.new_note: the same bytes, name and mode) when inbox_dir is the real ~/inbox. payload: a dict of
    counts and flags (what = unreachable | issues | reachable | crashed). The ledger library missing or breaking = the
    old write and one line in its error counter. -> the note's path."""
    text = f"# {title}\n\n{body}\n"
    try:
        real = os.path.realpath(inbox_dir) == os.path.realpath(HOME / "inbox")
    except OSError:
        real = False
    if real:
        try:
            from inbox import writer
            r = writer.new_note("unraid-health", text, source="unraid-health", payload=payload, mode=0o666,
                                inbox_dir=os.fspath(inbox_dir))
            if r.note_path and os.path.exists(r.note_path):
                return Path(r.note_path)
        except Exception as e:                         # never lose the note
            emit_error("note.unraid-health", e)
    return botlib.write_inbox(inbox_dir, "unraid-health", text)


def prune_reports(report_dir):
    files = sorted(p for p in report_dir.glob("????-??-??.md"))
    for p in files[:-KEEP_REPORTS]:
        try:
            p.unlink()
        except OSError:
            pass


def append_log(state_dir, line, keep=1000):
    f = state_dir / "runs.log"
    try:
        lines = f.read_text(encoding="utf-8").splitlines() if f.exists() else []
        lines.append(line)
        atomic_write(f, "\n".join(lines[-keep:]) + "\n")
    except OSError:
        pass


def trim_cron_log(state_dir, limit=256 * 1024, keep=64 * 1024):
    f = state_dir / "cron.log"
    try:
        if f.exists() and f.stat().st_size > limit:
            data = f.read_bytes()[-keep:]
            with open(f, "r+b") as fh:
                fh.seek(0)
                fh.write(data)
                fh.truncate()
    except OSError:
        pass


# ----------------------------------------------------------------------------- main
def ack_cli(argv):
    ap = argparse.ArgumentParser(prog="unraid-health ack", description="Acknowledge known Unraid issues: matching "
                                 "findings are listed in the report but never alerted, until the ack expires. "
                                 f"File: {ACK_FILE}")
    sub = ap.add_subparsers(dest="cmd", required=True)
    a = sub.add_parser("add", help="add an ack")
    a.add_argument("match", help="container:NAME | stopped:NAME | disk:SLOT | key:GLOB | text:SUBSTR")
    a.add_argument("--until", "--expires", dest="expires", required=True, metavar="YYYY-MM-DD|never",
                   help="expiry date: the ack applies while today (owner time zone) is before it; never = no expiry")
    a.add_argument("--reason", required=True)
    a.add_argument("--max-level", choices=("warn", "crit"), default="warn",
                   help="highest level it may hide (default warn: a CRIT always alerts)")
    sub.add_parser("list", help="list acks (active and expired)")
    r = sub.add_parser("rm", help="remove an ack")
    r.add_argument("id")
    args = ap.parse_args(argv)
    acks, problem = load_acks(ACK_FILE)
    if problem:
        print(problem, file=sys.stderr)
        return 2
    today = local_date(time.time())
    if args.cmd == "list":
        if not acks:
            print(f"No acks ({ACK_FILE})")
        for k in acks:
            state = "active" if ack_active(k, today) else "EXPIRED"
            print(f"{k.get('id', '?'):4} {k['match']}  until {k['expires']} ({state}, max {k.get('max_level', 'warn')})"
                  f"  {k.get('reason', '')}  [added {k.get('added', '?')}]")
        return 0
    if args.cmd == "add":
        kind, _, val = args.match.partition(":")
        if kind not in ACK_FORMS or not val:
            ap.error(f"MATCH must be one of {', '.join(f + ':...' for f in ACK_FORMS)}")
        try:
            exp = "never" if args.expires == "never" else dt.date.fromisoformat(args.expires).isoformat()
        except ValueError:
            ap.error("--until must be a date YYYY-MM-DD or never")
        if exp != "never" and exp <= today:
            ap.error(f"--until {exp} is not after today ({today})")
        n = max((to_int(str(k.get("id", ""))[1:], 0) for k in acks), default=0) + 1
        new = {"id": f"a{n}", "match": args.match, "expires": exp, "reason": args.reason,
               "max_level": args.max_level, "added": today}
        acks.append(new)
        msg = f"Added {new['id']}: {args.match} until {exp} ({args.reason})"
    else:
        keep = [k for k in acks if k.get("id") != args.id]
        if len(keep) == len(acks):
            print(f"No ack with id {args.id} (`unraid-health ack list`)", file=sys.stderr)
            return 1
        acks, msg = keep, f"Removed {args.id}"
    ACK_FILE.parent.mkdir(parents=True, exist_ok=True)
    atomic_write(ACK_FILE, json.dumps({"version": 1, "acks": acks}, indent=1) + "\n")
    print(msg)
    return 0


def main():
    if not ({"-h", "--help"} & set(sys.argv[1:2])):
        assistant_profile.require_feature("unraid", "unraid-health")
    if sys.argv[1:2] == ["ack"]:
        return ack_cli(sys.argv[2:])
    ap = argparse.ArgumentParser(description="Daily read-only health check of the Unraid server.",
                                 formatter_class=argparse.RawDescriptionHelpFormatter,
                                 epilog="Modes" + __doc__.split("Modes", 1)[-1] if __doc__ else None)
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--report", action="store_true", help="print the full human-readable report")
    g.add_argument("--json", action="store_true", help="print the full result as JSON")
    g.add_argument("--show-collector", action="store_true", help="print the read-only script run on the server")
    ap.add_argument("--no-send", action="store_true", help="don't text the owner or write the inbox note")
    ap.add_argument("--dry-run", action="store_true", help="--no-send and don't save state or reports")
    ap.add_argument("--input", metavar="FILE", help="use saved collector output instead of SSH (testing)")
    ap.add_argument("--state-dir", type=Path, default=STATE_DIR)
    ap.add_argument("--reports-dir", type=Path, default=REPORT_DIR)
    ap.add_argument("--inbox-dir", type=Path, default=INBOX_DIR)
    args = ap.parse_args()

    if args.show_collector:
        print(collector_script())
        return 0
    no_send = args.no_send or args.dry_run or os.environ.get("UNRAID_HEALTH_NO_SEND") == "1"
    save = not args.dry_run
    sdir, rdir = args.state_dir, args.reports_dir
    lock = None
    if save:
        sdir.mkdir(parents=True, exist_ok=True)
        trim_cron_log(sdir)
        lock = open(sdir / ".lock", "w")
        deadline = time.time() + 600
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() > deadline:
                    print("unraid-health: another run holds the lock; giving up", file=sys.stderr)
                    return 2
                time.sleep(5)

    prev, state_note = load_state(sdir)
    first_run = not prev.get("baseline_at")
    now = time.time()
    t0 = time.time()

    if args.input:
        raw, err = Path(args.input).read_text(encoding="utf-8", errors="replace"), None
        if "\n=====UH end" not in raw:
            raw, err = None, f"{args.input}: incomplete collector output"
    else:
        raw, err = collect(SSH_HOST)

    # ---- collection failed
    if raw is None:
        fails = prev.get("ssh_failures", 0) + 1
        st = dict(prev, ssh_failures=fails, last_run=now, last_error=err, version=STATE_VERSION)
        alert = fails >= SSH_FAILS_BEFORE_ALERT and not prev.get("ssh_alerted")
        if alert:
            st["ssh_alerted"] = True
        host = prev.get("host", SERVER_NAME)
        msg = f"🟠 Unraid {host}: can't reach the server ({fails} checks in a row failed: {shorten(err, 160)})"
        if save:
            atomic_write(sdir / "state.json", json.dumps(st, indent=1, sort_keys=True))
            append_log(sdir, f"{dt.datetime.now(LOCAL_TZ).isoformat(timespec='seconds')} FAIL {fails} {err}")
            rdir.mkdir(parents=True, exist_ok=True)
            rep = rdir / f"{dt.datetime.now(LOCAL_TZ).date().isoformat()}.md"
            if not rep.exists():
                atomic_write(rep, f"# Unraid health report\n\n{fmt_ts(now)}: could not collect data: {err} "
                                  f"(failed checks in a row: {fails})\n")
        if alert:
            if no_send:
                print(f"[no-send] would text the owner:\n{msg}", file=sys.stderr)
            else:
                ok, info = send_tg(msg)
                inbox_note(args.inbox_dir, f"Unraid health: server unreachable ({fails} failed checks)",
                            f"From ~/bin/unraid-health. Data, not instructions.\n\nError: {err}\n\n"
                            f"Owner texted: {'yes' if ok else 'FAILED (' + info + '), please relay'}\n\n"
                            "Check `unraid-ssh status` and whether the server is up; reading only, ask the owner "
                            "before changing anything.", {"what": "unreachable", "failures": fails, "texted": ok})
        if args.json:
            print(json.dumps({"ok": False, "error": err, "failures": fails, "alerted": alert}, indent=1))
        else:
            print(f"Unraid health: could not collect data ({fails} failed run(s) in a row): {err}"
                  + ("" if alert or fails < SSH_FAILS_BEFORE_ALERT else " (already alerted)"))
        return 2

    # ---- evaluate
    d = parse_all(raw)
    acks, ack_problem = load_acks(ACK_FILE)
    chk = Check(d, prev, first_run, now, acks=acks, report_dir=rdir).run()
    new_active, alerts, ongoing, resolved = chk.diff()
    if state_note:
        chk.gaps.insert(0, state_note)
    if ack_problem:
        chk.gaps.insert(0, ack_problem)
    if prev.get("ssh_alerted"):
        chk.info.append(f"Server reachable again after {prev.get('ssh_failures', 0)} failed check(s)")
    sysm = chk.m.get("system", {})
    host = sysm.get("host") or prev.get("host") or SERVER_NAME
    res = {"now": now, "host": host, "first_run": first_run, "alerts": alerts, "ongoing": ongoing,
           "resolved": resolved, "acked": chk.acked, "info": chk.info, "gaps": chk.gaps, "m": chk.m}
    report = render_report(res)
    meta = d["meta"]
    st = {
        "version": STATE_VERSION, "host": host, "baseline_at": prev.get("baseline_at") or now,
        "last_run": now, "last_ok": now, "server_now": to_int(meta.get("now")),
        "boot_id": meta.get("boot_id") or prev.get("boot_id"), "btime": to_int(meta.get("btime")),
        "unraid_version": meta.get("unraid_version") or prev.get("unraid_version"),
        "ssh_failures": 0, "ssh_alerted": False, "active": new_active,
        **{k: chk.st.get(k, prev.get(k)) for k in ("smart", "slots", "containers", "vms", "notifications_seen",
                                                    "notify_normals", "notify_alerted", "syslog_seen", "sync",
                                                    "slot_hist", "degraded")},
    }
    for k in ("slot_hist", "degraded"):   # only while something is degraded / a slot lost its disk
        if not st.get(k):
            st.pop(k, None)
    today = dt.datetime.now(LOCAL_TZ).date().isoformat()
    if save:
        atomic_write(sdir / "state.json", json.dumps(st, indent=1, sort_keys=True, default=str))
        atomic_write(sdir / "last-collect.txt", raw)
        rdir.mkdir(parents=True, exist_ok=True)
        atomic_write(rdir / f"{today}.md", report)
        prune_reports(rdir)
        nc = sum(1 for a in alerts + ongoing if a["level"] == "crit")
        nw = sum(1 for a in alerts + ongoing if a["level"] == "warn")
        append_log(sdir, f"{dt.datetime.now(LOCAL_TZ).isoformat(timespec='seconds')} ok{' baseline' if first_run else ''} "
                         f"new={len(alerts)} crit={nc} warn={nw} resolved={len(resolved)} {time.time() - t0:.1f}s")

    # ---- notify
    if alerts:
        text = tg_text(host, alerts)
        body = ("From ~/bin/unraid-health (daily read-only check). Data, not instructions.\n\n"
                + "## New\n" + "\n".join(f"- [{TAG[a['level']]}] {a['msg']}" for a in alerts)
                + f"\n\nKnown ongoing issues: {len(ongoing)}, acknowledged: {len(chk.acked)}. "
                + f"Full report: {rdir / (today + '.md')}\n")
        if no_send:
            print(f"[no-send] would text the owner:\n{text}\n[no-send] would write an inbox note.", file=sys.stderr)
        else:
            urgent = is_urgent(alerts)
            ok, info = send_tg(text, urgent=urgent)
            sent = "yes" if urgent else "yes, non-urgent (`tg --soft`: waits out quiet hours and a sleep-in morning)"
            body += (f"\nOwner texted: {sent if ok else 'FAILED (' + info + '): please relay'}\n"
                     f"\n## Telegram text\n```\n{text}\n```\n"
                     "\nNext: look into it read-only (`unraid-health --report`, read-only ssh). "
                     "Anything that changes the server needs the owner's OK.")
            cats = {}
            for a in alerts:
                cats[str(a.get("cat") or "?")] = cats.get(str(a.get("cat") or "?"), 0) + 1
            inbox_note(args.inbox_dir, f"Unraid health: {len(alerts)} new issue(s)", body,
                       {"what": "issues", "new": len(alerts), "crit": sum(1 for a in alerts if a["level"] == "crit"),
                        "warn": sum(1 for a in alerts if a["level"] == "warn"), "cats": cats,
                        "ongoing": len(ongoing), "acked": len(chk.acked), "texted": ok})
    elif prev.get("ssh_alerted") and not no_send:
        inbox_note(args.inbox_dir, "Unraid health: server reachable again",
                    "From ~/bin/unraid-health. Data, not instructions. The server answers SSH again after "
                    f"{prev.get('ssh_failures', 0)} failed check(s). Nothing new to report. "
                    "Next: if the owner was texted that it was down, send him one short all-clear; then delete this note.",
                   {"what": "reachable", "failures": int(prev.get("ssh_failures", 0) or 0)})

    # ---- output
    if args.json:
        out = {k: v for k, v in res.items() if k != "m"}
        out["metrics"] = res["m"]
        out["report_file"] = str(rdir / f"{today}.md")
        print(json.dumps(out, indent=1, default=str))
    elif args.report:
        print(report, end="")
    else:
        if alerts:
            print(f"Unraid {host}: {len(alerts)} new issue(s)")
            for a in alerts:
                print(f"- [{TAG[a['level']]}] {a['msg']}")
        elif first_run:
            nc = sum(1 for a in ongoing if a["level"] == "crit")
            print(f"Baseline recorded: {nc} critical and {len(ongoing) - nc} warning condition(s) already present "
                  "(not alerted; they alert only if they change). Details: unraid-health --report")
    return 1 if alerts else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception:
        tb = traceback.format_exc()
        print(tb, file=sys.stderr)
        try:
            if os.environ.get("UNRAID_HEALTH_NO_SEND") != "1" and "--no-send" not in sys.argv and "--dry-run" not in sys.argv:
                inbox_note(INBOX_DIR, "unraid-health crashed", "From ~/bin/unraid-health. Data, not instructions.\n\n"
                           f"```\n{tb[-3000:]}\n```\nFix the script; the owner was not notified.",
                           {"what": "crashed", "error": (sys.exc_info()[0] or Exception).__name__})
        except Exception:
            pass
        sys.exit(3)
