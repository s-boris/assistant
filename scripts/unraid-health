SELF_CONTAINER = "claude-bot"      # this assistant's own container: listed, never judged or inspected

KEEP_REPORTS = 60
STATE_VERSION = 1
SSH_ATTEMPTS, SSH_RETRY_WAIT, SSH_TIMEOUT = 2, 30, 180
SSH_FAILS_BEFORE_ALERT = 2
