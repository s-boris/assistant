#!/usr/local/bin/python3.13 -I
"""wake: the brain's own wake rules (hold idle beats, delivery class per event kind, timers). Source: ~/opt/assistant
(packages/inbox/wake.py, core); `wake --help`.

Finds its libraries next to itself: deployed, ~/bin/lib/{core,inbox}; in the repo, ../core and ../packages/inbox.
$ASSISTANT_LIB (a directory holding core/ and inbox/) overrides both. Stdlib only (the heartbeat gate runs it).
"""

import os
import sys

_here = os.path.dirname(os.path.realpath(__file__))
_roots = [
    os.environ.get("ASSISTANT_LIB", ""),
    os.path.join(_here, "lib"),
    os.path.join(_here, ".."),
    os.path.join(_here, "..", "packages"),
]
for _pkg in ("core", "inbox"):
    for _r in _roots:
        if _r and os.path.isfile(os.path.join(_r, _pkg, "__init__.py")):
            _r = os.path.abspath(_r)
            if _r not in sys.path:
                sys.path.insert(0, _r)
            break

if __name__ == "__main__":
    from inbox import wake

    sys.exit(wake.main(sys.argv[1:]))
