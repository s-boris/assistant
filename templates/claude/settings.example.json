{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "mcp__browser__browser_run_code_unsafe"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook UserPromptSubmit >/dev/null 2>&1 || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/agenda.sh\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/conduct.py\" prompt",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook PreToolUse >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Monitor|mcp__plugin_telegram(-plus)?_telegram__(react|draft|edit_message)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/conduct.py\" pre",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__plugin_telegram(-plus)?_telegram__(reply|send_poll)",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/pitch-check.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "mcp__hub__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/hub-stamp.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook PostToolUse >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook Stop >/dev/null 2>&1 || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/conduct.py\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook SubagentStart >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook SubagentStop >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook SessionStart >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook SessionEnd >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/tg-status\" hook StopFailure >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
