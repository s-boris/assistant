#!/usr/bin/env python3
"""Fake ~/bin/ha for wled-sync tests: `list light --json` and `device-url <entity>` from $FAKE_HA_DIR."""
import json
import os
import sys

d = os.environ['FAKE_HA_DIR']
with open(os.path.join(d, 'calls.log'), 'a') as fh:
    fh.write(json.dumps(sys.argv[1:]) + '\n')
cfg = json.load(open(os.path.join(d, 'ha.json')))
a = sys.argv[1:]
if cfg.get('fail'):
    print('ha: error: cannot reach Home Assistant (URLError)', file=sys.stderr)
    sys.exit(1)
if a == ['list', 'light', '--json']:
    print(json.dumps(cfg['lights']))
    sys.exit(0)
if len(a) == 2 and a[0] == 'device-url':
    url = cfg['urls'].get(a[1])
    if not url:
        print(f'ha: refused: {a[1]}: its device has no configuration_url', file=sys.stderr)
        sys.exit(2)
    print(url)
    sys.exit(0)
print('fake ha: unexpected call ' + ' '.join(a), file=sys.stderr)
sys.exit(2)
